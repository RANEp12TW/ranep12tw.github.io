  <SENTENSE Ver="1" Id="LOGINSTAGE_RANDOM_PASS_FAILED">
    <VALUE Lang="tw">登入失敗！帳號下線後,或切換頻道後,或使用網站功能後都需要等待10秒才可以再次登入！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="LOGINSTAGE_SSN_FAILED">
    <VALUE Lang="tw">身份證字號不符！</VALUE>
