    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_007">
        <VALUE Lang="tw">鏡像影分身</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_007">
        <VALUE Lang="tw">用幻影擾亂敵人，藉此逃離追擊。該技能移動中亦可使用</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_008">
        <VALUE Lang="tw">麻醉蜂</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_008">
        <VALUE Lang="tw">把一大群昆蟲放在地上以攻擊敵人。降低敵人的10~20抗性和0.1~0.2%的HP恢復。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_009">
        <VALUE Lang="tw">夢幻蝶</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_009">
