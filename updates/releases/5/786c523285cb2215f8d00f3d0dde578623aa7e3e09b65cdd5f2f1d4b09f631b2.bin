    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_010">
        <VALUE Lang="tw">skip</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_011">
        <VALUE Lang="tw">黑暗之雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_011">
        <VALUE Lang="tw">視線限制10%、移動速度減少-50~90%</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_012">
        <VALUE Lang="tw">泡泡領域</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_012">
        <VALUE Lang="tw">在地面上放出魔法氣泡讓同盟受到有益效果。提升防禦率5~10%，抵抗10~25，偵測隱秘敵人，以及10~20%的傷害反射的增益效果buff。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_013">
        <VALUE Lang="tw">殞石落下</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_013">
        <VALUE Lang="tw">skip</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_014">
        <VALUE Lang="tw">酸性泡泡</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_014">
        <VALUE Lang="tw">在地面上放出魔法氣泡，然後引爆它以攻擊四周的敵人。降低抵抗10~25，增加魔法命中機率10~20%和傷害30%。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_015">
        <VALUE Lang="tw">啦啦隊美眉</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_015">
        <VALUE Lang="tw">在地面上放出魔法助手以讓同盟受到有益效果。增加攻擊力5~10%，吸收物理傷害5~10%，防止異常狀態，並且偵測隱秘敵人。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_016">
        <VALUE Lang="tw">重擊泡泡</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_016">
        <VALUE Lang="tw">skip</VALUE>
    </SENTENSE>
