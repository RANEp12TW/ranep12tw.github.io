    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_017">
        <VALUE Lang="tw">skip</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_018">
        <VALUE Lang="tw">命運之骰</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_058_018">
        <VALUE Lang="tw">將魔法骰子放在地面上以讓敵人受到巨型骰子落下的攻擊。解除增益效果buff和逼使敵人下交通工具。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_058_019">
