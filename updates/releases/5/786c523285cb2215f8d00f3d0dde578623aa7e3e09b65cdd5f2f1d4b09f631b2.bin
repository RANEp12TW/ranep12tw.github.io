    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_000">
        <VALUE Lang="tw">奧義．開天闢地</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_000">
        <VALUE Lang="tw">朝敵人用力劈斬</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_001">
        <VALUE Lang="tw">奧義．影鐮鼸</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_001">
        <VALUE Lang="tw">聚集忍術之氣向四周目標發動攻擊。技能施展後可額外獲得自身體力恢復的效果.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_002">
        <VALUE Lang="tw">奧義．昇龍擊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_002">
        <VALUE Lang="tw">鐮刀瞄準敵人揮下後再拔起形成二次傷害，且可使敵人使用藥水的恢復效果減少.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_003">
        <VALUE Lang="tw">奧義．鐮咬</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_003">
        <VALUE Lang="tw">鐮刀大力朝敵人劈下後拖行.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_004">
        <VALUE Lang="tw">奧義．鐮之舞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_004">
        <VALUE Lang="tw">鐮刀鋒口釋放出孤魂靈氣朝四周敵人發動攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_005">
        <VALUE Lang="tw">忍法．真視之眼</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_005">
        <VALUE Lang="tw">隱身埋伏在敵人身旁探測敵人行動.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_006">
        <VALUE Lang="tw">忍法．縮地之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_006">
        <VALUE Lang="tw">瞬間移動到目的地之後給予敵人強力一擊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_007">
        <VALUE Lang="tw">忍法．噬魂之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_007">
        <VALUE Lang="tw">朝敵人發動攻擊吸取敵人靈魂之氣恢復自身體力.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_008">
        <VALUE Lang="tw">幻術．隨心所欲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_008">
        <VALUE Lang="tw">干擾敵人心智使敵人自殘.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_009">
        <VALUE Lang="tw">奧義．追魂</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_009">
        <VALUE Lang="tw">把惡靈注入敵人體內控制其行動.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_010">
        <VALUE Lang="tw">忍法．骨化之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_010">
        <VALUE Lang="tw">發動攻擊讓敵人靈魂出竅無法行動.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_011">
        <VALUE Lang="tw">忍法．反彈障壁</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_011">
        <VALUE Lang="tw">把痛苦烙痕刻印在敵人身上，烙印消失前所施展的全部技能攻擊都會套用在敵人身上.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_012">
        <VALUE Lang="tw">忍法．土之結界</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_012">
        <VALUE Lang="tw">從現實世界中抽離暫時變身無敵不受到任何攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_013">
        <VALUE Lang="tw">奧義．殘風</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_013">
        <VALUE Lang="tw">武器連續交錯揮舞朝敵人發動攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_014">
        <VALUE Lang="tw">奧義．血紅龍卷</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_014">
        <VALUE Lang="tw">利用揮舞鐮刀形成的黑色旋風攻擊敵人.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_015">
        <VALUE Lang="tw">忍法．血之咒印</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_015">
        <VALUE Lang="tw">讓四周敵人身陷苦楚，依照自身體力剩餘百分比給予敵人相對傷害。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_016">
        <VALUE Lang="tw">忍法．念動空間</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_016">
        <VALUE Lang="tw">瞬間移動到指定位置之後給予指定位置的眾多敵人短暫一擊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_017">
        <VALUE Lang="tw">奧義．爆風亂舞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_017">
        <VALUE Lang="tw">雙臂如同蝴蝶翅膀般揮動閃避的同時朝四周敵人發動攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_018">
        <VALUE Lang="tw">忍法．影襲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_018">
        <VALUE Lang="tw">煙霧彈效果一起把敵人吸入地面再發動攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_019">
        <VALUE Lang="tw">忍法．修羅幻境</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_019">
        <VALUE Lang="tw">佈下天羅地網把敵人困住,朝全部敵人一次發動攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_020">
        <VALUE Lang="tw">奧義．一擊入魂</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_020">
        <VALUE Lang="tw">精準的找出弱點，一擊給予目標極大的傷害，附帶降低目標能力效果。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_021">
        <VALUE Lang="tw">血祭大鐮咬</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_021">
        <VALUE Lang="tw">揮舞鐮刃大範圍的橫掃四周所有目標</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_043_022">
        <VALUE Lang="tw">勾魂引魄斬</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_043_022">
        <VALUE Lang="tw">鐮刃橫掃目標後，再躍起給予目標全力一擊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_000">
        <VALUE Lang="tw">奧義．牙突</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_000">
        <VALUE Lang="tw">雙刃分離朝敵人進行亂刀斬.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_001">
        <VALUE Lang="tw">奧義．連牙</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_001">
        <VALUE Lang="tw">雙刃分離朝敵人亂刀砍擊。使用此技能後一段時間內自身可額外獲得體力恢復的效果.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_002">
        <VALUE Lang="tw">奧義．血舞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_002">
        <VALUE Lang="tw">雙刃合併大力揮擊形成旋風朝敵人前進進行攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_003">
        <VALUE Lang="tw">忍法．替身術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_003">
        <VALUE Lang="tw">施展幻術曲體抱頭閃避攻擊同時瞬移至敵人身後.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_004">
        <VALUE Lang="tw">忍法．心轉之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_004">
        <VALUE Lang="tw">超越身心侷限加快全部冷卻中技能的冷卻時間，並提升該技能攻擊力.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_005">
        <VALUE Lang="tw">奧義．十文字</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_005">
        <VALUE Lang="tw">快速接近目標擺出十字形。從5級開始攻擊力大幅增加，第一次攻擊有強力打擊的效果但是突擊效果會消失。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_006">
        <VALUE Lang="tw">忍法．咒印之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_006">
        <VALUE Lang="tw">受到忍字標記的目標會受到連鎖傷害.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_007">
        <VALUE Lang="tw">奧義．殘像斬</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_007">
        <VALUE Lang="tw">指定區域內施放煙霧攻擊四周敵人.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_008">
        <VALUE Lang="tw">幻術．操靈之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_008">
        <VALUE Lang="tw">控制目標使之互相殘殺.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_009">
        <VALUE Lang="tw">奧義．赤殛</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_009">
        <VALUE Lang="tw">指定目標區域內施展血紅雷光劈擊敵人.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_010">
        <VALUE Lang="tw">忍法．偽裝之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_010">
        <VALUE Lang="tw">危急時立刻偽裝成自動販賣機脫離危險.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_011">
        <VALUE Lang="tw">奧義．空躍斬</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_011">
        <VALUE Lang="tw">跳躍至空中向下斬擊，擊中目標時使所有冷卻中的技能減少.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_012">
        <VALUE Lang="tw">忍法．潛行之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_012">
        <VALUE Lang="tw">使用後可立即進入潛行狀態，此時只能使用小步伐移動，攻擊目標或跑步時會解除潛行狀態.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_013">
        <VALUE Lang="tw">奧義．黑旋風</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_013">
        <VALUE Lang="tw">雙刃合體朝四周敵人揮擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_014">
        <VALUE Lang="tw">幻術．夢中起舞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_014">
        <VALUE Lang="tw">使用幻術迷幻目標讓敵人起舞.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_015">
        <VALUE Lang="tw">忍法．瞬身之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_015">
        <VALUE Lang="tw">帶領四周隊員瞬間移動至指定地點.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_016">
        <VALUE Lang="tw">幻術．影縛之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_016">
        <VALUE Lang="tw">減緩範圍內敵人的移動速度和攻擊速度強化自己的戰鬥能力.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_017">
        <VALUE Lang="tw">忍法．斷空步</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_017">
        <VALUE Lang="tw">瞬移至目標所在位置受到攻擊後隱藏樣貌，滲透敵人隊伍.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_018">
        <VALUE Lang="tw">忍法．破甲之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_018">
        <VALUE Lang="tw">瞬移到敵人身邊攻擊敵人騎乘工具，可解除該目標的騎乘狀態.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_019">
        <VALUE Lang="tw">忍法．鏡花水月</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_019">
        <VALUE Lang="tw">將四周敵人拉近集中後忍術內力一次爆發.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_020">
        <VALUE Lang="tw">奧義．紅蓮螺旋殺</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_020">
        <VALUE Lang="tw">武器展開揮擊四周敵人.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_021">
        <VALUE Lang="tw">奧義．雷嗚閃</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_021">
        <VALUE Lang="tw">快速磨擦雙刃使之發出電殛般的效果，往前方擲出，附帶降低目標抗性效果。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_022">
        <VALUE Lang="tw">真紅狂牙斬</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_022">
        <VALUE Lang="tw">揮舞雙刃釋放殺氣將目標一分為四</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_044_023">
        <VALUE Lang="tw">晨星荒舞劍</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_044_023">
        <VALUE Lang="tw">揮舞雙刃如流星般快速斬殺目標</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_000">
        <VALUE Lang="tw">奧義．音速投擲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_000">
        <VALUE Lang="tw">投擲迴旋標發動攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_001">
        <VALUE Lang="tw">奧義．劇毒手裏劍</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_001">
        <VALUE Lang="tw">讓敵人血液感染引發內出血。限定時間內額外獲得恢復生命力的效果.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_002">
        <VALUE Lang="tw">忍法．闇炎</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_002">
        <VALUE Lang="tw">施展火焰術攻擊使敵人被火焰吞噬.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_003">
        <VALUE Lang="tw">忍法．相位轉移</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_003">
        <VALUE Lang="tw">自身位置和目標對像互換並發動攻擊，技能等級5以上位置互換效果才會發動.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_004">
        <VALUE Lang="tw">忍法．變身術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_004">
        <VALUE Lang="tw">偽裝成非攻擊目標躲避攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_005">
        <VALUE Lang="tw">忍法．劇毒風暴</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_005">
        <VALUE Lang="tw">施展毒氣颶風讓四周敵人持續受到攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_006">
        <VALUE Lang="tw">奧義．毒輪斬</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_006">
        <VALUE Lang="tw">讓四周敵人感染湠疽病視線變模糊、行動遲緩.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_007">
        <VALUE Lang="tw">忍法．重力術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_007">
        <VALUE Lang="tw">集四方之氣束縛讓降低敵人正向之氣使其行動鈍化.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_008">
        <VALUE Lang="tw">忍法．體力奪取術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_008">
        <VALUE Lang="tw">使對方感染劇毒消耗其體力.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_009">
        <VALUE Lang="tw">忍法．屍鬼轉生術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_009">
        <VALUE Lang="tw">讓敵人身體引發副作用.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_010">
        <VALUE Lang="tw">忍法．洞察之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_010">
        <VALUE Lang="tw">看穿敵人的攻擊路線找到最有利的躲避位置。額外讓對方等待施放的所有技能延遲減少25%.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_011">
        <VALUE Lang="tw">奧義．風火輪</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_011">
        <VALUE Lang="tw">根據自身HP減少比例給予目標對像傷害.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_012">
        <VALUE Lang="tw">忍法．煙霧連彈</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_012">
        <VALUE Lang="tw">施放煙霧躲避敵人攻擊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_013">
        <VALUE Lang="tw">忍法．瞬火之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_013">
        <VALUE Lang="tw">瞬間移動至指定位置火花球四處飛散攻擊對方.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_014">
        <VALUE Lang="tw">幻術．形轉之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_014">
        <VALUE Lang="tw">朝前方敵人發射幻毒發動攻擊使其外貌突變.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_015">
        <VALUE Lang="tw">忍法．陰陽封印</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_015">
        <VALUE Lang="tw">擾亂敵人內力讓敵人使用中的技能冷卻時間加長,藥水恢復量減少.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_016">
        <VALUE Lang="tw">忍法．不知火</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_016">
        <VALUE Lang="tw">使用爆破攻擊敵人爆破形成的煙霧可暫時掩護隊友.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_017">
        <VALUE Lang="tw">忍法．血噬之術</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_017">
        <VALUE Lang="tw">使用自己的血製成的血術攻讓對方在一定時間內攻擊傷害增加.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_018">
        <VALUE Lang="tw">忍法．深淵毒牢</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_018">
        <VALUE Lang="tw">將帶有咒術的卷軸扔向目標，中招後會強制變成只能逃跑的老鼠.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_019">
        <VALUE Lang="tw">忍法．恐懼支配</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_019">
        <VALUE Lang="tw">讓對方中樞神經麻痺並操控其心智，可於技能效果時間內使用CTRL + 滑鼠右鍵進行操作。.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SN_045_020">
        <VALUE Lang="tw">奧義．分身殺法</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="SD_045_020">
        <VALUE Lang="tw">召喚八個圓月輪，造成大範圍的斬擊效果，附帶攻速降低效果。</VALUE>
    </SENTENSE>
