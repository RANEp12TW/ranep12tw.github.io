  <SENTENSE Ver="1" Id="ID_316_050">
    <VALUE Lang="cn">Forbidden tower副本必须拥有的lunch box道具，可以提升角色MP和SP恢复率。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_051">
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_052">
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_053">
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_054">
    <VALUE Lang="cn">利用Forbidden tower副本取得的特殊材料所制作的EXP戒指。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_055">
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_056">
    <VALUE Lang="cn">Forbidden tower副本怪物掉落的宝箱。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_057">
    <VALUE Lang="cn">隐藏护身能力的便当。使用后30分钟内角色攻击力增加7%，HP增加2%。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_058">
    <VALUE Lang="cn">使用后30分钟内HP增加2%，经验值增加5%。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_059">
    <VALUE Lang="cn">Forbidden tower制作的便当Lunch box。使用后30分钟内HP增加2%，攻击速度增加4%。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_060">
    <VALUE Lang="cn">可拿Forbidden tower的Medal向NPC兑换金币。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_061">
    <VALUE Lang="cn">装备在戒指可以获得附加效果。戒指使用期限到期时，镶嵌的道具和戒指会一并消失。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_316_062">
    <VALUE Lang="cn">装备在戒指可以获得附加效果。戒指使用期限到期时，镶嵌的道具和戒指会一并消失。</VALUE>
