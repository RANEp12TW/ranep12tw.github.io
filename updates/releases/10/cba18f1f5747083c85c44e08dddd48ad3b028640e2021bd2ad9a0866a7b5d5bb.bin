  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_186_160">
    <VALUE Lang="cn">初等玩家的专用随机礼物。内含多种物品。祝您好运！ </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_186_161">
    <VALUE Lang="cn">中等玩家的专用随机礼物。内含多种物品。祝您好运！ </VALUE>
  </SENTENSE>
