  <SENTENSE Ver="1" Id="ID_455_001">
    <VALUE Lang="cn">当您需要Destiny Box幸运箱时，请点击滑鼠右键来开启使用。 祝您好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_002">
    <VALUE Lang="cn">盒内装有3个高级命运箱子。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_003">
    <VALUE Lang="cn">基于您对Ran World的热爱，为了表达我们对您的感谢，'Bomb'、'Oh No!' 和 'Health'的效果将被消除。请拖曳到地面上来进行使用。  </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_004">
    <VALUE Lang="cn">基于您对Ran World的热爱，为了表达我们对您的感谢，'Bomb'、'Oh No!' 和 'Health'的效果将被消除。请拖曳到地面上来进行使用。  </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_005">
    <VALUE Lang="cn">基于您对Ran World的热爱，为了表达我们对您的感谢，'Bomb'、'Oh No!' 和 'Health'的效果将被消除。请拖曳到地面上来进行使用。  </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_006">
    <VALUE Lang="cn">基于您对Ran World的热爱，为了表达我们对您的感谢，'Bomb'、'Oh No!' 和 'Health'的效果将被消除。请拖曳到地面上来进行使用。  </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_007">
    <VALUE Lang="cn">基于您对Ran World的热爱，为了表达我们对您的感谢，'Bomb'、'Oh No!' 和 'Health'的效果将被消除。请拖曳到地面上来进行使用。  </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_008">
    <VALUE Lang="cn">基于您对Ran World的热爱，为了表达我们对您的感谢，'Bomb'、'Oh No!' 和 'Health'的效果将被消除。请拖曳到地面上来进行使用。  </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_009">
    <VALUE Lang="cn">是Hidden Card胶囊！还有Premium 背包扩充礼盒！请点击箱子，开启隐藏的背包栏位~！这就是我们说的 'Magic'。但请记住，只有24小时的绝佳效果，而且每日仅限使用1次。[By Capsule Genie]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_010">
    <VALUE Lang="cn">盒内装有Chicken套装。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_011">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到帽子物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_012">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到上衣物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_013">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到下裤物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_014">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到手套物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_015">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到鞋子物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_016">
    <VALUE Lang="cn">这个如何呢？ 很刺激吧！再试试吧！! 当您从胶囊商城得到此物品时，将会是最闪耀亮眼的主角哟！成为Ran World的英雄吧！[By. 胶囊 Genie]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_017">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到帽子物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_018">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到上衣物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_019">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到下裤物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_020">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到手套物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_021">
    <VALUE Lang="cn">用滑鼠左键来选择，并拖曳到鞋子物品上，再点击滑鼠右键来进行装备。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_022">
    <VALUE Lang="cn">我已经将Item Shop的物品进行升级了！\r\n对于像您一样喜欢品质优造型美的玩家来说，这是一个 "绝不可缺物品"。[By Capsule Genie]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_023">
    <VALUE Lang="cn">盒内装有500 Red Wine。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_024">
    <VALUE Lang="cn">当您从Capsule shop得到物品时，您将成为最有魅力闪亮的主角唷！  虽然这仅是个Chipped Ruby，但总有一天您将能得到顶级的物品的~ 要成为Ran World的英雄不再只是梦想！! [By Capsule Genie]</VALUE>
