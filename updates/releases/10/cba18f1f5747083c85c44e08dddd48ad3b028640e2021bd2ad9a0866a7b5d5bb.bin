  <SENTENSE Ver="1" Id="ID_3260_200">
    <VALUE Lang="cn">Weapons exchange after achieving level 10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_201">
    <VALUE Lang="cn">Pet, presented to newbies. Usable until character Lv. 100. Summon the PET with right mouse click. Press 'L' key to view the PET info when PET is summoned.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_202">
    <VALUE Lang="cn">Use it with click of right mouse button while your PET is summoned. Must assign the learned skill in the PET window opened with 'L' button to enable PET to execute the skill.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_203">
    <VALUE Lang="cn">Open the box with right mouse click</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_204">
    <VALUE Lang="cn">Reach level 10 and open the box with right mouse click.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_205">
    <VALUE Lang="cn">Reach level 20 and open the box with right mouse click.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_206">
    <VALUE Lang="cn">Sell it for 10,000 Golds to College Representative NPC at Market Place</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_207">
    <VALUE Lang="cn">Expires after 7 Days. EXP earned from hunting monsters will increase up to 150%. Usable up to level 100 only.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_208">
    <VALUE Lang="cn">Reach level 30 and open the box with right mouse click.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_209">
    <VALUE Lang="cn">Randomly assigns 0 ~ 4 options into items. Right-Click to open the Option Randomizer Window. This item will expire after 24 Hours.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_210">
    <VALUE Lang="cn">Addition Line (6 Blocks) of Inventory space will be unlocked. Right mouse click this item to unlock the inventory space permanently. Expires after 1 Day.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3260_211">
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
