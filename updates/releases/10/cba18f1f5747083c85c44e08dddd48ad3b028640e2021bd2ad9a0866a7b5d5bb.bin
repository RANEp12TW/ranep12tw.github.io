  <SENTENSE Ver="1" Id="ID_703_202">
    <VALUE Lang="cn">活动期间每天可通过完成任务获得. ※道具一天后将自动消失.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_703_203">
    <VALUE Lang="cn">非常感谢你一直以来都喜欢我. 我接受你的告白. - Cold Woman - ※ 可从活动NPC处兑换各种道具.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_703_204">
    <VALUE Lang="cn">对不起. 我好像跟你没有缘分. - Cold Woman - ※ 可从活动NPC处兑换各种道具.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_703_205">
    <VALUE Lang="cn">点击鼠标左键，将物品拖动到你想要使用的位置，然后点击鼠标右键进行使用.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_703_206">
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_703_207">
