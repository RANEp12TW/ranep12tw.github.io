  <SENTENSE Ver="1" Id="ID_240_147">
    <VALUE Lang="cn">可利用15个CDM Medal来进行交易。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_240_148">
    <VALUE Lang="cn">当使用改造卡时，1~4个随机数值可被增加或是变更。  </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_240_149">
    <VALUE Lang="cn">当使用改造卡时，1~4个随机数值可被增加或是变更。  </VALUE>
