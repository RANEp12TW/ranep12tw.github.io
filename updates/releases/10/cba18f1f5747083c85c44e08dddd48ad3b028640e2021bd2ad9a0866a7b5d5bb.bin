  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_186_172">
    <VALUE Lang="cn">此物品为Buff增益道具。点击滑鼠右键即可使用。10分钟之内可增加10%的防御力。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_186_173">
    <VALUE Lang="cn">为了感谢您阻止Chungs，我要给您个充满Ruby能量的项链。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_186_174">
    <VALUE Lang="cn">为了感谢您阻止Chungs，我要给您个充满Ruby能量的项链。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_186_175">
