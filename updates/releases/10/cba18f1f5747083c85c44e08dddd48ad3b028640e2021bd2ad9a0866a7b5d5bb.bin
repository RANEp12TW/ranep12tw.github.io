  <SENTENSE Ver="1" Id="ID_260_000">
    <VALUE Lang="cn">类别小于100Lv</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_001">
    <VALUE Lang="cn">点击滑鼠右键来开启礼盒。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_002">
    <VALUE Lang="cn">使用Resurrection Rosary7个小时内可提升1.5倍的经验值。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_003">
    <VALUE Lang="cn">按“V”来装备滑板栏位即可使用。按“N”可确认S.R.C的界面。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_004">
    <VALUE Lang="cn">武器兑换卡是专门赠送给新手玩家的。玩家们到了10等级之后，可在Market Place 的Newbie Guide兑换到希望的武器。但角色超过100等级时，将无法使用带武器。该卡片可被垃圾删除卡进行删除。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_005">
    <VALUE Lang="cn">给新生的宠物礼物。100等级以下的角色皆可使用。点击滑鼠右键可召唤之。在召唤出的状态下，按“L”键可确认宠物的相关资料。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_006">
    <VALUE Lang="cn">再次点击滑鼠右键可收回宠物。召唤之后，可点击L按键来设定，并施展宠物的已学技能。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_007">
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_008">
    <VALUE Lang="cn">给新生的武器，不可交易、不可储存于置物箱、不可进行研磨。可利用‘道具删除卡’ Garbage Card来进行删除。 </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_009">
    <VALUE Lang="cn">给新生的武器，不可交易、不可储存于置物箱、不可进行研磨。可利用‘道具删除卡’ Garbage Card来进行删除。 </VALUE>
  </SENTENSE>
