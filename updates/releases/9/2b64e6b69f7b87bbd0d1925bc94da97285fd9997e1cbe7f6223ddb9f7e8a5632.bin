<VALUE Lang="tw">請輸入名字</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="INVEN_CLUB_RENAME">
<VALUE Lang="tw">請輸入要修改的組織名稱</VALUE>
</SENTENSE>
