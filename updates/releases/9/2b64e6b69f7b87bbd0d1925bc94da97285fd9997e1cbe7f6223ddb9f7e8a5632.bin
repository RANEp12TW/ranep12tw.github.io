</SENTENSE>
<SENTENSE Ver="1" Id="TOURNAMENT_PVP_CTF_DETAIL">
<VALUE Lang="tw">對戰 : 紅隊 VS 藍隊</VALUE>
<VALUE Lang="tw">參加人數 : 5 vs 5 (個人申請, 自動配對)</VALUE>
<VALUE Lang="tw">參加條件 : Lv 230以上</VALUE>
