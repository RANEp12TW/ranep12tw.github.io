</SENTENSE>
<SENTENSE Ver="1" Id="TOURNAMENT_PVP_CTF_MAPNAME_LOW">
<VALUE Lang="tw">搶旗戰場 (Lv.200 ~ 229)</VALUE>
</SENTENSE>
