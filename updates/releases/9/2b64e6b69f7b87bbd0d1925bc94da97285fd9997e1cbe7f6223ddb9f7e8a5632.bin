</SENTENSE>
<SENTENSE Ver="1" Id="GUIDESUMMONS_MOB_POWER_20">
<VALUE Lang="tw">%1%的傷害估計大約是%2%! 我可不想失去朋友</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="GUIDESUMMONS_MOB_POWER_21">
