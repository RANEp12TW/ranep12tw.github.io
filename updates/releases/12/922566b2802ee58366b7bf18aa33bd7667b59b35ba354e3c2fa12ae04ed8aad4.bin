  <SENTENSE Ver="1" Id="ID_3180_063">
    <VALUE Lang="id">Special Pumpkin Mask[15D] created for Holloween day, will increase character ability while equipped.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3180_064">
    <VALUE Lang="id">Right click to open this box and get the 'Pumpkin Mask[15D]'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3180_065">
    <VALUE Lang="id">Right click to open this box and get the 'Heinous Prisoner Costume 15D'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3180_066">
    <VALUE Lang="id">Can combine with normal cloth. Left click the costume and drag to the preferable armor and right click on it.</VALUE>
  </SENTENSE>
