  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3120_024">
    <VALUE Lang="id">The ring handed down by the Mystic Guardian possessing great power. DEF +2, resistance +5, HP MP SP recovery rate +0.30%. Valid for seven days.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3120_025">
    <VALUE Lang="id">The ring handed down by the Mystic Guardian possessing great power. DEF +2, resistance +5, HP MP SP recovery rate +0.30%. Valid for fifteen days.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3120_026">
    <VALUE Lang="id">The ring handed down by the Mystic Guardian possessing great power. DEF +2, resistance +5, HP MP SP recovery rate +0.30%. Valid for thirty days.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3120_027">
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3120_028">
    <VALUE Lang="id">Blessed by the guardian of Sacred Gate, this tiara possesses great power granting its female users DEF +9, Evasion Rate +9, Resistance +9, Hp + MP+ SP Recovery Rate +0.30%. Valid for seven days.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3120_029">
