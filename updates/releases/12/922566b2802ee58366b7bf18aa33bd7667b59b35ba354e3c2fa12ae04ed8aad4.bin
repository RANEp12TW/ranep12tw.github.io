  <SENTENSE Ver="1" Id="ID_400_449">
    <VALUE Lang="id">Event Coin untuk menyambut Festival 1 Tahun Saint Foundation. Bawa 5 Coin ke College Representative dan tukar dengan Festival Lunch Box (Attack). Item akan dihapus ketika event selesai.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_400_450">
    <VALUE Lang="id">Event Coin untuk menyambut Festival 1 Tahun Saint Foundation. Bawa 3 Coin ke College Representative dan tukar dengan Festival Lunch Box (Defense). Item akan dihapus ketika event selesai.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_400_451">
    <VALUE Lang="id">Item Buff yang dipersiapkan Saint Foundation selama Festival saja. Klik kanan untuk menggunakan. Attack +8% selama 45 menit. Item akan dihapus ketika event selesai.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_400_452">
    <VALUE Lang="id">Item Buff yang dipersiapkan Saint Foundation selama Festival saja. Klik kanan untuk menggunakan. Defense +8% selama 45 menit. Item akan dihapus ketika event selesai.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_400_453">
    <VALUE Lang="id">Hadiah Spesial untuk menyambut Festival 1 Tahun Saint Foundation. Buka untuk mendapatkan berbagai macam hadiah di dalam. Item akan dihapus ketika durasi selesai.</VALUE>
  </SENTENSE>
