    <VALUE Lang="id">Senjata yang disediakan untuk pemula. Item ini tidak dapat ditukar, tidak dapat disimpan di locker atau diperkuat. Item ini dapat dibuang menggunakan Garbage Card</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_200">
    <VALUE Lang="id">Weapon Exchange yang disediakan untuk para pemula. Bawa ke 'Newbie Instructor' setelah mencapai level 10. Tidak dapat diganti setelah mencapai level 100 dan dapat dibuang dengan Garbage Card</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_201">
    <VALUE Lang="id">Pet, hadiah untuk para pemula. Dapat dipakai sampai Level 100. Klik kanan untuk mensummon Pet dan tombol 'L' untuk melihat status dari Pet.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_202">
    <VALUE Lang="id">Klik kanan untuk menggunakan item ini ketika Pet sedang dalam keadaan disummon untuk membuat pet dapat menggunakan skill ini. Skill dapat diatur dengan menekan tombol 'L'.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_203">
    <VALUE Lang="id">Klik kanan untuk membuka kemasan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_204">
    <VALUE Lang="id">Capai level 10 dan klik kanan untuk membuka box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_205">
    <VALUE Lang="id">Capai level 20 dan klik kanan untuk membuka box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_206">
    <VALUE Lang="id">Jual untuk mendapatkan 10,000 Golds kepada College Representative NPC di Market Place.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_207">
    <VALUE Lang="id">Habis setelah 7 Hari. EXP +50%. Dapat digunakan sampai level 100 saja.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_208">
    <VALUE Lang="id">Capai level 30 dan klik kanan untuk membuka box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_209">
    <VALUE Lang="id">Klik kanan untuk membuka 'Reform Slot'. Letakkan item di Reform Slot dan klik tombol 'OK; untuk mereformnya. Hilang setelah 1 hari.</VALUE>
  </SENTENSE>
