  <SENTENSE Ver="1" Id="ID_127_305">
    <VALUE Lang="id">Item hasil penelitian yang didapat setelah mengalahkan Tagger Choi. Kamu dapat menukarkannya dengan berbagai hadiah dengan berbicara ke Obinain NPC yang muncul setelah Tagger Choi dikalahkan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_127_306">
    <VALUE Lang="id">Obinain Random Box yang sangat berharga. Kamu boleh mendapatkan salah satu isinya secara acak.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_127_307">
    <VALUE Lang="id">Kotak ini mengandung 3 paket Special Healthy Drink (450).</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_127_308">
    <VALUE Lang="id">Buka dengan klik kanan mouse.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_127_309">
    <VALUE Lang="id">Buka dengan klik kanan mouse.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_127_310">
    <VALUE Lang="id">Boleh mendapatkan salah satu kartu dengan Random Option secara acak.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_127_311">
    <VALUE Lang="id">Boleh mendapatkan salah satu kartu dengan Random Option secara acak.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_127_312">
    <VALUE Lang="id">Kotak ini mengandung 10 buah PET Feed</VALUE>
  </SENTENSE>
