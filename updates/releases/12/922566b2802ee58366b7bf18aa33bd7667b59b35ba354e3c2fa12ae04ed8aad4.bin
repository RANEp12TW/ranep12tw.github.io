  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_180_255">
    <VALUE Lang="id">Robot ini sudah dirangkai dengan superalloy. Robot yang disummon dapat memberikan kemampuan tertentu untuk pemiliknya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_180_256">
