  <SENTENSE Ver="1" Id="ID_455_009">
    <VALUE Lang="id">Kartu tersembunyi di dalam Kapsul! Premium Inventory Expansion. Klik kanan untuk membuka inventori yang tersembunyi~! Ingat, hanya terbuka selama 24 jam saja [Dari Capsule Genie]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_010">
    <VALUE Lang="id">Box berisi Chicken Costume Set.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_011">
    <VALUE Lang="id">Pilih dengan klik kiri dan arahkan di topi yang diinginkan lalu klik kanan untuk menggabungkannya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_012">
    <VALUE Lang="id">Pilih dengan klik kiri dan arahkan di baju yang diinginkan lalu klik kanan untuk menggabungkannya.</VALUE>
