  <SENTENSE Ver="1" Id="ID_106_121">
    <VALUE Lang="id">Teleport langsung ke titik semula. Klik kanan untuk menggunakannya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_122">
    <VALUE Lang="id">Teleport langsung ke titik kembali sebelumnya. Klik kanan untuk menggunakannya</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_123">
    <VALUE Lang="id">Teleport ke map lain secara langsung tanpa menggunakan bus dari Bus Stop atau berjalan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_124">
    <VALUE Lang="id">Dapat mengakses locker dimanapun dan kapanpun. Klik kanan untuk menggunakannya</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_125">
    <VALUE Lang="id">Dapat teleport langsung ke posisi teman yang telah terdaftar. Dapat digunakan melalui menu "Friend List".</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_126">
    <VALUE Lang="id">Kartu untuk membuka mailbox dimanapun dan kapanpun. Klik kanan untuk menggunakannya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_127">
    <VALUE Lang="id">Jika karakter anda tewas, item ini akan memulihkannya langsung di tempat, tanpa penalti EXP.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_128">
    <VALUE Lang="id">Attack +7% selama 45 Menit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_129">
    <VALUE Lang="id">Defense +7% selama 45 Menit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_130">
    <VALUE Lang="id">Accuracy +8 selama 45 Menit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_131">
    <VALUE Lang="id">Aviod Rate +8 selama 45 Menit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_132">
    <VALUE Lang="id">Attack +4% dan Accuracy +4 selama 45 Menit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_133">
    <VALUE Lang="id">Defense +4% dan Avoid Rate +4 selama 45 Menit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_106_134">
    <VALUE Lang="id">20%~100% EXP tambahan a kan diberikan secara acak jika menggunakan item ini. Maksimum 4 buah Item dapat digunakan sekaligus: Durasi setiap item berjalan terpisah. (EXP yang didapatkan akan berlipat ganda jika menggunakan item ini).</VALUE>
  </SENTENSE>
