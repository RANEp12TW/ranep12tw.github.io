  <SENTENSE Ver="1" Id="ID_3120_021">
    <VALUE Lang="id">A mysterious box granted by the Phoenix Guardian. It randomly generates 1 item. Some say that they got a Crafter's Pouch and others an Oblivion Potion E. Right click to use.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3120_022">
