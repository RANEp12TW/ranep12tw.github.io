  <SENTENSE Ver="1" Id="ID_703_002">
    <VALUE Lang="id">Item tradable yang dapat ditukar dengan Beloved Alumni GiftBox yang berisi cinta Scarlet untuk adik-adik kelasnya. User dapat mendapatkan item ini melalui quest harian. ※ Kotak akan hilang setelah 1 hari, harap tukarkan sebelum ia menghilang. Semoga kamu </VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_703_003">
    <VALUE Lang="id">[level131 ~ level189] Adik-adik kelas yang tercinta. Saya terharu kalian telah datang. Terimalah ini dan cepat berlatih agar menjadi kuat.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_703_004">
    <VALUE Lang="id">[level131 ~ level189] Adik-adik kelas yang tercinta. Saya terharu kalian telah datang. Terimalah ini dan cepat berlatih agar menjadi kuat.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_703_005">
    <VALUE Lang="id">[level190] Adik-adik kelas yang tercinta. Saya terharu kalian telah datang. Sedikit lagi dan kamu a kan menjadi sangat kuat! Saya harus berhati-hati agar tidak jatuh hati nanti. Ho ho ho</VALUE>
  </SENTENSE>
