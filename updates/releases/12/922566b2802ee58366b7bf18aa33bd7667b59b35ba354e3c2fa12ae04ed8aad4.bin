  <SENTENSE Ver="1" Id="ID_704_062">
    <VALUE Lang="id">Ketika pet telah dipanggil, Mouse klik-kanan scroll ini untuk belajar skill. Skill ini akan memperbolehkan pet kamu mengambil semua item disekeliling.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_704_063">
    <VALUE Lang="id">Ketika pet telah dipanggil, Mouse klik-kanan scroll ini untuk belajar skill. Skill ini akan memperbolehkan pet kamu menggunakan HP potion di dalam inventory untuk memulihkan HPmu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_704_064">
    <VALUE Lang="id">Mouse klik kiri untuk memilih, taruh diatas pet card kamu dan klik kanan untuk mengisi kelaparan pet anda ke 100%.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_704_065">
