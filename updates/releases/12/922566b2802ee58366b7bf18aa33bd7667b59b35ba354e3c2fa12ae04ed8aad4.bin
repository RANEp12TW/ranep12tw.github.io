  <SENTENSE Ver="1" Id="ID_260_000">
    <VALUE Lang="id">Kategori untuk Level 100 ke bawah.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_001">
    <VALUE Lang="id">Klik kanan untuk membuka kemasan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_002">
    <VALUE Lang="id">EXP x 1.5 untuk 7 jam dengan kemampuan Resurrection Rosary.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_003">
    <VALUE Lang="id">Tekan tombol 'V' untuk menaiki. Tombol 'N' untuk melihat S.R.C status.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_004">
    <VALUE Lang="id">Weapon Exchange Card sebagai hadiah untuk para pemula. Mereka dapat menukarnya senjatanya di 'Newbie Guide' yang ada di Market Place ketika mencapai Lv 10.Tidak dapat digunakan setelah Lv 100.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_005">
    <VALUE Lang="id">Pet, hadiah untuk para pemula. Dapat dipakai sampai Level 100. Klik kanan untuk mensummon Pet dan tombol 'L' untuk melihat status dari Pet.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_006">
    <VALUE Lang="id">Klik kanan untuk menggunakan item ini ketika Pet sedang dalam keadaan disummon untuk membuat pet dapat menggunakan skill ini. Skill dapat diatur dengan menekan tombol 'L'.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_260_007">
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
