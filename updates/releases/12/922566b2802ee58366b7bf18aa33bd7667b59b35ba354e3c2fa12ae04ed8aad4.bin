  <SENTENSE Ver="1" Id="ID_810_000">
    <VALUE Lang="id"> -Ran In the Pocket akan membantu Student Leaders di petualangan Ran World. ♡-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_001">
    <VALUE Lang="id">Gem ini dapat digunakan di Ran In the Pocket. Gunakanlah tab yang berada di bagian bawah versi PC dari Ran Online untuk mengirim Gem ke Ran In the Pocket. -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_002">
    <VALUE Lang="id">Gem set berisi 150 pcs Gem dan tambahan 20 untuk anda sebagai bonus! -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_003">
    <VALUE Lang="id">Kantong Gem berisi 150 pcs Gem dan tambahan 50 untuk anda sebagai bonus! -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_004">
    <VALUE Lang="id">Karung Gem berisi 500 pcs Gem dan tambahan 80 untuk anda sebagai bonus! -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_005">
    <VALUE Lang="id">Keranjang Gem berisi 800 pcs Gem dan tambahan 150 untuk anda sebagai bonus! -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_006">
    <VALUE Lang="id">Kotak Gem berisi 2000 pcs Gem dan tambahan 360 untuk anda sebagai bonus! -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_007">
    <VALUE Lang="id">Kotak Gem berisi 4000 pcs Gem dan tambahan 800 untuk anda sebagai bonus! -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_008">
    <VALUE Lang="id">Item ini memperbolehkan anda menyambungkan karakter di Ran World dan Ran In the Pocket. Dengan menyambungkannya, anda bisa mendapatkan banyak hadiah dengan menukar M Point anda. ※Klik kanan untuk menggunakannya. Lalu set nickname anda dan link karakter anda. Setelah anda menyambungkannya anda bisa cek info karakter yang telah tersambung dari tab mobile di bagian bawah versi PC. -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_009">
    <VALUE Lang="id">Berisi 1 Ran In the Pocket Character Link Ticket dan tambahan 20 Gem untuk memberi selamat pada anda setelah menyambungkan karakter! -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_010">
    <VALUE Lang="id">Berisi 1 Ran In the Pocket Character Link Ticket dan tambahan 150 + 50 Gem untuk memberi selamat pada anda setelah menyambungkan karakter! -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_810_011">
    <VALUE Lang="id">Berisi 1 Ran In the Pocket Character Link Ticket dan tambahan 300 + 110 Gem untuk memberi selamat pada anda setelah menyambungkan karakter! -Selamat Datang di Ran In the Pocket-</VALUE>
  </SENTENSE>
