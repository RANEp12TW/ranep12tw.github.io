  <SENTENSE Ver="1" Id="ID_452_095">
    <VALUE Lang="id">Ini adalah model BT-7 yang diproduksi secara masal dimana teknologinya difokuskan di tenaganya. Equip di karakter slot kamu lalu tekan tombol 'V' untuk menggunakannya dan tombol 'N' untuk melihat statusnya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_452_096">
    <VALUE Lang="id">Ini adalah model BT-5, Prototype dari jenis S.C Bike. Equip di karakter slot kamu lalu tekan tombol 'V' untuk menggunakannya dan tombol 'N' untuk melihat statusnya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_452_097">
    <VALUE Lang="id">Model terakhir dari BT type dimana sudah diupgrade bagian keamanan dan mempunyai fungsi dari BT-7. Equip di karakter slot kamu lalu tekan tombol 'V' untuk menggunakannya dan tombol 'N' untuk melihat statusnya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_452_098">
    <VALUE Lang="id">Ini adalah model EV-1, Prototyple paling pertama dari jenis S.C Bike. Equip di karakter slot kamu lalu tekan tombol 'V' untuk menggunakannya dan tombol 'N' untuk melihat statusnya.</VALUE>
  </SENTENSE>
