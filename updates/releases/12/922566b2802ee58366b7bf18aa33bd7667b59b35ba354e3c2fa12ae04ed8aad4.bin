  <SENTENSE Ver="1" Id="ID_180_252">
    <VALUE Lang="id">Semua part harus dirangkai sendiri. Robot yang disummon dapat memberikan kemampuan tertentu untuk pemiliknya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_180_253">
    <VALUE Lang="id">Robot ini dapat bergerak cepat tapi tidak terlalu berguna dalam perang. Robot yang disummon dapat memberikan kemampuan tertentu untuk pemiliknya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_180_254">
