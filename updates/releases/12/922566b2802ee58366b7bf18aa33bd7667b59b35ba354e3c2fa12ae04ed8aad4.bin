  <SENTENSE Ver="1" Id="ID_001_053">
    <VALUE Lang="id">Surat yang dijatuhkan oleh magpie. Kumpulkan 100 surat dan tukar dengan Box of Present yang berisi Bridegroom Suit.</VALUE>
