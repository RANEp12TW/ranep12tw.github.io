  <SENTENSE Ver="1" Id="ID_455_001">
    <VALUE Lang="id">Kamu dapat menggunakan Destiny Box jika memerlukannya! Klik kanan untuk membuka kemasan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_002">
    <VALUE Lang="id">Box berisi 3 buah Premium Destiny Box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_003">
    <VALUE Lang="id">Sengaja dipersiapkan sebagai cinta dari Ran World~! Buang ke lantai untuk dipakai.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_004">
    <VALUE Lang="id">Sengaja dipersiapkan sebagai cinta dari Ran World~! Buang ke lantai untuk dipakai.</VALUE>
  </SENTENSE>
