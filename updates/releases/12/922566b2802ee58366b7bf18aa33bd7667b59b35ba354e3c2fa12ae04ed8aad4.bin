    <VALUE Lang="id">Pilih dengan klik kiri dan arahkan di sepatu yang diinginkan lalu klik kanan untuk menggabungkannya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_455_016">
