  <SENTENSE Ver="1" Id="ID_3316_056">
    <VALUE Lang="id">Treasure Box acquired from hunted mobs in the Forbidden tower.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3316_057">
    <VALUE Lang="id">Lunch box made by the spirit of warrior. It can increase 7% attack and 2% HP for 30 minutes when used.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3316_058">
    <VALUE Lang="id">Lunch box of Murakano. It can increase 5% EXP and 2% HP for 30 minutes when used.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3316_059">
    <VALUE Lang="id">Lunch box made in Forbidden tower. It can increase 4% Attack speed and 2% HP for 30 minutes when used.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3316_060">
    <VALUE Lang="id">Medal of Forbidden tower can be exchanged with ran gold to NPC.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="ID_3316_061">
    <VALUE Lang="id">Mount it on a ring to get extra option. But, be careful not to mount it on a durational ring because when such ring expires the jewel will vanish together.</VALUE>
  </SENTENSE>
