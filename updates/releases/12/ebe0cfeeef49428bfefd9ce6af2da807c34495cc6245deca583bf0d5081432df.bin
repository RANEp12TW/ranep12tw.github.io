    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3260_201">
        <VALUE Lang="tw">¨ÜUFO Turtle [Newbie]</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3260_201">
        <VALUE Lang="tw">Pet, presented to newbies. Usable until character Lv. 100. Summon the PET with right mouse click. Press 'L' key to view the PET info when PET is summoned.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3260_202">
        <VALUE Lang="tw">¨ÜScroll of PET HP Recovery</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3260_202">
        <VALUE Lang="tw">Use it with click of right mouse button while your PET is summoned. Must assign the learned skill in the PET window opened with 'L' button to enable PET to execute the skill.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3260_203">
        <VALUE Lang="tw">¨ÜNewbie Welcoming Kit</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3260_203">
        <VALUE Lang="tw">Open the box with right mouse click</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3260_204">
        <VALUE Lang="tw">¨ÜLv 10 Gift Pack</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3260_204">
        <VALUE Lang="tw">Reach level 10 and open the box with right mouse click.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3260_205">
        <VALUE Lang="tw">¨ÜLv 20 Gift Pack</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3260_205">
        <VALUE Lang="tw">Reach level 20 and open the box with right mouse click.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3260_206">
        <VALUE Lang="tw">¨ÜLucky Coin</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3260_206">
        <VALUE Lang="tw">Sell it for 10,000 Golds to College Representative NPC at Market Place</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3260_207">
        <VALUE Lang="tw">¨ÜAdoniechus Hat [7D]</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3260_207">
        <VALUE Lang="tw">Expires after 7 Days. EXP earned from hunting monsters will increase up to 150%. Usable up to level 100 only.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3260_208">
        <VALUE Lang="tw">¨ÜLv 30 Gift Pack</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3260_208">
