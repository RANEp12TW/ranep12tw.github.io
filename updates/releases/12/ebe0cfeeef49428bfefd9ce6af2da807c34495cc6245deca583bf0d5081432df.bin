        <VALUE Lang="tw">¨ÜOption Randomizer [1D]</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3260_209">
        <VALUE Lang="tw">Randomly assigns 0 ~ 4 options into items. Right-Click to open the Option Randomizer Window. This item will expire after 24 Hours.</VALUE>
