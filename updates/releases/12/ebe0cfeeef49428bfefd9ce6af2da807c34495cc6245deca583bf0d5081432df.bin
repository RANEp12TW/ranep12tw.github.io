    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_142_244">
        <VALUE Lang="tw">哈尼熊 拉風裝禮盒(15D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_142_244">
        <VALUE Lang="tw">可用來提升武器的攻擊力, 需注意在+1~+9的精煉過程中若失敗,可能會導致精練資料消失或整個道具消失之情況發生。不可交易轉移, 使用期限15天。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_142_245">
        <VALUE Lang="tw">哈尼熊 拉風裝禮盒(30D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_142_245">
        <VALUE Lang="tw">可用來提升防具的防禦力，需注意在+1~+9的精煉過程中若失敗，可能會導致精練資料消失或整個道具消失之情況發生。不可交易轉移, 使用期限15天。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_142_246">
        <VALUE Lang="tw">哈尼熊 牛仔裝禮盒(1D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_142_246">
        <VALUE Lang="tw">防止你的武器或防具在研磨過程中消失的情形。若此情形發生時, 則消耗一顆研磨劑和一條防爆項鏈, 同時研磨屬性歸零, 但被研磨之武器或防具不消失。使用時需先裝備在身上。</VALUE>
    </SENTENSE>
