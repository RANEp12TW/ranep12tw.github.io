    <SENTENSE Ver="1" Id="IN_3113_136">
        <VALUE Lang="tw">¨ÜBridegroom Overcoat [Male] [15D]</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3113_136">
        <VALUE Lang="tw">After you have chosen the item by left-clicking on it, place the mouse cursor over the clothing [top], then right-click to initiate the merging. Although the item still can be used without merging it with the others in the set, but the item alone does not have any defensive power.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3113_137">
