    <SENTENSE Ver="1" Id="IN_119_016">
        <VALUE Lang="tw">新郎禮服禮盒(男)(3H)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_119_016">
        <VALUE Lang="tw">男人一生中最帥的時候，英挺的模樣包準讓新娘子「婚」頭。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_119_017">
        <VALUE Lang="tw">新郎西裝外套(男)(3H)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_119_017">
        <VALUE Lang="tw">按滑鼠左鍵來點選後,將滑鼠指標移動到服飾(上衣)後,再按滑鼠右鍵來進行合成,雖然不必透過合成也可使用,但道具本身是不具有任何防禦力的。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_119_018">
        <VALUE Lang="tw">新郎西裝褲(男)(3H)</VALUE>
    </SENTENSE>
