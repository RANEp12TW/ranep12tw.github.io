    <SENTENSE Ver="1" Id="IN_452_095">
        <VALUE Lang="tw">Signus</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_452_095">
        <VALUE Lang="tw">這是 a mass-produced model BT-7 which technology is focused on stable output of power. Equip it in the proper slot of inventory and then press 'V' to ride it. Possible to use S.R.C interface when 'N' button is pressed.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_452_096">
        <VALUE Lang="tw">Active Scooter</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_452_096">
        <VALUE Lang="tw">這是 a BT-5, the very first proto款 of S.C 機車. Equip it in the proper slot of inventory and then press 'V' to ride it. Possible to use S.R.C interface when 'N' button is pressed.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_452_097">
        <VALUE Lang="tw">超級機車</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_452_097">
        <VALUE Lang="tw">The latest model of BT which has 進階版safety and function of BT-7. Equip it in the proper slot of inventory and then press 'V' to ride it. Possible to use S.R.C interface when 'N' button is pressed.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_452_098">
        <VALUE Lang="tw">Free Wing Scooter</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_452_098">
        <VALUE Lang="tw">這是 a EV-1, the very first proto款 of S.C 機車. Equip it in the proper slot of inventory and then press 'V' to ride it. (EV-1 cannot use any零件)</VALUE>
    </SENTENSE>
