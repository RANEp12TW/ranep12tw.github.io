    <SENTENSE Ver="1" Id="IN_186_179">
        <VALUE Lang="tw">戒指David (30D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_186_179">
        <VALUE Lang="tw">戒指David, the 戰士 of Another World who used to use this戒指 while he was still 訓練. Shabby but it still its is exquisite looks.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_186_180">
        <VALUE Lang="tw">戒指Susia (30D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_186_180">
        <VALUE Lang="tw">Something is written inner side of戒指. ＆Forever with you' _David</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_186_181">
        <VALUE Lang="tw">戒指Daniel (30D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_186_181">
        <VALUE Lang="tw">The master 工匠 of Another World called Daniel has crafted this戒指. This戒指 will assist the熊er to overcome the challenge of 黑暗ness.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_186_182">
        <VALUE Lang="tw">- 終極部的 Open Billing物品 -</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_186_182">
        <VALUE Lang="tw">斛鬼睡 螃擊 晦喃罹 虜萇 網葭嬴檜蠱</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_186_183">
        <VALUE Lang="tw">PET Students of 黑暗side Skin包裹 (15D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_186_183">
        <VALUE Lang="tw">這是 a 隨機 skin包裹 which shifts the out look of a PET into a student who went over to the 黑暗side. Summone PET, p花邊the cursor on the寵物卡 and click right mouse button to apply the outlook. The look will last for 15 days.</VALUE>
    </SENTENSE>
