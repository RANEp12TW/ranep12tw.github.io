    <SENTENSE Ver="1" Id="IN_118_016">
        <VALUE Lang="tw">置物箱租賃卡(7D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_118_016">
        <VALUE Lang="tw">按滑鼠右鍵來使用就可增加置物箱的使用空間，擴充的置物箱空間適用於同一伺服器裡的所有的角色。7日內可無限次使用。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_118_017">
        <VALUE Lang="tw">置物箱租賃卡(30D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_118_017">
        <VALUE Lang="tw">按滑鼠右鍵來使用就可增加置物箱的使用空間，擴充的置物箱空間適用於同一伺服器裡的所有的角色。30日內可無限次使用。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_118_018">
        <VALUE Lang="tw">置物箱租賃卡(90D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_118_018">
        <VALUE Lang="tw">按滑鼠右鍵來使用就可增加至物箱的使用空間.擴充的置物箱空間適用於同一伺服器裡的所有的角色，90日內可無限次使用。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_118_019">
        <VALUE Lang="tw">置物箱租賃卡(15D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_118_019">
        <VALUE Lang="tw">按滑鼠右鍵來使用就可增加置物箱的使用空間，擴充的置物箱空間適用於同一伺服器裡的所有的角色。15日內可無限次使用。</VALUE>
    </SENTENSE>
