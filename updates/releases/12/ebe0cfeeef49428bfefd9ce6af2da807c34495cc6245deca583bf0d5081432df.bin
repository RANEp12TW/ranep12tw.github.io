    <SENTENSE Ver="1" Id="IN_3001_083">
        <VALUE Lang="tw">¨ÜPlum Blossom (7D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_083">
        <VALUE Lang="tw">Each of them have a limit of 7 days, when 50 of these are collected, you are able to trade them in for a Super-class Headgear with the College Snitch</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3001_084">
        <VALUE Lang="tw">¨Ü7-11 Cooked Lobster Meatball</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_084">
        <VALUE Lang="tw">skip</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3001_085">
        <VALUE Lang="tw">¨Ü7-11 Fried Flowery Pellet</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_085">
        <VALUE Lang="tw">skip</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3001_086">
        <VALUE Lang="tw">¨ÜEvent Item</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_086">
        <VALUE Lang="tw">This item has no special function. Collect 30 of these items and you can redeem special items during events</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3001_087">
        <VALUE Lang="tw">¨ÜPeace Abounds Necklace (7D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_087">
        <VALUE Lang="tw">When the necklace is worn, the following effect will take place : Defence+6, Accuracy+8. However because this item has been worn old with age, it will gradually dissapear. It will expire within 7 days of use.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3001_088">
        <VALUE Lang="tw">¨ÜPeace Abounds Necklace Gift Box (3D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_088">
        <VALUE Lang="tw">The gift box will expire within 3 days. If it has not been opened within 3 days, the gift box, including the gift inside it, will dissapear into thin air.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3001_089">
        <VALUE Lang="tw">¨ÜNew Student Previous Point Teleport Card [7D]</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_089">
        <VALUE Lang="tw">This item is not transferrable; It can teleport the user to where the user previously went with a Campus Return Card. Right-click on the item to use, it can be used without countless number of times within 7 days of first-use.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3001_090">
        <VALUE Lang="tw">¨ÜNew Student Save Point Teleport Card [7D]</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_090">
        <VALUE Lang="tw">This item is not transferrable; It can teleport the user to his</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3001_091">
        <VALUE Lang="tw">¨ÜNew Student Rosary Beads (30D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_091">
        <VALUE Lang="tw">This item is not transferrable; Because it is only used for newly registered students, it will automatically dissapear after 30 days.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_3001_092">
        <VALUE Lang="tw">¨ÜNew Student Starter Kit (30D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_3001_092">
        <VALUE Lang="tw">This item is not transferrable; Please right-click on it to begin using this item.</VALUE>
    </SENTENSE>
