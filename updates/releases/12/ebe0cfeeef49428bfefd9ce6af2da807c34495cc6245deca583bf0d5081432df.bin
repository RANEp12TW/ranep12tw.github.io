        <VALUE Lang="tw">強力的Drink of Guardian (15D)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_186_172">
        <VALUE Lang="tw">這是 a Buff物品.Click it with right mouse button to use it. It 增強的Defence by 10% for 10Mins.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_186_173">
