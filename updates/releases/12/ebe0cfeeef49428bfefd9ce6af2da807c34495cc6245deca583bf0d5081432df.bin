    </SENTENSE>
    <SENTENSE Ver="1" Id="ID_142_242">
        <VALUE Lang="tw">自動使用道具快捷鍵上的藥品，並依照擺放藥品恢復量由小到大的順序使用</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="IN_142_243">
        <VALUE Lang="tw">哈尼熊 拉風裝禮盒(7D)</VALUE>
    </SENTENSE>
