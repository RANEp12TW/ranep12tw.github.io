  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_16_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_17_0">
    <VALUE Lang="tw">選擇1個Honor Award可兌換的物品(超能部)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_17_0_1">
    <VALUE Lang="tw">兌換 CDM Honor Award Random Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_17_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_18_0">
    <VALUE Lang="tw">選擇1個Honor Award可兌換的物品(忍術部)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_18_0_1">
    <VALUE Lang="tw">兌換 CDM Honor Award Random Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_18_0_2">
    <VALUE Lang="tw">回主題</VALUE>
