  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_3_0">
    <VALUE Lang="tw">最適合劍道部的字，就是《力》！ 沒錯！學習劍道可以提升您的力氣！要記住，必須經常練習，且必須在正確的動機下使用刀劍。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_3_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
