  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_1_0">
    <VALUE Lang="tw">這是Pumpkin box，長得就像我的頭！由於非常珍貴，所以一天只能領取一次唷。</VALUE>
