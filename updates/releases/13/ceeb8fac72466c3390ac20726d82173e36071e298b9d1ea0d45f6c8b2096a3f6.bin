  <SENTENSE Ver="1" Id="2013_halloween08.ntk_7_0_8">
    <VALUE Lang="tw">傀儡女娃</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_8_0">
    <VALUE Lang="tw">我是誰？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_8_0_10">
    <VALUE Lang="tw">幽靈</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_8_0_11">
    <VALUE Lang="tw">惡靈戰警</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_8_0_12">
    <VALUE Lang="tw">南瓜</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_8_0_9">
    <VALUE Lang="tw">西瓜</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0">
    <VALUE Lang="tw">辟里啪啦！知道我是誰嗎？答對就給獎。噢！不！世上沒有免費的東西！我要吃甜點！我不能沒有糖果。我不要小的！我要大顆的！</VALUE>
    <VALUE Lang="tw">5 顆 Halloween 糖果 = 謎題試卷 I</VALUE>
    <VALUE Lang="tw">5 顆 Halloween 糖果 + 1個大Halloween銀色棒棒糖= 謎題試卷r II</VALUE>
    <VALUE Lang="tw">5 顆 Halloween 糖果 + 1個大Halloween金色棒棒糖 =謎題試卷 III</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0_4">
    <VALUE Lang="tw">5 顆糖果兌換 謎題試卷 I.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0_5">
    <VALUE Lang="tw">5 顆糖果 1 個大銀色棒棒糖 兌換 謎題試卷 II.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0_6">
    <VALUE Lang="tw">5 顆糖果 1 個大金色棒棒糖 兌換 謎題試卷 III</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0">
    <VALUE Lang="tw">哈嘍！您喜歡吃糖嗎？不喜歡的話，可以把它給我嗎？</VALUE>
    <VALUE Lang="tw">2顆Halloween 糖果 = Pet skin card [Jack-o』-Lantern] (15D)</VALUE>
    <VALUE Lang="tw">1個大的Halloween銀色棒棒糖 = 1 南瓜禮盒</VALUE>
    <VALUE Lang="tw">1個大的 Halloween金色棒棒糖 = Death bike (30D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_1">
    <VALUE Lang="tw">2顆糖果 兌換 Pet skin card</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_2">
    <VALUE Lang="tw">Big silver lollipop 兌換 Pumpkin box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_3">
    <VALUE Lang="tw">Big gold lollipop 兌換 Death bike(30D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_4">
    <VALUE Lang="tw">交換糖果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0">
    <VALUE Lang="tw">看你費盡千辛萬苦終於來到這裡。</VALUE>
    <VALUE Lang="tw">現在總算知道要找到我是多麼不容易的吧！</VALUE>
    <VALUE Lang="tw">現在就讓你瞧瞧利用勳章跟卡片變成其它道具的魔法！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0_1">
    <VALUE Lang="tw">兌換特別物品需要什麼樣的材料呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0_2">
    <VALUE Lang="tw">我拿到材料了！給我特別物品吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_2_0">
    <VALUE Lang="tw">Pierrot Badge 50個 + Joker Badge 40個</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">= Jester King's Hat</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Pierrot Badge 75個 + Joker Badge 50個 +</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Joker Card 50個</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">= Joker Look Box (7D)</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Pierrot Badge 100個 + Joker Badge 75個 +</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Joker Card 7個</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">= Joker Bike (7D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_2_0_1">
    <VALUE Lang="tw">好！現在給我物品吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0">
    <VALUE Lang="tw">您想要那種道具呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_1">
    <VALUE Lang="tw">我要Jester King的帽子。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_2">
    <VALUE Lang="tw">我想要Joker Look Box！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_3">
    <VALUE Lang="tw">我想要Joker Bike！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_0">
    <VALUE Lang="tw">哇！您打敗了 Medusa了！ 去收集獎盃吧！</VALUE>
    <VALUE Lang="tw">我會幫您合成的。</VALUE>
    <VALUE Lang="tw">________________________________________________________</VALUE>
    <VALUE Lang="tw">[選單]</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Hair of Medusa (30ea) + Snake Scale (30ea)</VALUE>
    <VALUE Lang="tw">+ Piece of Snake Stone (30ea) + Vitality of Medusa (10ea)</VALUE>
    <VALUE Lang="tw">+ 100,000 Gold = Medusa Trophy A\r\</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_0_1">
    <VALUE Lang="tw">合成獎盃</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1">
    <VALUE Lang="tw">您知道2013年是蛇年嗎？</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">現在校園充斥著Medusa蛇妖的氣息，牠不停地在Ran世界裡製造破壞。</VALUE>
    <VALUE Lang="tw">我們需要各位同學幫忙，一起消滅Medusa，拯救校園。</VALUE>
    <VALUE Lang="tw">我是一個傷兵，沒辦法跟你一起去。有什麼其它問題再來問我吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_1">
    <VALUE Lang="tw">我該如何召喚Medusa呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_2">
    <VALUE Lang="tw">請提示我該如何消滅 Medusa。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_3">
    <VALUE Lang="tw">我已經消滅了Medusa！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0">
    <VALUE Lang="tw">想要找到 Medusa必須使用Flute！</VALUE>
    <VALUE Lang="tw">學校的怪物身上有機會可找到這些笛子Flute！</VALUE>
    <VALUE Lang="tw">記得使用不同的笛子可以召喚不同的Medusa獎勵也會有差異</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0_1">
    <VALUE Lang="tw">噢！我瞭解！</VALUE>
    <VALUE Lang="tw">您能提示我關於如何能打敗Medusa嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0_2">
    <VALUE Lang="tw">我已經消滅了Medusa！我可以拿獎勵了嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0">
    <VALUE Lang="tw">Medusa擁有石化的技能效果大家要小心</VALUE>
    <VALUE Lang="tw">如果使用抗石化頭盔就可以有防護效果</VALUE>
    <VALUE Lang="tw">合成時還可有其他效果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0_1">
    <VALUE Lang="tw">請再告訴我一次召喚Medusa的方法。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0_2">
    <VALUE Lang="tw">我已經消滅了Medusa！我可以拿獎勵了嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_4_0">
    <VALUE Lang="tw">哇！您已經殲滅了Medusa！</VALUE>
    <VALUE Lang="tw">快快收集獎盃吧！成後把戰利品帶來使用合成可以獲得獎勵!</VALUE>
    <VALUE Lang="tw">合成有失敗的機率!Hair of Medusa (30ea) + Snake Scale (30個) + Piece of Snake Stone (30個) + Vitality of Medusa (10個)+ 100,000 Gold = Medusa Trophy A</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">/</VALUE>
    <VALUE Lang="tw">Hair of Medusa (30ea) + Snake Scale (30ea)</VALUE>
    <VALUE Lang="tw">+ Piece of Snake St</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_4_0_1">
    <VALUE Lang="tw">合成獎盃</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer.ntk_1_0">
    <VALUE Lang="tw">活動地圖等級30~130已開放。</VALUE>
    <VALUE Lang="tw">請購買公車卡，並移動至活動地圖。</VALUE>
    <VALUE Lang="tw">*[Lv. 30~130的活動開始時間 ]</VALUE>
    <VALUE Lang="tw">[1:00], [5:00], [9:00], [13:00], [17:00], [21:00]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer.ntk_1_0_1">
    <VALUE Lang="tw">移動至活動地圖</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer.ntk_1_0_2">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0">
    <VALUE Lang="tw">有些元素激發了Saint Power Plant No.2.。</VALUE>
    <VALUE Lang="tw">有許多怪物，但他們不是很強。請快消滅他們！</VALUE>
    <VALUE Lang="tw">殲滅越多，可拿到越好的獎勵。 您可透過位在各個學院的Elemental Shaman NPC來進入活動地圖。</VALUE>
    <VALUE Lang="tw">*</VALUE>
    <VALUE Lang="tw">---開放時間---</VALUE>
    <VALUE Lang="tw">[LV30～130]</VALUE>
    <VALUE Lang="tw">1:00，5:00，9:00，13:00，17:00，21:00</VALUE>
    <VALUE Lang="tw">[Lv131～195]</VALUE>
    <VALUE Lang="tw">1:40，5:45，9:45，13:45，17:45，21:45</VALUE>
    <VALUE Lang="tw">[Lv196以上] \</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0_1">
    <VALUE Lang="tw">該如何去 Saint Power Plant No.2？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0_2">
    <VALUE Lang="tw">獎勵如何哪？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0_3">
    <VALUE Lang="tw">我已經殲滅完成！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_2_0">
    <VALUE Lang="tw">您可透過位在各個學院的Elemental Shaman NPC來進入活動地圖。</VALUE>
    <VALUE Lang="tw">*</VALUE>
    <VALUE Lang="tw">---開放時間---</VALUE>
    <VALUE Lang="tw">[Lv30~130]</VALUE>
    <VALUE Lang="tw">1:00, 5:00, 9:00, 13:00, 17:00, 21:00</VALUE>
    <VALUE Lang="tw">*</VALUE>
    <VALUE Lang="tw">[Lv131~195]</VALUE>
    <VALUE Lang="tw">1:40, 5:45, 9:45, 13:45, 17:45, 21:45</VALUE>
    <VALUE Lang="tw">*</VALUE>
    <VALUE Lang="tw">[Lv196 以上]</VALUE>
    <VALUE Lang="tw">2:30, 6:30, 10:30, 14:30, 18:30, 22:30</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_2_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_3_0">
    <VALUE Lang="tw">Saint Power Plant No.2 的怪物會掉落一個證書來證明您消滅的數量。收集它，我會幫你兌換些有用的物品。殲滅越多，可拿到越好的獎勵。</VALUE>
    <VALUE Lang="tw">--[ 兌換活動小幫手 ]---</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">*</VALUE>
    <VALUE Lang="tw">1,000 kill</VALUE>
    <VALUE Lang="tw">-&gt; Fresh water</VALUE>
    <VALUE Lang="tw">8,000 kill</VALUE>
    <VALUE Lang="tw">-&gt; Costume (1D) 或是 Fresh water (Item to compound potion)</VALUE>
    <VALUE Lang="tw">50,000 kill</VALUE>
    <VALUE Lang="tw">-&gt; Costume (7D) or Taxi c</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_4_0">
    <VALUE Lang="tw">哇！您收集了很多。請選擇您想要的獎勵！</VALUE>
    <VALUE Lang="tw">*</VALUE>
    <VALUE Lang="tw">1,000 kill</VALUE>
    <VALUE Lang="tw">-&gt; Fresh water</VALUE>
    <VALUE Lang="tw">8,000 kill</VALUE>
    <VALUE Lang="tw">-&gt; Costume (1D) or Fresh water (Item to compound potion)</VALUE>
    <VALUE Lang="tw">50,000 kill</VALUE>
    <VALUE Lang="tw">-&gt; Costume (7D) or Taxi card (10P)</VALUE>
    <VALUE Lang="tw">80,000 kill</VALUE>
    <VALUE Lang="tw">-&gt; Costume (15D) or Gold beret (15D) or Ring costu</VALUE>
  </SENTENSE>
