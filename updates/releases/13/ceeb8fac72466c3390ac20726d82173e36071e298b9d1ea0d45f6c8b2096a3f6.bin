    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_1_0_2">
    <VALUE Lang="tw">變更開始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_1_0_3">
    <VALUE Lang="tw">반지를 받는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_1_1">
    <VALUE Lang="tw">您您似乎已經去Administration Office確認過了，對嗎？</VALUE>
    <VALUE Lang="tw">那邊怎麼樣呢？</VALUE>
    <VALUE Lang="tw">嗯.. 那就是帶子cassette嗎？</VALUE>
    <VALUE Lang="tw">狀況似乎不太好。給我看看…</VALUE>
