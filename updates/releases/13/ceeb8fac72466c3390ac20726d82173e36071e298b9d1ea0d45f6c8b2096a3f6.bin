  <SENTENSE Ver="1" Id="npc_3_medic_1.ntk_1_0_7">
    <VALUE Lang="tw">告訴她發生了啥事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_medic_1.ntk_1_0_8">
