    <VALUE Lang="tw">消滅Boss - Sanitizer Master</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_11">
    <VALUE Lang="tw">消滅Boss - Blood Robber</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_12">
    <VALUE Lang="tw">[12/23] 消滅 Boss - Guard Captain</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_13">
    <VALUE Lang="tw">[13/23] 消滅 Boss - Joker</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_14">
    <VALUE Lang="tw">[14/23] 消滅 Boss - Jackson Leader</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_15">
    <VALUE Lang="tw">[15/23] 消滅 Boss - Wrestle Master</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_16">
    <VALUE Lang="tw">[16/23] 消滅 Boss - Violent Baldie</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_17">
    <VALUE Lang="tw">[17/23] 消滅 Boss - Ethereal Fist</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_18">
    <VALUE Lang="tw">[18/23] 消滅 Boss - Dark Swordsman</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_19">
    <VALUE Lang="tw">[19/23] 消滅 Boss - Ninja Knife</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_2">
    <VALUE Lang="tw">消滅Boss - Bandit Leader</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_20">
    <VALUE Lang="tw">[20/23] 消滅 Boss - Cruel Jupiter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_21">
    <VALUE Lang="tw">[21/23] 消滅 Boss - Dark Swordsman Jr.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_22">
    <VALUE Lang="tw">[22/23] 消滅 Boss - Dark Swordsman Jr.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_23">
    <VALUE Lang="tw">[23/23] 消滅 Boss - Dark Swordsman Jr.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_3">
    <VALUE Lang="tw">消滅Boss - Notorious Junkie</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_4">
    <VALUE Lang="tw">消滅Boss - Master Fencer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_5">
    <VALUE Lang="tw">消滅Boss - Brute Mauler</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_6">
    <VALUE Lang="tw">消滅Boss - Bruiser</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_7">
    <VALUE Lang="tw">消滅Boss - Furious Chef</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_8">
    <VALUE Lang="tw">消滅Boss - Welding Master</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_9">
    <VALUE Lang="tw">消滅Boss - Obasan</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_6_0">
    <VALUE Lang="tw">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_7_0">
    <VALUE Lang="tw">您角色的技能點數可能不夠，無法學習該等級技能。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_7_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_8_0">
    <VALUE Lang="tw">嗯.. 真是很厲害。如果下一次還有事情，需要我幫忙，</VALUE>
    <VALUE Lang="tw">請隨時跟我說。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_8_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_9_0">
    <VALUE Lang="tw">我會注意能力的強與弱。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_9_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_0">
    <VALUE Lang="tw">您準備好了嗎？我是不會放水的唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_0_1">
    <VALUE Lang="tw">是的！我準備好了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_0_2">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_0_3">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_1">
    <VALUE Lang="tw">您又變得更強了！果然是命運中的救星！您可獲得再次提升的機會，知道嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_1_1">
    <VALUE Lang="tw">詢問機會</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_1_2">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_1_3">
    <VALUE Lang="tw">我沒興趣</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_2">
    <VALUE Lang="tw">先清楚了嗎？準備好要接受最後的禮物了嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_2_1">
    <VALUE Lang="tw">準備好要接受力量</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_2_2">
    <VALUE Lang="tw">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_2_3">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_3">
    <VALUE Lang="tw">嘿嘿，我就說了吧！我們會再相見的！ 嗯~ 您似乎已經準備好要接受力量了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_3_1">
    <VALUE Lang="tw">我要接受最後的召喚！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_3_2">
    <VALUE Lang="tw">也許…..下次…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_3_3">
    <VALUE Lang="tw">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_4">
    <VALUE Lang="tw">想清楚了嗎？準備好要接受力量了嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_4_1">
    <VALUE Lang="tw">準備好要接受力量</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_4_3">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5">
    <VALUE Lang="tw">我們終於見面了！ 也許您認為我們相互只是兩個陌生人，但我為了與您的相見；為了要把力量傳給您，已經計劃很久了。懂我的苦心嗎？那麼，要開始了嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_1">
    <VALUE Lang="tw">詢問力量</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_2">
    <VALUE Lang="tw">沒興趣</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_3">
    <VALUE Lang="tw">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_4">
    <VALUE Lang="tw">Machinator的呼喚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_5">
    <VALUE Lang="tw">Machinator的呼喚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_6">
    <VALUE Lang="tw">您尚未準備完全。請充分準備好再來找我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_10_0">
    <VALUE Lang="tw">我想先測試您的實力。請試試消滅位在Prison Test Zone的 Crazy Bomber 。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_10_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_11_0">
    <VALUE Lang="tw">好的。考慮一下，準備充分再來找我吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_11_0_1">
    <VALUE Lang="tw">我能做什麼？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_11_0_2">
    <VALUE Lang="tw">我不知道</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_12_0">
    <VALUE Lang="tw">祝您好運！現在，您的實力已經強到能維持這世界的平衡了！</VALUE>
    <VALUE Lang="tw">請解救這個世界！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_12_0_1">
    <VALUE Lang="tw">我有信心！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_12_0_2">
    <VALUE Lang="tw">我會再來的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_12_0_3">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_13_0">
    <VALUE Lang="tw">嗯…… 我太高估您的實力了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_13_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_14_0">
    <VALUE Lang="tw">祝您好運！現在，您的實力已經強到能維持這世界的平衡了！</VALUE>
    <VALUE Lang="tw">請解救這個世界！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_14_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_15_0">
    <VALUE Lang="tw">嗯…… 我太高估您的實力了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_15_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_2_0">
    <VALUE Lang="tw">您有聽過7個開始起點嗎？聽說哪裡有7個固定石。雖然不曉得那是啥，但我們必須先穩住那7個固定石被摧毀的平衡，混亂現象才會結束。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_2_0_1">
    <VALUE Lang="tw">我能做什麼？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_2_0_2">
    <VALUE Lang="tw">不確定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_3_0">
    <VALUE Lang="tw">雖然您的能力還不夠強，但若是透過嚴格訓練，就可以抑制黑暗力量的話，您就可以鎮靜固定石被摧毀的平衡。願意挑戰嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_3_0_1">
    <VALUE Lang="tw">我可以的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_3_0_2">
    <VALUE Lang="tw">也許…..下次…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_3_0_3">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_4_0">
    <VALUE Lang="tw">嗯,我看人很準的。請仔細考慮看看，有心理準備後，再來找我吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_4_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_5_0">
    <VALUE Lang="tw">嗯....您真的變強了！我會一直等您，所以，一定要再回來找我唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_5_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_6_0">
    <VALUE Lang="tw">恭喜您！看來您有辦法得到更強的力量了！等您變強之後，一定要再回來…我想給您最後的禮物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_6_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_7_0">
    <VALUE Lang="tw">祝您好運！想念過去和平的日子……. 拜託您了,幫我們重新把和平找回來。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_7_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_8_0">
    <VALUE Lang="tw">我錯了！我以為您是比較厲害的那個人！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_8_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_9_0">
    <VALUE Lang="tw">我很高興您來了。我只是希望可以幫您得到新力量。請通過我的測驗，拿到新的靈珠來學習新力量吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_9_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sp_blueevil.ntk_1_0">
    <VALUE Lang="tw">"哇! 你真的膽子很大!</VALUE>
    <VALUE Lang="tw">可是你馬上會嘗到黑暗的恐怖.</VALUE>
    <VALUE Lang="tw">若你怕的話,現在馬上回到你的世界去.</VALUE>
    <VALUE Lang="tw">我會等待你的決定.</VALUE>
    <VALUE Lang="tw">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sp_blueevil.ntk_1_0_1">
    <VALUE Lang="tw">開啟商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sp_evil.ntk_1_0">
    <VALUE Lang="tw">歡迎歡迎，您有什麼生意要給我做的啊？只要記住，代價要有看頭，我才會給您機會談判。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sp_evil.ntk_1_0_1">
    <VALUE Lang="tw">恢復失去的EXP</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_square_nin_teacher.ntk_1_0">
    <VALUE Lang="tw">….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_square_nin_teacher.ntk_1_0_1">
    <VALUE Lang="tw">詢問我能做什麼.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_square_nin_teacher.ntk_1_1">
    <VALUE Lang="tw">調查結果顯示Daramais有他們自己的故事. Good Lagians將他們推向了黑暗. 儘管他們一直呆在黑暗裡, 可這些Daramais仍然能通過他們獨特的感官看到一切.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_square_nin_teacher.ntk_1_1_1">
    <VALUE Lang="tw">告訴他你將接受這個任務.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_square_nin_teacher.ntk_1_1_2">
    <VALUE Lang="tw">收到Daramai的文件信息</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_square_nin_teacher.ntk_2_0">
    <VALUE Lang="tw">希望這個報告會有幫助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_square_teacher.ntk_1_0">
    <VALUE Lang="tw">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_square_teacher.ntk_1_0_1">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_srp_seojia.ntk_1_0">
    <VALUE Lang="tw">發生了什麼事？我不記得任何事情。我想我碰到了強勁衝擊而失去了知覺，我總是看到未知的......怪異的怪物眼神….我不知道發生了什麼事，但既然你救了我的命，就讓我告訴你一些罕見的物品秘密。這是有點貴，但他們真的很難找到。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_srp_seojia.ntk_1_0_1">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_srp_seojia.ntk_1_0_2">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_srp_seojia.ntk_2_0">
    <VALUE Lang="tw">總之，非常感謝您。有緣的話，我們會再見面的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0">
    <VALUE Lang="tw">希望保護者Daian與您同在。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_1">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_10">
    <VALUE Lang="tw">將信件交給他</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_11">
    <VALUE Lang="tw">聽取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_12">
    <VALUE Lang="tw">請傳遞介紹書</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_13">
    <VALUE Lang="tw">聊聊So Sung Il的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_14">
    <VALUE Lang="tw">聊聊不明刺客的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_15">
    <VALUE Lang="tw">聊聊So Sung Il的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_16">
    <VALUE Lang="tw">詢問她在這世界發現了什麼東西</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_17">
    <VALUE Lang="tw">請傳遞標本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_18">
    <VALUE Lang="tw">請使用異界戒指</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_19">
    <VALUE Lang="tw">請交付羊皮紙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_2">
    <VALUE Lang="tw">告訴她是Tarsan送您過來的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_20">
    <VALUE Lang="tw">希望您使用咒術</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_21">
    <VALUE Lang="tw">回應她的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_22">
    <VALUE Lang="tw">希望您使用咒術</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_23">
    <VALUE Lang="tw">將 Ring of Saintroll (C)兌換為全新戒指</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_24">
    <VALUE Lang="tw">將 Ring of Saintroll (B)兌換為全新戒指</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_25">
    <VALUE Lang="tw">將 Ring of Saintroll (A)兌換為全新戒指</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_3">
    <VALUE Lang="tw">現在，告訴他您已經殲滅他們了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_4">
    <VALUE Lang="tw">請將緊急訊息交給他</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_5">
    <VALUE Lang="tw">請將Lucian的紙條交給他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_6">
    <VALUE Lang="tw">請她自我介紹一番。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_7">
    <VALUE Lang="tw">詢問她是否有要幫忙的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_8">
    <VALUE Lang="tw">告訴她您要傳達的訊息</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_1_0_9">
    <VALUE Lang="tw">將Magic Flame的碎皮交給他</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_10_0">
    <VALUE Lang="tw">我和我的同伴為了能讓我們出生的世界變得更加美好所以才會來到這裡的。戰爭只會造成兩敗俱傷。為了製造一個更加美好的世界，是需要一些強大力量的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_10_0_1">
    <VALUE Lang="tw">詢問強大力量的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_11_0">
    <VALUE Lang="tw">在很久以前，也有一些人從我們的世界來到這裡。 他們具有非常強的力量。我可以從您身上感受到這種力量。太神奇了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_11_0_1">
    <VALUE Lang="tw">告訴她您想知道更多的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_12_0">
    <VALUE Lang="tw">saintroll的力量只能由被選定的人使用。我不知道該怎麼用這世界的語言來解釋給你。如果我跟你們聊得更多，我應該就會知道了。希望您能常常來回此地。.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_12_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_13_0">
    <VALUE Lang="tw">當我們第一次來到這個世界的時候，我們其中一位同伴受傷了。還有一位同伴為了陪伴受傷的成員，一起留了下來。可以請您去找他嗎？一個是Veno，另一種是所謂的Evilplate Monk。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_13_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_13_0_2">
    <VALUE Lang="tw">問她是否知道在哪兒</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_14_0">
    <VALUE Lang="tw">我記得在海洋附近....不太確定，但....如果很難找到的話，我會直接送您過去。另外，還有一件事，若您發現Veno，請告訴他Suah現在很好，請別擔心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_14_0_1">
    <VALUE Lang="tw">告訴她您會幫他</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_15_0">
    <VALUE Lang="tw">當你準備好的時候要告訴我唷。這可能會使您頭痛或頭暈，要小心唷！準備好了嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_15_0_1">
    <VALUE Lang="tw">告訴她您已經準備好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_16_0">
    <VALUE Lang="tw">哦，太好了！但我沒有足夠的藥物供應他們。在隧道裡面會有所謂的Magic Flame怪物在徘徊。您將能取得需要的材料。請您幫我拿一些過來。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_16_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_17_0">
    <VALUE Lang="tw">好吧，現在我已經取得了足夠的藥品。請拿去給Evilplate Monk。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_17_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_18_0">
    <VALUE Lang="tw">謝謝您</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_18_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_19_0">
    <VALUE Lang="tw">還有....請您幫我送信給Evilplate Monk …..這是私人的事請，但…...請幫我這個忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_19_0_1">
    <VALUE Lang="tw">告訴她您會轉達的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_2_0">
    <VALUE Lang="tw">無民氏先生，我們曾幫助過的人……噢！您帶來了我遺失的東西。 謝謝您，非常歡迎…..噓…..安靜唷..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_2_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_2_0_2">
    <VALUE Lang="tw">問她現在何事正在發生中</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_20_0">
    <VALUE Lang="tw">謝謝您</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_20_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_21_0">
    <VALUE Lang="tw">在這個世界裡…. Adoniechus絕對起點…..應該已經找到了。謝謝..我要去告訴我的朋友！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_21_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_22_0">
    <VALUE Lang="tw">這裡很難取得外界的信息，因為這是一個與世隔絕的地方。剛剛聽說像您一樣的人有來拜訪我的消息。我想要做更多的調查，請您幫幫我，好嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_22_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_23_0">
    <VALUE Lang="tw">謝謝！我會學著透過標本來確認這兩個世界的差異。</VALUE>
    <VALUE Lang="tw">我不知道這個資料是否準確，但總比什麼都不做來的好。</VALUE>
    <VALUE Lang="tw">這是一個神秘的戒指，它擁有著Saintroll的力量。這將帶來大幫助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_23_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_24_0">
    <VALUE Lang="tw">您變得更強了。如果您找到So Sung Il的所在位置，那麼你將能夠找到擁有羊皮紙的Multilock。然後，我會給您製作更強的戒指。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_24_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_25_0">
    <VALUE Lang="tw">您給我的這張羊皮紙上面寫有古老的咒語。</VALUE>
    <VALUE Lang="tw">我不知道它是如何來到這世界的，但我可以用這個咒語，讓您的戒指變得更強。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_25_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_26_0">
    <VALUE Lang="tw">請把戒指取下來。當您帶著戒指時，我是無法使用法術的。準備好要告訴我唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_26_0_1">
    <VALUE Lang="tw">告訴她您已經準備好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_26_0_2">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_27_0">
    <VALUE Lang="tw">急著呼叫您的原因是，我已經知道了如何將Saintroll戒指的力量發揮出來的方法了。準備好要告訴我唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_27_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_28_0">
    <VALUE Lang="tw">請把戒指取下來。當您帶著戒指時，我是無法使用法術的。準備好要告訴我唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_28_0_1">
    <VALUE Lang="tw">告訴她您已經準備好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_28_0_2">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_3_0">
    <VALUE Lang="tw">我的一位同伴正監視我。可以麻煩您把它引開嗎？目前這樣我無法跟您說太多。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_3_0_1">
    <VALUE Lang="tw">告訴她您會幫忙的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_4_0">
    <VALUE Lang="tw">他很強壯的... 請小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_4_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_5_0">
    <VALUE Lang="tw">對手是Gorusi，他是一個很難擊敗又古怪的對象。他無法與人對話。要他監視我的人叫做Lucian，去找他吧。他往隧道的盡頭那段走過去了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_5_0_1">
    <VALUE Lang="tw">告訴她您會去找Lucian</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_6_0">
    <VALUE Lang="tw">要當心Gorusi隨時隨地的攻擊唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_6_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_7_0">
    <VALUE Lang="tw">您做得太棒了。他怎麼可以如此地命令Gorusi！我想他是無法相信他的黨員。您可以再回到隧道的盡頭，並再次收集更多的信息給我嗎？拜託了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_7_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_8_0">
    <VALUE Lang="tw">我明白。他怎麼能這樣對待....和他一樣的人…..謝謝您做的一切。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_8_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_9_0">
    <VALUE Lang="tw">我叫做Suah，我不是這個世界的人。我是來自 "異世界"的人。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sua.ntk_9_0_1">
    <VALUE Lang="tw">問她為何來到這裡</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0">
    <VALUE Lang="tw">…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_1">
    <VALUE Lang="tw">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_10">
    <VALUE Lang="tw">兌換 10th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_11">
    <VALUE Lang="tw">兌換 11th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_12">
    <VALUE Lang="tw">兌換 12th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_13">
    <VALUE Lang="tw">兌換 13th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_14">
    <VALUE Lang="tw">兌換 14th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_15">
    <VALUE Lang="tw">兌換 15th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_16">
    <VALUE Lang="tw">兌換 16th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_17">
    <VALUE Lang="tw">兌換 17th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_18">
    <VALUE Lang="tw">兌換 18th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_19">
    <VALUE Lang="tw">兌換 19th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_2">
    <VALUE Lang="tw">兌換 1st Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_20">
    <VALUE Lang="tw">兌換 21st Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_21">
    <VALUE Lang="tw">兌換 22nd Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_22">
    <VALUE Lang="tw">兌換 23rd Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_23">
    <VALUE Lang="tw">兌換 24th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_24">
    <VALUE Lang="tw">兌換 25th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_3">
    <VALUE Lang="tw">兌換 2nd Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_4">
    <VALUE Lang="tw">兌換 3rd Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_5">
    <VALUE Lang="tw">兌換 4th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_6">
    <VALUE Lang="tw">兌換 5th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_7">
    <VALUE Lang="tw">兌換 7th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_8">
    <VALUE Lang="tw">兌換 8th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_1_0_9">
    <VALUE Lang="tw">兌換 9th Grade 靈珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_10_0">
    <VALUE Lang="tw">您想學習哪個10等級的技能呢?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_10_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_10_0_2">
    <VALUE Lang="tw">學習Sunken Strike</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_10_0_3">
    <VALUE Lang="tw">學習Revolving Slash</VALUE>
