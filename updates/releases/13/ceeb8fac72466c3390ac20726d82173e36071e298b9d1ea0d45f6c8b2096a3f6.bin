    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_3_0">
    <VALUE Lang="tw">看了這景象之後，您還無法明白市發生了什麼事情了嗎？當我在清掃街道時，事情就變得非常不對勁了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_4_0">
    <VALUE Lang="tw">從那件事情發生之後，我們一直沒有機會逃走。到現在沒有一個人願意留下來做打掃……。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_4_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_5_0">
