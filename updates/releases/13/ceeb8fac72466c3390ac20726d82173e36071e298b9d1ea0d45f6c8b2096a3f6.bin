  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_36_0">
    <VALUE Lang="tw">達到特定等級，就能拿到Spiritual Spheres。您可自由使用Spiritual Spheres來選擇可學的技能唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_36_0_1">
    <VALUE Lang="tw">學習 Shin Ryu Attack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_36_0_2">
    <VALUE Lang="tw">學習 Dark Souls</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_36_0_3">
    <VALUE Lang="tw">學習 Shin Ryu Attack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_36_0_4">
