    <VALUE Lang="tw">聆聽故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_b.ntk_1_0_2">
    <VALUE Lang="tw">接受她的請求</VALUE>
