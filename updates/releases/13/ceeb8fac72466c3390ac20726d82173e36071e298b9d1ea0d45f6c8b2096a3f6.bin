    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_21_0">
    <VALUE Lang="tw">學生們這一段時間來都認真的練習著吧</VALUE>
    <VALUE Lang="tw">現在慢慢地要準備到外面去了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_21_0_1">
