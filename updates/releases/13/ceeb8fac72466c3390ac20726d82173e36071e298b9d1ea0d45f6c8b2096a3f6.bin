  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_110_0">
    <VALUE Lang="tw">也不必一定要走到宿舍,你到宿舍分館去打掃一下就好.</VALUE>
    <VALUE Lang="tw">走出本館往左走到底就可以看到宿舍分館的入口</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_110_0_1">
