  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_12_0">
    <VALUE Lang="tw">被派去Leonair Campus調查的學生們還沒回來, 果然這事非比尋常。從Financial Group那邊派去的專員也沒有消息。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_12_0_1">
    <VALUE Lang="tw">詢問有關學院的事情</VALUE>
  </SENTENSE>
