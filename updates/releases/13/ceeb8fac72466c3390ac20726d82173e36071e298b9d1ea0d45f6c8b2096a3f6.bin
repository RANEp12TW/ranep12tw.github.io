  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0">
    <VALUE Lang="tw">我不懂街道為何會變成這幅模樣？</VALUE>
    <VALUE Lang="tw">我算幸運的了，至少可以躲到這裡。</VALUE>
    <VALUE Lang="tw">稍微一不注意，可能連我也會遭殃的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_1">
    <VALUE Lang="tw">您在說什麼？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_10">
    <VALUE Lang="tw">詢問Freezing Halogen的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_11">
    <VALUE Lang="tw">告訴他事情的真相</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_2">
