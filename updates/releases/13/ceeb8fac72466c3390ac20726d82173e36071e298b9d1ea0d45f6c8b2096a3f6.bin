  <SENTENSE Ver="1" Id="npc_3_cheyuk_1.ntk_4_0">
    <VALUE Lang="tw">本結界認證已結束！請前往下個終端機，並完成結界認證。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_cheyuk_1.ntk_4_0_1">
