  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_8_0_1">
    <VALUE Lang="tw">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_9_0">
    <VALUE Lang="tw">複製靈-</VALUE>
    <VALUE Lang="tw">一般來說，被認定是敵人的生命體，幾乎都是以正常的精神與肉體來做成的基礎複製品。在本實驗裡，我們稱它們為複製靈。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_9_0_1">
    <VALUE Lang="tw">最初</VALUE>
  </SENTENSE>
