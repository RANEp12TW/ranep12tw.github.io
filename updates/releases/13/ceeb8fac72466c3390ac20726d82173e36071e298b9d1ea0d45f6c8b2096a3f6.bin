    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex2.ntk_3_0">
    <VALUE Lang="tw">沒錯！我死掉了..</VALUE>
    <VALUE Lang="tw">我去公園調查到一半, 不知道從Leonair學院出現什麼！！</VALUE>
    <VALUE Lang="tw">忘記是什麼東西了, 但我知道是他們殺了我！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex2.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex2.ntk_4_0">
    <VALUE Lang="tw">我明明就死了卻還可以說話, 也聽的見...</VALUE>
    <VALUE Lang="tw">我不太清楚到底怎麼回事, 不過我似乎慢慢在消失中...</VALUE>
    <VALUE Lang="tw">搞不好就這樣成為怪物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex2.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex2.ntk_5_0">
    <VALUE Lang="tw">要去找可以替代我們的人。</VALUE>
    <VALUE Lang="tw">但在這之前要先阻止從Leonair學院冒出來的東西。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex2.ntk_5_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex3.ntk_1_0">
    <VALUE Lang="tw">嗚嗚嗚</VALUE>
