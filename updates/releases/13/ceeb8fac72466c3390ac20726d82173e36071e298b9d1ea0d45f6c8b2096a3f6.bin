  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_2">
    <VALUE Lang="tw">資料檢索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_3">
    <VALUE Lang="tw">資料檢索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_4">
    <VALUE Lang="tw">資料檢索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_5">
    <VALUE Lang="tw">資料檢索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_6">
    <VALUE Lang="tw">資料檢索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_2_0">
    <VALUE Lang="tw">因為學院資料庫系統故障，資料室現在只能儲存2份檔案。我們會盡快復原所有重要的資料。請稍微閱讀一下這份文件，好嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_2_0_1">
    <VALUE Lang="tw">詢問關於劍道部學生 Chi Ri Qing。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_2_0_2">
    <VALUE Lang="tw">詢問關於弓箭部學生 Cheng Xi Zhi。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_3_0">
    <VALUE Lang="tw">Chi Ri Qing是Sacred Gate Campus2年級的劍道部修練生。雙親都因為事故而死亡，現在離開學院，單獨進行調查。</VALUE>
    <VALUE Lang="tw">萬一您有發現新情報的話，請您跟Administration Office連絡。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_4_0">
    <VALUE Lang="tw">Cheng Xi Zhi是Sacred Gate Campus2年級的弓箭部修練生。雙親都因事故而亡，現在以複製靈追尋已變異的姐姐，單獨進行中。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_5_0">
    <VALUE Lang="tw">現在沒有方法可以維持終端機的機能正常運轉。</VALUE>
  </SENTENSE>
