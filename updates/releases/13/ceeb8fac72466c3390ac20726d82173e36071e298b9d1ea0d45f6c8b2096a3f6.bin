  <SENTENSE Ver="1" Id="npc_rantto.ntk_6_0">
    <VALUE Lang="tw">행운번호를 얻기 위해서는 주화가 있어야만 해요</VALUE>
    <VALUE Lang="tw">원래는 제가 기념으로 먼저 나눠드리려고 했는데, 여기 들어오다가 몽땅 빼앗겨 버렸지 뭐예요-</VALUE>
    <VALUE Lang="tw">바깥에 체인 들고 다니는 사람들 있잖아요?</VALUE>
    <VALUE Lang="tw">그 사람들한테서 주화를 빼앗아 오면 행운번호로 바꿔드릴께요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_6_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_7_0">
    <VALUE Lang="tw">주화를 행운번호로 교환해 드릴께요</VALUE>
    <VALUE Lang="tw">한번 바꾼 행운번호는 다음 기회가 아니면 바꾸질 못하시니 신중히 생각해 보고 결정하세요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_7_0_1">
    <VALUE Lang="tw">행운번호로 교환한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_9_0">
    <VALUE Lang="tw">원하시는 행운번호가 어느 군에 속하는지 확인하신 뒤 선택해 주십시오</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">제 1군 : 1 ~ 5</VALUE>
    <VALUE Lang="tw">제 2군 : 6 ~ 10</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_9_0_1">
    <VALUE Lang="tw">제 1군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_9_0_2">
    <VALUE Lang="tw">제 2군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_reformcard.ntk_1_0">
    <VALUE Lang="tw">在這裡可更改您道具物品的隨機選項。我們無法保證您會得到什麼結果。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_reformcard.ntk_1_0_1">
    <VALUE Lang="tw">開啟商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0">
    <VALUE Lang="tw">你好~</VALUE>
    <VALUE Lang="tw">我是 Club War Processing Agent.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">此領導組織占是在Saint Complex Research Basement戰場中對認證處理器進行認證並獲得目標點數就可獲得勝利.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">想要瞭解更多內容嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_1">
    <VALUE Lang="tw">變更稅率.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_2">
    <VALUE Lang="tw">進入戰場</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_3">
    <VALUE Lang="tw">獲得點數</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_4">
    <VALUE Lang="tw">加速器效果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_5">
    <VALUE Lang="tw">組隊條件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_6">
    <VALUE Lang="tw">使用道具</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_7">
    <VALUE Lang="tw">技能限制</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_8">
    <VALUE Lang="tw">區域稅率</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_2_0">
    <VALUE Lang="tw">只能在特定時間內領導組織占.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">時間一到，就可同過我旁邊的入口進入領導組織戰.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_2_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_3_0">
    <VALUE Lang="tw">佔領中央認證機可在認證有效期間每5秒獲得10點勝利點數.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_3_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_4_0">
    <VALUE Lang="tw">破壞各區域中的認證加速器可獲得增益效果.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">認證速度加快50%，復活時間減少50%，獲得點數2倍等增益效果可逆轉當前的局勢.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">對了，要注意的是加速效果只維持三分鐘時間!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_4_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_5_0">
    <VALUE Lang="tw">無法跟其他阻止進行組隊.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">如果跟其他組織進行組隊，所組成的隊伍將自動解散，這點還請大家注意.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_5_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_6_0">
    <VALUE Lang="tw">無法使用卡片類道具. 此外也無法使用寵物和坐騎.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_6_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_7_0">
    <VALUE Lang="tw">無法在Saint Research Complex Basement中使用復活類技能.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">且在認證過程中將自動解除免疫，隱身，無視傷害等效果.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_7_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_8_0">
    <VALUE Lang="tw">在管轄地區內所發生的所有有關購買/出售的稅率將由在戰場中獲得勝利的組織master直接進行設定.如果沒有進行設定將適用基本稅率.</VALUE>
    <VALUE Lang="tw">現在設定稅率嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_8_0_1">
    <VALUE Lang="tw">變更稅率.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_8_0_2">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0">
    <VALUE Lang="tw">어서 와라</VALUE>
    <VALUE Lang="tw">뭘 도와줄까?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_1">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_2">
    <VALUE Lang="tw">검도부에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_3">
    <VALUE Lang="tw">수행 방법에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_4">
    <VALUE Lang="tw">전투 방법에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_1">
    <VALUE Lang="tw">다른 부원들은 다 나가!</VALUE>
    <VALUE Lang="tw">정신 사납다.</VALUE>
    <VALUE Lang="tw">아니면 뭐냐,</VALUE>
    <VALUE Lang="tw">볼 일이라도 있는거냐?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_1_1">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_0">
    <VALUE Lang="tw">우선 기본적인 것들을 다시 한번 알려 줄테니 잘 들어.</VALUE>
    <VALUE Lang="tw">너희들에겐 레벨업을 하는 순간 3개의 '포인트'가 할당된다.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_0_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_1">
    <VALUE Lang="tw">호오? 연습을 꽤 했나 보군!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_1_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_11_0">
    <VALUE Lang="tw">그리고 그 포인트들을 분배하는 방법에 따라 너희들의 '성장 방향'이 달라지게 되지.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_11_0_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_12_0">
    <VALUE Lang="tw">만약 힘과 체력과 민첩에 분배한다면 검으로 보다 빠른 공격을 할 수 있는 '속공형'이 될테고,</VALUE>
    <VALUE Lang="tw">힘에만 집중하다면 검이 아니라 도를 사용하며 파괴력 높은 공격을하는 '필살형'이 될거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_12_0_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_13_0">
    <VALUE Lang="tw">.....5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_0">
    <VALUE Lang="tw">선두에 서서 동료들을 지키는게 너희들이 해야 할 일이야.</VALUE>
    <VALUE Lang="tw">힘이 있으면 당연히 그래야지!</VALUE>
    <VALUE Lang="tw">주의해야 할 점은 검도부원으로서 성장한 너희들이 '스태미너'를 상대적으로 많이 소비한다는 거야</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_0_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_1">
    <VALUE Lang="tw">이거 정말 대단하군!</VALUE>
    <VALUE Lang="tw">너 언제 그렇게 강해진거냐?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_1_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_2_0">
    <VALUE Lang="tw">어느쪽이 될 지는 선택하기 나름이겠지만 ,</VALUE>
    <VALUE Lang="tw">누군가를 보호하기 위할 때에만 상대를 해하는 행동이 용서된다는 걸 명심해.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0">
    <VALUE Lang="tw">어느쪽이 될 지는 선택하기 나름이겠지만 ,</VALUE>
    <VALUE Lang="tw">누군가를 보호하기 위할 때에만 상대를 해하는 행동이 용서된다는 걸 명심해.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0_2">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_1">
    <VALUE Lang="tw">'3층'은 레벨이 최소한 '20'은 돼야 하니까, 혹시라도 지금 갈 생각은 하지 않는게 좋을거야!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_1_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_1_2">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_0">
    <VALUE Lang="tw">그리고 힘과 민첩에 2:1 비율로 분배한다면 방어에 중심을 두는 '지구전형'이 되겠고,</VALUE>
    <VALUE Lang="tw">마지막으로 힘과 민첩과 기력에 분배한다면 기를 이용할 할 수 있는 '기공형'으로 성장하게 될거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_0_2">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_1">
    <VALUE Lang="tw">그 정도면 학교 밖으로 나가 볼 수도 있겠는데?</VALUE>
    <VALUE Lang="tw">나가서 더 실력을 키워봐라!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_1_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_1_2">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_0">
    <VALUE Lang="tw">'스태미너'가 완전히 떨어지게 되면 '명중률'이나 '공격력'이 반감돼 버려서 경우에 따라서는 위험한 상황이 될 수도 있으니 무턱대고 달려 나가기만 하는 행동은 신중히 삼가해야 한다는 점을 항상 명심하고 있도록 해.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_0_2">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_1">
    <VALUE Lang="tw">너라면 지하 괴물들까지 청소해 버릴 수도 있겠는데?!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_1_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_1_2">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_6_0">
    <VALUE Lang="tw">....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_0">
    <VALUE Lang="tw">음... 검도부라...</VALUE>
    <VALUE Lang="tw">그런 걸 한마디로 말 하자면...</VALUE>
    <VALUE Lang="tw">그래, 힘을 지닌 자들이 배워야 할 기술이라고 할 수 있겠군.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_0_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_1">
    <VALUE Lang="tw">그 정도 실력으로 검도부의 본질을 알고 싶다고?</VALUE>
    <VALUE Lang="tw">아직 멀어도 한참 멀었으니, 가서 더 수련하고 와!</VALUE>
    <VALUE Lang="tw">너라면 '2층'이 아마 적당할 거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_1_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_8_0">
    <VALUE Lang="tw">힘이 있으면 할 수 있는 일이 두 가지가 있는데,</VALUE>
    <VALUE Lang="tw">누군가를 해하는 것과 그리고 누군가를 보호하는 것이지.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_8_0_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_9_0">
    <VALUE Lang="tw">......4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0">
    <VALUE Lang="tw">請給我看看您哪裡受傷了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_10">
    <VALUE Lang="tw">接受藥品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_11">
    <VALUE Lang="tw">變更開始地點</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_12">
    <VALUE Lang="tw">給看孢子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_13">
    <VALUE Lang="tw">申請Antibiotic</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_14">
    <VALUE Lang="tw">把藥材交給她</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_15">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_16">
    <VALUE Lang="tw">詢問關於 Sacred Financial Group的印象</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_17">
    <VALUE Lang="tw">詢問她需要幫助嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_18">
    <VALUE Lang="tw">交出血液樣本</VALUE>
  </SENTENSE>
