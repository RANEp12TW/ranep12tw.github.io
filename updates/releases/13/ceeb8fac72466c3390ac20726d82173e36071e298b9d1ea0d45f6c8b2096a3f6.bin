  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_0">
    <VALUE Lang="tw">今天我的頭特別癢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_1">
    <VALUE Lang="tw">聽說他很擅長倒立唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_2">
    <VALUE Lang="tw">只有在深夜時，才能看見他們的存在。</VALUE>
  </SENTENSE>
