  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_7">
    <VALUE Lang="tw">聽取建議</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_8">
    <VALUE Lang="tw">轉交材料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_9">
    <VALUE Lang="tw">戒指將升等一級。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_10_0">
    <VALUE Lang="tw">學生...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">期待這位老年人什麼?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">他呀!!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">異常地尊重對方時，一定是有什麼目的，不是嗎?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">那麼想給什麼?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">雖想擺脫這危險的地方, 但以那麼虛弱的身體，不要做夢了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_10_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_11_0">
    <VALUE Lang="tw">說什麼來看看，自然可理解嗎?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">在完全龜裂的街道上，飄了飄停在那固定的紙和車子...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">那樣的話，這地方的時間也並非完全停止...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">目前為止，學生所學過的常識</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">是完全都停止的狀況嗎?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">我認為不想要理解，也是好事 ...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">哼， 那樣看來，確實是一個是可理解的</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">這停止的時間是自然的自我防禦本能</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw"> 扮演中繼角色的, 就是財團本公司建築物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_11_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_12_0">
    <VALUE Lang="tw">哈哈哈</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">聽了這個而來</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">你真有兩下啊</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">在那方面，我所知道的...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">那潑婦附帶地說連禮物都給了</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">好像相當信任學生。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_12_0_1">
    <VALUE Lang="tw">繼續</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_13_0">
    <VALUE Lang="tw">是呀，照這那說，這老年人本來也是一位</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">那時, 和另一個世界接壤，雖不是那樣，現在，那裡完全一樣的傢伙，好像遍佈都是的樣子。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">財團的年輕人看了這個，稱為『複製令』</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">理由是連區分誰是本尊的意義都沒有</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">簡言之，無法再以人的種類來區隔</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_13_0_1">
    <VALUE Lang="tw">聽取勸告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_14_0">
    <VALUE Lang="tw">不想轉達一句有助益的話嗎?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">我認為多少要分享一點情報</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">要先說什麼?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">是呀...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">現在馬上就要見到學生真實的模樣</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">很久以前, 存在於完全不同世界時的模樣</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">那個，誰也不知道是得或是失</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">不知道那個模樣也是好事</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">現在, 在此非要和怪物打架的理由是什麼...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_14_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_15_0">
    <VALUE Lang="tw">學生曾想過嗎?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">雖相然是說為了活下來而做的，但一半是錯誤答案</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">正無意識中調整僅存的責任感</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">也有可能拒絕責任感??</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">是噢!!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_15_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_16_0">
    <VALUE Lang="tw">從觀望者的立場中可看出光明和黑暗的戰爭機會</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">指的是透過這樣的事故所給的</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">如何</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">這財團製造那種機會是向學生表達謝意嗎?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">不然的話，是像誘惑吃善惡果的蛇一樣的嗎?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">呵呵!!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">想著想著，還是蠻有趣的事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_16_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0">
    <VALUE Lang="tw">能使學生們變得更強大且能夠發揮潛力，在目前沒有自我提升的狀況，只要再努力試看看，他的能力就能夠一樣地完全開放出來的東西….。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">怎樣,要告訴你方法嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0_1">
    <VALUE Lang="tw">打聽其傳達方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0_2">
    <VALUE Lang="tw">打聽其傳達方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0_3">
    <VALUE Lang="tw">打聽其傳達方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_18_0">
    <VALUE Lang="tw">如果要改變的學生程度，視學生自身情況而運用適當的道具是必要且免不了的.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">幫助這老人變成值得去做的事，要創造一些方法可以去瞭解他們所說的話..</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">如何, 瞭解嗎? 知道嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_18_0_1">
    <VALUE Lang="tw">打聽其傳達方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_19_0">
    <VALUE Lang="tw">堅硬無比的地壓戒指... 是那樣地效果,</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">受到若干衝擊的影響，可以使身體的機能受到催化的道具呀.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">當然，只有有預期的效果, 每個人身體才會一點一滴地成長, 這個道具是針對每個人專用目的而製造，而且可以看到改變後的效果，有達到原先的預期嗎?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">換句話說...，為學生門瞭解並收集相關資料，才可以正確地製造適合他們的道具.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_19_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0">
    <VALUE Lang="tw">您想告訴老人什麼事情？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_1">
    <VALUE Lang="tw">詢問有關附近經過的學生</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_2">
    <VALUE Lang="tw">詢問有關 聖財團的 HQ</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_3">
    <VALUE Lang="tw">詢問有關老人的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_4">
    <VALUE Lang="tw">鄭重的呈上問候</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_5">
    <VALUE Lang="tw">詢問週遭的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_20_0">
    <VALUE Lang="tw">辛苦了.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">但是在這過程中要相當正確的收集.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">因為只有材料的話，並不能馬上結束...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">唉, 這裡有.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">使用看看吧.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">而且，這戒指上還可以再做些改良.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">主任的能力值增加的話，如果針對他的方法，也可以一起成長.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">適當的時候，要再進行一次搜尋.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_20_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_21_0">
    <VALUE Lang="tw">我偶然地發現珍貴的資料並在手上..</VALUE>
    <VALUE Lang="tw">聽說不久前學生製造的戒指，如果再加以改良，就可以一樣製作出更好的戒指。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_21_0_1">
    <VALUE Lang="tw">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_21_0_2">
    <VALUE Lang="tw">拒絕</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_22_0">
    <VALUE Lang="tw">我剛好手上有些貴重的材料..</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">學生們如果加入這些材料的話，說不定可以製作出更好戒指。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_22_0_1">
    <VALUE Lang="tw">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_22_0_2">
    <VALUE Lang="tw">拒絕</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_23_0">
    <VALUE Lang="tw">剛好破掉了, 真好!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">好的方法要廣為宣傳.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">不過學生們的經驗都還不足...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">萬一比你強一點的對手找碴，也就可以明白因應之道. .</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">這樣的程度的方法我喜歡，因為這些傢伙們最近在找我們的碴.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_23_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_24_0">
    <VALUE Lang="tw">嗯…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">我這個老頑固沒白活…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">你那樣問我,是不是懷疑我的判斷啊.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">我不是負責人，雖然我不是很清楚，但是看到你目前所做的事情，都值得稱讚。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_24_0_1">
    <VALUE Lang="tw">詢問財團的業績</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_25_0">
    <VALUE Lang="tw">叫什麼民俗學者?是那財團的創立者嗎…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">剛開始創立財團時比較轟動。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">是啊… 據說合併全世界的教育機關。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">領來特別選出的學生，進行免費訓練。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_25_0_1">
    <VALUE Lang="tw">繼續</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_26_0">
    <VALUE Lang="tw">據說援助了生活費…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">不僅僅是幫助學生，甚至連學生的家族都有援助.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">因此這附近的很多設施都重新建築了。積極的參與很多社會福利的事業.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_26_0_1">
    <VALUE Lang="tw">詢問他注意到的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_27_0">
    <VALUE Lang="tw">安分守己的普通市民很難親眼目睹那些事情。是啊，是不是在虎令學院前面穿上黑色大衣的年輕人？</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">如果是他，因為是負責人，應該更清楚, 不是嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_27_0_1">
    <VALUE Lang="tw">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_28_0">
    <VALUE Lang="tw">其他地方都比較開放，只有這個建築物感到有點封閉。以前看過據說有兩個階段的保安步驟…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">第一關，用眼睛看不到的晶片，移植到皮膚的人們,就能通過第一關。第二關是聲音辨識，如果沒有做註冊的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_28_0_1">
    <VALUE Lang="tw">詢問更加詳細的內容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_29_0">
    <VALUE Lang="tw">呵呵，我也不是負責人，能正確知道嗎?說不定有第三個保安步驟。啊，對了，你到碼頭就可以見到跟我一樣的老人。你去問問他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_29_0_1">
    <VALUE Lang="tw">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_3_0">
    <VALUE Lang="tw">學生? 是呀…看到了幾個人...</VALUE>
    <VALUE Lang="tw">有趣啊</VALUE>
    <VALUE Lang="tw">在這停止的時間裡，來要進行什麼</VALUE>
    <VALUE Lang="tw">那樣的話，應該要把時間連結起來...</VALUE>
    <VALUE Lang="tw">不是嗎??</VALUE>
    <VALUE Lang="tw">我好像太高估了!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_30_0">
    <VALUE Lang="tw">為什麼會有這麼不堪的保安設備，是否準備好通過那些保安設備…有點擔心啊.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">現在就算那樣也只能是進去看，這更讓人擔心…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">雖然有收到資訊…但是先進去的學生打算等從1樓進來的學生。首先去正門前面，會自動完成保安步驟。好好利用能判讀研究資料的終端機.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_30_0_1">
    <VALUE Lang="tw">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_31_0">
    <VALUE Lang="tw">自古以來這樣的感覺是特別的…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">這Eight signs of divine… 不像是我們世界的.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">分明是能夠離開這個世界的鑰匙。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">那麼，是不是想使用這個?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">如果是的話又得見血…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">這傢伙… 正在尋找血。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">嘴也非常刁…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">在那頂峰處,可能有適合這傢伙口味的一群傢伙。 …</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">不管怎樣小心啊。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_31_0_1">
    <VALUE Lang="tw">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_4_0">
    <VALUE Lang="tw">學生們完全不知道自己的學院在哪裡。</VALUE>
    <VALUE Lang="tw">更何況，怎麼知道那財團的背景，</VALUE>
    <VALUE Lang="tw">簡言之，聖財團當初創立的目的是不要破壞世界的均衡，</VALUE>
    <VALUE Lang="tw"> 是呀, 就是當初的目的。</VALUE>
  </SENTENSE>
