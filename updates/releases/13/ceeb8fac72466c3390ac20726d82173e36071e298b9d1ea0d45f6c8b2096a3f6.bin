  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_16_0">
    <VALUE Lang="tw">一定要活著,將現在發生的異象平息下來,要一直撐到完成大事之後!</VALUE>
  </SENTENSE>
