    <VALUE Lang="tw">搭乘公車</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0_3">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_1">
    <VALUE Lang="tw">這裡是公車站。只要您擁有Bus Ticket ，就可以使用公車服務，暢遊各地區唷。</VALUE>
