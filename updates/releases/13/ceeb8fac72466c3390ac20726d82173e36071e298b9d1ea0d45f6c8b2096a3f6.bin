  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_2">
    <VALUE Lang="tw">詢問狀況</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_3">
    <VALUE Lang="tw">詢問有關 Main Hole</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_4">
