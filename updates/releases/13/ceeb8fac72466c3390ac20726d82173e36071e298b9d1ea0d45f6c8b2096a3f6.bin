  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_3_0">
    <VALUE Lang="tw">忍術部是利用固定之石力量和自古流傳下來的術法，在任何情況下都可制伏敵人技巧聞名的職業。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_3_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_3_1">
    <VALUE Lang="tw">您還有很多東西需要學習。慢慢來不要著急。先去完成其它校內任務再來找我吧。</VALUE>
  </SENTENSE>
