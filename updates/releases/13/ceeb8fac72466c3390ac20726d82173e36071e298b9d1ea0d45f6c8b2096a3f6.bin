    <VALUE Lang="tw">這樣以來應該會比之前還要好</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_47_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_48_0">
    <VALUE Lang="tw">如需要我製作的特殊武器,就把需要的材料收集過來吧</VALUE>
