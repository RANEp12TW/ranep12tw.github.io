  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_12_0_4">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_13_0">
    <VALUE Lang="tw">嗯.. 你登記了嗎?</VALUE>
    <VALUE Lang="tw">應該不是第一次了吧, 哪有人這麼僵硬的??</VALUE>
    <VALUE Lang="tw">你知道嗎?</VALUE>
    <VALUE Lang="tw">我可以治療到等級15以下, 所以, 受傷的話要趕快到這裡來喔.</VALUE>
    <VALUE Lang="tw">如果你變更為從這裡開始的位置不是更方便嗎?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_13_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_14_0">
    <VALUE Lang="tw">不管再怎樣累人還是有很多文件要寫跟做很多的事, 但不知何時紙全用光了.</VALUE>
    <VALUE Lang="tw">那裡的Welfare Society商店有, 請問你願意幫我帶過來嗎?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_14_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_15_0">
    <VALUE Lang="tw">啊, 真是多謝!!</VALUE>
    <VALUE Lang="tw">剛剛急急忙忙寫下的東西得再寫一次了呢~</VALUE>
    <VALUE Lang="tw">以後受傷的話再過來吧.</VALUE>
    <VALUE Lang="tw">會給予你更好的治療.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_15_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_16_0">
    <VALUE Lang="tw">喔~ 你拿來囉!!</VALUE>
    <VALUE Lang="tw">這不是守衛大叔麻煩你的嗎?</VALUE>
    <VALUE Lang="tw">不管怎樣, 謝啦!! 正好需要.</VALUE>
    <VALUE Lang="tw">藥品一直是不夠的, 所以, 若沒有這類急救藥品的話實在沒法度了.</VALUE>
    <VALUE Lang="tw">外面的狀況得快點好轉才是, 真是令人擔心啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_16_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_17_0">
    <VALUE Lang="tw">藥品供給的狀況不好,</VALUE>
    <VALUE Lang="tw">已經緊急到要直接製作使用的地步了。</VALUE>
    <VALUE Lang="tw">不好意思, 可以幫我收集香煙的煙蒂嗎?</VALUE>
    <VALUE Lang="tw">有兩個叫做Little Hooligan和Hooligan的人常叼著煙！</VALUE>
    <VALUE Lang="tw">上次拜託過，但Little Hooligan抽的煙品質不太好, 無法用作藥品的材料,</VALUE>
    <VALUE Lang="tw">請幫我取得Hooligan的煙吧..</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">啊~ 如果你幫我收集到20個, 我就換錢給你。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_17_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_18_0">
    <VALUE Lang="tw">哇~ 你都收集到啦?</VALUE>
    <VALUE Lang="tw">真是感謝^^</VALUE>
    <VALUE Lang="tw">因為往後有陣子可能都得這樣自給自足, 所以有空的話再幫個忙吧.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_18_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_19_0">
    <VALUE Lang="tw">現在不只是藥品, 醫療用品全都不足.</VALUE>
    <VALUE Lang="tw">這樣看來, 可以用的東西全都要找來準備好.</VALUE>
    <VALUE Lang="tw">我剛看了一下, 是不是有群打著石膏的學生</VALUE>
    <VALUE Lang="tw">那群學生的口袋裡似乎有滿滿的繃帶.</VALUE>
    <VALUE Lang="tw">雖說打著石膏看起來是很痛啦, 不過這樣浪費繃帶的話對其他學生不好吧?</VALUE>
    <VALUE Lang="tw">嗯,就這樣.. 麻煩你, 幫忙把剩下的繃帶拿回來.</VALUE>
    <VALUE Lang="tw">現在補給的狀況不是很好, 所以要省著使用呀!"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_19_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_2_0">
    <VALUE Lang="tw">.....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_20_0">
    <VALUE Lang="tw">啊, 太好了~</VALUE>
    <VALUE Lang="tw">那群學生的臉雖然看起有點嚇人, 不過挺聽話的嘛...</VALUE>
    <VALUE Lang="tw">是啊...有耐心慢慢說服的話, 相信不管是誰都會親切相待的.</VALUE>
    <VALUE Lang="tw">不管怎麼說, 謝啦, 以後還要麻煩你呢~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_20_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_21_0">
    <VALUE Lang="tw">망각의 약?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">함부로 쓰면 안되는 약품인데...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">이제까지 조정했던 능력치들을 분배하기 전의 상태로 돌려버리는 약이라는 건 알고 있지?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">익혔던 스킬들을 모두 잊어버리게 되고, 대신 영령구슬들로 바꿔주고, 나눴던 스킬포인트를 모두 회수해 모아주는데...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">그래도 그런 약을 먹을거야?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_21_0_1">
    <VALUE Lang="tw">망각의 약을 사용하겠다고 한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_21_0_3">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_22_0">
    <VALUE Lang="tw">그래...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">벌써 결심해 버렸나 보구나</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">할 수 없지</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">그럼 가서 약재를 좀 구해 줄래?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">예전같으면 따로 재료를 구할 필요도 없었겠지만, 지금은 그런 흔한 것들도 함부로 쓸 수 없는 상황이니까...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">자, 자 그렇게 싫은 표정 하지 말고!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">금방 구할 수 있을테니까, 다녀와-</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_22_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_23_0">
    <VALUE Lang="tw">별로 오래 걸리진 않았지?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">쉽게 구할 수 있다고 했잖니-</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">그런데 아쉽게도 더이상 약을 만들수가 없어</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">그러게 정해진 날짜 동안에 다 했어야지-</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_23_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_24_0">
    <VALUE Lang="tw">별로 오래 걸리진 않았지?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">쉽게 구할 수 있다고 했잖니-</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">자, 여기에 이 알약만 섞으면 완성이야</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">솔직히 쓰레기장에서 구한 재료로 이런 미심쩍은 약을 만들어 먹인다는게 좀 마음에 걸리긴 하지만... 그래도 먹는다는데 어떻게 말리겠니-</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">응? 이런 재료로 약을 만든다는 말은 안했던가?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">음...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">이제라도 말 해줬으니까 된거지?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">자, 약은 다 만들어졌으니까</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">먹</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_24_0_1">
