  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_36_0">
    <VALUE Lang="tw">達到特定等級，就能拿到Spiritual Spheres。您可自由使用Spiritual Spheres來選擇可學的技能唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_36_0_4">
    <VALUE Lang="tw">兌換 Dynamic Sharp Sword</VALUE>
