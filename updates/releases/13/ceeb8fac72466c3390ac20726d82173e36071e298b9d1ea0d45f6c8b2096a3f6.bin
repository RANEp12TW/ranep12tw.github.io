  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_29_0">
    <VALUE Lang="tw">…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_3_0">
    <VALUE Lang="tw">那是因為我總是不喜歡到外面出來.</VALUE>
    <VALUE Lang="tw">""我很討厭像你們一樣跑來跑去,到處打架. """</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_3_0_1">
    <VALUE Lang="tw">您過去都待在哪裡呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_30_0">
    <VALUE Lang="tw">啊…是Grocer派你過來的啊？看來這有點複雜呢。如果要解碼需要用到解碼器Decoder。先前似乎有看過位在Phoenix campus的 Shocker怪人有用過這東西。您可以幫我取得解碼器Decoder嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_30_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_31_0">
    <VALUE Lang="tw">找回來的啊？嗯…有了解碼器果然容易多了。好了，拿去給Grocer吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_31_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0">
    <VALUE Lang="tw">Grocer… 您好。這是您要的東西！</VALUE>
  </SENTENSE>
