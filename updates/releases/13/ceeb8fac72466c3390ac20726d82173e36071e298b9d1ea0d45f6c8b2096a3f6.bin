    <VALUE Lang="tw">兌換 Dynamic Sharp Sword</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_34_0_5">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
