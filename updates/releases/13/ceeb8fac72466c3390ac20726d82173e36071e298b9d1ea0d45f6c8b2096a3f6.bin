  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_70_0_11">
    <VALUE Lang="tw">兌換Oktagon Arrow物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_70_0_12">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_70_0_5">
    <VALUE Lang="tw">兌換Lightning Arrow物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0">
    <VALUE Lang="tw">您想問什麼呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_1">
    <VALUE Lang="tw">詢問關於弓箭部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_2">
    <VALUE Lang="tw">詢問修煉方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_3">
    <VALUE Lang="tw">詢問戰鬥方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_4">
    <VALUE Lang="tw">詢問技能點數</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_5">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_9_0">
    <VALUE Lang="tw">這兒沒有回頭路。</VALUE>
    <VALUE Lang="tw">但千萬不能大意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_9_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0">
    <VALUE Lang="tw">噢！可以見到正常人真是開心！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_1">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_2">
    <VALUE Lang="tw">聽取對話</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_3">
    <VALUE Lang="tw">申請公車零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_4">
    <VALUE Lang="tw">申請發電機零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_5">
    <VALUE Lang="tw">收集未驗證紙幣</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_6">
    <VALUE Lang="tw">Technical Teacher的測驗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_7">
    <VALUE Lang="tw">確認測驗結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_8">
    <VALUE Lang="tw">傳達命令書</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_10_0">
    <VALUE Lang="tw">是嗎？那紙幣明明就有問題！</VALUE>
    <VALUE Lang="tw">在大問題發生之前確認出有危險實在太好了。</VALUE>
    <VALUE Lang="tw">請盡量持續傳達這份Order Document。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_10_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_11_0">
    <VALUE Lang="tw">已經到可以測驗的程度了嗎?</VALUE>
    <VALUE Lang="tw">比想像中學習的速度快呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_11_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_12_0">
    <VALUE Lang="tw">很好 這程度就合格了</VALUE>
    <VALUE Lang="tw">但是這算比想像中的差所以以後要多練習</VALUE>
    <VALUE Lang="tw">雖然上課時都聽懂了但你無法猜對何時那些有兩隻手兩隻腳的傢伙會不會以你敵人的身份出現"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_12_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_13_0">
    <VALUE Lang="tw">.......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_14_0">
    <VALUE Lang="tw">總之老師所帶的東西裡頭沒有這種零件。</VALUE>
    <VALUE Lang="tw">位在Construction Site 4th Hole的Supervisor搞不好有帶著。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_14_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_15_0">
    <VALUE Lang="tw">你可以從你的頭頭那邊取得所需零件。</VALUE>
    <VALUE Lang="tw">他位在 4th Hole的建築工地。</VALUE>
    <VALUE Lang="tw">你必須要先證明自己，</VALUE>
    <VALUE Lang="tw">他們一開始可能會有點嚴格粗暴。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_15_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_16_0">
    <VALUE Lang="tw">.......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_17_0">
    <VALUE Lang="tw">혹시나 해서 현금지급기에서 확인도 해 봤더니 정품으로 인식하더라구</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_17_0_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_18_0">
    <VALUE Lang="tw">아까 물어보니까 청소부들이 이런 지폐를 다발로 모으고 있다는 소리까지 들리는 거 보니까 이대로 놔두면 문제가 커질 것 같아</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_18_0_1">
    <VALUE Lang="tw">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_19_0">
    <VALUE Lang="tw">가져가서 한번 확인 좀 해 봐라</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_19_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_2_0">
    <VALUE Lang="tw">...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_2_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_2_0_2">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_20_0">
    <VALUE Lang="tw">....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_21_0">
    <VALUE Lang="tw">很好,那麼</VALUE>
    <VALUE Lang="tw">出題之前我會再跟你們說一次之前講的本次測驗的目的,你們平時上格鬥課的目標絕對不是一般人</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_21_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_22_0">
    <VALUE Lang="tw">所以要定期舉行這種能力考試,可以學到更多需要學習的部分</VALUE>
    <VALUE Lang="tw">雖說情況比預定的進行的快,但不會只到現在</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_22_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_23_0">
    <VALUE Lang="tw">因為你們真正要戰鬥的敵人,他們的水準並非這程度,所以以後要持續學習</VALUE>
    <VALUE Lang="tw">瞭解了嗎</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_23_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_3_0">
    <VALUE Lang="tw">嗯如果有聽課的話可以猜出大概的樣子</VALUE>
    <VALUE Lang="tw">比起預計的是快了不過早就預料到啦從18年前"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_4_0">
    <VALUE Lang="tw">雖然早已預想到事件的大概,現在卻全然不知會怎樣</VALUE>
    <VALUE Lang="tw">再加上至今仍不知當初預知的事情是否正確</VALUE>
    <VALUE Lang="tw">那必須先做確定</VALUE>
    <VALUE Lang="tw">多收集可能的情報</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_5_0">
    <VALUE Lang="tw">本來是有人決定管理這個不過不知道跑去哪裡了</VALUE>
    <VALUE Lang="tw">所以暫時由我來看管是針對社服的特性再做強化的產品模樣</VALUE>
    <VALUE Lang="tw">心意一樣但想就這樣分配掉掉點可惜耶</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_5_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0">
    <VALUE Lang="tw">嗯…. 您想問什麼呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0_1">
    <VALUE Lang="tw">詢問現況</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0_2">
    <VALUE Lang="tw">詢問該做什麼才好？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0_3">
    <VALUE Lang="tw">詢問奇特服裝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0_4">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_7_0">
    <VALUE Lang="tw">阿 你在找修理公車用的零件吧</VALUE>
    <VALUE Lang="tw">最近雖然有幾個人收走一樣的零件卻因為出車禍又來找我</VALUE>
    <VALUE Lang="tw">如果這次可以確實帶走就好了</VALUE>
    <VALUE Lang="tw">雖然為了應付這類事情準備很多東西但現在零件幾乎沒剩了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_7_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_8_0">
    <VALUE Lang="tw">又是零件 全部都被包走了</VALUE>
    <VALUE Lang="tw">看一下這是以前的規格也有點不一樣吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_8_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_9_0">
    <VALUE Lang="tw">又是來買零件嗎? 真是的</VALUE>
    <VALUE Lang="tw">嗯, 這是哪裡奇怪的紙幣呀? 這裡有耶</VALUE>
    <VALUE Lang="tw">我雖無法正確指出是哪裡, 不過這紙幣就是怪怪的</VALUE>
    <VALUE Lang="tw">好像有去現金提款機確認過, 不過告知是真的呀</VALUE>
    <VALUE Lang="tw">剛剛問過, 從清潔工人說這種紙幣包成一束來看, 這樣下去問題會擴大</VALUE>
    <VALUE Lang="tw">帶去再確認一次</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_9_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_0">
    <VALUE Lang="tw">아, 그거 혹시 열쇠 조각 ...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">잠깐 줘 볼래?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">어쩌면 그 『깨달음의 열쇠』 일지도 모르겠는데!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">정말 『깨달음의 열쇠』 라면 『세인트 재단』 에게서 뭔가를 받기 위한 증표가 될 거야</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_0_1">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_0_2">
    <VALUE Lang="tw">열쇠 조각 들을 합친다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_1">
    <VALUE Lang="tw">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_2">
    <VALUE Lang="tw">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_3">
    <VALUE Lang="tw">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_4">
    <VALUE Lang="tw">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5">
    <VALUE Lang="tw">來這裡真是辛苦呀</VALUE>
    <VALUE Lang="tw">物品還有一點,有需要的話要說阿</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_1">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_10">
    <VALUE Lang="tw">接受指示 (消滅 Hell Scissors)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_11">
    <VALUE Lang="tw">報告結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_12">
    <VALUE Lang="tw">交付藥品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_13">
    <VALUE Lang="tw">申請考試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_14">
    <VALUE Lang="tw">確認考試結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_2">
    <VALUE Lang="tw">聽取對話</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_3">
    <VALUE Lang="tw">調查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_4">
    <VALUE Lang="tw">申請考試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_5">
    <VALUE Lang="tw">確認考試結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_6">
    <VALUE Lang="tw">接受指示（紙幣驗證）</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_7">
    <VALUE Lang="tw">傳達命令書</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_8">
    <VALUE Lang="tw">詢問 Leonair Campus的位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_9">
    <VALUE Lang="tw">確認Map的紙片</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_10_0">
    <VALUE Lang="tw">自發性地接受考試是不錯啦</VALUE>
    <VALUE Lang="tw">反正學生或是老師都會定期考試來測定能力希望你不要覺得煩</VALUE>
    <VALUE Lang="tw">敵人的能力也在變,稍微有變強,要順便消除自負的態度</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_11_0">
    <VALUE Lang="tw">嗯 很好 算是良好的</VALUE>
    <VALUE Lang="tw">這種程度是穩要可以過的用這試著去想以後這樣想的話就理所當然的東西也…</VALUE>
    <VALUE Lang="tw">總之定期能力測驗就這樣了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_11_0_1">
    <VALUE Lang="tw">接受指示(驗證紙幣)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_11_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_12_0">
    <VALUE Lang="tw">事​​實上久前清道夫大叔給我這就走了</VALUE>
    <VALUE Lang="tw">是阿看起來跟錢沒兩樣不過仔細看是偽鈔</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_12_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_13_0">
    <VALUE Lang="tw">那紙幣似乎確實有什麼重要的東西</VALUE>
    <VALUE Lang="tw">現在在路上常會看見有掉落的東西先撿起來收著吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_13_0_1">
    <VALUE Lang="tw">詢問Leonair Campus的位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_14_0">
    <VALUE Lang="tw">以前明明就在那邊Trading Hole隧道的附近，</VALUE>
    <VALUE Lang="tw">但是某天突然消失不見了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_14_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_15_0">
    <VALUE Lang="tw">地圖的紙片真的還在呀</VALUE>
    <VALUE Lang="tw">搞不好老師也不知道至今還在,真是太好了</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_15_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_16_0">
    <VALUE Lang="tw">嗯,要不然之前是有要你做的事情啦</VALUE>
    <VALUE Lang="tw">為了確保學生跟市民最基本的安全,是持續整理中沒錯</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_16_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_17_0">
    <VALUE Lang="tw">很好,做的很好</VALUE>
    <VALUE Lang="tw">往後財團中有補給或支援的時候,要你做的事情會很多喔</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_17_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_18_0">
    <VALUE Lang="tw">事​​情進行到這樣,財團本部卻什麼話都沒說</VALUE>
    <VALUE Lang="tw">雖然消息有說要派重要人員來,會不會都是財團內部…</VALUE>
    <VALUE Lang="tw">阿 不要操心了</VALUE>
    <VALUE Lang="tw">是老師自己在那邊講的</VALUE>
    <VALUE Lang="tw">總之 辛苦啦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_18_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_19_0">
    <VALUE Lang="tw">......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_2_0">
    <VALUE Lang="tw">...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_2_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_2_0_2">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_20_0">
    <VALUE Lang="tw">現在沒辦法拉哩拉雜說一堆,我只告訴你一句話</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_20_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_21_0">
    <VALUE Lang="tw">現在周圍幾乎沒有正常的人,千萬不要只因為外表就去接近</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_21_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_22_0">
    <VALUE Lang="tw">.......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_23_0">
    <VALUE Lang="tw">但問題是，詢問之後卻有並非偽鈔的反應出現。</VALUE>
    <VALUE Lang="tw">而且紙幣周圍反射奇怪的文字，似乎是古代的神秘暗號。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_23_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_24_0">
    <VALUE Lang="tw">總之這些紙幣本身似乎帶有什麼意義,拜託你拿去確定一下</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_24_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_25_0">
    <VALUE Lang="tw">阿！這必須由老師保管，拿去給 Technical Teacher 吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_25_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_26_0">
    <VALUE Lang="tw">.....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_27_0">
    <VALUE Lang="tw">而且那個位置阿從以前就原有的東西像建築物現在卻被侵入的人們佔據</VALUE>
    <VALUE Lang="tw">雖說異象出現的時機精確的一致</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_27_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_28_0">
    <VALUE Lang="tw">問題不出在那，而是Leonair學院現在到底在哪裡。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_28_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_29_0">
    <VALUE Lang="tw">有人說在Sacred Gate Park的南邊,也有人說在北邊不直接去確定的話根本無法得知</VALUE>
    <VALUE Lang="tw">但是聽說剛好有個叫做 Cheng Xi Zhi的射箭部學生，他確定了Leonair學院的位置，還做了張地圖。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_29_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_3_0">
    <VALUE Lang="tw">就像第一次來這裡的人問的。</VALUE>
    <VALUE Lang="tw">朝著Sacred Gate Park，往右邊走是Phoenix學院；往左邊走的話是Mystic Peak學院；往後面走是Sacred Gate學院阿！</VALUE>
    <VALUE Lang="tw">好吧,現在想起來沒？</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_30_0">
    <VALUE Lang="tw">那地圖卻被怪人搶奪,被撕成一片一片的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_30_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_31_0">
    <VALUE Lang="tw">"雖然不知道那怪人是誰,重要的是如何找到那被撕成一片片的地圖</VALUE>
    <VALUE Lang="tw">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_31_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_32_0">
    <VALUE Lang="tw">地圖被撕破的時候附近有小丑Clown，這樣會找不到嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_32_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_33_0">
    <VALUE Lang="tw">......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_34_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">"來看看 剩不到七張,怎麼這麼亂阿</VALUE>
    <VALUE Lang="tw">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_34_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_35_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">"哎呀不管老師再怎麼拼湊都不行的吧</VALUE>
    <VALUE Lang="tw">字太草,圖案也不規則,損傷很嚴重,連接線不確實</VALUE>
    <VALUE Lang="tw">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_35_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_36_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Student Director有做過遺跡挖掘，搞不好可以拼湊的起來</VALUE>
    <VALUE Lang="tw">。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_36_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_37_0">
    <VALUE Lang="tw">....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_38_0">
    <VALUE Lang="tw">但最近這周圍為非作歹的傢伙變多了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_38_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_39_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">"不管怎樣因為數字不足就這樣放著,往後不知該怎辦</VALUE>
    <VALUE Lang="tw">即使只有一點點餘力,如能將會造成禍端的東西消失就太好了</VALUE>
    <VALUE Lang="tw">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_39_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_4_0">
    <VALUE Lang="tw">用這樣一臉無知的表情問的話,教你們的老師會很憂鬱的</VALUE>
    <VALUE Lang="tw">哎呀,現在那個老師不知走到多遠去了</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_4_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_40_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">"喔, 聽說試驗付出很多, 很奇特喔!</VALUE>
    <VALUE Lang="tw">是啊 序論 好像沒有必要?</VALUE>
    <VALUE Lang="tw">哪裡... 適當的課題找起來有點難.</VALUE>
    <VALUE Lang="tw">對啊, 那 程度的話沒問題...</VALUE>
    <VALUE Lang="tw">學生有程度的話所謂'冰專家' 者知道嗎?</VALUE>
    <VALUE Lang="tw">什麼真吃驚...</VALUE>
    <VALUE Lang="tw">這次試驗的課題一直把那人們撂倒.</VALUE>
    <VALUE Lang="tw">和以前的試驗一樣沒有時間的限制</VALUE>
    <VALUE Lang="tw">做幾次挑戰都可以試試看!"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_40_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_41_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">"從容應變?</VALUE>
    <VALUE Lang="tw">那冰玦聽說真的很少見?</VALUE>
    <VALUE Lang="tw">這個真的是以無時不做程度完成的嗎.</VALUE>
    <VALUE Lang="tw">心情不佳卻來找碴，根本是想惹事的傢伙們...</VALUE>
    <VALUE Lang="tw">反正試驗已經合格了!</VALUE>
    <VALUE Lang="tw">在上面恐怕沒有老師痛恨的試驗.</VALUE>
    <VALUE Lang="tw">聽說滿滿的課題也找不到.</VALUE>
    <VALUE Lang="tw">那樣真好."</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_41_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_42_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">您正前往 Root Hole嗎？</VALUE>
    <VALUE Lang="tw">對把時間停止東西有點意外.</VALUE>
    <VALUE Lang="tw">把空間軸做變化的思維...</VALUE>
    <VALUE Lang="tw">說實在的，它連想像都有點費力, 空間軸是如何把它改變呢...</VALUE>
    <VALUE Lang="tw">財團總社在本洞有不同的東西你知道嗎?</VALUE>
    <VALUE Lang="tw">總社內部可以確認的的話就好了…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_42_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_5_0">
    <VALUE Lang="tw">득도의 경지에 이른 『마루치』 와 『아라치』 의 기운이 서로 만날 때 이르는 경지를 가리키는 말인데</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">본래는 소승불교에서 모든 번뇌를 뚫고 이치를 깨달아 열반의 경지에 이른 성자를 말이고 『나한』 이라고도 하지</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_5_0_1">
    <VALUE Lang="tw">'깨달음의 열쇠' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_5_0_2">
    <VALUE Lang="tw">'나한의 구슬' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_5_0_3">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_6_0">
    <VALUE Lang="tw">그 열쇠를 지니고 있다면 재단에 보관중인 걸 받을 수도 있게 된다는 얘기는 들었지</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">하지만 지금은 조각조각으로 나뉘어져 있을테니까 일단 7조각을 모으게 되면 나한테 가져오도록 해</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_6_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_7_0">
    <VALUE Lang="tw">아, 그 녹색 구슬 말이지?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">그냥 하나씩만으로는 별다를 게 없는데 30개를 다 합쳐서 목걸이를 만들면 꽤 쓸만해 진다지</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_7_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_8_0">
    <VALUE Lang="tw">OK！讓我想想.....</VALUE>
    <VALUE Lang="tw">我該怎麼跟您解釋呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_8_0_1">
    <VALUE Lang="tw">詢問方向</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_8_0_2">
    <VALUE Lang="tw">詢問現況</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_9_0">
    <VALUE Lang="tw">阿！聽Construction Supervisor說過</VALUE>
    <VALUE Lang="tw">你接受我的請托 真是非常感謝</VALUE>
    <VALUE Lang="tw">他們也知道現在的狀況在某種程度上來說是很奇怪的,所以盡可能幫你,做的真是太好了</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_9_0_1">
    <VALUE Lang="tw">申請考試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_9_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_1_0">
    <VALUE Lang="tw">歡迎來到格鬥部！如果您不屬於此單位，請各自回到您的所屬區域。謝謝。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_1_0_1">
