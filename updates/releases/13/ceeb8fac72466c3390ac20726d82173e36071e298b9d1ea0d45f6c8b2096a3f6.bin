  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_10_0">
    <VALUE Lang="tw">看來你平安無事地把藥品送過去了</VALUE>
    <VALUE Lang="tw">很辛苦吧?</VALUE>
    <VALUE Lang="tw">但是多虧那些藥品, 才可以拯救很多人的性命.</VALUE>
    <VALUE Lang="tw">如果前往我們醫院的路沒有被堵住的話,就不會有這種事了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_10_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_11_0">
    <VALUE Lang="tw">你來的正好…我正擔心那裡可能需要一些藥品</VALUE>
