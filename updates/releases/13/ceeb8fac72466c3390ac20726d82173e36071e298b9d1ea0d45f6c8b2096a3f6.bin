  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0">
    <VALUE Lang="tw">街道不知道為什麼會變成這樣</VALUE>
    <VALUE Lang="tw">最後還可以躲來這裡算是幸運了</VALUE>
    <VALUE Lang="tw">一不小心的話現在會變怎樣都不知道</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_1">
    <VALUE Lang="tw">您在說些什麼？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_2">
    <VALUE Lang="tw">聽取Cleaner的忠告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_3">
    <VALUE Lang="tw">交付回收型垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_4">
    <VALUE Lang="tw">交付回收型垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_2_0">
    <VALUE Lang="tw">...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_3_0">
    <VALUE Lang="tw">看了還不知道嗎? 清掃街道的時候突然就變成這樣了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_4_0">
    <VALUE Lang="tw">從那件事情發生之後，我們一直沒有機會逃走。到現在沒有一個人願意留下來做打掃……。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_4_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_5_0">
    <VALUE Lang="tw">辛苦了學生們</VALUE>
    <VALUE Lang="tw">因為要好好珍惜物資,往後有時間再好好拜託你們了</VALUE>
    <VALUE Lang="tw">你們幫我收集來的話就用其他的東西跟你們​​</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_5_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_6_0">
    <VALUE Lang="tw">.....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_7_0">
    <VALUE Lang="tw">連物資都不夠, 亂七八糟, 連一點也募集不到的話, 往後就更慘了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_7_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_8_0">
    <VALUE Lang="tw">其他都別管,但是請一定幫我收集空瓶過來</VALUE>
    <VALUE Lang="tw">再怎麼沒辦法也要好好保管藥品啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_8_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
