  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0">
    <VALUE Lang="tw">此終端機掌控著 Right Dragon Park 的出入機能。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_1">
    <VALUE Lang="tw">確認激活</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_2">
    <VALUE Lang="tw">終端機測試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_3">
    <VALUE Lang="tw">終端機測試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_4">
    <VALUE Lang="tw">終端機測試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_5">
    <VALUE Lang="tw">結界認證</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_6">
    <VALUE Lang="tw">結界認證</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_7">
    <VALUE Lang="tw">結界認證</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_8">
    <VALUE Lang="tw">終端機測試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_9">
    <VALUE Lang="tw">結界認證</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_2_0">
    <VALUE Lang="tw">終端機正常運作中</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_2_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_3_0">
    <VALUE Lang="tw">終端機的結界機能正常運作中。您需要4顆靈珠才能通過認證，並得到結界的能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_4_0">
    <VALUE Lang="tw">已完成此區的認證, 不過要等完成其他區域的認證後, 才能獲得其成效, 請移動至下一個區域的終端機.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_5_0">
    <VALUE Lang="tw">許多惡靈在 Right Dragon Park 裡徘徊遊蕩。被這些惡靈所附著的怪物身上有著不良物質，導致週遭環境出現奇怪現象。請您盡全力處理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_5_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_9_0">
    <VALUE Lang="tw">.....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0">
    <VALUE Lang="tw">您在煩惱什麼呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_1">
    <VALUE Lang="tw">聽取對話</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_2">
    <VALUE Lang="tw">Bus Driver的請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_3">
    <VALUE Lang="tw">Construction Supervisor的請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_4">
    <VALUE Lang="tw">傳達零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_5">
    <VALUE Lang="tw">Physics Teacher的請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_7">
    <VALUE Lang="tw">確認報告書</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_8">
    <VALUE Lang="tw">傳遞Golf Clubs</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_10_0">
    <VALUE Lang="tw">不好意思, 可以幫我從Technical Teache那邊拿發電機的零件來嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_10_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_11_0">
    <VALUE Lang="tw">我因為那群瘋狂的勞工而動彈不得, 只怕我一離開, 他們就會將我已做好的工程都被搞砸了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_11_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_12_0">
    <VALUE Lang="tw">........</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_13_0">
    <VALUE Lang="tw">沒錯! 這就是我之前找的零件.</VALUE>
    <VALUE Lang="tw">真是多謝.</VALUE>
    <VALUE Lang="tw">雖然沒有讓它不再故障的辦法, 不過可以作業好一陣子了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_13_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_14_0">
    <VALUE Lang="tw">不過這到底是怎麼搞的, 人們會變成那模樣?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_14_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_15_0">
    <VALUE Lang="tw">學生！！？？</VALUE>
    <VALUE Lang="tw">噢！我瞭解了！您的老師現在很忙……</VALUE>
    <VALUE Lang="tw">好的………….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_15_0_1">
    <VALUE Lang="tw">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_16_0">
    <VALUE Lang="tw">哎！只能繼續叫學生。這邊人員不足加上物資缺乏，內部工程上使用的材料需要拿這些採用的來替代。可否跑趟Training Ground高爾夫場拿高爾夫球桿過來呢?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_17_0">
    <VALUE Lang="tw">"哦。這些就可以了!</VALUE>
    <VALUE Lang="tw">我們的工人如果好好做事的話我也不會拜託你，謝謝你學生！</VALUE>
    <VALUE Lang="tw">我覺得聖財團這個地方是專門做好事的地方。對我們來說是很好。 "</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_2_0">
    <VALUE Lang="tw">... …..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_3_0">
    <VALUE Lang="tw">本來在旁邊管理工程, 現在卻躲的遠遠的.</VALUE>
    <VALUE Lang="tw">大事不妙~ 工程期限就快到了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_4_0">
    <VALUE Lang="tw">是該做事沒錯, 不過人們變的怪怪的, 機器也故障, 實在麻煩</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_4_0_1">
    <VALUE Lang="tw">詢問那些發狂的人們</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_5_0">
    <VALUE Lang="tw">喔, 把這種學生送走吧...</VALUE>
    <VALUE Lang="tw">沒時間沒辦法呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_5_0_1">
    <VALUE Lang="tw">Construction Supervisor的請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_6_0">
    <VALUE Lang="tw">聽聽我的請求...</VALUE>
    <VALUE Lang="tw">為了要在期限內完工, 必須要使用機器人來代替瘋掉的工人們, 但是現在竟然連發電機都壞掉了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_6_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_7_0">
    <VALUE Lang="tw">聽聽我的請求...</VALUE>
    <VALUE Lang="tw">為了要在期限內完工, 必須要使用機器人來代替瘋掉的工人們, 但是現在竟然連發電機都壞掉了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_7_0_1">
    <VALUE Lang="tw">Physics Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_8_0">
    <VALUE Lang="tw">阿. 差點嚇死...</VALUE>
    <VALUE Lang="tw">剛剛Sacred Gate College的Physics Teacher那邊有消息傳來</VALUE>
    <VALUE Lang="tw">我們會去Sacred Gate Ring找他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_9_0">
    <VALUE Lang="tw">......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0">
    <VALUE Lang="tw">…..嗯…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_1">
    <VALUE Lang="tw">與Bus Driver進行對話</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_2">
    <VALUE Lang="tw">Bus Driver的請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_3">
    <VALUE Lang="tw">交付零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_4">
    <VALUE Lang="tw">Bus Driver的請求2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_5">
    <VALUE Lang="tw">詢問他是否需要幫忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_6">
    <VALUE Lang="tw">報告結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_10_0">
    <VALUE Lang="tw">幾天前開始，公車就故障了。而且越來越嚴重，連發動都成問題了。好像此地區的其他公車也都有類似的問題。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_10_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_11_0">
    <VALUE Lang="tw">...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_12_0">
    <VALUE Lang="tw">不好意思，您可以幫我從Technical Teacher那兒要一點零件過來嗎？ 他就在學院交叉路口那裡。唯有如此我才能修好公車，使它發動成功！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_12_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_13_0">
    <VALUE Lang="tw">그럼 이 버스도 움직일 수 있게 될 거고, 학생들도 조금은 편해지겠지</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_13_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_14_0">
    <VALUE Lang="tw">您有去過SG Hole了嗎？如果有去過的話，那您一定有見過那些壞心的 Green Mask (Uncle Potato)。因為他們威脅我，甚至想我勒索。因此我連公車都不敢開了。</VALUE>
    <VALUE Lang="tw">如果可以的話，請您幫我打退他們。好嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_14_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_15_0">
    <VALUE Lang="tw">謝謝您，現在我終於可以開公車載學生上下學了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_15_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_2_0">
    <VALUE Lang="tw">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_3_0">
    <VALUE Lang="tw">當然，公車曾被學生們當作通勤的工具。可以傳送地點是真的非常方便的事情。比起用跑的，公車真的太方便了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_3_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_4_0">
    <VALUE Lang="tw">噢！我很抱歉，我不知道您在這兒！ 我正忙著找出這些不對勁的原因。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_4_0_1">
    <VALUE Lang="tw">詢問他在做什麼？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_5_0">
    <VALUE Lang="tw">噢！這台公車無法使用。連我都無法用它來進行工作。我得把它修好，這樣學生們才能安全使用。畢竟在這混亂地區獨自行走，是非常危險的事情。但現在沒有修理用的零件，情況真糟糕。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_5_0_1">
    <VALUE Lang="tw">詢問Driver關於更多的公車情報</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_6_0">
    <VALUE Lang="tw">根據公車殘骸的報告評估，我可以說，修理這輛車不應該是個大問題。修復此車所需的零件，需要盡快收集到才行。在我能得到所有必要的配備之前，我是無法進行修理的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_6_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_7_0">
    <VALUE Lang="tw">謝謝您帶來我要的零件了！我終於可以開始修 破損的公車了！從現在起，學生們往來其他地區間時，會更加的方便與安全唷！</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_7_0_1">
    <VALUE Lang="tw">Bus Driver的請求2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_8_0">
    <VALUE Lang="tw">請您去拜訪Construction Supervisor，他位在Sacred Gate Campus的交叉路那兒。我聽說他想請我幫忙，但我無法去找他，因為我得處理公車的問題。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_9_0">
    <VALUE Lang="tw">....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0">
    <VALUE Lang="tw">這裡是公車站。只要您擁有Bus Ticket ，就可以使用公車服務，暢遊各地區唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0_1">
    <VALUE Lang="tw">搭乘公車</VALUE>
  </SENTENSE>
