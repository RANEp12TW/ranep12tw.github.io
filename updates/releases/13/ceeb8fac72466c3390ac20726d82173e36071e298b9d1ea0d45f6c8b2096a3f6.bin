    <VALUE Lang="tw">用 Green Pearl 兌換 Red Pearl。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_6">
    <VALUE Lang="tw">用 Blue Pearl 兌換 Green Pearl。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_7">
    <VALUE Lang="tw">用 Green bead 兌換5個 red beads。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_8">
