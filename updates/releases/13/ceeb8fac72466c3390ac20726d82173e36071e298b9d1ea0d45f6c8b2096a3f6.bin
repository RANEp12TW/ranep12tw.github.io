  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_22_0">
    <VALUE Lang="tw">啊, 我剛好還沒準備好那些藥品, 需要跟Mystic Peak Small Square的Physics Teacher拿取.</VALUE>
