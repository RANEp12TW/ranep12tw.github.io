  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_1_3_7">
    <VALUE Lang="tw">我想進入 Leonair Campus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_1_3_8">
    <VALUE Lang="tw">我想進入 Leonair Campus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_1_3_9">
    <VALUE Lang="tw">確認考試結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_10_0">
    <VALUE Lang="tw">對, 這沒錯.</VALUE>
    <VALUE Lang="tw">就是以前資料上看的那個葉子.</VALUE>
    <VALUE Lang="tw">可是這好奇怪, 其他都變了, 怎麼這個還是老樣子..?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_10_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_11_0">
    <VALUE Lang="tw">您無法進入此地區。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_11_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_12_0">
    <VALUE Lang="tw">很好，剛好就這樣。</VALUE>
    <VALUE Lang="tw">就像我說的，我現在在這裡動彈不得。</VALUE>
    <VALUE Lang="tw">請您進去Leonair Campus裡頭瞭解一下大概的狀況。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_12_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_13_0">
    <VALUE Lang="tw">這是什麼? 繃帶Bandage?</VALUE>
    <VALUE Lang="tw">而且這腐蝕的狀態, 應該是從屍體身上撕下來的吧?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_13_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_14_0">
    <VALUE Lang="tw">不管怎麼說, 情報都太少了..</VALUE>
    <VALUE Lang="tw">植物實驗體跟預測的一樣, 不過除此之外的.</VALUE>
    <VALUE Lang="tw">到底什麼死掉的傢伙會走來走去</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_14_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_15_0">
    <VALUE Lang="tw">雖然我不是這一方面的專家, 不過這上面沾有這麼多的異物, 只要一看就知道應該很難讀取的到吧.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_15_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_16_0">
    <VALUE Lang="tw">雖然Sacred Financial Group Research Center可以輕易復原它，但現在卻不​​行。</VALUE>
    <VALUE Lang="tw">聽說Trading Hole有一位這方面的專家。帶去拜託他應該就可以復原了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_16_0_1">
    <VALUE Lang="tw">詢問有關 Sacred Financial Group Research Center的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_16_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_17_0">
    <VALUE Lang="tw">我好像說了太多廢話.</VALUE>
    <VALUE Lang="tw">不要想太多.</VALUE>
    <VALUE Lang="tw">只是因為僅剩單純的技術研究所了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_17_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_18_0">
    <VALUE Lang="tw">如果真是如此, 那就麻煩了..</VALUE>
    <VALUE Lang="tw">如果要去地下二樓就要去三樓的專用電梯.</VALUE>
    <VALUE Lang="tw">而且要去三樓的話要有特別的ID卡</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_18_0_1">
    <VALUE Lang="tw">詢問特殊ID Card。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_18_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0">
    <VALUE Lang="tw">復原成功了.</VALUE>
    <VALUE Lang="tw">雖然花了不少時間, 不過真是辛苦你了.</VALUE>
    <VALUE Lang="tw">說的也是, 看的到內容吧?</VALUE>
    <VALUE Lang="tw">不管看到什麼, 暫時還是別說出去比較好</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_1">
    <VALUE Lang="tw">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_2">
    <VALUE Lang="tw">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_3">
    <VALUE Lang="tw">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_4">
    <VALUE Lang="tw">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_5">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_2_0">
    <VALUE Lang="tw">....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_20_0">
    <VALUE Lang="tw">帶子的狀態有點怪...</VALUE>
    <VALUE Lang="tw">不會是給誰看過了吧?</VALUE>
    <VALUE Lang="tw">那有什麼關係嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_20_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_21_0">
    <VALUE Lang="tw">各學院的 Administration Office會保管特殊時刻用的卡片。</VALUE>
    <VALUE Lang="tw">請取得卡片，並複製卡片。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_21_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_22_0">
    <VALUE Lang="tw">好, 這就是Leonair Campus。</VALUE>
    <VALUE Lang="tw">不但帶了地圖，就連認證書都一起帶過來了。看來您是略有所聞喔。但還是先後退吧。</VALUE>
    <VALUE Lang="tw">你是說看不見從那裡面滲出來不均衡的元素嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_22_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_23_0">
    <VALUE Lang="tw">嗯, 很好..</VALUE>
    <VALUE Lang="tw">反正正好需要有人代替我進去, 藉機測驗一下你的能力吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_23_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_24_0">
    <VALUE Lang="tw">給你40分鐘，抓20名Sacred Gate Defender來，我就佩服您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_24_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_25_0">
    <VALUE Lang="tw">我給你一句忠告, 那群傢伙的電氣攻擊厲害的不得了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_25_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_26_0">
    <VALUE Lang="tw">不管你討厭或喜歡，都要聽我的請求。</VALUE>
    <VALUE Lang="tw">現在 Leonair campus裡面某些東西正在成長。</VALUE>
    <VALUE Lang="tw">已經有幾個知道發生什麼事情，雖然進去過，卻只將那奇怪的氣息擴大。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_26_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_27_0">
    <VALUE Lang="tw">那麼, 請告訴我裡面究竟怎麼了?</VALUE>
    <VALUE Lang="tw">我說了, 因為我要代替作出結界, 沒辦法了.</VALUE>
    <VALUE Lang="tw">進去裡面看的話, 是草嗎? 就是有滿滿的植物體</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_27_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_28_0">
    <VALUE Lang="tw">去取得一個叫做Smallpox leave的葉子五片來。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_28_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_29_0">
    <VALUE Lang="tw">如果跟以前的結構一樣的話, 一進去會有反覆的階梯.</VALUE>
    <VALUE Lang="tw">爬完階梯後, 經過操場會有一條路, 去拿樣本回來</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_29_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_3_0">
    <VALUE Lang="tw">聖財團的調查派遣人員? 確定現在正擴散的異常現象是否從這附近而來</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_3_0_1">
    <VALUE Lang="tw">詢問關於Sacred Financial Group的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_30_0">
    <VALUE Lang="tw">那裡面有屍體走來走去嗎?</VALUE>
    <VALUE Lang="tw">雖然不超過預期想像的, 不過狀況不是太好.</VALUE>
    <VALUE Lang="tw">總之用這程度的樣本看來, 似乎不是可以掌握的狀況</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_30_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_31_0">
    <VALUE Lang="tw">不好意思請幫我調查一下Leonair Campus。</VALUE>
    <VALUE Lang="tw">還有，請幫我看看是否 Student director 到現在還活著？</VALUE>
    <VALUE Lang="tw">我相信您辦得到的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_31_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_32_0">
    <VALUE Lang="tw">這樣就太好了.</VALUE>
    <VALUE Lang="tw">遇見跟你一樣的人就可以拜託吧</VALUE>
    <VALUE Lang="tw">因為信任你, 所以小心點喔</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_32_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_33_0">
    <VALUE Lang="tw">게다가 이런 구식 기록매체를 아직까지 쓰고 있다니...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">아무래도 전문가에게 보여야 겠는걸, 일단은 내가 보관하고 있도록 하지</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_33_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_34_0">
    <VALUE Lang="tw">並非單純潮濕所造成的損傷.</VALUE>
    <VALUE Lang="tw">這是要在一定的熱度下經過很長的時間才會出現的傷口</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_34_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_35_0">
    <VALUE Lang="tw">如果說症狀不只呼吸, 就連神經都受到影響的話..</VALUE>
    <VALUE Lang="tw">難說是不是..."</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_35_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_36_0">
    <VALUE Lang="tw">最近開始有人詢問那個病, 雖然來這之前有確認過資料, 總之好像是植物體實驗的影響</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_36_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_37_0">
    <VALUE Lang="tw">但就單純的速度來說, 影響不會擴散這麼遠.</VALUE>
    <VALUE Lang="tw">會不會跟Leonair學院地下二樓的排水管有關係</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_37_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_38_0">
    <VALUE Lang="tw">在這裡一邊整理情況, 怎麼想都覺得目前學生的能力將難以承擔往後的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_38_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_39_0">
    <VALUE Lang="tw">去 Trading Hole找Master of Taoist Rites。如果可以請求授課就太好了。即使只變強一點點都會有幫助的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_39_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_4_0">
    <VALUE Lang="tw">似乎對學院漠不關心.</VALUE>
    <VALUE Lang="tw">沒道理不知道這周邊成立了四間很奇怪的學院.</VALUE>
    <VALUE Lang="tw">那個後援團體就是我們聖財團</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_40_0">
    <VALUE Lang="tw">... ……</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_41_0">
    <VALUE Lang="tw">太久沒有動了，只是站著也會暈，居然會有傢伙找這種麻煩。</VALUE>
    <VALUE Lang="tw">好！首先去問問這個人，並幫助他之後再來找我。據說是Construction Supervisor，他正對財團發郵件要求幫助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_41_0_1">
    <VALUE Lang="tw">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_41_0_2">
    <VALUE Lang="tw">決絕</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_42_0">
    <VALUE Lang="tw">不要問為什麼，需要幫助的人就給予幫助，不需要幫助的人，親自訪問需要什麼樣的幫助。</VALUE>
    <VALUE Lang="tw">就像現在你所做的事情那樣，從小開始到國家單位為止… 僅僅是規模不同而已，內容都相似。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_42_0_1">
    <VALUE Lang="tw">詢問細節</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_43_0">
    <VALUE Lang="tw">不清楚。是啊… 我只能說到這裡…</VALUE>
    <VALUE Lang="tw">最好尋找周圍的老師瞭解一下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_44_0">
    <VALUE Lang="tw">沒錯。不是很難的事情，快去快回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_45_0">
    <VALUE Lang="tw">雖然不大好，但好像不是能拒絕的立場啊。如果不幫我，我也不再多說什麼了。就當作做件好事，快去快回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_46_0">
    <VALUE Lang="tw">學生謝謝你幫忙把它們趕走</VALUE>
    <VALUE Lang="tw">辛苦你了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_46_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_47_0">
    <VALUE Lang="tw">我現在正在調查異變的發生，不過人手不足。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">想要請你幫忙，不過那個地方實在是非常危險。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_47_0_1">
    <VALUE Lang="tw">我會幫助您的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_48_0">
    <VALUE Lang="tw">很高興你有心要協助調查，不過以你現在的實力要去Leonine學院....實在是很危險</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">請再繼續完成更艱難訓練累積實力後，再來找我吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_48_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_49_0">
    <VALUE Lang="tw">哇！竟然這麼快就取得Bine Hands mutatant man eating Poison Ivy！看來這段時間訓練的成效還不錯！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_49_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_5_0">
    <VALUE Lang="tw">哼哼！！！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_5_0_1">
    <VALUE Lang="tw">您是誰？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_5_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_50_0">
    <VALUE Lang="tw">最近聽說異變事件發生後到現在Leonine 學院還有人存活...</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">去找它們打聽應該可以知道異變當天到底發生了什麼事情</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">這次的任務非常危險確定要幫忙打聽實際的情況嗎?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_50_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_51_0">
    <VALUE Lang="tw">這本 Leonine手冊雖然已經嚴重損毀不過它可是紀錄很多當時發生異變的情況</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">真的很謝謝你~幫忙找到這本珍貴的手冊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_51_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_6_0">
    <VALUE Lang="tw">只要我稍微退後, 我現在的位置應該就會被取代了.</VALUE>
    <VALUE Lang="tw">瞭解的話就打起精神.後退呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_6_0_1">
    <VALUE Lang="tw">要求進入 Leonair Campus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_6_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_7_0">
    <VALUE Lang="tw">你要從那邊進去?</VALUE>
    <VALUE Lang="tw">我現在站在這裡動也不能動, 你還說這種話.</VALUE>
    <VALUE Lang="tw">莫名其妙!不知是笨還是厲害</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_7_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_8_0">
    <VALUE Lang="tw">不差吧? 算還可以的...</VALUE>
    <VALUE Lang="tw">我只是想問一下你.</VALUE>
    <VALUE Lang="tw">沒事啦! 算了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_8_0_1">
    <VALUE Lang="tw">Special Agent的請托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_8_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_9_0">
    <VALUE Lang="tw">我在這裡動彈不得, 可以幫我一個忙嗎? 沒關係吧?</VALUE>
  </SENTENSE>
