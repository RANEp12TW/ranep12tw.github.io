  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_69_0_5">
    <VALUE Lang="tw">兌換Dozen Arrow物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_69_0_8">
    <VALUE Lang="tw">兌換Enhanced Cyclone Arrow物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_69_0_9">
    <VALUE Lang="tw">兌換 Destructive Arrow物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_7_0">
    <VALUE Lang="tw">신입생처럼 굴기는...</VALUE>
    <VALUE Lang="tw">곧장 나가면 현관이 있지?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_7_0_1">
    <VALUE Lang="tw">?쩊홁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_70_0">
    <VALUE Lang="tw">角色達到某特定級數，已成功獲取靈珠。現在可用靈珠來學習新技能唷。</VALUE>
  </SENTENSE>
