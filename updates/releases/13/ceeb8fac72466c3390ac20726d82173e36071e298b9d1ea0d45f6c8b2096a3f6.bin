    <VALUE Lang="tw">學習 Vampiric Attack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_12_0_4">
    <VALUE Lang="tw">學習Vibra Blast</VALUE>
