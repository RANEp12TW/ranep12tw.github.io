  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_10_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">自發性地接受考試是不錯啦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_10_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_11_0">
    <VALUE Lang="tw">很好, 算是良好的</VALUE>
    <VALUE Lang="tw">這種程度是一定要可以輕鬆過的, 不然你以後要走的路將會十分坎坷...</VALUE>
    <VALUE Lang="tw">總之定期能力測驗就這樣了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_11_0_1">
    <VALUE Lang="tw">接受指示 (紙幣驗證)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_11_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_12_0">
    <VALUE Lang="tw">不久前清潔工人把這丟給我後就走了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_12_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_13_0">
    <VALUE Lang="tw">那紙幣似乎確實有什麼重要的東西</VALUE>
    <VALUE Lang="tw">現在在路上常會看見有掉落的東西, 先撿起來收著吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_13_0_1">
    <VALUE Lang="tw">詢問Leonair Campus的位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_14_0">
    <VALUE Lang="tw">以前明明就在那邊Trading Hole Passage的附近</VALUE>
    <VALUE Lang="tw">但是某天突然消失不見</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_14_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_15_0">
    <VALUE Lang="tw">地圖的紙片真的還在呀</VALUE>
    <VALUE Lang="tw">搞不好老師也不知道至今還在真是太好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_15_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_16_0">
    <VALUE Lang="tw">嗯, 我正想要找人幫我做點事情</VALUE>
    <VALUE Lang="tw">為了確保學生跟市民最基本的安全我是有在持續整理拉</VALUE>
    <VALUE Lang="tw">不過最近這周圍為非作歹的傢伙變多了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_16_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_17_0">
    <VALUE Lang="tw">很好, 做的很好</VALUE>
    <VALUE Lang="tw">往後財團中有補給或支援的時候, 需要你協助的事情會很多喔</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_17_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_18_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">事​​情進行到這樣財團本部卻什麼話都沒說</VALUE>
    <VALUE Lang="tw">雖然消息有說要派重要人員來, 會不會都是財團內部…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_18_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_19_0">
    <VALUE Lang="tw">辛苦了</VALUE>
    <VALUE Lang="tw">但是以那群傢伙不知從何出現且數量越來越多的狀態來看, 是不可以坐視不管的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_19_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_2_0">
    <VALUE Lang="tw">嗯......</VALUE>
    <VALUE Lang="tw">歡迎來到Sacred Gate Ring！</VALUE>
    <VALUE Lang="tw">需要什麼幫忙呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_2_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_2_0_2">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_20_0">
    <VALUE Lang="tw">Student Director沒有說過這種話嗎</VALUE>
    <VALUE Lang="tw">這世界上沒有可以坐視不管的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_20_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_21_0">
    <VALUE Lang="tw">........</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_22_0">
    <VALUE Lang="tw">反正學生或是老師都會定期考試來測定能力, 希望你不要覺得煩</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_22_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_23_0">
    <VALUE Lang="tw">敵人的能力也在變, 稍微有變強, 要順便消除自負的態度</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_23_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_24_0">
    <VALUE Lang="tw">.........</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_25_0">
    <VALUE Lang="tw">是啊看起來跟錢沒兩樣, 不過仔細看是偽鈔</VALUE>
    <VALUE Lang="tw">但問題是詢問之後卻有並非偽鈔的反應出現</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_25_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_26_0">
    <VALUE Lang="tw">而且紙幣周圍反射奇怪的文字, 似乎是古代的神秘暗號。</VALUE>
    <VALUE Lang="tw">總之，這些紙幣本身似乎帶有什麼意義, 拜託你拿去確定一下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_26_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_27_0">
    <VALUE Lang="tw">啊！這必須由老師保管，拿去給Technical Teacher 吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_27_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_28_0">
    <VALUE Lang="tw">.......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_29_0">
    <VALUE Lang="tw">而且那個位置, 從以前就有的東西, 比如說像建築物, 現在卻被入侵的人們佔據</VALUE>
    <VALUE Lang="tw">雖說與異變發生的時間點相同</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_29_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_3_0">
    <VALUE Lang="tw">什麼？你問的問題就像第一次來這裡的人似的。</VALUE>
    <VALUE Lang="tw">朝著Sacred Gate Park，往右邊走是Phoenix學院；往左邊走的話是Mystic Peak學院；往後面走是Sacred Gate學院。</VALUE>
    <VALUE Lang="tw">好吧, 現在想起來沒？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_30_0">
    <VALUE Lang="tw">問題不出在那, 而是Leonair Campus現在到底在哪裡？</VALUE>
    <VALUE Lang="tw">有人說在Sacred Gate Park的南邊, 也有人說在北邊, 不直接去確定的話根本無法得知。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_30_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_31_0">
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">但是聽說剛好有個叫做Cheng Xi Zhi的弓箭部學生, 確定了Leonair Campus的位置, 還做了張地圖。</VALUE>
    <VALUE Lang="tw">那地圖卻被怪人搶奪, 被撕成一片一片的..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_31_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_32_0">
    <VALUE Lang="tw">雖然不知道那怪人是誰重要的是如何找到那被撕成一片片的地圖</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_32_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_33_0">
    <VALUE Lang="tw">地圖被撕破的時候附近有小丑這樣會找不到嗎</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_33_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_34_0">
    <VALUE Lang="tw">........</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_35_0">
    <VALUE Lang="tw">來看看 剩不到七張 怎麼這麼亂阿</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_35_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_36_0">
    <VALUE Lang="tw">哎呀不管老師再怎麼拼湊都不行的吧</VALUE>
    <VALUE Lang="tw">字太草, 圖案也不規則, 損傷很嚴重, 連接線不確實</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_36_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_37_0">
    <VALUE Lang="tw">Student Director有做過遺跡挖掘的工作, 搞不好可以拼湊的起來</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_37_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_38_0">
    <VALUE Lang="tw">.....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_39_0">
    <VALUE Lang="tw">不管怎樣因為人力不足就這樣放任她們變多的話後果將不堪射想</VALUE>
    <VALUE Lang="tw">即使只有一點點餘力如能將會造成禍端的東西消失就太好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_39_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_4_0">
    <VALUE Lang="tw">以前來玩的時候有很多鳥跟小孩，現在卻變的殺氣騰騰。</VALUE>
    <VALUE Lang="tw">那時小丑Clown還邊賣氣球邊跟我們玩，真是開心啊。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_40_0">
    <VALUE Lang="tw">......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_41_0">
    <VALUE Lang="tw">啊, 不要操心了</VALUE>
    <VALUE Lang="tw">是老師自己在那邊講的</VALUE>
    <VALUE Lang="tw">總之, 辛苦啦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_41_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_42_0">
    <VALUE Lang="tw">......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_43_0">
    <VALUE Lang="tw">到底財團有沒有意思要幫忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_43_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_44_0">
    <VALUE Lang="tw">真是抱歉</VALUE>
    <VALUE Lang="tw">你們還需要再教育往後有事情的話才可以應付</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_44_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_45_0">
    <VALUE Lang="tw">.......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_46_0">
    <VALUE Lang="tw">雖然當下會覺得悶悶的</VALUE>
    <VALUE Lang="tw">事實上我們的老師知道的並不多</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_46_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_47_0">
    <VALUE Lang="tw">能夠告訴我們的正反面還不一定是對的</VALUE>
    <VALUE Lang="tw">怎麼說哩…說一加一不等於二, 不就讓人無法理解嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_47_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_48_0">
    <VALUE Lang="tw">哇，都主動要考試，真不簡單!</VALUE>
    <VALUE Lang="tw">那麼不需要說廢話了吧?</VALUE>
    <VALUE Lang="tw">看看…要找適當的題材不容易耶。</VALUE>
    <VALUE Lang="tw">好，那種程度應該可以…</VALUE>
    <VALUE Lang="tw">依你的程度應該知道 '寒冰將領' 吧?</VALUE>
    <VALUE Lang="tw">嚇什麼…</VALUE>
    <VALUE Lang="tw">這次的考試課題就是打倒那傢伙。</VALUE>
    <VALUE Lang="tw">不會像之前的考試一樣有限制時間。</VALUE>
    <VALUE Lang="tw">不管幾次挑戰看看吧!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_48_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_49_0">
    <VALUE Lang="tw">?</VALUE>
    <VALUE Lang="tw">真的打敗那個寒冰將領?</VALUE>
    <VALUE Lang="tw">真的變的這麼強。</VALUE>
    <VALUE Lang="tw">他給人的感覺冷冰冰的實在是不想去惹他…</VALUE>
    <VALUE Lang="tw">反正考試是合格了!</VALUE>
    <VALUE Lang="tw">以後可能不需要透過老師考試了。</VALUE>
    <VALUE Lang="tw">也找不到適合的題材。</VALUE>
    <VALUE Lang="tw">話說回來。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_49_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0">
    <VALUE Lang="tw">득도의 경지에 이른 『마루치』 와 『아라치』 의 기운이 서로 만날 때 이르는 경지를 가리키는 말인데</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">본래는 소승불교에서 모든 번뇌를 뚫고 이치를 깨달아 열반의 경지에 이른 성자를 말이고 『나한』 이라고도 하지</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0_1">
    <VALUE Lang="tw">'깨달음의 열쇠' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0_2">
    <VALUE Lang="tw">'나한의 구슬' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0_3">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_50_0">
    <VALUE Lang="tw">要會到本洞那裡嗎。</VALUE>
    <VALUE Lang="tw">時間停止真是意外。</VALUE>
    <VALUE Lang="tw">以為空間軸會變</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_50_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_51_0">
    <VALUE Lang="tw">......</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_52_0">
    <VALUE Lang="tw">財團的社會活動？我們學院都屬於同一個財團，這當然知道。</VALUE>
    <VALUE Lang="tw">這麼說上課時間裡沒有提過財團的事情。</VALUE>
    <VALUE Lang="tw">嗯… 我說這些話可能會覺得我沒有責任心,但是對這些財團的背景還是有距離感… 太詳細的內容, 我也不是非常的清楚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_53_0">
    <VALUE Lang="tw">聽說 Leonine學院負責調查異變事件的Dispatched Agent已經被 Saint Private Guards(= Sacred Gate Defender)弄得不勘其擾。請你幫忙把它們趕走讓Dispatched Agent可以專心調查。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_53_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_6_0">
    <VALUE Lang="tw">그 열쇠를 지니고 있다면 재단에 보관중인 걸 받을 수도 있게 된다는 얘기는 들었지</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">하지만 지금은 조각조각으로 나뉘어져 있을테니까 일단 7조각을 모으게 되면 나한테 가져오도록 해</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_6_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_7_0">
    <VALUE Lang="tw">아, 그 녹색 구슬 말이지?</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">그냥 하나씩만으로는 별다를 게 없는데 30개를 다 합쳐서 목걸이를 만들면 꽤 쓸만해 진다지</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_7_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0">
    <VALUE Lang="tw">嗯…. 您想問什麼呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0_1">
    <VALUE Lang="tw">詢問方向</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0_2">
    <VALUE Lang="tw">詢問關於Sacred Gate Park的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0">
    <VALUE Lang="tw">啊? 聽Construction Supervisor 說過</VALUE>
    <VALUE Lang="tw">你接受我的請托 真是非常感謝</VALUE>
    <VALUE Lang="tw">他們也知道現在的狀況在某種程度上來說是很奇怪的, 所以盡可能幫你, 做的真是太好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0_1">
    <VALUE Lang="tw">申請考試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0_2">
