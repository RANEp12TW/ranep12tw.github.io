    <VALUE Lang="tw">學生們要拿著紙幣去給Mystic Peak學院的Student Director，以學習Suggestion Book。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_81_0_1">
