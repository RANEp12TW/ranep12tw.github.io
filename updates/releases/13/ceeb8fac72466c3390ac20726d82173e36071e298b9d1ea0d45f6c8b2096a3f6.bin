    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_2_0_1">
    <VALUE Lang="tw">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_2_0_2">
    <VALUE Lang="tw">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_3_0">
    <VALUE Lang="tw">我有遇見從 Leonine Campus出來的人。</VALUE>
    <VALUE Lang="tw">我清楚地記得，有人突然攻擊我，然後我進入了獅族校園。什麼？為什麼我的屍體還在這裡......？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_4_0">
    <VALUE Lang="tw">我好像也跟他們一樣變成怪物了,</VALUE>
    <VALUE Lang="tw">在死掉的瞬間被傳送到這裡來了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_4_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_5_0">
    <VALUE Lang="tw">現在準備什麼都太晚了,</VALUE>
    <VALUE Lang="tw">只好盡量努力不要再有任何犧牲了...</VALUE>
    <VALUE Lang="tw">還有以後遇見已經變身的我, 不要猶豫, 就殺了我吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_5_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_6_0">
    <VALUE Lang="tw">而且依稀感覺到我被複製成很多個,</VALUE>
    <VALUE Lang="tw">不知有多少朋友遭到襲擊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex1.ntk_6_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
