  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_maingate1.ntk_1_0_2">
    <VALUE Lang="tw">申請Main Entrance的通過測驗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_maingate1.ntk_1_0_3">
