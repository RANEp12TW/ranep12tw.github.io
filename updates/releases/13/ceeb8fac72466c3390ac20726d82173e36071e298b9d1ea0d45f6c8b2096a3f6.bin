    <VALUE Lang="tw">詢問是什麼事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex3.ntk_1_0_2">
    <VALUE Lang="tw">詢問怎麼可以說話</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex3.ntk_1_0_3">
