  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_6_0">
    <VALUE Lang="tw">這是錄影帶？</VALUE>
    <VALUE Lang="tw">那麼，您要給我什麼？</VALUE>
    <VALUE Lang="tw">你給我收，我給你收，將才能維持好平衡啊。</VALUE>
