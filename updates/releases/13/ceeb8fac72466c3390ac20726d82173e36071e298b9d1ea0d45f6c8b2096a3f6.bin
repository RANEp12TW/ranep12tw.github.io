    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_125_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
