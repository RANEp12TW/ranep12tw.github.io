  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_28_0_1">
    <VALUE Lang="tw">Angry Quack Quack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_28_0_2">
    <VALUE Lang="tw">Whipping Artist</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_28_0_3">
    <VALUE Lang="tw">Magicknife Illusion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_28_0_4">
    <VALUE Lang="tw">Titan's Determination</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_28_0_5">
    <VALUE Lang="tw">上一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_3_0">
    <VALUE Lang="tw">我知道你的情況很好, 但是我不能冒任何的風險了, 把這當成是一種安慰吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_4_0">
    <VALUE Lang="tw">坐車去Mystic peak Lake Shop, 消滅Stray Dogs.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_5_0">
    <VALUE Lang="tw">去MarketPlace, Assassin Student有詳細情報</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_6_0">
    <VALUE Lang="tw">你必須小心! 他不是一個那麼簡單的敵人.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0">
    <VALUE Lang="tw">如果你有Spirit Spheres, 就能學習. 你想學什麼技能.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0_1">
    <VALUE Lang="tw">Sand Dust</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0_2">
    <VALUE Lang="tw">Whipped</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0_3">
    <VALUE Lang="tw">Glittering Bees</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0_4">
    <VALUE Lang="tw">上一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_8_0">
    <VALUE Lang="tw">如果你有Spirit Spheres, 就能學習. 你想學什麼技能.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_8_0_1">
    <VALUE Lang="tw">Scratch</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_8_0_2">
    <VALUE Lang="tw">上一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0">
    <VALUE Lang="tw">如果你有Spirit Spheres, 就能學習. 你想學什麼技能.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_1">
    <VALUE Lang="tw">Card Throw</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_2">
    <VALUE Lang="tw">Whip Slash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_3">
    <VALUE Lang="tw">Swarming Locusts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_4">
    <VALUE Lang="tw">Titan's Will</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_5">
    <VALUE Lang="tw">上一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0">
    <VALUE Lang="tw">嘿！哈嘍！</VALUE>
    <VALUE Lang="tw">您為何這麼緊張？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_1">
    <VALUE Lang="tw">聽取對話</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_2">
    <VALUE Lang="tw">Bus Driver的請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_3">
    <VALUE Lang="tw">Construction Supervisor的請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_4">
    <VALUE Lang="tw">傳達零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_5">
    <VALUE Lang="tw">Physic Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_10_0">
    <VALUE Lang="tw">不好意思, 可以幫我從Technical Teacher那邊拿發電機的零件來嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_10_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_11_0">
    <VALUE Lang="tw">我因為那群瘋狂的勞工而動彈不得,只怕我一離開他們就會將我已做好的工程都被搞砸了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_11_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_12_0">
    <VALUE Lang="tw">.....7</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_13_0">
    <VALUE Lang="tw">沒錯! 這就是我之前找的零件</VALUE>
    <VALUE Lang="tw">真是多謝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_13_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_14_0">
    <VALUE Lang="tw">雖然沒有讓它不再故障的辦法, 不過可以作業好一陣子了.</VALUE>
    <VALUE Lang="tw">不過這到底是怎麼搞的, 人們會變成那模樣</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_14_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_2_0">
    <VALUE Lang="tw">....</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_3_0">
    <VALUE Lang="tw">本來在旁邊管理工程, 現在卻躲的遠遠的.</VALUE>
    <VALUE Lang="tw">大事不妙~ 工程期限就快到了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_4_0">
    <VALUE Lang="tw">是該做事沒錯, 不過人們變的怪怪的, 機器也故障, 實在麻煩</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_4_0_1">
    <VALUE Lang="tw">請問是誰？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_5_0">
    <VALUE Lang="tw">喔,把這種學生送走吧</VALUE>
    <VALUE Lang="tw">沒時間沒辦法呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_5_0_1">
    <VALUE Lang="tw">Construction Supervisor的請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_6_0">
    <VALUE Lang="tw">聽聽我的請求</VALUE>
    <VALUE Lang="tw">為了要在期限內完工,必須要使用機器人來代替瘋掉的工人們,但是現在竟然連發電機都壞掉了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_6_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_7_0">
    <VALUE Lang="tw">上次聽劍道部一個學生朋友說, 不是只有這裡這樣子..</VALUE>
    <VALUE Lang="tw">唉... 世界將會變成什麼樣子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_7_0_1">
    <VALUE Lang="tw">Physics Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_8_0">
    <VALUE Lang="tw">阿 差點嚇死</VALUE>
    <VALUE Lang="tw">剛剛Sacred Gate College的Physics Teacher那邊有消息傳來</VALUE>
    <VALUE Lang="tw">他說會去Sacred Gate Ring等您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_9_0">
    <VALUE Lang="tw">.....6</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0">
    <VALUE Lang="tw">詢問什麼是"端午節"。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_1">
    <VALUE Lang="tw">是的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_2">
    <VALUE Lang="tw">領取經驗獎勵</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_3">
    <VALUE Lang="tw">交換 Exorcist Ring(15D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_2_0">
    <VALUE Lang="tw">我相信您！您做得到的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0">
    <VALUE Lang="tw">你好~!在這裡看起來像個外地來的…</VALUE>
    <VALUE Lang="tw">來這裡…因為那些傢伙讓我無法逃離這地方。</VALUE>
    <VALUE Lang="tw">可以幫我一個忙嗎</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_1">
    <VALUE Lang="tw">進行交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_2">
    <VALUE Lang="tw">Miscellaneos Savior</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_3">
    <VALUE Lang="tw">斯德哥爾摩症候群</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_4">
    <VALUE Lang="tw">收集Terrorist的補給品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_5">
    <VALUE Lang="tw">Heavy Destroyer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_6">
    <VALUE Lang="tw">通行證收集狂</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_7">
    <VALUE Lang="tw">兌換禮票</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_8">
    <VALUE Lang="tw">通行證收集狂</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_2_0">
    <VALUE Lang="tw">咕嚕咕嚕....唉攸我的肚子。躲在這裡好幾天都沒吃東西，快餓扁了..</VALUE>
    <VALUE Lang="tw">你身上有吃的嗎? 幫我找到吃的就送給你我的收藏品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_2_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_3_0">
    <VALUE Lang="tw">這幾天困在這裡發現一件奇怪的事。一開始反抗的工人慢慢和偵搜部隊靠攏開始協助他們。</VALUE>
    <VALUE Lang="tw">請盡快阻止他們不要讓更多人​​被同化。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_4_0">
    <VALUE Lang="tw">聽說偵搜部隊每個人都有一張通行證Certificate。曾經看到他們在領取補給品時拿出通行證</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_5_0">
    <VALUE Lang="tw">有一些工人看起來是負責重裝備技術。想到如果他們把零件組裝開始動亂...想到就覺得很可怕。</VALUE>
    <VALUE Lang="tw">你也來一起幫忙說不定可以扭轉情勢</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_5_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_6_0">
    <VALUE Lang="tw">所以。這裡是Terrorist Area！</VALUE>
    <VALUE Lang="tw">您的反應真快！怎麼會知道我想要的是什麼？</VALUE>
    <VALUE Lang="tw">哈哈！現在身上沒有這個東西，不過只要搜集兌換券交給我，就可以給你我的收藏品。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_6_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert_chainsaw.ntk_1_0">
    <VALUE Lang="tw">等...一下!!我跟偵搜部隊一點關係也沒有!呼...我也看他們很不順眼，有任何需要儘管跟我說</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert_chainsaw.ntk_1_0_1">
    <VALUE Lang="tw">進行交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0">
    <VALUE Lang="tw">……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_1">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_10">
    <VALUE Lang="tw">取得確認</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_2">
    <VALUE Lang="tw">詢問她是誰？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_3">
    <VALUE Lang="tw">詢問Garansanoa的同伴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_4">
    <VALUE Lang="tw">告訴他，您會阻止Lucian。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_5">
    <VALUE Lang="tw">我想要幫忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_6">
    <VALUE Lang="tw">取得確認</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_7">
    <VALUE Lang="tw">淨化 Basement</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_8">
    <VALUE Lang="tw">取得確認</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_9">
    <VALUE Lang="tw">我想要幫Priest的忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_10_0">
    <VALUE Lang="tw">這不是件容易的事情。他們比High Elders還要強大，請您務必要小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_10_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_11_0">
    <VALUE Lang="tw">好姐妹…..請別那麼緊繃。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_11_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_2_0">
    <VALUE Lang="tw">我是服侍Daian 的Priest。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_2_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_3_0">
    <VALUE Lang="tw">一個叫做Lucian的人，試圖要傷害 Garansanoa的朋友Liz，甚至奪取Adoniechus絕對起點。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_3_0_1">
    <VALUE Lang="tw">詢問還有其他人嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_4_0">
    <VALUE Lang="tw">這個嘛…. 有個從Roo Tribe來的族人，叫作Gainun。跟我們很不一樣，您必須加強警戒，小心提防。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_4_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_5_0">
    <VALUE Lang="tw">這是和您無關的事情。不過，如果您幫我的話，我可以考慮接受您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_5_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_6_0">
    <VALUE Lang="tw">請對付 Hillo。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_6_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_7_0">
    <VALUE Lang="tw">不錯唷。 你要再試試嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_7_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_8_0">
    <VALUE Lang="tw">請對付Cyclop。它的力量很強，請小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_8_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_9_0">
    <VALUE Lang="tw">很好。請繼續淨化失去理智的人。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_9_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_battlefield_helper.ntk_1_0">
    <VALUE Lang="tw">我可以幫你什麼忙嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_battlefield_helper.ntk_1_0_1">
    <VALUE Lang="tw">出售道具</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0">
    <VALUE Lang="tw">這裡是公車站。只要您擁有Bus Ticket ，就可以使用公車服務，暢遊各地區唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_1">
    <VALUE Lang="tw">搭乘公車</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_10">
    <VALUE Lang="tw">傳送文件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_3">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_4">
    <VALUE Lang="tw">寄出Skill Document。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_5">
    <VALUE Lang="tw">找出被偷走的Dry Ice。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_6">
    <VALUE Lang="tw">傳遞 Emergency Action Guide。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_7">
    <VALUE Lang="tw">調查死亡的Police。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_8">
