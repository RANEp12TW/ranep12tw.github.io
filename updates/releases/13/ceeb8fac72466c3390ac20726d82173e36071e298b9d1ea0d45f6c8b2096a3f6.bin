  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_8_0">
    <VALUE Lang="tw">還真是血氣旺盛的學生啊</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
