    <VALUE Lang="tw">物品買賣</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex3.ntk_3_0">
    <VALUE Lang="tw">我還不想死..</VALUE>
    <VALUE Lang="tw">還有好多事情沒有做..!</VALUE>
    <VALUE Lang="tw">不想就這樣死掉~!"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex3.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex3.ntk_4_0">
    <VALUE Lang="tw">這.. 我還沒死, 當然可以說話!</VALUE>
    <VALUE Lang="tw">我還沒死, 還活著!</VALUE>
    <VALUE Lang="tw">我還活著</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex3.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex3.ntk_5_0">
    <VALUE Lang="tw">我..也不知道..</VALUE>
    <VALUE Lang="tw">現在我什麼也不記得了..</VALUE>
    <VALUE Lang="tw">不過有沒有記憶已經無所謂了</VALUE>
    <VALUE Lang="tw">讓我就這樣活下去吧!</VALUE>
    <VALUE Lang="tw">聽不到我的聲音嗎?</VALUE>
    <VALUE Lang="tw">我說我不想死</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_s_ex3.ntk_5_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_1_0">
    <VALUE Lang="tw">설마 그 열쇠는...!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">틀림없군 『깨달음의 열쇠』야!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">어디서 구한 건지는 모르겠지만 대단한데!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">그 열쇠를 지니고 있다면 이 반지의 주인이 될 수 있다는 얘기지.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">자, 열쇠를 나에게 주고 반지를 받도록 해.</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
