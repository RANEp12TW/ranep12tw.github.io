  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_7">
    <VALUE Lang="tw">傳達指令文件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_8">
    <VALUE Lang="tw">詢問 Leonair 學院的位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_9">
    <VALUE Lang="tw">確認地圖紙片</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_10_0">
    <VALUE Lang="tw">自發性地接受考試是不錯啦!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">反正學生或是老師都會定期考試來測定能力,希望你不要覺得煩</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_10_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_11_0">
    <VALUE Lang="tw">嗯!很好!算是良好的</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">這種程度是穩可以過的,用這試著去想以後,這樣想的話就理所當然的東西也…</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">總之定期能力測驗就這樣了</VALUE>
