  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0">
    <VALUE Lang="tw">請在這邊兌換您的'Check In Badges'！</VALUE>
    <VALUE Lang="tw">兌換之後是沒有折扣的 ！請注意，兌換之後是沒有折扣的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_1">
    <VALUE Lang="tw">我該如何得到徽章呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_2">
    <VALUE Lang="tw">拿10 Check In Badges 去兌換1個 'I-Ran Man Suit Prototype (7D)'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_3">
    <VALUE Lang="tw">拿15 Check In Badges 去兌換1個 'I-Ran Man Suit Prototype (15D)'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_4">
    <VALUE Lang="tw">拿20 Check In Badges 去兌換1個 'I-Ran Man Suit Prototype (30D)'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_2_0">
    <VALUE Lang="tw">在活動期間，可向位在Market Place的Student Counselor NPC索取「Check In Badges」。 不過請注意，您需要登錄至少30分鐘以上，Ran時間已經開始計算，別忘了看時間。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_2_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
