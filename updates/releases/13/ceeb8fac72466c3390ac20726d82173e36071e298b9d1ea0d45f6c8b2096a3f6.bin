  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0">
    <VALUE Lang="tw">請選擇需要的資料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_1">
    <VALUE Lang="tw">研究設施的構造</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_2">
    <VALUE Lang="tw">絕對起點和聖石</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_3">
    <VALUE Lang="tw">複製靈</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_4">
    <VALUE Lang="tw">聖徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_5">
    <VALUE Lang="tw">守護計劃</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_6">
    <VALUE Lang="tw">財團沿革</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_3_0">
    <VALUE Lang="tw">聖財團直屬Laboratory - Root Hole、Head Office</VALUE>
    <VALUE Lang="tw">監獄Laboratory - Sacred Private Prison</VALUE>
    <VALUE Lang="tw">學院Laboratory - Sacred Gate、Mystic Peak、Phoenix、Leonine</VALUE>
    <VALUE Lang="tw">美洲Laboratory - Alaska、Lio De Janeiro</VALUE>
    <VALUE Lang="tw">歐亞大陸Laboratory - Jakarta</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_3_0_1">
    <VALUE Lang="tw">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_4_0">
    <VALUE Lang="tw">絕對起點的研究</VALUE>
    <VALUE Lang="tw">如同物體的組成要素有原子和電子。那樣的世界中心起核心作用之後，所產生的基準點就叫做『絕對起點』。</VALUE>
    <VALUE Lang="tw">以空間和時間區分的每個範圍都有~~的存在。它們有著劃分鄰接範圍與邊界範圍的作用，甚至有保護區域內的效果。</VALUE>
    <VALUE Lang="tw">不過，無法非常的肯定的是，現在的絕對起點是否仍保有它的本質。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_4_0_1">
    <VALUE Lang="tw">繼續</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_5_0">
    <VALUE Lang="tw">聖石的研究報告</VALUE>
    <VALUE Lang="tw">在絕對起點的周圍，它有著天線的作用。不太確定每個範圍是否有聖石的數值出現，不過可以確定的是，每個聖石都有著不同的用處。可是，不同時間和不同空間的聖石會相互排斥。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_5_0_1">
    <VALUE Lang="tw">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0">
    <VALUE Lang="tw">該終端機具有共享聖財團的資料機能。</VALUE>
    <VALUE Lang="tw">若您輸入了文件裡的任何資料，您將可以進行搜尋聖財團的情報。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_1">
    <VALUE Lang="tw">文件的輸入件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_2">
    <VALUE Lang="tw">文件的輸入件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_3">
    <VALUE Lang="tw">文件的輸入件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_4">
    <VALUE Lang="tw">文件的輸入件</VALUE>
  </SENTENSE>
