    <VALUE Lang="tw">傳達藥品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_13">
    <VALUE Lang="tw">申請測驗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_14">
    <VALUE Lang="tw">確認測試結果</VALUE>
  </SENTENSE>
