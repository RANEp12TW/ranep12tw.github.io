  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_10_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_2_0">
    <VALUE Lang="tw">技能點數從0個開始計算，每當角色等級晉級時，就會增加 1個技能點數。您可利用這些技能點數，來學習新的技能，亦或是提升舊技能的等級。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_2_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_3_0">
    <VALUE Lang="tw">但是你的技能點數可能不夠讓你學到Grade 16的技能。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_3_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_4_0">
    <VALUE Lang="tw">讓我來提供你一些機會得到技能點數。</VALUE>
    <VALUE Lang="tw">每完成一件我交代給你的任務，你將會得到兩點的技能點數。</VALUE>
    <VALUE Lang="tw">不過，有些任務可不是那麼簡單喔!</VALUE>
    <VALUE Lang="tw">祝你好運!!</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0">
    <VALUE Lang="tw">讓我們開始衝任務吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_1">
    <VALUE Lang="tw">消滅Boss - Chief Hooligan</VALUE>
  </SENTENSE>
