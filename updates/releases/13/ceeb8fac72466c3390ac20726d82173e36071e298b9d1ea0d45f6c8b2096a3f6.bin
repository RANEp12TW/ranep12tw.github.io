  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_2_4">
    <VALUE Lang="tw">歸還掃帚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_2_5">
