  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_7_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0">
