  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0">
    <VALUE Lang="tw">我不存...</VALUE>
    <VALUE Lang="tw">這個世上有我嗎...</VALUE>
    <VALUE Lang="tw">在我心中有世上嗎...</VALUE>
    <VALUE Lang="tw">對我而言我不存在, 對世上而言那個世上也不存在...</VALUE>
    <VALUE Lang="tw">呵呵..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0_1">
