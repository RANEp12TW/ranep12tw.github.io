    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_27_0">
    <VALUE Lang="tw">原來這就是傳聞中的紙幣路</VALUE>
    <VALUE Lang="tw">哪裡…果然…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_27_0_1">
