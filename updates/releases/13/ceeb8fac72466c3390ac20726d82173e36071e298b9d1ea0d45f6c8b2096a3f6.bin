    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_23_0">
    <VALUE Lang="tw">原來這就是傳聞中的紙幣!</VALUE>
    <VALUE Lang="tw">哪裡…果然…</VALUE>
    <VALUE Lang="tw">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_23_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_24_0">
    <VALUE Lang="tw">啊,學生們以後若需要紙幣時會再通知你們,從那時要集合在看取得的地方</VALUE>
    <VALUE Lang="tw">我再說一次,這絕對不是普通的錢</VALUE>
