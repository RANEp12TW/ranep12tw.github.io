  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_0">
    <VALUE Lang="tw">掃把？反正我在處理事情時，拿著掃把也是挺不方便的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_0_1">
