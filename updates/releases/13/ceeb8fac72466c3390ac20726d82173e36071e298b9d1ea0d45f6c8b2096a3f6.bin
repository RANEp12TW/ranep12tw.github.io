  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_9_0">
    <VALUE Lang="tw">雖有幾個人經過這位老年人</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">擔心我身體的，學生倒是一個呀</VALUE>
