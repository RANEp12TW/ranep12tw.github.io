  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_98_0">
    <VALUE Lang="tw">오랜만에 반가운 걸 가져왔는데 좀 아쉽군</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
