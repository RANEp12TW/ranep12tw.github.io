  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_97_0">
    <VALUE Lang="tw">我會給您所需的技能文書，但同時您也得給我靈珠作交換，瞭解吧？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_97_0_1">
