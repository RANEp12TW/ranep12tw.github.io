  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_1_0">
    <VALUE Lang="tw">如果你不是一個魔術師, 我沒有什麼能幫你做的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_1_0_1">
    <VALUE Lang="tw">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_1_1">
    <VALUE Lang="tw">學習一個強大的魔術不是一件容易的事情. 它需要不懈的努力和練習. 那麼, 你希望我幫你做什麼？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_1_1_1">
    <VALUE Lang="tw">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_1_1_10">
    <VALUE Lang="tw">要求 4st Grade of Spirit Sphere.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_1_1_11">
    <VALUE Lang="tw">要求 5st Grade of Spirit Sphere.</VALUE>
  </SENTENSE>
