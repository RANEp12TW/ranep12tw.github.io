<?xml version="1.0" encoding="utf-8"?>
<TEXT>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0">
    <VALUE Lang="tw">Pierrot過渡忙於RAN學生的活動，結果竟然變身為Joker了。若不趕緊抓到Joker的話，校園秩序會大亂的。請將Joker一開始要給學生們準備的禮物帶過來唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_1">
    <VALUE Lang="tw">我可以在哪兒找到Joker？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_2">
    <VALUE Lang="tw">我可以在哪裡拿到副本的入場卷呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_3">
    <VALUE Lang="tw">取得禮盒的位置？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0">
    <VALUE Lang="tw">Joker 正躲在封閉的副本裡。那邊有許多危險的陷阱，您要找到他是很不容易的。記得，要有入場卷，才能進去唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0_2">
    <VALUE Lang="tw">取得入場卷的方法？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0">
    <VALUE Lang="tw">Ran的怪物都被 Joker的邪噁心靈給污染了。它們現在會掉落Matryoshka Boxes！</VALUE>
    <VALUE Lang="tw">沒有人知道開啟禮盒之後，會拿到什麼物品。但您一定可以找到被Joker給藏起來的入場卷。請努力獲得更多禮盒，並開啟它們吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0_2">
    <VALUE Lang="tw">取得禮物的方法？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0">
    <VALUE Lang="tw">追尋副本內怪物的腳步，就可找到Boss的蹤跡。消滅怪物，就有機會獲得禮盒唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0_2">
    <VALUE Lang="tw">請兌換。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0">
    <VALUE Lang="tw">為了取得禮物，您需要準備以下內容：</VALUE>
    <VALUE Lang="tw">--</VALUE>
    <VALUE Lang="tw">Pierrot Badge 100ea + Joker Badge 80ea</VALUE>
    <VALUE Lang="tw">= Jester King's Hat</VALUE>
    <VALUE Lang="tw">Pierrot Badge 150ea + Joker Badge 100ea +</VALUE>
    <VALUE Lang="tw">Joker Card 100ea</VALUE>
    <VALUE Lang="tw">= Joker Look Box (7D)</VALUE>
    <VALUE Lang="tw">Pierrot Badge 200ea + Joker Badge 150ea +</VALUE>
    <VALUE Lang="tw">Joker Card 150ea</VALUE>
    <VALUE Lang="tw">= Jo</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_1">
    <VALUE Lang="tw">我要Jester King's Hat！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_2">
    <VALUE Lang="tw">我要Joker Look Box！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_3">
    <VALUE Lang="tw">我要Joker Bike！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_event_club.ntk_1_0">
    <VALUE Lang="tw">我是Super Robot，專門賣ClubWar重要的補給品。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_event_club.ntk_1_0_1">
    <VALUE Lang="tw">兌換糖果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_0">
    <VALUE Lang="tw">嗚嗚！嗚嗚！汪汪！汪汪！嗚嗚！嗚嗚！汪汪！汪汪！</VALUE>
    <VALUE Lang="tw">嗚嗚！嗚嗚！汪汪！汪汪！嗚嗚！嗚嗚！汪汪！汪汪！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_1">
    <VALUE Lang="tw">嗚嗚！嗚嗚！汪汪！汪汪！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_1_1">
    <VALUE Lang="tw">我們好像應該要哄他入睡才能通過。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_1_2">
    <VALUE Lang="tw">餵吃安眠藥</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_2_0">
    <VALUE Lang="tw">Zzz...Zzz...Zzz....Zzz</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th02.ntk_1_0">
    <VALUE Lang="tw">哈哈哈！歡迎！我有一些魔法物品喲。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th02.ntk_1_0_1">
    <VALUE Lang="tw">販賣物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th03.ntk_1_0">
    <VALUE Lang="tw">Ran World正舉辦Ran的4週年慶典。請給我們一些掌聲與祝賀吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th03.ntk_1_0_1">
    <VALUE Lang="tw">領取4週年禮盒</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_0">
    <VALUE Lang="tw">不想和童話故事中的白馬王子見面嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_1">
    <VALUE Lang="tw">您有搭過嗎？這真的很棒！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_2">
    <VALUE Lang="tw">他們只愛正妹~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_3">
    <VALUE Lang="tw">嗶嗶嗶~！嚇到了嗎？哦…您沒有被嚇到啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_3_1">
    <VALUE Lang="tw">不給糖就搗蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_2_0">
    <VALUE Lang="tw">我還會再給您一顆Candy，請明天再過來一趟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_2_0_1">
    <VALUE Lang="tw">詢問除了Candy之外，還有其他東西嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_0">
    <VALUE Lang="tw">或許他才是Halloween day真正的主角。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_1">
    <VALUE Lang="tw">這個很容易著火。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_2">
    <VALUE Lang="tw">他們的床非常地黑暗，即使是天亮，也不會有人知道。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_3">
    <VALUE Lang="tw">嗶嗶嗶~！嚇到了嗎？哦…您沒有被嚇到啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_3_1">
    <VALUE Lang="tw">不給糖就搗蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_2_0">
    <VALUE Lang="tw">我還會再給您一顆Candy，請明天再過來一趟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_2_0_1">
    <VALUE Lang="tw">詢問除了Candy之外，還有其他東西嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_0">
    <VALUE Lang="tw">我無法理解，為何那個醜八怪人緣那麼好。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_1">
    <VALUE Lang="tw">每當家裡有客人來時，他就會變得很忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_2">
    <VALUE Lang="tw">他們總是和蚊子進行戰鬥。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_3">
    <VALUE Lang="tw">嗶嗶嗶~！嚇到了嗎？哦…您沒有被嚇到啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_3_1">
    <VALUE Lang="tw">不給糖就搗蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_2_0">
    <VALUE Lang="tw">我還會再給您一顆Candy，請明天再過來一趟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_2_0_1">
    <VALUE Lang="tw">詢問除了Candy之外，還有其他東西嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_0">
    <VALUE Lang="tw">您知道 π 是什麼意思嗎？據我所知，好像是 3，14….什麼的….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_1">
    <VALUE Lang="tw">看到他們的人頭落地，我的心情好難受。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_2">
    <VALUE Lang="tw">他們出生於Romania。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_3">
    <VALUE Lang="tw">嗶嗶嗶~！嚇到了嗎？哦…您沒有被嚇到啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_3_1">
