  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_4">
    <VALUE Lang="tw">交付羽毛</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_5">
    <VALUE Lang="tw">詢問Sacred Financial Group的社服活動內容</VALUE>
