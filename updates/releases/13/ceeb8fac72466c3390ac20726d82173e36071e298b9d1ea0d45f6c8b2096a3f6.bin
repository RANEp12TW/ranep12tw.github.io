  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_3_2">
    <VALUE Lang="tw">詢問有關在Root Hole的 Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_3_3">
    <VALUE Lang="tw">結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4">
    <VALUE Lang="tw">如果學生通過了全部的考試，就能充分地證明學生的能力。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4_1">
    <VALUE Lang="tw">聽取對話</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4_2">
    <VALUE Lang="tw">詢問有關在Root Hole的 Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4_3">
    <VALUE Lang="tw">結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5">
    <VALUE Lang="tw">我很好奇學生的能力到哪裡？真的很好奇。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_1">
    <VALUE Lang="tw">詢問郵件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_2">
    <VALUE Lang="tw">秀出獎勵品。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_3">
    <VALUE Lang="tw">詢問現況</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_4">
    <VALUE Lang="tw">秀出Pill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_5">
    <VALUE Lang="tw">詢問發生何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_6">
    <VALUE Lang="tw">接受確認結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_7">
    <VALUE Lang="tw">詢問有關在Root Hole的 Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_8">
    <VALUE Lang="tw">結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6">
    <VALUE Lang="tw">到這裡來的目的是？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_1">
    <VALUE Lang="tw">秀出信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_2">
    <VALUE Lang="tw">詢問信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_3">
    <VALUE Lang="tw">詢問有關在Root Hole的 Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_4">
    <VALUE Lang="tw">結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_10_0">
    <VALUE Lang="tw">來吧！要挑戰最後一道任務了嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_10_0_2">
    <VALUE Lang="tw">接受最後的測試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_10_0_3">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_11_0">
    <VALUE Lang="tw">這是最後一道任務了！我讓您感到緊張，對吧？</VALUE>
    <VALUE Lang="tw">這次的考試可以測出學生自己的力量。您有8分鐘的時間，請消滅位在Golf Field area 的15名Hunk Baldy。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_11_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_12_0">
    <VALUE Lang="tw">太厲害了！雖然還不是超級厲害，但已經能確定您擁有不錯的基本功。很不錯了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_12_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_13_0">
    <VALUE Lang="tw">我確定光就在我們的身邊。但不曉得它們何時可以展現了能量給我們瞧瞧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_13_0_2">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_14_0">
    <VALUE Lang="tw">連我的女兒都不相信我。在發生異變之前，她一句話也不說。她否認異變的發生，甚至抗拒去相信事實。</VALUE>
    <VALUE Lang="tw">現在的問題在於，可怕的事情正在發生……… 真的非常危險且不安全。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_14_0_2">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_15_0">
    <VALUE Lang="tw">...4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_16_0">
    <VALUE Lang="tw">學生們已經開始恐慌了。我想這只是前戲而已，我也可以感受得到這種份瘋狂的氣氛一直在持續惡化中。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_16_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_17_0">
    <VALUE Lang="tw">我得測驗學生的能力，如此他們才能知道自身的實力，並評估各種危險性，來避免各種傷害。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_17_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_18_0">
    <VALUE Lang="tw">....7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_19_0">
    <VALUE Lang="tw">Sacred Financial Group的創辦人崔教授給了您這封信。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_19_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_2_0">
    <VALUE Lang="tw">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_20_0">
    <VALUE Lang="tw">我的女兒也是Sacred Financial Group的學生。</VALUE>
    <VALUE Lang="tw">您有聽說過她嗎？</VALUE>
    <VALUE Lang="tw">她的等級只有1級，所以懂的不是很多。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_20_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_21_0">
    <VALUE Lang="tw">我們必須要殺掉邪惡的學長！他真的製造了很多麻煩。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_21_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_22_0">
    <VALUE Lang="tw">那個學長變成怪物了。現在他也許已經成為異世界的人了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_22_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_23_0">
    <VALUE Lang="tw">....8</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_24_0">
    <VALUE Lang="tw">我們似乎是永遠也無法瞭解異世界的語言。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_24_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_25_0">
    <VALUE Lang="tw">應該是有其他的念法。事實上，我好像把您搞得更糊塗了….. 抱歉啊！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_25_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_26_0">
    <VALUE Lang="tw">在Sacred Gate Campu的周圍，以及 "Green" Underground Foothole Command Center 的3樓裡面，都寫有著奇怪的文字。.</VALUE>
    <VALUE Lang="tw">噢！問題就在這裡了！只要是與 「Aima、Sarandu、Aida」這3個文字有關的東西，都可以在 Trading Hole裡找得到唷。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_26_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_27_0">
    <VALUE Lang="tw">您知道他們拿著Painkillers嗎？請您在15分鐘之內，拿到10 顆 Painkiller。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_27_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_28_0">
    <VALUE Lang="tw">....10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_29_0">
    <VALUE Lang="tw">第二道測驗已成功達成。</VALUE>
    <VALUE Lang="tw">您還想要拿到更多資訊嗎？</VALUE>
    <VALUE Lang="tw">自從1988年，LiuChengYou事件發生之後，博士教授馬上就猜到這事情會發生了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_29_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_3_0">
    <VALUE Lang="tw">您怎麼現在才來…..</VALUE>
    <VALUE Lang="tw">謝謝您。您是為了給我信才來到這裡的嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_3_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_30_0">
    <VALUE Lang="tw">你說的是這事件嗎？當時，過了幾年後，Sacred Financial Group 在成為巨大的機關時，就成功獲得了國際間的認證與肯定。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_30_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_31_0">
    <VALUE Lang="tw">我也是經由當時收到的資料，才知道現在的事情。事實上，我認為所謂的「預言」，其實都是屁話，不可信的虛假謊言。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_31_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_32_0">
    <VALUE Lang="tw">但是，那些資料不僅確實說明了當時的異變現象，同時也顯示了之後所發生的種種事跡。甚至連學生在這地方進行的活動也……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_32_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_33_0">
    <VALUE Lang="tw">雖然預言這種東西會帶來更大的混亂，不過，我想這可以讓我們時時處於警戒心態。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_33_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_34_0">
    <VALUE Lang="tw">....13</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_35_0">
    <VALUE Lang="tw">別忘了，現在日益嚴重的異象與戰爭，都是跟「光」有關係的。學生們一定要表現得像是英雄，才能拯救我們的未來。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_35_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_36_0">
    <VALUE Lang="tw">總有某天，我一定會恢復我的記憶，那些在和平時代，我們享受美好生活的那段回憶。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_36_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_37_0">
    <VALUE Lang="tw">您一定要記住，我們是一定要結合的！目標是為了與週遭混亂世界的戰鬥！</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_37_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_38_0">
    <VALUE Lang="tw">請注意現在是覺醒的時段。</VALUE>
    <VALUE Lang="tw">我們必須接受大量的訓練，才能證明我們是有足夠能力可前往下一關的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_38_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_39_0">
    <VALUE Lang="tw">......14</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_4_0">
    <VALUE Lang="tw">來~我建議您先休息一下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_4_0_2">
    <VALUE Lang="tw">接受請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_4_0_3">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_40_0">
    <VALUE Lang="tw">請問您在Leonair Campus裡面有看過「光」出現的模樣嗎?我想這地區不會再出現任何光明了。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_40_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_41_0">
    <VALUE Lang="tw">請問您在Leonair Campus裡面有看過「光」出現的模樣嗎?我想這地區不會再出現任何光明了。Leonair Campus 的位置也是突然間移到別處……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_41_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_42_0">
    <VALUE Lang="tw">我們必須要警戒所有週遭發生的大小事件。 必須要在這黑暗時期裡，保持警戒。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_42_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_43_0">
    <VALUE Lang="tw">對我們來說，LiuChingYou事件是一個非常刻苦銘心的教訓。</VALUE>
    <VALUE Lang="tw">雖然，他尚未有任何絲毫的悔意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_43_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_44_0">
    <VALUE Lang="tw">我們現在的模樣，將掌握我們往後未來的結果。一定要記住這點。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_44_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_45_0">
    <VALUE Lang="tw">請狠狠地訓練自己，直到你獲得足夠的力量和資格。這是為了您的未來著想。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_45_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_46_0">
    <VALUE Lang="tw">如果時間到的話，我會告訴您關於通往異世界的門在哪兒。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_46_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_47_0">
    <VALUE Lang="tw">一旦你進入下一個階段，您可能會看到一個長得像你一樣的人。您可能還會遇到更強大的怪物！</VALUE>
    <VALUE Lang="tw">請牢牢記住。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_47_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_48_0">
    <VALUE Lang="tw">他上次是跑到哪兒去了？</VALUE>
    <VALUE Lang="tw">我得問清楚，搞明白。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_48_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_49_0">
    <VALUE Lang="tw">這樣已經很標準了。好啦！您已經達成了，請把這個交給他，他會幫您忙的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_49_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_5_0">
    <VALUE Lang="tw">首先，我想確認您的地理能力到哪個程度。您有遇過Cordy、Freezing Halogen、WereWolve、和Shadow Crow嗎？</VALUE>
    <VALUE Lang="tw">給您20分鐘，請找出牠們的位置，並收集牠們的唾液和羽毛。</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_5_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_6_0">
    <VALUE Lang="tw">哇！您都帶來了嗎？辛苦了！看來您很勤勞地在累積實力唷！您通過了我的第一個測驗，恭喜您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_6_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_7_0">
    <VALUE Lang="tw">很好！這就是全部了。現在，要來進行第二場考試了嗎？</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_7_0_2">
    <VALUE Lang="tw">接受第二道測試</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_7_0_3">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_8_0">
    <VALUE Lang="tw">我要開始念了！</VALUE>
    <VALUE Lang="tw">Antony、Frankno、Salandu、Dalama、Aida、Panarol、Kalasanoya、Huianolu、Aima、Kanaauni！這些是什麼，您知道嗎？</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_8_0_2">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_9_0">
    <VALUE Lang="tw">尋找Pills對您來說不難吧？</VALUE>
    <VALUE Lang="tw">非常謝謝您。您已經通過第2道關卡了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_9_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_0">
    <VALUE Lang="tw">你好嗎？看起來似乎很累。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_0_2">
    <VALUE Lang="tw">詢問問題內容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_0_3">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_1">
    <VALUE Lang="tw">歡迎光臨！</VALUE>
    <VALUE Lang="tw">您想要買點Hot Dog嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_1_1">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_1_2">
    <VALUE Lang="tw">詢問走失的孩子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2">
    <VALUE Lang="tw">你好嗎？看起來似乎很累。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2_1">
    <VALUE Lang="tw">詢問問題內容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2_4">
    <VALUE Lang="tw">交付食物的材料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2_8">
    <VALUE Lang="tw">詢問走失的孩子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_2_0">
    <VALUE Lang="tw">是 今天早上材料突然都被偷走了</VALUE>
    <VALUE Lang="tw">清晨去買回來的好材料說</VALUE>
