  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_10_0">
    <VALUE Lang="tw">真是多謝,</VALUE>
    <VALUE Lang="tw">我被搶的書是MinFuLeiSi Special 出版社出的，書名是"Programming RPGs for DirectX."。</VALUE>
    <VALUE Lang="tw">剛剛被名叫Clown ICE的人搶走了。請您幫我找回來好嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_10_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0">
    <VALUE Lang="tw">現在看到我應該只有想到書吧,</VALUE>
    <VALUE Lang="tw">總之要有書,才可度過這類難關,</VALUE>
    <VALUE Lang="tw">再說也有拜託您的人</VALUE>
    <VALUE Lang="tw">可以再幫我一次嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0_1">
    <VALUE Lang="tw">接受請求</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0_2">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_12_0">
    <VALUE Lang="tw">現在看到我應該只有想到書吧,</VALUE>
    <VALUE Lang="tw">總之要有書,才可度過這類難關,</VALUE>
    <VALUE Lang="tw">再說也有拜託您的人</VALUE>
    <VALUE Lang="tw">可以再幫我一次嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_12_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_13_0">
    <VALUE Lang="tw">真的找回來哩.</VALUE>
    <VALUE Lang="tw">拜託歸拜託,不過沒想到找回來了,</VALUE>
    <VALUE Lang="tw">真是感謝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_13_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_14_0">
    <VALUE Lang="tw">果然找回來了,</VALUE>
    <VALUE Lang="tw">上次已經幫過我,這次是不是更辛苦,我一直在想</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_14_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_15_0">
    <VALUE Lang="tw">......2</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_16_0">
    <VALUE Lang="tw">你問什麼?</VALUE>
    <VALUE Lang="tw">程式?遊戲程式?</VALUE>
    <VALUE Lang="tw">我做人們看見的與聽見的</VALUE>
    <VALUE Lang="tw">所以也做某程度的調查跟準備</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_16_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_17_0">
    <VALUE Lang="tw">做什麼都可以販賣,請看這裡,</VALUE>
    <VALUE Lang="tw">大部分市民都處於無法做事的狀態嘛.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_17_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
