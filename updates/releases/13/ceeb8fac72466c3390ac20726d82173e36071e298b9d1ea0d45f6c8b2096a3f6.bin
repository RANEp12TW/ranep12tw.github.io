  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0">
    <VALUE Lang="tw">您願意加入我嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_1">
    <VALUE Lang="tw">告知是Suah派您來的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_10">
    <VALUE Lang="tw">交出信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_11">
    <VALUE Lang="tw">殲滅野蠻怪異物種</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_12">
    <VALUE Lang="tw">殲滅野蠻怪異物種</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_13">
    <VALUE Lang="tw">殲滅野蠻怪異物種</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_14">
    <VALUE Lang="tw">殲滅野蠻怪異物種</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_15">
    <VALUE Lang="tw">殲滅野蠻怪異物種</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_16">
    <VALUE Lang="tw">殲滅野蠻怪異物種</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_17">
    <VALUE Lang="tw">回報結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_18">
    <VALUE Lang="tw">回報結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_19">
    <VALUE Lang="tw">回報結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_2">
    <VALUE Lang="tw">詢問為何一直呆在這兒</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_20">
    <VALUE Lang="tw">回報結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_21">
    <VALUE Lang="tw">回報結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_22">
    <VALUE Lang="tw">回報結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_23">
    <VALUE Lang="tw">告訴他，您想知道更多關於他的事情。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_24">
    <VALUE Lang="tw">毫無音訊的少女</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_25">
    <VALUE Lang="tw">傳遞信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_26">
    <VALUE Lang="tw">消滅 Wild species</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_27">
    <VALUE Lang="tw">告訴結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_3">
    <VALUE Lang="tw">詢問是否需要任何協助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_4">
    <VALUE Lang="tw">回報結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_5">
    <VALUE Lang="tw">詢問是否需要任何協助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_6">
    <VALUE Lang="tw">轉達您聽到的消息</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_7">
    <VALUE Lang="tw">詢問是否他希望為自己做點什麼？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_8">
    <VALUE Lang="tw">傳達急救藥品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_9">
    <VALUE Lang="tw">聆聽他的故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_10_0">
    <VALUE Lang="tw">噢，您已經知道有不少人在追捕我們了，是吧？不過，這不代表我們做了不光彩的事情，而僅是各自的眼光與想法不同罷了。我相信事出必有因，善惡的判定是見仁見智。話說回來，一直被追捕的感覺，還真不舒服呢！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_10_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_11_0">
    <VALUE Lang="tw">這件任務並不難，告訴Suah不要再擔心追捕者的事情。另外，我需要更多的急救藥品。因為Obi nine的狀況越來越不樂觀。還有，隊長沒有受傷，請Suah不要再哭了。哈哈哈…我可以想像得到Suah緊張如熱鍋上的螞蟻似的表情了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_11_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_12_0">
    <VALUE Lang="tw">真是太令人心安了。非常感激您的幫忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_12_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_13_0">
    <VALUE Lang="tw">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_14_0">
    <VALUE Lang="tw">這封信是要給Suah的。Suah很害羞，所以不要解釋太多，只要安靜地，把這封信交給她就可以。還有，您不可以打開偷看唷。知道嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_14_0_1">
    <VALUE Lang="tw">告訴他，您會幫忙轉達的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_14_0_2">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_15_0">
    <VALUE Lang="tw">這對情侶也太甜蜜了…..哈哈哈。收到了。我會交給隊長的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_15_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_16_0">
    <VALUE Lang="tw">這對情侶也太甜蜜了…..哈哈哈。收到了。我會交給隊長的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_16_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_17_0">
    <VALUE Lang="tw">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_18_0">
    <VALUE Lang="tw">我知道您已經幫助過我一次了。但這邊野蠻怪物的量實在是太龐大了。如果您能再繼續殲滅一定的數量，我會很感激您的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_18_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_19_0">
    <VALUE Lang="tw">謝謝您。雖然不是很足夠，但至少可以應付一下了。對了，我在附近走動時，發現了這東西，也許對您會有幫助。看看吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_19_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_2_0">
    <VALUE Lang="tw">謝天謝地，您平安無事地回來了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_2_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_20_0">
    <VALUE Lang="tw">那些怪物手中提著金屬筒，用它來點火攻擊人們。我能單獨對付他們，但還是希望透過善心人似的幫助，達到雙贏的境界。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_20_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_21_0">
    <VALUE Lang="tw">您每次都讓我競艷！這是我的一點小心意，請笑納。謝謝您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_21_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_22_0">
    <VALUE Lang="tw">它們一定是水手，因為我有在船上看到它們。有時他們在甲板上忙碌的工作。但每當我靠近時，他們總能快速地抓住我。請幫幫我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_22_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_23_0">
    <VALUE Lang="tw">他們一定很愛海… 是該跟他們做個了斷了。來！希望這可以帶來好運。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_24_0">
    <VALUE Lang="tw">他們是我們剛到這裡時所遇到的第一批人。這些人總是阻止我們察看Hangout。Hangout外面還有更多。請幫幫我們。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_24_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_25_0">
    <VALUE Lang="tw">托您的福，現在我已經完成這棟建築物的周圍調查工作了。非常感謝您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_25_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_26_0">
    <VALUE Lang="tw">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_27_0">
    <VALUE Lang="tw">嗯…您希望我說點自己的事情嗎？您是值得信賴的人，我想我可以告訴您些私人的事情。我其實是位外交官。噢，別用那種眼神看我。以貌取人是不好的唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_27_0_1">
    <VALUE Lang="tw">問問他家鄉的故事。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_28_0">
    <VALUE Lang="tw">我的星球分為兩個部分。一邊是暖和明亮的美麗世界；另一邊則是貧瘠寒冷的陰暗世界。美麗世界的人們沒嘗過苦頭，因而無法理解他們有多麼幸運</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_28_0_1">
    <VALUE Lang="tw">詢問他另一邊（陰暗世界）的情況如何</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_29_0">
    <VALUE Lang="tw">我們正是從陰暗世界來的。在那裡，人們需要互相依賴生存。在貧瘠的大地，人們得對抗邪惡又暴力的動物，否則無法生存下去。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_29_0_1">
    <VALUE Lang="tw">詢問他為何來到這裡？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_3_0">
    <VALUE Lang="tw">我們最初剛到這兒時，因其中一位隊友受傷，我和隊長於是決定先脫隊，3人一起留下來佔歇會兒。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_3_0_1">
    <VALUE Lang="tw">詢問其他人在何處？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_30_0">
    <VALUE Lang="tw">就算生在黑暗地帶，身為人類，我們還是渴望陽光的。這有點複雜，簡單的說就是，我們來這裡是為了尋找一個可以幫助我們得到陽光的元素。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_30_0_1">
    <VALUE Lang="tw">詢問找到之後，下一步計劃是？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_31_0">
    <VALUE Lang="tw">當然是回到我們的世界啊。同時也得結束這些漫長又煩悶的戰爭。之後我還打算和我心愛的女孩共組家庭呢。哈哈哈。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_31_0_1">
    <VALUE Lang="tw">詢問是否已經有心上人了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_32_0">
    <VALUE Lang="tw">當然由啊…是個愛藏秘密的小笨蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_32_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_33_0">
    <VALUE Lang="tw">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_34_0">
    <VALUE Lang="tw">我想知道Mr.No-Name過得好不好。他幫了我很大的忙。但我卻沒能親口向他道謝。請您幫我轉達給他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_34_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_35_0">
    <VALUE Lang="tw">噢！謝謝您！原來有這麼一回事啊。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_35_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_4_0">
    <VALUE Lang="tw">這是一個很安全的地方，且我們是重視誠信的人。希望您可以向我們證明，絕對不會輕易違背誓言，好讓我們能相信您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_4_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_5_0">
    <VALUE Lang="tw">每當我去找隊長和其他同伴時，總會被扛著魚和拿著兩根警棍的人騷擾與阻攔。希望您能撥空幫助我，好嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_5_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_6_0">
    <VALUE Lang="tw">太好了。我很滿足了。雖然過一段時間後，他們還是會再聚過來，不過這足夠讓我們撐一下了。謝謝您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_6_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_7_0">
    <VALUE Lang="tw">您是位實力派的好人。我想再拜託您一件事情。這件事對您而言，是輕而易舉的。好嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_7_0_1">
    <VALUE Lang="tw">告訴他您願意幫忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_8_0">
    <VALUE Lang="tw">順著Wharf的方向走，您會看到一位老人，他站在一個大樓的前方。我們第一次到達時，發現他是唯一沒有迷失自己的活人。請問問他，當初發生異變時的情況為何。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_8_0_1">
    <VALUE Lang="tw">回首頁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_9_0">
    <VALUE Lang="tw">嗯…這些追捕者已經嘗到苦果了啊….我終於可以放心了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_9_0_1">
    <VALUE Lang="tw">詢問關於追捕者的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_minigame.ntk_1_0">
    <VALUE Lang="tw">生命之輪永遠都是週而復始的！</VALUE>
    <VALUE Lang="tw">我會告訴你，但要適量才能避免失敗。</VALUE>
    <VALUE Lang="tw">希望您能正確地、開心地進行！</VALUE>
    <VALUE Lang="tw">我已經警告過您了唷！</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
    <VALUE Lang="tw">*賭注限制：1～10,000,000 Gold。</VALUE>
    <VALUE Lang="tw">*在連續得勝的情況下，賭注將自動增加。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_minigame.ntk_1_0_1">
    <VALUE Lang="tw">擲骰子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0">
    <VALUE Lang="tw">我蠻喜歡戰場的變化~不過您來這裡是？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0_1">
    <VALUE Lang="tw">詢問關於CDM Honor Award.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0_2">
    <VALUE Lang="tw">詢問關於Honor Award交易名單</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0_3">
    <VALUE Lang="tw">告訴他您想要兌換Honor Award。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0">
    <VALUE Lang="tw">選擇1個職業的物品來兌換(需20個Honor Awards)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_1">
    <VALUE Lang="tw">格鬥部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_2">
    <VALUE Lang="tw">劍道部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_3">
    <VALUE Lang="tw">弓箭部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_4">
    <VALUE Lang="tw">氣功部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_5">
    <VALUE Lang="tw">超能部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_6">
    <VALUE Lang="tw">忍術部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_7">
    <VALUE Lang="tw">兌換200 P幣點數卡</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_8">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
