    <VALUE Lang="tw">詢問卡帶的狀態</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_1_2">
    <VALUE Lang="tw">請把卡帶交給我，反正您拿著也沒啥用處。</VALUE>
  </SENTENSE>
