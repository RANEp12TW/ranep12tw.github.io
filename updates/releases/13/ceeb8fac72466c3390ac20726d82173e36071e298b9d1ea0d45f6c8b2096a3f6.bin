  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_2">
    <VALUE Lang="tw">還是...</VALUE>
    <VALUE Lang="tw">以那樣的程度, 是無法通過這扇門</VALUE>
    <VALUE Lang="tw">要怎麼做才能</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_2_1">
    <VALUE Lang="tw">變更開始地點</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_10_0">
    <VALUE Lang="tw">聖…聖…聖…徒…</VALUE>
    <VALUE Lang="tw">非常… 討厭… 墳墓裡的屍體…</VALUE>
    <VALUE Lang="tw">妨礙了安…安息處…安息…那些傢伙…</VALUE>
    <VALUE Lang="tw">不承認…秩序…危險</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_11_0">
    <VALUE Lang="tw">異…..異變？您在說什麼咚咚？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_11_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_2_0">
    <VALUE Lang="tw">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_2_0_1">
    <VALUE Lang="tw">已變更開始地點</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_3_0">
    <VALUE Lang="tw">這..這門</VALUE>
    <VALUE Lang="tw">時間不夠了, 是呀...</VALUE>
    <VALUE Lang="tw">想要通過門, 要有這認證書才行</VALUE>
    <VALUE Lang="tw">我可以制..製作</VALUE>
    <VALUE Lang="tw">因此, 才拜..拜託你</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_3_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_4_0">
    <VALUE Lang="tw">謝..謝謝</VALUE>
    <VALUE Lang="tw">現在…有點想起來了…</VALUE>
    <VALUE Lang="tw">我需要Shadow Crow的8個黑色羽毛（Black Feather）。</VALUE>
    <VALUE Lang="tw">請帶給我好嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_5_0">
    <VALUE Lang="tw">羽毛.. 8個</VALUE>
    <VALUE Lang="tw">好, 好..</VALUE>
    <VALUE Lang="tw">這裡…認證書… 和簿子一樣</VALUE>
    <VALUE Lang="tw">拿著這個的話, 現在起就可通過那扇了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_5_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_6_0">
    <VALUE Lang="tw">.....3</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_7_0">
    <VALUE Lang="tw">現在我的..腦袋好奇怪…想不太起來</VALUE>
    <VALUE Lang="tw">把書..書找給我</VALUE>
    <VALUE Lang="tw">薔薇, 從顏色褪掉的薔薇...</VALUE>
    <VALUE Lang="tw">把書找給我</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_7_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_8_0">
    <VALUE Lang="tw">.....5</VALUE>
    <VALUE Lang="tw">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_9_0">
    <VALUE Lang="tw">只要通.. 通過一次, 從下次開始, 就可自由進..進入</VALUE>
    <VALUE Lang="tw">來, 去看看</VALUE>
    <VALUE Lang="tw">但是… 我是誰呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_9_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0">
    <VALUE Lang="tw">哈哈哈！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_1">
    <VALUE Lang="tw">詢問怎麼回事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_10">
    <VALUE Lang="tw">詢問是否需要幫忙？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_2">
    <VALUE Lang="tw">接受請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_3">
    <VALUE Lang="tw">分享食物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_4">
    <VALUE Lang="tw">詢問他是否為Suna Jo的朋友</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_5">
    <VALUE Lang="tw">回復說是Suna Jo派你來的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_6">
    <VALUE Lang="tw">詢問發生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_7">
    <VALUE Lang="tw">轉達 Evilplate Monk 的問候</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_8">
    <VALUE Lang="tw">詢問是否需要幫忙？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_9">
    <VALUE Lang="tw">回報結果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_10_0">
    <VALUE Lang="tw">噢，是Suna派您來的啊。從您上次來訪後，我的記憶開始慢慢地恢復了。之前的確有好一陣子我的神智不是很清醒，也一直都很餓。雖然現在也沒好到哪裡去…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_10_0_1">
    <VALUE Lang="tw">告訴他您想知道發生了什麼事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_11_0">
    <VALUE Lang="tw">我只記得某人有在幫助我一路走來平安無事。她有著美麗又悲傷的雙眼，但跟她走在一起的那些人看起來就很可怕……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_11_0_1">
    <VALUE Lang="tw">詢問後來那些人怎麼樣了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_12_0">
    <VALUE Lang="tw">我們在Main Gate說再見之後， 他們就往Trading Hole的方向走了。然後，我跑去與Leonine學院的Student Director見面了。我真的很想知道那個孩子過的如何，如果您有時間的話，可以幫我問候一下她嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_12_0_1">
    <VALUE Lang="tw">告訴他您會找找的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_13_0">
    <VALUE Lang="tw">謝謝您，我真的很開心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_13_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_14_0">
    <VALUE Lang="tw">他應該很擔心我…….但我想先找點什麼東西…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_14_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_15_0">
    <VALUE Lang="tw">以前有個學生叫做Stoner，他曾跟我一起到了Leonine學院，但是，當我幌了一下神，回過頭來看，他竟然消失了！最近有個孩子跟我說，他經過Leonine學院的B3時，似乎有找到Stoner的相關線索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_15_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_16_0">
    <VALUE Lang="tw">噢…..Stoner.. 哇！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_16_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0">
    <VALUE Lang="tw">請將這封信交給他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0_2">
    <VALUE Lang="tw">請傳遞信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_2_0">
    <VALUE Lang="tw">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_2_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_3_0">
    <VALUE Lang="tw">好可怕……...之前不是這樣子的。自從那個孩子離奇死亡後，大家都變得跟原本不一樣了….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_3_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_4_0">
    <VALUE Lang="tw">我好餓，因為我躲在這裡太久了……..我也不敢到外頭去找食物…. 外頭太危險了。請問您有食物可以分給我嗎？真的拜託您了……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_4_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_5_0">
    <VALUE Lang="tw">食物？是吃的？！太謝謝您了！現在我可以在這多躲一會兒了！我會堅持下去的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_5_0_1">
    <VALUE Lang="tw">回主題</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_6_0">
    <VALUE Lang="tw">…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_7_0">
    <VALUE Lang="tw">Suna……..好像是Suna Jo…嗯，我想我應該知道她是誰。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_7_0_1">
    <VALUE Lang="tw">告訴他，您來這兒是為了完成尋找他的任務。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_8_0">
    <VALUE Lang="tw">Suna，他是我的朋友阿！我怎麼會忘記朋友的名字了呢？他一定很擔心我，您可以幫我跟他說一聲嗎？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_8_0_1">
    <VALUE Lang="tw">請他別擔心</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_9_0">
    <VALUE Lang="tw">請將這封信轉交給Suna，拜託您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_9_0_1">
    <VALUE Lang="tw">領取信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0">
    <VALUE Lang="tw">你.. 你是.. 人..</VALUE>
    <VALUE Lang="tw">自從.. 結界.. 解除以來..</VALUE>
    <VALUE Lang="tw">所有的人.. 都變了....</VALUE>
    <VALUE Lang="tw">我也..正慢慢的.. 改變..</VALUE>
    <VALUE Lang="tw">啊.. 雖然我有.. 一些藥品..</VALUE>
    <VALUE Lang="tw">但是因為.. 非常.. 稀有.....</VALUE>
    <VALUE Lang="tw">所以.. 只能賣你.. 貴一些了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_1">
    <VALUE Lang="tw">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_2">
    <VALUE Lang="tw">詢問她會不會害怕</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_3">
    <VALUE Lang="tw">告訴她事情的真相</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_4">
    <VALUE Lang="tw">詢問她會不會害怕</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_5">
    <VALUE Lang="tw">告訴她事情的真相</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_6">
    <VALUE Lang="tw">詢問異變當天的狀況</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_2_0">
    <VALUE Lang="tw">每…天晚上….那些男....人打給我…我不想見他們…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_2_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_3_0">
    <VALUE Lang="tw">他…們不…會再…過來了……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_3_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_4_0">
    <VALUE Lang="tw">老…師在…呼叫我…...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_4_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_5_0">
    <VALUE Lang="tw">他…們不…會再…過來了……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_5_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_6_0">
    <VALUE Lang="tw">我…..什麼都想不起來了……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_6_0_1">
    <VALUE Lang="tw">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_1_0">
    <VALUE Lang="tw">我肚子好餓……… 沒有學生在受飢餓之苦的…..我們為什麼會這樣呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_1_0_1">
    <VALUE Lang="tw">鑰匙的請求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_1_0_2">
    <VALUE Lang="tw">傳遞吃的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_2_0">
    <VALUE Lang="tw">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_3_0">
    <VALUE Lang="tw">是啊！我指的就是那個鑰匙。這是哪裡的鑰匙呢？Classroom？Information Center？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_3_0_1">
    <VALUE Lang="tw">下一頁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_4_0">
    <VALUE Lang="tw">吃的東西！！！！太好了！來！把鑰匙拿走吧！您是個好學生。下次的考試，我會給您高分的。呵呵呵………</VALUE>
