  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_5_0">
    <VALUE Lang="th">There are evil spirits roaming inside the Library. The mobs of monsters possessed by these spirits are causing strange effects to their surroundings. Please try your best to eliminate them.</VALUE>
