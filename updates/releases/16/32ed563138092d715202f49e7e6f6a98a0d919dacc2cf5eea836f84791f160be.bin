    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_33_0_4">
    <VALUE Lang="th">Exchange for Dynamic Sharp Sword</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_33_0_5">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_34_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_34_0_4">
    <VALUE Lang="th">Exchange for Dynamic Sharp Sword</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_34_0_5">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_35_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_35_0_4">
    <VALUE Lang="th">Exchange for Dynamic Sharp Sword</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_35_0_5">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_36_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_36_0_4">
    <VALUE Lang="th">Exchange for Dynamic Sharp Sword</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_36_0_5">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_37_0">
    <VALUE Lang="th">.......3-1</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_38_0">
    <VALUE Lang="th">Great strength allows you to fulfill two important objectives in battle.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can use your strength to attack your enemies or to protect your friends.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_38_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_39_0">
    <VALUE Lang="th">You know which use of your strength is best without telling me, right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Remember that hurting others can only be considered moral if you do it to protect someone.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_39_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_4_0">
    <VALUE Lang="th">Although you can learn and understand swordsmanship by swinging a sword on your own, please listen to me carefully, even if I'm repeating basics that you already know.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_40_0">
    <VALUE Lang="th">......4-1</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_41_0">
    <VALUE Lang="th">You are awarded 3 Stat Points each time your character levels up. Your character's build and growth is determined by how these Stat Points are allocated to your character's attributes.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_41_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_42_0">
    <VALUE Lang="th">If you evenly distribute points to Strength, Stamina, and Dexterity, then your character will grow into a Swordsman with very fast attacks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_42_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_43_0">
    <VALUE Lang="th">If you concentrate on the Strength stat, then your character will become a Swordsman that inflicts great damage to enemies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_43_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_44_0">
    <VALUE Lang="th">Lastly, distributing the points evenly to Strength, Dexterity, and Intelligence will result in a Skill Type character.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_44_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_45_0">
    <VALUE Lang="th">...5-1</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_46_0">
    <VALUE Lang="th">Take note that practitioners in the Sword Section consume a relatively large amount of SP.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_46_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_47_0">
    <VALUE Lang="th">Your Accuracy and attack rate will diminish once your SP is completely depleted. Try to avoid this dangerous scenario.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_47_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_48_0">
    <VALUE Lang="th">Therefore, cast your skills wisely, and don't needlessly overexert yourself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_48_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_49_0">
    <VALUE Lang="th">...6</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_5_0">
    <VALUE Lang="th">Stand at the front of your party. Protecting them is your primary job. This is how a Swordsman displays his power.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_5_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_50_0">
    <VALUE Lang="th">All kind of skills, when leveled up causes conflict with each Skill Points.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_50_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_51_0">
    <VALUE Lang="th">You should have more than enough Skill Points at the beginning since the starting skills won't require many Skill Points.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_51_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_52_0">
    <VALUE Lang="th">You'll find, however, that you might not have enough points to learn some of the later skills. Think and plan carefully, and choose the essential skills that you want to learn.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_52_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_53_0">
    <VALUE Lang="th">.....7</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_54_0">
    <VALUE Lang="th">그 양 옆에 ‘매점’ 하고 ‘락커룸’이 있으니까 가 봐</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그리고 학원생 등록에 대해서는 ‘매점’ 바로 옆에 ‘교무실’의 ‘학생주임’께 꼭 말씀드리고</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_54_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_55_0">
    <VALUE Lang="th">‘양호실’에 가면 상처치료도 해 주니까 미리 가서 인사나 드리도록 해</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_55_0_1">
    <VALUE Lang="th">?쩊홁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_56_0">
    <VALUE Lang="th">.......9</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_57_0">
    <VALUE Lang="th">This is just my observation, but all the teachers and students from the school came out fine.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please remember that the evil can't control everyone!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There aren't too many normal human beings around anymore. Most have already been transformed into evil monsters. Although it's a really bad situation, it's not like things can't be changed for the better.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The teachers are doing all that they can to return things back the way they should be. Please remember that.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_57_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_58_0">
    <VALUE Lang="th">.....10</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_59_0">
    <VALUE Lang="th">There is something that you must do before submitting your registration form.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Like I said before, these violent monsters are wrecking our campus. Please get out there, and keep them from causing even more destruction.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_59_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_6_0">
    <VALUE Lang="th">Initially, your character's Skill Points are set to 0. You earn 1 additional Skill Point every time your character levels up. You can use these points to learn new skills.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_60_0">
    <VALUE Lang="th">Know that carelessness may result in you ending up in a really bad situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_60_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_61_0">
    <VALUE Lang="th">Remember that you'll be entering a world full of dangers once you submit the Exit Approval Form. Please be careful out there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_61_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_62_0">
    <VALUE Lang="th">Oh... So you saw the List of Saints.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's true that there's nothing wrong with the list.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah, but you're probably curious about what's behind it. Am I right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why are there so many students with family problems?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's quite simple, actually.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not too many loving parents would send their children to an experimental school.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even if extraordinary benefits were offered, most parents would think that traditions set by normal schools are more important.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_62_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_63_0">
    <VALUE Lang="th">Many people raise this question...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What is forgiveness, and does it work?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, but it's not like I have the right to teach you anything.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why should I force what little I know upon you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You know that there are arenas in the Trading Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can find teachers that can teach you more over there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_63_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_64_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_64_0_4"><VALUE Lang="tw">兌換 風迴劍（177級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Aero Boomerang (Lv177, Class=130, Item=175/14)</VALUE><VALUE Lang="id">Skill book: Aero Boomerang (Lv177, Class=130, Item=175/14)</VALUE><VALUE Lang="cn">Skill book: Aero Boomerang (Lv177, Class=130, Item=175/14)</VALUE><VALUE Lang="th">Skill book: Aero Boomerang (Lv177, Class=130, Item=175/14)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_64_0_5"><VALUE Lang="tw">兌換 三重斬（177級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Triple Slash (Lv177, Class=130, Item=175/34)</VALUE><VALUE Lang="id">Skill book: Triple Slash (Lv177, Class=130, Item=175/34)</VALUE><VALUE Lang="cn">Skill book: Triple Slash (Lv177, Class=130, Item=175/34)</VALUE><VALUE Lang="th">Skill book: Triple Slash (Lv177, Class=130, Item=175/34)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_64_0_6"><VALUE Lang="tw">兌換 連環鐮刃（177級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Chain Sickles (Lv177, Class=130, Item=175/54)</VALUE><VALUE Lang="id">Skill book: Chain Sickles (Lv177, Class=130, Item=175/54)</VALUE><VALUE Lang="cn">Skill book: Chain Sickles (Lv177, Class=130, Item=175/54)</VALUE><VALUE Lang="th">Skill book: Chain Sickles (Lv177, Class=130, Item=175/54)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_64_0_7">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_65_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_65_0_4"><VALUE Lang="tw">兌換 鎖鏈束縛（197級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Chain Tie (Lv197, Class=130, Item=175/16)</VALUE><VALUE Lang="id">Skill book: Chain Tie (Lv197, Class=130, Item=175/16)</VALUE><VALUE Lang="cn">Skill book: Chain Tie (Lv197, Class=130, Item=175/16)</VALUE><VALUE Lang="th">Skill book: Chain Tie (Lv197, Class=130, Item=175/16)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_65_0_5"><VALUE Lang="tw">兌換 旋風斬（197級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Whirlwind Strike (Lv197, Class=130, Item=175/36)</VALUE><VALUE Lang="id">Skill book: Whirlwind Strike (Lv197, Class=130, Item=175/36)</VALUE><VALUE Lang="cn">Skill book: Whirlwind Strike (Lv197, Class=130, Item=175/36)</VALUE><VALUE Lang="th">Skill book: Whirlwind Strike (Lv197, Class=130, Item=175/36)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_65_0_6"><VALUE Lang="tw">兌換 赤紅雷電（197級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE><VALUE Lang="id">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE><VALUE Lang="cn">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE><VALUE Lang="th">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_65_0_7">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_66_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_66_0_4"><VALUE Lang="tw">兌換 無重突刺（207級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Weightless Stab (Lv207, Class=130, Item=175/17)</VALUE><VALUE Lang="id">Skill book: Weightless Stab (Lv207, Class=130, Item=175/17)</VALUE><VALUE Lang="cn">Skill book: Weightless Stab (Lv207, Class=130, Item=175/17)</VALUE><VALUE Lang="th">Skill book: Weightless Stab (Lv207, Class=130, Item=175/17)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_66_0_5"><VALUE Lang="tw">兌換 暮光斬（207級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Twilight (Lv207, Class=130, Item=175/37)</VALUE><VALUE Lang="id">Skill book: Twilight (Lv207, Class=130, Item=175/37)</VALUE><VALUE Lang="cn">Skill book: Twilight (Lv207, Class=130, Item=175/37)</VALUE><VALUE Lang="th">Skill book: Twilight (Lv207, Class=130, Item=175/37)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_66_0_6"><VALUE Lang="tw">兌換 閃光（207級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Glint (Lv207, Class=130, Item=175/57)</VALUE><VALUE Lang="id">Skill book: Glint (Lv207, Class=130, Item=175/57)</VALUE><VALUE Lang="cn">Skill book: Glint (Lv207, Class=130, Item=175/57)</VALUE><VALUE Lang="th">Skill book: Glint (Lv207, Class=130, Item=175/57)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_66_0_7">
    <VALUE Lang="th">Learn Titan's Arcanum</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_66_0_8">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_67_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_67_0_4"><VALUE Lang="tw">兌換 暴風劍（217級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Gust of Sword (Lv217, Class=130, Item=175/18)</VALUE><VALUE Lang="id">Skill book: Gust of Sword (Lv217, Class=130, Item=175/18)</VALUE><VALUE Lang="cn">Skill book: Gust of Sword (Lv217, Class=130, Item=175/18)</VALUE><VALUE Lang="th">Skill book: Gust of Sword (Lv217, Class=130, Item=175/18)</VALUE></SENTENSE>
