<?xml version="1.0" encoding="utf-8"?>
<TEXT>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0">
    <VALUE Lang="th">Pierrot who has been preparing the event for the students of RAN has turned into a Joker due to the stress from the constant night shift and overwork!</VALUE>
    <VALUE Lang="th">Letting this Joker go free will bring the ill spirit to schools and to entire Ran. Please bring back the gifts which the Joker had prepared for the students at the first place.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_1">
    <VALUE Lang="th">Where can I find this Joker?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_2">
    <VALUE Lang="th">Where can I get the Admission Ticket to dungeon?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_3">
    <VALUE Lang="th">Where can I get the gift?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0">
    <VALUE Lang="th">Joker is hiding alone in the hidden dungeon. That place is filled with various traps so it won't be easy to meet him. One more thing, you will need an Admission Ticket to enter the dungeon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0_2">
    <VALUE Lang="th">Where can I get the Admission Ticket?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0">
    <VALUE Lang="th">Monsters of Ran has been affected by the Joker's ill spirit and they are dropping the Matryoshka Boxes!</VALUE>
    <VALUE Lang="th">No one knows the structure of that box but you will be able to find the Admission Ticket hid by Joker so go open them as many as you can.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0_2">
    <VALUE Lang="th">Where can I get the gift?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0">
    <VALUE Lang="th">There should be a person inside the dungeon who has been chasing the joker. You will be able to receive the gift from that person AKA Joker Hunter. I can also help you exchange the item but I recommend you to meet Joker Hunter inside the dungeone because more material is needed when I create the present. Are you sure to exchange it to me?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0_2">
    <VALUE Lang="th">Please exchange it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0">
    <VALUE Lang="th">This is what you need to get the present here.</VALUE>
    <VALUE Lang="th">--</VALUE>
    <VALUE Lang="th">Pierrot Badge 100ea + Joker Badge 80ea</VALUE>
    <VALUE Lang="th">= Jester King's Hat</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Pierrot Badge 150ea + Joker Badge 100ea +</VALUE>
    <VALUE Lang="th">Joker Card 100ea</VALUE>
    <VALUE Lang="th">= Joker Look Box (7D)</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Pierrot Badge 200ea + Joker Badge 150ea +</VALUE>
    <VALUE Lang="th">Joker Card 150ea</VALUE>
    <VALUE Lang="th">= Joker Bike (7D)</VALUE>
    <VALUE Lang="th">--</VALUE>
    <VALUE Lang="th">Hmm...You'll need less items if you go exchange it to Joker Hunter..but well, if you need then I'll help you. What present do you need?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_1">
    <VALUE Lang="th">I want the Jester King's Hat!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_2">
    <VALUE Lang="th">I want the Joker Look Box!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_3">
    <VALUE Lang="th">I want the Joker Bike!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_event_club.ntk_1_0">
    <VALUE Lang="th">I'm Super Robot who sells necessary item for CW.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_event_club.ntk_1_0_1">
    <VALUE Lang="th">Exchange candies.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_0">
    <VALUE Lang="th">Woof! Woof! Bark! Bark! Woof! Woof! Bark! Bark!</VALUE>
    <VALUE Lang="th">Woof! Woof! Bark! Bark! Woof! Woof! Bark! Bark!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_1">
    <VALUE Lang="th">Woof! Woof! Bark! Bark!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_1_1">
    <VALUE Lang="th">It seems we need to make him sleep to pass.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_1_2">
    <VALUE Lang="th">Feed sleeping pill.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_2_0">
    <VALUE Lang="th">Zzz...Zzz...Zzz....Zzz</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th02.ntk_1_0">
    <VALUE Lang="th">Hahahaha. Welcome. I have some magical items~~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th02.ntk_1_0_1">
    <VALUE Lang="th">Item Sale</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th03.ntk_1_0">
    <VALUE Lang="th">Ran World celebrates the 4th anniversary. Please congratulate us.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th03.ntk_1_0_1">
    <VALUE Lang="th">Receive 4h Anniversary Gift Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_0">
    <VALUE Lang="th">Don’t you want to meet a Prince Charming from fairy tales?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_1">
    <VALUE Lang="th">Did you ever ride it before? It is really exciting!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_2">
    <VALUE Lang="th">They love pretty girls~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_3">
    <VALUE Lang="th">Peekaboo~! Did you get startled? Hmm… you didn’t get startled.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_3_1">
    <VALUE Lang="th">Trick or treat!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_2_0">
    <VALUE Lang="th">I’ll give you a candy tomorrow too so please come~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_2_0_1">
    <VALUE Lang="th">Ask whether there is something else rather than candy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_0">
    <VALUE Lang="th">It might be real hero of Halloween day.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_1">
    <VALUE Lang="th">It is vulnerable to fire.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_2">
    <VALUE Lang="th">Their beds are very dark so no one can notice sunrise.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_3">
    <VALUE Lang="th">Peekaboo~! Surprise?! Umm.. you are not surprised?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_3_1">
    <VALUE Lang="th">Trick or treat!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_2_0">
    <VALUE Lang="th">I’ll give you a candy tomorrow too so please come~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_2_0_1">
    <VALUE Lang="th">Ask whether there is something else rather than candy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_0">
    <VALUE Lang="th">I can’t understand why that ugly one is so popular.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_1">
    <VALUE Lang="th">He is really busy when guest visits his house.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_2">
    <VALUE Lang="th">They always compete with mosquito.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_3">
    <VALUE Lang="th">Peekaboo~! Did you get startled? Hmm… you didn’t get startled.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_3_1">
    <VALUE Lang="th">Trick or treat!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_2_0">
    <VALUE Lang="th">I’ll give you a candy tomorrow too so please come~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_2_0_1">
    <VALUE Lang="th">Ask whether there is something else rather than candy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_0">
    <VALUE Lang="th">Do you know what π means? According to what I heard, 3.14..something…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_1">
    <VALUE Lang="th">It hurts my heart when I see he gets losing his hair.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_2">
    <VALUE Lang="th">They grew up in Romania.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_3">
    <VALUE Lang="th">Peekaboo~! Surprise?! Umm.. you are not surprised?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_3_1">
    <VALUE Lang="th">Trick or treat!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_2_0">
    <VALUE Lang="th">I’ll give you a candy tomorrow too so please come~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_2_0_1">
    <VALUE Lang="th">Ask whether there is something else rather than candy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_0">
    <VALUE Lang="th">My head is especially itches today.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_1">
    <VALUE Lang="th">He is really good at standing on his hands.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_2">
    <VALUE Lang="th">They can only be seen at night.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_3">
    <VALUE Lang="th">Peekaboo~! Did you get startled? Hmm… you didn’t get startled.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_3_1">
    <VALUE Lang="th">Trick or treat!</VALUE>
