  <SENTENSE Ver="1" Id="npc_2_jaryosil1.ntk_6_0">
    <VALUE Lang="th">After you finish reading and activating the Refresh skill book, use the [K] button to open the Skill Window. Click and hold down the left mouse button to select Refresh in the Support option panel (located on the right). While holding down the button, drag the skill and drop it into the desired Shortcut Key holder in the Shortcut Key panel.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You are finally ready to use the Refresh skill with the shortcut key you've assigned.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_jaryosil1.ntk_6_0_1">
