  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_1_0_3">
    <VALUE Lang="th">Confirm</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_1_0_4">
    <VALUE Lang="th">Confirmation of Shirt</VALUE>
  </SENTENSE>
