    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_main_1.ntk_1_0_12">
    <VALUE Lang="th">도움말을 본다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_main_1.ntk_1_0_13">
