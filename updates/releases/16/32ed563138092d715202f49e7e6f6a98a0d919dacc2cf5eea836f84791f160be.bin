  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0">
    <VALUE Lang="th">The Information Room Terminal is unable to function properly due to an error in the school's Main Terminal.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please resolve this problem.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0_1">
    <VALUE Lang="th">Confirm Activation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0_2">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0_3">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0_4">
    <VALUE Lang="th">Search Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_2_0">
    <VALUE Lang="th">Due to the errors in the School's Information Center System, the Information Room can only process the data contained in this 1 File.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We will restore all necessary information as soon as possible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please feel free to read through the document.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_2_0_1">
    <VALUE Lang="th">Ask about Shockwave Skill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_3_0">
    <VALUE Lang="th">After you finish reading and activating the Shockwave skill book, use the [K] button to open the Skill Window. Click and hold down the left mouse button to select Shockwave in the Qi option panel (located on the right). While holding down the button, drag the skill and drop it into the desired Shortcut Key holder in the Shortcut Key panel.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You are finally ready to use the Shockwave skill with the shortcut key you've assigned.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_3_0_1">
    <VALUE Lang="th">The Effect of the Shockwave Skill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_4_0">
    <VALUE Lang="th">Due to the errors in the School's Information Center System, the Information Room can only process the data contained in this 1 File.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We will restore all necessary information as soon as possible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please feel free to stay and read through the document.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_4_0_1">
    <VALUE Lang="th">Ask about Refresh Skill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_5_0">
    <VALUE Lang="th">Now there isn't any means of keeping this Terminal functioning properly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_6_0">
    <VALUE Lang="th">After you finish reading and activating the Refresh skill book, use the [K] button to open the Skill Window. Click and hold down the left mouse button to select Refresh in the Support option panel (located on the right). While holding down the button, drag the skill and drop it into the desired Shortcut Key holder in the Shortcut Key panel.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You are finally ready to use the Refresh skill with the shortcut key you've assigned.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_6_0_1">
    <VALUE Lang="th">The Effect of the Refresh Skill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_7_0">
    <VALUE Lang="th">The Shockwave skill uses the art of manipulating Qi Energy to attack nearby enemies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The usage and training for this skill is the same as other skills for your character.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_8_0">
    <VALUE Lang="th">The Refresh skill is used to hasten health recovery against damage. This skill can only be used on your own character.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The usage and training for this skill is the same as other skills for your character.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_9_0">
    <VALUE Lang="th">Search Information Finished</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
