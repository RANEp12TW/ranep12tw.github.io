  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_66_0_11"><VALUE Lang="tw">兌換 赤紅雷電（197級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE><VALUE Lang="id">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE><VALUE Lang="cn">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE><VALUE Lang="th">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE></SENTENSE>
