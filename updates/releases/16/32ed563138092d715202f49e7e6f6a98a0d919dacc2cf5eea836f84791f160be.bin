  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_59_0_4"><VALUE Lang="tw">兌換 翱翔之箭（217級／弓箭部）</VALUE><VALUE Lang="GS">Skill book: Soaring Stake (Lv217, Class=260, Item=173/18)</VALUE><VALUE Lang="id">Skill book: Soaring Stake (Lv217, Class=260, Item=173/18)</VALUE><VALUE Lang="cn">Skill book: Soaring Stake (Lv217, Class=260, Item=173/18)</VALUE><VALUE Lang="th">Skill book: Soaring Stake (Lv217, Class=260, Item=173/18)</VALUE></SENTENSE>
