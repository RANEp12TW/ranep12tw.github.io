    <VALUE Lang="th">[23/23] Eliminate Boss - Dark Swordsman Jr.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_3">
    <VALUE Lang="th">Eliminate Boss - Notorious Junkie</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_4">
    <VALUE Lang="th">Eliminate Boss - Master Fencer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_5">
    <VALUE Lang="th">Eliminate Boss - Brute Mauler</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_6">
    <VALUE Lang="th">Eliminate Boss - Bruiser</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_7">
    <VALUE Lang="th">Eliminate Boss - Furious Chef</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0_8">
    <VALUE Lang="th">Eliminate Boss - Welding Master</VALUE>
  </SENTENSE>
