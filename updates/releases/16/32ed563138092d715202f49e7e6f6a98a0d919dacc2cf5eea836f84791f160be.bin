    <VALUE Lang="th">Search Information Finished</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_jaryosil1.ntk_2_0">
    <VALUE Lang="th">Due to the errors in the School's Information Center System, the Information Room can only process the data contained in this 1 File.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We will restore all necessary information as soon as possible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please feel free to read through the document.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_jaryosil1.ntk_2_0_1">
    <VALUE Lang="th">Ask about Shockwave Skill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_jaryosil1.ntk_3_0">
    <VALUE Lang="th">After you finish reading and activating the Shockwave skill book, use the [K] button to open the Skill Window. Click and hold down the left mouse button to select Shockwave in the Qi option panel (located on the right). While holding down the button, drag the skill and drop it into the desired Shortcut Key holder in the Shortcut Key panel.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You are finally ready to use the Shockwave skill with the shortcut key you've assigned.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_jaryosil1.ntk_3_0_1">
    <VALUE Lang="th">The Effect of the Shockwave Skill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_jaryosil1.ntk_4_0">
    <VALUE Lang="th">Due to the errors in the School's Information Center System, the Information Room can only process the data contained in this 1 File.</VALUE>
