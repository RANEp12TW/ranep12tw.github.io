    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_jaryosil1.ntk_4_0_1">
    <VALUE Lang="th">Ask about Refresh Skill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_jaryosil1.ntk_5_0">
    <VALUE Lang="th">Now there isn't any means of keeping this Terminal functioning properly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
