  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_6_0">
    <VALUE Lang="th">Your character will gain 1 additional Skill Point each time you level up.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_60_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
