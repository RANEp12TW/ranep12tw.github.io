  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_27_0_6"><VALUE Lang="tw">兌換 碎骨擊（167級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Bone Smasher (Lv167, Class=130, Item=175/33)</VALUE><VALUE Lang="id">Skill book: Bone Smasher (Lv167, Class=130, Item=175/33)</VALUE><VALUE Lang="cn">Skill book: Bone Smasher (Lv167, Class=130, Item=175/33)</VALUE><VALUE Lang="th">Skill book: Bone Smasher (Lv167, Class=130, Item=175/33)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_27_0_7"><VALUE Lang="tw">兌換 大漩渦（167級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Maelstrom (Lv167, Class=130, Item=175/53)</VALUE><VALUE Lang="id">Skill book: Maelstrom (Lv167, Class=130, Item=175/53)</VALUE><VALUE Lang="cn">Skill book: Maelstrom (Lv167, Class=130, Item=175/53)</VALUE><VALUE Lang="th">Skill book: Maelstrom (Lv167, Class=130, Item=175/53)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_27_0_9"><VALUE Lang="tw">兌換 土沃之眼（175級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Toal's Eyes (Lv175, Class=130, Item=175/70)</VALUE><VALUE Lang="id">Skill book: Toal's Eyes (Lv175, Class=130, Item=175/70)</VALUE><VALUE Lang="cn">Skill book: Toal's Eyes (Lv175, Class=130, Item=175/70)</VALUE><VALUE Lang="th">Skill book: Toal's Eyes (Lv175, Class=130, Item=175/70)</VALUE></SENTENSE>
