  <SENTENSE Ver="1" Id="npc_2_t_sc.ntk_29_0_2"><VALUE Lang="tw">兌換 電場（127級／超能部）</VALUE><VALUE Lang="GS">Skill book: Electric Field (Lv127, Class=3072, Item=389/102)</VALUE><VALUE Lang="id">Skill book: Electric Field (Lv127, Class=3072, Item=389/102)</VALUE><VALUE Lang="cn">Skill book: Electric Field (Lv127, Class=3072, Item=389/102)</VALUE><VALUE Lang="th">Skill book: Electric Field (Lv127, Class=3072, Item=389/102)</VALUE></SENTENSE>
