  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_33_0_3"><VALUE Lang="tw">兌換 致命冰凍（67級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="id">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="cn">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="th">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_33_0_4">
    <VALUE Lang="th">물품으로 교환한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_33_0_5">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_34_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_34_0_1"><VALUE Lang="tw">兌換 翔鶴擊（117級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="id">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="cn">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="th">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_34_0_2"><VALUE Lang="tw">兌換 致命突刺（157級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE><VALUE Lang="id">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE><VALUE Lang="cn">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE><VALUE Lang="th">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_34_0_3"><VALUE Lang="tw">兌換 致命冰凍（67級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="id">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="cn">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="th">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_34_0_4">
    <VALUE Lang="th">물품으로 교환한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_34_0_5">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_35_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_35_0_1"><VALUE Lang="tw">兌換 翔鶴擊（117級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="id">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="cn">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="th">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_35_0_2"><VALUE Lang="tw">兌換 致命突刺（157級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE><VALUE Lang="id">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE><VALUE Lang="cn">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE><VALUE Lang="th">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_35_0_3"><VALUE Lang="tw">兌換 致命冰凍（67級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="id">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="cn">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="th">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_35_0_4">
    <VALUE Lang="th">물품으로 교환한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_35_0_5">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_36_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_36_0_1"><VALUE Lang="tw">兌換 翔鶴擊（117級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="id">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="cn">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="th">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_36_0_2"><VALUE Lang="tw">兌換 致命突刺（157級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE><VALUE Lang="id">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE><VALUE Lang="cn">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE><VALUE Lang="th">Skill book: Fatal Thrust (Lv157, Class=520, Item=176/13)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_36_0_3"><VALUE Lang="tw">兌換 致命冰凍（67級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="id">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="cn">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="th">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_36_0_4">
    <VALUE Lang="th">물품으로 교환한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_36_0_5">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_37_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_38_0">
    <VALUE Lang="th">Destiny has chosen students to join the Shaman Section.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_38_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_39_0">
    <VALUE Lang="th">The power of your skills lies in your understanding of the Universe's Spirit.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Remember that your goals are not geared toward destruction.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_39_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_4_0">
    <VALUE Lang="th">Focusing Stat points to Intelligence will develop a character that will be good at Support.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_4_0_1">
    <VALUE Lang="th">Ask about the Enemy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_4_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_40_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_41_0">
    <VALUE Lang="th">‘회복’ 기술문서를 구입해 익힌 다음, 'K'키로 스킬창을 열고 가장 오른편의 '보조' 항목에서 '회복'을 선택한 뒤 열리는 왼쪽 윗편의 슬롯에 위치시킨 순간부터 오른쪽 클릭으로 '회복' 기술을 쓸 수 있을거야.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_41_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_42_0">
    <VALUE Lang="th">유용하게 쓰도록 해.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_42_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_43_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_44_0">
    <VALUE Lang="th">It is essential for you to learn how to meditate in peace. This is how you can strengthen your power and eventually tap into your full potential.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_44_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_45_0">
    <VALUE Lang="th">Given the current situation, however, there isn't time to think about that now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_45_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_46_0">
    <VALUE Lang="th">You will need skills that can inflict direct damage to your enemies when you must face them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_46_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_47_0">
    <VALUE Lang="th">You are awarded 3 Stat Points each time your character levels up. Your character's build and growth is determined by how these Stat Points are allocated to your character's attributes.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_47_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_48_0">
    <VALUE Lang="th">Primarily investing Stat Points in Strength, followed by Dexterity, will develop a Spear Type character that will have strong close-ranged abilities.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_48_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_49_0">
    <VALUE Lang="th">You can also allocate Stat Points equally to Strength, Dexterity, and Intelligence to develop an Attack Type character.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_49_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_5_0">
    <VALUE Lang="th">Ah, don't worry, I'm not asking you to kill people.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Those enemies are just clones of mobs whose minds are unstable.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_5_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_50_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_51_0">
    <VALUE Lang="th">There are times when you must grant death to free those trapped spirits.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_51_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_52_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_53_0">
    <VALUE Lang="th">You should have more than enough Skill Points at the beginning since the starting skills won't require many Skill Points.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_53_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_54_0">
    <VALUE Lang="th">You'll find, however, that you might not have enough points to learn some of the later skills. Think and plan carefully, and choose the essential skills that you want to learn.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_54_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_55_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_56_0">
    <VALUE Lang="th">그 양 옆에 ‘매점’ 하고 ‘락커룸’이 있으니까 가 봐</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그리고 학원생 등록에 대해서는 ‘매점’ 바로 옆에 ‘교무실’의 ‘학생주임’께 꼭 말씀드리고</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_56_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_57_0">
    <VALUE Lang="th">‘양호실’에 가면 상처치료도 해 주니까 미리 가서 인사나 드리도록 해</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_57_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_58_0">
    <VALUE Lang="th">......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_59_0">
    <VALUE Lang="th">Please go take part in helping the investigation of the situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Remember that not all of you can be controlled by the evil!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_59_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_6_0">
    <VALUE Lang="th">Your specialty isn't direct fighting.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You must always stay behind your partners, and back them up. Support them so that they can use the full extent of their powers.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_60_0">
    <VALUE Lang="th">There aren't too many normal human beings around anymore. Most have already been transformed into evil monsters. Although it's a really bad situation, it's not like things can't be changed for the better.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please remember this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_60_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_61_0">
    <VALUE Lang="th">The teachers are doing all that they can to return things back the way they should be.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_61_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_62_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_63_0">
    <VALUE Lang="th">Now, there's something you need to do before you submit your registration form.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Like I said before, these violent monsters are wrecking our campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please get out there, and keep them from causing even more destruction.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_63_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_64_0">
    <VALUE Lang="th">Know that carelessness may result in you ending up in a really bad situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_64_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_65_0">
    <VALUE Lang="th">Remember that you'll be entering a world full of dangers once you submit the Exit Approval Form. Please be careful out there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_65_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_66_0">
    <VALUE Lang="th">Oh... So you saw the List of Saints.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's true that there's nothing wrong with the list.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah, but you're probably curious about what's behind it. Am I right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why are there so many students with family problems?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's quite simple, actually.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not too many loving parents would send their children to an experimental school.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even if extraordinary benefits were offered, most parents would think that traditions set by normal schools are more important.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_66_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_spirit1.ntk_67_0">
    <VALUE Lang="th">Many people raise this question...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What is forgiveness, and does it work?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, but it's not like I have the right to teach you anything.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why should I force what little I know upon you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You know that there are arenas in the Trading Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can find teachers that can teach you more over there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
