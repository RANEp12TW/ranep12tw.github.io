    <VALUE Lang="th">This is the 30th floor security Terminal.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Password is required to enter 30th floor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please enter the password.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_1_1_1">
    <VALUE Lang="th">Enter the password.</VALUE>
  </SENTENSE>
