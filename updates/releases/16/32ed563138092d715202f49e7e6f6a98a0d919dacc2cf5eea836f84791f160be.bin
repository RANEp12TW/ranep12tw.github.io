  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_47_0">
    <VALUE Lang="th">It better than previous.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_47_0_1">
