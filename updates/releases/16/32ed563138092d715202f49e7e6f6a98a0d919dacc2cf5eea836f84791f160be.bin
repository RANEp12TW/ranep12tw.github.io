  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_1_0">
    <VALUE Lang="th">Welcome to Club Death Match~!</VALUE>
    <VALUE Lang="th">I am dispatched CDM Execution Agent from Saint Foundation for CDM’s operation.</VALUE>
    <VALUE Lang="th">Check your items before enter battle map~!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_1_0_2">
    <VALUE Lang="th">Sales</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_1_0_3">
    <VALUE Lang="th">Multi Gate</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_1_0_4">
    <VALUE Lang="th">Safe Zone and Battle Zone</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_1_0_5">
    <VALUE Lang="th">Battle Rule</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_2_0">
    <VALUE Lang="th">Multi gate is newly developed gate moving method by Foundation.</VALUE>
    <VALUE Lang="th">Step up on the gate~! You can see more than one moving places.</VALUE>
    <VALUE Lang="th">Can you feel your battle will be changed according to your choice?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_3_0">
    <VALUE Lang="th">The place where you are standing is Safe zone.</VALUE>
    <VALUE Lang="th">You can’t attack other characters in this area.</VALUE>
    <VALUE Lang="th">See the gate behind you.</VALUE>
    <VALUE Lang="th">You can move to battle zone through the gate.</VALUE>
    <VALUE Lang="th">GO! Go for it!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_4_0">
    <VALUE Lang="th">Listen, I’ll give you brief guide about battle rule.</VALUE>
    <VALUE Lang="th">You can get points by killing opponent club member. On the contrary, you lose points when your club member is killed.</VALUE>
    <VALUE Lang="th">The club which gets the highest point at the end of battle will be a winner team.</VALUE>
    <VALUE Lang="th">How easy it is~!</VALUE>
    <VALUE Lang="th">Ah~ if you keep stay in safe zone for a certain time, you will be compulsorily moved to battle zone. Don’t forget it~!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper1.ntk_1_0">
    <VALUE Lang="th">I feel good after change battle ground~ What are you here for?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper1.ntk_1_0_1">
    <VALUE Lang="th">Ask about CDM Honor Award.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper1.ntk_1_0_2">
    <VALUE Lang="th">Ask about Honor Award Trade list.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper1.ntk_1_0_3">
    <VALUE Lang="th">Tell her that you want to exchange Honor Award.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_helper1.ntk_10_0">
    <VALUE Lang="th">Choose a class for item exchange. (20 Honor Awards)</VALUE>
  </SENTENSE>
