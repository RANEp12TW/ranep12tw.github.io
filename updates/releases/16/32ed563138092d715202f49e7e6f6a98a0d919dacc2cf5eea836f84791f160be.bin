    <VALUE Lang="th">Listen to the conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_shop1.ntk_1_0_3">
    <VALUE Lang="th">Accept Immediately</VALUE>
  </SENTENSE>
