  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_2_0">
    <VALUE Lang="th">Initially, your character's Skill Points is set to 0. You earn 1 additional skill point every time your character levels up. You can use these points to learn new skills.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_2_0_1">
    <VALUE Lang="th">Next page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_3_0">
    <VALUE Lang="th">Your character's Skill Points may not be enough to learn Grade 16 Skill.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_3_0_1">
    <VALUE Lang="th">Next page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_4_0">
    <VALUE Lang="th">I will offer quests for you to earn more Skill Points.</VALUE>
    <VALUE Lang="th">The reward of each quest you accomplish is 2 Skill Points.</VALUE>
    <VALUE Lang="th">Some of these quests might be a little difficult.</VALUE>
    <VALUE Lang="th">Good luck!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0">
    <VALUE Lang="th">Let us start the quest now!</VALUE>
  </SENTENSE>
