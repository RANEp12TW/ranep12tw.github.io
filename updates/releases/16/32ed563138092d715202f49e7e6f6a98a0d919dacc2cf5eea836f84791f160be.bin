  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_2_0">
    <VALUE Lang="th">There's a citizen that needs you to save her from some suspicious men.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can't help her, but I know you have the power to save her.</VALUE>
