    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_64_0_10"><VALUE Lang="tw">兌換 龍爪拳（207級／格鬥部）</VALUE><VALUE Lang="GS">Skill book: Dragon Claw (Lv207, Class=65, Item=174/17)</VALUE><VALUE Lang="id">Skill book: Dragon Claw (Lv207, Class=65, Item=174/17)</VALUE><VALUE Lang="cn">Skill book: Dragon Claw (Lv207, Class=65, Item=174/17)</VALUE><VALUE Lang="th">Skill book: Dragon Claw (Lv207, Class=65, Item=174/17)</VALUE></SENTENSE>
