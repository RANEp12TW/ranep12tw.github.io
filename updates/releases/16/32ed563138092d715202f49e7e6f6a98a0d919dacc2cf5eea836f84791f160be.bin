  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_3">
    <VALUE Lang="th">Really...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me here?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_3_3">
    <VALUE Lang="th">Confirm</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_3_4">
    <VALUE Lang="th">Ask what Happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_2_0">
    <VALUE Lang="th">I don't know why I'm here...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I just saw all these suspicious men when I woke up. It's also kind of hard to even stand in here...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_5_0">
    <VALUE Lang="th">Thank you so much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I was in such despair…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But now, I… I…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_0">
    <VALUE Lang="th">Have you collected 50 of my Gold Coins?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_0_1">
    <VALUE Lang="th">Sure thing! Here, 50 Gold Coins!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_1">
    <VALUE Lang="th">Have you collected 50 of my Gold Coins?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_1_1">
    <VALUE Lang="th">50? No... Not yet...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_2">
    <VALUE Lang="th">Bad thugs have taken my Gold Coins... Oh my goodness!... What should I do?.... (sobbing)....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_2_1">
    <VALUE Lang="th">What's wrong? Stop Crying! Do you want to talk to me about it?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_10_0">
    <VALUE Lang="th">Hey there. Would you like to collect these Gold Coins one more time for a Lucky Green Hat? If you are interested in getting an extra Hat then collect the Gold Coins again and bring it to me. Cuz, I still have got plenty of that Hat left... Ha Ha Ha</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_2_0">
    <VALUE Lang="th">(sobbing)... One day a mob of monsters came and took all of my Gold Coins.</VALUE>
    <VALUE Lang="th">Those Gold Coins are the most precious treasure of mine...</VALUE>
    <VALUE Lang="th">Can somebody please help?....</VALUE>
    <VALUE Lang="th">Well, look at you, you look pretty strong...</VALUE>
    <VALUE Lang="th">Would you please help me, would you please?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_2_0_1">
    <VALUE Lang="th">Ok! I will help you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_2_0_2">
    <VALUE Lang="th">No! Sorry! (Back to beginning)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_3_0">
    <VALUE Lang="th">Great! I knew you would help me! Please find 50 of my Gold Coins from the monsters! If you could do that for me then I will give you a nice compensation.</VALUE>
    <VALUE Lang="th">Be careful! those monsters are pretty strong... Be safe!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_3_0_1">
    <VALUE Lang="th">Back to beginning</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_4_0">
    <VALUE Lang="th">Hurry! Before those bastards get far away and disappear with my Gold Coins.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_4_0_1">
    <VALUE Lang="th">Back to beginning</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_5_0">
    <VALUE Lang="th">Well Well Well~ finally these shining Gold Coins have came back to me...</VALUE>
    <VALUE Lang="th">(giggles).... Simple ones.... (giggles)</VALUE>
    <VALUE Lang="th">Thanks to you, I now have acquired mighty power... (giggles)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_5_0_1">
    <VALUE Lang="th">What are you saying...?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_6_0">
    <VALUE Lang="th">You still don't get it, do you? What a fool... (giggles)</VALUE>
    <VALUE Lang="th">Actually, those monsters you have "Punished" are the true owners of these Gold Coins. You simply trusted my words and took their Gold Coins from them... (giggles)... These Gold Coins work as a charm which gives more power to those monsters.</VALUE>
    <VALUE Lang="th">I have always envied it but the monsters were too strong for me to defeat and I could not do anything.... After a long long period of my master planning, I knew that I could be able to get these Gold Coins easily by fooling you....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_6_0_1">
    <VALUE Lang="th">Gee... then... you fooled me!! You con!! Give the Gold Coins back!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_7_0">
    <VALUE Lang="th">(giggles)... Aww, you now understood... But what can you do?</VALUE>
    <VALUE Lang="th">I have no intention to give these precious treasure back to you! (giggles)...</VALUE>
    <VALUE Lang="th">However, I am the man of my word!</VALUE>
    <VALUE Lang="th">I will give you the reward which I have promised you for getting these Gold Coins.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_7_0_1">
    <VALUE Lang="th">Reward...? What is it?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_8_0">
    <VALUE Lang="th">Well, about now, the monsters should be looking all over for you, as crazy as they can be...</VALUE>
    <VALUE Lang="th">You are in a great danger... (giggles)</VALUE>
    <VALUE Lang="th">My reward will be of a great help when you are hunted by those angry monsters... (giggles) Monsters might come at any minute now! I don't want to get involved in it, so hurry up and decide whether to take my reward or not and leave this place!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_8_0_1">
    <VALUE Lang="th">Accept the Reward</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_8_0_2">
    <VALUE Lang="th">Do not Accept the Reward</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_9_0">
    <VALUE Lang="th">Aww.. Come on... I am sorry for tricking you...! Take this now before the monsters barge into this place!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_9_0_1">
    <VALUE Lang="th">Angry but accept the gift anyway.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_suryun.ntk_1_0">
    <VALUE Lang="th">Hello...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_suryun.ntk_1_0_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0">
    <VALUE Lang="th">This is for the Extra Stage.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hurry and take this, if you want to go there and check it out.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_1">
    <VALUE Lang="th">Take Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_2">
    <VALUE Lang="th">Take Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_3">
    <VALUE Lang="th">Take Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_4">
    <VALUE Lang="th">Take Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_5">
    <VALUE Lang="th">Take Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_6">
    <VALUE Lang="th">Buy Bus Ticket</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0">
    <VALUE Lang="th">I'm deployed here to conduct the orders from Saint Foundation. What can I do for you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_1">
    <VALUE Lang="th">Eliminate Life Weapon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_2">
    <VALUE Lang="th">Geth the tissue sample</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_3">
    <VALUE Lang="th">Deliver the tissue sample</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_4">
    <VALUE Lang="th">Secure way out</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_2_0">
    <VALUE Lang="th">What Ryuin delivered can be reported together with mine at the same time after finishing my mission. Apart from this, can you help me? This is a secret introduction, though, I can't do it by myself. I heard the enemy have biological weapons. Can you check whether they really exist and destroy them instead?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_3_0">
    <VALUE Lang="th">What Saint Foundation though was true! I can't even imagine what could happen to me if I went there alone. I'm sorry to keep asking you for favors, but, can I ask one more? Can you get me some tissue samples from biological weapons?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_4_0">
    <VALUE Lang="th">You are much better than expected always! Thank you. I will remember what you've done for me. Ah, I saw the Physics Teacher around here! You could get some goods you need.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_5_0">
    <VALUE Lang="th">I'm deeply sorry but I have one more favor. I was to get back to Saint Foundation, though, there are a plenty of monsters and enemies all around. Can you secure my way back to the Saint Foundation? This would be my last favor.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0">
    <VALUE Lang="th">I'm here to give support in students injured. Just tell me if there is anything I can help you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_2">
    <VALUE Lang="th">Set as Starting Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_3">
    <VALUE Lang="th">Get first-aid kit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_4">
    <VALUE Lang="th">Deliver first-aid kit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_2_0">
    <VALUE Lang="th">On my way here, most of the first-aid boxes was stolen by Monsters so that I'm in difficulty with helping students. Can you get them back from the Monsters?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_3_0">
    <VALUE Lang="th">Really appreciated. Please bring me more first-aid boxes.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0">
    <VALUE Lang="th">Welcome to Ground Zero. It will be harder than you think.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_1">
    <VALUE Lang="th">Talk with Student Director</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_10">
    <VALUE Lang="th">Final Report</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_11">
    <VALUE Lang="th">Reach Level 225</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_12">
    <VALUE Lang="th">Reach Level 230</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_13">
    <VALUE Lang="th">Reach Level 235</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_14">
    <VALUE Lang="th">Reach Level 240</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_15">
    <VALUE Lang="th">Reach Level 225 Report</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_16">
    <VALUE Lang="th">Reach Level 230 Report</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_17">
    <VALUE Lang="th">Reach Level 235 Report</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_18">
    <VALUE Lang="th">Reach Level 240 Report</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_19">
    <VALUE Lang="th">The Past Still Present</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_2">
    <VALUE Lang="th">Eliminate Scouter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_20">
    <VALUE Lang="th">Report the result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_21">
    <VALUE Lang="th">The call for final attack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_3">
    <VALUE Lang="th">Eliminate Elite Scouter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_4">
    <VALUE Lang="th">Acquire Scouter Badge</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_5">
    <VALUE Lang="th">Deliver Scouter Badge</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_6">
    <VALUE Lang="th">Get the directive of search</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_7">
    <VALUE Lang="th">Report the result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_8">
    <VALUE Lang="th">Deliver the Attack Directive</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_9">
    <VALUE Lang="th">Eliminate The Commander</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_10_0">
    <VALUE Lang="th">So..Well.. The final battle is to begin. Don't look down on the boss! You should be more careful. Beating them all is important, but the safety comes first. Good luck!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_11_0">
    <VALUE Lang="th">Oh..It's more than I've expected! There's no doubt that we can confront and overcome any sort of threats! Every students and teachers will remember and eulogize you forever!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_12_0">
    <VALUE Lang="th">Waited for you! The remains of the defense line have been being collapsed while the cleanup party had already got into Chaos Island. I desperately want to clutch at any straw now! Can you help us out? Please..It will be defintely a big help for us.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_13_0">
    <VALUE Lang="th">Thank you!! Thank you very much! You save us all!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_2_0">
    <VALUE Lang="th">Thank you for responding to our call. We are in the serious situation now. So we desperately need your help! It's going to be so painful time.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_3_0">
    <VALUE Lang="th">The advance party is almost done for observing enemy movement now. Eliminate the enemies closest to you. Kill Scouter.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_4_0">
    <VALUE Lang="th">It seems as if the advance party is almost done for observing enemy movement now. Eliminate the enemies closest to you. Kill Elite Scouter.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_5_0">
    <VALUE Lang="th">We are to build the final defense line to make enemies stay in the Ground Zero. To do that, get me the spoils taken from the enemies. Then you deserve the rewards!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_6_0">
    <VALUE Lang="th">Great! Along with your own power, please save the final defense line!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_7_0">
    <VALUE Lang="th">It seems as if the enemies move upon a directive of their boss. Some of them definitely have instructions. Please eliminate them and bring it to me!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_8_0">
    <VALUE Lang="th">Oh… It was true! They've been ordered by their boss. Hm.. But it's all encrypted. Hard to get across it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_9_0">
    <VALUE Lang="th">Head toward the Technical Teacher with the directive taken from the enemies. He could decipher the message!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0">
    <VALUE Lang="th">It's not a good situation here. Can you help us?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_1">
    <VALUE Lang="th">Deliver deciphered directive of search</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_10">
    <VALUE Lang="th">Report the result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_11">
    <VALUE Lang="th">Report the result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_12">
    <VALUE Lang="th">Buying Time</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_13">
    <VALUE Lang="th">Reporting Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_2">
    <VALUE Lang="th">Eliminate The Chaser</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_3">
    <VALUE Lang="th">Find where is dispatched agent</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_4">
    <VALUE Lang="th">Get the Attack directives</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_5">
    <VALUE Lang="th">Deliver the Attack Directives</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_6">
    <VALUE Lang="th">Secure the entry way</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_7">
    <VALUE Lang="th">Ask for the final attack command</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_8">
    <VALUE Lang="th">Chaos Begins</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_9">
    <VALUE Lang="th">Report the result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_10_0">
    <VALUE Lang="th">Thank you! The burden of the rearguard students is now lightened.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_11_0">
    <VALUE Lang="th">Could you please help me and buy some time for the healing of the injured Assassins?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_11_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_12_0">
    <VALUE Lang="th">Thank you. Because of you the healing is completed…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_12_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_2_0">
    <VALUE Lang="th">Are you the student the Technical Teacher sent? Ah..wait for seconds.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_3_0">
    <VALUE Lang="th">It all came true. They've been moving upon the directive of their boss. Hm, everybody reports to the Chaser, then the Chaser must be the leader of Searcher Unit. OK, then she is the one you have to eliminate first! There's no time to hesitate! Go!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_4_0">
    <VALUE Lang="th">Hm.. I need to report current situation of Lost City to Saint Foundation for more students to fight. One of agents from Saint Foundation dispatched would be around here and have a way to communicate with Saint Foundation, but I lost him. Please find him and tell him about this situation instead.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_5_0">
    <VALUE Lang="th">I found within the directives on search that the main force has been delivering the directive of search. Before they send them all, we can interrupt the enemy with snatching the directives. Can you do that?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_6_0">
    <VALUE Lang="th">Great works! Please keep collecting the directive of search as much as possible!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_7_0">
    <VALUE Lang="th">Scientist Teacher sent us details. The boss of the enemies is positioned at the deep inside Chaos Island. The thing is that you will confront many monsters in front. Eliminate them all and secure the entry! Go!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_8_0">
    <VALUE Lang="th">Thank you so much! Now that we can approach to the boss without a hitch, please report this situation to Student Director and ask the final attack. I'll wait here.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_9_0">
    <VALUE Lang="th">I feel strange here. I assume that the enemy decides to advance to attack. It may damage the students in rear. Can you gain time?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0">
    <VALUE Lang="th">Why I've dispatched here is… to collect the technical resources.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_1">
    <VALUE Lang="th">Deliver the directive of search</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_2">
    <VALUE Lang="th">Get the code-breaking kit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_3">
    <VALUE Lang="th">Deliver the code-breaking kit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_4">
    <VALUE Lang="th">Secure the entry way 1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_5">
    <VALUE Lang="th">Secure the entry way 2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_6">
    <VALUE Lang="th">Collect Weapon Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_7">
    <VALUE Lang="th">Collect Weapon Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_8">
    <VALUE Lang="th">Deliver deciphered directive of search</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_9">
    <VALUE Lang="th">Deliver again the directive of search</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_10_0">
    <VALUE Lang="th">Ah, is that a new directive on search taken from the enemies? I'll start to decrypt it right away.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_2_0">
    <VALUE Lang="th">The encrypted structure of this enemy's directive on search from Student Director is different. I can't decrypt it right away, but what if you get me the code-breaking kit?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_3_0">
    <VALUE Lang="th">Some of enemies might have the code-breaking kit. If I get it, I can use it for deciphering the code soon!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_4_0">
    <VALUE Lang="th">Is this the code-breaking kit? Wait for seconds. It seems that the way to use this kit is not so different from ours. It won't take so long to decrypt it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_5_0">
    <VALUE Lang="th">Hello, again! Code-breaking works is almost done. I need to deliver this to Ryuin if I'm done with it, but there are a bunch of monsters. Can you secure the entry way to him?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_6_0">
    <VALUE Lang="th">Appreciate your help, though, there are plenty of monsters left still. Please keep working on it more. Thank you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_7_0">
    <VALUE Lang="th">I've checked on the weapons and arms of the enemies, and technically, they are much more prominent than ours. Can you get the parts of them? I'll analyze them, and it will be defintely helpful for us.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_8_0">
    <VALUE Lang="th">Thank you! But the parts have been broken while I'm doing a research on it. The more get the parts, the better I can do my research. Can you keep getting them for me?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_9_0">
    <VALUE Lang="th">Finally I'm done with decryption!! It contains the important messages for the advance party. Can you hand it over to Ryuin?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0">
    <VALUE Lang="th">It's impossible. It's superphysical. How come have they done this? It could bring a terrible disaster…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_2">
    <VALUE Lang="th">Deliver Blood Sample</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_3">
    <VALUE Lang="th">Block the supplies passage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_4">
    <VALUE Lang="th">Report the result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_5">
    <VALUE Lang="th">Eliminate The Transformer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_6">
    <VALUE Lang="th">Report the result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_2_0">
    <VALUE Lang="th">Oh! Surprised! How did you find me? I've been waiting for someone coming because Scientist Teacher asked me a favor. I forgot to deliver this message to him as frantically coming here.Can you deliver this message instead of me? He's inside of Collapsed City.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_3_0">
    <VALUE Lang="th">A massive size of army was moving out from inside of the city, and… they were carrying big loads a lot. I guess that they are supplies for armies. Can you cut off them? Ah, but, please be careful the big one. I don't have a good feeling.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_4_0">
    <VALUE Lang="th">Wasn't it hard? You are fantastic! The students in rear will definitely appreciate you a lot.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_5_0">
    <VALUE Lang="th">While researching inside of the city, I found a strange enemy in mechanical arms. I couldn't finish my survey because of him. Looks dangerous but you would know what you can do for this, don't you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_6_0">
    <VALUE Lang="th">I was right! Thank you so much! I can restart my survey now.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0">
    <VALUE Lang="th">Hm…It's really strange. Really odd creatures are here. Inspires my curiosity a lot. Hope to go back to my lab as soon as possible. Hope that this situation goes end soon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_1">
    <VALUE Lang="th">Deliver Blood Sample</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_2">
    <VALUE Lang="th">Deliver research report on enemy troops</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_3">
    <VALUE Lang="th">Get the blood sample of Mutant Citizen</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_4">
    <VALUE Lang="th">Deliver the blood sample of Mutant Citizen</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_5">
    <VALUE Lang="th">Get the blood sample of Twisted Soldier</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_6">
    <VALUE Lang="th">Deliver the blood sample of Twisted Soldier</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_7">
    <VALUE Lang="th">Get the reseach report on the size of enemy.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_2_0">
    <VALUE Lang="th">Finally I got it! I've desperately needed it. Thank you! Ah, I have something for Ryuin. Wait for seconds..Where did I put it?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_3_0">
    <VALUE Lang="th">Ah! Here it is. It's a research report written while searching inside of the city. Please hand it over to Ryuin. He must want it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_4_0">
    <VALUE Lang="th">Resembles Gorilla.. And a bunch of rare creatures are here, but they are really aggressive. It's my personal request, though, could you get me the blood samples of them?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_5_0">
    <VALUE Lang="th">Deeply appreciated! I want to proceed my experiments more!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_6_0">
    <VALUE Lang="th">Sorry, but I have one more favor for you. Did you see an abnormal living thing with strange arms. Looks really creepy, but I badly want to have a study about it. Can you bring me the blood sample of it?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_7_0">
    <VALUE Lang="th">Thank you for your help! Thank you so much! I'll never forget your hard decision on this!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0">
    <VALUE Lang="th">This is the dedicated elevator to Basement 2.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You must enter the password before you can use it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0_1">
    <VALUE Lang="th">Enter Password</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0_4">
    <VALUE Lang="th">Enter Password</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0_5">
    <VALUE Lang="th">Read Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_4_0">
    <VALUE Lang="th">Password Error.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please try again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_5_0">
    <VALUE Lang="th">Password Confirmed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You may now use the elevator.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_5_0_1">
    <VALUE Lang="th">Read Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_5_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_6_0">
    <VALUE Lang="th">Some of the specimens in Basement 2 are spreading…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Whoever reads this message, please inform the others as soon as possible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They have to know that the basement is in critical condition.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0">
    <VALUE Lang="th">Ermm... I can't see...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Just where am I?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It feels like… Like this world is completely different!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0_1">
    <VALUE Lang="th">Change Save Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0_2">
    <VALUE Lang="th">Ask about Sacred Financial Group's Public Service</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1">
    <VALUE Lang="th">Student!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I know how you can pass through this door.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I would be happy to tell you how if you do some favors for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_1">
    <VALUE Lang="th">Change Save Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_2">
    <VALUE Lang="th">Ask about the Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_3">
    <VALUE Lang="th">Give the Encyclopedias</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_4">
    <VALUE Lang="th">Give the Feathers</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_5">
    <VALUE Lang="th">Ask about Sacred Financial Group's Public Service</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_6">
    <VALUE Lang="th">Ask about the day of Phenomenon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_2">
    <VALUE Lang="th">I'm sorry, but there's no way you can pass through these gates at your current level.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Come back again after you get stronger and can prove yourself of being worthy!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_2_1">
    <VALUE Lang="th">Change Save Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_10_0">
    <VALUE Lang="th">Sa… Sac... Sacred...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hate... Many… Bodies of Tomb…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Heaven... Rest... Interrupted... Damn people…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Disobey... Orders... Dangerous…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_11_0">
    <VALUE Lang="th">Pheo… Pheonomenon? What are you talking about?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_11_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_2_0">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_2_0_1">
    <VALUE Lang="th">Changed Start Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_3_0">
    <VALUE Lang="th">The entrance to this building was set up with a Force Field function. In order to pass through this door, you must have an Authentication Booklet.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can make one for you if you like!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_4_0">
    <VALUE Lang="th">Now I remember!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I need 8 pieces of Black Feathers from the Shadow Crows. Please bring them to me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_5_0">
    <VALUE Lang="th">I need eight pieces of Enchanted Feathers.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is needed to create the Authentication Scroll. Once you have that, you'll be able to pass through the doors.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Very good! This should be enough!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_5_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_6_0">
    <VALUE Lang="th">.....3</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_7_0">
    <VALUE Lang="th">Please help me…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Something is definitely wrong with my head.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can't remember anything. Please help me find a book that can help me remember…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_8_0">
    <VALUE Lang="th">.....5</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_9_0">
    <VALUE Lang="th">Okay, once you've been authenticated to pass through the doors, you can easily enter and exit this building.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please be safe!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0">
    <VALUE Lang="th">Hahaha!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_1">
    <VALUE Lang="th">Ask What's the Matter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_10">
    <VALUE Lang="th">Ask if he needs anything</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_2">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_3">
    <VALUE Lang="th">Give the Food</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_4">
    <VALUE Lang="th">Ask if he is a friend of Suna Jo</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_5">
    <VALUE Lang="th">Tell him Suna Jo has sent you here</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_6">
    <VALUE Lang="th">Ask what had happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_7">
    <VALUE Lang="th">Deliver greetings from Evilplate Monk</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_8">
    <VALUE Lang="th">Ask if he needs help with anything</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_9">
    <VALUE Lang="th">Report the result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_10_0">
    <VALUE Lang="th">Oh! Suna has sent you here.. I am getting my memories back somehow since from your last visit.. For a while, my mind was just dim and I was hungry.. But My head is not clear yet.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_10_0_1">
    <VALUE Lang="th">Tell him you would like to know what happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_11_0">
    <VALUE Lang="th">I only remember someone helping me to get here. She had a very beautiful yet sad eyes but the people she was with looked very scary..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_11_0_1">
    <VALUE Lang="th">Ask what had happened to them</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_12_0">
    <VALUE Lang="th">We said goodbye in front of the main gate and they were headed to Trading Hole. Then, I met Leonine school Student Director. I wonder what that child is doing right now.. I really would like to know. If you aren't that busy would you please send my regards to her?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_12_0_1">
    <VALUE Lang="th">Tell him you will find it</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_13_0">
    <VALUE Lang="th">Thanks.. I am really grateful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_13_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_14_0">
    <VALUE Lang="th">He must be.. worried about me.. But I would like to find out about something first..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_14_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_15_0">
    <VALUE Lang="th">A student called Stoner had followed me to Leonine School but.. When I was conscious again, he was gone. Recently, a child passing through here told me that he has found a clue in the B 3F..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_15_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_16_0">
    <VALUE Lang="th">Oh.. Stoner.. Gee</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_16_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0">
    <VALUE Lang="th">Please deliver this letter to him</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0_2">
    <VALUE Lang="th">Deliver the letter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_2_0">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_3_0">
    <VALUE Lang="th">Very scary…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Everybody has become scary.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It wasn't like this before, but after that kid died…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Everything changed all of a sudden.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_4_0">
    <VALUE Lang="th">I've gotten very hungry, just hiding in here. I'm too scared to go outside… But… Do you have something I can eat?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please spare me some food…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_5_0">
    <VALUE Lang="th">Food?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Food!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now I can hide in here a while longer… I'll last…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_6_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_7_0">
    <VALUE Lang="th">Suna.. Suna Jo.. Hmm.. I think I can remember..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_7_0_1">
    <VALUE Lang="th">Tell him you are here on a request to find him</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_8_0">
    <VALUE Lang="th">Suna is.. She is my friend. How come I couldn't remember a friend's name.. She must have been worried so much.. Um.. Would you please send my regards to her?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_8_0_1">
    <VALUE Lang="th">Tell him not to worry</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_9_0">
    <VALUE Lang="th">Please deliver this letter to Suna, please..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_9_0_1">
    <VALUE Lang="th">Take the letter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0">
    <VALUE Lang="th">You're… You're h-human!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">When the Force Field was removed… The humans… Changed…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm also ch-changing. Very slowly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Still got some… M-medicine here, but not m-much left.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I c-can sell it to you, but it'll b-be expensive…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_2">
    <VALUE Lang="th">Ask if she is scared</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_3">
    <VALUE Lang="th">Tell her what happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_4">
    <VALUE Lang="th">Ask if she is scared</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_5">
    <VALUE Lang="th">Tell her what happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_6">
    <VALUE Lang="th">Ask about the day of Phenomenon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_2_0">
    <VALUE Lang="th">Ev.. every night.. those men.. ca.. call.. me.. I.. don't.. wan.. wanna. go..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_3_0">
    <VALUE Lang="th">Th.. they.. are not.. gon.. gonna co.. come.. any.. more..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_4_0">
    <VALUE Lang="th">The.. tea.. teachers.. are ca.. call calling.. me .. no.. now..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_4_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_5_0">
    <VALUE Lang="th">Th.. they.. are not.. gon.. gonna co.. come.. any.. more..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_5_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_6_0">
    <VALUE Lang="th">No… I don..t remem…ber … any.. Thing…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_6_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_1_0">
    <VALUE Lang="th">I-I'm so hungry…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">No more students…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Suffering in hunger...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How did it come to this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_1_0_1">
    <VALUE Lang="th">Request Key</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_1_0_2">
    <VALUE Lang="th">Give Something to Eat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_2_0">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_3_0">
    <VALUE Lang="th">Yes, I'm talking about a key.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The key to which room or building? Classroom? Information Center?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_4_0">
    <VALUE Lang="th">Food to eat!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is too unbelievably wonderful…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Here, you can have this key!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You are a good student.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll give you a better grade on your next paper.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Heh heh heh!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_5_0">
    <VALUE Lang="th">.....3</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_6_0">
    <VALUE Lang="th">This is a video tape?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So what is it you want to give me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You give, you take, you give, you take. It's alright as long as the balance isn't tipped too far.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_7_0">
    <VALUE Lang="th">But…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please bring me something to eat.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I see some people eating outside.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please bring me some food!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0">
    <VALUE Lang="th">Where are my students? They're all gone!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I feel their spirits roaming this eerie building!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How can I help you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_1">
    <VALUE Lang="th">Ask about Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_10">
    <VALUE Lang="th">Ask about the day of Phenomenon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_11">
    <VALUE Lang="th">Ask if he needs help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_12">
    <VALUE Lang="th">Hand over the things found</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_13">
    <VALUE Lang="th">Ask if he is in a trouble</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_2">
    <VALUE Lang="th">Ask about Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_3">
    <VALUE Lang="th">Request Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_4">
    <VALUE Lang="th">Return the Key</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_5">
    <VALUE Lang="th">Retrieve the Cassette</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_6">
    <VALUE Lang="th">Take out the Crystal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_7">
    <VALUE Lang="th">Ask about the Cassette</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_8">
    <VALUE Lang="th">Ask about the Code to Enter Basement Level 2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_9">
    <VALUE Lang="th">Ask about Sacred Financial Group's Public Service</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_10_0">
    <VALUE Lang="th">Student should have learned from class that the start of the chaos started about 18 years ago.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It started when the eclipse and meteor shower happened in Northern Asia.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_11_0">
    <VALUE Lang="th">Once you collect all the necessary records, compile them and give the records to him!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please don't forget to be polite.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_12_0">
    <VALUE Lang="th">A-ha! I remember the special number code.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I wrote it in the memo.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Just bring it over so we can decipher the message using the code.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_13_0">
    <VALUE Lang="th">.......10</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_14_0">
    <VALUE Lang="th">Everything started during that time. The Sacred Financial Group set up all 4 Colleges which are protected with Force field Mechanisms. This is their way to protect the people; especially the Students!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_14_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_15_0">
    <VALUE Lang="th">That is the starting point of all those inexplicable happenings.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There's nothing to hide now. All the people already know what brought the chaos. I hope everyone can help to bring a little order, especially on the streets.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Here's some more information...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The meteor shower is a sign of communication between the outer world and the world we are living in right now. It is one of the greatest mysteries that consuming my thoughts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_15_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_16_0">
    <VALUE Lang="th">This just proves that there is another world or dimension out there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If I may be so bold, I actually believe that we are controlled by machines that are controlled by people! I just hope that this isn't true!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_16_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_17_0">
    <VALUE Lang="th">I have a lot of beliefs and theories to share with you, but I don't have much time!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The only sure thing I can tell you is that there's still a way to stop the spread of this chaos and save our world.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please keep your hopes up, okay?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Vigilance is a virtue!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_18_0">
    <VALUE Lang="th">Oh my, I… My mind… I'm having trouble… Thinking…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You are… Did you bring the red ball to me before?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why…? Suddenly…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Sacred Financial Group? No... Yes... I remember it like an angel that was supposed to work for good and justice. At least... When this place was Leonine campus before the incident.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_18_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_19_0">
    <VALUE Lang="th">Dangerous... It already changed direction…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Laboratory... They experimented on humans, but this… They abandoned this world…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_19_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_2_0">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_20_0">
    <VALUE Lang="th">The day.. Wasn.. Wasn't.. Different.. From… any other day.. I don'..t rememeber.. Anything.. on that day…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_20_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_21_0">
    <VALUE Lang="th">There.. Is … a notebook… I have.. Written.. Everything.. There.. A boy and a .. Girl student has one each… if.. You find.. The notebooks… then you will.. Be able to know what… happened.. On.. That.. Day…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_21_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_22_0">
    <VALUE Lang="th">Now.. I.. Will.. Know.. What.. Ha..happen..ed</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_22_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_23_0">
    <VALUE Lang="th">Ta.. Take thie.. I don.. don't need it.. Any.. More..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_23_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_3_0">
    <VALUE Lang="th">Students! Where are my precious students?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What's going on here?!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_4_0">
    <VALUE Lang="th">Dear Student: Please be careful when you explore the corridors. Be safe! Evil spirits are all around.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_5_0">
    <VALUE Lang="th">Ah! I need all necessary data information stored and encrypted in the Cassette! There are also documents like diaries that would help me understand how the chaos began!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This video Cassette is locked!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Where is the key? I believe it is in the 3rd Classroom of the Second Year Corridors.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please be discreet while traversing the eerie hallways!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_6_0">
    <VALUE Lang="th">This is the key!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why is it bent out of shape? We need to fix it first. Someone in the 7th Class of the Second Year Batch can have this key fixed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Student! Please visit him and get this key fixed! Don't run around in the hallway!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Take Care!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_7_0">
    <VALUE Lang="th">Oh! Here's the Cassette!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please use it properly and take good care of it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is a very important clue in our investigation that can help us unlock the mystery of all this chaos.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_8_0">
    <VALUE Lang="th">Crystal! Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What happened here?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This isn't right! How did the Administration Office become this way? Where are the teachers? Everyone disappeared!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_8_0_1">
    <VALUE Lang="th">Explain the Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_8_0_2">
    <VALUE Lang="th">Request Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_8_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_9_0">
    <VALUE Lang="th">It's real!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The entire city was affected by the abnormal phenomenon. I hope this can be fixed somehow.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_9_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_0">
    <VALUE Lang="th">Me</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">should</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">ruin the job</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">or correct it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_0_1">
    <VALUE Lang="th">Request Key Repair</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1">
    <VALUE Lang="th">The ceiling collapsed, the deck also broken ...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The windows fell down ... What should be done first?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1_1">
    <VALUE Lang="th">Request Key Repair</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1_2">
    <VALUE Lang="th">Ask about Help that may be Needed</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1_3">
    <VALUE Lang="th">Give the Towel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1_4">
    <VALUE Lang="th">Give the Glove</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_10_0">
    <VALUE Lang="th">I'll bend it too much out of shape if I use too much force …</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Knowing the correct amount of pressure is very important.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_11_0">
    <VALUE Lang="th">.....4</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_12_0">
    <VALUE Lang="th">Spider webs are the worst! And there are cracks in the wall, desk, and blackboard.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't even have my towel and gloves… How can I work like this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_12_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_13_0">
    <VALUE Lang="th">Emm…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Help me find it first.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_14_0">
    <VALUE Lang="th">I think my towel is in the Locker on the 1st Floor. Will you help me by getting it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can find my gloves on my own.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_14_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_15_0">
    <VALUE Lang="th">....5</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_16_0">
    <VALUE Lang="th">This means that I've got to work hard.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I need my towel if I'm going to work comfortably.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That's right.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_16_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_17_0">
    <VALUE Lang="th">But…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can't find my gloves...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Think carefully. Yes, I placed them on the shelf in the shop house… Did I?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Help me find it!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_18_0">
    <VALUE Lang="th">......6</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_19_0">
    <VALUE Lang="th">Now you can go.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can complete this by myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Bring this crystal to the Student Director.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't need it anymore.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_19_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_2_0">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_3_0">
    <VALUE Lang="th">So does it mean it has to be done first?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It doesn't need much time, and it's not too hard.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Just a slight press</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_4_0">
    <VALUE Lang="th">I reorganized all the College's facilities on my own.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's an easy job.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I just don't know where to start.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_5_0">
    <VALUE Lang="th">Ah, my towel.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm, I can work really hard if I have a towel.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I need something to wipe off my sweat, you know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can't hold anything if your hands slip from getting all sweaty.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_5_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_6_0">
    <VALUE Lang="th">Glove! My glove…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can start working now!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm, but where do I begin?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What should I do first?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_7_0">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_7_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_8_0">
    <VALUE Lang="th">.....3</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_9_0">
    <VALUE Lang="th">I need to understand how to put this together… The logo won't pop off with just a light press.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Don't force the crooked area. I feel like it will slightly bend in the reversed direction… Back into shape.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_9_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0">
    <VALUE Lang="th">……what's your business?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_1">
    <VALUE Lang="th">Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_10">
    <VALUE Lang="th">Wiping Out the Loan Shark (Repeat)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_11">
    <VALUE Lang="th">Restart Scouting Operation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_12">
    <VALUE Lang="th">Defeat the Loan Shark Group Leader</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_13">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_2">
    <VALUE Lang="th">Set Starting Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_3">
    <VALUE Lang="th">Scout Surroundings</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_4">
    <VALUE Lang="th">Report Investigation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_5">
    <VALUE Lang="th">Merchants Oppression</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_6">
    <VALUE Lang="th">Merchants Oppression (Repeat)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_7">
    <VALUE Lang="th">Investigate the Reason for Violence</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_8">
    <VALUE Lang="th">Deliver the drug analysis report</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_9">
    <VALUE Lang="th">Wiping Out the Loan Shark</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_10_0">
    <VALUE Lang="th">…great work. Now the rest should go away.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_2_0">
    <VALUE Lang="th">…let's scout the areas. You go that way.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_3_0">
    <VALUE Lang="th">…great work. I will keep that in mind.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_4_0">
    <VALUE Lang="th">…the merchants…are acting strange. Defeat and bring them here.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_5_0">
    <VALUE Lang="th">…I wouldn't know anything about this. Please take it to the Scientist Instructor.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_6_0">
    <VALUE Lang="th">…great work. I will take care of this.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_7_0">
    <VALUE Lang="th">…I've narrowed down the targets. Let's wipe out the Loan Shark.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_8_0">
    <VALUE Lang="th">…roughly done. Let's widen the scouting range.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_9_0">
    <VALUE Lang="th">…If we cut off it's head, then the rest will fall. Let's defeat the group leader.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0">
    <VALUE Lang="th">……what's your business?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_1">
    <VALUE Lang="th">Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_10">
    <VALUE Lang="th">Distraction Attack Strategy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_11">
    <VALUE Lang="th">Eliminate the Leader of Violent Organization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_12">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_13">
    <VALUE Lang="th">Wipe Out Violent Organization (Repeat)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_2">
    <VALUE Lang="th">Set Starting Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_3">
    <VALUE Lang="th">Scout Surroundings</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_4">
    <VALUE Lang="th">Report Investigation Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_5">
    <VALUE Lang="th">Collect Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_6">
    <VALUE Lang="th">New Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_7">
    <VALUE Lang="th">Cross the Bridge</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_8">
    <VALUE Lang="th">Report Investigation Content</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_9">
    <VALUE Lang="th">Test Fighting Power</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_10_0">
    <VALUE Lang="th">…I have found out where the leader of the Violent Organization is. Just ignore the underlings and go straight for his head.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_11_0">
    <VALUE Lang="th">…Great work. I know it wasn't easy.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_12_0">
    <VALUE Lang="th">…please wipe out the remaining members.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_2_0">
    <VALUE Lang="th">…we need a clear view of the base. Please scout ahead.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_3_0">
    <VALUE Lang="th">…is that so..? Even in here…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_4_0">
    <VALUE Lang="th">…please find out about the current situation here from the residents.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_5_0">
    <VALUE Lang="th">…you've done well. Let's cross the bridge..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_6_0">
    <VALUE Lang="th">…let's infiltrate after we cross the bridge. Let's regroup at the other side first.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_7_0">
    <VALUE Lang="th">…so the residents are saying the same thing. I see.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_8_0">
    <VALUE Lang="th">…let's find out the enemies' strategy and patterns first.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_9_0">
    <VALUE Lang="th">…seems like this will be really difficult. I will sneak in, so you just do as planned.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_0">
    <VALUE Lang="th">It's all done now.</VALUE>
    <VALUE Lang="th">Now you can go to the other side through the tunnel.</VALUE>
    <VALUE Lang="th">Good luck and be careful!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_1">
    <VALUE Lang="th">Hey~ Not there!!</VALUE>
    <VALUE Lang="th">Can't you move faster?!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_1_1">
    <VALUE Lang="th">Tell him that you were selected.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_1_2">
    <VALUE Lang="th">Give him the storage key.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_2_0">
    <VALUE Lang="th">Ah, you volunteered to scout..</VALUE>
    <VALUE Lang="th">Ha.. What should we do? The process isn't finished yet.</VALUE>
    <VALUE Lang="th">The drilling machine just broke and we need the storage key to fix it.</VALUE>
    <VALUE Lang="th">Could you please go and get the key?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_2_0_1">
    <VALUE Lang="th">Tell him that you will get the key.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_3_0">
    <VALUE Lang="th">I forget where did I put my keys.</VALUE>
    <VALUE Lang="th">Well, I guess we can use the spare key.</VALUE>
    <VALUE Lang="th">Try and ask the Student Counsellor in MarketPlace for it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_4_0">
    <VALUE Lang="th">Wooow~~~ thank you very much for this!</VALUE>
    <VALUE Lang="th">Now we can finish the job. Ha Ha Ha.</VALUE>
    <VALUE Lang="th">Please wait for a bit and trust us.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_0">
    <VALUE Lang="th">Hi..Hiiks..Please save me…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_0_1">
    <VALUE Lang="th">Ask him where does it hurt.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_0_2">
    <VALUE Lang="th">Ask about the areas over the bridge.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_1">
    <VALUE Lang="th">Ah Ah..What happened to the others…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_1_1">
    <VALUE Lang="th">Gangsters Tyranny (Repeat)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_1_2">
    <VALUE Lang="th">Ask him what happened.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_2_0">
    <VALUE Lang="th">Ah..Ah Ah..Re really?</VALUE>
    <VALUE Lang="th">Ugh..Th th Thank you. Really.</VALUE>
    <VALUE Lang="th">I have been harassed by the gangsters..luckily I managed to get away..</VALUE>
    <VALUE Lang="th">It will be the end of me if I get caught by them.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_3_0">
    <VALUE Lang="th">There was an incident not too long ago.</VALUE>
    <VALUE Lang="th">The tunnel collapsed and we are separated from the other world but we managed to survive…</VALUE>
    <VALUE Lang="th">But, I don't remember since when..suspicious men started to gather.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_3_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_4_0">
    <VALUE Lang="th">At at at first I thought they were just some thugs from the neighborhood</VALUE>
    <VALUE Lang="th">but they imprison people, working them like slaves, while taking over the city.</VALUE>
    <VALUE Lang="th">Even up to now, there should be a lot of people who are working for them against their own will.</VALUE>
    <VALUE Lang="th">Those</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_4_0_1">
    <VALUE Lang="th">Gangsters Tyranny</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_5_0">
    <VALUE Lang="th">Th th.. Thank you… Really grateful.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_6_0">
    <VALUE Lang="th">I am st st still worry about the others who were captured.</VALUE>
    <VALUE Lang="th">If you could please wipe them out so that the others could escape?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_7_0">
    <VALUE Lang="th">You want to cr cr cross the bridge?</VALUE>
    <VALUE Lang="th">Th That place is the hideout of the Gangsters..</VALUE>
    <VALUE Lang="th">The strange guys with the mask don't just blindly shoot..</VALUE>
    <VALUE Lang="th">The scary girl always bring a sword..</VALUE>
    <VALUE Lang="th">It makes me shiver even just the thought of them..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0">
    <VALUE Lang="th">Wow. You have come.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_1">
    <VALUE Lang="th">Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_10">
    <VALUE Lang="th">[Daily Limited] Missing Credit Account Book</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_11">
    <VALUE Lang="th">Deliver Account Book</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_2">
    <VALUE Lang="th">Ask if she is the one who sent the note.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_3">
    <VALUE Lang="th">Deliver Unpaid Bill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_4">
    <VALUE Lang="th">Cut the Source of Fund</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_5">
    <VALUE Lang="th">Cut the Source of Fund (Repeat)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_6">
    <VALUE Lang="th">Noisy Biker Gang</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_7">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_8">
    <VALUE Lang="th">[Daily Limited] Generosity of the Underworld</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_9">
    <VALUE Lang="th">Deliver Weapon Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_10_0">
    <VALUE Lang="th">I have a lot of things to manage these days..but the biker gang keep on making a lot of noises at night, I can't sleep or focus.</VALUE>
    <VALUE Lang="th">We can deal with normal biker gangs but their leader is proven to be pretty strong.</VALUE>
    <VALUE Lang="th">Could you please find and defeat the leade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_11_0">
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Now I can enjoy peaceful nights. Hoho</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_12_0">
    <VALUE Lang="th">We have already conquered this side of the streets.</VALUE>
    <VALUE Lang="th">And it's all thanks to you. Hoho</VALUE>
    <VALUE Lang="th">Now, I am planing to expand to weapon exchanging business too..</VALUE>
    <VALUE Lang="th">Could you please assist me in collecting Mysterious Mask's weapon parts?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_13_0">
    <VALUE Lang="th">Impressive.</VALUE>
    <VALUE Lang="th">The way you handle it makes my heart flutters. Hoho</VALUE>
    <VALUE Lang="th">I will ask for your favor again next time.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_14_0">
    <VALUE Lang="th">Huff.. I am already really busy as it is..</VALUE>
    <VALUE Lang="th">But.. Last night someone broke in and stole the Credit Account Book..</VALUE>
    <VALUE Lang="th">I have an idea who it was..</VALUE>
    <VALUE Lang="th">Could you please go to that side and get the book back from those Spine Breakers?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_14_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_15_0">
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Do you want to always work for me?</VALUE>
    <VALUE Lang="th">…Hoho. Just kidding.</VALUE>
    <VALUE Lang="th">See you tomorrow.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_15_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_2_0">
    <VALUE Lang="th">Yes, that is correct.</VALUE>
    <VALUE Lang="th">I have known from a reliable source that you have been in "East Shopping Region" since a few days ago.</VALUE>
    <VALUE Lang="th">And I have contacted you because you seem to be trustworthy.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_2_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_3_0">
    <VALUE Lang="th">Let me introduce myself.</VALUE>
    <VALUE Lang="th">I am the owner of this "The Blue" bar, "Madam S".</VALUE>
    <VALUE Lang="th">This bar is an adult entertainment place which is under the protection of the "Violent Organization", which is in charge of East Shopping Region.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_3_0_1">
    <VALUE Lang="th">Why are you looking for me?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_4_0">
    <VALUE Lang="th">Wow, very direct. Ho ho</VALUE>
    <VALUE Lang="th">Well..I would like to offer you a deal.</VALUE>
    <VALUE Lang="th">A deal that will be beneficial to the both of us.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_4_0_1">
    <VALUE Lang="th">A deal?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_5_0">
    <VALUE Lang="th">I might be belong to the "Violent Organization" but this isn't related to that.</VALUE>
    <VALUE Lang="th">I just want to completely own this adult entertainment business.</VALUE>
    <VALUE Lang="th">And in the process, eliminates some of my competitors..</VALUE>
    <VALUE Lang="th">You can test your skills while fulfilling my request,</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_5_0_1">
    <VALUE Lang="th">I get it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_6_0">
    <VALUE Lang="th">Nice.</VALUE>
    <VALUE Lang="th">Then, first help me get the unpaid bills from the customers who didn't pay.</VALUE>
    <VALUE Lang="th">If they resists, you may break their legs or do anything as you please. Ho ho</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_7_0">
    <VALUE Lang="th">One, two, three, four……..it's the correct amount. Thank you.</VALUE>
    <VALUE Lang="th">There are also some troublesome guests in our establishment. Please take care of them.</VALUE>
    <VALUE Lang="th">I heard that they are pretty strong? Hoho</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_8_0">
    <VALUE Lang="th">Since you have proven yourself to be very strong..let's move on to the real deal, shall we?</VALUE>
    <VALUE Lang="th">The adult entertainment establishments serves as the source of funds for the "Violent Organization".</VALUE>
    <VALUE Lang="th">If you take down these establishments, the "Violent Organizati</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_9_0">
    <VALUE Lang="th">Although I have taken over the establishments as you have taken them down. But, it's not easy to finish them.</VALUE>
    <VALUE Lang="th">Please keep on defeating their remaining members so that they can't get back up again.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0">
    <VALUE Lang="th">I always like researching new things. Hohoho</VALUE>
    <VALUE Lang="th">Anything I can help you with?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_1">
    <VALUE Lang="th">Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_10">
    <VALUE Lang="th">[Daily Limited] Persistent Group of People</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_11">
    <VALUE Lang="th">Deliver Improved Drug Sample</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_2">
    <VALUE Lang="th">Talk about the merchants' situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_3">
    <VALUE Lang="th">Ask to analyze drug</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_4">
    <VALUE Lang="th">Troublesome Artists</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_5">
    <VALUE Lang="th">Troublesome Artists (Repeat)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_6">
    <VALUE Lang="th">Investigating Violence II</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_7">
    <VALUE Lang="th">Receive drug analysis</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_8">
    <VALUE Lang="th">Request to track place of origin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_9">
    <VALUE Lang="th">Confirm tracking result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_10_0">
    <VALUE Lang="th">Place of origin has been tracked.</VALUE>
    <VALUE Lang="th">The signal is encrypted so it took longer than expected..no big deal~</VALUE>
    <VALUE Lang="th">All of the phone message came from that side over the market area.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_11_0">
    <VALUE Lang="th">This Loan Shark group is just persistent like a cockroach!</VALUE>
    <VALUE Lang="th">This time they are using another type of drugs on the merchants.</VALUE>
    <VALUE Lang="th">Although we have delivered some samples to Assassin Agent but they are not enough.</VALUE>
    <VALUE Lang="th">Please help us and deliver more sample.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_12_0">
    <VALUE Lang="th">Thank you!</VALUE>
    <VALUE Lang="th">I will deliver the result of the tests later to Assassin Agent myself.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_2_0">
    <VALUE Lang="th">Um~ so they attacked without any reasons and warnings like crazy zombies, right?</VALUE>
    <VALUE Lang="th">Even after you managed to calm them down, they will start attacking again soon?</VALUE>
    <VALUE Lang="th">Any other traits that you spotted?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_2_0_1">
    <VALUE Lang="th">There seems to be some suspicious people hanging around the merchants..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_3_0">
    <VALUE Lang="th">Ohooo..Something smells fishy there, right? Hoho</VALUE>
    <VALUE Lang="th">There is only one truth! And it will eventually come to light!</VALUE>
    <VALUE Lang="th">Go and investigate those people.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_3_0_1">
    <VALUE Lang="th">Investigating Violence I</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_4_0">
    <VALUE Lang="th">See? I knew there is something wrong..Give that to me.</VALUE>
    <VALUE Lang="th">The test result might take a while because my equipments are rusty..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_5_0">
    <VALUE Lang="th">There are some strange looking guys who stole our supply dump.</VALUE>
    <VALUE Lang="th">Among the supply, the drug that we were investigating was also there…</VALUE>
    <VALUE Lang="th">Quick, go and teach them a lesson!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_6_0">
    <VALUE Lang="th">Those guys from before, they stole our supply dump again.</VALUE>
    <VALUE Lang="th">Quick, go and teach them a lesson again!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_7_0">
    <VALUE Lang="th">The result for the drug analysis has come out.</VALUE>
    <VALUE Lang="th">Please wait~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_8_0">
    <VALUE Lang="th">Um…Here!</VALUE>
    <VALUE Lang="th">It seems that this substance contained in the drug can enduce the violent part of the merchants' brain.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_9_0">
    <VALUE Lang="th">You want me to track the origin of the message in this phone?</VALUE>
    <VALUE Lang="th">Please wait for a moment~</VALUE>
    <VALUE Lang="th">Should be done in a second.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0">
    <VALUE Lang="th">Hocus Poocus~ I am the Magician Animal Trainer. What brings you here?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_1">
    <VALUE Lang="th">Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_2">
    <VALUE Lang="th">I wish to hire animals.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_3">
    <VALUE Lang="th">Trainer's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_4">
    <VALUE Lang="th">Trainer's Request (Request)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_5">
    <VALUE Lang="th">Lingering Attachment</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_6">
    <VALUE Lang="th">Tell him that there is no other way.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_7">
    <VALUE Lang="th">[Daily Limited] Trace of Mutation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_8">
    <VALUE Lang="th">Deliver Mutant Genes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_10_0">
    <VALUE Lang="th">The other scouts said that they saw someone who can call those beasts and tame them.</VALUE>
    <VALUE Lang="th">Can you..look for that person and ask him how did he tame those beasts?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_11_0">
    <VALUE Lang="th">Really..?</VALUE>
    <VALUE Lang="th">…Should I just really give up?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_12_0">
    <VALUE Lang="th">Hey you~</VALUE>
    <VALUE Lang="th">Aren't you curious as to why those animals become like that?</VALUE>
    <VALUE Lang="th">Previously when we investigated, there were some strange genes in the body of those animals and I am really curious.</VALUE>
    <VALUE Lang="th">Could you please help me in collecting them?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_13_0">
    <VALUE Lang="th">Thank you~!</VALUE>
    <VALUE Lang="th">I need to investigate this to find out the trace of mutation.</VALUE>
    <VALUE Lang="th">I will need your assistance again in the near future~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_2_0">
    <VALUE Lang="th">If you wish to hire magical animals, you first must master the animal magic. Have you learned it before?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_2_0_1">
    <VALUE Lang="th">Yes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_2_0_2">
    <VALUE Lang="th">No</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_3_0">
    <VALUE Lang="th">Ah,unfortunately you haven't learned it. Please come back again when you have learned it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_4_0">
    <VALUE Lang="th">Although you should know about this since you have mastered it, but I will explain it again.</VALUE>
    <VALUE Lang="th">The hired animal will get stronger as your own stats increase. And you command the animals using skill 1~4. They might act cute sometimes. Now, would you like to</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_4_0_1">
    <VALUE Lang="th">Ask about the Tiger.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_4_0_2">
    <VALUE Lang="th">Ask about the Cat.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_4_0_3">
    <VALUE Lang="th">Ask about the Owl.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_5_0">
    <VALUE Lang="th">The Magician's Tiger</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Order 1. Pull the target towards you for 1.5 seconds , Movement Speed -30%, HP Absorption +10%</VALUE>
    <VALUE Lang="th">Order 2. For 1.5 seconds, Movement Speed -20%, HP Absorption +10%, Skill Range -70</VALUE>
    <VALUE Lang="th">Order 3. For 1.5 seconds quickly approach the target, H</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_5_0_1">
    <VALUE Lang="th">Get the Tiger</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_5_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_6_0">
    <VALUE Lang="th">The Magician's Cat</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Order 1. For 1.5 seconds, every second +100, removes debuff, prevent status abnormalities/ recover</VALUE>
    <VALUE Lang="th">Order 2. For 1.5 seconds, Absorp Physical Damage +10%, Defense +5%, HP+MP+SP Recovery Rate 0.01%</VALUE>
    <VALUE Lang="th">Order 3. For 2 seconds, Attack +15%, Ac</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_6_0_1">
    <VALUE Lang="th">Get the Cat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_6_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_7_0">
    <VALUE Lang="th">The Magician's Owl</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Order 1. For 2 seconds, Defense -10%, Attack Speed -20%, HP Absorption +10%,</VALUE>
    <VALUE Lang="th">Order 2. For 2 seconds, Defense -10%, Skill Delay +10%, HP Absorption +10%</VALUE>
    <VALUE Lang="th">Order 3. For 1.5 seconds, Defense -30%, Accuracy -45, Attack -30%, HP Absorption +1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_7_0_1">
    <VALUE Lang="th">Get the Owl</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_7_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_8_0">
    <VALUE Lang="th">Say…</VALUE>
    <VALUE Lang="th">You are the one who was attacked by those amazing beasts in front, right?</VALUE>
    <VALUE Lang="th">I would like to try to tame them.</VALUE>
    <VALUE Lang="th">Will you help?</VALUE>
    <VALUE Lang="th">Just bring me about 10 of them each please~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_9_0">
    <VALUE Lang="th">It hurts my pride as an animal expert.</VALUE>
    <VALUE Lang="th">But, if they can't be tamed..then I can't do anything.</VALUE>
    <VALUE Lang="th">Please get rid of them as they are very dangerous.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper1.ntk_1_0">
    <VALUE Lang="th">I'm here to give support in students injured. Just tell me if there is anything I can help you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper1.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper1.ntk_1_0_2">
    <VALUE Lang="th">Set as Starting Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper2.ntk_1_0">
    <VALUE Lang="th">Well, it has been a long time since I have last seen a human being.. Just tell me if you need anything.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper2.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_infinitystairs.ntk_1_0">
    <VALUE Lang="th">Prepare your self or you'll regret it</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_infinitystairs.ntk_1_0_1">
    <VALUE Lang="th">Item Sale</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0">
    <VALUE Lang="th">Hey, newbie! Where do you belong?</VALUE>
    <VALUE Lang="th">I will give you a weapon which your circle uses. Tell me where you belong!</VALUE>
    <VALUE Lang="th">Extreme class also can use it. However, weapon would only be provided to a student who reached level 10. After that I will exchange it to a better weapon when you reach level 30, 50 and 70 so, don't forget to come and collect your weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_1">
    <VALUE Lang="th">Greet politely as a new member of Swordsman.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_10">
    <VALUE Lang="th">Ask for a weapon for newbie.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_11">
    <VALUE Lang="th">Greet politely as a new member of Assassin.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_12">
    <VALUE Lang="th">Greet politely as a new member of Magician.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_2">
    <VALUE Lang="th">Greet politely as a new member of Bralwer.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_3">
    <VALUE Lang="th">Greet politely as a new member of Archer.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_4">
    <VALUE Lang="th">Greet politely as a new member of Shaman.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_5">
    <VALUE Lang="th">Greet politely as a new member of Scientist.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_6">
    <VALUE Lang="th">Tell him you are a new member of Extreme Class Swordsman.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_7">
    <VALUE Lang="th">Tell him you are a new member of Extreme Class Brawler.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_8">
    <VALUE Lang="th">Tell him you are a new member of Extreme Class Archer.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_9">
    <VALUE Lang="th">Tell him you are a new member of Extreme Class Shaman.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1">
    <VALUE Lang="th">If you are at Lv. 30 or higher and a new student then I can give you a weapon that would suit you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_1">
    <VALUE Lang="th">I wanna weapon for a Sowrdsman which would suit me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_2">
    <VALUE Lang="th">I wanna weapon for a Brawler which would suit me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_3">
    <VALUE Lang="th">I wanna weapon for a Archer which would suit me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_4">
    <VALUE Lang="th">I wanna weapon for a Shaman which would suit me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_5">
    <VALUE Lang="th">I wanna weapon for a Scientist which would suit me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_6">
    <VALUE Lang="th">I wanna weapon for a Assassin which would suit me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_7">
    <VALUE Lang="th">I wanna weapon for a Magician which would suit me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_2">
    <VALUE Lang="th">Are you a new student?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_2_1">
    <VALUE Lang="th">Listen to his story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_10_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_11_0">
    <VALUE Lang="th">Maximizing the three force in slumber and the power of sorcery that trancends the time and space are the final destination of Shaman training. Everything starts with a staff.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_11_0_1">
    <VALUE Lang="th">Receive a common type 'Staff'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_11_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0">
    <VALUE Lang="th">I can see that you've gotten stronger and will need a new weapon soon. Once you reach Lv. 30, 50 and 70, come back to me to exchange your weapon. Also, you know that it is not possible to exchange while you are equipping it, right?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_1">
    <VALUE Lang="th">Exchange for a Lv. 30 'Staff'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_2">
    <VALUE Lang="th">Exchange for a Lv. 50 'Staff'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_3">
    <VALUE Lang="th">Exchange for a power type spear.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_4">
    <VALUE Lang="th">Exchange for a spirit type staff.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_5">
    <VALUE Lang="th">Exchange for a dex type lance.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_6">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_13_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0">
    <VALUE Lang="th">The reaseon why Scientist group uses gun is to suppress the enemy at instant. What type of weapon do you need?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0_1">
    <VALUE Lang="th">Gun DEX type.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0_2">
    <VALUE Lang="th">Gun Power type.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0_3">
    <VALUE Lang="th">Gun Spirit Type.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0_4">
    <VALUE Lang="th">Back.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0">
    <VALUE Lang="th">I can see that you've gotten stronger and will need a new weapon soon. Once you reach Lv. 30, 50 and 70, come back to me to exchange your weapon. Also, you know that it is not possible to exchange while you are equipping it, right?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_1">
    <VALUE Lang="th">Exchange for a Lv. 30 Dex type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_10">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_2">
    <VALUE Lang="th">Exchange for a Lv. 30 Power type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_3">
    <VALUE Lang="th">Exchange for a Lv. 30 Spirit type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_4">
    <VALUE Lang="th">Exchange for a Lv. 50 Dex type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_5">
    <VALUE Lang="th">Exchange for a Lv. 50 Power type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_6">
    <VALUE Lang="th">Exchange for a Lv. 50 Spirit type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_7">
    <VALUE Lang="th">Exchange for a Lv. 70 Dex type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_8">
    <VALUE Lang="th">Exchange for a Lv. 70 Power type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_9">
    <VALUE Lang="th">Exchange for a Lv. 70 Spirit type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_16_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_17_0">
    <VALUE Lang="th">If you are a new student who has just joined then reach Lv.10 and come back to me for a weapon. However, existing students who doesn't meet the conditions would just better continue their training.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_17_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_18_0">
    <VALUE Lang="th">You haven't reached level 10.</VALUE>
    <VALUE Lang="th">It's a piece of a cake so become level 10 and come back then, I will give you a fine weapon as a gift.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_18_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_19_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_19_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0">
    <VALUE Lang="th">Swordsmanship is a very highly intellectual study which is to train one's body and spirit. Which weapon would you like to use?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_1">
    <VALUE Lang="th">''Sword' Dex Type</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_2">
    <VALUE Lang="th">''Blade' Power Type</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_3">
    <VALUE Lang="th">''Vital Sword' Spirit Type</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_4">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0">
    <VALUE Lang="th">The basic of Assassination is to defeat a target without knowing that he or she already defeated the target. Therefore, it all starts with how to be the expert of training level weapon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_1">
    <VALUE Lang="th">Dex Type "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_2">
    <VALUE Lang="th">Pow Type "Scythe"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_3">
    <VALUE Lang="th">Int Type "Shuriken"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_4">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0">
    <VALUE Lang="th">I can see that you need new weapon now. When you have reached level 30, 50 or 70 come back to me for a weapon. Remember you cannot trade the weapon while you are equipping it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_1">
    <VALUE Lang="th">Exchange for 30 Lv. "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_10">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_2">
    <VALUE Lang="th">Exchange for 30 Lv. "Scythe"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_3">
    <VALUE Lang="th">Exchange for 30 Lv. "Shuriken"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_4">
    <VALUE Lang="th">Exchange for 50 Lv. "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_5">
    <VALUE Lang="th">Exchange for 50 Lv. "Scythe"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_6">
    <VALUE Lang="th">Exchange for 50 Lv. "Shuriken"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_7">
    <VALUE Lang="th">Exchange for 70 Lv. "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_8">
    <VALUE Lang="th">Exchange for 70 Lv. "Scythe"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_9">
    <VALUE Lang="th">Exchange for 70 Lv. "Shuriken"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_22_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0">
    <VALUE Lang="th">Magician defeat enemies using their quick hand motion or some tricks. Which weapon do you want?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_1">
    <VALUE Lang="th">Trick Magician "Cube"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_2">
    <VALUE Lang="th">Taming Magician "Whip"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_3">
    <VALUE Lang="th">Illusion Magician "Magic Wand"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_4">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0">
    <VALUE Lang="th">When you reached level 30, 50 or 70, come to me again so I can change your weapon with stronger one. However do not forget to unequip it first before talk to me. ^__^</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_1">
    <VALUE Lang="th">Trade to Level 30 Cube</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_10">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_2">
    <VALUE Lang="th">Trade to Level 30 Whip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_3">
    <VALUE Lang="th">Trade to Level 30 Magic Wand</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_4">
    <VALUE Lang="th">Trade to Level 50 Cube</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_5">
    <VALUE Lang="th">Trade to Level 50 Whip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_6">
    <VALUE Lang="th">Trade to Level 50 Magic Wand</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_7">
    <VALUE Lang="th">Trade to Level 70 Cube</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_8">
    <VALUE Lang="th">Trade to Level 70 Whip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_9">
    <VALUE Lang="th">Trade to Level 70 Magic Wand</VALUE>
