  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_29_0_3"><VALUE Lang="tw">兌換 煙幕（127級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE><VALUE Lang="id">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE><VALUE Lang="cn">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE><VALUE Lang="th">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_29_0_4">
    <VALUE Lang="th">Learn Titan's Force</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_29_0_6">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_3_0">
    <VALUE Lang="th">Assassin is a club learning the skills to outreach the limit of human with the power of Solidified Stone and the ancient martial arts to win in a fight in any given condition!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_3_1">
    <VALUE Lang="th">There are tons to learn so don't rush it! Come back after you take care of the things in the campus.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_3_1_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_30_0">
    <VALUE Lang="th">Oh! You have a Spiritual Sphere. Exchange it with desired Skill Scroll.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_30_0_1"><VALUE Lang="tw">兌換 黑洞（147級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="id">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="cn">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="th">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_30_0_2"><VALUE Lang="tw">兌換 迷醉（147級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="id">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="cn">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="th">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_30_0_3"><VALUE Lang="tw">兌換 火焰傳送（137級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Fireport (Lv137, Class=12288, Item=362/55)</VALUE><VALUE Lang="id">Skill book: Fireport (Lv137, Class=12288, Item=362/55)</VALUE><VALUE Lang="cn">Skill book: Fireport (Lv137, Class=12288, Item=362/55)</VALUE><VALUE Lang="th">Skill book: Fireport (Lv137, Class=12288, Item=362/55)</VALUE></SENTENSE>
