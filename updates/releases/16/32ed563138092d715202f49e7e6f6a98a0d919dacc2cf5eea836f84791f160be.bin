  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_11_0">
    <VALUE Lang="th">Why haven't you finished the student registration?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Are the college services not operating properly?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Submit your registration form to the Welfare Society, and then take it to the School Administration Office. The Student Director will then process your Exit Approval Form.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_12_0">
    <VALUE Lang="th">I've found out that quests are very difficult at first. But now... It's really hard for me to finish them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_12_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_13_0">
    <VALUE Lang="th">Hmm? Your registration is almost done.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The next procedure is to request for Exit Approval.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now, there's something you need to do before you submit your registration form.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_14_0">
    <VALUE Lang="th">Just give the registration form to the Student Director at the School Administration Office, and then you may go outside.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hand it to him if you're finished.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_14_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
