  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_27_0">
    <VALUE Lang="th">If you have Spirit Spheres, you are somehow qualified. Now, which skill do you want?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_27_0_1">
    <VALUE Lang="th">Gold Rush</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_27_0_2">
    <VALUE Lang="th">Order: Step 4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_27_0_3">
