  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0">
    <VALUE Lang="th">The ecosystem is being destroyed~!</VALUE>
    <VALUE Lang="th">Something must be done, Immediately~!</VALUE>
    <VALUE Lang="th">This is a big problem ~!</VALUE>
    <VALUE Lang="th">(Crank Crank)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0_1">
    <VALUE Lang="th">What's going on in our planet? Can you tell me what's happening?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0_2">
    <VALUE Lang="th">Submit the Red Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0_3">
    <VALUE Lang="th">Submit the Green Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0_4">
    <VALUE Lang="th">Submit the Yellow Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_2_0">
    <VALUE Lang="th">Basura, the alien is trying to destroy mother earth~!</VALUE>
    <VALUE Lang="th">Eliminate the monster and collect the colored trashes~!</VALUE>
    <VALUE Lang="th">Collect 30 of each colored trash and return to me for rewards~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_3_0">
    <VALUE Lang="th">Have you collected all 30 of Red Trashes?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_3_0_1">
    <VALUE Lang="th">Recycle the collected red trash for a Red Gift Box reward</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_3_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_4_0">
    <VALUE Lang="th">Have you collected all 30 of Green Trashes?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_4_0_1">
    <VALUE Lang="th">Recycle the collected green trash for a Green Gift Box reward</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_4_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_5_0">
    <VALUE Lang="th">Have you collected all 30 of Yellow Trashes?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_5_0_1">
    <VALUE Lang="th">Recycle the collected yellow trash for a Yellow Gift Box reward</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_5_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_0">
    <VALUE Lang="th">Do you have both the Christmas Stockings and Tickets?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_0_1">
    <VALUE Lang="th">Yes.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_0_2">
    <VALUE Lang="th">No.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_1">
    <VALUE Lang="th">Do you have the Christmas Stockings?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_1_1">
    <VALUE Lang="th">Yes.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_1_2">
    <VALUE Lang="th">No.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_2">
    <VALUE Lang="th">Do you have the Christmas Tickets?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_2_1">
    <VALUE Lang="th">Yes.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_2_2">
    <VALUE Lang="th">No.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_3">
    <VALUE Lang="th">Gee. This is a big problem. What should I do now?</VALUE>
    <VALUE Lang="th">Could you please help me out?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_3_1">
    <VALUE Lang="th">Ask Santa what is going on</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_2_0">
    <VALUE Lang="th">Bad Rudolf, he was grumbling about his work hours and at last, he has disappeared with all the presents.</VALUE>
    <VALUE Lang="th">How can I find him alone in this huge town. If you could help me finding him, I will give you a present as a token of my gratitude.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_3_0">
    <VALUE Lang="th">I will give you the present, if you have 20 Christmas Stockings and Tickets each.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_3_0_1">
    <VALUE Lang="th">Please give me the present</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_3_0_2">
    <VALUE Lang="th">Maybe, next time</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_4_0">
    <VALUE Lang="th">I will give you the present, if you have 20 Christmas Stockings.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_4_0_1">
    <VALUE Lang="th">Please give me the present</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_4_0_2">
    <VALUE Lang="th">Maybe, next time</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_5_0">
    <VALUE Lang="th">I will give you the present, if you have 20 Christmas Tickets.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_5_0_1">
    <VALUE Lang="th">Please give me the present</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_5_0_2">
    <VALUE Lang="th">Maybe, next time</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0">
    <VALUE Lang="th">This is for you!</VALUE>
    <VALUE Lang="th">Thank you so much for your help. Ho Ho Ho~ Merry Christmas, Everyone!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_1">
    <VALUE Lang="th">Exchange Christmas Stockings and Tickets for a Christmas Hat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_2">
    <VALUE Lang="th">Exchange Christmas Stockings and Tickets for a Christmas Hat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_3">
    <VALUE Lang="th">Exchange Christmas Stockings for a Santa Costume</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_4">
    <VALUE Lang="th">Exchange Christmas Stockings for a Santa Costume</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_5">
    <VALUE Lang="th">Exchange Christmas Tickets for a Santa's Shoes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_6">
    <VALUE Lang="th">Exchange Christmas Tickets for a Santa's Shoes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_7_0">
    <VALUE Lang="th">Liar!! You will never receive a present for lying to Santa.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_8_0">
    <VALUE Lang="th">I have to go deliver all the presents tonight, so please hurry up!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0">
    <VALUE Lang="th">Hello.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_1">
    <VALUE Lang="th">Show the Stone</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_10">
    <VALUE Lang="th">Give Trails of Person You're Looking For</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_11">
    <VALUE Lang="th">Give Trails of Person You're Looking For</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_12">
    <VALUE Lang="th">Give Trails of Person You're Looking For</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_13">
    <VALUE Lang="th">Show Blueprint</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_14">
    <VALUE Lang="th">Deliver the Action Guide</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_15">
    <VALUE Lang="th">Give the Withdrawal Weapons</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_16">
    <VALUE Lang="th">Start "Collect a Bead"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_17">
    <VALUE Lang="th">Give Collected Beads</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_18">
    <VALUE Lang="th">Start Deliver the News</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_19">
    <VALUE Lang="th">Start Deliver the News</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_2">
    <VALUE Lang="th">Ask What's the Matter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_20">
    <VALUE Lang="th">Ask about the status of Middle Hole</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_3">
    <VALUE Lang="th">Give the Weapons</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_4">
    <VALUE Lang="th">Give the Weapons</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_5">
    <VALUE Lang="th">Give the Weapons</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_6">
    <VALUE Lang="th">Give the Weapons</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_7">
    <VALUE Lang="th">Give the Weapons</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_8">
    <VALUE Lang="th">Give Trails of Person You're Looking For</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_9">
    <VALUE Lang="th">Give Trails of Person You're Looking For</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_10_0">
    <VALUE Lang="th">Then I have something to ask of you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I have no idea whether there are people who are injured or are in need of help like my friend.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help check the situation nearby?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_11_0">
    <VALUE Lang="th">Hmm, furthermore, even the Trading Hole Police Station is reporting the current bad situation…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I am not even sure whether this is true or not.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_12_0">
    <VALUE Lang="th">Oh what's this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What..?! Oh my goodness... How did you get this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is the weapon blueprint that uses a human body. Permanent rechargeable bullet shell and self-recoverable armor... Who the hell even considered this?!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_12_0_1">
    <VALUE Lang="th">Ask for More Details</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_13_0">
    <VALUE Lang="th">The weird laboratory in underground prison... And the blueprint of Leonine campus!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I heard some rumors about that laboratory. Is the company really doing this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_14_0">
    <VALUE Lang="th">Thank you very much... I will check it out.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway... I cannot believe there is a book that can help us in this weird situation. Is there a good fortune teller that you know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_14_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_15_0">
    <VALUE Lang="th">Oh, that's a lot…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How did you bring all of this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can leave that to us. We already heard about your story, and we'll bring this stuff to the police office.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_15_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_16_0">
    <VALUE Lang="th">I need some beads to create and fix weapons. Think you can help me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_16_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_17_0">
    <VALUE Lang="th">Wow, that's a bead, right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Next time, if you have free time, could you collect more beads for me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Haha~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_18_0">
    <VALUE Lang="th">Good luck!!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_19_0">
    <VALUE Lang="th">Are you blind? This is a total mess!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_19_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_2_0">
    <VALUE Lang="th">Ah, it's that stone!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But hasn't it been identified yet?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's called... USS... Something...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I heard that it's like some sort of secret code, but it's only hearsay.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Is this for me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmph. It doesn't look like it'll be much use...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Well, thank you, anyway.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_3_0">
    <VALUE Lang="th">Why did the people come here in a scattered manner?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The shop's weapons are all stolen by these people!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">From what I know, those people aren't real.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_4_0">
    <VALUE Lang="th">Then the snows came, there were earthquakes… It was total chaos in the city!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">My shop was pretty much ruined at that time...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even though what I said was out of anger, I still have to get back my lost weapons.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please, even if it's only some of them, can't they be recovered?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_4_0_1">
    <VALUE Lang="th">Reply</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_4_0_2">
    <VALUE Lang="th">Reply</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_4_0_3">
    <VALUE Lang="th">Reply</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_4_0_4">
    <VALUE Lang="th">Reply</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_4_0_5">
    <VALUE Lang="th">Reply</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_4_0_6">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_5_0">
    <VALUE Lang="th">Honestly speaking, I don't expect them to be found, but we still have to try our best.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_6_0">
    <VALUE Lang="th">Wow, you really helped me find them!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even though it's just some of them, I am still very grateful…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">As long as we have this, it will be easier to rebuild our shop…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If we do this... And do that…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_7_0">
    <VALUE Lang="th">There are some friends that I'm waiting for, but I am afraid that they might have been victims of an earthquake.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Pardon me, but can you help me find them?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Though I have no idea when they will come back, I'll still wait for them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If my friend returns, we can hear more details about the stones.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">About last time at some Financial Group building…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_8_0">
    <VALUE Lang="th">Oh, you're here!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm, what have you found?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ahhhh ~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I think I've been overly optimistic.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">At the city's current state, it's a mistake to hope for my friend to just mind his own business...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_8_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_9_0">
    <VALUE Lang="th">That is your friend's item, isn't it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even though it's said to be stolen everywhere, but it's still strange...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_9_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_1_0">
    <VALUE Lang="th">It's very dangerous here!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_1_0_1">
    <VALUE Lang="th">Change Save Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_1_0_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_1_0_4">
    <VALUE Lang="th">Ask about Related Problem</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_1_0_5">
    <VALUE Lang="th">Give Him the Key</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_1_0_6">
    <VALUE Lang="th">Deliver the Action Guide</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_1_0_7">
    <VALUE Lang="th">Ask about the status of Middle Hole</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_1_0_8">
    <VALUE Lang="th">Ask if he is in a trouble</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_1_0_9">
    <VALUE Lang="th">Hand over the things found</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_2_0">
    <VALUE Lang="th">Ah… Yes, the situation here is getting worse.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They assigned me to come here, and I brought a lot a medicine, but the wild dogs here nearly tore me apart.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_2_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_3_0">
    <VALUE Lang="th">I'd be dead if students like you weren't there to save me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hm, I'm sorry, but those mad dogs stole my key. Do you think you can get it back?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_3_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_3_0_2">
    <VALUE Lang="th">Decline</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_4_0">
    <VALUE Lang="th">Oh, really?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much. I'm sure you'll find it if you hunt down those dogs that are almost as big as wolves.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Be careful~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_5_0">
    <VALUE Lang="th">You get hurt?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_5_0_1">
    <VALUE Lang="th">Heal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_6_0">
    <VALUE Lang="th">Even this place...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I already have the guideline, so it'd be really helpful in an emergency case.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_6_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_7_0">
    <VALUE Lang="th">As you can see, things are getting worse. I am so worried! Something big will happen, if this keeps up.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_7_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_8_0">
    <VALUE Lang="th">We have received so many paticients after the phenomenon but there is not enough medicines to cure them all. They could be cureed instantly with proper medincine but.. It is really hard to see them suffer.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_8_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_9_0">
    <VALUE Lang="th">Thank you! Because of you we can save so many lives.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_medic.ntk_9_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0">
    <VALUE Lang="th">In this space where time stops, not even wind exists.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_1">
    <VALUE Lang="th">Listen to Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_10">
    <VALUE Lang="th">The ring will be upgraded one step further.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_11">
    <VALUE Lang="th">Ask about Sacred Financial Group Background</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_12">
    <VALUE Lang="th">Ask how to Enter Main Office</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_13">
    <VALUE Lang="th">Listen to Advice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_14">
    <VALUE Lang="th">Show the Eight Signs of Divine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_15">
    <VALUE Lang="th">Exchange Janaohu Ganil with new ring</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_16">
    <VALUE Lang="th">Exchange Iron Fist Ganil with new ring</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_17">
    <VALUE Lang="th">Exchange Black Knife Ganil with new ring</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_2">
    <VALUE Lang="th">Show Authentication Certificate</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_3">
    <VALUE Lang="th">Ask about Business</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_5">
    <VALUE Lang="th">Listen to Advice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_6">
    <VALUE Lang="th">Listen to Advice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_7">
    <VALUE Lang="th">Listen to Advice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_8">
    <VALUE Lang="th">Deliver Material</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_1_0_9">
    <VALUE Lang="th">The ring will be upgraded one step further.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_10_0">
    <VALUE Lang="th">Hmmm?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why are you waiting for this old man?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">When you strangely respect the other person, there definitely must be a motive, right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Though he would like to escape this dangerous place, it's impossible with a body that's so weak.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_11_0">
    <VALUE Lang="th">Let's say, will you naturally understand it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">On this broken road, a soft piece of paper is floating.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If that is the case, then time in this place hasn't completely stopped…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The knowledge the students have acquired…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They haven't been improving?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I feel that not trying to understand is a good thing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmmph, it seems that it's understandable</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This stoppage of time is a natural defense mechanism</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Financial Group Main construction company will play out their role, and then…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_12_0">
    <VALUE Lang="th">Haha, that is because I'm here.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That woman trusts students there, and gives presents.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_12_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_13_0">
    <VALUE Lang="th">If that's the case, the old man used to be one.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">At that time, they connect with another world, even though that's not the case</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now, those same scumbags seem like they're everywhere.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Financial Group's youngsters see this as a sign of cloning.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Simply said, the people cannot be identified as individuals anymore.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_13_0_1">
    <VALUE Lang="th">Listen to Advice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_14_0">
    <VALUE Lang="th">Don't you want to give any advice?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I feel like sharing a bit of information…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm, where should I start?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I want to see the student's true colors.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The colors which existed in a totally different world a long time ago.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know whether those colors are a good thing</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why must they fight the monsters, no matter what?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_14_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_15_0">
    <VALUE Lang="th">Have you thought about it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Though it's said to be done to survive, but half of the answers to that question are wrong.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Indirectly controlling whatever sense of responsibility that is left…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Or perhaps it's the result of denying oneself of responsibility.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Right</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_15_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_16_0">
    <VALUE Lang="th">From a spectator's viewpoint, the opportunity for battle between light and darkness can be seen. That happens in this kind of situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What do you think?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Financial Group creates these opportunities for the students as a sign of gratitude?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If not, it's like a snake ready to pounce, isn't it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Heh heh...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thinking about it, it's pretty interesting.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_16_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0">
    <VALUE Lang="th">It will enable the students to become stronger and express the peak of their powers. As long as you keep trying hard, even if you don't self-improve for a while, your efforts will pay off in the end.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Well, do you want me to tell you what the secret to success is?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0_1">
    <VALUE Lang="th">Understand the Method of Passing</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0_2">
    <VALUE Lang="th">Understand the Method of Passing</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0_3">
    <VALUE Lang="th">Understand the Method of Passing</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_18_0">
    <VALUE Lang="th">If you want to change your level, then suitable items must be used.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Helping this old man is something that's worthwhile, even if it takes you a while to figure out what he's talking about.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you understand this concept?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_18_0_1">
    <VALUE Lang="th">Understand the Method of Passing</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_19_0">
    <VALUE Lang="th">The solid Ring will produce these kinds of results.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It is a tool that causes body function to quick when it is used to hit a certain number of times.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Of course it will only work for a certain period of time. You can't boost the body indefinitely.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This weapon is created according to each individual's specialty, and you may see the results of the change.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">In other words ... The proper information is gathered from the students in order to create suitable weapons for them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_19_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0">
    <VALUE Lang="th">What do you want to tell this old man?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_1">
    <VALUE Lang="th">Ask about Students Passing By</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_2">
    <VALUE Lang="th">Ask about Sacred Gate Financial Group HQ</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_3">
    <VALUE Lang="th">Ask about the Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_4">
    <VALUE Lang="th">Solemnly Give Regards</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_5">
    <VALUE Lang="th">Ask about Neighborhood</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_20_0">
    <VALUE Lang="th">Sorry to trouble you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But this process must be immaculately performed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It can't be completed with just these ingredients.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah, here's some.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Try and use them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Also, some changes may be made in the Ring.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If the Director's power increases, then we will grow together with him according to his way</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The search must be done at the right time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_20_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_21_0">
    <VALUE Lang="th">I accidentally discovered this precious tidbit of information …</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I heard not long ago that if a little change was made on the student's made Ring, a better Ring will be formed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_21_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_21_0_2">
    <VALUE Lang="th">Decline</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_22_0">
    <VALUE Lang="th">I happen to have some precious ingredients.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you students add some of these ingredients, you may make a better Ring.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_22_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_22_0_2">
    <VALUE Lang="th">Decline</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_23_0">
    <VALUE Lang="th">Just broken!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I guess it's better than you see it like this. You students can use all the experience you can get.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_23_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_24_0">
    <VALUE Lang="th">Hm…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm not just an old man. Let me guess. You're dying to know about the Sacred Financial Group.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Although I don't know much about that company, most people praise that company's achievements.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_24_0_1">
    <VALUE Lang="th">Ask about Company Achievement</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_25_0">
    <VALUE Lang="th">Is he a folk shaman scholar? The one who established the company...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">He was made quite an impression when he started the company, loudly claiming to unify all the schools in the world, and to provide free tuition to gifted students.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_25_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_26_0">
    <VALUE Lang="th">He provided financial support to students and families, remodeled the buildings in this area, and was aggressive in promoting and enacting community service.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_26_0_1">
    <VALUE Lang="th">Ask What He Noticed</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_27_0">
    <VALUE Lang="th">I think most people in this town don’t know about it very well.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah, right! You ever see a person wear a black suit in front of Leonine Campus?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">He would know about it very well since he is an employee of that company.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_27_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_28_0">
    <VALUE Lang="th">This building is very different from the others in terms of security.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I remember that there are two major security systems. The one is the security code under skin, which human eyes cannot see. The other is voice recognition. You can't enter the building without passing both of those security systems.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_28_0_1">
    <VALUE Lang="th">Ask for More Details</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_29_0">
    <VALUE Lang="th">Haha, I don't know the details since I'm not an employee.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Maybe there's another security system.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah. I just remembered something for you. You can find an old man like me at the Wharf passage.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Go there and ask him about it</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_29_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_3_0">
    <VALUE Lang="th">Students? Yeah, I saw some…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's interesting!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">During the break, they came to attend to some business of theirs.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If that's the case, time should have been combined!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I think I've miscalculated…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_30_0">
    <VALUE Lang="th">The security system isn't so secure…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can easily get inside this building.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm so worried about it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But I am more concerned about the fact that you have to enter this building.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I got the message from the student who already entered here. He said that he will wait for incoming students on the 1st floor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Just go to the building main door. The security process will be done automatically. You may use the Information Terminal to read the research documents.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_30_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_31_0">
    <VALUE Lang="th">I've had a bad feeling of foreboding for quite some time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This eight signs of divine… I don't think they belong to this world. Surely it's the key that opens the way to another world. So you want to use this? The divine needs blood. Maybe special blood.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can probably get it at the top of this building.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway be careful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_31_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_4_0">
    <VALUE Lang="th">The students do not even know where their colleges are.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Want about the Financial Group's background?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Simply said, the founding of the Sacred Financial Group was originally meant to disrupt the World's balance.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yeap, that's their original motive.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_4_0_1">
    <VALUE Lang="th">Ask about the Sacred Gate Financial Group</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_5_0">
    <VALUE Lang="th">The students are stubborn.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't like their behavior. They act with no regrets at all.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not a single day goes by without something happening.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_5_0_1">
    <VALUE Lang="th">Ask about Sacred Gate Financial Group HQ Building</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_6_0">
    <VALUE Lang="th">Should I ignore the old man's advice?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They do not seem different from the other students.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You mean you want to check out this building?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">As of this moment, there isn't a solution, as to what seems to be the problem.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I do not know what might happen.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Nor do I know how to solve it, nor how to teach.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_7_0">
    <VALUE Lang="th">Standing here doing nothing, that's a bit strange.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How did he come here?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How is he not damaged?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Students…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You got to introduce yourself before you ask questions from your elders. You can't expect manners without using basic manners. It's about respect.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_7_0_1">
    <VALUE Lang="th">Rebut the Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_8_0">
    <VALUE Lang="th">You guys are really hot-blooded students…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Easily pumped up.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This will only worry people…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Next time when you have an opponent to fight, no matter how big he is, never lose your head.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Your mind will definitely get you the win when everything else fails.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You students must learn how to control your emotions.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_9_0">
    <VALUE Lang="th">Even though there were a few people who passed by this old man…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There was only one student who cared for my body…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Though I know not of his true intentions...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The important thing was his expression.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm, I have no need to worry.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The air here is definitely better than anywhere else.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Due to the break.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_9_0_1">
    <VALUE Lang="th">Ask about the Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_9_0_2">
    <VALUE Lang="th">Ask about the Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_9_0_3">
    <VALUE Lang="th">Ask about the Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0">
    <VALUE Lang="th">What's the matter?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_1">
    <VALUE Lang="th">Change Save Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_10">
    <VALUE Lang="th">Listen to the mission content</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_11">
    <VALUE Lang="th">Submit the special sphere</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_12">
    <VALUE Lang="th">Police's Call</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_13">
    <VALUE Lang="th">Police's Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_2">
    <VALUE Lang="th">Ask about the Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_3">
    <VALUE Lang="th">Ask about the Main Hole</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_4">
    <VALUE Lang="th">Discuss the Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_5">
    <VALUE Lang="th">Show Weather Info</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_6">
    <VALUE Lang="th">Ask about Weather</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_7">
    <VALUE Lang="th">Open Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_8">
    <VALUE Lang="th">Deliver Retrieved Fireworks</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_9">
    <VALUE Lang="th">Ask about Fire Accident</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_10_0">
    <VALUE Lang="th">Fires occur frequently in this zone.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The main reason is fireworks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please find and collect fireworks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_10_0_1">
    <VALUE Lang="th">Start "Collect Fireworks"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_10_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_11_0">
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Good luck!!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_12_0">
    <VALUE Lang="th">I want to make the sphere comparison, Bakulaw may have the special sphere. Please get the special sphere from Bakulaw.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_13_0">
    <VALUE Lang="th">This is the clone. We need to do further the investigation. Here is the sphere for you as the reward.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_14_0">
    <VALUE Lang="th">I'm glad you are coming. I just want to help you earn new power. Pass my exam and you'll get sphere to learn the new power.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_14_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_15_0">
    <VALUE Lang="th">Eliminate Haring Braso in Root Hole</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_15_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_2_0">
    <VALUE Lang="th">I don't know what to say...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's not the top of the mountain, but ...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The time is a condition that stops. Even if something has changed in a big way, it will not show here. Is that lucky or unfortunate? ...Oh, please have a look around.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_3_0">
    <VALUE Lang="th">People feel fearless when they're here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You don't age when time stops moving.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You never get hungry if you're already full.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, your injuries won't heal, but…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah, is there anything you don't know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Well, if time stops here, I guess not.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_4_0">
    <VALUE Lang="th">During the time it happened, it didn't work.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You will understand it better if you take a look yourself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Main Hole has the Sacred Financial Group main office. There are a lot of interesting facilities, but there's a little sense of regret in the air..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_5_0">
    <VALUE Lang="th">The air is fresh.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Though I can never find the results...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It can be sent to the lab from the communication facility here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't think that any clues can be found.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We must investigate.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_5_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_6_0">
    <VALUE Lang="th">Ah, can you help figure out what's happening at the Sacred Financial Group?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not long ago, a very loud explosion sound was heard after a student went into the Head Office building.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm worried and want to have a look, but I'll drop all communication if I leave my post.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me out please?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_7_0">
    <VALUE Lang="th">I heard that if you are lucky, you will get the results.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is in addition to finding more clues.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_8_0">
    <VALUE Lang="th">I feel that a more thorough investigation should be done.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There isn't enough manpower or place to do it…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That's how I feel…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The air here doesn't flow smoothly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That stifling feeling gets more intense as we head nearer to the Main Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I am not sure whether it's because of the nearby fire, but it feels like it has always been this bad.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I still suspect that ongoing fire.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_9_0">
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">These fireworks need to be kept safe.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You already know about the many accidents at Middle Hole and Root Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I know that we can't stop fireworks from going around.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But promoting fire awareness and safety is always a good idea. It's even better to follow those ideas too.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_0">
    <VALUE Lang="th">Thank you very much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_0_2">
    <VALUE Lang="th">Talk about Copy Spirit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_1">
    <VALUE Lang="th">Welcome.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Although I'm in no situation to welcome someone, I'm glad that you are here. Now I can ask you for help, yes?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_1_1">
    <VALUE Lang="th">Ask about Favor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_1_2">
    <VALUE Lang="th">Ask about Favor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_1_3">
    <VALUE Lang="th">Talk about Copy Spirit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_10_0">
    <VALUE Lang="th">And the foundation of great geometry theory was completed. Unfortunately, before this theory had been completed, there were already lots of experiments with its branched theory.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The one of them is D Engine which was developed for airplanes. It can compress time and space and reduce the travel time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The prototype had no problem but at the last testing of manufactured engine, the whole airplane suddenly vanished.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_10_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_11_0">
    <VALUE Lang="th">All the other projects were canceled because of that accident. All information was treated as confidential.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Then, all the following research and work was conducting on an unofficial basis.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even though we were working in the shows, we worked with passion. We were going to discover something new.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It was unofficial, but because of my report on the truth behind the meteor fall, I could establish the Sacred Financial Group.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_11_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_12_0">
    <VALUE Lang="th">At first, I was preparing the military base but I realized that people on the list were too young. So to make them more comfortable, I changed the plan from a military base to a school campus, and had to add a regular education curriculum too. I had another reason to make these campuses.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_12_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_13_0">
    <VALUE Lang="th">Because of my title as Director of Campus, I overused my authorities. Maybe that's just my excuse.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I believed that they were too young to overcome this incident by themselves...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_13_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_14_0">
    <VALUE Lang="th">There are two suns in the sky, although we cannot see the other one right now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">And two suns provide enough sunshine, warm temperature, and an overall good environment.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But the other side of earth does not receive these benefits.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_14_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_15_0">
    <VALUE Lang="th">Oh, I used the term “Earth.” Is it too weird that it's got the same name as the real world in which you live?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_15_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_16_0">
    <VALUE Lang="th">Although this world was ruined by war…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">And yes, this is also Earth.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_16_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_17_0">
    <VALUE Lang="th">After I established SFG and prepared all school campuses, I found out that the other world is actually this place “Earth” in the future.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It was not good timing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We were not yet prepared completely, and the results were unexpected.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We were able to know the history of another world.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_17_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_18_0">
    <VALUE Lang="th">As you know about the other world, there is the Daramai race that lived without sun, and realized their unfair situation and isolation in another world.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_18_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_19_0">
    <VALUE Lang="th">The Ragia refuses to share the sunshine.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Ragia even tried to obliterate Daramai race when they asked to share the sun. Ragia consider Daramai as an abandoned race.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That's why there is the war between Light and Dark. It results in this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_19_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_2_0">
    <VALUE Lang="th">It's probably not a hard task.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's just a simple treasure hunt compared to your past labors.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm sorry, though, it won't be fun.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's my copy spirit. I can't easily get close to him. It looks like he is staying away from me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You just need to check where he is and what he looks like.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_20_0">
    <VALUE Lang="th">But…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I discovered that the Daramai base was placed in the same location as the SFG Head Office.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes, the Daramai was trapped inside the Sacred Gate Area with special field, and fought in our own future.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_20_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_21_0">
    <VALUE Lang="th">The Ragia Council simply doesn't change its mind.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even they abused the power they accumulated to save the world, and it is impossible to selfishly hold on to all the benefits of abundant resources forever. Not at the cost of another race…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So if I cannot change history, then I want to lead the war for ourselves.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">With the knowledge of another world, my preparation, and your power, I want to make the future better.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_21_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_22_0">
    <VALUE Lang="th">So I removed the Leonine barrier and started to make living bio-weapons...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I found I couldn't control myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I was just driven to develop new and better living-bio-weapons without knowing the purpose, the direction and effects.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_22_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_23_0">
    <VALUE Lang="th">Now I can see how selfish I was, and what I've done...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I think you're the only hope now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_23_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_24_0">
    <VALUE Lang="th">You're correct.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You want it too, right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You saw one in my room like me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That's correct too.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm also real.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">He and I both think, "I'm real."</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you believe me, then won't you help me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_24_0_1">
    <VALUE Lang="th">Ask about Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_3_0">
    <VALUE Lang="th">Ah... That place...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">With that body...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Perhaps... It was a good decision not to go near him.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I might vanish!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Then two worlds will be rendered asunder in explosive chaos.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0">
    <VALUE Lang="th">Is there something else I need to tell you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0_1">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0_2">
    <VALUE Lang="th">Ask about the SFG</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0_3">
    <VALUE Lang="th">Ask about the Campuses</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0_4">
    <VALUE Lang="th">Ask about Another World</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_5_0">
    <VALUE Lang="th">Well, it's just a list of names of people that are related somehow to the strange incidents.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The problem was…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We pushed ourselves to gather too many people on that long list.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_5_0_1">
    <VALUE Lang="th">Ask about Students that were Hurt</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_6_0">
    <VALUE Lang="th">Of course I knew.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I was the one who controls it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The truth is…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They weren't cooperating with me in the first place.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We had no more time to waste, and only few of them accepted our offers.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_6_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_7_0">
    <VALUE Lang="th">I didn't want to be a hero…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Maybe I'd rather be a hero because it means I should recognize the rights of all people.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't want to do it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It is okay as long as the world is not destroyed and people are living regardless of sacrifice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_7_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_8_0">
    <VALUE Lang="th">Eventually I won't bother with blame or hatred from people because there are some that can easily change world history.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I even didn't feel sorry or guilty.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_9_0">
    <VALUE Lang="th">18 years ago, I joined the meteor fall investigation team. At that time, I thought it is just a regular natural phenomenon.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Who would have thought that it'd turn our world of science upside-down?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Since we couldn't progress with the investigation, the team was disbanded. 1 year after first investigation, the team was reorganized... Then I found it…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The crack between time and space…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_9_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_1_0">
    <VALUE Lang="th">…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_1_0_2">
    <VALUE Lang="th">Give Enrollment Form</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_1_0_3">
    <VALUE Lang="th">Ask about Damage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_1_0_4">
    <VALUE Lang="th">Deliver the New Suit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_1_0_5">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_1_0_6">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_2_0">
    <VALUE Lang="th">Thanks~ The guy who processed my document said that it disappeared. Then he vanished too, and now I can't do anything until I find those forms… Anyway, thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_2_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_3_0">
    <VALUE Lang="th">It's okay… I just took a bit of a beating… But I'll be fine. I probably need to train a bit more to catch up with my classmates.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_4_0">
    <VALUE Lang="th">Oh, thanks! This stuff might really be useful to me! Hey, now I've got a fighting chance of keeping up with my classmates.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_4_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_5_0">
    <VALUE Lang="th">Why can't we bring cars to school?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I've got a license, a car I paid with my own money.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now I've got to park well outside campus… Ugh…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_5_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_6_0">
    <VALUE Lang="th">My friend told me that he'd find my document for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I'm waiting for him now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm, but he's still not here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me find that document?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_6_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_6_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_7_0">
    <VALUE Lang="th">They don't like me... Maybe because of my scores?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll need to study more than they do.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you think you can teach me how to learn things better and more quickly?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_7_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_7_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_8_0">
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They'll find me if they come back here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I guess all I can do for now is just wait.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_9_0">
    <VALUE Lang="th">I'll study here by myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_9_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_1_0">
    <VALUE Lang="th">Aw...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_1_0_1">
    <VALUE Lang="th">What happened?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_1_0_2">
    <VALUE Lang="th">Confirm</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_1_0_3">
    <VALUE Lang="th">Give Medical Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_1_0_4">
    <VALUE Lang="th">Ask about the status of Middle Hole.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_2_0">
    <VALUE Lang="th">I found my leg stuck here when I woke up. It's lucky that this bus here blocked the wind and the rain.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can't remember much before I got knocked out.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes... I think I saw 3 people in spacesuits run toward something.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What was that all about?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_2_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_3_0">
    <VALUE Lang="th">Thanks!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm really grateful for your help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It looks like I can survive here for a while.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_4_0">
    <VALUE Lang="th">I might sound weird, but I feel comfortable here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">And I feel like I could remember something if I stayed here for a while.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_4_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_5_0">
    <VALUE Lang="th">I… I don't know… I was in an accident and I don't remember much…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_citywomen1.ntk_5_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_1_0">
    <VALUE Lang="th">This is the Information Search Terminal.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_1_0_1">
    <VALUE Lang="th">Try to Use It</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_1_0_2">
    <VALUE Lang="th">Open Recorded Documents</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_1_0_3">
    <VALUE Lang="th">Insert Part of Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_1_0_4">
    <VALUE Lang="th">Insert Part of Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_1_0_5">
    <VALUE Lang="th">Insert Part of Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_1_0_6">
    <VALUE Lang="th">Insert Part of Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_10_0">
    <VALUE Lang="th">They are seriously grotesque mutated monsters caused by the crossing over of time and space. Usually these creatures are possessed by malignant spirits that can only remember and perform aggressive actions. Both these bodies and spirits were malformed…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_10_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_11_0">
    <VALUE Lang="th">Some of them have either normal spirits or normal bodies, and sometimes they have been duplicated into many bodies. It is possible for there to be several unstable mutant Copy spirits, but there have been no reports of this yet. It is rumored, though, that a copy spirit in a monster body, but a normal spirit nonetheless, will result in that original spirit animating the body of a monster. In other words, you have a potentially friendly monster.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_11_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_12_0">
    <VALUE Lang="th">- List of Saints</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There is a list of the people that has been affected by a spirits from another world and have attained superior potential or ability.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Most people that are directly or indirectly affected by Sacred stones are also included on this list.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_12_0_1">
    <VALUE Lang="th">Open the list.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_13_0">
    <VALUE Lang="th">- Guidian Plan</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is a plan to prevent young people affected by Ragia warrior particles from falling too much under their war-like influence.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Since the real world does not easily understand this surrealistic relationship, the massive meteor fall observed in the Asia area is usually used to describe what happened.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_13_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_14_0">
    <VALUE Lang="th">In other words, the guardian plan is to create the best army using young people imbued with the power of might warriors from the other world.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_14_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_15_0">
    <VALUE Lang="th">- Company History</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">1996. 2. Dr. Choi establishes the world-wide company, Sacred Foundation Group with UN support.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">1996. 10. SFG establishes the world-wide education system for gifted people around the Sacred Gate area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">1997. 10. SFG starts to build 4 main campuses.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">1998. 1. Starts to build a network system around Sacred Gate and the 4 campuses.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">1998. 11. Operation of network system begins.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">2003. 8. SFG, 4 campuses are completed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_15_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_16_0">
    <VALUE Lang="th">!! Data has emergency error.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">!! Can't back to recent backup data.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">!! And but yet, could you want open this data?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_16_0_1">
    <VALUE Lang="th">Open</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_16_0_2">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
