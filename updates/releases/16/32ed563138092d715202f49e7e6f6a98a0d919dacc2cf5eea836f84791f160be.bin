  <SENTENSE Ver="1" Id="npc_1_t_sc.ntk_61_0_4">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_sc.ntk_62_0">
    <VALUE Lang="th">Exchange it for 'Scroll of Air Strike VI'</VALUE>
