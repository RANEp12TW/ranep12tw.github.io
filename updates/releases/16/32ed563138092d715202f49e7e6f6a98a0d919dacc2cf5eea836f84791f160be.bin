  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_sc.ntk_63_0_1">
    <VALUE Lang="th">Exchange it for 'Titan's Mettle'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_sc.ntk_63_0_4"><VALUE Lang="tw">兌換 BMP震波（187級／超能部）</VALUE><VALUE Lang="GS">Skill book: BMP Shockwaver (Lv187, Class=3072, Item=389/87)</VALUE><VALUE Lang="id">Skill book: BMP Shockwaver (Lv187, Class=3072, Item=389/87)</VALUE><VALUE Lang="cn">Skill book: BMP Shockwaver (Lv187, Class=3072, Item=389/87)</VALUE><VALUE Lang="th">Skill book: BMP Shockwaver (Lv187, Class=3072, Item=389/87)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_sc.ntk_63_0_5"><VALUE Lang="tw">兌換 急速衰弱（177級／超能部）</VALUE><VALUE Lang="GS">Skill book: Rapid Debility (Lv177, Class=3072, Item=389/107)</VALUE><VALUE Lang="id">Skill book: Rapid Debility (Lv177, Class=3072, Item=389/107)</VALUE><VALUE Lang="cn">Skill book: Rapid Debility (Lv177, Class=3072, Item=389/107)</VALUE><VALUE Lang="th">Skill book: Rapid Debility (Lv177, Class=3072, Item=389/107)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_sc.ntk_63_0_6"><VALUE Lang="tw">兌換 後門入侵（187級／超能部）</VALUE><VALUE Lang="GS">Skill book: Backdoor Invade (Lv187, Class=3072, Item=389/127)</VALUE><VALUE Lang="id">Skill book: Backdoor Invade (Lv187, Class=3072, Item=389/127)</VALUE><VALUE Lang="cn">Skill book: Backdoor Invade (Lv187, Class=3072, Item=389/127)</VALUE><VALUE Lang="th">Skill book: Backdoor Invade (Lv187, Class=3072, Item=389/127)</VALUE></SENTENSE>
