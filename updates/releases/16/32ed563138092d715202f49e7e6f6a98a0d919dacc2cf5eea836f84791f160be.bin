  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_main_1.ntk_10_0">
    <VALUE Lang="th">체력 : 100</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">공격력 : 8~17</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">방어력 : 0</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">약점 : 걷기만 하므로 공격과 이동을 적절히 사용하면 효과를 볼 수 있습니다</VALUE>
    <VALUE Lang="th">Skip</VALUE>
