    <VALUE Lang="th">Oh! You have a Spiritual Sphere. Exchange it with desired Skill Scroll.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_62_0_1"><VALUE Lang="tw">兌換 戰舞（177級／忍術部）</VALUE><VALUE Lang="GS">Skill book: War Dance (Lv177, Class=12288, Item=362/18)</VALUE><VALUE Lang="id">Skill book: War Dance (Lv177, Class=12288, Item=362/18)</VALUE><VALUE Lang="cn">Skill book: War Dance (Lv177, Class=12288, Item=362/18)</VALUE><VALUE Lang="th">Skill book: War Dance (Lv177, Class=12288, Item=362/18)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_62_0_4"><VALUE Lang="tw">兌換 挑釁（177級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Provocation (Lv177, Class=12288, Item=362/38)</VALUE><VALUE Lang="id">Skill book: Provocation (Lv177, Class=12288, Item=362/38)</VALUE><VALUE Lang="cn">Skill book: Provocation (Lv177, Class=12288, Item=362/38)</VALUE><VALUE Lang="th">Skill book: Provocation (Lv177, Class=12288, Item=362/38)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_62_0_5"><VALUE Lang="tw">兌換 煙霧彈（167級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Smoke Grenade (Lv167, Class=12288, Item=362/58)</VALUE><VALUE Lang="id">Skill book: Smoke Grenade (Lv167, Class=12288, Item=362/58)</VALUE><VALUE Lang="cn">Skill book: Smoke Grenade (Lv167, Class=12288, Item=362/58)</VALUE><VALUE Lang="th">Skill book: Smoke Grenade (Lv167, Class=12288, Item=362/58)</VALUE></SENTENSE>
