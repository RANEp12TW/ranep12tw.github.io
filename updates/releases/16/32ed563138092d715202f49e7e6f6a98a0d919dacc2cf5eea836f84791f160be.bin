  <SENTENSE Ver="1" Id="npc_1_t_sc.ntk_29_0_7"><VALUE Lang="tw">兌換 強力射擊（47級／超能部）</VALUE><VALUE Lang="GS">Skill book: Power Shooting (Lv47, Class=3072, Item=389/122)</VALUE><VALUE Lang="id">Skill book: Power Shooting (Lv47, Class=3072, Item=389/122)</VALUE><VALUE Lang="cn">Skill book: Power Shooting (Lv47, Class=3072, Item=389/122)</VALUE><VALUE Lang="th">Skill book: Power Shooting (Lv47, Class=3072, Item=389/122)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_sc.ntk_3_0">
    <VALUE Lang="th">It overpowers a human brain when the power of solidified stone and the scientific thinking are combined together. If we are too dependable on the weapons then we would better be called a Hunter's Group.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_sc.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_sc.ntk_30_0">
    <VALUE Lang="th">Great, you've got a spiritual sphere, exchange it for a skill scroll of your choice.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_sc.ntk_30_0_1"><VALUE Lang="tw">兌換 腐蝕射擊（157級／超能部）</VALUE><VALUE Lang="GS">Skill book: Corroded (Lv157, Class=3072, Item=389/83)</VALUE><VALUE Lang="id">Skill book: Corroded (Lv157, Class=3072, Item=389/83)</VALUE><VALUE Lang="cn">Skill book: Corroded (Lv157, Class=3072, Item=389/83)</VALUE><VALUE Lang="th">Skill book: Corroded (Lv157, Class=3072, Item=389/83)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_sc.ntk_30_0_2"><VALUE Lang="tw">兌換 洗腦（127級／超能部）</VALUE><VALUE Lang="GS">Skill book: Brain Washing (Lv127, Class=3072, Item=389/103)</VALUE><VALUE Lang="id">Skill book: Brain Washing (Lv127, Class=3072, Item=389/103)</VALUE><VALUE Lang="cn">Skill book: Brain Washing (Lv127, Class=3072, Item=389/103)</VALUE><VALUE Lang="th">Skill book: Brain Washing (Lv127, Class=3072, Item=389/103)</VALUE></SENTENSE>
