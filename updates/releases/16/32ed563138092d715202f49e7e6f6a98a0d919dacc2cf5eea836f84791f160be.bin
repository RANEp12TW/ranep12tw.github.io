  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_28_0_2">
    <VALUE Lang="th">Whipping Artist</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_28_0_3">
    <VALUE Lang="th">Magicknife Illusion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_28_0_4">
    <VALUE Lang="th">Titan's Determination</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_28_0_5">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_3_0">
    <VALUE Lang="th">I know your situation very well, but I cannot take any more risks. I'm sorry, but take this as a consolation.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_4_0">
    <VALUE Lang="th">Take the bus and go to Mystic Peak Lake Shop. Then, eliminate the Stray Dogs.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_5_0">
    <VALUE Lang="th">Go to the MarketPlace. The Assassin Student has the detailed information.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_6_0">
    <VALUE Lang="th">You have to be careful! He is not an easy target.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0">
    <VALUE Lang="th">If you have Spirit Spheres, you are somehow qualified. Now, which skill do you want?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0_1">
    <VALUE Lang="th">Sand Dust</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0_2">
    <VALUE Lang="th">Whipped</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0_3">
    <VALUE Lang="th">Glittering Bees</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_7_0_4">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_8_0">
    <VALUE Lang="th">If you have Spirit Spheres, you are somehow qualified. Now, which skill do you want?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_8_0_1">
    <VALUE Lang="th">Scratch</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_8_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0">
    <VALUE Lang="th">If you have Spirit Spheres, you are somehow qualified. Now, which skill do you want?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_1">
    <VALUE Lang="th">Card Throw</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_2">
    <VALUE Lang="th">Whip Slash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_3">
    <VALUE Lang="th">Swarming Locusts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_4">
    <VALUE Lang="th">Titan's Will</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_trick.ntk_9_0_5">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0">
    <VALUE Lang="th">Hey, there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why do you look so worried?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_1">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_2">
    <VALUE Lang="th">Bus Driver's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_3">
    <VALUE Lang="th">Construction Supervisor's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_4">
    <VALUE Lang="th">Give the Spare Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_5">
    <VALUE Lang="th">Physic Teacher's call</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_10_0">
    <VALUE Lang="th">Excuse me, can you help me acquire the necessary spare parts from the Technical Teacher?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_11_0">
    <VALUE Lang="th">I cannot leave this area because these crazy workers might leave their work stations. I just don't trust them...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_12_0">
    <VALUE Lang="th">.....7</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_13_0">
    <VALUE Lang="th">That's right! These are the spare parts I'm looking for. Thank you very much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This can help our construction project for a while until something breaks down again. I'm keeping my fingers crossed that something like that won't happen...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_14_0">
    <VALUE Lang="th">What's wrong? Why is everyone like this? Everything looks weird around here. Am I in another dimension?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_14_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_2_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_3_0">
    <VALUE Lang="th">The supervisor in charge of this construction project is hiding!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is bad! Our construction deadline is close!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_4_0">
    <VALUE Lang="th">It's troubling to know most of the people at the construction site are acting funny and most of the machinery broke down. There's going to be a delay in the construction work, and the site is just full of turmoil.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_4_0_1">
    <VALUE Lang="th">Ask Who It Is</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_5_0">
    <VALUE Lang="th">Oh, please get rid of those stubborn students! We can't get anything done with them around! We've got enough trouble as it is!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_5_0_1">
    <VALUE Lang="th">Construction Supervisor's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_6_0">
    <VALUE Lang="th">Would you please hear me out? I could use your help.</VALUE>
    <VALUE Lang="th">In order to complete construction by the deadline, we must replace these crazy workers with efficiently working machinery. The problem is that the generator is broken. This just makes things more complicated!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_7_0">
    <VALUE Lang="th">My friend from the Sword Section told me that this is not the only area where strange things started to happen. Now imagine what would happen to our world if this chaos continues and spreads.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_7_0_1">
    <VALUE Lang="th">Physics Teacher's Call</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_8_0">
    <VALUE Lang="th">I'm pretty nervous. I'm expecting news from the Physics Teacher at Sacred Gate College. Please find him! He said he would wait near the Sacred Gate Ring.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_9_0">
    <VALUE Lang="th">.....6</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0">
    <VALUE Lang="th">Ask about "Dragon Boat Event"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_1">
    <VALUE Lang="th">Yes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_2">
    <VALUE Lang="th">Get experience reward</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_3">
    <VALUE Lang="th">Exchange Exorcist Ring(15D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_2_0">
    <VALUE Lang="th">I believe in you, you can make it!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0">
    <VALUE Lang="th">Hello~! Long time to meet outsider in this place~</VALUE>
    <VALUE Lang="th">I do not care how can you reached this place but it will be better if you leave as soon as possible since these guys will not believe it.</VALUE>
    <VALUE Lang="th">By the way, can you help me?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_2">
    <VALUE Lang="th">Miscellaneos Savior</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_3">
    <VALUE Lang="th">Stockholm Syndrome</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_4">
    <VALUE Lang="th">Collect Terrorist's Supply</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_5">
    <VALUE Lang="th">Heavy Destroyer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_6">
    <VALUE Lang="th">Certificate Collector</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_7">
    <VALUE Lang="th">Change the Coupon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_8">
    <VALUE Lang="th">Certificate Collector</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_2_0">
    <VALUE Lang="th">Urrgghh~ My stomach~~ Lately I do not eat anything because keep busy hiding from these guys.</VALUE>
    <VALUE Lang="th">Do you have any food for me? Please try to find some of it for me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_3_0">
    <VALUE Lang="th">I have already spying them for a few days and I find something weird. At the first time, it was normal but slowly their movement is same with Terrorist action.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_4_0">
    <VALUE Lang="th">Each Terrorist has 1 Certificate in their pocket.</VALUE>
    <VALUE Lang="th">I found they will show it when it need as a proof.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_5_0">
    <VALUE Lang="th">Some of the workers there work with pretty heavy duty military border. They drive some big and heavy bulldozer which very scary.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_6_0">
    <VALUE Lang="th">So here is Terrorist Area right?</VALUE>
    <VALUE Lang="th">You are so quick! How do you know I need a gun?</VALUE>
    <VALUE Lang="th">By the way, please collect some coupon for me and I will give you something useful.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert_chainsaw.ntk_1_0">
    <VALUE Lang="th">W-W-Wait a minute!! I do not have any relation with the Terrorist! Wew… If you need something, please let me know so I can help you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert_chainsaw.ntk_1_0_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_10">
    <VALUE Lang="th">Get confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_2">
    <VALUE Lang="th">Ask who she is</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_3">
    <VALUE Lang="th">Ask about Garansanoa's friends</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_4">
    <VALUE Lang="th">Tell her you will stop Lucian.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_5">
    <VALUE Lang="th">I would like to help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_6">
    <VALUE Lang="th">Get confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_7">
    <VALUE Lang="th">Purify the Basement</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_8">
    <VALUE Lang="th">Get confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_9">
    <VALUE Lang="th">I would like to help Priest</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_10_0">
    <VALUE Lang="th">This isn't an easy job. They are stronger than the High Elders so be very carful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_10_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_11_0">
    <VALUE Lang="th">Sister.. Please rest in peace..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_11_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_2_0">
    <VALUE Lang="th">I am one of the Priests who serve Daian</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_3_0">
    <VALUE Lang="th">A guy named Lucian is trying to harm Garansanoa's friend Liz and to take the Adoniechus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_3_0_1">
    <VALUE Lang="th">Ask if there is anybody else</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_4_0">
    <VALUE Lang="th">Well, there is another person called Gainun from Roo Tribe. Not like us, he is the assassin of Roo tribe so be extra careful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_4_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_5_0">
    <VALUE Lang="th">This wouldn't be any of your concern, is it? I am not going to turn down if you would like to help</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_5_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_6_0">
    <VALUE Lang="th">Please go face Hillo</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_6_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_7_0">
    <VALUE Lang="th">Not bad. Would you like to try again?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_7_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_8_0">
    <VALUE Lang="th">Go face Cyclops. He is strong so be careful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_8_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_9_0">
    <VALUE Lang="th">Good. Go purify those who have lost their will.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_9_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_battlefield_helper.ntk_1_0">
    <VALUE Lang="th">How can I help you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_battlefield_helper.ntk_1_0_1">
    <VALUE Lang="th">Item Sale</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0">
    <VALUE Lang="th">This is the Bus Stop.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Once have your Bus Ticket ready, you can use the Bus Service to move to another area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_1">
    <VALUE Lang="th">Ride the Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_10">
    <VALUE Lang="th">Transmit the Documents</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_3">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_4">
    <VALUE Lang="th">Send Out Skill Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_5">
    <VALUE Lang="th">Find the Stolen Dry Ice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_6">
    <VALUE Lang="th">Deliver Emergency Action Guide</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_7">
    <VALUE Lang="th">Investigate Dead Police</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_8">
    <VALUE Lang="th">Action on Spell Defensive Mechanism</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_9">
    <VALUE Lang="th">Action on Spell Defensive Mechanism</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_2_0">
    <VALUE Lang="th">Document Scan is now complete.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you want to send?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_2_0_1">
    <VALUE Lang="th">Send Out Skill Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_3_0">
    <VALUE Lang="th">Processing...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Document has been sent.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_4_0">
    <VALUE Lang="th">Dry ice is very important for storing ice cream, but the dry ice kept in the warehouse has been stolen. It's now your job to find the stolen dry ice.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_5_0">
    <VALUE Lang="th">There are some places where the emergency action guide hasn't been delivered yet. Get the guide books near the book stores and distribute them.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_6_0">
    <VALUE Lang="th">You should obtain the security monitor videotape to report about the dead policeman in the prison.</VALUE>
    <VALUE Lang="th">The prisoners already transferred that videotape somewhere, so try to retrieve the security monitor videotape from the prisoners.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_7_0">
    <VALUE Lang="th">Many students were injured from the spell attacks, and especially large number of students were injured in Root Hole. Retrieve the spell skill document from the Elemental Sorcerer to make defensive mechanism work against the spell attacks.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_8_0">
    <VALUE Lang="th">Completed.</VALUE>
  </SENTENSE>
