  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_1_0_16">
    <VALUE Lang="th">망각의 약에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_1_0_17">
    <VALUE Lang="th">망각의 약 재료를 전달한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_1_0_18">
    <VALUE Lang="th">망각의 약에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_1_0_19">
    <VALUE Lang="th">망각의 약 재료를 전달한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_1_0_2">
    <VALUE Lang="th">Ask to be Healed</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_1_0_20">
    <VALUE Lang="th">Confirm Position</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_1_0_3">
