    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_3_0_6">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_3_0_7">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_3_0_8">
    <VALUE Lang="th">Return</VALUE>
