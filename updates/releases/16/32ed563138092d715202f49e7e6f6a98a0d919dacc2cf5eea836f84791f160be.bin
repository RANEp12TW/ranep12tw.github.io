    <VALUE Lang="th">Exchange for Dashing Arrow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_62_0_6">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
