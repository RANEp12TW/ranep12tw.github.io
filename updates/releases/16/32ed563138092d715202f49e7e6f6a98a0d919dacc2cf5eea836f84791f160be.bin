  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_10_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_10_0_1"><VALUE Lang="tw">兌換 重拳（7級／格鬥部）</VALUE><VALUE Lang="GS">Skill book: Heavy Punch (Lv7, Class=65, Item=174/1)</VALUE><VALUE Lang="id">Skill book: Heavy Punch (Lv7, Class=65, Item=174/1)</VALUE><VALUE Lang="cn">Skill book: Heavy Punch (Lv7, Class=65, Item=174/1)</VALUE><VALUE Lang="th">Skill book: Heavy Punch (Lv7, Class=65, Item=174/1)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_10_0_2">
    <VALUE Lang="th">Learn Armor Damage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_10_0_3"><VALUE Lang="tw">兌換 側踢（7級／格鬥部）</VALUE><VALUE Lang="GS">Skill book: Side Kick (Lv7, Class=65, Item=174/21)</VALUE><VALUE Lang="id">Skill book: Side Kick (Lv7, Class=65, Item=174/21)</VALUE><VALUE Lang="cn">Skill book: Side Kick (Lv7, Class=65, Item=174/21)</VALUE><VALUE Lang="th">Skill book: Side Kick (Lv7, Class=65, Item=174/21)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_10_0_4"><VALUE Lang="tw">兌換 鐵頭功（7級／格鬥部）</VALUE><VALUE Lang="GS">Skill book: Metal Head (Lv7, Class=65, Item=174/41)</VALUE><VALUE Lang="id">Skill book: Metal Head (Lv7, Class=65, Item=174/41)</VALUE><VALUE Lang="cn">Skill book: Metal Head (Lv7, Class=65, Item=174/41)</VALUE><VALUE Lang="th">Skill book: Metal Head (Lv7, Class=65, Item=174/41)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_10_0_5">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_11_0">
    <VALUE Lang="th">Why haven't you finished the student registration?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Are the college services not operating properly?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Submit your registration form to the Welfare Society, and then take it to the School Administration Office. The Student Director will then process your Exit Approval Form.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_12_0">
    <VALUE Lang="th">I've found out that quests are very difficult at first. But now... It's really hard for me to finish them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_12_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_13_0">
    <VALUE Lang="th">Hmm? Your registration is almost done.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The next procedure is to request for Exit Approval.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now, there's something you need to do before you submit your registration form.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_14_0">
    <VALUE Lang="th">Just give the registration form to the Student Director at the School Administration Office, and then you may go outside.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hand it to him if you're finished.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_14_0_1">
    <VALUE Lang="th">Return</VALUE>
