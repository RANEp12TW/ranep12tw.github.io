    <VALUE Lang="th">15 Sweet Love Chocolate Boxes = Fine Valentine's Day Box</VALUE>
    <VALUE Lang="th">25 Sweet Love Chocolate Boxes = Luxury Valentine's Day Box</VALUE>
  </SENTENSE>
