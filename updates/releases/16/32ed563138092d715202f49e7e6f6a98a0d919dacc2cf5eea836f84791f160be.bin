  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_1_0">
    <VALUE Lang="th">Oh my goodness! Why are so many people injured?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_1_0_1">
