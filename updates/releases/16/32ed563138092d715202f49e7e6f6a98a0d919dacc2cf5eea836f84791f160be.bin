  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_1_0">
    <VALUE Lang="th">Welcome to the Abandoned Desert, the place to challenge to your limit.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_1_0_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
