    <VALUE Lang="th">Receive Lottery Ticket</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_worldcup02.ntk_1_1">
    <VALUE Lang="th">Which country will win this Brazil World Cup ?</VALUE>
    <VALUE Lang="th">Give a try! But, make sure that there's only one chance for you! Please choose it carefully.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_worldcup02.ntk_1_1_1">
    <VALUE Lang="th">Sell item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_worldcup02.ntk_1_1_2">
    <VALUE Lang="th">Select winner country</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_worldcup02.ntk_1_2">
    <VALUE Lang="th">Some places are haunted by the Astray Soccer Ball. They will make messy around the World Cup season.</VALUE>
    <VALUE Lang="th">Please prevent festive atmosphere of World Cup not to be damaged by monsters!!</VALUE>
    <VALUE Lang="th">[Event time]</VALUE>
    <VALUE Lang="th">1st half : 13:00 ~ 13:45</VALUE>
    <VALUE Lang="th">2nd half : 16:00 ~ 16:45</VALUE>
