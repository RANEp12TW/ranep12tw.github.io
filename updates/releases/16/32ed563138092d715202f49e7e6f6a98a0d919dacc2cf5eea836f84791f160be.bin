  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busteminal.ntk_1_1">
    <VALUE Lang="th">This is the Bus Stop.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Once have your Bus Ticket ready, you can use the Bus Service to move to another area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busteminal.ntk_1_1_1">
    <VALUE Lang="th">Ride the Bus</VALUE>
  </SENTENSE>
