    <VALUE Lang="th">The password is verified.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The 90th floor pass permission is confirmed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_2_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_3_0">
    <VALUE Lang="th">Each security agent has an encrypted part of the ID and Password.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you want to enter, you should complete the ID and Password by getting the permissions from each agent.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_0">
    <VALUE Lang="th">This is the security elevator for the restricted area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_1">
    <VALUE Lang="th">This is the security elevator for the restricted area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please enter the password.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_1_1">
    <VALUE Lang="th">Enter the password.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_2">
    <VALUE Lang="th">This is the security elevator for the restricted area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Pass permission is already confirmed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_2_0">
    <VALUE Lang="th">The password is verified.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Pass permission for restricted area is confirmed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0">
    <VALUE Lang="th">Hey! Hello!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0_2">
    <VALUE Lang="th">Ask about Underground Laboratory</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0_3">
    <VALUE Lang="th">Show Materials</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0_4">
    <VALUE Lang="th">Show the Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_10_0">
    <VALUE Lang="th">By the way. The guy I talked to, before you, a while ago was just like that.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Look around you before you think about the reason behind this underground. What you are trying to do now…?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We're not gods or legendary heroes. We're just human.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_10_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_11_0">
    <VALUE Lang="th">Oh, you found something?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can I see?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh? Wow~ Is it like a time machine?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, I can read this! This is Ganil language.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_11_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_12_0">
    <VALUE Lang="th">The machine... It can go through something.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Vector?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know whether... You can definitely move to another space and time with this machine.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_12_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_13_0">
    <VALUE Lang="th">It's not yet functional, though.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It doesn't work at all.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are probably some parts missing that you can uncover…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_13_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_14_0">
    <VALUE Lang="th">Wow, impressive...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How were you able to find all that stuff in this dirty gutter?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How about changing your job? You can be a treasure hunter for life!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_14_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_15_0">
    <VALUE Lang="th">I'm not sure if this works very well since my major is software... I think the important parts are complete, but we might need some minor parts later.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_15_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_16_0">
    <VALUE Lang="th">You know that this isn't just a list of names?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes, I don't mind the ideals of SFG or the ideals of another world.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But I don't like to make sacrifices on that ideal. The indulgence of sacrifice is... Just an excuse...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Jung Il, maybe if he was there, he'd support it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_16_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_2_0">
    <VALUE Lang="th">You should have many questions….</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_2_0_1">
    <VALUE Lang="th">Ask about Him</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_2_0_2">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_3_0">
    <VALUE Lang="th">I was a sophomore at Sacred Gate Campus and enrolled in the swordsmanship class. I didn’t want to study here. Maybe that's why…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_3_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_4_0">
    <VALUE Lang="th">Don't look at me like this~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm not a good mood to talk to you nicely, and I'm not the type to take care of other people.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't care whatever people say, but because of my personality, I've hurt my shy friend many times.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway someday he was getting into some kind of superstition…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I couldn't do anything about it....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_4_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_5_0">
    <VALUE Lang="th">If I think I don't stop him, he can't be normal anymore.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I couldn't believe that he was so afraid of his incarnation images and memory...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So... I should do this...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_5_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_6_0">
    <VALUE Lang="th">So Seung Il... After he died, I couldn't just leave this place…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are some clues left here…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">And I also heard that there is a private laboratory for S.F.G. near here...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I am sure that the monsters near here are related to that laboratory somehow.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_6_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_7_0">
    <VALUE Lang="th">I think. It is already meaningless if the lab even exists.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_7_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_8_0">
    <VALUE Lang="th">There's too many monsters… Too many for all of them to live underground.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Is it clear now?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Experiments on human bodies were conducted in that laboratory.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They were making weapons out of human beings.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_8_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_9_0">
    <VALUE Lang="th">Why? SFG officially creates 4 campuses for the sake of education? What about jail? And the Laboratory…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Is it a defense system for this village?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Haha…!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm getting silly with my thinking nowadays.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_9_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0">
    <VALUE Lang="th">It's too far from there~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_1">
    <VALUE Lang="th">Change Start Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_2">
    <VALUE Lang="th">Ask for Heal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_3">
    <VALUE Lang="th">Open the Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_4">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_5">
    <VALUE Lang="th">Ask for Help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_6">
    <VALUE Lang="th">Give Hair Clip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_7">
    <VALUE Lang="th">Inform [Request help from Hong Ji Yoon]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_10_0">
    <VALUE Lang="th">I was with Dae Yook in front of that door, and needed to go to the restroom. We couldn't reach it in a normal way.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_10_0_1">
    <VALUE Lang="th">To Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_11_0">
    <VALUE Lang="th">Did you see the floating objects? As you can see, the space here is quite unstable and time stopped. So you might use this to use the restroom.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There is a broken window somewhere. And through that window, you can reach the toilet.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Because of this weird time space, we can destroy or move objects.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_11_0_1">
    <VALUE Lang="th">To Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_12_0">
    <VALUE Lang="th">Did you already find it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh. I forgot.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You cannot pass through that passage again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Weird? You can enter the passage several times but once you reach the end of passage, you cannot enter it again. Maybe there are certain rules for this passage. Anyway, I think there is another similar passage over there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_12_0_1">
    <VALUE Lang="th">To Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_13_0">
    <VALUE Lang="th">Lee Da Xu...Ah... Da Xu is my friend. Is he suffering from amnesia?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_14_0">
    <VALUE Lang="th">He can't remember anything? I believe his memories will come back slowly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_15_0">
    <VALUE Lang="th">Lee Da Xu? Ah… He's still alive, is that true? Da Xu and me are very good friends… How'd he lose his memories? If he's need any help to recover from his condition, then please let me know.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_15_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0">
    <VALUE Lang="th">Too many questions?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0_1">
    <VALUE Lang="th">Ask about Her</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0_2">
    <VALUE Lang="th">Ask about Head Office Building</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0_3">
    <VALUE Lang="th">Ask about Bathroom</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0_4">
    <VALUE Lang="th">Ask about Restroom</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_3_0">
    <VALUE Lang="th">I'm sorry I didn't introduce myself</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_3_0_1">
    <VALUE Lang="th">Ask about Hong Mi Ran</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_4_0">
    <VALUE Lang="th">Ah. You met my mom?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">After the incident, I was not able to see her. Now I'm already here…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How's my mom?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_4_0_1">
    <VALUE Lang="th">Ask how she came here.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_5_0">
    <VALUE Lang="th">There was an upperclassman I liked… He was so perfect, I remember someone had he must be more than human. He had so many fans... Ugh... But then he turned into a monster.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I still wanted to protect him somehow… But there was nothing I could do.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_5_0_1">
    <VALUE Lang="th">Ask about that Boy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_6_0">
    <VALUE Lang="th">I killed Joo Seong, vice-representative of the fighter class.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There was no other choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If I didn’t kill him, he would kill more people.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I have no regrets.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_6_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_7_0">
    <VALUE Lang="th">I had a boyfriend that always protected me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">His name was Lee Dae Yook.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">He went to another world after he saw that I was having a hard time with everything that was happening.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">He didn't even tell me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_7_0_1">
    <VALUE Lang="th">To Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_8_0">
    <VALUE Lang="th">I don’t know how many floors this building has. The emergency stairs are destroyed and the elevator is broken. This building probably has more than 10th floors?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_8_0_1">
    <VALUE Lang="th">Ask for More Info</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_9_0">
    <VALUE Lang="th">Only a few things…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Like research notes…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't remember too many details…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I just remember being excited about the idea of visiting another world.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_9_0_1">
    <VALUE Lang="th">Ask How to Visit Another World.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0">
    <VALUE Lang="th">Huh?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_2">
    <VALUE Lang="th">Give Enrollment Form</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_3">
    <VALUE Lang="th">Ask about Damage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_4">
    <VALUE Lang="th">Deliver the New Suit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_5">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_6">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_2_0">
    <VALUE Lang="th">Thanks~ The guy who processed my document said that it disappeared. Then he vanished too, and now I can't do anything until I find those forms… Anyway, thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_2_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_3_0">
    <VALUE Lang="th">It's okay… I just took a bit of a beating… But I'll be fine. I probably need to train a bit more to catch up with my classmates.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_4_0">
    <VALUE Lang="th">Oh! Thanks, It will be useful I think I could defense myself with this. Watch me, I will catch up their skills as soon as possible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_4_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_5_0">
    <VALUE Lang="th">Oh well... Everything is fine, but there is no computer game club.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Are we monkeys?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why should we play and jump around campus?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know why this school was such a boring atmosphere.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Let me play alone in quiet.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_5_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_6_0">
    <VALUE Lang="th">My friend told me that he'd find my document for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I'm waiting for him now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm, but he's still not here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me find that document?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_6_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_6_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_7_0">
    <VALUE Lang="th">They don't like me... Maybe because of my scores?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll need to study more than they do.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you think you can teach me how to learn things better and more quickly?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_7_0_1">
    <VALUE Lang="th">agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_7_0_2">
    <VALUE Lang="th">reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_8_0">
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They'll find me if they come back here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I guess all I can do for now is just wait.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_9_0">
    <VALUE Lang="th">I'll study here by myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_9_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0">
    <VALUE Lang="th">Weird, it was a human…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_10">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_11">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_12">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_13">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_14">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_15">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_16">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_17">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_18">
    <VALUE Lang="th">Tell him that you would like to complete the Eight Signs of Divine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_19">
    <VALUE Lang="th">Ask if he needs help with anything</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_2">
    <VALUE Lang="th">Show the Eight Signs of Divine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_20">
    <VALUE Lang="th">Tell him about the secret passage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_21">
    <VALUE Lang="th">Ask if he needs help with anything</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_22">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_23">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_24">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_3">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_4">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_5">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_6">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_7">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_8">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_9">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_10_0">
    <VALUE Lang="th">I was so proud of myself, training in the traditional sword skills.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">After I met him… I felt so foolish.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_10_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_11_0">
    <VALUE Lang="th">I was able to master complex sword skills in a few days, but I easily lost my mind with such an obvious taunt...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_11_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_12_0">
    <VALUE Lang="th">I was raging and cursing and… Suddenly, I was killed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes, I really died. I was killed by my copy spirit.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">He utterly defeated me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_12_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0">
    <VALUE Lang="th">Ah this is the device for passing through the dimension gate, but it's not assembled yet.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Instructions? Oh well... Could we maybe find a list? Huh. That's right. I remember that list now. The List of Saints.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_1">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_10">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_11">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_12">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_2">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_3">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_4">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_5">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_6">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_7">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_8">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_13_0_9">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_14_0">
    <VALUE Lang="th">You've heard of the list of inmates.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How can all these gifted people be here?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Fate? Advertising? No way!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Everything was planned by SFG.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The sudden death of parents, retirements, house fires, and so on.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_14_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_15_0">
    <VALUE Lang="th">There are no parents that send their children to a new school without any good reason.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">While the higher-ups talk about world peace, they are actually committing crimes against humanity.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Don't believe me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can directly ask about it. Ask any teacher. See how they respond.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_16_0">
    <VALUE Lang="th">"You want to complete the Eight Signs of Divine?</VALUE>
    <VALUE Lang="th">It is not an easy task..</VALUE>
    <VALUE Lang="th">Ok go ahead.. Hope you would bring back a good news."</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_17_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_18_0">
    <VALUE Lang="th">I fell something, near the No.3 Plant. I would've gone myself if JS was not here but.. Please go find out what happened for me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_18_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_19_0">
    <VALUE Lang="th">A secret passage? I have never seen it.. Oh ok. I will investigate it on my own. Thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_19_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_2_0">
    <VALUE Lang="th">You may have many questions…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But you don't know much about it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_2_0_1">
    <VALUE Lang="th">Ask about Him</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_2_0_2">
    <VALUE Lang="th">Ask about the Underground</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_2_0_3">
    <VALUE Lang="th">Ask about Ji Il Cheung</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_20_0">
    <VALUE Lang="th">You need to tell one more person about secret passage. Do you know Suah by any chance? I've heard about her from other kids. Don't ask me why, just go tell Suah about the secret passage. She would understand if you tell her that Liz has found the way to Adoniechus. Please do this for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_20_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_3_0">
    <VALUE Lang="th">Sacred Gate Campus... Swordsmanship class, and Mesran of Ragia in another world.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Who were you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not the one for now, the one before incarnation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_3_0_1">
    <VALUE Lang="th">Ask Again</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_4_0">
    <VALUE Lang="th">It is good not to remember what you were.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If I could remember you were the hypocrite, you wouldn't forgive yourself. We are the ones who ignore the people that never benefited from the Light. We consider them as invaders.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I still cannot believe I was one of them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_4_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_5_0">
    <VALUE Lang="th">The war between Light and Dark. It sounds cool, but…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Daramai race was forced to live in the day. Someday, they were able to realize the power of Light after suffering so long in the dark, and asked to share it. Their oppressors refused…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_5_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_6_0">
    <VALUE Lang="th">The Ragia considered themselves the rightful owners of the Light, and considered the Daramai as lowly invaders.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Another world was almost destroyed by war.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So who am I? I am not a part of the Light race.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I want to fight against Light.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_6_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_7_0">
    <VALUE Lang="th">This place is like the face behind the mask. Here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They pretend to be saviors of justice, but they developed weapons in secret.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Moreover...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_7_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_8_0">
    <VALUE Lang="th">I believe you already saw almost too much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They are just like the people who insist that they own the Light.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">SFG doesn't care about human life. They've experimented on living human bodies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_8_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_9_0">
    <VALUE Lang="th">You might be able to find something here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But you might regret what you learn.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Are you still willing to find out?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_9_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_1_0">
    <VALUE Lang="th">Uh... Hello?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_1_0_2">
    <VALUE Lang="th">Give Enrollment Form</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_1_0_3">
    <VALUE Lang="th">Ask about Damage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_1_0_4">
    <VALUE Lang="th">Deliver the New Suit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_1_0_5">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_1_0_6">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_2_0">
    <VALUE Lang="th">Ah... Thanks~ If the officer just tells me where I should look… Maybe I can find my papers on my own.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_2_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_3_0">
    <VALUE Lang="th">I can endure the beatings... Still, they really hurt, though...~ This school uniform doesn't really absorb any brunt either...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_4_0">
    <VALUE Lang="th">Oh, what are these clothes? They look sturdier... Maybe I'll even get the chance to fight back if someone hits me! Anyway, thanks. This'll be handy~~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_4_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_5_0">
    <VALUE Lang="th">I don't get it</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_5_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_6_0">
    <VALUE Lang="th">My friend told me that he'd find my document for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I'm waiting for him now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm, but he's still not here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me find that document?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_6_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_6_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_7_0">
    <VALUE Lang="th">They don't like me... Maybe because of my scores?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll need to study more than they do.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you think you can teach me how to learn things better and more quickly?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_7_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_7_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_8_0">
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They'll find me if they come back here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I guess all I can do for now is just wait.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_9_0">
    <VALUE Lang="th">I'll study here by myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sujung1.ntk_9_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_1_0">
    <VALUE Lang="th">Hello, welcome.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_1_0_2">
    <VALUE Lang="th">Open the Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_1_0_3">
    <VALUE Lang="th">Check if this Student was Mentioned by the Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_1_0_4">
    <VALUE Lang="th">Ask about the Underground Laboratory</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_1_0_5">
    <VALUE Lang="th">Tell her about Seung Hee Jeon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_2_0">
    <VALUE Lang="th">What do you want to know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_2_0_1">
    <VALUE Lang="th">Ask about Her</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_2_0_2">
    <VALUE Lang="th">Ask about the Head Office Building</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_2_0_3">
    <VALUE Lang="th">Ask about Sacred Financial Group's Public Service</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_3_0">
    <VALUE Lang="th">I'm Seung Hee Ji, Sophomore Archer Class at Sacred Gate campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">A few months ago, I followed my sister, and she transformed into a monster. I lost her near here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I made the map of Leonine campus and sign board here so that I could easily trace friends and family that have been transformed into monsters.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_4_0">
    <VALUE Lang="th">It's like a big tombstone here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">A lot of people died to make this building.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We believed they sacrificed themselves for our sakes, but</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_4_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_5_0">
    <VALUE Lang="th">The Sacred Financial Group obviously did several good jobs for this community.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are almost too many records of the company's donations and public service.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now, there are still people that doubt the Sacred Financial Group.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Are they too good to be true? Maybe not.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I think somebody has to sacrifice for the others.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">All of us can't be happy, anyway.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_5_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_6_0">
    <VALUE Lang="th">Maybe... It is me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I am the one who talked about it first.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Okay, look at these documents carefully.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I already read them so many times.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Although I couldn't find any suspected evidence…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Maybe the other can find it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_6_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_7_0">
    <VALUE Lang="th">Oh well…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I haven't gone to the underground laboratory yet.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You cannot use the stairs. Maybe you have to use elevator although I don't know how to activate it. Anyway, I think you can go down if you can open it... You probably need a password.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_7_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_8_0">
    <VALUE Lang="th">Really? Where? Where did you meet my sister?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Where... Accidentally? Okay, I know you didn't expect this, but it is good news.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Although I sensed my sister in my heart, I didn't expect for her to really be alive somewhere.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you so much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Maybe if you meet my sister again, could you tell her my message?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I was so proud of you as my sister, and I believe you will survive in any bad situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeji1.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0">
    <VALUE Lang="th">Huh?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_10">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_11">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_12">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_13">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_14">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_15">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_16">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_17">
    <VALUE Lang="th">Ask How You can Help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_18">
    <VALUE Lang="th">Relate Investigation Details</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_19">
    <VALUE Lang="th">Seung Hee Yoon's Call</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_2">
    <VALUE Lang="th">Ask about Seung Hee Ji</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_20">
    <VALUE Lang="th">Seung Hee Yoon's Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_3">
    <VALUE Lang="th">Tell her about Seung Hee Ji</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_4">
    <VALUE Lang="th">Open the Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_5">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_6">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_7">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_8">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_9">
    <VALUE Lang="th">Ask about List of Saints</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_10_0">
    <VALUE Lang="th">Maybe there will be another copy spirit that has a better body. If not, please tell her that I was so happy that she could stop me. Also tell her not to feel so weak.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please help me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_10_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_11_0">
    <VALUE Lang="th">Oh. That was the answer.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I won't ever give up, then!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thanks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now I feel better.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Maybe someday another copy of my spirit will visit Hee Ji since I know her feelings so well.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Then I will just rest here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_11_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_12_0">
    <VALUE Lang="th">It is morally wrong to put enforcement on that list.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But what will happen without enforcement?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now can we talk like this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I believe this is the evil is necessary for life to exist.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_12_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_13_0">
    <VALUE Lang="th">Suddenly...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I thought of something.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The artificial heart power generator room underground...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It has been discovered that the electricity is stable in an artificial heart without an outside power supply.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Is it really an artificial heart? A man-made object?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">For me, its movement is so natural… And looks weird.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Could you check that place?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_13_0_1">
    <VALUE Lang="th">Accept</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_13_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_14_0">
    <VALUE Lang="th">If the beat rate is little bit changed... If the vibration is almost same, then it really is an artificial heart.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_14_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_15_0">
    <VALUE Lang="th">Ah, okay…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You look so tired. If that one is based on a real one...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Then it won't have that kind of problem.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you for your help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_15_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_16_0">
    <VALUE Lang="th">I'm glad you are coming. I just want to help you earn new power. Pass my exam and you'll get new sphere to learn the power.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_16_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_17_0">
    <VALUE Lang="th">Eliminate Multilock in Head.B U-Ground.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_17_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_2_0">
    <VALUE Lang="th">Is there something that I could help you with?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_2_0_1">
    <VALUE Lang="th">Ask about Her</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_2_0_2">
    <VALUE Lang="th">Ask about the Underground</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_2_0_3">
    <VALUE Lang="th">Ask about Copy Spirit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_3_0">
    <VALUE Lang="th">I was the vice-representative of archery class in Sacred Gate Campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">...But... I died....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Then I transformed into a monster since I didn't have any power like my sister's.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_3_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_4_0">
    <VALUE Lang="th">My poor sister killed me eventually.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It wasn't easy.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Then she shared her power with me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">My copied spirit was able to get the same body form and spirit as before.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_4_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_4_0_2">
    <VALUE Lang="th">Ask about Copy Spirit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_5_0">
    <VALUE Lang="th">Well, I'm a copy spirit myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Many free spirits are captured in this place, and certain forces keep them trapped here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Perhaps a spirit's grudge or attachment?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_5_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_6_0">
    <VALUE Lang="th">If possible, I want to leave this place.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can't leave because of certain invisible forces.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I just hope that the other free spirits won't suffer this... Maybe it's my grudge</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_6_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_7_0">
    <VALUE Lang="th">When two different dimensions cross each other, it can cause an organism to transform into a completely new creature that is bloodthirsty and violent.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Sometimes the crossing of dimensions causes more than one new kind of life form to be spawned.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_7_0_1">
    <VALUE Lang="th">Continue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_8_0">
    <VALUE Lang="th">I was one of them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Then there are cases where this happens, but the organism doesn't lose its mind or sanity.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_9_0">
    <VALUE Lang="th">I wanted to do what my sister did…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I wanted to hug her instead of being stuck here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm trapped. There's no way out for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">My body isn't even a human body either.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Will you help me? Please send my sister a message for me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_9_0_1">
    <VALUE Lang="th">Accept</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_9_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0">
    <VALUE Lang="th">Hi, hello~~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_2">
    <VALUE Lang="th">Give Enrollment Form</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_3">
    <VALUE Lang="th">Ask about Damage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_4">
    <VALUE Lang="th">Deliver the New Suit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_5">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_6">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_2_0">
    <VALUE Lang="th">Ah, thanks. The officer just told me where I should look. That's why I couldn't do anything…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_2_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_3_0">
    <VALUE Lang="th">I can endure the attacks from those kids, but not for too long. This school uniform doesn't really absorb the brunt of those hits...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_4_0">
    <VALUE Lang="th">Oh, look at these clothes. These seem a little sturdier. Maybe I can even counterattack with clothes as tough as these! Anyway, thanks! I think they'll be handy~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_4_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_5_0">
    <VALUE Lang="th">There's no welfare for students here…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I was studying in USA when I heard about a better tuition and scholarship program.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is totally different than what I expected, though.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">And how can I study in these filthy conditions?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even I feel a little disgusted and uncomfortable.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_5_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_6_0">
    <VALUE Lang="th">My friend told me that he'd find my document for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I'm waiting for him now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm, but he's still not here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me find that document?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_6_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_6_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_7_0">
    <VALUE Lang="th">They don't like me... Maybe because of my scores?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll need to study more than they do.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you think you can teach me how to learn things better and more quickly?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_7_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_7_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_8_0">
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They'll find me if they come back here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I guess all I can do for now is just wait.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_9_0">
    <VALUE Lang="th">I'll study here by myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_9_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0">
    <VALUE Lang="th">Yo!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_2">
    <VALUE Lang="th">Give Enrollment Form</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_3">
    <VALUE Lang="th">Ask about Damage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_4">
    <VALUE Lang="th">Deliver the New Suit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_5">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_6">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_2_0">
    <VALUE Lang="th">Thanks~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The guy who processed my document said that it disappeared, and then he vanished too.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I couldn't do anything because he didn't tell me where he lost it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I haven't been able to enroll in anything up till now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway, thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_2_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_3_0">
    <VALUE Lang="th">It's okay…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Nuts, someone just hit me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Aw, it's nothing, I just wasn't fast enough to strike back.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I probably… Need more practice at this fighting thing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_4_0">
    <VALUE Lang="th">Oh!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thanks, this will be useful~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I think I could defend myself better with this!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Huh, I better catch to their skills as soon as I can.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_4_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_5_0">
    <VALUE Lang="th">I transferred here from my old school~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Then I found the school doesn't provide a dormitory… And it was so hard to enroll in anything.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm going to quit... I want to go back!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_5_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_6_0">
    <VALUE Lang="th">My friend told me that he'd find my document for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I'm waiting for him now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm, but he's still not here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me find that document?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_6_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_6_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_7_0">
    <VALUE Lang="th">They don't like me... Maybe because of my scores?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll need to study more than they do.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you think you can teach me how to learn things better and more quickly?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_7_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_7_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_8_0">
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They'll find me if they come back here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I guess all I can do for now is just wait.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_9_0">
    <VALUE Lang="th">I'll study here by myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_9_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0">
    <VALUE Lang="th">Hi, hello~~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_1">
    <VALUE Lang="th">Listen to the Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_2">
    <VALUE Lang="th">Give Enrollment Form</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_3">
    <VALUE Lang="th">Ask about Damage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_4">
    <VALUE Lang="th">Deliver the New Suit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_5">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_6">
    <VALUE Lang="th">I want to help.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_2_0">
    <VALUE Lang="th">Ah... Thanks.</VALUE>
    <VALUE Lang="th">Ah... Thanks.</VALUE>
    <VALUE Lang="th">The officer just told me where I should look.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That's why I couldn't do anything.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_2_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_3_0">
    <VALUE Lang="th">I can endure the beatings...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Still, they really hurt, though…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This school uniform doesn't really absorb any brunt either...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_4_0">
    <VALUE Lang="th">Oh, what are these clothes?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They look sturdier... Maybe I'll even get the chance to fight back if someone hits me!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway, thanks. This'll be handy~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_4_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_5_0">
    <VALUE Lang="th">The weird thing is...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The school campus is very nice!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The classroom equipment is terrible, though.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">No air conditioning, no heating, no electric fans…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Then I thought…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Maybe…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This school isn't for teaching academics to kids.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_5_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_6_0">
    <VALUE Lang="th">My friend told me that he'd find my document for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I'm waiting for him now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm, but he's still not here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me find that document?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_6_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_6_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_7_0">
    <VALUE Lang="th">They don't like me... Maybe because of my scores?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll need to study more than they do.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you think you can teach me how to learn things better and more quickly?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_7_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_7_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_8_0">
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They'll find me if they come back here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So I guess all I can do for now is just wait.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_9_0">
    <VALUE Lang="th">I'll study here by myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_9_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_0">
    <VALUE Lang="th">It's incredible that you're still alive. Aside from that, I've got nothing to talk to you about.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_0_1">
    <VALUE Lang="th">Ask about Problem</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_1">
    <VALUE Lang="th">Ask About Sister</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_1_1">
    <VALUE Lang="th">Give the Letter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_2">
    <VALUE Lang="th">What are you holding? It looks like a letter…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_2_1">
    <VALUE Lang="th">Give the Letter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_3">
    <VALUE Lang="th">You said that letter is from Lee Zhen? Quick, give it to me!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_3_1">
    <VALUE Lang="th">Give the Letter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_4">
    <VALUE Lang="th">I guess I was right… Would you please come back after the exam?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_4_1">
    <VALUE Lang="th">Tell the Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5">
    <VALUE Lang="th">You received limited abilities because you were late, but they should be enough for you for now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_1">
    <VALUE Lang="th">Accept Confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_2">
    <VALUE Lang="th">Accept Confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_3">
    <VALUE Lang="th">Accept Confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_4">
    <VALUE Lang="th">Receive the Murakano Blood Sample.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_5">
    <VALUE Lang="th">Deliver the Amanuoyin's Birthday Gift.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_6">
    <VALUE Lang="th">Deliver the Refine Pill.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_7">
    <VALUE Lang="th">Receive Amanuoruoyin's Second Request.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_8">
    <VALUE Lang="th">Receive Amanuoruoyin's Last Request.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_10_0">
    <VALUE Lang="th">Keep building up your skills and abilities. You've got talent, but you can't stop learning and growing. You need to be stronger than your enemies!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_11_0">
    <VALUE Lang="th">I lied… I watched my sister slowly lose her humanity…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_11_0_1">
    <VALUE Lang="th">Continue Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_12_0">
    <VALUE Lang="th">In that place, that one person...... All because of Professor Chui. No, it's my fault too! I hope my sister can forgive me. Please give my message to her, and ask her to be patient. I will go and save her from the suffering I caused her.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_13_0">
    <VALUE Lang="th">Murakano Blood not only can create the Bloody weapon but it can awake the ability of the consumer…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_14_0">
    <VALUE Lang="th">This… Prepared by my sister… It is so pathetic because of my despair.</VALUE>
    <VALUE Lang="th">Time to wake myself and find the way to look for my sister…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_15_0">
    <VALUE Lang="th">I feel more calm now. Really thank you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_16_0">
    <VALUE Lang="th">It is not a big problem for you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_17_0">
    <VALUE Lang="th">Sorry because of me you are in danger.</VALUE>
    <VALUE Lang="th">I will not forget your kindness until I die..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_2_0">
    <VALUE Lang="th">What? You don't know the current state of this horrific world?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_3_0">
    <VALUE Lang="th">Power… I have something to tell you.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_3_0_1">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_4_0">
    <VALUE Lang="th">I used to be like you, and wanted to put an end to all of the world's madness. That changed after I entered the Financial Group Tower and found out about Professor Chui's Research Project.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_4_0_1">
    <VALUE Lang="th">I already told you about it…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_5_0">
    <VALUE Lang="th">Oh? Where did you hear this from? Who else knows about this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Lee Zhen?! Lee Zhen is still alive? Great, I need your help, please go and find Lee Zhen. He will know I sent you after you say my name, Amanuoruoyin.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_6_0">
    <VALUE Lang="th">Erm… These things happen. Sorry, but can you help me to write a letter and give it to Lee Zhen?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_7_0">
    <VALUE Lang="th">It's okay, my help might not be all that great, but…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_7_0_1">
    <VALUE Lang="th">Ask About Past</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_8_0">
    <VALUE Lang="th">He said want to stop this chaotic situation, and develop his abilities. His biggest goal, though, was to find his lost sister. I couldn't do anything except leave her alone and save her friends. I still think I failed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_8_0_1">
    <VALUE Lang="th">Continue Story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_9_0">
    <VALUE Lang="th">That's all I remember. You can go back now. I hope you can remember what I told you before.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_1">
    <VALUE Lang="th">Hello? Why are you so hurry? Is there anything important?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_1_1">
    <VALUE Lang="th">Deliver the Expedition Participation Letter.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_10">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_2">
    <VALUE Lang="th">How can I help you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_2_1">
    <VALUE Lang="th">Give Accessory [Collect Accessory]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_3">
    <VALUE Lang="th">How can I help you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You have anything you want to tell me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_3_1">
    <VALUE Lang="th">Give Letter [Please Persuade Amanuoruoyin]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_4">
    <VALUE Lang="th">Who?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How did you know I was here?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Lucky you're a student....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What happened with the researcher?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_4_1">
    <VALUE Lang="th">Confirm Amanuoruoyin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_5">
    <VALUE Lang="th">If you are Wan Xing, you can surely help me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_5_1">
    <VALUE Lang="th">Help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_6">
    <VALUE Lang="th">You're here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank god you're here, I really appreciate it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_6_1">
    <VALUE Lang="th">Handout</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7">
    <VALUE Lang="th">Hi? We meet again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know anything about it because I've been very busy. Say, why do you look so different from the other students?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_1">
    <VALUE Lang="th">Ask about Person</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_2">
    <VALUE Lang="th">Ask Him to Hear You Out</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_3">
    <VALUE Lang="th">Handout</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_4">
    <VALUE Lang="th">Ask Him to Hear You Out</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_5">
    <VALUE Lang="th">Handout</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_6">
    <VALUE Lang="th">Passing Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_7">
    <VALUE Lang="th">Give the Letter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_8">
    <VALUE Lang="th">Ask Him to Hear You Out</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_9">
    <VALUE Lang="th">Handout</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_8">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_9">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_10_0">
    <VALUE Lang="th">I heard some student said he had the Yin Xi research report.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They saw on the 50th Floor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me get it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_11_0">
    <VALUE Lang="th">Yin Xi is the same as me… We were both parts of a weird experiment.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Did he know the truth?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Does he know his grandfather did all this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_11_0_1">
    <VALUE Lang="th">Talk about Chui Yin Xi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_12_0">
    <VALUE Lang="th">Did you meet Yin Xi?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You were training with Chui Yin Xi....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Zhen, Ruoyin, Yin Xi, Da Xu</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_13_0">
    <VALUE Lang="th">They should live their own lives as best they can now. I've learned enough to satisfy me. Now, it's time for me to give you some information.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I gave all my experiment diaries were sent to Yin Xi. The writing's messy, but I tried to finish it early and send all the data to Lee Zhen and Chui Yin Xi.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_14_0">
    <VALUE Lang="th">Oh....Thank you... I'm very happy because I was able to survive for the sake of meeting my brother. Thanks again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_14_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_15_0">
    <VALUE Lang="th">The accessory needed to start the Human Segregator progress can probably be found in the underground laboratory.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_15_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_16_0">
    <VALUE Lang="th">I still need to be careful. Someone else may find me, and then… Anyway, after we meet again, I'll tell you more about my story.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_16_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_17_0">
    <VALUE Lang="th">Oh, you already got it, thank you so much. I'm not sure whether I can successfully complete the process, though…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_18_0">
    <VALUE Lang="th">Now I'll keep living since I know my brother is still alive...Thank you so much for sending that letter to me. Let me know if you ever need my help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_18_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_19_0">
    <VALUE Lang="th">These are all definitely accessories, but these don't look like they'll be enough. Please collect more for me when you have some free time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_19_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_2_0">
    <VALUE Lang="th">I heard that this building, 1F, contains plenty of information.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know the name of the file or whatever it is I need there…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But can you help me get it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">As you know, it's very dangerous inside this building.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Just be careful~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_20_0">
    <VALUE Lang="th">Request has been checked. Please let him know that I will prepare and deliver it to expedition section.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_3_0">
    <VALUE Lang="th">First you'll need to arrange and organize all your information.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Seems you have plenty to do. Take care.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_4_0">
    <VALUE Lang="th">Aiya! I'm Amaruoyin!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know why I'm here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_4_0_1">
    <VALUE Lang="th">Ask about Amanuoruoyin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_5_0">
    <VALUE Lang="th">Ruoyin? Is it? You're still alive?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ruoyin is my brother, but we had to part many years ago.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I met him again recently, but…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_5_0_1">
    <VALUE Lang="th">Continue to Listen</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_5_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_6_0">
    <VALUE Lang="th">My body started to mutate into what you call a spirit clone… I had to leave my brother. It hurts, and I know there's some problem in this process…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_7_0">
    <VALUE Lang="th">I heard my name in the report during the research process.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">All the research information can be found in 30F Research Information Room 4. Can you help me get it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_8_0">
    <VALUE Lang="th">Thank you very much for your help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_8_0_1">
    <VALUE Lang="th">Inform Amaruoyin that She was a Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_9_0">
    <VALUE Lang="th">Yes, I know, but I'm not sure what the experiment was…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Maybe the report will let me know the truth.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_0">
    <VALUE Lang="th">Who are you? You look useless... And nothing can help me. Please just get out of here, okay?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_0_1">
    <VALUE Lang="th">How can I help you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_0_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_1">
    <VALUE Lang="th">What happened?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You have anything you want to give me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_1_1">
    <VALUE Lang="th">Give the Accessory. [Collect Accessory].</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_10">
    <VALUE Lang="th">Wait a minute, what is this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm... Do you want to get stronger? I can help you do that.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_10_1">
    <VALUE Lang="th">Accept</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_10_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_11">
    <VALUE Lang="th">Wait a minute, what is this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm... Do you want to get stronger? I can help you do that.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_11_1">
    <VALUE Lang="th">Accept</VALUE>
  </SENTENSE>
