  <SENTENSE Ver="1" Id="npc_3_gisuk_1.ntk_3_0">
    <VALUE Lang="th">The Force Field Mechanism of the Terminal is running properly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll need 7 Spiritual Spheres to optimize this Terminal's Force Field function.</VALUE>
