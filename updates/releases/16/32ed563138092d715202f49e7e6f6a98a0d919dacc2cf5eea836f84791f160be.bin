    <VALUE Lang="th">Exchange item for Dozen Arrow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_66_0_4">
    <VALUE Lang="th">Exchange item for Enhanced Cyclone Arrow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_66_0_5">
    <VALUE Lang="th">Exchange item for Destructive Arrow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_66_0_6">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_67_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_67_0_1">
    <VALUE Lang="th">Exchange item for Lightning Arrow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_67_0_4">
    <VALUE Lang="th">Exchange item for Blazing Gear</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_67_0_5">
    <VALUE Lang="th">Exchange item for Oktagon Arrow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_67_0_6">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_7_0">
    <VALUE Lang="th">신입생처럼 굴기는...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">곧장 나가면 현관이 있지?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_7_0_1">
    <VALUE Lang="th">짾??</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0">
    <VALUE Lang="th">What do you want to know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_1">
    <VALUE Lang="th">Ask about the Archery Section</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_2">
    <VALUE Lang="th">Ask about Training Methods</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_3">
    <VALUE Lang="th">Ask about Combat Methods</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_4">
    <VALUE Lang="th">Ask about Skill Points</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_5">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_9_0">
    <VALUE Lang="th">There's no turning back now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please be aware of this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_9_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0">
    <VALUE Lang="th">Oh! It's great to see a normal human after all this time!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_2">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_3">
    <VALUE Lang="th">Request for Bus Spare Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_4">
    <VALUE Lang="th">Request for Generator Spare Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_5">
    <VALUE Lang="th">Collect Unverified Currency Notes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_6">
    <VALUE Lang="th">Technical Teacher's Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_7">
    <VALUE Lang="th">Confirm Test Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_8">
    <VALUE Lang="th">Give the Order Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_9">
    <VALUE Lang="th">Ask about the Taxi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_10_0">
    <VALUE Lang="th">That money is really strange, and it's good we discovered it before the problem got any worse. Just carry on with delivering the Order Document.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That'll help out a lot!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_11_0">
    <VALUE Lang="th">Oh, so you already reached level to qualify for this exam?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You learn faster than I thought!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_11_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_12_0">
    <VALUE Lang="th">Good, you pass the exam by achieving your level. It's a little less than what I expected, but...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll need to practice more so that you'll be ready for any kind of attack from these fellahs.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_13_0">
    <VALUE Lang="th">....7</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_14_0">
    <VALUE Lang="th">Ah, are you looking for spare parts to fix the bus?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Several people came to collect those same spare parts. They keep coming back because the buses keep getting involved in accidents. I'm just glad we're able to help out by having spare parts available.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Although we've prepared all the necessary equipment for these kinds of situations, we starting to run out of spare parts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_14_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_15_0">
    <VALUE Lang="th">....8</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_16_0">
    <VALUE Lang="th">You can get the spare parts you need from the supervisors of the Construction Site located at the 4th Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll have to prove yourself to them first. They might give you a bit of a rough time!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_16_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_17_0">
    <VALUE Lang="th">.......9</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_18_0">
    <VALUE Lang="th">These currency notes have been verified by the ATMs as genuine money.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_18_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_19_0">
    <VALUE Lang="th">Do you think that this trash still needs to be gathered?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It'd definitely be better for us Street Cleaners if all the garbage and trash was sorted and collected.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please help us out, okay?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_19_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_2_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_2_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_2_0_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_20_0">
    <VALUE Lang="th">Please take these and verify them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_20_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_21_0">
    <VALUE Lang="th">...11</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_22_0">
    <VALUE Lang="th">Great!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Let me remind you of this test's purpose again before I give you the exam questions.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Your regular targets in this test won't be human begins.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_22_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_23_0">
    <VALUE Lang="th">That's the reason why you need to regular take these kinds of exams.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll be able to learn the stuff you really need to know.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_23_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_24_0">
    <VALUE Lang="th">You need to diligently continue your studies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll eventually fight enemies higher than this level, so don't get complacent.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you understand me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_24_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_25_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_26_0">
    <VALUE Lang="th">It will only operate to limited areas. You will not be ablee to get to all the places. It will take you to the places where there is conscious teacher or people are at.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_26_0_1">
    <VALUE Lang="th">Ask him how much is the fare</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_27_0">
    <VALUE Lang="th">School supports all~! would only happen in your dreams.. Isolated schools to do that is really hard and just thank that you could travel faster and safely. Don't consider it expensive</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_27_0_1">
    <VALUE Lang="th">Tell him you would like to ride it</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_27_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_28_0">
    <VALUE Lang="th">Go talk to Student counselor and receive the pass</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_28_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_3_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can imagine how it would have been if you had listened in class. It all happened 18 years ago, earlier than anyone expected.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_4_0">
    <VALUE Lang="th">We predicted long ago that this would happen, but it was much worse than we thought it would be.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please collect any important information related to this matter.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_5_0">
    <VALUE Lang="th">Right now, I'm managing distribution of these unique costumes since the person that was originally assigned to this job disappeared. Personally, I don't like the idea of doing this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I just think it's kind of a pity to just give away items like this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_6_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What do you want to know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_6_0_1">
    <VALUE Lang="th">Ask about the Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_6_0_2">
    <VALUE Lang="th">Ask about What Should be Done</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_6_0_3">
    <VALUE Lang="th">Ask about Unique Costumes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_6_0_4">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_7_0">
    <VALUE Lang="th">Ah, are you looking for spare parts to fix the bus? Several people came to collect those same spare parts</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They keep coming back because the buses keep getting involved in accidents.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_7_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_8_0">
    <VALUE Lang="th">All the spare parts have been distributed. The ones we have left aren't what you need.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_9_0">
    <VALUE Lang="th">So you're here to buy some more spare parts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Where'd you get this weird money? Look, I've still got plenty of those things here, and I have no idea where they came from.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_9_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_0">
    <VALUE Lang="th">아, 그거 혹시 열쇠 조각 ...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">잠깐 줘 볼래?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">어쩌면 그 ‘깨달음의 열쇠’ 일지도 모르겠는데!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">정말 ‘깨달음의 열쇠’ 라면 ‘세인트 재단’ 에게서 뭔가를 받기 위한 증표가 될 거야</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_0_1">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_0_2">
    <VALUE Lang="th">열쇠 조각 들을 합친다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_1">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_2">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_3">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_4">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5">
    <VALUE Lang="th">Didn't you have a tough time reaching this place?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are still a few items left, so let me know if you need anything.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_10">
    <VALUE Lang="th">Accept order (Purify Junk Car Yard)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_11">
    <VALUE Lang="th">Report results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_12">
    <VALUE Lang="th">Give the Medicine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_13">
    <VALUE Lang="th">Apply for Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_14">
    <VALUE Lang="th">Check the Test Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_2">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_3">
    <VALUE Lang="th">Investigate Shouting</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_4">
    <VALUE Lang="th">Apply for the Examination</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_5">
    <VALUE Lang="th">Verify the Exam Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_6">
    <VALUE Lang="th">Accept Order (Currency Notes Verification)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_7">
    <VALUE Lang="th">Give the Order Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_8">
    <VALUE Lang="th">Ask about Leonair Campus's Location</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_1_5_9">
    <VALUE Lang="th">Confirmation of Pieces of Map</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_10_0">
    <VALUE Lang="th">It's good that you want to take the examination.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">In any case, students and teachers will have their abilities examined on a regular basis.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I hope you don't mind this too much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_11_0">
    <VALUE Lang="th">Great, you did really well!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now that you've grown stronger and reached your current level, you'll easily be able to handle the dangers that lie ahead.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Don't rest on your laurels, though: you'll need to regularly take ability examinations to keep in good shape.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_11_0_1">
    <VALUE Lang="th">Accept Order (Currency Notes Verification)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_11_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_12_0">
    <VALUE Lang="th">The Cleaner gave me these things before he left.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes, actually it doesn't look any different from regular money, but you can tell it's counterfeit if you look very carefully.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This counterfeit was skillfully crafted. I'm sure that it'd easily pass for genuine money.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_12_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_13_0">
    <VALUE Lang="th">Looks like these Currency Notes contain something important. For now, it'd be wise to pick up items that people drop on the streets.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_13_0_1">
    <VALUE Lang="th">Ask about Leonair Campus's Location</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_14_0">
    <VALUE Lang="th">I am pretty sure that it was located near the Trading Hole Passage, but one day it suddenly disappeared!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_14_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_15_0">
    <VALUE Lang="th">It's perfect! The pieces of the map still exist. Even the teachers weren't aware of this!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_15_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_16_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I need someone to do something for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll continue to do my part to help clear up this situation in order to ensure the safety of the students as well as the citizens.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Unfortunately, the mobs plaguing this area have multiplied dramatically.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_16_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_17_0">
    <VALUE Lang="th">Well done!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Sacred Financial Group will always appreciate your help in transporting reinforcements and supplies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_18_0">
    <VALUE Lang="th">You came at the right time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It would be unwise to say that we can hold up for another week.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Although this situation is temporary, we will still need to know how to solve these kinds of problems in the future.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_18_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_19_0">
    <VALUE Lang="th">....3</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_2_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_2_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_2_0_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_20_0">
    <VALUE Lang="th">Good! Do you remember now?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_20_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_21_0">
    <VALUE Lang="th">...4</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_22_0">
    <VALUE Lang="th">I don't have the time to explain these things to you. I'll just sum it up in one sentence.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There aren't many normal people around this here. Please be careful in approaching strangers.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_22_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_23_0">
    <VALUE Lang="th">....10</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_24_0">
    <VALUE Lang="th">Our enemies are growing in power.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They're becoming better skilled, and their numbers are gradually increasing. They'll become quite formidable if left unchecked.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We can't relax and just assume that we're better than them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_24_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_25_0">
    <VALUE Lang="th">......12</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_26_0">
    <VALUE Lang="th">Moreover, this currency looks like it has ancient writing that probably has some hidden meaning.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please take this money for note verification.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_26_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_27_0">
    <VALUE Lang="th">You need to take these to the Technical Teacher.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_27_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_28_0">
    <VALUE Lang="th">....14</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_29_0">
    <VALUE Lang="th">Moreover, the place is now filled with weird mobs that appeared shortly after the abnormal phenomenon began.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_29_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_3_0">
    <VALUE Lang="th">You should know the answers to your own questions. It's not your first time here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Your point of reference should be the Sacred Gate Park: to its right is the Phoenix Campus, to the left is Mystic Peak Campus, and to the south is Sacred Gate Campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_30_0">
    <VALUE Lang="th">The big problem right now is to confirm the exact location of Leonair Campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We have received contrasting information regarding its location. Some say it's south of Sacred Gate Park, while others say it's to the north.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's really confusing, and the only way to pinpoint its exact location is to go there ourselves.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_30_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_31_0">
    <VALUE Lang="th">It's a good thing that Cheng Xi Zhi, a student in the Archery Section, was able to verify the location of Leonair Campus and was able to draw a map.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Unfortunately, the map was stolen and torn to pieces. We still don't know who did it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_31_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_32_0">
    <VALUE Lang="th">The identities of the thieves aren't important.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Right now, we need to find the pieces of that map.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_32_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_33_0">
    <VALUE Lang="th">I heard that there were some clowns in the area when the map was torn up.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you think this clue will be enough to lead us to the pieces of the map?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_33_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_34_0">
    <VALUE Lang="th">.....15</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_35_0">
    <VALUE Lang="th">We have fewer than 7 pieces of the map, and they're all in pretty bad condition.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_35_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_36_0">
    <VALUE Lang="th">Even if it seems impossible, I have to try and put these pieces together.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The writing is sloppy, the drawings look terrible, the paper is crumpled, and the edges of the pieces just don't fit together right...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_36_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_37_0">
    <VALUE Lang="th">The Student Director is experienced in working with archeological evidence. Maybe he might be able to put those torn pieces of paper back together.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_37_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_38_0">
    <VALUE Lang="th">....16</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_39_0">
    <VALUE Lang="th">We can't let a lack of manpower deter us from stopping this evil from spreading. The consequences will be catastrophic if we fail.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It'd be advisable to address the problem now before it gets out of control.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_39_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_4_0">
    <VALUE Lang="th">C'mon! Don't make your teacher feel bad by acting like you don't care.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Huh? Where'd the teacher go?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_40_0">
    <VALUE Lang="th">....18</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_41_0">
    <VALUE Lang="th">Please help me retrieve the medicines listed on this document.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_41_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_42_0">
    <VALUE Lang="th">Your mission is to slay the monster called Ice Master.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I won't give you a time limit like in past missions, so give it your best shot.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_42_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_43_0">
    <VALUE Lang="th">You beat the Ice Master? I guess you can handle the cold.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway, you pass the mission.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_43_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_44_0">
    <VALUE Lang="th">Are you going to Root Hole?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's strange that time has stopped. I thought the 공간축 might have changed...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I knew that the Saint building is located in Root Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hopefully, you'll be able to have a look inside Root Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_44_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_5_0">
    <VALUE Lang="th">득도의 경지에 이른 ‘마루치’ 와 ‘아라치’ 의 기운이 서로 만날 때 이르는 경지를 가리키는 말인데</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">본래는 소승불교에서 모든 번뇌를 뚫고 이치를 깨달아 열반의 경지에 이른 성자를 말이고 ‘나한’ 이라고도 하지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_5_0_1">
    <VALUE Lang="th">'깨달음의 열쇠' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_5_0_2">
    <VALUE Lang="th">'나한의 구슬' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_5_0_3">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_6_0">
    <VALUE Lang="th">그 열쇠를 지니고 있다면 재단에 보관중인 걸 받을 수도 있게 된다는 얘기는 들었지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">하지만 지금은 조각조각으로 나뉘어져 있을테니까 일단 7조각을 모으게 되면 나한테 가져오도록 해</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_6_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_7_0">
    <VALUE Lang="th">아, 그 녹색 구슬 말이지?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그냥 하나씩만으로는 별다를 게 없는데 30개를 다 합쳐서 목걸이를 만들면 꽤 쓸만해 진다지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_7_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_8_0">
    <VALUE Lang="th">Okay, let's see...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How shall I say this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_8_0_1">
    <VALUE Lang="th">Ask for Directions</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_8_0_2">
    <VALUE Lang="th">Ask about Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_9_0">
    <VALUE Lang="th">Ah, I've heard the Construction Supervisor mention this before. I really appreciate that you accepted my request.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It'd be wise to accept all the help you can get. Keep up the good work.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_9_0_1">
    <VALUE Lang="th">Apply for Examination</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_9_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_0">
    <VALUE Lang="th">Welcome to the Brawler Section! Please go to your respective trainers if you do not belong to this section.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_0_2">
    <VALUE Lang="th">Announce Situation for New Students</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1">
    <VALUE Lang="th">Can I assist you with anything?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_10">
    <VALUE Lang="th">Ask about 5 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_11">
    <VALUE Lang="th">Ask about 6 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_12">
    <VALUE Lang="th">Ask about 7 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_13">
    <VALUE Lang="th">Ask about 8 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_14">
    <VALUE Lang="th">Ask about 9 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_15">
    <VALUE Lang="th">Ask about 10 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_16">
    <VALUE Lang="th">Ask about 11 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_17">
    <VALUE Lang="th">Ask about 12 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_18">
    <VALUE Lang="th">Ask about 13 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_19">
    <VALUE Lang="th">Ask about 14 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_2">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_20">
    <VALUE Lang="th">Ask about 15 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_21">
    <VALUE Lang="th">Ask about 16 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_22">
    <VALUE Lang="th">Ask about 17 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_23">
    <VALUE Lang="th">Ask about 18 Spiritual Spheres</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_1_1_24">
    <VALUE Lang="th">Ask about 20 Spiritual Spheres</VALUE>
  </SENTENSE>
