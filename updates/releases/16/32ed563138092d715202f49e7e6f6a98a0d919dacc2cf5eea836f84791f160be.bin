  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0">
    <VALUE Lang="th">Clitter-clatter! Do you know who I am? If you get the answer, I’ll give you a good thing. Uh-oh! Nothing comes for free! I want something sweet. Nothing is going to happen with that small candy! Bring me big one!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">5 Halloween candies = Test Paper I</VALUE>
    <VALUE Lang="th">5 Halloween candies + 1 Big Halloween silver lollipop = Test Paper II</VALUE>
    <VALUE Lang="th">5 Halloween candies + 1 Big Halloween gold lollipop = Test Paper III</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0_4">
    <VALUE Lang="th">Exchange 5 candies to Test Paper I.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0_5">
    <VALUE Lang="th">Exchange 5 candies and 1 big silver lollipop to Test Paper II.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0_6">
    <VALUE Lang="th">Exchange 5 candies and 1 big gold lollipop to Test Paper III.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0">
    <VALUE Lang="th">Hi~ Do you like candy? If you don't, would you give candy to me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">2 Halloween candies = Pet skin card [Jack-o’-Lantern] (15days)</VALUE>
    <VALUE Lang="th">1 Big Halloween silver lollipop = 1 Pumpkin box</VALUE>
    <VALUE Lang="th">1 Big Halloween gold lollipop = Death bike (30days)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_1">
    <VALUE Lang="th">Exchange 2 candies to Pet skin card.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_2">
    <VALUE Lang="th">Exchange Big silver lollipop to Pumpkin box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_3">
    <VALUE Lang="th">Exchange Big gold lollipop to Death bike(30days)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_4">
    <VALUE Lang="th">Exchange candies.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0">
    <VALUE Lang="th">You did well getting here. It was really hard to find me huh?</VALUE>
    <VALUE Lang="th">Now, let me show you the magic crafting an special item with the badges and cards~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0_1">
    <VALUE Lang="th">What ingredients do you need to make the special item?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0_2">
    <VALUE Lang="th">I get the ingredients, just make me the item!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_2_0">
    <VALUE Lang="th">Pierrot Badge 50ea + Joker Badge 40ea</VALUE>
    <VALUE Lang="th">= Jester King's Hat</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Pierrot Badge 75ea + Joker Badge 50ea +</VALUE>
    <VALUE Lang="th">Joker Card 50ea</VALUE>
    <VALUE Lang="th">= Joker Look Box (7D)</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Pierrot Badge 100ea + Joker Badge 75ea +</VALUE>
    <VALUE Lang="th">Joker Card 75ea</VALUE>
    <VALUE Lang="th">= Joker Bike (7D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_2_0_1">
    <VALUE Lang="th">Okay! Now, make me the item!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0">
    <VALUE Lang="th">Which item do you want me to make you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_1">
    <VALUE Lang="th">I want the Jester King's Hat!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_2">
    <VALUE Lang="th">I want the Joker Look Box!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_3">
    <VALUE Lang="th">I want the Joker Bike!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_0">
    <VALUE Lang="th">Wow, you have defeated Medusa! Go and collect the trophies.</VALUE>
    <VALUE Lang="th">I will compound them for you!</VALUE>
    <VALUE Lang="th">________________________________________________________</VALUE>
    <VALUE Lang="th">[Recipes]</VALUE>
    <VALUE Lang="th">Hair of Medusa (30ea) + Snake Scale (30ea)</VALUE>
    <VALUE Lang="th">+ Piece of Snake Stone (30ea) + Vitality of Medusa (10ea)</VALUE>
    <VALUE Lang="th">+ 100,000 Gold = Medusa Trophy A</VALUE>
    <VALUE Lang="th">/</VALUE>
    <VALUE Lang="th">Hair of Medusa (30ea) + Snake Scale (30ea)</VALUE>
    <VALUE Lang="th">+ Piece of Snake Stone (30ea) + Vitality of Medusa (10ea)</VALUE>
    <VALUE Lang="th">+ Goggle of Protection (7D)(1ea) = Medusa Trophy B</VALUE>
    <VALUE Lang="th">________________________________________________________</VALUE>
    <VALUE Lang="th">Compound may fail but the Goggle of Protection lowers the fail percentage.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_0_1">
    <VALUE Lang="th">Compound the Trophies.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1">
    <VALUE Lang="th">Do you know that the year 2013 is the year of the Snake?</VALUE>
    <VALUE Lang="th">Due to the forces of snake has gotten too strong, Medusa has appeared in the world of Ran and corrupting it. We need you students to save the world of Ran.I won't be a much help since I am not a fighting type but I can always give you advice.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_1">
    <VALUE Lang="th">How can I summon Medusa?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_2">
    <VALUE Lang="th">Please advice me how to defeat Medusa.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_3">
    <VALUE Lang="th">I have defeated Medusa!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0">
    <VALUE Lang="th">You need get flute first to summon Medusa. You will be able to get it easily, just wander around in the world of Ran.</VALUE>
    <VALUE Lang="th">But, according to the level of students, different flutes are required and different Medusas will be summoned from different flutes.</VALUE>
    <VALUE Lang="th">Each Medusa will give different reward.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0_1">
    <VALUE Lang="th">Oh, I see! Can you give me some advice, how to defeat Medusa?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0_2">
    <VALUE Lang="th">I have defeated Medusa. Can I get the reward?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0">
    <VALUE Lang="th">Medusa is powerful and she will turn all the onlookers of her eyes into stones so please be extra careful. If you have a Goggle of Protection then you will be able to defeat her much easier. Plus, such goggle will be useful when you get the reward.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0_1">
    <VALUE Lang="th">Please tell me how to summon Medusa once more.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0_2">
    <VALUE Lang="th">I have defeated Medusa. Can I get the reward?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_4_0">
    <VALUE Lang="th">Wow, you have defeated Medusa! Go and collect the trophies.</VALUE>
    <VALUE Lang="th">I will compound them for you!</VALUE>
    <VALUE Lang="th">________________________________________________________</VALUE>
    <VALUE Lang="th">[Recipes]</VALUE>
    <VALUE Lang="th">Hair of Medusa (30ea) + Snake Scale (30ea)</VALUE>
    <VALUE Lang="th">+ Piece of Snake Stone (30ea) + Vitality of Medusa (10ea)</VALUE>
    <VALUE Lang="th">+ 100,000 Gold = Medusa Trophy A</VALUE>
    <VALUE Lang="th">/</VALUE>
    <VALUE Lang="th">Hair of Medusa (30ea) + Snake Scale (30ea)</VALUE>
    <VALUE Lang="th">+ Piece of Snake Stone (30ea) + Vitality of Medusa (10ea)</VALUE>
    <VALUE Lang="th">+ Goggle of Protection (7D)(1ea) = Medusa Trophy B</VALUE>
    <VALUE Lang="th">________________________________________________________</VALUE>
    <VALUE Lang="th">Compound may fail but the Goggle of Protection lowers the fail percentage.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_4_0_1">
    <VALUE Lang="th">Compound the Trophies.</VALUE>
  </SENTENSE>
