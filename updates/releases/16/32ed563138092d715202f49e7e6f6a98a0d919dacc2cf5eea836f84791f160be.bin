    <VALUE Lang="th">Ask questions about Skills</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_shop1_c.ntk_9_0_5">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_suryun_1.ntk_1_0">
    <VALUE Lang="th">Welcome to the Training Yard!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Feel free to explore and use the facilities available in this area. If you would like to move to another area or Campus, then you may take one of the many buses here. Please remember to have your Bus Ticket ready before using the Bus Services.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can change your Save Point here if you like.</VALUE>
