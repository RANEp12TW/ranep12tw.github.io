  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0">
    <VALUE Lang="th">Exchange your 'Check In Badges' here!</VALUE>
    <VALUE Lang="th">No rebate once exchanged! Please be advised, no rebate once exchanged!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_1">
    <VALUE Lang="th">How can I get a Check In Badge?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_2">
    <VALUE Lang="th">Exchange 10 Check In Badges for a 'I-Ran Man Suit Prototype (7D)'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_3">
    <VALUE Lang="th">Exchange 15 Check In Badges for a 'I-Ran Man Suit Prototype (15D)'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_4">
    <VALUE Lang="th">Exchange 20 Check In Badges for a 'I-Ran Man Suit Prototype (30D)'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_2_0">
    <VALUE Lang="th">‘Check In Badges’ can be acquired from the Student Counselor NPC at the Market Place during the event. Please note that you need to be logged on at least 30 minutes or more and Ran Time is applied so don’t forget to watch the time.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_1_0">
    <VALUE Lang="th">This Machine is operating normally!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_1_0_11">
    <VALUE Lang="th">Start Authentication</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_1_0_12">
    <VALUE Lang="th">Change Tax Rate</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_2_0">
    <VALUE Lang="th">네트워크 연결상태 불량으로 인해 정보 검색은 할 수 없습니다</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_2_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_3_0">
    <VALUE Lang="th">Set the tax rate within the governed area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The default setting is 5.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_3_0_1">
    <VALUE Lang="th">Change Tax Rate</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_3_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0">
    <VALUE Lang="th">Welcome!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0_10">
    <VALUE Lang="th">Change Save Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0_11">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0_12">
    <VALUE Lang="th">Ask about [E]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0_13">
    <VALUE Lang="th">Hand over 'Master CD'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_10_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_10_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_11_0">
    <VALUE Lang="th">There are powers of Dragon, Tiger, Phoenix and Turtle at Sacred Gate, Mystic Peak, Phoenix and Trading Hole. However, these powers were too strong and gave damages to people. Therefore, 'Director' had built the E-Rooms at where there was too much power to seal it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_11_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_12_0">
    <VALUE Lang="th">Since then, people found a way to use the holy power after continuous research. However, it was coded and 'Master CD' given at 'Lead Club' authentication is needed. If you give me the 'Master CD', I will help you use it temporarily.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_12_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0">
    <VALUE Lang="th">Decoding is done. Please select the class which you would like to receive weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0_1">
    <VALUE Lang="th">Swordsman</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0_2">
    <VALUE Lang="th">Brawler</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0_3">
    <VALUE Lang="th">Archer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0_4">
    <VALUE Lang="th">Shaman</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0_5">
    <VALUE Lang="th">Science</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0_6">
    <VALUE Lang="th">Assassin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0_7">
    <VALUE Lang="th">Magician</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0_8">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_14_0">
    <VALUE Lang="th">Ok, then pick the type of weapon you prefer.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
