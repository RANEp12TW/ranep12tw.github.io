  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_35_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_35_0_4">
    <VALUE Lang="th">Exchange Item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_35_0_5">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_36_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_36_0_4">
    <VALUE Lang="th">Exchange Item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_36_0_5">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_37_0">
    <VALUE Lang="th">.......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_38_0">
    <VALUE Lang="th">Destiny has chosen students to join the Shaman Section.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_38_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_39_0">
    <VALUE Lang="th">The power of your skills lies in your understanding of the Universe's Spirit.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Remember that your goals are not geared toward destruction.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_39_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_4_0">
    <VALUE Lang="th">Focusing Stat points to Intelligence will develop a character that will be good at Support.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_4_0_1">
    <VALUE Lang="th">Ask about Enemy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_4_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_40_0">
    <VALUE Lang="th">......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_41_0">
    <VALUE Lang="th">Those enemies are just clones of mobs whose minds are unstable.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They are the opposite of people whose souls are free.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_41_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_42_0">
    <VALUE Lang="th">There are times when you must grant death to free those trapped spirits.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_42_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_43_0">
    <VALUE Lang="th">하지만... 언젠가는 살인이라는 걸 하기 싫어도 해야 할 때가 올 거야. 그때는...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_43_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_44_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_45_0">
    <VALUE Lang="th">You must always stay behind your partners, and back them up. Support them so that they can use the full extent of their powers.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_45_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_46_0">
    <VALUE Lang="th">.......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_47_0">
    <VALUE Lang="th">You should have more than enough Skill Points at the beginning since the starting skills won't require many Skill Points.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll find, however, that you might not have enough points to learn some of the later skills. Think and plan carefully, and choose the essential skills that you want to learn.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_47_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_48_0">
    <VALUE Lang="th">하지만 나중엔 모자라서 배울 수도 있는 스킬을 못배우고 썩히게 될 경우가 생길 수도 있으니까 잘 생각해 보고 꼭 필요한 스킬만 익히도록.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_48_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_49_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_5_0">
    <VALUE Lang="th">Ah! Don't worry, you're not suited for killing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_5_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_50_0">
    <VALUE Lang="th">You need to go to the School Administration Office for student registration. It is located near the Welfare Society.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Look for the Student Director so he can assist you in your registration.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can get your wounds treated at the First-Aid Room. You'd better know how to get there. Sooner or later, you're probably going to get injured!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_50_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_51_0">
    <VALUE Lang="th">......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_52_0">
    <VALUE Lang="th">We are conducting an investigation of the case.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please remember that the evil can't control everyone!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_52_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_53_0">
    <VALUE Lang="th">There aren't too many normal human beings around anymore. Most have already been transformed into evil monsters. Although it's a really bad situation, it's not like things can't be changed for the better.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please remember this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_53_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_54_0">
    <VALUE Lang="th">The teachers are doing all that they can to return things back the way they should be.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_54_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_55_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_56_0">
    <VALUE Lang="th">Like I said before, these violent monsters are wrecking our campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please get out there, and keep them from causing even more destruction.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_56_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_57_0">
    <VALUE Lang="th">Know that carelessness may result in you ending up in a really bad situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Remember that you'll be entering a world full of dangers once you submit the Exit Approval Form. Please be careful out there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_57_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_58_0">
    <VALUE Lang="th">외출 신청서를 써 내면 그걸로 너는 그 위험 속으로 들어가게 된다는 걸 명심하고 마음 단단히 먹도록 해!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_58_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_59_0">
    <VALUE Lang="th">.....4-1</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_6_0">
    <VALUE Lang="th">Your character build is not suited for battle.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_60_0">
    <VALUE Lang="th">It is essential for you to learn how to meditate in peace. This is how you can strengthen your power and eventually tap into your full potential.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Given the current situation, however, there isn't time to think about that now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_60_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_61_0">
    <VALUE Lang="th">You will need skills that can inflict direct damage to your enemies when you must face them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You are awarded 3 Stat Points each time your character levels up. Your character's build and growth is determined by how these Stat Points are allocated to your character's attributes.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_61_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_62_0">
    <VALUE Lang="th">Primarily investing Stat Points in Strength, followed by Dexterity, will develop a Spear Type character that will have strong close-ranged abilities.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_62_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_63_0">
    <VALUE Lang="th">You can also allocate Stat Points equally to Strength, Dexterity, and Intelligence to build an Attack Type character.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Focusing your Stat Points in Intelligence will develop a Supportive Type character.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_63_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_64_0">
    <VALUE Lang="th">Oh... So you saw the List of Saints.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's true that there's nothing wrong with the list.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah, but you're probably curious about what's behind it. Am I right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why are there so many students with family problems?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's quite simple, actually.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not too many loving parents would send their children to an experimental school.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even if extraordinary benefits were offered, most parents would think that traditions set by normal schools are more important.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_64_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_65_0">
    <VALUE Lang="th">Many people raise this question...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What is forgiveness, and does it work?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, but it's not like I have the right to teach you anything.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why should I force what little I know upon you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You know that there are arenas in the Trading Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can find teachers that can teach you more over there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_65_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_66_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_67_0">
    <VALUE Lang="th">What?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now, I've told you that you needed to be ready for this situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Well, it's too late now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Maybe you can find the items you need in the Resource Room.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_67_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_68_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_68_0_4"><VALUE Lang="tw">兌換 螺旋槍（197級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Spiral Spear (Lv197, Class=520, Item=176/15)</VALUE><VALUE Lang="id">Skill book: Spiral Spear (Lv197, Class=520, Item=176/15)</VALUE><VALUE Lang="cn">Skill book: Spiral Spear (Lv197, Class=520, Item=176/15)</VALUE><VALUE Lang="th">Skill book: Spiral Spear (Lv197, Class=520, Item=176/15)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_68_0_5"><VALUE Lang="tw">兌換 狂野風暴（177級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Wild Storm (Lv177, Class=520, Item=176/36)</VALUE><VALUE Lang="id">Skill book: Wild Storm (Lv177, Class=520, Item=176/36)</VALUE><VALUE Lang="cn">Skill book: Wild Storm (Lv177, Class=520, Item=176/36)</VALUE><VALUE Lang="th">Skill book: Wild Storm (Lv177, Class=520, Item=176/36)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_68_0_6"><VALUE Lang="tw">兌換 天界裁決（177級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Umpire of Heaven (Lv177, Class=520, Item=176/57)</VALUE><VALUE Lang="id">Skill book: Umpire of Heaven (Lv177, Class=520, Item=176/57)</VALUE><VALUE Lang="cn">Skill book: Umpire of Heaven (Lv177, Class=520, Item=176/57)</VALUE><VALUE Lang="th">Skill book: Umpire of Heaven (Lv177, Class=520, Item=176/57)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_68_0_7">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_69_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_69_0_4"><VALUE Lang="tw">兌換 死亡之影（187級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Shadow of Death (Lv187, Class=520, Item=176/17)</VALUE><VALUE Lang="id">Skill book: Shadow of Death (Lv187, Class=520, Item=176/17)</VALUE><VALUE Lang="cn">Skill book: Shadow of Death (Lv187, Class=520, Item=176/17)</VALUE><VALUE Lang="th">Skill book: Shadow of Death (Lv187, Class=520, Item=176/17)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_69_0_5"><VALUE Lang="tw">兌換 冰霰（197級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Ice Pellet (Lv197, Class=520, Item=176/38)</VALUE><VALUE Lang="id">Skill book: Ice Pellet (Lv197, Class=520, Item=176/38)</VALUE><VALUE Lang="cn">Skill book: Ice Pellet (Lv197, Class=520, Item=176/38)</VALUE><VALUE Lang="th">Skill book: Ice Pellet (Lv197, Class=520, Item=176/38)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_69_0_6"><VALUE Lang="tw">兌換 堅毅守護（197級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Rigid Defender (Lv197, Class=520, Item=176/59)</VALUE><VALUE Lang="id">Skill book: Rigid Defender (Lv197, Class=520, Item=176/59)</VALUE><VALUE Lang="cn">Skill book: Rigid Defender (Lv197, Class=520, Item=176/59)</VALUE><VALUE Lang="th">Skill book: Rigid Defender (Lv197, Class=520, Item=176/59)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_69_0_7">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_7_0">
    <VALUE Lang="th">Skill Points are set at 0 at the start. Each time your character's level increases, you will be awarded with 1 Skill Point. You can use these Skill Points to learn new skills or upgrade existing skills.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Most skills will require you to consume Skill Points in order to learn them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_7_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_70_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_70_0_4"><VALUE Lang="tw">兌換 龍之波動（207級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Dragon Wave (Lv207, Class=520, Item=176/18)</VALUE><VALUE Lang="id">Skill book: Dragon Wave (Lv207, Class=520, Item=176/18)</VALUE><VALUE Lang="cn">Skill book: Dragon Wave (Lv207, Class=520, Item=176/18)</VALUE><VALUE Lang="th">Skill book: Dragon Wave (Lv207, Class=520, Item=176/18)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_70_0_5"><VALUE Lang="tw">兌換 旋風（207級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Whirlwind (Lv207, Class=520, Item=176/39)</VALUE><VALUE Lang="id">Skill book: Whirlwind (Lv207, Class=520, Item=176/39)</VALUE><VALUE Lang="cn">Skill book: Whirlwind (Lv207, Class=520, Item=176/39)</VALUE><VALUE Lang="th">Skill book: Whirlwind (Lv207, Class=520, Item=176/39)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_70_0_6"><VALUE Lang="tw">兌換 迅捷（207級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Swift (Lv207, Class=520, Item=176/60)</VALUE><VALUE Lang="id">Skill book: Swift (Lv207, Class=520, Item=176/60)</VALUE><VALUE Lang="cn">Skill book: Swift (Lv207, Class=520, Item=176/60)</VALUE><VALUE Lang="th">Skill book: Swift (Lv207, Class=520, Item=176/60)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_70_0_7">
    <VALUE Lang="th">Learn Lightning Thunder IV</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_70_0_8">
    <VALUE Lang="th">Learn Inner Vitality IV</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_70_0_9">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_71_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
