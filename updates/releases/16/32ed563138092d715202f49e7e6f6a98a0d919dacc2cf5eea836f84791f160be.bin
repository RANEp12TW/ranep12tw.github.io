    <VALUE Lang="th">This is the 50th floor security Terminal.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The ID and Password are required to enter 50th floor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please enter the ID and password.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_1_1_1">
    <VALUE Lang="th">Enter ID and Password</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_1_2">
    <VALUE Lang="th">The 50th floor pass permission is already confirmed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">50th floor gate is opened.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_2_0">
    <VALUE Lang="th">The password is verified.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The 30th floor pass permission is confirmed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_2_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_3_0">
    <VALUE Lang="th">Each security agent has an encrypted part of the ID and Password.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you want to enter, you should complete the ID and Password by getting the permissions from each agent.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
