  <SENTENSE Ver="1" Id="2016_oblivionpotione.ntk_2_0">
    <VALUE Lang="th">Thank you for playing Ran Online. Please keep supporting us.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event1.ntk_1_0">
    <VALUE Lang="th">Hm.. Who should I harrass next~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event1.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event1.ntk_1_1">
    <VALUE Lang="th">Trick or treat !</VALUE>
    <VALUE Lang="th">If you don’t give me some candies, I will follow and harrass you forever!</VALUE>
    <VALUE Lang="th">But, if you do, I will exchange them for some presents~</VALUE>
    <VALUE Lang="th">Quick, give me some candies!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event1.ntk_1_1_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event2.ntk_1_0">
    <VALUE Lang="th">Where did the Playful Witch go...</VALUE>
    <VALUE Lang="th">Hopefully she is not messing around again..?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event2.ntk_1_1">
    <VALUE Lang="th">Careful! The Playful Witch might harrass you..</VALUE>
    <VALUE Lang="th">But, if you take this candy from me everyday~</VALUE>
    <VALUE Lang="th">And give them to her, you will be safe!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event2.ntk_1_1_1">
    <VALUE Lang="th">Receive Candy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event2.ntk_2_0">
    <VALUE Lang="th">Happy Halloween then~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event2.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_reformcardcampaign.ntk_1_0">
    <VALUE Lang="th">Come back when you reach level 195.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_reformcardcampaign.ntk_1_1">
    <VALUE Lang="th">Hi~ Thank you for coming, let's keep our game clean from items with unusual stats! Please reform your items with these Reform Cards. Be careful though, the Reform Cards will vanish after an hour!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_reformcardcampaign.ntk_1_1_1">
    <VALUE Lang="th">Receive 5 pieces Reform Card</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_reformcardcampaign.ntk_2_0">
    <VALUE Lang="th">Do not forget to use your free Reform Card or it will be vanished after 1 hour ^^</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_reformcardcampaign.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_sep_event.ntk_1_0">
    <VALUE Lang="th">Wh..Who are you..? Mom said not to talk to strangers..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_sep_event.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_sep_event.ntk_1_1">
    <VALUE Lang="th">H.. Hi..? I am called Rabunnyand I am from the Moon~</VALUE>
    <VALUE Lang="th">This Thanksgiving, I have prepared lots of gifts from the Moon!</VALUE>
    <VALUE Lang="th">Actually, I am very shy and that's why it's difficult for me to make friends..</VALUE>
    <VALUE Lang="th">If you could come and talk to me everyday then I will give you my stamp!</VALUE>
    <VALUE Lang="th">Would you like to be my friend..?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_sep_event.ntk_1_1_1">
    <VALUE Lang="th">Let's be friends</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_sep_event.ntk_1_1_3">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_sep_event.ntk_2_0">
    <VALUE Lang="th">Thank you, my friend! See you again tommorow~ bye~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_sep_event.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine1.ntk_1_0">
    <VALUE Lang="th">Hi, can you help me? I'll give reward if you help me out. Would you like to hear my story?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">--------------------------------------------------</VALUE>
    <VALUE Lang="th">You can help me everyday during the event periode. It is not that difficult. Please just listen to my story.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine1.ntk_1_0_1">
    <VALUE Lang="th">Sell Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine1.ntk_1_0_2">
    <VALUE Lang="th">Ok, I am listening.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine1.ntk_2_0">
    <VALUE Lang="th">Finally! I knew you would accept my request! Honestly, there is a girl who I've loved for a long time. But I can't even approach her because I am too shy. Could you go to her and give my love proposal in place of me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">-----------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine1.ntk_2_0_1">
    <VALUE Lang="th">Give me the invitation card</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine1.ntk_2_0_2">
    <VALUE Lang="th">Ok, I will help you</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine1.ntk_2_0_3">
    <VALUE Lang="th">Move to Beautiful Wedding chapel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine1.ntk_3_0">
    <VALUE Lang="th">Thank you and good luck! Uh, I am nervous.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">--------------------------------------------------</VALUE>
    <VALUE Lang="th">I want to convey my love to her everyday.. Then hopefully things will go as I have imagined. Either she receives my proposal or not , I will accept the resu</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine1.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine2.ntk_1_0">
    <VALUE Lang="th">Is there are anything you want to talk about?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine2.ntk_1_0_1">
    <VALUE Lang="th">Sell Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine2.ntk_1_0_2">
    <VALUE Lang="th">You are so beautiful</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine2.ntk_1_0_3">
    <VALUE Lang="th">I got something to tell you</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine2.ntk_2_0">
    <VALUE Lang="th">Ah, thank you. I heard that a lot. Is that what you really want to say?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine2.ntk_2_0_1">
    <VALUE Lang="th">I got something to tell you</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine2.ntk_3_0">
    <VALUE Lang="th">…oh, It's his proposal! I'm still wondering whether to accept it or not.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">----------------------------------------------</VALUE>
    <VALUE Lang="th">Please think carefully before choosing, the items that can be obtained will be different.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine2.ntk_3_0_1">
    <VALUE Lang="th">Accept his proposal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016valentine2.ntk_3_0_2">
    <VALUE Lang="th">Refuse his proposal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event1.ntk_1_0">
    <VALUE Lang="th">Welcome to Ran Air~ How can I assist you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event1.ntk_1_1">
    <VALUE Lang="th">Welcome to Ran Air~ dear passenger!</VALUE>
    <VALUE Lang="th">May I see your boarding pass, please?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event1.ntk_1_1_1">
    <VALUE Lang="th">Yes, Please wait! (check your bag)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event1.ntk_2_0">
    <VALUE Lang="th">Your boarding pass is confirmed~</VALUE>
    <VALUE Lang="th">Have a pleasant flight and see you again next time!</VALUE>
    <VALUE Lang="th">Thank you~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event1.ntk_2_0_1">
    <VALUE Lang="th">Please introduce the destination</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event1.ntk_3_0">
    <VALUE Lang="th">The place is famous for it's clear water and blue skies~</VALUE>
    <VALUE Lang="th">There will be a guide once you are there,</VALUE>
    <VALUE Lang="th">please ask him for more information~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_1_0">
    <VALUE Lang="th">Welcome! I am the guide of this place, you can call me Cooler~</VALUE>
    <VALUE Lang="th">Anything I can help you with?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_1_0_1">
    <VALUE Lang="th">I want to know more about the festival!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_1_0_2">
    <VALUE Lang="th">Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_2_0">
    <VALUE Lang="th">Can you see those guys who look like me?</VALUE>
    <VALUE Lang="th">There are treasures put in front of them!</VALUE>
    <VALUE Lang="th">Try to take them if you can~</VALUE>
    <VALUE Lang="th">I think it might be a bit difficult for you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_2_0_1">
    <VALUE Lang="th">That shouldn't be a problem for me!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_3_0">
    <VALUE Lang="th">Nice! Overflowing spirit!</VALUE>
    <VALUE Lang="th">Go go and take them~</VALUE>
    <VALUE Lang="th">Oh! We shouldn't litter during festivals!</VALUE>
    <VALUE Lang="th">If you collect the event waste under the pink crabs,</VALUE>
    <VALUE Lang="th">I will reward you with presents!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_goldcoin.ntk_1_0">
    <VALUE Lang="th">Please come back when you reach level 190 or above.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_goldcoin.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_goldcoin.ntk_1_1">
    <VALUE Lang="th">A precious reward is waiting for you. Receive your gold coin now.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_goldcoin.ntk_1_1_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_goldcoin.ntk_1_1_2">
    <VALUE Lang="th">Receive Gold Coins.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_goldcoin.ntk_2_0">
    <VALUE Lang="th">Come back after 24 hours for your next gold coin.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_level_dungeon.ntk_1_0">
    <VALUE Lang="th">Welcome, Honored Students!</VALUE>
    <VALUE Lang="th">Accept this and use it to save Saint foundation.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_level_dungeon.ntk_1_0_1">
    <VALUE Lang="th">Receive 'Dignitary Ticket'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_level_dungeon.ntk_2_0">
    <VALUE Lang="th">Good luck!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_1_0">
    <VALUE Lang="th">Hello! Nice to see you again~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_1_1">
    <VALUE Lang="th">Hi! Nice to see you again~</VALUE>
    <VALUE Lang="th">Hey hey!! Don't go~ I have a favor to ask!</VALUE>
    <VALUE Lang="th">Wait~ Ta-Da! This is a small present that I have prepared for you!</VALUE>
    <VALUE Lang="th">Please take this entry ticket to the Park of Presents~</VALUE>
    <VALUE Lang="th">You can go there through the gate</VALUE>
    <VALUE Lang="th">so what are you waiting for? go there and collect as many presents as you want!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_1_1_1">
    <VALUE Lang="th">Receive entry ticket to the Park of Presents.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_2_0">
    <VALUE Lang="th">Keep in mind that you only have</VALUE>
    <VALUE Lang="th">30 minutes per day inside so hurry up and collect as many rewards as you can!</VALUE>
    <VALUE Lang="th">Before they are gone! Hurry hurry!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_0">
    <VALUE Lang="th">Hey~ My name is Chloe from Fantasy Forest~</VALUE>
    <VALUE Lang="th">I really like the color green. It makes me feel calm and peaceful~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_0_1">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_1">
    <VALUE Lang="th">Hey~ My name is Chloe from Fantasy Forest~</VALUE>
    <VALUE Lang="th">Come here and listen to my story!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_1_1">
    <VALUE Lang="th">What happened?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_1_2">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_0">
    <VALUE Lang="th">Clover represent good luck~</VALUE>
    <VALUE Lang="th">I want to wish everyone here good luck for the whole year!</VALUE>
    <VALUE Lang="th">But wouldn't it be better if we trade the happiness with good luck?</VALUE>
    <VALUE Lang="th">Use my Blessing and collect Saint Clover during the item buff time.</VALUE>
    <VALUE Lang="th">I will trade your happiness to good luck!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_0_1">
    <VALUE Lang="th">Yeah!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_1">
    <VALUE Lang="th">Clover represent good luck~</VALUE>
    <VALUE Lang="th">I want to wish everyone here good luck for the whole year!</VALUE>
    <VALUE Lang="th">But wouldn't it be better if we trade the happiness with good luck?</VALUE>
    <VALUE Lang="th">Use my Blessing and collect Saint Clover during the item buff time.</VALUE>
    <VALUE Lang="th">I will trade your happiness to good luck!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_1_1">
    <VALUE Lang="th">Yeah!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_2">
    <VALUE Lang="th">Clover represent good luck~</VALUE>
    <VALUE Lang="th">I want to wish everyone here good luck for the whole year!</VALUE>
    <VALUE Lang="th">But wouldn't it be better if we trade the happiness with good luck?</VALUE>
    <VALUE Lang="th">Use my Blessing and collect Saint Clover during the item buff time.</VALUE>
    <VALUE Lang="th">I will trade your happiness to good luck!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_2_1">
    <VALUE Lang="th">Yeah!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_3_0">
    <VALUE Lang="th">Oh! This buff will only last for 1 hour and 30 minutes!</VALUE>
    <VALUE Lang="th">Please keep that in mind!</VALUE>
    <VALUE Lang="th">The, I wish you the best of luck for today…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_0">
    <VALUE Lang="th">coock-a-doddle-doo!! Whe..where is this….?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_0_1">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_1">
    <VALUE Lang="th">Oh, it seems Santa forgot to take me with him...</VALUE>
    <VALUE Lang="th">Please help me get back to Santa by collecting Santa's Trace…!</VALUE>
    <VALUE Lang="th">Ah! Before you go, I will give you some presents~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_1_1">
    <VALUE Lang="th">Receive gift</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_1_2">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_2_0">
    <VALUE Lang="th">You will come back again tomorrow, right?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc1.ntk_1_0">
    <VALUE Lang="th">Come quickly! I have stolen these items from the shop! Come and buy as soon as you can!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc1.ntk_1_0_1">
    <VALUE Lang="th">상점</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc2.ntk_1_0">
    <VALUE Lang="th">Are you looking for something? I can provide you materials in exchange for gold!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc2.ntk_1_0_1">
    <VALUE Lang="th">상점</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc3.ntk_1_0">
    <VALUE Lang="th">I came all the way from the shop with these stolen costumes! Wanna buy? Give me your gold and I'll trade you these items!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc3.ntk_1_0_1">
    <VALUE Lang="th">상점</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_0">
    <VALUE Lang="th">Ah haa…What should I do…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_0_1">
    <VALUE Lang="th">Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_1">
    <VALUE Lang="th">Does she like me..? Or not..?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_1_1">
    <VALUE Lang="th">What can I do?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_1_2">
    <VALUE Lang="th">Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_2_0">
    <VALUE Lang="th">Hey thank goodness you are here!</VALUE>
    <VALUE Lang="th">I have a girl that I liked for a very long time</VALUE>
    <VALUE Lang="th">But I don't know whether she likes me or not... That's why!</VALUE>
    <VALUE Lang="th">Could you please convey my feelings to her?</VALUE>
    <VALUE Lang="th">I am so nervous I can't even speak to her…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_2_0_1">
    <VALUE Lang="th">Hah, it's nothing~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_3_0">
    <VALUE Lang="th">Thank you so much! Ah!</VALUE>
    <VALUE Lang="th">Come to think of it, the mobs have stolen the chocolate that I planned to give her..!</VALUE>
    <VALUE Lang="th">I will repay you if you give her my love and find those chocolates!</VALUE>
    <VALUE Lang="th">I am counting on you!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_1_0">
    <VALUE Lang="th">Hi~ are you hurt? Let me take a look at you…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_1_1">
    <VALUE Lang="th">Hi~ How can I help you? Do you have something to say to me?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_1_1_1">
    <VALUE Lang="th">Explain the situation.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_2_0">
    <VALUE Lang="th">Oh oh I remember!</VALUE>
    <VALUE Lang="th">Not long ago he received a treatment from me!</VALUE>
    <VALUE Lang="th">He said he wanted to get to know me?</VALUE>
    <VALUE Lang="th">Um…Can you let him know that I am interested in him too?</VALUE>
    <VALUE Lang="th">And ask him to come and talk to me directly!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_2_0_1">
    <VALUE Lang="th">Okay! I will tell it to him!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_3_0">
    <VALUE Lang="th">Thank you! Well then, see you next time~ I hope you find your partner soon too~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="costumesell_kr.ntk_1_0">
    <VALUE Lang="th">What do you think about my style? You like my fashion? I am selling a few costumes which will surely change your appearance. You can use Blessed Paper on these costumes too! Come. Take a look!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="costumesell_kr.ntk_1_0_1">
    <VALUE Lang="th">상점열기</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="event_npc_0806.ntk_1_0">
    <VALUE Lang="th">Hello…</VALUE>
    <VALUE Lang="th">Cart Shop is Opened~~</VALUE>
    <VALUE Lang="th">Only some items are available for now, more will be update future~</VALUE>
    <VALUE Lang="th">Please don’t say its expensive, I don’t have so many left~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="event_npc_0806.ntk_1_0_1">
    <VALUE Lang="th">Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="kr_exchange_weapon.ntk_1_0">
    <VALUE Lang="th">If you have the Weapon Exchange Ticket.. Then you will be seeing a lot of me. Feel free to look around.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="kr_exchange_weapon.ntk_1_0_1">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0">
    <VALUE Lang="th">Hmm.. This is not good..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_1">
    <VALUE Lang="th">Ask who he is</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_10">
    <VALUE Lang="th">Deliver the machine parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_11">
    <VALUE Lang="th">Defeat Mutant Guard Dog (Elite)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_2">
    <VALUE Lang="th">Survivor Recon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_3">
    <VALUE Lang="th">Report Survivor Recon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_4">
    <VALUE Lang="th">Gather Info on Hydropower Facility</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_5">
    <VALUE Lang="th">Gather Info on Nuclear Power Facility</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_6">
    <VALUE Lang="th">Gather Info on Solar Power Facility</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_7">
    <VALUE Lang="th">Gather Info on Thermal Power Facility</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_8">
    <VALUE Lang="th">Gather Info on Wind Power Facility</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_9">
    <VALUE Lang="th">Useful Guard Robot</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_10_0">
    <VALUE Lang="th">While I still worked here, there was a Guard Robot built with newest technology. It was 100% robot and was not controlled by humans. I am shocked because it is now half human and half robot because of a virus. I am making a simple machine with Power Researcher P to get inside of a power plant and we need a part that is used to make Guard Robot. Please go defeat them and get me some useful parts.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_10_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_11_0">
    <VALUE Lang="th">It seems to be the right parts. It shall be well used. Thanks! I will inform you when I get close to the basement of a power plant.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_11_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_12_0">
    <VALUE Lang="th">Just like the guard robot, the canines which were guarding this place also got infected to virus. Please defeat the Guard Dog (Elite) which is stronger than the regular ones. It shall buy us some time here.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_12_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_2_0">
    <VALUE Lang="th">I used to be the manager who used to run this place. Back then, I was pitying myself too much did not do my job. I mean I did not want to devote my whole life here at this place. Why? Um.. My dream was not this. I was having hard time getting hold of myself and the high officials have gave me a few months vacation. When I cam back, this place had changed a lot as if time had went fast only in this place.. Something bad must had been done. It was only a few years..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_3_0">
    <VALUE Lang="th">A few years ago I used to run this place. Power equipment? I recently check the place in hope to find my precious CD. CD? It is not something used in the computers. I will be here until I find it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_4_0">
    <VALUE Lang="th">The top priority is to understand current situation so in order to communicate better, would you please go tell the Student Director (Dispatched) about my being here.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_4_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_5_0">
    <VALUE Lang="th">Go down East, you will be able to find a big building. It used to be the place where hydropower plant was.. I think you will be able to find a clue if you investigate the building condition and the various information..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_5_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_6_0">
    <VALUE Lang="th">Check the Nuclear power Plant located at the end of Northeast from the Control Tower. It is the main power source of all the other power plants here.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_6_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_7_0">
    <VALUE Lang="th">There is a very high-tech Solar power Plant at Northwest. I have seen a very powerful mutant. It is almost impossible to get it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_7_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_8_0">
    <VALUE Lang="th">Behind you, there is a thermal power plant very near. We just came from that side. I could not find anything particular but it looked less aged than other facilities.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_8_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_9_0">
    <VALUE Lang="th">There was a wind power plant on the way back. It did not work when I was still the manager here but it must be getting its energy from deep down underground.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_9_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0">
    <VALUE Lang="th">Helping out a student in a trouble is the joy of my life! What can I do for you today? Just tell me..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_1">
    <VALUE Lang="th">Ask for help to find the goods</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_10">
    <VALUE Lang="th">Ask about the attendance book</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_11">
    <VALUE Lang="th">Report the accomplishment</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_12">
    <VALUE Lang="th">Wish you would make a great student</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_13">
    <VALUE Lang="th">Get confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_14">
    <VALUE Lang="th">Report the Voluntary Work result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_15">
    <VALUE Lang="th">School Voluntary Work I</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_16">
    <VALUE Lang="th">Get confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_17">
    <VALUE Lang="th">School Voluntary Work II</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_18">
