  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_2_0">
    <VALUE Lang="th">Thank you for doing me the favor. I wish you good luck in your path.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_1_0">
