  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_7_0_4"><VALUE Lang="tw">兌換 震盪刺擊（67級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Staggering Sting (Lv67, Class=130, Item=175/45)</VALUE><VALUE Lang="id">Skill book: Staggering Sting (Lv67, Class=130, Item=175/45)</VALUE><VALUE Lang="cn">Skill book: Staggering Sting (Lv67, Class=130, Item=175/45)</VALUE><VALUE Lang="th">Skill book: Staggering Sting (Lv67, Class=130, Item=175/45)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_7_0_5"><VALUE Lang="tw">兌換 CP震波（57級／劍道部）</VALUE><VALUE Lang="GS">Skill book: CP Shockwave (Lv57, Class=130, Item=175/66)</VALUE><VALUE Lang="id">Skill book: CP Shockwave (Lv57, Class=130, Item=175/66)</VALUE><VALUE Lang="cn">Skill book: CP Shockwave (Lv57, Class=130, Item=175/66)</VALUE><VALUE Lang="th">Skill book: CP Shockwave (Lv57, Class=130, Item=175/66)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0">
    <VALUE Lang="th">Which skill do you want to learn out of the skills of Grade 8?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0_2"><VALUE Lang="tw">兌換 痛苦吸收（67級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE><VALUE Lang="id">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE><VALUE Lang="cn">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE><VALUE Lang="th">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0_3"><VALUE Lang="tw">兌換 能量吸收（77級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE><VALUE Lang="id">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE><VALUE Lang="cn">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE><VALUE Lang="th">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0">
    <VALUE Lang="th">Which skill do you want to learn out of the skills of Grade 9?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_2"><VALUE Lang="tw">兌換 碧波劍氣（87級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="id">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="cn">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="th">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_3"><VALUE Lang="tw">兌換 震撼噴流（57級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="id">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="cn">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="th">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_4"><VALUE Lang="tw">兌換 無盡怒氣（87級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="id">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="cn">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="th">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_0">
    <VALUE Lang="th">It looks like you are not a magician… I'm not a friendly old man either… Hmmm…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_0_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1">
    <VALUE Lang="th">You must be a Magician, right?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_10">
    <VALUE Lang="th">Suggest ways on how to improve Magician Class.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_2">
    <VALUE Lang="th">Ask the meaning of Dahlia.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_3">
    <VALUE Lang="th">Suggest ways on how to improve Magician Class.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_4">
    <VALUE Lang="th">Receive Crucio's favor.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_5">
    <VALUE Lang="th">Deliver the information you investigated.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_6">
    <VALUE Lang="th">Learn Crucio's First Lesson.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_7">
    <VALUE Lang="th">Learn Crucio's Second Lesson.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_8">
    <VALUE Lang="th">Learn Crucio's Third Lesson.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_9">
    <VALUE Lang="th">Suggest ways on how to improve Magician Class.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_10_0">
    <VALUE Lang="th">I will be waiting here.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_11_0">
    <VALUE Lang="th">I was stupid. I didn't know the truth.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_12_0">
    <VALUE Lang="th">Good luck!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0">
    <VALUE Lang="th">Just try to guess the answer.</VALUE>
    <VALUE Lang="th">You can try again, so don't feel so burdened.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_1">
    <VALUE Lang="th">Passionate Love</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_2">
    <VALUE Lang="th">Everlasting Love</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_3">
    <VALUE Lang="th">My gratitude exceeds your care.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_4">
    <VALUE Lang="th">Pure Soul</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_3_0">
    <VALUE Lang="th">That's what Rose symbolizes. Think again.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_4_0">
    <VALUE Lang="th">That's what Lily symbolizes. Think again.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_4_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_5_0">
    <VALUE Lang="th">You’re right. Let me give you your reward.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_5_0_1">
    <VALUE Lang="th">Receive the reward.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_6_0">
    <VALUE Lang="th">That's what Gypsophila symbolizes. Think again.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_6_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_7_0">
    <VALUE Lang="th">Wish you happy.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_8_0">
    <VALUE Lang="th">Talk with the Magician Instructor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0">
    <VALUE Lang="th">You are looking at an old man , but I was once a great warrior. For the sake of my lover, I fought Valentino, the Great Wizard. Unfortunately, I lost. I ran to the cliff and hid in the cave. I was fortunate that I did not lose my mind and I survived. Can you go to the Sacred gate Police to find out some news about my loved one? I will pass my expertise to you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0_1">
    <VALUE Lang="th">Tell him to accept his favor.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_1_0">
    <VALUE Lang="th">Abra Kadabra~ I am the Animal Trainer. What can I do for you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_1_0_1">
    <VALUE Lang="th">Get a magical animal.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0">
    <VALUE Lang="th">To receive a magical animal, you need to learn the Animal Mastery. Have you learned it?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0_1">
    <VALUE Lang="th">Yes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0_2">
    <VALUE Lang="th">No</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_3_0">
    <VALUE Lang="th">Oh, that's unfortunate! You haven't learned the Animal Mastery yet. Learn it if you got the chance.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0">
    <VALUE Lang="th">You already learned the Animal Mastery, but let me explain this to you first. These animals have skills that you can level up in orders 1 to 4. In doing so, they become stronger. Now, shall we look at these skills?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_1">
    <VALUE Lang="th">Ask about the Tiger.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_2">
    <VALUE Lang="th">Ask about the Cat.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_3">
    <VALUE Lang="th">Ask about the Owl.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0">
    <VALUE Lang="th">The Magician's Tiger</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Order 1. Pull the target towards you for 1.5 seconds , Movement Speed -30%, HP Absorption +10%</VALUE>
    <VALUE Lang="th">Order 2. For 1.5 seconds, Movement Speed -20%, HP Absorption +10%, Skill Range -70</VALUE>
    <VALUE Lang="th">Order 3. For 1.5 seconds quickly approach the target, HP Absorption +10%, Fixed Target, Unable to use Potions</VALUE>
    <VALUE Lang="th">Order 4. Stuns for 0.8 Seconds, HPAbsorption +10%, Defense -10%</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It is mainly equipped with attack skills.</VALUE>
    <VALUE Lang="th">Doesn't it make you want to go to the battlefield with the Tiger??</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0_1">
    <VALUE Lang="th">Get the Tiger</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0">
    <VALUE Lang="th">The Magician's Cat</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Order 1. For 1.5 seconds, every second +100, removes debuff, prevent status abnormalities/ recover</VALUE>
    <VALUE Lang="th">Order 2. For 1.5 seconds, Absorp Physical Damage +10%, Defense +5%, HP+MP+SP Recovery Rate 0.01%</VALUE>
    <VALUE Lang="th">Order 3. For 2 seconds, Attack +15%, Accuracy +30</VALUE>
    <VALUE Lang="th">Order 4. For 1 second, Magic Attack Absorption + 10%, HP Recovery rate +0.2%, Resistance + 20, Attack Speed + 20%, Movement Speed + 20%</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It is mainly equipped with buff skills.</VALUE>
    <VALUE Lang="th">Doesn't it make you want to spend more time with the cute Cat?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0_1">
    <VALUE Lang="th">Get the Cat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_7_0">
    <VALUE Lang="th">The Magician's Owl</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Order 1. For 2 seconds, Defense -10%, Attack Speed -20%, HP Absorption +10%,</VALUE>
    <VALUE Lang="th">Order 2. For 2 seconds, Defense -10%, Skill Delay +10%, HP Absorption +10%</VALUE>
    <VALUE Lang="th">Order 3. For 1.5 seconds, Defense -30%, Accuracy -45, Attack -30%, HP Absorption +10%,</VALUE>
    <VALUE Lang="th">Order 4. For 0.8 seconds, Defense -10%, unable to use skills and potions, HP Absorption +10%</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It is mainly equipped with attack skills.</VALUE>
    <VALUE Lang="th">Don't you want to be with the Owl who can reduce your opponent's abilities?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_7_0_1">
    <VALUE Lang="th">Get the Owl</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_7_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_ruin.ntk_1_0">
    <VALUE Lang="th">The enemies are targeting us day and night so we have to keep our spirits up!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_ruin.ntk_1_0_1">
    <VALUE Lang="th">Item Sale</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_sia.ntk_1_0">
    <VALUE Lang="th">It's the foundation's policy so we can't do anything but looking at the situation right now, I have a bad feeling about this..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_sia.ntk_1_0_1">
    <VALUE Lang="th">Item Sale</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_0">
    <VALUE Lang="th">Uh? Are you student here? I was a student here too, but as you can see, I am very successful now. Hu hu huft</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">--------------------------------------------------</VALUE>
    <VALUE Lang="th">I come here to see my lovely juniors from time to time with tons of presents. You want one? Hu hu huft.. But, I can't just give my present away. Well, I like to party.. Will you go with me? If you do then I can give you all the presents~ Hu hu huft</VALUE>
    <VALUE Lang="th">--------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_0_1">
    <VALUE Lang="th">Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_0_2">
    <VALUE Lang="th">You will give the rewards? How to get it?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_1">
    <VALUE Lang="th">Uh? Are You student here? I was a student here too, but as you can see, I am very successful now. Hu hu huft</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">--------------------------------------------------</VALUE>
    <VALUE Lang="th">I came here to see my lovely juniors from time to time with tons of presents. Um? But you are just too cute. You need to grow up to enjoy the party with me. Come back when you have reached level 30 or higher. Keep working hard and come back because I will be waiting~</VALUE>
    <VALUE Lang="th">---------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_2_0">
    <VALUE Lang="th">Hu Huft. Well, It depends on you. Shall we start the party?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">--------------------------------------------------</VALUE>
    <VALUE Lang="th">If you want to exchange and receive the present, you need to take and use my handmade lunchbox for the buff. When you are in buff status, mobs will drop my beautiful portrait. Get those portraits and exchange them to get the present that you want. Hu huft.. Our party is being held everyday but you only have 3 hours buff after eating my hanmade lunchbox. Good luck</VALUE>
    <VALUE Lang="th">---------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_2_0_1">
    <VALUE Lang="th">Well. I too, know how to party. (Quest Begin)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_3_0">
    <VALUE Lang="th">I like your style~ Let's enjoy the party with me. Hu huft..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">----------------------------------------------</VALUE>
    <VALUE Lang="th">Oh, Here is little tip for you. If you want to complete the daily quest, you must have the party invitation card which can be exchanged with beloved alumni gift box. You can find my hand made lunchbox in the box. Hu huft Good luck!</VALUE>
    <VALUE Lang="th">-----------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_1_0">
    <VALUE Lang="th">시험을 치르기 위해 한 학생이 시험지를 배부받아갔다더니 그게 자네군... 그래 얼마나 열심히 공부했는지 볼까?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_1_0_1">
    <VALUE Lang="th">시험을 시작한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_1_0_3">
    <VALUE Lang="th">반성문을 제출한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_10_0">
    <VALUE Lang="th">음... 그렇다면 기숙사에 있는 쓰레기장에서 청소를 하며 반성문을 모아오시게 그러면 다시한번 생각을 해보겠네.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_10_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_2_0">
    <VALUE Lang="th">축하하네. 학교에 이런학생이 있었다니 가슴이 벅차오르는군. 이 의견서를 교무실에 계신 학생 주임에게 드리게.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_2_0_2">
    <VALUE Lang="th">의견서를 배부받는다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0">
    <VALUE Lang="th">다음 중 함수 y=2x+4의 그래프 위에 있는 점은 무엇인가?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_1">
    <VALUE Lang="th">1. (0,2)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_2">
    <VALUE Lang="th">2. (1,6)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_3">
    <VALUE Lang="th">3. (-1,-2)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_4">
    <VALUE Lang="th">4. (2,6)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0">
    <VALUE Lang="th">남학생은 한 명이 10일 동안 여학생은 한명이 15일 동안 걸려서 할 수 있는 일을 남학생과 여학생을 합해 12명이 하루에 끝내려고 한다. 남학생은 최소한 몇 명이 필요한가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_1">
    <VALUE Lang="th">1. 4명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_2">
    <VALUE Lang="th">2. 5명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_3">
    <VALUE Lang="th">3. 6명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_4">
    <VALUE Lang="th">4. 7명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0">
    <VALUE Lang="th">합이 163인 두 자연수가 있다. 큰 수를 작은 수로 나누면 몫이 7이고 나머지는 3이다. 두 자연수 중에서 작은 수를 구하면 무엇인가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_1">
    <VALUE Lang="th">1. 7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_2">
    <VALUE Lang="th">2. 20</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_3">
    <VALUE Lang="th">3. 52</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_4">
    <VALUE Lang="th">4. 77</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0">
    <VALUE Lang="th">연립 방정식 2x+y=4x-3y=5를 푼다면 과연 x,y의 값은 얼마인가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_1">
    <VALUE Lang="th">1. x=-1, y=3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_2">
    <VALUE Lang="th">2. x=2, y=1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_3">
    <VALUE Lang="th">3. x=-2, y=-1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_4">
    <VALUE Lang="th">4. x=1, y=2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0">
    <VALUE Lang="th">톱니의 수가 30개, 42개인 두 톱니바퀴가 맞물려 돌아가고 있다. 두 톱니가 한 번 맞물린 후 같은 톱니에서 다시 맞물릴 때까지 큰 톱니바퀴는 몇 바퀴를 돌아야 하는가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_1">
    <VALUE Lang="th">1. 3바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_2">
    <VALUE Lang="th">2. 4바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_3">
    <VALUE Lang="th">3. 5바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_4">
    <VALUE Lang="th">4. 6바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_8_0">
    <VALUE Lang="th">아직 수양이 부족한 것 같군. 이래서 어떻게 시험을 볼 생각을 했는지....쯧쯧.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_8_0_1">
    <VALUE Lang="th">다시한번 시험을 치르고 싶다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_9_0">
    <VALUE Lang="th">그렇군 반성문을 적어왔군. 이제는 정말 잘할 자신이 있겠지. 좋아... 다시한번 기회를 주지. 이번에는 잘해보게나</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_9_0_1">
    <VALUE Lang="th">시험을 재도전한다.</VALUE>
  </SENTENSE>

