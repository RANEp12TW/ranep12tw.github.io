  <SENTENSE Ver="1" Id="npc_3_locker.ntk_1_0_1">
    <VALUE Lang="th">Open the Locker</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_1_1">
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_1_2">
    <VALUE Lang="th">The weather is getting cold and gloomy. I'm starting to feel aches and pains in my body.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_1_2_1">
    <VALUE Lang="th">Open the Locker</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_1_2_2">
    <VALUE Lang="th">Ask about Locker Usage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_1_2_3">
    <VALUE Lang="th">Ask about the Campus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_1_2_4">
    <VALUE Lang="th">Return Broom</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_1_2_5">
    <VALUE Lang="th">Borrow Broom</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_2_0">
    <VALUE Lang="th">.......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_3_0">
    <VALUE Lang="th">Of course! Just use these lockers whenever you want. Try to stick to using just one locker space for yourself, alright? Store items that you want to keep and use later inside your locker. You'll need to spend some more money if you want to expand your locker space.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_3_0_1">
    <VALUE Lang="th">Open the Locker</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_3_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_4_0">
    <VALUE Lang="th">Sigh. How do I answer that question? As you probably know, there are 3 Campuses in the area, but there are rumors of a fourth campus. I've heard the teachers and the School Administration talking about the Force-- Force Fiel... Ah yes! The Force Field! I'm not one hundred percent sure, but I think there's something very important about that Force Field. Of all the campuses here, Leonair Campus is the probably the weirdest. I remember that I was just listening to some teachers talking when the sky suddenly change</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I really want to know more about what actually happened. If you guys find important information about that event, please don't forget to let me know, alright?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_4_0_1">
    <VALUE Lang="th">Open the Locker</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_4_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_5_0">
    <VALUE Lang="th">Broom? Oh! That Broom! I really have no idea what's so special about these brooms. Well, if you really think you'll need one, feel free to take it. Please bring it back as soon as you're done using it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_locker.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_main_1.ntk_1_0">
    <VALUE Lang="th">This Terminal controls the entrance and exit to the Main Center.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
