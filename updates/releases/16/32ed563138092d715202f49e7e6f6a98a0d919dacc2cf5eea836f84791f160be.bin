  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_3_0">
    <VALUE Lang="th">Give the stone in your hand to me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It looks important, so let me have a look.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_3_0_1">
    <VALUE Lang="th">Give the Stone to the Police</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_3_0_2">
    <VALUE Lang="th">Put the Stone Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_4_0">
    <VALUE Lang="th">It feels like it just escaped from the passage.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There is a mark on the skin.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It seems like it was caused by the cold air from some unknown place.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It looks like the 3rd passage and the Trading Hole passage have both been captured by beasts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_4_0_1">
    <VALUE Lang="th">Confirm Tunnel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_5_0">
    <VALUE Lang="th">Please report who have died. Even the smallest detail needs to be reported.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_6_0">
    <VALUE Lang="th">It should be enough to prove to the beasts at the passage that we are stronger than them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Just ignore their presence, and go through the passage.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_7_0">
    <VALUE Lang="th">It feels like the pulse is weakening.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Knows how to fall, but not how to stand…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
