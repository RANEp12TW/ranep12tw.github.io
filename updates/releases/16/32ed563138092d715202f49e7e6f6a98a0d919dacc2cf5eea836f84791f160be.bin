  <SENTENSE Ver="1" Id="npc_reformcard.ntk_1_0_1">
    <VALUE Lang="th">Open Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0">
    <VALUE Lang="th">Hi~</VALUE>
    <VALUE Lang="th">I am the Club War Processing Agent.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This club war which will decide the leader club is held at the Saint Complex Research Basement. Clubs will have to authentificate the machines to achieve the target score in the limited time provided.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you need more information?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_1">
    <VALUE Lang="th">Set New Tax</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_2">
    <VALUE Lang="th">Enter the battlefield</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_3">
    <VALUE Lang="th">Obtain Points</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_4">
    <VALUE Lang="th">Accelerator Buff Effect</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_5">
    <VALUE Lang="th">Party Requirements</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_6">
    <VALUE Lang="th">Using Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_7">
    <VALUE Lang="th">Skill Limitations</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_8">
    <VALUE Lang="th">Tax area</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_2_0">
    <VALUE Lang="th">Entry to the Club War is only permitted during the Club War time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Once the Club War starts, you can enter through the gate next to me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_3_0">
    <VALUE Lang="th">You can obtain 10 points every 5 seconds if you manage to authenticate the main central authentication machine.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_4_0">
    <VALUE Lang="th">You can receive useful buffs by destroying the Accelerator Machine located in each area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Try to overturn the tide of battle with the help of 50% reduction on the certification and resurrection time and double points obtaining buffs.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, and please don't forget that the buffs will only last for 3 minutes after the machines is destroyed!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_4_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_5_0">
    <VALUE Lang="th">The points accumulated by the club members will be count into their respective club's points, therefore partying with other club's members is not possible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please note that if a user create a party with another club's members, the party will be disbanded upon entering the Club War.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_5_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_6_0">
    <VALUE Lang="th">Please note that you can't use any consumable items, pet, mounts and card type items inside the S.R.C Basement.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_6_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_7_0">
    <VALUE Lang="th">Resurrection related skills are unusable inside the Saint Research Complex Basement.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">And please also note that immunity, damage ignorance and stealth related skills are unusable while authentificating.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_7_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_8_0">
    <VALUE Lang="th">As the Club War winner, your Guild Master can implement the tax for the payment / purchase in the area. In case desired tax is not set, area's default rate will be implemented.</VALUE>
    <VALUE Lang="th">Would you like to change the tax rate?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_8_0_1">
    <VALUE Lang="th">Set New Tax</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_8_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0">
    <VALUE Lang="th">어서 와라</VALUE>
    <VALUE Lang="th">뭘 도와줄까?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_1">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_2">
    <VALUE Lang="th">검도부에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_3">
    <VALUE Lang="th">수행 방법에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_4">
    <VALUE Lang="th">전투 방법에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_1">
    <VALUE Lang="th">다른 부원들은 다 나가!</VALUE>
    <VALUE Lang="th">정신 사납다.</VALUE>
    <VALUE Lang="th">아니면 뭐냐,</VALUE>
    <VALUE Lang="th">볼 일이라도 있는거냐?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_1_1">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_0">
    <VALUE Lang="th">우선 기본적인 것들을 다시 한번 알려 줄테니 잘 들어.</VALUE>
    <VALUE Lang="th">너희들에겐 레벨업을 하는 순간 3개의 '포인트'가 할당된다.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_1">
    <VALUE Lang="th">호오? 연습을 꽤 했나 보군!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_1_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_11_0">
    <VALUE Lang="th">그리고 그 포인트들을 분배하는 방법에 따라 너희들의 '성장 방향'이 달라지게 되지.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_11_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_12_0">
    <VALUE Lang="th">만약 힘과 체력과 민첩에 분배한다면 검으로 보다 빠른 공격을 할 수 있는 '속공형'이 될테고,</VALUE>
    <VALUE Lang="th">힘에만 집중하다면 검이 아니라 도를 사용하며 파괴력 높은 공격을하는 '필살형'이 될거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_12_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_13_0">
    <VALUE Lang="th">.....5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_0">
    <VALUE Lang="th">선두에 서서 동료들을 지키는게 너희들이 해야 할 일이야.</VALUE>
    <VALUE Lang="th">힘이 있으면 당연히 그래야지!</VALUE>
    <VALUE Lang="th">주의해야 할 점은 검도부원으로서 성장한 너희들이 '스태미너'를 상대적으로 많이 소비한다는 거야</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_1">
    <VALUE Lang="th">이거 정말 대단하군!</VALUE>
    <VALUE Lang="th">너 언제 그렇게 강해진거냐?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_1_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_2_0">
    <VALUE Lang="th">.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0">
    <VALUE Lang="th">어느쪽이 될 지는 선택하기 나름이겠지만 ,</VALUE>
    <VALUE Lang="th">누군가를 보호하기 위할 때에만 상대를 해하는 행동이 용서된다는 걸 명심해.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_1">
    <VALUE Lang="th">'3층'은 레벨이 최소한 '20'은 돼야 하니까, 혹시라도 지금 갈 생각은 하지 않는게 좋을거야!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_1_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_1_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_0">
    <VALUE Lang="th">그리고 힘과 민첩에 2:1 비율로 분배한다면 방어에 중심을 두는 '지구전형'이 되겠고,</VALUE>
    <VALUE Lang="th">마지막으로 힘과 민첩과 기력에 분배한다면 기를 이용할 할 수 있는 '기공형'으로 성장하게 될거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_0_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_1">
    <VALUE Lang="th">그 정도면 학교 밖으로 나가 볼 수도 있겠는데?</VALUE>
    <VALUE Lang="th">나가서 더 실력을 키워봐라!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_1_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_1_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_0">
    <VALUE Lang="th">'스태미너'가 완전히 떨어지게 되면 '명중률'이나 '공격력'이 반감돼 버려서 경우에 따라서는 위험한 상황이 될 수도 있으니 무턱대고 달려 나가기만 하는 행동은 신중히 삼가해야 한다는 점을 항상 명심하고 있도록 해.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_0_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_1">
    <VALUE Lang="th">너라면 지하 괴물들까지 청소해 버릴 수도 있겠는데?!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_1_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_1_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_6_0">
    <VALUE Lang="th">....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_0">
    <VALUE Lang="th">음... 검도부라...</VALUE>
    <VALUE Lang="th">그런 걸 한마디로 말 하자면...</VALUE>
    <VALUE Lang="th">그래, 힘을 지닌 자들이 배워야 할 기술이라고 할 수 있겠군.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_1">
    <VALUE Lang="th">그 정도 실력으로 검도부의 본질을 알고 싶다고?</VALUE>
    <VALUE Lang="th">아직 멀어도 한참 멀었으니, 가서 더 수련하고 와!</VALUE>
    <VALUE Lang="th">너라면 '2층'이 아마 적당할 거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_1_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_8_0">
    <VALUE Lang="th">힘이 있으면 할 수 있는 일이 두 가지가 있는데,</VALUE>
    <VALUE Lang="th">누군가를 해하는 것과 그리고 누군가를 보호하는 것이지.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_8_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_9_0">
    <VALUE Lang="th">......4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0">
    <VALUE Lang="th">Please show me where you are injured.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_10">
    <VALUE Lang="th">Accept Medicine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_11">
    <VALUE Lang="th">Change Save Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_12">
    <VALUE Lang="th">Show Spores</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_13">
    <VALUE Lang="th">Request Antibiotic</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_14">
    <VALUE Lang="th">Give her collected medicine ingredients</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_15">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_16">
    <VALUE Lang="th">Ask about Impression of Sacred Financial Group</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_17">
    <VALUE Lang="th">Ask if she needs help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_18">
    <VALUE Lang="th">Hand over the blood sample</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_3">
    <VALUE Lang="th">Ask about the Abnormal Status</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_4">
    <VALUE Lang="th">Sacred Gate Ring Nurse's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_5">
    <VALUE Lang="th">Give Proposal Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_6">
    <VALUE Lang="th">Ask to be Healed</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_7">
    <VALUE Lang="th">Ask to be Healed</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_8">
    <VALUE Lang="th">Accept Medicine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_1_0_9">
    <VALUE Lang="th">Accept Medicine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_10_0">
    <VALUE Lang="th">Looks like you delivered the medicine safely.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It wasn't easy, was it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We'll be able to save a lot of lives with that medicine.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If the road that leads to our hospital hadn't been blocked, this wouldn't have been necessary.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_11_0">
    <VALUE Lang="th">You came just in time. Here, this is the medicine I've prepared, so please be sure that you bring it to where it needs to go, okay?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_12_0">
    <VALUE Lang="th">It seems to me that you knew that this was inevitable. That's why you're telling me this in advance.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_12_0_1">
    <VALUE Lang="th">Request Antibiotic</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_12_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_13_0">
    <VALUE Lang="th">It seems to me that you knew that this was inevitable. That's why you're telling me this in advance.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_14_0">
    <VALUE Lang="th">Sorry to keep you waiting.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">These raw materials can make quite a mess, but they're pretty effective.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you please wait for a while?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_14_0_1">
    <VALUE Lang="th">Wait</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_14_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_15_0">
    <VALUE Lang="th">It's finished now. Here, take it! I think injecting this medicine should cause the patient to experience a full recovery. However, the victim's body has been sustaining this sickness for a long period of time, so I'd still advise him to and rest for the next few days.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_15_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_16_0">
    <VALUE Lang="th">....3</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_17_0">
    <VALUE Lang="th">게다가 그들에겐 제대로 '사고' 할 수 있는 능력 조차 없는 것 같더군요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그에 비하면 난...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_18_0">
    <VALUE Lang="th">.....4</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_19_0">
    <VALUE Lang="th">It's fortunate that I've retained my sanity. Um, but aside from my medical skills and knowledge, I can't... I can't recall much else. All I can do is take care of all this medicine here…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_19_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_2_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_20_0">
    <VALUE Lang="th">.........9</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_21_0">
    <VALUE Lang="th">Excuse me, but can you deliver the medicine over there for me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_21_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_22_0">
    <VALUE Lang="th">*Sigh* It’s unfortunate that I don't have any medicine ready. I need to get some ingredients from the Physics Teacher at Mystic Peak Small Square.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's a hard task since that area is infested by weird dogs, but I'm confident that you can do this for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's urgent that I make this medicine.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_22_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_23_0">
    <VALUE Lang="th">....12</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_24_0">
    <VALUE Lang="th">This is the first time I've seen so many spores in one place.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They're almost just like sand.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">These must be the spores that caused the allergy, right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_24_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_25_0">
    <VALUE Lang="th">......13</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_26_0">
    <VALUE Lang="th">Here are some of the materials that are needed to produce the antibiotic.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can get all of these things nearby.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me collect these items?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_26_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_27_0">
    <VALUE Lang="th">I heard that this hospital also gets some support from the Sacred Financial Group.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm new here so I don't know much about the Sacred Financial Group, but I'm aware that their support enabled this hospital to improve as a facility and a work environment.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_28_0">
    <VALUE Lang="th">Don't you want to know why the Werewolf has become more vicious after the sudden phenomenon? I wonder what has effected the Werewolf like that. It will be possible by analyzing the blood sample of Werewolf… Would you please get me some blood sample?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_28_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_29_0">
    <VALUE Lang="th">Thank you for helping me clear this!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_29_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_3_0">
    <VALUE Lang="th">They started to appear not too long ago. At first there was only one, but then they rapidly multiplied.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't think they were capable of masterminding or carrying out that chaotic incident.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_4_0">
    <VALUE Lang="th">의사 선생님께서 왕진중이시라 지금은 저 혼자 있지만...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">사실 저희 선생님도 저들과 같이 변형돼 버린 몸이세요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_5_0">
    <VALUE Lang="th">Since you are able to make it all the way here, you should already have the basics covered.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There's just two more things I want to teach you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_5_0_2">
    <VALUE Lang="th">Ask about Effects of Petrification</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_5_0_3">
    <VALUE Lang="th">Ask about Effects of Confusion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_6_0">
    <VALUE Lang="th">I'm sorry that my memory still hasn't fully recovered yet.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I might end up helping or harming you with my medical skills. I hope you understand the risks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_7_0">
    <VALUE Lang="th">Petrification makes the body like stone.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The victim is immobilized, but his Defense ironically increases.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_8_0">
    <VALUE Lang="th">This condition is characterized by the victim getting very dizzy. The Attack and Accuracy Rate of the victim is reduced by half, making him weak against his enemies. The moment SP (Stamina Point) is consumed, the victim will be in grave danger.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_9_0">
    <VALUE Lang="th">Not long ago I received the bleak news from the Physics Teacher from Phoenix Hole saying that there're insufficient supplies of First-Aid medicines.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But my situation is similar to most other people; I can't leave the position at which I'm currently stationed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_medic_1.ntk_9_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_1_0">
    <VALUE Lang="th">This tunnel has been listed as a dangerous area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's not safe to use the left road that goes through the tunnel, and using the exit to the right road that is also hazardous.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_1_0_1">
    <VALUE Lang="th">Ask about Dangerous Tunnel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_1_0_2">
    <VALUE Lang="th">Ask How to Pass Through</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_1_0_3">
    <VALUE Lang="th">Pass Through the Tunnel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_1_0_4">
    <VALUE Lang="th">Exchange for Police Emblem</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_1_0_5">
    <VALUE Lang="th">Ask if he has seen a party with a girl</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_1_0_6">
    <VALUE Lang="th">Ask Crusio's Lover's Whereabouts.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_10_0">
    <VALUE Lang="th">Let me replace your 30 Police Emblem pieces with this newly repaired Police Emblem.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_10_0_1">
    <VALUE Lang="th">Exchange for Police Emblem</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_11_0">
    <VALUE Lang="th">You mean the party with a girl? Well, I remember giving warning to a party with two adults males and one girl who went towards trading Hole. Especially, the girl was really pretty.. Since you are a student of Saint, you will be able to find them in Trading Hole.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_11_0_1">
    <VALUE Lang="th">Backg</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_12_0">
    <VALUE Lang="th">After thorough investigation, the woman did not get married after the incident and is now living alone. Who the strongest is does not matter to her.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_2_0">
    <VALUE Lang="th">The Crazy Dogs blocking the tunnel will attack anything that passes them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It'll be tough to deal with them since the gas pipe near the tunnel makes it too dangerous for anyone who intends to enter the tunnel. Sorry for this bad news!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_3_0">
    <VALUE Lang="th">We've learned from investigations that people that have lost their sanity also wander the tunnels.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There is also a Giant Shepherd that leads the tunnel's inhabitants.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_4_0">
    <VALUE Lang="th">Of course, we can't allow a normal resident to go through.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Only students from the Sacred Gate School are allowed to enter.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_5_0">
    <VALUE Lang="th">....3</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_6_0">
    <VALUE Lang="th">If my analysis is correct, then the German Shepherd did something to control the other dogs.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_7_0">
    <VALUE Lang="th">They recognized him as their master. I guess we need to do the same if we want to go through that tunnel.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_8_0">
    <VALUE Lang="th">......4</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_9_0">
    <VALUE Lang="th">Take extra caution if you venture inside. Those monsters are bloodthirsty and will attack any living thing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_police_1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_1_0">
    <VALUE Lang="th">어서 오세요~</VALUE>
    <VALUE Lang="th">뭘 찾으시나요?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_1_0_1">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_1_0_2">
    <VALUE Lang="th">아이템 획득에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_1_0_3">
    <VALUE Lang="th">아이템 종류에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_1_0_4">
    <VALUE Lang="th">상점에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_10_0">
    <VALUE Lang="th">일단 평범한 '일반 아이템'이 있구요.</VALUE>
    <VALUE Lang="th">기능이 좀 좋아진 상위 아이템이 있는데, '레어 아이템'이라고도 해요.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_10_0_1">
    <VALUE Lang="th">다음으로.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_11_0">
    <VALUE Lang="th">그 중에서도 '유니크 아이템'이라고 특별하게 잘 만들어진 것들이 있는데, 아마 찾기는 힘들거예요.</VALUE>
    <VALUE Lang="th">혹시나 그런 걸 입수하시면 잘 보관하도록 하세요.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_11_0_1">
    <VALUE Lang="th">다음으로.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_12_0">
    <VALUE Lang="th">그리고...저도 아직 본 적이 없어서 잘은 모르겠지만, 진~짜로 희귀한 아이템도 있다고 하네요.</VALUE>
    <VALUE Lang="th">저희 본사에 있는 물품자료를 보면 아마 알아볼 수도 있을거예요.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_12_0_1">
    <VALUE Lang="th">다음으로.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_13_0">
    <VALUE Lang="th">.......4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_14_0">
    <VALUE Lang="th">예, 본사인 '선우 유통'에서 관리하는 직영점... 이라는 거죠.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_14_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_15_0">
    <VALUE Lang="th">위생, 품질, 가격, 제품종류 등 모든 부분을 공식적으로 검증받아 전국 각지의 학교에 파견된 우수한 유통사입니다.</VALUE>
    <VALUE Lang="th">라고 사원 교육때 배웠는데, 이제야 겨우 써보내요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_15_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_16_0">
    <VALUE Lang="th">.....5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_17_0">
    <VALUE Lang="th">적들을 쓰러트리면 지니고 있던 아이템을 뺏을 수 있어요.</VALUE>
    <VALUE Lang="th">적이 세면 셀수록 고급의 아이템을 얻을 가능성이 높아지니까 참고하시구요.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_17_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_18_0">
    <VALUE Lang="th">혹시 좋은 물품을 얻으셨는데 사용하실 생각이 없던가, 아님 돈이 필요하시다면 저에게 오셔서 처분하도록 하세요.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_18_0_1">
    <VALUE Lang="th">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_2_0">
    <VALUE Lang="th">하지만 친구분들과 서로 교환하는 방법도 있으니까 꼭 저에게 오지 않으셔도 되요.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_2_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_2_0_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_3_0">
    <VALUE Lang="th">아, 그리고 함부로 사용할 수 없는 '퀘스트 아이템'이라는 것도 있어요, 그치만 저한테 가져오셔도 처분하실 수는 없으니까 곤란하거든요~</VALUE>
    <VALUE Lang="th">꼭 퀘스트 수행에만 사용해 주세요.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_3_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_3_0_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_4_0">
    <VALUE Lang="th">그치만 지금은 본사로부터의 지원이 완전히 끊겨 버려서 제대로 된 물품이 별로 없어요...</VALUE>
    <VALUE Lang="th">죄송해요.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_4_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_4_0_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_5_0">
    <VALUE Lang="th">하지만 친구분들과 '1대1 교환' 하는 방법도 있으니까 꼭 저에게 오지 않으셔도 되거든요.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_5_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_5_0_2">
    <VALUE Lang="th">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_6_0">
    <VALUE Lang="th">....2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_7_0">
    <VALUE Lang="th">적들을 쓰러트리면 지니고 있던 아이템을 뺏을 수 있어요.</VALUE>
    <VALUE Lang="th">적이 세면 셀수록 고급의 아이템을 얻을 가능성이 높아지니까 참고하시구요.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_7_0_1">
    <VALUE Lang="th">다음으로.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_8_0">
    <VALUE Lang="th">혹시 좋은 물품을 얻으셨는데 사용하실 생각이 없던가, 아님 돈이 필요하시다면 저에게 오셔서 처분하도록 하세요.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_8_0_1">
    <VALUE Lang="th">다음으로.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_9_0">
    <VALUE Lang="th">.....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_saint51f.ntk_1_0">
    <VALUE Lang="th">I heard making new markets... Anyway, what can I help you?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_saint51f.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0">
    <VALUE Lang="th">Welcome</VALUE>
    <VALUE Lang="th">For the efficient school life,</VALUE>
    <VALUE Lang="th">Please check the contents listed below.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_1">
    <VALUE Lang="th">Confirm Attendance</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_10">
    <VALUE Lang="th">Using Skills</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_2">
    <VALUE Lang="th">Location of Main Centre</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_3">
    <VALUE Lang="th">Changing View Point</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_4">
    <VALUE Lang="th">Using Mini Map</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_5">
    <VALUE Lang="th">Quest Enforcing &amp; Checking</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_6">
    <VALUE Lang="th">Checking Tips</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_7">
    <VALUE Lang="th">Checking Help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_8">
    <VALUE Lang="th">Checking Inventory</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_9">
    <VALUE Lang="th">Checking Character Info.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_10_0">
    <VALUE Lang="th">Character skill info can be checked by pressing 'K' button. Skills can be learned with skill scrolls sold by each guidance teacher and also learned skill can be assigned in quickslot by clicking it with left mouse button and drag to the slot or just by double clicking it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Place mouse cursor on a monster then press assigned shortcut key(Numeric Keys) and then click monster with right mouse button to initiate the skill.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_10_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_2_0">
    <VALUE Lang="th">"First, confirm ""Main Centre"" written on the ground,</VALUE>
    <VALUE Lang="th">then go follow the arrow to enter Main Centre."</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_3_0">
    <VALUE Lang="th">Changing the view can be done by rolling the mouse wheel button for zooming and you can rotate the view point by pressing and holding the mouse wheel button.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Also, Up, Down, Left and Right button can be used to change the view point.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_4_0">
    <VALUE Lang="th">Press 'M' button on your keyboard to turn on/off the Mini Map.</VALUE>
    <VALUE Lang="th">Click left mouse button and hold the bottom left corner of the Mini Map window and drag it to adjust Mini Map window size.</VALUE>
    <VALUE Lang="th">Click left mouse button on the place you wish to go to in the Mini Map, Character will start to move to the destination automatically.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_4_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_5_0">
