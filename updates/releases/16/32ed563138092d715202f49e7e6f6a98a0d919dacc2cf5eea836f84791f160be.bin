  <SENTENSE Ver="1" Id="2014_worldcup01.ntk_1_0">
    <VALUE Lang="th">World Cup is one of the huge parties across the world.</VALUE>
    <VALUE Lang="th">Let's cheer for together</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_worldcup01.ntk_1_1">
    <VALUE Lang="th">The long-awaited day has come! Which country do you think that will win this Brazil World Cup?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_worldcup01.ntk_1_1_1">
    <VALUE Lang="th">My prophecy goes beyond the foul.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_worldcup02.ntk_1_0">
    <VALUE Lang="th">Are you good at guessing the winner?</VALUE>
    <VALUE Lang="th">Then give it a shot! If you pick up a winning team right, I will give you special presents after this World Cup ends.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_worldcup02.ntk_1_0_1">
    <VALUE Lang="th">Sell item</VALUE>
  </SENTENSE>
