    <VALUE Lang="th">Change 100 Eternal Snow Crystal to Snowman (3H)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_august_event.ntk_1_0_3">
    <VALUE Lang="th">Change 200 Eternal Snow Crystal to EXP Rudolf Costume Set (3H) Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_august_event.ntk_1_0_4">
    <VALUE Lang="th">Change 250 Eternal Snow Crystal to Snowman Hat Random Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_august_event.ntk_1_0_5">
    <VALUE Lang="th">Change 300 Eternal Snow Crystal to Oblivion Potion E (7D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_ballan01.ntk_1_0">
    <VALUE Lang="th">I heard that someone took my chocolate away!!! I should make another one and give it for him tomorrow again…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_ballan01.ntk_1_1">
    <VALUE Lang="th">I gave chocolate to a man I love. Hope that he accepts my confession~~~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_ballan01.ntk_1_1_1">
    <VALUE Lang="th">Ask who the man is.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_ballan01.ntk_2_0">
    <VALUE Lang="th">He is just amazing~♡ You will find him at a glance!^^</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_ballan02.ntk_1_0">
    <VALUE Lang="th">I lost my chocolate! Someone took my chocolate from me!!! …Ah, stupid.. It's my fault...What can I do now?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_ballan02.ntk_1_1">
    <VALUE Lang="th">She said that she likes being with me! I feel like flying in the Sky!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_ballan02.ntk_1_1_1">
    <VALUE Lang="th">Ask who the man is.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_ballan02.ntk_2_0">
    <VALUE Lang="th">Huh? Didn't you call my name?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_ballan03.ntk_1_0">
    <VALUE Lang="th">Dark damp atmosphere is around you.. Why don't we change this world for singles together with me?</VALUE>
    <VALUE Lang="th">Take chocolate from the Boy in Love and bring it to me. I will give a present for you as a reward.</VALUE>
