  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_32_0_3"><VALUE Lang="tw">兌換 致命冰凍（67級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="id">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="cn">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="th">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE></SENTENSE>
