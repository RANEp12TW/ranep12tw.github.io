  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_29_0_5">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_3_0">
    <VALUE Lang="th">One word best describes the Sword Section. Power!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes, learning the way of the sword will grant you great power. Just remember to train always, and to use your sword for the right reasons.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_30_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_30_0_4">
    <VALUE Lang="th">Exchange Item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_30_0_5">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_31_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_31_0_4"><VALUE Lang="tw">兌換 粉碎擊（160級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Crush (Lv160, Class=130, Item=175/63)</VALUE><VALUE Lang="id">Skill book: Crush (Lv160, Class=130, Item=175/63)</VALUE><VALUE Lang="cn">Skill book: Crush (Lv160, Class=130, Item=175/63)</VALUE><VALUE Lang="th">Skill book: Crush (Lv160, Class=130, Item=175/63)</VALUE></SENTENSE>
