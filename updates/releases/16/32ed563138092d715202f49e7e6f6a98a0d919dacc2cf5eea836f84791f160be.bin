  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_circleroom_1.ntk_6_0">
    <VALUE Lang="th">The target amount required for purification has been achieved and verified.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you for your efforts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_circleroom_1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_circleroom_1.ntk_9_0">
    <VALUE Lang="th">The priority targets of this area are the Elite Fencers. Please help eliminate 30 Elite Fencer targets.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_circleroom_1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0">
    <VALUE Lang="th">I'm not sure how the streets got to be this dangerous. I'm so lucky to have found a safe place to hide!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Sheesh! I really don't know what'll happen to me if I'm not careful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_1">
    <VALUE Lang="th">What are you talking about?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_10">
    <VALUE Lang="th">Ask about Freezing Halogen</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_11">
    <VALUE Lang="th">Tell him what happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_2">
    <VALUE Lang="th">Listen to Cleaner's Advice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_3">
    <VALUE Lang="th">Delivering Recycled Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_4">
    <VALUE Lang="th">Deliver Recycled Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_5">
    <VALUE Lang="th">Exchange a Green Pearl for a Red Pearl.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_6">
    <VALUE Lang="th">Exchange a Blue Pearl for a Green Pearl</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_7">
    <VALUE Lang="th">Exchange a Green bead for 5 red beads.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_8">
    <VALUE Lang="th">Exchange a Blue Bead for 25 Red beads.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_1_0_9">
    <VALUE Lang="th">Exchange a Red bead.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_10_0">
    <VALUE Lang="th">Thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_10_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_2_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_3_0">
    <VALUE Lang="th">You still have no idea after seeing it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Things suddenly got weird while I was cleaning the streets.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_4_0">
    <VALUE Lang="th">Ever since these events happened, we never had the chance to run away.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">No one is left to do the cleaning up till now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_5_0">
    <VALUE Lang="th">Thank you very much! I'm so sorry for bothering you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We really have to treasure all kinds of resources. I'll ask for your help later in case you have any spare time to assist me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll give you something nice if you collect any of my available items.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0">
    <VALUE Lang="th">Wow! This Blue Pearl is a very valuable item. Please choose any item here in exchange for this Blue Pearl.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_1">
    <VALUE Lang="th">Exchange Burr</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_10">
    <VALUE Lang="th">Exchange Fine Silver</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_11">
    <VALUE Lang="th">Exchange Crystal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_12">
    <VALUE Lang="th">Exchange Fine Crystal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_13">
    <VALUE Lang="th">Exchange Sodium</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_14">
    <VALUE Lang="th">Variant Sodium</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_15">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_2">
    <VALUE Lang="th">Exchange Protective Potion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_3">
    <VALUE Lang="th">Exchange Fine Burr</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_4">
    <VALUE Lang="th">Exchange Deluxe Protective Potion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_5">
    <VALUE Lang="th">Exchange Bone Powder</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_6">
    <VALUE Lang="th">Exchange Deluxe Bone Powder</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_7">
    <VALUE Lang="th">Exchange Iron</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_8">
    <VALUE Lang="th">Exchange Fine Iron</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_9">
    <VALUE Lang="th">Exchange Silver</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_7_0">
    <VALUE Lang="th">If this mess and resource shortage continues, then we'll suffer tremendous problems later on.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are other matters that you don't need to worry about for now. Just concentrate on helping me collect some Empty Bottles.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please use the Medicine Items carefully.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0">
    <VALUE Lang="th">Wow, this Red Pearl is special! Please choose any of my available items in exchange for this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_1">
    <VALUE Lang="th">Exchange Burr</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_10">
    <VALUE Lang="th">Exchange Fine Silver</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_11">
    <VALUE Lang="th">Exchange Crystal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_12">
    <VALUE Lang="th">Exchange Fine Crystal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_13">
    <VALUE Lang="th">Exchange Sodium</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_14">
    <VALUE Lang="th">Exchange Fine Sodium</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_15">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_2">
    <VALUE Lang="th">Exchange Protective Potion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_3">
    <VALUE Lang="th">Exchange Fine Burr</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_4">
    <VALUE Lang="th">Exchange Deluxe Protective Potion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_5">
    <VALUE Lang="th">Exchange Bone Powder</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_6">
    <VALUE Lang="th">Exchange Deluxe Bone Powder</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_7">
    <VALUE Lang="th">Exchange Iron</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_8">
    <VALUE Lang="th">Exchange Fine Iron</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_9">
    <VALUE Lang="th">Exchange Silver</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_9_0">
    <VALUE Lang="th">After I gather up the trashes, they would just lay them open again while I do something else just for a second.. So, I have to do it all over again and my back cannot stand it anymore. Please help me!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_9_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_extraacti.ntk_1_0">
    <VALUE Lang="th">Confirm the goal of Extra Activity and carry it out by pressing 'Y' button then you will be able to earn Title which you can add to your name and the activity points. Carry out many Easy Activities and purchase a special item.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_extraacti.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_1_0">
    <VALUE Lang="th">The Terminal located in the Basic Science Classroom is not functioning properly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please attend to this problem immediately.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_1_0_1">
    <VALUE Lang="th">Activate Authentication</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_1_0_2">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_1_0_3">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_1_0_4">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_1_0_5">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_1_0_6">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_2_0">
    <VALUE Lang="th">Due to the errors found in the School's</VALUE>
    <VALUE Lang="th">Information Center System,</VALUE>
    <VALUE Lang="th">the Information Room has all the available information contained within these 2 files.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We will restore all necessary information</VALUE>
    <VALUE Lang="th">as soon as we resolve the situation.</VALUE>
    <VALUE Lang="th">For the meantime, you can stay</VALUE>
    <VALUE Lang="th">and browse through these two documents.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_2_0_1">
    <VALUE Lang="th">Ask about the Sword Section Student named Chi Ri Qing</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_2_0_2">
    <VALUE Lang="th">Ask about the Archery Section Student named Cheng Xi Zhi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_3_0">
    <VALUE Lang="th">Chi Ri Qing is a Sacred Gate Campus 2nd Year Student. He is a former Trainee of the Sword Section Class. His background is very interesting: both of his parents died in a chaotic incident.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Since then, he left the school carrying out his own investigation about the incident.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you have seen or have any information about this student, please contact the Administration Office immediately.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_4_0">
    <VALUE Lang="th">Cheng Xi Zhi is a 2nd Year student from the Sacred Gate Campus, and a former trainee of the Archery Section. Both of her parents died in the catastrophic phenomenon that caused the major problems in our world. She is now using her Evil Spirit to find her mutated older sister.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This student has important information regarding the location of Leonair Campus. We must get in contact with her immediately.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gichogwahak1.ntk_5_0">
    <VALUE Lang="th">There are no means of keeping this Terminal functioning properly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_1_0">
    <VALUE Lang="th">This Terminal controls the entrance and exit to the Dormitory.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_1_0_1">
    <VALUE Lang="th">Confirm Activation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_1_0_2">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_1_0_3">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_1_0_4">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_1_0_5">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_2_0">
    <VALUE Lang="th">The Terminal is running properly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_3_0">
    <VALUE Lang="th">The Terminal's Force Field mechanism is functioning properly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll need 9 Spiritual Spheres to optimize this Terminal's Force Field function.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_4_0">
    <VALUE Lang="th">Force Field Optimization is completed!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please move to the next Terminal to complete the remaining Force Field Optimization requirements.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_5_0">
    <VALUE Lang="th">학습1관 내부에는 일부의 복사령들이 활동중입니다</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">이들이 지닌 구성자들이 주변의 요소들에게 불확실한 영향을 끼치고 있으니, 구성자들을 가능한한 제거해 주십시오</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0">
    <VALUE Lang="th">Say, are you feeling alright?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_1">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_10">
    <VALUE Lang="th">Listen to the Rumor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_11">
    <VALUE Lang="th">Listen to the Rumor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_12">
    <VALUE Lang="th">Listen to the Rumor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_13">
    <VALUE Lang="th">Listen to the Rumor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_3">
    <VALUE Lang="th">Guard's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_4">
    <VALUE Lang="th">Give the Note</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_5">
    <VALUE Lang="th">Guard's 2nd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_6">
    <VALUE Lang="th">Verify the Medicine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_7">
    <VALUE Lang="th">Guard's 3rd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_8">
    <VALUE Lang="th">Give the Blades</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_1_0_9">
    <VALUE Lang="th">Get the Degree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_10_0">
    <VALUE Lang="th">Make sure you stop and never pass through the crossroads in front.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are a lot of weird dogs loitering that area, and no one knows where they came from.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It would be safer to travel along the left or right corner streets.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Honestly, I'm not very familiar with the other roads because I've never actually passed by them before.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_11_0">
    <VALUE Lang="th">득도의 경지에 이른 ‘마루치’ 와 ‘아라치’ 의 기운이 서로 만나서 이루는 경지를 말하는거 라더군</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">아마도 '나한의 구슬' 과 '깨달음의 열쇠'도 관계가 있을거야</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_11_0_1">
    <VALUE Lang="th">'깨달음의 열쇠' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_11_0_2">
    <VALUE Lang="th">'나한의 구슬' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_11_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_12_0">
    <VALUE Lang="th">예전에 재단에서 온 사람들이 그런 말을 하는 걸 들은 적이 있는데 열쇠가 지금은 조각 조각으로 나뉘어져 있다더군</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">일단은 그 조각들을 합쳐야 할 텐데 말야...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_13_0">
    <VALUE Lang="th">직접 본 적은 없으니까 녹색 구슬이라는 것 밖에는 알 수가 없군</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">더 자세한 건 '학생주임'님께 여쭈 보면 알 수 있지 않을까</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_14_0">
    <VALUE Lang="th">Having these fellahs around is like my own personal hell, I tell ya!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_14_0_1">
    <VALUE Lang="th">Ask about What Happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_14_0_2">
    <VALUE Lang="th">Ask about the Situation Outside</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_14_0_3">
    <VALUE Lang="th">Ask for Useful Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_14_0_4">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_15_0">
    <VALUE Lang="th">You mean the mail from the Headquarters of the Finance Department?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I actually had that document earlier, but I'm not sure where I placed it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah! It's here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It looks like a simple document, but this was personally requested by the Student Director.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I think he has very little trust in the students.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What's important is that the document is still here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_15_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_16_0">
    <VALUE Lang="th">Goodness! I almost forgot...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I should have told you at the very beginning. I was thinking of asking you to do something.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I wasn't aware of the full extent of the chaos caused by these weird mobs on the campus grounds and the surrounding area. That is why I'm staying here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not so long ago, the note written by the Health Advisor that the Blood Drinker requested was stolen.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm sorry for bothering you, but may I know if you've found the stolen note?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_16_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_17_0">
    <VALUE Lang="th">Well, I'll be...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is the note!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thanks for finding it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even though you found this note, there are still bigger problems that we've got to deal with.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_17_0_2">
    <VALUE Lang="th">Guard's 2nd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_18_0">
    <VALUE Lang="th">Please consider helping me out by delivering this medicine to the Health Advisor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Health Advisor has ordered the recovery of the first-aid medicine several times. We need that medicine back as soon as possible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please accept my request for your help again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are these fellahs known as the Blood Drinkers that rob people who possess the medicine. It's pretty clear that these Blood Drinkers have the medicine. Please make sure they can't rob people of their medicine again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_18_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_19_0">
    <VALUE Lang="th">Oh! You found them all!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please take all this medicine to the Health Advisor now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The people causing trouble on campus are preventing me from bringing this medicine to the Health Advisor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_19_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_2_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_20_0">
    <VALUE Lang="th">Hmm? Did the Health Advisor like it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh! He did?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You see those fellahs, especially those Ardee Boys, getting more reckless? Trust me, you wanna stay away when they start waving around those daggers.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So you might see all sorts of folk carrying around daggers dripping with fresh blood, but you don't need to be that afraid of them. Now those Ardee Boys, on the other hand, are dangerous! Do me a favor, and help me by taking those knives away from the Ardee Boys. It's probably impossible to get all their daggers, but I think getting 10 Daggers from them shouldn't be a problem.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_20_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_21_0">
    <VALUE Lang="th">Sorry for troubling you like this, but I really appreciate your hard work, especially since it's making our campus much safer.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm really impressed by your performance. I'll be sure to commend you for all the good you've done for me if I ever meet your teachers again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_21_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_22_0">
    <VALUE Lang="th">I heard that there's more of those capital items around.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can learn more about the rumor through the campus's crossroads there~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_22_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_23_0">
    <VALUE Lang="th">I hear that item's very small and easy to lose.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Search for the people that came back from the dead on Leonair Campus and talk to them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You might get some useful information from him</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_23_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_24_0">
    <VALUE Lang="th">I hear that item's very small and easy to lose.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Search for the people that came back from the dead on Leonair Campus and talk to them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You might get some useful information from him.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_24_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_3_0">
    <VALUE Lang="th">Sigh... I don't even know where to begin.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">My situation is a bit complicated because I have to take care of the Health Advisor's request to search for first-aid medicine.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I lost the list of medicines! This is a serious problem…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_4_0">
    <VALUE Lang="th">This is the first time in my life that I've encountered a problem that doesn't make any sense at all. I can't even go outside to assess the actual situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Where in the hell are these mobs coming from?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not so long ago, those creatures almost killed me while I was rescuing a friend of mine. I barely died, and I tell ya…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It was horrible!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_4_0_3">
    <VALUE Lang="th">Ask about Situation on the Streets</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_5_0">
    <VALUE Lang="th">.........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_6_0">
    <VALUE Lang="th">하도 정신이 없어서 누군지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">얼굴도 기억 나질 않는데</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">하여튼 그 친구가 자기 이름이</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그렇다고 했던 것만 겨우 기억</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">나는군</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_7_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Let me see. Even though I had a tough time coming here, I don't think I have any other information to tell you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Wait, hold on for a minute!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There's this thing called the Abrasive Kit. You can use that item to produce better and stronger equipment for yourself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_7_0_2">
    <VALUE Lang="th">Ask How to Use Abrasive Kits</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_8_0">
    <VALUE Lang="th">Open the Inventory Window and choose the Abrasive Kit. Drag it to the item you want to transform by clicking the top right position of the item, and the item will be upgraded.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You should know that there's a big probability of failure, though.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please note that items vanish when transformation attempts are unsuccessful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_9_0">
    <VALUE Lang="th">난리도 아니야~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">여기부터는 최소한 레벨이 35는 돼야 갈 수 있을걸세.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그러니 그냥 얌전히 돌아가서 연습 좀 더 하고 나오게나.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_guard1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gwahak_1.ntk_1_0">
    <VALUE Lang="th">This Terminal controls the entrance and exit to the Science Center.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gwahak_1.ntk_1_0_1">
    <VALUE Lang="th">Confirm Activation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gwahak_1.ntk_1_0_10">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gwahak_1.ntk_1_0_11">
    <VALUE Lang="th">Force Field Optimization</VALUE>
