    <VALUE Lang="th">30th floor gate is opened.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_2_0">
    <VALUE Lang="th">The password is verified.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The 30th floor pass permission is confirmed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_3_0">
    <VALUE Lang="th">There are the pieces of paper that contain the 30th floor password hints on the 1st floor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you want to enter, please find and complete the password.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_3_0_1">
    <VALUE Lang="th">Start to find the password.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_4_0">
    <VALUE Lang="th">Please enter the password once all pieces of paper are collected and verified.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_1_0">
    <VALUE Lang="th">This is the 50th floor security Terminal.</VALUE>
