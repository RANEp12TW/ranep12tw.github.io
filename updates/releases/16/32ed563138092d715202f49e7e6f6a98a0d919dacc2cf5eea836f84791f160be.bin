  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_1_0_9">
    <VALUE Lang="th">Nurse's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_10_0">
    <VALUE Lang="th">Poisoning causes the victim's Strength and Stamina to continuously diminish, and it inflicts more damage than burns. Please be aware of this!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The rate of damage from being poisoned is higher than the case of getting burnt. Please be aware of this fact!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_11_0">
    <VALUE Lang="th">When a victim is suffocated, the movement of the victim will immediately become awry.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">However, this condition will not last long. Having said that, it is still considered a dangerous condition. Please be careful not to get suffocated!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_12_0">
    <VALUE Lang="th">Although the medicines I have aren't really enough to heal your condition, I'll still try my best to treat you. Please let me take a look at your injuries.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_12_0_1">
    <VALUE Lang="th">Ask about the treatment of wounds</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_12_0_2">
    <VALUE Lang="th">Ask about Chaotic Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_12_0_3">
    <VALUE Lang="th">Ask about Different Illnesses</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_12_0_4">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_13_0">
    <VALUE Lang="th">Oh! Are you going to register?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I bet this is your first time to register. You seem a little nervous!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you understand the terms of registration?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can assure you that you can come to me for treatment until you reach Level 15. Please visit me in case you need to be treated.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Don't you think it'd be more convenient if you change your Save Point over here?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_14_0">
    <VALUE Lang="th">Writing these medical reports is really exhausting work, and I just ran out of paper. Do you think you can help me with this problem?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are paper supplies at the Welfare Society. Would you go there and get some paper for me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_14_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_15_0">
    <VALUE Lang="th">Ah! Thank you very much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This job requires me to write medical records all day.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you get injured in the future, please feel free to come to me for help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll attend to your medical needs and make sure you get quality treatment.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_15_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_16_0">
    <VALUE Lang="th">Oh! You already got it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much! You've been a great help! We have a medicine shortage if you didn't bring new supplies. We'd have big trouble on campus without any first-aid supplies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I hope the situation outside gets better. I'm afraid it'll affect the campus if things continue like this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_16_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_17_0">
    <VALUE Lang="th">The quality and quantity of medicine supplies aren't very good, so we have to find a way to produce our own.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Excuse me. Would you be willing to help me collect some Cigarette Butts?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Have you ever heard of Little Hooligan and the Hooligan? They're notorious for chain-smoking.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I requested someone to collect cigarette butts from Little Hooligan for me. He brought me butts that weren't high enough in quality, and they couldn't be used to make medicinal materials. Would you help me acquire cigarette butts from the Hooligan instead?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, and don't worry. I'll give you some money if you can get me 20 cigarette Butts from the Hooligan.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_18_0">
    <VALUE Lang="th">Wow! You already collected the Cigarette Butts!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you so much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We should be able to produce our own medicinal materials, starting today. If you find yourself with free time later, please come here and help me again, okay?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_18_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_19_0">
    <VALUE Lang="th">We're experiencing a shortage in medicines and medical supplies use for treatment.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If this continues, we'll need to come up with new ways to get or make the medical equipment and supplies that we need on our own.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I just got a great idea! The Street Junkies outside carry plaster and wear bandages, right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes, now I remember that those guys carry bandages on them, but the Street Junkies don't really need them. I think that other students will benefit more from having those bandages.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Having said that, will you help me get bandages from the Street Junkies?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We don't have many bandages on hand, so we'll need to replenish our supply.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_19_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_2_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_20_0">
    <VALUE Lang="th">This is great! Thanks!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Most students may look tough, but they're actually good and obedient like you, deep down inside. You really have to communicate pleasantly to people to get their respect.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway, thanks a lot! I might come and ask for your assistance again in the future. *Smiles*</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_20_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_21_0">
    <VALUE Lang="th">망각의 약?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">함부로 쓰면 안되는 약품인데...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">이제까지 조정했던 능력치들을 분배하기 전의 상태로 돌려버리는 약이라는 건 알고 있지?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">익혔던 스킬들을 모두 잊어버리게 되고, 대신 영령구슬들로 바꿔주고, 나눴던 스킬포인트를 모두 회수해 모아주는데...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그래도 그런 약을 먹을거야?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_21_0_1">
    <VALUE Lang="th">망각의 약을 사용하겠다고 한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_21_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_22_0">
    <VALUE Lang="th">그래...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">벌써 결심해 버렸나 보구나</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">할 수 없지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그럼 가서 약재를 좀 구해 줄래?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">예전같으면 따로 재료를 구할 필요도 없었겠지만, 지금은 그런 흔한 것들도 함부로 쓸 수 없는 상황이니까...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">자, 자 그렇게 싫은 표정 하지 말고!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">금방 구할 수 있을테니까, 다녀와-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_22_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_23_0">
    <VALUE Lang="th">별로 오래 걸리진 않았지?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">쉽게 구할 수 있다고 했잖니-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그런데 아쉽게도 더이상 약을 만들수가 없어</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그러게 정해진 날짜 동안에 다 했어야지-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_23_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_24_0">
    <VALUE Lang="th">별로 오래 걸리진 않았지?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">쉽게 구할 수 있다고 했잖니-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">자, 여기에 이 알약만 섞으면 완성이야</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">솔직히 쓰레기장에서 구한 재료로 이런 미심쩍은 약을 만들어 먹인다는게 좀 마음에 걸리긴 하지만... 그래도 먹는다는데 어떻게 말리겠니-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">응? 이런 재료로 약을 만든다는 말은 안했던가?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">음...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">이제라도 말 해줬으니까 된거지?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">자, 약은 다 만들어졌으니까</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">먹어봐-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">아, 배우고 있던 스킬수 만큼 영령구슬이 잔뜩 나올테니까 인벤토리는 비워놔야 돼, 잊지마-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_24_0_1">
    <VALUE Lang="th">?쩊홁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_25_0">
    <VALUE Lang="th">망각의 약?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">함부로 쓰면 안되는 약품인데...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">이제까지 조정했던 능력치들을 분배하기 전의 상태로 돌려버리는 약이라는 건 알고 있지?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">익혔던 스킬들을 모두 잊어버리게 되고, 대신 영령구슬들로 바꿔주고, 나눴던 스킬포인트를 모두 회수해 모아주는데...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그래도 그런 약을 먹을거야?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_25_0_1">
    <VALUE Lang="th">망각의 약을 사용하겠다고 한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_25_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_3_0">
    <VALUE Lang="th">Unfortunately, I can't help the patients with severe injuries since there isn't much medicine left. I can still treat people that have suffered minor injuries, but I can't help students beyond Level 15 because my skills are still pretty limited.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_4_0">
    <VALUE Lang="th">미안, 내 실력으로 학생을 치료했다가는 오히려 해를 입힐지도 몰라.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_5_0">
    <VALUE Lang="th">I don't think this is a disease. I think this is more like a serious chemical reaction where the victim's body get burned, paralyzed by electricity, or frozen. There's another condition in which the victim's body is petrified.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_5_0_2">
    <VALUE Lang="th">Ask about Burn Effects</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_5_0_3">
    <VALUE Lang="th">Ask about Paralysis Effects</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_5_0_4">
    <VALUE Lang="th">Ask about Freezing Effects</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_5_0_5">
    <VALUE Lang="th">Asking about Poisoning Effects</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_5_0_6">
    <VALUE Lang="th">Ask about Suffocation Effects</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_6_0">
    <VALUE Lang="th">I have no idea what the situation outside is like, but judging from what I've heard from the teachers, it doesn't look good at all.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_7_0">
    <VALUE Lang="th">Burns will cause the body to weaken, resulting in lower Strength and Stamina. Please be careful since burns can end up being fatal.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_8_0">
    <VALUE Lang="th">Paralysis caused by electricity or some other form of shock will cause the body's Movement Speed to slow down.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_9_0">
    <VALUE Lang="th">Freezing the body causes it to stiffen, resulting in decreased Movement Speed and Defense. The effects could be fatal if the victim suffers in this condition for a prolonged period of time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_1_0">
    <VALUE Lang="th">Oh, you are not an Assassin, the friend of darkness seeking the light! I cannot help you!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_1_0_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_1_0_2">
    <VALUE Lang="th">인술부기념주화로 행운에 도전하고 싶어요!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_1_1">
    <VALUE Lang="th">Do your best until we can go back to our home!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_1_1_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
