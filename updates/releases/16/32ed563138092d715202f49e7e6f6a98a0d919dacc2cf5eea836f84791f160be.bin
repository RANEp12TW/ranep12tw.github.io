  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_69_0_5"><VALUE Lang="tw">兌換 暗影拳（237級／格鬥部）</VALUE><VALUE Lang="GS">Skill book: Shadow Punch (Lv237, Class=65, Item=174/20)</VALUE><VALUE Lang="id">Skill book: Shadow Punch (Lv237, Class=65, Item=174/20)</VALUE><VALUE Lang="cn">Skill book: Shadow Punch (Lv237, Class=65, Item=174/20)</VALUE><VALUE Lang="th">Skill book: Shadow Punch (Lv237, Class=65, Item=174/20)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_69_0_8"><VALUE Lang="tw">兌換 旋風踢（197級／格鬥部）</VALUE><VALUE Lang="GS">Skill book: Twister Kick (Lv197, Class=65, Item=174/40)</VALUE><VALUE Lang="id">Skill book: Twister Kick (Lv197, Class=65, Item=174/40)</VALUE><VALUE Lang="cn">Skill book: Twister Kick (Lv197, Class=65, Item=174/40)</VALUE><VALUE Lang="th">Skill book: Twister Kick (Lv197, Class=65, Item=174/40)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_69_0_9"><VALUE Lang="tw">兌換 烈焰氣擊（197級／格鬥部）</VALUE><VALUE Lang="GS">Skill book: Fire Blowing (Lv197, Class=65, Item=174/60)</VALUE><VALUE Lang="id">Skill book: Fire Blowing (Lv197, Class=65, Item=174/60)</VALUE><VALUE Lang="cn">Skill book: Fire Blowing (Lv197, Class=65, Item=174/60)</VALUE><VALUE Lang="th">Skill book: Fire Blowing (Lv197, Class=65, Item=174/60)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_7_0">
    <VALUE Lang="th">Oh, a new student?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_7_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_8_0">
    <VALUE Lang="th">Oh, and you've got to visit the Student Director at the School Administration Office to register as a student. The office is next to the Welfare Society.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_9_0">
    <VALUE Lang="th">Ah! Can I help you with anything?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_9_0_1">
    <VALUE Lang="th">Ask about the Brawler Section</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_9_0_2">
    <VALUE Lang="th">Ask about Training Methods</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_9_0_3">
    <VALUE Lang="th">Ask about Combat Methods</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_9_0_4">
    <VALUE Lang="th">Ask about Skill Points</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_9_0_5">
    <VALUE Lang="th">Ask about the College</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_9_0_6">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_1_0">
    <VALUE Lang="th">This section is exclusive to Sword Section Students. You can stay and watch for a while if you'd like.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_1_1">
