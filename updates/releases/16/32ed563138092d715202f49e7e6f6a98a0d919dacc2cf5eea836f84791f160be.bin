  <SENTENSE Ver="1" Id="2016_oblivionpotione.ntk_1_0">
    <VALUE Lang="th">Skill balancing compensation for Brawler, Shaman, and Magician class users.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oblivionpotione.ntk_1_0_1">
