  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_1_5">
    <VALUE Lang="th">Clitter-clatter! Do you know who I am? If you get the answer, I’ll give you a good thing. Uh-oh! Nothing comes for free! I want something sweet. Nothing is going to happen with that small candy! Bring me big one!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">5 Halloween candies = Test Paper I</VALUE>
    <VALUE Lang="th">5 Halloween candies + 1 Big Halloween silver lollipop = Test Paper II</VALUE>
    <VALUE Lang="th">5 Halloween candies + 1 Big Halloween gold lollipop = Test Paper III</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_1_5_1">
    <VALUE Lang="th">Start a test</VALUE>
  </SENTENSE>
