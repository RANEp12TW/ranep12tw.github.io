  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_8_0_2"><VALUE Lang="tw">兌換 終極．火焰風暴（67級／終極部）</VALUE><VALUE Lang="GS">Skill book: Fire Storm (Lv67, Class=48, Item=179/7)</VALUE><VALUE Lang="id">Skill book: Fire Storm (Lv67, Class=48, Item=179/7)</VALUE><VALUE Lang="cn">Skill book: Fire Storm (Lv67, Class=48, Item=179/7)</VALUE><VALUE Lang="th">Skill book: Fire Storm (Lv67, Class=48, Item=179/7)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_8_0_3"><VALUE Lang="tw">兌換 終極．化學彈藥（207級／終極部）</VALUE><VALUE Lang="GS">Skill book: Chemical Munition (Lv207, Class=48, Item=179/21)</VALUE><VALUE Lang="id">Skill book: Chemical Munition (Lv207, Class=48, Item=179/21)</VALUE><VALUE Lang="cn">Skill book: Chemical Munition (Lv207, Class=48, Item=179/21)</VALUE><VALUE Lang="th">Skill book: Chemical Munition (Lv207, Class=48, Item=179/21)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_8_0_4"><VALUE Lang="tw">兌換 終極．白炎彈（67級／終極部）</VALUE><VALUE Lang="GS">Skill book: White Fireballs (Lv67, Class=48, Item=179/35)</VALUE><VALUE Lang="id">Skill book: White Fireballs (Lv67, Class=48, Item=179/35)</VALUE><VALUE Lang="cn">Skill book: White Fireballs (Lv67, Class=48, Item=179/35)</VALUE><VALUE Lang="th">Skill book: White Fireballs (Lv67, Class=48, Item=179/35)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_8_0_5"><VALUE Lang="tw">兌換 終極．颶風雙刃（207級／終極部）</VALUE><VALUE Lang="GS">Skill book: Hurricane Blades (Lv207, Class=48, Item=179/49)</VALUE><VALUE Lang="id">Skill book: Hurricane Blades (Lv207, Class=48, Item=179/49)</VALUE><VALUE Lang="cn">Skill book: Hurricane Blades (Lv207, Class=48, Item=179/49)</VALUE><VALUE Lang="th">Skill book: Hurricane Blades (Lv207, Class=48, Item=179/49)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_8_0_6"><VALUE Lang="tw">兌換 終極．流星風暴（67級／終極部）</VALUE><VALUE Lang="GS">Skill book: Meteor Storm (Lv67, Class=48, Item=179/63)</VALUE><VALUE Lang="id">Skill book: Meteor Storm (Lv67, Class=48, Item=179/63)</VALUE><VALUE Lang="cn">Skill book: Meteor Storm (Lv67, Class=48, Item=179/63)</VALUE><VALUE Lang="th">Skill book: Meteor Storm (Lv67, Class=48, Item=179/63)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_8_0_7"><VALUE Lang="tw">兌換 終極．火焰漩渦（207級／終極部）</VALUE><VALUE Lang="GS">Skill book: Fire Whirl (Lv207, Class=48, Item=179/77)</VALUE><VALUE Lang="id">Skill book: Fire Whirl (Lv207, Class=48, Item=179/77)</VALUE><VALUE Lang="cn">Skill book: Fire Whirl (Lv207, Class=48, Item=179/77)</VALUE><VALUE Lang="th">Skill book: Fire Whirl (Lv207, Class=48, Item=179/77)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_8_0_8"><VALUE Lang="tw">兌換 終極．庫莫拉之躍（107級／終極部）</VALUE><VALUE Lang="GS">Skill book: Kumora's Leap (Lv107, Class=48, Item=179/95)</VALUE><VALUE Lang="id">Skill book: Kumora's Leap (Lv107, Class=48, Item=179/95)</VALUE><VALUE Lang="cn">Skill book: Kumora's Leap (Lv107, Class=48, Item=179/95)</VALUE><VALUE Lang="th">Skill book: Kumora's Leap (Lv107, Class=48, Item=179/95)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_8_0_9">
    <VALUE Lang="th">scroll of Titan's Mettle</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0">
    <VALUE Lang="th">What do you want to exchange among 17th grade skills?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_10"><VALUE Lang="tw">兌換 終極．連鎖精神（137級／終極部）</VALUE><VALUE Lang="GS">Skill book: Chain Spirit (Lv137, Class=48, Item=179/98)</VALUE><VALUE Lang="id">Skill book: Chain Spirit (Lv137, Class=48, Item=179/98)</VALUE><VALUE Lang="cn">Skill book: Chain Spirit (Lv137, Class=48, Item=179/98)</VALUE><VALUE Lang="th">Skill book: Chain Spirit (Lv137, Class=48, Item=179/98)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_2"><VALUE Lang="tw">兌換 終極．火神之箭（77級／終極部）</VALUE><VALUE Lang="GS">Skill book: Vulcanus Arrow (Lv77, Class=48, Item=179/8)</VALUE><VALUE Lang="id">Skill book: Vulcanus Arrow (Lv77, Class=48, Item=179/8)</VALUE><VALUE Lang="cn">Skill book: Vulcanus Arrow (Lv77, Class=48, Item=179/8)</VALUE><VALUE Lang="th">Skill book: Vulcanus Arrow (Lv77, Class=48, Item=179/8)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_3"><VALUE Lang="tw">兌換 終極．毒煙（217級／終極部）</VALUE><VALUE Lang="GS">Skill book: Poison Smoke (Lv217, Class=48, Item=179/22)</VALUE><VALUE Lang="id">Skill book: Poison Smoke (Lv217, Class=48, Item=179/22)</VALUE><VALUE Lang="cn">Skill book: Poison Smoke (Lv217, Class=48, Item=179/22)</VALUE><VALUE Lang="th">Skill book: Poison Smoke (Lv217, Class=48, Item=179/22)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_4"><VALUE Lang="tw">兌換 終極．不朽重擊（77級／終極部）</VALUE><VALUE Lang="GS">Skill book: Immortal Blow (Lv77, Class=48, Item=179/36)</VALUE><VALUE Lang="id">Skill book: Immortal Blow (Lv77, Class=48, Item=179/36)</VALUE><VALUE Lang="cn">Skill book: Immortal Blow (Lv77, Class=48, Item=179/36)</VALUE><VALUE Lang="th">Skill book: Immortal Blow (Lv77, Class=48, Item=179/36)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_5"><VALUE Lang="tw">兌換 終極．踏擊連環（217級／終極部）</VALUE><VALUE Lang="GS">Skill book: Stomp Chain Attack (Lv217, Class=48, Item=179/50)</VALUE><VALUE Lang="id">Skill book: Stomp Chain Attack (Lv217, Class=48, Item=179/50)</VALUE><VALUE Lang="cn">Skill book: Stomp Chain Attack (Lv217, Class=48, Item=179/50)</VALUE><VALUE Lang="th">Skill book: Stomp Chain Attack (Lv217, Class=48, Item=179/50)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_6"><VALUE Lang="tw">兌換 終極．召靈（77級／終極部）</VALUE><VALUE Lang="GS">Skill book: Evocation (Lv77, Class=48, Item=179/64)</VALUE><VALUE Lang="id">Skill book: Evocation (Lv77, Class=48, Item=179/64)</VALUE><VALUE Lang="cn">Skill book: Evocation (Lv77, Class=48, Item=179/64)</VALUE><VALUE Lang="th">Skill book: Evocation (Lv77, Class=48, Item=179/64)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_7"><VALUE Lang="tw">兌換 終極．爆裂衝擊（217級／終極部）</VALUE><VALUE Lang="GS">Skill book: Explosive Blast (Lv217, Class=48, Item=179/78)</VALUE><VALUE Lang="id">Skill book: Explosive Blast (Lv217, Class=48, Item=179/78)</VALUE><VALUE Lang="cn">Skill book: Explosive Blast (Lv217, Class=48, Item=179/78)</VALUE><VALUE Lang="th">Skill book: Explosive Blast (Lv217, Class=48, Item=179/78)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_8"><VALUE Lang="tw">兌換 終極．戰吼（117級／終極部）</VALUE><VALUE Lang="GS">Skill book: War Cry (Lv117, Class=48, Item=179/96)</VALUE><VALUE Lang="id">Skill book: War Cry (Lv117, Class=48, Item=179/96)</VALUE><VALUE Lang="cn">Skill book: War Cry (Lv117, Class=48, Item=179/96)</VALUE><VALUE Lang="th">Skill book: War Cry (Lv117, Class=48, Item=179/96)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_9"><VALUE Lang="tw">兌換 終極．致命堡壘（127級／終極部）</VALUE><VALUE Lang="GS">Skill book: Fatal Fort (Lv127, Class=48, Item=179/97)</VALUE><VALUE Lang="id">Skill book: Fatal Fort (Lv127, Class=48, Item=179/97)</VALUE><VALUE Lang="cn">Skill book: Fatal Fort (Lv127, Class=48, Item=179/97)</VALUE><VALUE Lang="th">Skill book: Fatal Fort (Lv127, Class=48, Item=179/97)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_0">
    <VALUE Lang="th">Hi there! I am Sia, the Manager of Assassin.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_0_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1">
    <VALUE Lang="th">Assassin Instructor is at the campus. If you need something then just talk to me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_1">
    <VALUE Lang="th">Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_10">
    <VALUE Lang="th">Train</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_11">
    <VALUE Lang="th">Volunteer for the Leonine Campus research.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_12">
    <VALUE Lang="th">Ask what is wrong</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_2">
    <VALUE Lang="th">Ask about Saint List</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_3">
    <VALUE Lang="th">Ask about Saint List</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_4">
    <VALUE Lang="th">Ask about Saint List</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_5">
    <VALUE Lang="th">Tell what Dispatched agent said</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_6">
    <VALUE Lang="th">Report the training result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_7">
    <VALUE Lang="th">Report the training result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_8">
    <VALUE Lang="th">Hand over the Books</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_9">
    <VALUE Lang="th">Train</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_10_0">
    <VALUE Lang="th">Oh there is a good opponent!</VALUE>
    <VALUE Lang="th">The Skating Boys who always wander around in a group to threat the terrified people. You will be able to learn about the unnecessary movements you may have while defeating them. Go on!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_10_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_11_0">
    <VALUE Lang="th">You sure have improved a lot compare to when you have just came to me but you still haven't fixed bad habits that create unnecessary movements.</VALUE>
    <VALUE Lang="th">I think you need more training so I recommend you to go defeat Bloody Mary who have gotten more violent.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_11_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_12_0">
    <VALUE Lang="th">You must be really curious about what happened in Leonine Campus. I am sure you have no problem going into Leonine Campus for research now but the Dispatched Agent stationed there won't trust your ability….</VALUE>
    <VALUE Lang="th">Oh, there is a way!</VALUE>
    <VALUE Lang="th">I heard there is a mutatant monster called Poison Ivy at Leonine Campus. Defeat a few of them and collect their hands made of bines then the agent will trust you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_12_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_13_0">
    <VALUE Lang="th">My research book had been stolen. I have recorded the data of the unnatural happenings just before the phenomenon but the Freezing Clowns have took it. I was too naive and never imagined getting it stolen to them… I would like to go by myself but there is a very important task which Ryuin the Assassin Instructor has asked me to do so would you please get my book back?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_13_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_2_0">
    <VALUE Lang="th">Us, assassins have known a bit more about the meteorite phenomenon that had happened 18 years ago. The director of Saint Foundation must have known about the relationship between our world and Another World. I heard that he once mentioned that the previously done acts of both sides of world will eventually effect the world of today.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_2_0_1">
    <VALUE Lang="th">Continue the conversation.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_3_0">
    <VALUE Lang="th">The meteorite actually was something else…</VALUE>
    <VALUE Lang="th">The creatures from the Another World could not cross over to our world in its original form and it was divided into a transmittable form to cross over. Saint List was the list that contained the list of the people like us who came over in that form. That is why we are the only ones who could withstand the phenomenon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_3_0_1">
    <VALUE Lang="th">Continue the conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_4_0">
    <VALUE Lang="th">I guess the Foundation wanted to gather students like us and prepare before the phenomenon hit the world…</VALUE>
    <VALUE Lang="th">It was the matter of survivor of our world and that is why they have done such things.. The adults are all the same..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_4_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_5_0">
    <VALUE Lang="th">I see, so you would like to help the dispatched agent researching Leonine Campus but you are not strong enough.</VALUE>
    <VALUE Lang="th">Ok! Don't worry! I will make sure to train you strong enough for Leonine Campus.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_5_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_6_0">
    <VALUE Lang="th">How was your fight against the Skating Boys? Since you came back in one piece, I guess they were alright to fight against. If not then you must be already…. Never mind!</VALUE>
    <VALUE Lang="th">Okay, just don't get too confident over a few wins against the Skating Boys. They are the easiest targets you can face here.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_6_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_7_0">
    <VALUE Lang="th">Guess, it was not easy for you this time! It took longer than expected. But you are back safe so it must be worth it. Well, you should have learned to be more careful and be modest about your skills. Now you will be hard one to defeat for the mobs..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_7_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_8_0">
    <VALUE Lang="th">Did you get my notebooks back from Freezing Clowns?</VALUE>
    <VALUE Lang="th">Thank you so much! I was so mad when these were stolen. I had such a hard time collecting these data. Thank you, I wouldn't need to do it all over again. If my books are helpful to resolve the sudden phenomenon then it would be all for you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_8_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_9_0">
    <VALUE Lang="th">As you may already know, it is essential for us the assassins to defeat an opponent quickly and precisely. In order to do that we must reduce the unnecessary movements.</VALUE>
    <VALUE Lang="th">The problem is that it really is hard to understand the unnecessary movements without actual field experiences. As all the people have different looks, each one has unique habit when performing a same skill and those habits create vulnerability. Therefore, field experiences are essential to find out what unnecessary movements they each have.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_9_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nurse_sport.ntk_1_0">
    <VALUE Lang="th">Oh my goodness! Why are so many people injured?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nurse_sport.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_obinain.ntk_1_0">
    <VALUE Lang="th">Wow, you managed to defeat Tagger Choi.. You are definitely something else!!</VALUE>
    <VALUE Lang="th">It's a shame that you didn't deliver the finishing blow~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hm.. It seems like the thing that we feared has come to be.</VALUE>
    <VALUE Lang="th">Prof. Tagger wants to conquer this world and he seems to be collecting his powers now.</VALUE>
    <VALUE Lang="th">His target is to come back to this life...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Prof Tagger should have finished recovering by now and he will soon reappears with new powers.</VALUE>
    <VALUE Lang="th">Quick go to your campus and prepare for his arrival!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_obinain.ntk_1_0_1">
    <VALUE Lang="th">Potion Sale</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_obinain.ntk_1_0_2">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_obinain.ntk_2_0">
    <VALUE Lang="th">Turns out there is a big secret~</VALUE>
    <VALUE Lang="th">Saint Foundation is currently researching about the current world and the other dimension!</VALUE>
    <VALUE Lang="th">The research needs "Faint Dimension Trace" which you might obtain by defeating Prof Tagger.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can exchange the "Faint Dimension Trace" with a variety of excellent rewards. The more you collect, the better the rewards~!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olditemexch.ntk_1_0">
    <VALUE Lang="th">Hey~ Welcome~</VALUE>
    <VALUE Lang="th">I was the one who exchanged the old material items to the new ones before.</VALUE>
    <VALUE Lang="th">If you still need to exchange it, feel free to talk to me~</VALUE>
    <VALUE Lang="th">Another tip about the new items is, all new items from shop, compounding, drop have additional stats (green) and random options (light blue). If you don't like them, you can reform them using the additional stats reform card (green), and reform card (light blue).</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olditemexch.ntk_1_0_1">
    <VALUE Lang="th">물품매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_oldskillbook.ntk_1_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_oldskillbook.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_0">
    <VALUE Lang="th">올림픽 주화를 모두 모아 오셨네요.</VALUE>
    <VALUE Lang="th">모아오신 올림픽 주화를 모두 드리지는 못하고...</VALUE>
    <VALUE Lang="th">기념하는 의미로 한개만 드릴께요</VALUE>
    <VALUE Lang="th">하지만 이 주화는 18일이 지나면 사라지는 거라서 기념용이라고 하기에는 좀...</VALUE>
    <VALUE Lang="th">한국이 획득할 거라고 예상되는 총 메달수가 적힌 티켓으로 바꾸셔서 보관하시는 게 좋을거예요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_0_1">
    <VALUE Lang="th">올림픽 주화를 전달한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1">
    <VALUE Lang="th">한국이 최종적으로 획득할 거라고 예상되는 메달의 수를 선택하세요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">제 1군 : 20 ~ 25</VALUE>
    <VALUE Lang="th">제 2군 : 26 ~ 30</VALUE>
    <VALUE Lang="th">제 3군 : 31 ~ 35</VALUE>
    <VALUE Lang="th">제 4군 : 35 ~ 40</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1_1">
    <VALUE Lang="th">제 1군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1_2">
    <VALUE Lang="th">제 2군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1_3">
    <VALUE Lang="th">제 3군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1_4">
    <VALUE Lang="th">제 4군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_2">
    <VALUE Lang="th">올림픽이 끝나고 총 메달수 획득수가 확인된 후에 가지고 계신 티켓의 숫자와 메달수가 일치한다면 메달수 X 10000 의 금액으로 환전하실 수 있게 될 거예요</VALUE>
    <VALUE Lang="th">음... 아마 9월 1일부터 환전이 가능해질 것 같군요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_3">
    <VALUE Lang="th">지금 아테네 올림픽이 개최되고 있다는 건 아시죠?</VALUE>
    <VALUE Lang="th">교통망이 정상이 아니라서 직접 가 볼수는 없지만 멀리서나마 응원할 수 있도록 하는 이벤트를 만들었어요</VALUE>
    <VALUE Lang="th">과연 최종적으로 한국이 획득하는 총 메달의 수는 몇개나 될까요?</VALUE>
    <VALUE Lang="th">잘 맞추시면 큰 행운도 따라올거예요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_3_1">
    <VALUE Lang="th">올림픽 주화를 입수한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_2_0">
    <VALUE Lang="th">한국이 최종적으로 획득할 거라고 예상되는 총 메달 수를 고르세요</VALUE>
  </SENTENSE>
