  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_31">
    <VALUE Lang="th">I would like to make some goods, I need</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_32">
    <VALUE Lang="th">아이런맨 코스튬에 대해 묻는다.</VALUE>
  </SENTENSE>
