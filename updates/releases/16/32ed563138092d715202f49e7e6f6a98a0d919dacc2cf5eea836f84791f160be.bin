    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_12_0">
    <VALUE Lang="th">Oh! Wait! I must take care of something really quick…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_12_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_13_0">
    <VALUE Lang="th">Paper work is too complicated! Okay, the registration is complete and I must process the Exit Approval Form…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_13_0_1">
