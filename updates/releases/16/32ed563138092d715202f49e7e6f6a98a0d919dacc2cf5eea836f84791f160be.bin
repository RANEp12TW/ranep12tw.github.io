  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_3">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_4">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_5">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_6">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_7">
    <VALUE Lang="th">Give the Medication</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_8">
    <VALUE Lang="th">Ask about the Lost Child</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_9">
    <VALUE Lang="th">Request for Cassette Recovery</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_10_0">
    <VALUE Lang="th">Is it about Mr. Brave?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes? Sometimes I hear people complaining about him. I just ignore them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_11_0">
    <VALUE Lang="th">That's right, this is the oil!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So, where did you get these?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_12_0">
    <VALUE Lang="th">.....2</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_13_0">
    <VALUE Lang="th">What? Broken Cassette?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can't help you with that right now!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">My daughter has such a high fever!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please, please help my daughter! She needs immediate medical treatment!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_14_0">
    <VALUE Lang="th">........8</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_15_0">
    <VALUE Lang="th">You better check out the content of the cassette before returning it back to the Campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_15_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_16_0">
    <VALUE Lang="th">......10</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_17_0">
    <VALUE Lang="th">Please take good care of that cassette!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's very fragile: we might not be able to recover its data again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_17_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_18_0">
    <VALUE Lang="th">I'm so stressed out!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Need some Special Oil to recover my dizziness.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please help me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_18_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_19_0">
    <VALUE Lang="th">I already ordered that Special Oil, but it hasn't been delivered to me yet. I heard that it was unloaded at No.3 Wharf. Can you go there and get it for me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_19_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0">
    <VALUE Lang="th">The Hospital services are unable to treat my daughter. Sadly, the Police Department cannot do their duties. It is total chaos around here. Please! You must help my daughter...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you do, then I'll help you to recover that Cassette.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_2">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_3">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_4">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_5">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_6">
    <VALUE Lang="th">Refuse</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_7">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_20_0">
    <VALUE Lang="th">Could you help me look for it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Meanwhile, I'll just try my best to relax.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, and please be careful. I hear that area's kind of dangerous.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_20_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_21_0">
    <VALUE Lang="th">Our radio also acts up like this…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It seems to be caused by a magnetic field.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_21_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_22_0">
    <VALUE Lang="th">Oh, this is a walkie-talkie! We can use this to talk to each other.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But now we know a little more. Try going to that location and taking a look.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_22_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_23_0">
    <VALUE Lang="th">So lucky!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Sure, I think I can repair this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_23_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_24_0">
    <VALUE Lang="th">Finally... There's a student who wants to enter the Head Office.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why? My shop required to prepare this equipment.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Who is expecting this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's none of my business, but I'm a bit worried about you since you helped me a lot before.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_24_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_25_0">
    <VALUE Lang="th">Can I see?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh… It's that one.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes? Oh… A year ago, I read some stuff about this, and decided to get trained for it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Let me see. All the parts are here…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Huh, there's a crack here. I just need to hold it in place, use this paste to attach it…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm going to need a crystal powder that you can get in the underground prison. I'll show you how to use that crystal powder to affix the parts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_25_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_3_0">
    <VALUE Lang="th">Is that real?!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Nurse told us that it wasn't a common allergy, so treating it wasn't easy. I've heard something at the Police Station about the treatment, but I can't remember what it was.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_4_0">
    <VALUE Lang="th">I am sorry....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can't help you recover the Cassette.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0">
    <VALUE Lang="th">You already found the medication!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This medicine will help my daughter ... As promised, I will now help you recover the Cassette.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0_1">
    <VALUE Lang="th">Request Cassette Recovery Again</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0_2">
    <VALUE Lang="th">Request Cassette Recovery Again</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0_3">
    <VALUE Lang="th">Request Cassette Recovery Again</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0_4">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_6_0">
    <VALUE Lang="th">First of all, the nature of our business is Video Rental. We have no available equipment to recover Cassettes.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I think it'll be difficult to recover the data on this Cassette. We'll need special equipment, but I think the people at the Police Station can help us. Can you help me acquire the necessary equipment to fix this Cassette from the Police Station?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0">
    <VALUE Lang="th">Ah, thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Let me try to fix this....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Just wait for 2 seconds. I'll let you observe my expertise on Video Equipment.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0_1">
    <VALUE Lang="th">Wait</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0_2">
    <VALUE Lang="th">Wait</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0_3">
    <VALUE Lang="th">Wait</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0_4">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_8_0">
    <VALUE Lang="th">Here! It is done!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even though we cannot recover the entirety of the video, I think this will help you a lot. The video still has its essential content. I made two copies for you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_8_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_9_0">
    <VALUE Lang="th">About that?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I heard it before, but I was more worried about my daughter. Sorry, but I couldn't help it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_1_0">
    <VALUE Lang="th">I regent… Ordinariness!</VALUE>
    <VALUE Lang="th">I pursuit for Greatness, Splendor and Powerfulness which I already possess~ HaHaHaHa~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Look at me! I, alone stand out in this Market Place. You must desire the same and that is why you came to me, right? Are you ready?</VALUE>
    <VALUE Lang="th">Let's be the hero of this world together.</VALUE>
    <VALUE Lang="th">Yes, you! I am talking to you!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_1_0_1">
    <VALUE Lang="th">You are Magnificent!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_1_0_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_1_0_3">
    <VALUE Lang="th">Asking about Ran world on style event</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_1_0_4">
    <VALUE Lang="th">Take the Quiz.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_1_0_5">
    <VALUE Lang="th">Lightning Warrior Pet can be fusion into a New Pet</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_10_0">
    <VALUE Lang="th">[Basic Level Question 3]</VALUE>
    <VALUE Lang="th">-----------------------------------------------</VALUE>
    <VALUE Lang="th">What anniversary does Ran World celebrated on 2012?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_10_0_1">
    <VALUE Lang="th">1) 1st Ann</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_10_0_2">
    <VALUE Lang="th">2) 2nd Ann</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_10_0_3">
    <VALUE Lang="th">3) 3rd Ann</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_10_0_4">
    <VALUE Lang="th">4) 100th Ann</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_10_0_5">
    <VALUE Lang="th">5) 5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_11_0">
    <VALUE Lang="th">[Basic Level Question 4]</VALUE>
    <VALUE Lang="th">-----------------------------------------------</VALUE>
    <VALUE Lang="th">What is the maximum level of Ran world?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_11_0_1">
    <VALUE Lang="th">1) 100</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_11_0_2">
    <VALUE Lang="th">2) 200</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_11_0_3">
    <VALUE Lang="th">3) 230</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_11_0_4">
    <VALUE Lang="th">4) 500</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_11_0_5">
    <VALUE Lang="th">5) 5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_12_0">
    <VALUE Lang="th">[Basic Level Question 5]</VALUE>
    <VALUE Lang="th">-----------------------------------------------</VALUE>
    <VALUE Lang="th">Extreme Class can be created once you have a character of what level?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_12_0_1">
    <VALUE Lang="th">1) 10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_12_0_2">
    <VALUE Lang="th">2) 195</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_12_0_3">
    <VALUE Lang="th">3) 190</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_12_0_4">
    <VALUE Lang="th">4) 230</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_12_0_5">
    <VALUE Lang="th">5) 10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_13_0">
    <VALUE Lang="th">[Intermediate Level Question 1]</VALUE>
    <VALUE Lang="th">-----------------------------------------------</VALUE>
    <VALUE Lang="th">What is the brand new class of Ran World that was updated on 2012?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_13_0_1">
    <VALUE Lang="th">1) Swordsman</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_13_0_2">
    <VALUE Lang="th">2) Scientist</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_13_0_3">
    <VALUE Lang="th">3) Extreme</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_13_0_4">
    <VALUE Lang="th">4) Assassin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_13_0_5">
    <VALUE Lang="th">5) 10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_14_0">
    <VALUE Lang="th">[Intermediate Level Question 2]</VALUE>
    <VALUE Lang="th">-----------------------------------------------</VALUE>
    <VALUE Lang="th">What system allows you to purchase billing item in the game?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_14_0_1">
    <VALUE Lang="th">1) Point Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_14_0_2">
    <VALUE Lang="th">2) Capsule Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_14_0_3">
    <VALUE Lang="th">3) Hair Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_14_0_4">
    <VALUE Lang="th">4) Pet Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_14_0_5">
