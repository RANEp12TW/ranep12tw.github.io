  <SENTENSE Ver="1" Id="npc_p_police.ntk_1_0_9">
    <VALUE Lang="th">Report Main Culprit of Violence</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_10_0">
    <VALUE Lang="th">I also feel the same way. I'm just a policeman, but it's obvious that there's something extraordinary is happening inside. I can't tell what it is, but it's definitely not good.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_11_0">
    <VALUE Lang="th">Understood.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I might be the only one who understands that place's design.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please first check out the places that I told you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_12_0">
    <VALUE Lang="th">The facilities nearby should be checked out.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If the quake's source comes from beneath, obviously we have to enter the underground center to find out more...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We should know after checking out a few places nearby.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_12_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_13_0">
    <VALUE Lang="th">Now we should focus on investigating the underground facilities, and then we can start after preparing sufficient manpower and equipment. Let's go and confirm the facilities underground again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Next, we should investigate the Prison facility.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_14_0">
    <VALUE Lang="th">There still aren't any reliable clues.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">After some investigation, it seems that only the convicts might be able to escape from the prison</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There's no way to do it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even if we barely have any information, we still need to report this to the Trading Hole Police.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_14_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_15_0">
    <VALUE Lang="th">I heard that the students are quite cautious.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you for your help…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Whatever happened definitely wasn't normal. How many were killed?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I will seek revenge for my friends, even if I have to die.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That is my destiny.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">See you...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_15_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_16_0">
    <VALUE Lang="th">That glove is made from asbestos.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The shoes are also made of flame retardant material.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Usually, he isn't very reliable.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This towel… Smells poisonous.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It smells like something is burning?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_16_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_17_0">
    <VALUE Lang="th">The mystery is solved.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The culprits are still inside.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's the guard!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_18_0">
    <VALUE Lang="th">There's no way to capture it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It won't be easy since it transformed into a monster.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But now the spirits of the fallen police may rest.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It will be much easier now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I represent the police in giving thanks to the students.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much... Really, thank you all so much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_18_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_19_0">
    <VALUE Lang="th">I just returned.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">A criminal passed by just now, and I caught him.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I have some pieces, this weird stuff…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Though, we have to see it completely to find out...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's obvious that it has the same logo as the government.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know whether this has bigger implications.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me find the other pieces?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_19_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_2_0">
    <VALUE Lang="th">There was a sudden explosion, and the people... Something weird happened to them!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It almost seems natural for the criminals to have become more violent.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even the police and watchmen's power increased.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_2_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_20_0">
    <VALUE Lang="th">Can you show me where?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's fake.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">When you first see it and it's undamaged, you wouldn't be able to discern whether it's fake or not</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You did well to figure it out, but you were also able to tell it was fake because it was in such a broken condition.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_20_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_21_0">
    <VALUE Lang="th">Actually, the certificate surface requires some stacked negatives.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It'll be too troublesome to reject them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please report this to the Trading Hole Police.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_21_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_22_0">
    <VALUE Lang="th">A prison run by a Financial Group. Isn't it strange?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even if it is recognized internationally, it's still a little weird.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If it weren't for my duties being assigned to this place, then I never would have come.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It was the first time I've been in such a bad environment that all I thought about was escape.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I think I saw some strange creature before I got out.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah, it's not the right time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please report the Prison's current state to the Trading Hole police.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_22_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_23_0">
    <VALUE Lang="th">Oh, you mean this box?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is the only thing that remains after escaping the prison.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I had no idea it was like that…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">But it has been very helpful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I think it has to do with something that is locked on the 2nd floor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It can be opened as long as you find the key and CD. Do you need any help?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_23_0_1">
    <VALUE Lang="th">Promise</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_23_0_5">
    <VALUE Lang="th">Decline</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_24_0">
    <VALUE Lang="th">As long as you have the key and CD, it will be alright.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Besides us, it's guarded by former guards of the Citizens Company.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can find it from them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_24_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_25_0">
    <VALUE Lang="th">Thank you very much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can help you shortly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_25_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_26_0">
    <VALUE Lang="th">It's a mutated ore found near the prison.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's rarely seen.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can find the broken stone at the Ore Mine which is between the prison fences.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_26_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_27_0">
    <VALUE Lang="th">Thank you for your help in the investigation. There's still a small matter of collecting a few important items that will be needed. I hope you may be able to help me find them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_27_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_28_0">
    <VALUE Lang="th">Thanks to you, the investigation is running smoothly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_28_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_29_0">
    <VALUE Lang="th">Please get a weapon there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I know about the place that hides weapons.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_29_0_1">
    <VALUE Lang="th">Agree</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_29_0_2">
    <VALUE Lang="th">Ignore</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_3_0">
    <VALUE Lang="th">There's no way to guard the prison. I wanted to run away to the Trading Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It slowly dawned on me that I was the only one left.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">My whole body was trembling and I didn't want to even think about going inside.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_30_0">
    <VALUE Lang="th">Good luck!!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_30_0_1">
    <VALUE Lang="th">Ignore</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_31_0">
    <VALUE Lang="th">I am worried that if the rioting prisoners might escape from the prison because of the chaos created by the Phenomenon. We must stop the riot before they escape but we have left all the armors and weapons inside… I know it is not easy but would you please go find them inside the prison?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_31_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_32_0">
    <VALUE Lang="th">Good! It may not be possible to defeat all the prisoners but it will be possible to stop them from esacping from the prison.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_32_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_4_0">
    <VALUE Lang="th">The student is from the Sacred Financial Group college.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Well, do you want to listen to my request?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_4_0_1">
    <VALUE Lang="th">Reply</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_4_0_2">
    <VALUE Lang="th">Resists</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_5_0">
    <VALUE Lang="th">Please help my friends...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know if we're too late.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I remember that it's near the Main Gate.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_6_0">
    <VALUE Lang="th">We're too late.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you still want to try?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please listen… I still need you to help me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">My friends were killed by those scumbags. Please find the culprit so he can be punished!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_7_0">
    <VALUE Lang="th">쮁┳짩퇱툹쿽閑좥쨓랫줄쫇閑?좥지킡촑㏀윰갠ず㉵...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">쩑㏀ず?짵좥㉩τ㉵밴쫇ㄳ쩳?좥쿽퀿촑㏀춏ヴ캵ず좥㉲쩈좥춏쨛ㅯ좧</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_8_0">
    <VALUE Lang="th">I can't understand it…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even if it were just a mere psychological illness, this should never have happened...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Well, I guess I don't know for sure.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_8_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_9_0">
    <VALUE Lang="th">Even the police are starting to rebel.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">No matter how you look at it, it's not normal.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I heard that the Trading Hole police are alright, aren't they?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please you should report this to them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know what else is happening. I need to wait for my orders here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police_d1.ntk_1_0">
    <VALUE Lang="th">(Still alive)</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police_d1.ntk_1_0_1">
    <VALUE Lang="th">Confirmation of body</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police_d1.ntk_2_0">
    <VALUE Lang="th">(This body looks like it's still alive, but there's no pulse.)</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police_d1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police_d2.ntk_1_0">
    <VALUE Lang="th">(Still alive)</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police_d2.ntk_1_0_1">
    <VALUE Lang="th">Confirmation of Body</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police_d2.ntk_2_0">
    <VALUE Lang="th">(This body looks like it's still alive, but there's no pulse.)</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police_d2.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_1_0">
    <VALUE Lang="th">My memories…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_1_0_1">
    <VALUE Lang="th">Ask about Violence</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_1_0_2">
    <VALUE Lang="th">Ask if Violence was on Purpose</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_2_0">
    <VALUE Lang="th">I did something wrong...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I committed crimes... I was a convict...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It seems like I can leave now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't understand why I behaved that way.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's like there was this voice... Telling me to murder...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_3_0">
    <VALUE Lang="th">It was as if someone was in my head making me do it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I knew it was wrong, but…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I guess it's pointless to explain…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I always thought that it was a bad thing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">…Yes, I started the rebellion.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why… Is this happening to me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you see my leg?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It looks… Alive, doesn't it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_3_0_1">
    <VALUE Lang="th">return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_premium_bank.ntk_1_0">
    <VALUE Lang="th">No, haven't you seen it before?</VALUE>
    <VALUE Lang="th">Why do I always meet these kind of people everywhere I go..</VALUE>
    <VALUE Lang="th">Please get rid of those evil guys before they ruin my precious collectibles!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_premium_bank.ntk_1_0_1">
    <VALUE Lang="th">Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_premium_bank.ntk_1_0_2">
    <VALUE Lang="th">[Repetitive] Subdue the Gang Leader</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_premium_bank.ntk_2_0">
    <VALUE Lang="th">If you get rid of the guy who commands those evil guys, wouldn't all of them run away?</VALUE>
    <VALUE Lang="th">Please find that guy and defeat him.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_premium_bank.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_pvptotal_award.ntk_1_0">
    <VALUE Lang="th">Play the PVP contents and get some PVP Medals. Exchange it with special reward box.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">------------------------------------------------------------------------</VALUE>
    <VALUE Lang="th">PVP Medal can be obtained from CDM, Club War and Capture the Flag</VALUE>
    <VALUE Lang="th">------------------------------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_pvptotal_award.ntk_1_0_1">
    <VALUE Lang="th">Open Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_0">
    <VALUE Lang="th">주화를 입수해 오시면 행운번호 선택의 기회를 드립니다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_0_1">
    <VALUE Lang="th">주화를 입수한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_1">
    <VALUE Lang="th">주화를 가지고 오셨네요.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_1_1">
    <VALUE Lang="th">주화를 전달한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_10">
    <VALUE Lang="th">행운번호[ 8 ]를 이미 소지하고 계십니다. 더이상은 교환이 불가능 하오니, 다음기회를 이용해 주십시오, 소지하고 계시는 행운번호가 당첨되시기를 바랍니다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_11">
    <VALUE Lang="th">행운번호[ 9 ]를 이미 소지하고 계십니다. 더이상은 교환이 불가능 하오니, 다음기회를 이용해 주십시오, 소지하고 계시는 행운번호가 당첨되시기를 바랍니다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_12">
    <VALUE Lang="th">행운번호[ 10 ]를 이미 소지하고 계십니다. 더이상은 교환이 불가능 하오니, 다음기회를 이용해 주십시오, 소지하고 계시는 행운번호가 당첨되시기를 바랍니다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_13">
    <VALUE Lang="th">행운번호[ 11 ]를 이미 소지하고 계십니다. 더이상은 교환이 불가능 하오니, 다음기회를 이용해 주십시오, 소지하고 계시는 행운번호가 당첨되시기를 바랍니다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_14">
    <VALUE Lang="th">행운번호[ 12 ]를 이미 소지하고 계십니다. 더이상은 교환이 불가능 하오니, 다음기회를 이용해 주십시오, 소지하고 계시는 행운번호가 당첨되시기를 바랍니다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_15">
    <VALUE Lang="th">행운번호[ 13 ]를 이미 소지하고 계십니다. 더이상은 교환이 불가능 하오니, 다음기회를 이용해 주십시오, 소지하고 계시는 행운번호가 당첨되시기를 바랍니다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_1_16">
    <VALUE Lang="th">행운번호[ 14 ]를 이미 소지하고 계십니다. 더이상은 교환이 불가능 하오니, 다음기회를 이용해 주십시오, 소지하고 계시는 행운번호가 당첨되시기를 바랍니다.</VALUE>
