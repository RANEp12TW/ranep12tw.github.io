    <VALUE Lang="th">I’ll give you a candy tomorrow too so please come~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_2_0_1">
    <VALUE Lang="th">Ask whether there is something else rather than candy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_1_0">
    <VALUE Lang="th">This is a Pumpkin box which looks just like my head! This precious box is resented only once a day!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_1_1">
    <VALUE Lang="th">This is a Pumpkin box which looks just like my head! This precious box is resented only once a day!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_1_1_1">
    <VALUE Lang="th">Receive a Pumpkin box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_2_0">
    <VALUE Lang="th">I give you a Pumpkin box every Saturday and Sunday so please visit me~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween07.ntk_1_0">
    <VALUE Lang="th">This is a Pumpkin box which looks just like my head! This precious box is resented only once a day!</VALUE>
