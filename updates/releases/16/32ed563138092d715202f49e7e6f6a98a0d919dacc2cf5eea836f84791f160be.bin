  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_6_0">
    <VALUE Lang="th">The target amount for purification has been achieved and verified. Thank you for all your efforts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
