  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_1_0_1">
    <VALUE Lang="th">Search ID and Password</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_1_1">
    <VALUE Lang="th">This is the 90th floor security Terminal.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The ID and Password are required to enter 90th floor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please enter the ID and password.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_1_1_1">
    <VALUE Lang="th">Enter ID and Password</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_1_2">
    <VALUE Lang="th">The 90th floor pass permission is already confirmed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">90th floor gate is opened.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
