  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0">
    <VALUE Lang="th">Some elements has stimulated in Saint Power Plant No.2. There are so many mobs but they are week and easy to kill. Please kill them fast! The more you kill the better reward you can receive~ You can enter event map from Elemental Shaman NPC which located in each campus</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">--- Open Time ---</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">[Lv30~130]</VALUE>
    <VALUE Lang="th">1:00, 5:00, 9:00, 13:00, 17:00, 21:00</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">[Lv131~195]</VALUE>
    <VALUE Lang="th">1:40, 5:45, 9:45, 13:45, 17:45, 21:45</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">[Lv196 or higher]</VALUE>
    <VALUE Lang="th">2:30, 6:30, 10:30, 14:30, 18:30, 22:30</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0_1">
    <VALUE Lang="th">How to go to Saint Power Plant No.2?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0_2">
    <VALUE Lang="th">How can I get the reward?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0_3">
    <VALUE Lang="th">I've collected kill!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_2_0">
    <VALUE Lang="th">You can enter event map from Elemental Shaman NPC which located in each campus</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">--- Open Time ---</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">[Lv30~130]</VALUE>
    <VALUE Lang="th">1:00, 5:00, 9:00, 13:00, 17:00, 21:00</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">[Lv131~195]</VALUE>
    <VALUE Lang="th">1:40, 5:45, 9:45, 13:45, 17:45, 21:45</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">[Lv196 or higher]</VALUE>
    <VALUE Lang="th">2:30, 6:30, 10:30, 14:30, 18:30, 22:30</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_3_0">
    <VALUE Lang="th">Hunted mobs in Saint Power Plant No.2 will drop a certificate to certifiy the number of kill. Collect it and I'll help you to exchangewith some useful items. The more kill number the better the reward.</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">---[ Exchage Event Helper ]---</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">1,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Fresh water</VALUE>
    <VALUE Lang="th">8,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Costume (1D) or Fresh water (Item to compound potion)</VALUE>
    <VALUE Lang="th">50,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Costume (7D) or Taxi card (10P)</VALUE>
    <VALUE Lang="th">80,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Costume (15D) or Gold beret (15D) or Ring costume (15D)</VALUE>
    <VALUE Lang="th">150,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Costume (30D) or Gold Beret (30D) or Ring costume (30D)</VALUE>
    <VALUE Lang="th">700,000 kill -&gt; Costume (Permanent) or Hat (Permanent)</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">---[ Compound ]---</VALUE>
    <VALUE Lang="th">Red Pudding (Small)[30]</VALUE>
    <VALUE Lang="th">= Small HP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="th">Red Pudding (Regular)[30]</VALUE>
    <VALUE Lang="th">= Medium HP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="th">Red Pudding (Large)[50]</VALUE>
    <VALUE Lang="th">= Daramai HP Recovery[50]+Fresh water[1]</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">Blue Pudding (Small)[30]</VALUE>
    <VALUE Lang="th">= Medium MP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="th">Blue Pudding (Regular)[30]</VALUE>
    <VALUE Lang="th">= Big MP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="th">Blue Pudding (Large)[50]</VALUE>
    <VALUE Lang="th">= Daramai MP Recovery[50]+Fresh water[1]</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">Green Pudding (Small)[30]</VALUE>
    <VALUE Lang="th">= Medium SP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="th">Green Pudding (Regular)[30]</VALUE>
    <VALUE Lang="th">= Big SP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="th">Green Pudding (Large)[50]</VALUE>
    <VALUE Lang="th">= Fresh water[1]+Fresh water[1]</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">All pudding (Small)[30]</VALUE>
    <VALUE Lang="th">= Small HP Recovery Potion[10]+Medium MP Recovery Potion[10]</VALUE>
    <VALUE Lang="th">+Medium SP Recovery Potion[10]+Fresh water[1]</VALUE>
    <VALUE Lang="th">All pudding (Regular)[30]</VALUE>
    <VALUE Lang="th">= Medium HP Recovery Potion[10]+Big MP Recovery Potion[10]</VALUE>
    <VALUE Lang="th">+Big SP Recovery Potion[10]+Fresh water[1]</VALUE>
    <VALUE Lang="th">All pudding (Large)[50]</VALUE>
    <VALUE Lang="th">= Daramai HP Recovery[15]+Daramai SP Recovery[15]</VALUE>
    <VALUE Lang="th">+Daramai MP Recovery[15]+Fresh water[1]</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_4_0">
    <VALUE Lang="th">Wow! You've collected a lot. Select one of the rewards you want!</VALUE>
    <VALUE Lang="th">*</VALUE>
    <VALUE Lang="th">1,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Fresh water</VALUE>
    <VALUE Lang="th">8,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Costume (1D) or Fresh water (Item to compound potion)</VALUE>
    <VALUE Lang="th">50,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Costume (7D) or Taxi card (10P)</VALUE>
    <VALUE Lang="th">80,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Costume (15D) or Gold beret (15D) or Ring costume (15D)</VALUE>
    <VALUE Lang="th">150,000 kill</VALUE>
    <VALUE Lang="th">-&gt; Costume (30D) or Gold Beret (30D) or Ring costume (30D)</VALUE>
    <VALUE Lang="th">700,000 kill -&gt; Costume (Permanent) or Hat (Permanent)</VALUE>
  </SENTENSE>
