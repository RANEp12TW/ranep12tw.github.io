  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_19">
    <VALUE Lang="th">School Voluntary Work III</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_2">
    <VALUE Lang="th">아이런맨 슈트를 받고 싶다고 말한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_20">
