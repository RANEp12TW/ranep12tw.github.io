  <SENTENSE Ver="1" Id="npc_p_knight.ntk_1_0">
    <VALUE Lang="th">Who defeated who?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Looks like there's not a single person dead.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_1_0_1">
    <VALUE Lang="th">Confirm</VALUE>
