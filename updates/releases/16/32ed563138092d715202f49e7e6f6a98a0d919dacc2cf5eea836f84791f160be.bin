    <VALUE Lang="th">Confirm</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_2_4">
    <VALUE Lang="th">Confirm</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_2_5">
    <VALUE Lang="th">Ask what Happened</VALUE>
