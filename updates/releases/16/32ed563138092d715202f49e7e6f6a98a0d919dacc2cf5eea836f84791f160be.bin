  <SENTENSE Ver="1" Id="2013_summer2.ntk_1_0_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_1_0">
    <VALUE Lang="th">Oh… you have brought me the Cupid Chocolate! Here, let's exchange it with the box which I made for my girlfriend!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_1_0_1">
    <VALUE Lang="th">Exchange</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_1_1">
    <VALUE Lang="th">I have fled to school with my girlfriend to avoid the powerful force of Medusa but on the way we have lost each other. I need to give this present to my girlfriend since it is the Valentine's Day, would you please help me?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_1_1_1">
    <VALUE Lang="th">Okay… How can I help?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_1_1_2">
    <VALUE Lang="th">Sorry… I am a bit busy at the moment.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_2_0">
    <VALUE Lang="th">There is a Cupid at MP campus and I heard that the Cupid Chocolate has very powerful effect.</VALUE>
    <VALUE Lang="th">I would like to give it to my girlfriend as a Valentine's day present… would you please get it for me?</VALUE>
    <VALUE Lang="th">Collect 50 Valentine Chocolates which you will be able to get easily in the world of Ran and bring them to Cupid to exchange it for 1 Cupid Chocolate!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_2_0_1">
    <VALUE Lang="th">Okay.. Let’s do that.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_2_0_2">
    <VALUE Lang="th">Umm.. I am busy right now but I will get'em when I have time.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_3_0">
    <VALUE Lang="th">You are heartless!.. Gee.. What should I get her…?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_boy.ntk_4_0">
    <VALUE Lang="th">Thank you! I am counting on you!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_cupid.ntk_1_0">
    <VALUE Lang="th">Wow, you have brought the Chocolate I told you about~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_cupid.ntk_1_0_1">
    <VALUE Lang="th">Exchange</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_cupid.ntk_1_1">
    <VALUE Lang="th">Hello! I am Cupid.</VALUE>
    <VALUE Lang="th">I have specially summoned myself here to make couples in Valentine's Day!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_cupid.ntk_1_1_1">
    <VALUE Lang="th">Please get me a girlfriend!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_cupid.ntk_1_1_2">
    <VALUE Lang="th">I heard there is a couple who needs your help!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_cupid.ntk_2_0">
    <VALUE Lang="th">I don't just make a partner for anyone! Besides, I am very busy because of the Zombie couple who have fled to school!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_cupid.ntk_3_0">
    <VALUE Lang="th">Ah ha! You mean the Zombie couple, right? HaHaHa! I have expected and prepared something! Go and collect Valentine Chocolates! You will be able to get them easily in the Ran. Um.. 50 would be enough!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_girl.ntk_1_0">
    <VALUE Lang="th">Great.. You have brought me the Cupid Chocolate! Here, please exchange it with the box which I made for my boyfriend!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_girl.ntk_1_0_1">
    <VALUE Lang="th">Exchange</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_girl.ntk_1_1">
    <VALUE Lang="th">I have fled to school with my boyfriend to avoid the powerful force of Medusa but on the way we have lost each other. I need to give this present to my boyfriend since it is the Valentine's Day, would you please help me?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_girl.ntk_1_1_1">
    <VALUE Lang="th">Okay… How can I help?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_girl.ntk_1_1_2">
    <VALUE Lang="th">Sorry… I am a bit busy at the moment.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_girl.ntk_2_0">
    <VALUE Lang="th">There is a Cupid at MP campus and I heard that the Cupid Chocolate has very powerful effect.</VALUE>
    <VALUE Lang="th">I would like to give it to my boyfriend as a Valentine's day present… would you please get it for me?</VALUE>
    <VALUE Lang="th">Collect 50 Valentine Chocolates which you will be able to get easily in the world of Ran and bring them to Cupid to exchange it for 1 Cupid Chocolate!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_girl.ntk_2_0_1">
    <VALUE Lang="th">Okay.. Let’s do that.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_girl.ntk_3_0">
    <VALUE Lang="th">You are heartless!.. Gee.. What should I get him…?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_valentine_girl.ntk_4_0">
    <VALUE Lang="th">Thank you! I am counting on you!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_august_event.ntk_1_0">
    <VALUE Lang="th">My plan is to make a Snowman that cannot melt during Summer Season!! Everybody call me Crazy but in order to show it to them, I need "Eternal Snow Crystal". Can you please find it for me? Do not worry, I'll trade it with another item just for you ^__^</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">50 Eternal Snow Crystal = Adoniechus Bracelet C (5H)</VALUE>
    <VALUE Lang="th">100 Eternal Snow Crystal = Snowman (3H)</VALUE>
    <VALUE Lang="th">200 Eternal Snow Crystal = EXP Rudolf Costume Set (3H) Box</VALUE>
    <VALUE Lang="th">250 Eternal Snow Crystal = Snowman Hat Random Box</VALUE>
    <VALUE Lang="th">300 Eternal Snow Crystal = Oblivion Potion E (7D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_august_event.ntk_1_0_1">
    <VALUE Lang="th">Change 50 Eternal Snow Crystal to Adoniechus Bracelet C (5H)</VALUE>
