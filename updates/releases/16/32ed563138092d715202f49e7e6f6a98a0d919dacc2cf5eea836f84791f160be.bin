  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_62">
    <VALUE Lang="th">Deliver Proposal. [Please deliver proposal]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_63">
    <VALUE Lang="th">Tell that you need Oblivion Potion.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_64">
    <VALUE Lang="th">Tell that you will get the Murakano Blood Sample.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_65">
    <VALUE Lang="th">Tell that you will deliver the Expedition Participation Letter.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_66">
    <VALUE Lang="th">Receive the Request.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_67">
    <VALUE Lang="th">Receive the Request collecting Amanuoruoyin's cure medicine.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_68">
    <VALUE Lang="th">Receive the First Mission.</VALUE>
  </SENTENSE>
