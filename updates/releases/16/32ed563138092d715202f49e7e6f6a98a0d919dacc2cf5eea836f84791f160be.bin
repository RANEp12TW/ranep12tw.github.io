  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_29_0_5"><VALUE Lang="tw">兌換 專注瞄準（191級／超能部）</VALUE><VALUE Lang="GS">Skill book: Focus Aim (Lv191, Class=3072, Item=389/137)</VALUE><VALUE Lang="id">Skill book: Focus Aim (Lv191, Class=3072, Item=389/137)</VALUE><VALUE Lang="cn">Skill book: Focus Aim (Lv191, Class=3072, Item=389/137)</VALUE><VALUE Lang="th">Skill book: Focus Aim (Lv191, Class=3072, Item=389/137)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_29_0_6">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_29_0_7"><VALUE Lang="tw">兌換 強力射擊（47級／超能部）</VALUE><VALUE Lang="GS">Skill book: Power Shooting (Lv47, Class=3072, Item=389/122)</VALUE><VALUE Lang="id">Skill book: Power Shooting (Lv47, Class=3072, Item=389/122)</VALUE><VALUE Lang="cn">Skill book: Power Shooting (Lv47, Class=3072, Item=389/122)</VALUE><VALUE Lang="th">Skill book: Power Shooting (Lv47, Class=3072, Item=389/122)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_3_0">
    <VALUE Lang="th">It overpowers a human brain when the power of solidified stone and the scientific thinking are combined together. If we are too dependable on the weapons then we would better be called a Hunter's Group.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_3_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_30_0">
    <VALUE Lang="th">Great, you've got a spiritual sphere, exchange it for a skill scroll of your choice.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_30_0_1"><VALUE Lang="tw">兌換 腐蝕射擊（157級／超能部）</VALUE><VALUE Lang="GS">Skill book: Corroded (Lv157, Class=3072, Item=389/83)</VALUE><VALUE Lang="id">Skill book: Corroded (Lv157, Class=3072, Item=389/83)</VALUE><VALUE Lang="cn">Skill book: Corroded (Lv157, Class=3072, Item=389/83)</VALUE><VALUE Lang="th">Skill book: Corroded (Lv157, Class=3072, Item=389/83)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_30_0_2"><VALUE Lang="tw">兌換 洗腦（127級／超能部）</VALUE><VALUE Lang="GS">Skill book: Brain Washing (Lv127, Class=3072, Item=389/103)</VALUE><VALUE Lang="id">Skill book: Brain Washing (Lv127, Class=3072, Item=389/103)</VALUE><VALUE Lang="cn">Skill book: Brain Washing (Lv127, Class=3072, Item=389/103)</VALUE><VALUE Lang="th">Skill book: Brain Washing (Lv127, Class=3072, Item=389/103)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_30_0_3"><VALUE Lang="tw">兌換 聖光砲（127級／超能部）</VALUE><VALUE Lang="GS">Skill book: Saint Cannon (Lv127, Class=3072, Item=389/123)</VALUE><VALUE Lang="id">Skill book: Saint Cannon (Lv127, Class=3072, Item=389/123)</VALUE><VALUE Lang="cn">Skill book: Saint Cannon (Lv127, Class=3072, Item=389/123)</VALUE><VALUE Lang="th">Skill book: Saint Cannon (Lv127, Class=3072, Item=389/123)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_30_0_4">
    <VALUE Lang="th">Exchange it for 'Titan's Vigor'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_30_0_5">
    <VALUE Lang="th">Exchange it for 'Air Strike V'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_30_0_6">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_31_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_32_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_33_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_34_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_35_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_36_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_37_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_38_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_39_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_4_0">
    <VALUE Lang="th">I'll explain it for you, listen carefully!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_4_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_40_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_41_0">
    <VALUE Lang="th">Three (3) points will be rewarded when each time you level up. Depending on how you distribute these points will influence your characteristics.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_41_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_42_0">
    <VALUE Lang="th">Increase DEX to become the master of Chemistry. You will be able to hit targets with Lasting, durational damages and debuff them.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_42_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_43_0">
    <VALUE Lang="th">Invest in POW to study microbe and gene manipulation to increase your immunity. You will also be able to take control over the actions of targets.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_43_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_44_0">
    <VALUE Lang="th">Increasing INT will awake your ability in Physics. You will be able to summon creatures from Another World through a gate to fight against monsters.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_44_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_45_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_46_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_47_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_48_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_49_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_5_0">
    <VALUE Lang="th">Physical powers are rather weak than any other classes so, it is required to keep certain distance from the target. Taking temporary control over a target or attack by dealing lasting damages are the role of true Scientist. You can play many different type of roles so you must always keep calm and understand the circumstances.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_5_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_50_0">
    <VALUE Lang="th">Why aren't you registered yet..</VALUE>
    <VALUE Lang="th">Because you are not ready, such things are happening to you..</VALUE>
    <VALUE Lang="th">You should be able to find something proper at the DB room terminal in front of Main Center.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_50_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_51_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_52_0">
    <VALUE Lang="th">Our group has just been reborn and I am too busy to take care of everyone. However, I don't expect anyone to behave disorderly?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_52_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_53_0">
    <VALUE Lang="th">All creatures were just normal human beings once, inside and out of the school. However, if you feel pity and go easy on them will just put yourself in dangerous situations. Everything is depending on you all.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_53_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_54_0">
    <VALUE Lang="th">I wouldn't be here, if the accident in the basement didn't occur. But I have already decided to be with you all so, I will give my 100% to help you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_54_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_55_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_56_0">
    <VALUE Lang="th">There are soulless people wandering around outside of the school. Inside the school it is a bit safer but once you go out the main gate, you need to be careful. You don't know what will come after you.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_56_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_57_0">
    <VALUE Lang="th">Once you get the approval from Student Director, it means that you are ready to face the great dangers like that so be prepared.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_57_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_58_0">
    <VALUE Lang="th">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_59_0">
    <VALUE Lang="th">The facts about Saint List is just a tip of an iceberg.</VALUE>
    <VALUE Lang="th">You will understand when you get closer to the truth.</VALUE>
    <VALUE Lang="th">Your own matters are important but I hope you could get closer to the truth and think more.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_59_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_6_0">
    <VALUE Lang="th">Starting from '0', you will be able to receive '1' Skill Point each when you level up.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_6_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_60_0">
    <VALUE Lang="th">You will probably get more curious..</VALUE>
    <VALUE Lang="th">Go see Scientist Student Rep. at Trading Hole, she will be able to give you more details.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_60_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_61_0">
    <VALUE Lang="th">Great, you've got a spiritual sphere, exchange it for a skill scroll of your choice.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_61_0_1"><VALUE Lang="tw">兌換 化學反應（177級／超能部）</VALUE><VALUE Lang="GS">Skill book: Chemical Reaction (Lv177, Class=3072, Item=389/86)</VALUE><VALUE Lang="id">Skill book: Chemical Reaction (Lv177, Class=3072, Item=389/86)</VALUE><VALUE Lang="cn">Skill book: Chemical Reaction (Lv177, Class=3072, Item=389/86)</VALUE><VALUE Lang="th">Skill book: Chemical Reaction (Lv177, Class=3072, Item=389/86)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_61_0_2"><VALUE Lang="tw">兌換 纏繞（197級／超能部）</VALUE><VALUE Lang="GS">Skill book: Entangle (Lv197, Class=3072, Item=389/106)</VALUE><VALUE Lang="id">Skill book: Entangle (Lv197, Class=3072, Item=389/106)</VALUE><VALUE Lang="cn">Skill book: Entangle (Lv197, Class=3072, Item=389/106)</VALUE><VALUE Lang="th">Skill book: Entangle (Lv197, Class=3072, Item=389/106)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_61_0_3"><VALUE Lang="tw">兌換 水能融合（167級／超能部）</VALUE><VALUE Lang="GS">Skill book: Hydrofusion (Lv167, Class=3072, Item=389/126)</VALUE><VALUE Lang="id">Skill book: Hydrofusion (Lv167, Class=3072, Item=389/126)</VALUE><VALUE Lang="cn">Skill book: Hydrofusion (Lv167, Class=3072, Item=389/126)</VALUE><VALUE Lang="th">Skill book: Hydrofusion (Lv167, Class=3072, Item=389/126)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_61_0_4">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_62_0">
    <VALUE Lang="th">Great, you've got a spiritual sphere, exchange it for a skill scroll of your choice.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_62_0_1">
    <VALUE Lang="th">Exchange it for 'Scroll of Air Strike VI'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_62_0_4">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_63_0">
    <VALUE Lang="th">Great, you've got a spiritual sphere, exchange it for a skill scroll of your choice.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_63_0_1">
    <VALUE Lang="th">Exchange it for 'Titan's Mettle'</VALUE>
  </SENTENSE>
