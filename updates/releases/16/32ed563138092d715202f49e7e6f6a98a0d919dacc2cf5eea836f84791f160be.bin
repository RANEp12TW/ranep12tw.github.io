  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_21">
    <VALUE Lang="th">School Voluntary Work IV</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_22">
    <VALUE Lang="th">Get confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_1_0_23">
    <VALUE Lang="th">Ask if he needs help with anything</VALUE>
  </SENTENSE>
