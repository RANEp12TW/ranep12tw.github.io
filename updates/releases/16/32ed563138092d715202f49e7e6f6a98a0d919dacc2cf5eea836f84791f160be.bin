  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_116_0">
    <VALUE Lang="th">So is this what I think it is?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I need to check what it says first.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_116_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_117_0">
    <VALUE Lang="th">Up till now, you were only able to collect this much?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Well, I guess it isn't that easy to get them from underground.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please collect more when you have time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_117_0_1">
