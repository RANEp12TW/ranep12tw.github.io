    <VALUE Lang="th">Confirm</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_1_6">
    <VALUE Lang="th">Confirm</VALUE>
  </SENTENSE>
