  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_8_0_5">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_9_0">
    <VALUE Lang="th">There's no turning back now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please be aware of this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_9_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0">
    <VALUE Lang="th">Oh!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's great to see a normal human after all this time!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_2">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_3">
    <VALUE Lang="th">Request for Bus Spare Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_4">
    <VALUE Lang="th">Request for Generator Spare Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_5">
    <VALUE Lang="th">Collect Unverified Currency Notes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_6">
    <VALUE Lang="th">Technical Teacher's Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_7">
    <VALUE Lang="th">Confirm Test Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_8">
    <VALUE Lang="th">Give the Order Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_9">
    <VALUE Lang="th">Ask about Experimental Mutation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_10_0">
    <VALUE Lang="th">That money is really strange, and it's good we discovered it before the problem got any worse. Just carry on with delivering the Order Document.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That'll help out a lot!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_11_0">
    <VALUE Lang="th">Oh, so you already reached level to qualify for this exam?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You learn faster than I thought!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Let me remind you of this test's purpose again before I give you the exam questions. Your regular targets in this test won't be human begins. That's the reason why you need to regular take these kinds of exams. You'll be able to learn the stuff you really need to know.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You need to diligently continue your studies since you'll eventually fight enemies higher than this level.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you understand me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_12_0">
    <VALUE Lang="th">Good, you pass the exam by achieving your level. It's a little less than what I expected, but...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll need to practice more so that you'll be ready for any kind of attack from these fellahs.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_13_0">
    <VALUE Lang="th">Although it's impossible to understand the entire situation now, I think there's something weird about the stuff that the Financial Group is involved in. I would tell you more, but I really can't give you more information because of my position.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_14_0">
    <VALUE Lang="th">그래서 당분간만 내가 대신 봐주고 있긴 한데, '서클복'을 특성에 맞게 좀 더 강화한 제품인 모양이야...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_14_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_15_0">
    <VALUE Lang="th">마음 같아선 그냥 나눠주고 싶은데 아쉽구나~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_15_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_16_0">
    <VALUE Lang="th">이번엔 확실히 가져다 줄 수 있었으면 좋겠는데...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">이런 일을 대비해서 여러 가지 물건들을 준비해 놓긴 했지만, 그 부품들도 이젠 거의 남아있지 않거든</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_16_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_17_0">
    <VALUE Lang="th">어쩌면 4동 공사장의 공사감독이 가지고 있었을 지도 모르는데...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_17_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_18_0">
    <VALUE Lang="th">그 친구들 지금 정상이 아니라서 말로 해서는 줄 것 같지 않을테니까 고생 좀 해야 할거다</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_18_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_19_0">
    <VALUE Lang="th">...........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_2_0">
    <VALUE Lang="th">Hmmm....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How can I help you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_2_0_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_20_0">
    <VALUE Lang="th">여기 있구나</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">어디라고 정확히 찍을 수는 없지만 이 지폐 어딘가 이상해-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_20_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_21_0">
    <VALUE Lang="th">혹시나 해서 현금지급기에서 확인도 해 봤더니 정품으로 인식하더라구</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_21_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_22_0">
    <VALUE Lang="th">아까 물어보니까 청소부들이 이런 지폐를 다발로 모으고 있다는 소리까지 들리는 거 보니까 이대로 놔두면 문제가 커질 것 같아</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">가져가서 한번 확인 좀 해 봐라</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_22_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_23_0">
    <VALUE Lang="th">............</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_24_0">
    <VALUE Lang="th">문제를 내기 전에 다시 한번 이 시험의 목적에 대해 말해 주겠는데</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">너희들이 평상시에 받던 격투 수업의 목표는 절대로 일반인이 아니다</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_24_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_25_0">
    <VALUE Lang="th">그 때문에 정기적으로 이런 능력확인 시험을 거쳐서 더 배워야 할 부분을 알아가는 것이야</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">이미 예정보다 빠르게 상황이 진행되고 있는 듯 하지만, 아직까지는 아니야...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_25_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_26_0">
    <VALUE Lang="th">너희들이 싸워야 할 진짜 적들은 이정도 수준이 아니기 때문에 앞으로 계속 배워야 하는거야</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">알겠냐?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_26_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_27_0">
    <VALUE Lang="th">.......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_28_0">
    <VALUE Lang="th">I guess that now you're aware that anyone could be an enemy.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_28_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_29_0">
    <VALUE Lang="th">........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_3_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can imagine how it would have been if you had listened in class. It all happened 18 years ago, earlier than anyone expected.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_30_0">
    <VALUE Lang="th">그 개 뿐만이 아냐</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">지금 모든 걸 다 알 순 없겠지만, 재단에서 하는 일 중에 걸리는 게 좀 있거든</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_30_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_31_0">
    <VALUE Lang="th">하지만 아직은 아니야...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">미안하지만 나도 정리해서 알려줄 수 입장은 못 되니까...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_31_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_4_0">
    <VALUE Lang="th">We predicted long ago that this would happen, but it was much worse than we thought it would be.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please collect any important information related to this matter.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_5_0">
    <VALUE Lang="th">Right now, I'm managing distribution of these unique costumes since the person that was originally assigned to this job disappeared. Personally, I don't like the idea of doing this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_6_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What do you want to know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_6_0_1">
    <VALUE Lang="th">Ask about Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_6_0_2">
    <VALUE Lang="th">Ask What Needs to be Done</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_6_0_3">
    <VALUE Lang="th">Ask about Unique Costumes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_6_0_4">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_7_0">
    <VALUE Lang="th">Ah, are you looking for spare parts to fix the bus?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Several people came to collect those same spare parts. They keep coming back because the buses keep getting involved in accidents. I'm just glad we're able to help out by having spare parts available. Although we've prepared all the necessary equipment for these kinds of situations, we starting to run out of spare parts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_8_0">
    <VALUE Lang="th">All the spare parts have been distributed. The ones we have left aren't what you need.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can get the spare parts you need from the supervisors at the Construction Site located at the 4th Hole. First, you'll need to work hard to prove yourself to them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_9_0">
    <VALUE Lang="th">So you're here to buy some more spare parts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Where'd you get this weird money? Look, I've still got plenty of those things here, and I have no idea where they came from.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_0">
    <VALUE Lang="th">아, 그거 혹시 열쇠 조각 ...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">잠깐 줘 볼래?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">어쩌면 그 ‘깨달음의 열쇠’ 일지도 모르겠는데!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">정말 ‘깨달음의 열쇠’ 라면 ‘세인트 재단’ 에게서 뭔가를 받기 위한 증표가 될 거야</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_0_2">
    <VALUE Lang="th">열쇠 조각 들을 합친다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_1">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_2">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_3">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_4">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5">
    <VALUE Lang="th">Didn't you have a tough time reaching this place?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are still a few items left, so let me know if you need anything.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_10">
    <VALUE Lang="th">Accept Order [Defeat Freezing Halogen]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_11">
    <VALUE Lang="th">Report Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_12">
    <VALUE Lang="th">Accept Order [Eliminate Bombs]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_13">
    <VALUE Lang="th">Report Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_14">
    <VALUE Lang="th">Accept Order (Purify Park)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_15">
    <VALUE Lang="th">Report Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_16">
    <VALUE Lang="th">Ask about Experiment Object</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_17">
    <VALUE Lang="th">Apply for Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_18">
    <VALUE Lang="th">Check the Test Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_2">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_21">
    <VALUE Lang="th">Ask about Sacred Financial Group's Public Service</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_22">
    <VALUE Lang="th">Ask if she needs help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_3">
    <VALUE Lang="th">Investigate the Shouting</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_4">
    <VALUE Lang="th">Apply for the Examination</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_5">
    <VALUE Lang="th">Verify the Examination Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_6">
    <VALUE Lang="th">Accept Order (Currency Notes Verification)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_7">
    <VALUE Lang="th">Give the Order Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_8">
    <VALUE Lang="th">Ask about Leonair Campus's Location</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_1_5_9">
    <VALUE Lang="th">Confirmation of Pieces of Map</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_10_0">
    <VALUE Lang="th">It's good that you want to take the examination.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_11_0">
    <VALUE Lang="th">Great, you did really well!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Now that you've grown stronger and reached your current level, you'll easily be able to handle the dangers that lie ahead.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Don't rest on your laurels, though: you'll need to regularly take ability examinations to keep in good shape.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_11_0_1">
    <VALUE Lang="th">Accept Order (Currency Notes Verification)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_11_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_12_0">
    <VALUE Lang="th">The cleaner just left after dumping this on me not too long ago.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_12_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_13_0">
    <VALUE Lang="th">Looks like these Currency Notes contain something important. For now, it'd be wise to pick up items that people drop on the streets.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_13_0_1">
    <VALUE Lang="th">Ask about Leonair Campus's Location</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_14_0">
    <VALUE Lang="th">I'm pretty sure that it was located near the Trading Hole Passage, but one day it just suddenly vanished.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_14_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_15_0">
    <VALUE Lang="th">It's perfect!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The pieces of the map still exist. Even the teachers weren't aware of this!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_15_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_16_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I need someone to do something for me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll continue to do my part to help clear up this situation in order to ensure the safety of the students as well as the citizens.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Unfortunately, the mobs plaguing this area have multiplied dramatically.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The number of mobs causing trouble around here has increased astronomically.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_16_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_17_0">
    <VALUE Lang="th">Well done!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The Sacred Financial Group will always appreciate your help in transporting reinforcements and supplies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_18_0">
    <VALUE Lang="th">The situation has worsened, prompting the Sacred Financial Group to dispatch people to monitor the events.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_18_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_19_0">
    <VALUE Lang="th">We can't just relax and allow these guys to just multiply and continue menacing these areas.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_19_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_2_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Welcome to the Sacred Gate Ring!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How can I help you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_2_0_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_20_0">
    <VALUE Lang="th">The Student Director told this is one of the things is the world that just can't be changed.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_20_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_21_0">
    <VALUE Lang="th">........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_22_0">
    <VALUE Lang="th">In any case, everyone will have their abilities tested on a regular basis.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_22_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_23_0">
    <VALUE Lang="th">Our enemies are growing in power.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They're becoming better skilled, and their numbers are gradually increasing. They'll become quite formidable if left unchecked.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We can't relax and just assume that we're better than them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_23_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_24_0">
    <VALUE Lang="th">.........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_25_0">
    <VALUE Lang="th">This counterfeit was skillfully crafted. I'm sure that it'd easily pass for genuine money.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_25_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_26_0">
    <VALUE Lang="th">Moreover, this current looks like it has ancient writing that probably has some hidden meaning. Please take this money for note verification.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_26_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_27_0">
    <VALUE Lang="th">You need to take these to the Technical Teacher.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_27_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_28_0">
    <VALUE Lang="th">.......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_29_0">
    <VALUE Lang="th">Moreover, the place is now filled with weird mobs that appeared shortly after the abnormal phenomenon began.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_29_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_3_0">
    <VALUE Lang="th">You should know the answers to your questions.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This isn't your first time here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Your point of reference should be the Sacred Gate Park: to its right is the Phoenix Campus, to the left is Mystic Peak Campus, and to the south is Sacred Gate Campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Good, do you remember now?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_30_0">
    <VALUE Lang="th">The big problem right now is to confirm the location of Leonair Campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We have received contrasting information regarding its location. Some say it's south of Sacred Gate Park, while others say it's to the north.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's really confusing, and the only way to pinpoint its exact location is to go there ourselves.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_30_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_31_0">
    <VALUE Lang="th">Cheng Xi Zhi, a student at the Archery Section was able to verify the location of Leonair Campus, and even drew up a map.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Unfortunately, the map was stolen and torn to pieces. We still don't know who did it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_31_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_32_0">
    <VALUE Lang="th">The identities of the thieves aren't important.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Right now, we need to find the pieces of that map.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_32_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_33_0">
    <VALUE Lang="th">I heard that there were some clowns in the area when the map was torn up.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you think this clue will be enough to lead us to the pieces of the map?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_33_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_34_0">
    <VALUE Lang="th">........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_35_0">
    <VALUE Lang="th">We have fewer than 7 pieces of the map, and they're all in pretty bad condition.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_35_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_36_0">
    <VALUE Lang="th">Even if it seems impossible, I have to try and put these pieces together.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The writing is sloppy, the drawings look terrible, the paper is crumpled, and the edges of the pieces just don't fit together right.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_36_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_37_0">
    <VALUE Lang="th">The Student Director is experienced in working with archeological evidence. Maybe he might be able to put those torn pieces of paper back together.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_37_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_38_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_39_0">
    <VALUE Lang="th">We can't let a lack of manpower deter us from stopping this evil from spreading. The consequences will be catastrophic if we fail.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It'd be advisable to address the problem now before it gets out of control.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_39_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_4_0">
    <VALUE Lang="th">This use to be a great place to relax because it was always full of singing birds and playing children.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There were clowns selling balloons and making people laugh. Things have changed now, and that blissful atmosphere has been replaced by a murderous mist.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_40_0">
    <VALUE Lang="th">.......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_41_0">
    <VALUE Lang="th">Don't worry, the teacher is just talking to herself. Sorry to have bothered you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_41_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_42_0">
    <VALUE Lang="th">......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_43_0">
    <VALUE Lang="th">Does the Financial Group have any intentions to help at all?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_43_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_44_0">
    <VALUE Lang="th">I'm really sorry, but you need to continue your education so that you won't make the same mistakes when you face similar problems.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_44_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_45_0">
    <VALUE Lang="th">.......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_46_0">
    <VALUE Lang="th">I suppose you must feel disappointed since the teachers don't know much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_46_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_47_0">
    <VALUE Lang="th">I know that there are many different and contrasting views on this problem that aren't necessarily true.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How can I put this…?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's like when someone says that one plus one doesn't equal two.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Wouldn't that statement be incomprehensible?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_47_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_48_0">
    <VALUE Lang="th">Your mission is to slay the monster called Ice Master.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I won't give you a time limit like in past missions, so give it your best shot.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_48_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_49_0">
    <VALUE Lang="th">You beat the Ice Master? I guess you can handle the cold.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway, you pass the mission.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_49_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0">
    <VALUE Lang="th">득도의 경지에 이른 ‘마루치’ 와 ‘아라치’ 의 기운이 서로 만날 때 이르는 경지를 가리키는 말인데</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">본래는 소승불교에서 모든 번뇌를 뚫고 이치를 깨달아 열반의 경지에 이른 성자를 말이고 ‘나한’ 이라고도 하지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0_1">
    <VALUE Lang="th">'깨달음의 열쇠' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0_2">
    <VALUE Lang="th">'나한의 구슬' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_50_0">
    <VALUE Lang="th">Are you going to Root Hole?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's strange that time has stopped. I though the 공간축 might have changed...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I knew that the Saint building is located in Root Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hopefully, you'll be able to have a look inside Root Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_50_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_51_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_52_0">
    <VALUE Lang="th">The Sacred Financial Group's community service?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Of course, we all know about that because all the campuses are part of the Sacred Financial Group.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I just realized that we don't have any information about the company. Well, I suppose you think me irresponsible for not caring about the company's background, but... I'm sorry, I don't know any of the details.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_53_0">
    <VALUE Lang="th">The Dispatched Agent who is investigating the phenomenon at Leonine school is having a hard time because of the Saint Private Guards(= Sacred Gate Defender).</VALUE>
    <VALUE Lang="th">Please defeat them to help Dispatched Agent with his investigation.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_53_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_6_0">
    <VALUE Lang="th">그 열쇠를 지니고 있다면 재단에 보관중인 걸 받을 수도 있게 된다는 얘기는 들었지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">하지만 지금은 조각조각으로 나뉘어져 있을테니까 일단 7조각을 모으게 되면 나한테 가져오도록 해</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_7_0">
    <VALUE Lang="th">아, 그 녹색 구슬 말이지?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그냥 하나씩만으로는 별다를 게 없는데 30개를 다 합쳐서 목걸이를 만들면 꽤 쓸만해 진다지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0">
    <VALUE Lang="th">Okay, what do you want to know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0_1">
    <VALUE Lang="th">Ask for Directions</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0_2">
    <VALUE Lang="th">Ask about Sacred Gate Park</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0">
    <VALUE Lang="th">Ah, I've heard the Construction Supervisor mention that place. I really appreciate your willingness to help me out.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's pretty smart for you to accept all the help that you can get because of all the strange things that are happening in different areas.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Keep up the good work.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0_1">
    <VALUE Lang="th">Apply for the Examination</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
