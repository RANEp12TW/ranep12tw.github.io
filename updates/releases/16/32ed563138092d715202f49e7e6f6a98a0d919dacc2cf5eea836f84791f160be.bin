    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_28_0_3">
    <VALUE Lang="th">Exchange for Upgraded Short Bow [Electric]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_28_0_4">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_29_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_29_0_3">
    <VALUE Lang="th">Exchange for Upgraded Short Bow [Electric]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_29_0_4">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_3_0">
    <VALUE Lang="th">You need to use your skills more frequently if you want to master the art of instantly killing your enemies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_30_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_30_0_3">
    <VALUE Lang="th">Exchange for Upgraded Short Bow [Electric]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_30_0_4">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_31_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_31_0_3">
    <VALUE Lang="th">Learn Destruction V</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_31_0_4">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_32_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_32_0_3">
    <VALUE Lang="th">Exchange for Upgraded Short Bow [Electric]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_32_0_4">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_33_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_33_0_3">
    <VALUE Lang="th">Exchange for Upgraded Short Bow [Electric]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_33_0_4">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_34_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_34_0_3">
    <VALUE Lang="th">Exchange for Upgraded Short Bow [Electric]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_34_0_4">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_35_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_35_0_3">
    <VALUE Lang="th">Exchange for Upgraded Short Bow [Electric]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_35_0_4">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_36_0">
    <VALUE Lang="th">Students from the Archery Section don't need to rely only on strength. Consider upgrading your character's Agility to increase the Accuracy of your attacks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_36_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_37_0">
    <VALUE Lang="th">You are awarded 3 Stat Points each time your character levels up. Your character's build and growth is determined by how these Stat Points are allocated to your character's attributes.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you concentrate on Dexterity, you will develop great Attack Speed and become a Fast Attack Type.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_37_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_38_0">
    <VALUE Lang="th">Distributing Stat Points evenly to Strength and Dexterity, and investing some into Vitality, will develop your character into a Power Attack Type.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_38_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_39_0">
    <VALUE Lang="th">Lastly, distributing the points evenly to Strength, Dexterity, and Intelligence will result in a Skill Type character.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_39_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_4_0">
    <VALUE Lang="th">Hmm. You're right in making sure that you know the fundamentals.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_40_0">
    <VALUE Lang="th">Don't invest too many Stat Points in physical strengths since characters also benefit from concentration and other attributes.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_40_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_41_0">
    <VALUE Lang="th">Maintaining a safe distance from enemies is a great strategy for protecting yourself from your target's attacks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_41_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_42_0">
    <VALUE Lang="th">Try to keep your distance from your target, especially when you suddenly find yourself in a close encounter.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll probably fare better if you form a group with other players since you have relatively weak defenses.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_42_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_43_0">
    <VALUE Lang="th">Mastering the use of a bow is very difficult. There are many different archery styles, but you must start by learning the fundamental techniques.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_43_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_44_0">
    <VALUE Lang="th">The ability to attack a target from long range is the primary advantage of the Archery Section.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_44_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_45_0">
    <VALUE Lang="th">기본적으로 근접해 있지 않은 목표에 대해 궁수에게는 최소한의 위험을, 그리고 목표에게는 최대한의 피해를 주는 것이 우리 양궁부의 기술이야.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_45_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_46_0">
    <VALUE Lang="th">Most skills will require you to consume Skill Points in order to learn them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_46_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_47_0">
    <VALUE Lang="th">You should have more than enough Skill Points at the beginning since the starting skills won't require many Skill Points.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll find, however, that you might not have enough points to learn some of the later skills. Think and plan carefully, and choose the essential skills that you want to learn.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_47_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_48_0">
    <VALUE Lang="th">하지만 나중엔 모자라서 배울 수도 있는 스킬을 못배우고 썩히게 될 경우가 생길 수도 있으니까 잘 생각해 보고 꼭 필요한 스킬만 익히도록 해.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_48_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_49_0">
    <VALUE Lang="th">There aren't too many normal human beings around anymore. Most have already been transformed into evil monsters. Although it's a really bad situation, it's not like things can't be changed for the better.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please remember this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_49_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_5_0">
    <VALUE Lang="th">Hmm. I like your persistence.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_5_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_50_0">
    <VALUE Lang="th">The teachers are doing all that they can to return things back the way they should be.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_50_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_51_0">
    <VALUE Lang="th">Like I said before, these violent monsters are wrecking our campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please get out there, and keep them from causing even more destruction.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_51_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_52_0">
    <VALUE Lang="th">Know that carelessness may result in you ending up in a really bad situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Remember that you'll be entering a world full of dangers once you submit the Exit Approval Form. Please be careful out there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_52_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_53_0">
    <VALUE Lang="th">외출 신청서를 써 내면 그걸로 너는 그 위험 속으로 들어가게 된다는 걸 명심하고 마음 단단히 먹도록 해!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_53_0_1">
    <VALUE Lang="th">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_54_0">
    <VALUE Lang="th">Oh... So you saw the List of Saints.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's true that there's nothing wrong with the list.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah, but you're probably curious about what's behind it. Am I right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why are there so many students with family problems?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's quite simple, actually.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not too many loving parents would send their children to an experimental school.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even if extraordinary benefits were offered, most parents would think that traditions set by normal schools are more important.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_54_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_55_0">
    <VALUE Lang="th">Many people raise this question...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What is forgiveness, and does it work?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, but it's not like I have the right to teach you anything.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why should I force what little I know upon you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You know that there are arenas in the Trading Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can find teachers that can teach you more over there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_55_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_56_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_56_0_3">
    <VALUE Lang="th">Exchange for Wild Shot</VALUE>
  </SENTENSE>
