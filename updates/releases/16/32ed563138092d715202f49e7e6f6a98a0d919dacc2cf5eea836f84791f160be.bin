    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_32_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_32_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_4_0">
    <VALUE Lang="th">Ah! Do you really want to help me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The MinFuLeiSi Special Publishing House published a book that was snatched from me. The title of the book is "Online Games Programming Guide." A villain known as the Cripple Guy took it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please help me by retrieving that book from that vile mobster!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_5_0">
    <VALUE Lang="th">I can't believe that this rare book was snatched by that person. This is inexcusable!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Would you help me find it again, please?!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_5_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_5_0_2">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_5_0_3">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_5_0_4">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_5_0_5">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_5_0_6">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_5_0_7">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_5_0_8">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_6_0">
    <VALUE Lang="th">Thanks! It's great to know that you'll help me out. Another book entitled "Games Programmer C++" was stolen from me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It was snatched by a villain known as the Skating Master.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please help me!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_6_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_7_0">
    <VALUE Lang="th">That book I bought is very precious!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It is one of my favorite books because it covers the basics of Programming. I spent a lot of money on it. Sadly, somebody took it away from me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Could you help me get that book back?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_7_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_7_0_2">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_7_0_3">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_7_0_4">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_7_0_5">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_7_0_6">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_7_0_7">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_7_0_8">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_8_0">
    <VALUE Lang="th">Ah, do you really want to help me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The book that got snatched from me was published by the MinFuLeiSi Special Publishing House, and it's entitled "Special Influence Games Programming."</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It was snatched by a fiend named Hodel. Please help me!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_9_0">
    <VALUE Lang="th">Now I'm a little afraid of buying books.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's alright for me to just stand like this, but… Why do my books keep getting targeted?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This time I didn't buy this book, and it's more important to me since I received it from a friend.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me one more time?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_9_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_9_0_2">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_9_0_3">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_9_0_4">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_9_0_5">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_9_0_6">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_9_0_7">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_9_0_8">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0">
    <VALUE Lang="th">I'm not sure how the streets became like this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I consider myself lucky for being able to find a safe hiding place over here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Sheesh! I really don't know what'll happen to me if I'm not careful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_1">
    <VALUE Lang="th">Who are you talking about?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_10">
    <VALUE Lang="th">Give the Key</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_11">
    <VALUE Lang="th">Take the Golf Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_12">
    <VALUE Lang="th">Give the Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_13">
    <VALUE Lang="th">Ask if Everything is Alright</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_14">
    <VALUE Lang="th">Give the Golf Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_15">
    <VALUE Lang="th">Ask about Problem</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_16">
    <VALUE Lang="th">Find out the Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_17">
    <VALUE Lang="th">Ask about Garbage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_18">
    <VALUE Lang="th">Deliver the Oil</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_19">
    <VALUE Lang="th">Ask about Garbage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_20">
    <VALUE Lang="th">Ask about Garbage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_21">
    <VALUE Lang="th">Ask about Garbage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_4">
    <VALUE Lang="th">Mention Collecting Recycled Resources</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_5">
    <VALUE Lang="th">Ask about Lost Children</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_6">
    <VALUE Lang="th">Ask for Directions</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_7">
    <VALUE Lang="th">Volunteer to Collect Rubbish</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_8">
    <VALUE Lang="th">Give the Recyclable Rubbish</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_9">
    <VALUE Lang="th">Ask if Everything is Alright</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_10_0">
    <VALUE Lang="th">Do you think that this trash still needs to be gathered? It'd definitely be better for us Street Cleaners if all the garbage and trash was sorted and collected. Please help us out, okay?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_11_0">
    <VALUE Lang="th">It's great to know that you're here to help. There are these monsters that make our job difficult in cleaning the streets. Those long-furred dogs pulling milk-bottle carts really give me the creeps. Watch out, or they'll bite you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm not kidding...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's possible, you know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_11_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_11_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_12_0">
    <VALUE Lang="th">Do you really want me to give this to you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Here! Take it. It's really huge, so be very careful with it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_13_0">
    <VALUE Lang="th">Whoa! It looks like you've taken care of those monster dogs!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How the heck did you do it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much for your help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Finally! I can now start cleaning the street without worrying about those hounds biting me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_14_0">
    <VALUE Lang="th">Maybe you won't believe me, but I really think that we absolutely must dispose of all this trash. I mean, sure it's a form of pollution, but there's more to it than that.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There's something else about the trash, but I can't quite put my finger on it. Please help be acquire what I need by collecting some trash.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_14_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_14_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_15_0">
    <VALUE Lang="th">Somebody said that they saw it taken away by a group of strange people called the Wrestlers.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Although I'm not sure whether or not they're still holding the trash, I need your help to find out.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_15_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_16_0">
    <VALUE Lang="th">Wow! Thank God! You found it!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It would be better if I take this to the Research Institute for them to analyze. I suspect that we won't learn any good news from this, though...have a feeling it is not going to be good news?</VALUE>
    <VALUE Lang="th">Huh, what did you say?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Sorry! Don't mind me. I was just talking to myself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_16_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_17_0">
    <VALUE Lang="th">I only wanted to sweep the Golf Course. Suddenly, I found myself being chased by these ridiculous girls carrying gold clubs.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can't even finish my sweeping because these nutcases chased me all the way here. Don't you think the world will get so dirty if nobody sweeps it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_17_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_17_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_18_0">
    <VALUE Lang="th">Oh! Please...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I get goose bumps seeing those golf clubs aimed at me! It was terrible!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There were also those mobs carrying bombs! Watch out for them!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Those monsters were huge! Please be careful!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_18_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_19_0">
    <VALUE Lang="th">A gold club!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I've seen one of these before, but I'm not familiar with this one in particular.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_19_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_2_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_20_0">
    <VALUE Lang="th">The living area of the locals is very limited. These nasty hoodlums cause trouble and make this place a living hell for the people that have to live here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">These jerks have even caused some students to get stranded!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_20_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_20_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_21_0">
    <VALUE Lang="th">Although there are only a few of those hoodlums around, try your best to nab 20 of them!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I know you're powerful enough to take them out! Please try your best to eliminate them now!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_21_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_22_0">
    <VALUE Lang="th">We're really grateful that you're here to help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Students like you should be concerned of the situation after experiencing this chaos.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We all agree that this strange phenomenon must be resolved as soon as possible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_22_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_23_0">
    <VALUE Lang="th">.....4</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_24_0">
    <VALUE Lang="th">The lack of resources today reflects the chaotic future we will experience if students don't contribute to the resolution of this situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are other matters you have to consider. For the meantime, will you help me collect some Empty Bottles?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">No matter what happens, we will always need medical supplies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_24_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_25_0">
    <VALUE Lang="th">.....6</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_26_0">
    <VALUE Lang="th">Did something unfortunate happen to him?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Perhaps he went through an operation which made him a cyborg. What do you think?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_26_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_27_0">
    <VALUE Lang="th">.....7</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_28_0">
    <VALUE Lang="th">There are fewer and fewer normal students…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is a very depressing situation!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm not sure whether it involves a group of delinquent students or a group of lazy airheads with mental problems.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I just know that there's a group of lowlifes loitering around and tossing trash on the streets on purpose. It's really nasty!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_28_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_29_0">
    <VALUE Lang="th">What's worse is that they choose to throw around trash that can't be recycled!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_29_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_3_0">
    <VALUE Lang="th">You still have no idea about the chaos after seeing the outskirts? Things started getting crazy as I was cleaning the streets. The bloodthirsty monsters scared the hell out of me!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_30_0">
    <VALUE Lang="th">....8</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_31_0">
    <VALUE Lang="th">Do you think there's no need to see what's in the trash!?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please be quick, and just take it over there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_31_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_32_0">
    <VALUE Lang="th">.....9</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_33_0">
    <VALUE Lang="th">Ah, yup!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If this is the case, go over to the Financial Group Research Institute! Oh wait... No! It's at another place. I'm sorry... Try the Recycling Research Center, it should be over there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_33_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_34_0">
    <VALUE Lang="th">Hahahaha!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Don't fret! It's not something worth worrying about.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_34_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_35_0">
    <VALUE Lang="th">...10</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_36_0">
    <VALUE Lang="th">Hmm?</VALUE>
    <VALUE Lang="th">You need to check the contents of the trash first. Alright?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_36_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_37_0">
    <VALUE Lang="th">...11</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_38_0">
    <VALUE Lang="th">I want to clean the golf course, but an enormous dog took away the key I use to access my cleaning supplies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_38_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_39_0">
    <VALUE Lang="th">...14</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_4_0">
    <VALUE Lang="th">예전에는 그래도 매일 청소를 했으니까 재활용품 수집도 그럭저럭 됐는데</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">요즘 같아서는 청소가 문제가 아니라 도망다니기도 바쁘네 원...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_40_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">How do I say this? Somebody threw away something which he shouldn't have.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_40_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_41_0">
    <VALUE Lang="th">...15</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_42_0">
    <VALUE Lang="th">Can you go check the contents of the trash for me? Once you find what I want, please bring it back to me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_42_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_43_0">
    <VALUE Lang="th">....19</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_44_0">
    <VALUE Lang="th">Let me handle this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm really sorry to bother you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This was supposed to be the stuff I was going to give you after I finished cleaning.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_44_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_45_0">
    <VALUE Lang="th">Looks like it's not going to a big deal. This trash looks properly sorted and collected. I'm not sure if this is enough of a reward to pay you for helping me, but...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you please accept this as a token of my appreciation?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_45_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_46_0">
    <VALUE Lang="th">This was something I overheard while I was doing my sweeping rounds...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There was this bunch of never-seen-before nasty guys who identify themselves as part of the "Green" Organization. They started causing mayhem by harassing the locals.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_46_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_47_0">
    <VALUE Lang="th">A few days ago I witnessed a glimpse of the treacherous activities of that evil organization.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I heard they had all the students clumped up into one place and suffocated them to death! This is horrible! Why isn't anybody doing something about them?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_47_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_48_0">
    <VALUE Lang="th">....22</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_49_0">
    <VALUE Lang="th">There are very few policemen around here, and we need to mobilize more men to scout the entire area. You know what I just heard? The violent "Green" Organization is hiding in their headquarters near the dock warehouse. It is located opposite of the Trading Hole No. 1 Passage. Do you have any information on them?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_49_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_5_0">
    <VALUE Lang="th">수고했어 학생</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">물자는 아껴 써야 하니까 앞으로도 시간이 되면 또 부탁해요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그냥 모아오면 다른 걸로 바꿔줄테니까</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_50_0">
    <VALUE Lang="th">What should we do if the students get scattered?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">...Ah, yup! I picked this up too while doing my cleaning. I'm sorry to have troubled you... Do you want to have this, though?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_50_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_51_0">
    <VALUE Lang="th">Although I don't remember when it started. Lots of boxes are spotted nowadays.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll know what it contains when I shake it, based on my experience at this sort of thing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I am sure it will contain something like an "Add-on Kit."</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hm, it won't open very easily. You could try using some oil… And I don't really know what's inside the box. It's also pretty hard to find oil. I doubt I could open this box at all now…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Maybe... Do you want to try?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_51_0_1">
    <VALUE Lang="th">Accept</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_51_0_2">
    <VALUE Lang="th">Reject</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_52_0">
    <VALUE Lang="th">Oil from tuna is suitable, and you can easily find it near this area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There are many workers in tuna fishing boats on the wharf.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Just so you know, you cannot just use any tuna oil, and the quality of the tuna is not always the same.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you gather 10 bottles of high quality tuna oil?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_52_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_53_0">
    <VALUE Lang="th">Oh~ Okay, okay!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The box is here... Try to open it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Good Luck…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_53_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_6_0">
    <VALUE Lang="th">Let me think...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Are you referring to those strange crying children?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I hope they weren't captured or eaten by those evil monsters.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_7_0">
    <VALUE Lang="th">Can you please pick out the trash and pass them to me? You should be able to collect the recyclable items by sweeping the streets.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_7_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_7_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_8_0">
    <VALUE Lang="th">Those roller skating mobsters and those crazy girls holding screwdrivers are the main offenders when it comes to littering.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Our streets would be much cleaner if we got rid of those fools.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_8_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_9_0">
    <VALUE Lang="th">Just as I thought...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Collecting this trash is no problem for you. Go ahead and give it to me now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_9_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
