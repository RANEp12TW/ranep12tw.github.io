  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_35_0_3">
    <VALUE Lang="th">Take the Vital Bow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_36_0">
    <VALUE Lang="th">Select item type.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_36_0_1">
    <VALUE Lang="th">Take Staff</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_37_0">
    <VALUE Lang="th">Select item type.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_37_0_1">
    <VALUE Lang="th">Take the Gun</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_37_0_2">
    <VALUE Lang="th">Take the Railgun</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_37_0_3">
    <VALUE Lang="th">Take the Portal Gun</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_38_0">
    <VALUE Lang="th">Are you talking about ring? Can you help me get it? The design can get it from Hell Scissors</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_38_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_39_0">
    <VALUE Lang="th">You get it~ this is the item I wan to give you</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_39_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_4_0">
    <VALUE Lang="th">The Science class is under classroom.</VALUE>
    <VALUE Lang="th">So, most students couldn't see us.</VALUE>
    <VALUE Lang="th">Because of my class have to order from the Saint foundation, directly.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_4_0_1">
    <VALUE Lang="th">What did you study?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_40_0">
    <VALUE Lang="th">It need a lot of item, necklace must have the design plan to process, it can get it from Bomber Clown in Sacred Gate Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_40_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_41_0">
    <VALUE Lang="th">Please wait for while, I make it now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_41_0_1">
    <VALUE Lang="th">Wait for While</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_42_0">
    <VALUE Lang="th">It done, but this is the first time I make this item, can't confirm it work or not.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_42_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_43_0">
    <VALUE Lang="th">If you wan more powerful weapon, it need more special material, you can get it from Got Milk.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_43_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_44_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_45_0">
    <VALUE Lang="th">Please select weapon.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_45_0_1">
    <VALUE Lang="th">I want DEX type weapon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_45_0_10">
