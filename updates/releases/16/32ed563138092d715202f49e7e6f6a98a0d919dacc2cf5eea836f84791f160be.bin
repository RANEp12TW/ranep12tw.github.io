  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_57_0_5"><VALUE Lang="tw">兌換 堅韌之箭（197級／弓箭部）</VALUE><VALUE Lang="GS">Skill book: Tenacity Arrow (Lv197, Class=260, Item=173/56)</VALUE><VALUE Lang="id">Skill book: Tenacity Arrow (Lv197, Class=260, Item=173/56)</VALUE><VALUE Lang="cn">Skill book: Tenacity Arrow (Lv197, Class=260, Item=173/56)</VALUE><VALUE Lang="th">Skill book: Tenacity Arrow (Lv197, Class=260, Item=173/56)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_57_0_6">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_58_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_58_0_3">
    <VALUE Lang="th">Exchange for Scroll of Titan's Mettle</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_58_0_4"><VALUE Lang="tw">兌換 碎心箭（207級／弓箭部）</VALUE><VALUE Lang="GS">Skill book: Heartbreaker (Lv207, Class=260, Item=173/17)</VALUE><VALUE Lang="id">Skill book: Heartbreaker (Lv207, Class=260, Item=173/17)</VALUE><VALUE Lang="cn">Skill book: Heartbreaker (Lv207, Class=260, Item=173/17)</VALUE><VALUE Lang="th">Skill book: Heartbreaker (Lv207, Class=260, Item=173/17)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_58_0_5"><VALUE Lang="tw">兌換 幽魂之風（207級／弓箭部）</VALUE><VALUE Lang="GS">Skill book: Gust of Ghosts (Lv207, Class=260, Item=173/37)</VALUE><VALUE Lang="id">Skill book: Gust of Ghosts (Lv207, Class=260, Item=173/37)</VALUE><VALUE Lang="cn">Skill book: Gust of Ghosts (Lv207, Class=260, Item=173/37)</VALUE><VALUE Lang="th">Skill book: Gust of Ghosts (Lv207, Class=260, Item=173/37)</VALUE></SENTENSE>
