  <SENTENSE Ver="1" Id="2014_santagirl.ntk_1_0">
    <VALUE Lang="th">Santa asked me to give you a special present if you bring 25 Merry Red Socks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
