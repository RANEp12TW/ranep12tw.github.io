  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_29_0_1"><VALUE Lang="tw">兌換 閃焰射擊（147級／超能部）</VALUE><VALUE Lang="GS">Skill book: Flare (Lv147, Class=3072, Item=389/82)</VALUE><VALUE Lang="id">Skill book: Flare (Lv147, Class=3072, Item=389/82)</VALUE><VALUE Lang="cn">Skill book: Flare (Lv147, Class=3072, Item=389/82)</VALUE><VALUE Lang="th">Skill book: Flare (Lv147, Class=3072, Item=389/82)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_29_0_2"><VALUE Lang="tw">兌換 電場（127級／超能部）</VALUE><VALUE Lang="GS">Skill book: Electric Field (Lv127, Class=3072, Item=389/102)</VALUE><VALUE Lang="id">Skill book: Electric Field (Lv127, Class=3072, Item=389/102)</VALUE><VALUE Lang="cn">Skill book: Electric Field (Lv127, Class=3072, Item=389/102)</VALUE><VALUE Lang="th">Skill book: Electric Field (Lv127, Class=3072, Item=389/102)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_sc.ntk_29_0_3">
