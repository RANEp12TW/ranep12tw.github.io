    <VALUE Lang="th">Accept Confirmation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_2">
    <VALUE Lang="th">You're back. Let's see how many you collected.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_2_1">
    <VALUE Lang="th">Deliver Proposal</VALUE>
  </SENTENSE>
