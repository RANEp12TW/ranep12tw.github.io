  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_29_0_1"><VALUE Lang="tw">兌換 赦免（137級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Exoneration (Lv137, Class=12288, Item=362/14)</VALUE><VALUE Lang="id">Skill book: Exoneration (Lv137, Class=12288, Item=362/14)</VALUE><VALUE Lang="cn">Skill book: Exoneration (Lv137, Class=12288, Item=362/14)</VALUE><VALUE Lang="th">Skill book: Exoneration (Lv137, Class=12288, Item=362/14)</VALUE></SENTENSE>
