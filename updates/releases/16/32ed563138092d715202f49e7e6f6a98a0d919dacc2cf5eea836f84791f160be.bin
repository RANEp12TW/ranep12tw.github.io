  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_69">
    <VALUE Lang="th">Ask what has happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_7">
    <VALUE Lang="th">Rescue the Civilian</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_8">
    <VALUE Lang="th">Ask about What Happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_9">
    <VALUE Lang="th">Ask about What Happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_10_0">
    <VALUE Lang="th">Thank you very much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The book that got snatched from me was published by the MinFuLeiSi Special Publishing House, and it's entitled "Programming RPGs for DirectX."</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It was snatched by a fiend called Clown ICE. Please help me!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0">
    <VALUE Lang="th">I really need to have those books in order to overcome this difficult stage in my life. I know other people are asking you for help, but please… I think I need your help more!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Is that okay with you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_12_0">
    <VALUE Lang="th">So you really want to help me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The book that got snatched from me was published by the MinFuLeiSi Special Publishing House, and it's entitled "Tricks for Windows Game Programming."</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It was stolen by a fiend named Golf.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please help me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_13_0">
    <VALUE Lang="th">You found it!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I never expected you to help me get back all my books!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thanks a lot. You really are a helpful person!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_14_0">
    <VALUE Lang="th">Wow! Thanks a lot!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I feel so ashamed. I'd like to express my deep gratitude to you for helping me out this entire time.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">These books will really help me a lot!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_14_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_15_0">
    <VALUE Lang="th">......2</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_16_0">
    <VALUE Lang="th">What are you asking about?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You need information about programs? Like game programs, right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll do my best to provide you with all the information you may need!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_16_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_17_0">
    <VALUE Lang="th">Most of the civilians here have nothing else to do but watch the chaos get worse.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's good to see students like you doing your part to fight this pandemonium!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_17_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_18_0">
    <VALUE Lang="th">I get the feeling that business will be slow today.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm still keeping my hopes up, though!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_18_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_19_0">
    <VALUE Lang="th">......3</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_2_0">
    <VALUE Lang="th">It's so frustrating to be just an employee!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Someday, I want to have my own business. I've got to have the right attitude and outlook. I can do it!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_2_0_6">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_20_0">
    <VALUE Lang="th">There are various textbooks on gaming, but only a few of them are actually useful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The most useful gaming books are hard to find, which is why I felt so terrible when I lost them!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_20_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_21_0">
    <VALUE Lang="th">Books are limited in supply, so you might not be able to get a book later once its first printing sells out.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm so sad that my precious books were stolen from me!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_21_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_22_0">
    <VALUE Lang="th">.....5</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_23_0">
    <VALUE Lang="th">There aren't any more textbook supplies in this city. That's why I painstakingly make my own copies of these textbooks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Soon, I want to establish my own special course on computer programming.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_23_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_24_0">
    <VALUE Lang="th">......13</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_25_0">
    <VALUE Lang="th">I picked this thing up while I was walking around the area. I wonder if you can put this to good use.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Here! Please accept it!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_25_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_26_0">
    <VALUE Lang="th">....14</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_27_0">
    <VALUE Lang="th">I picked this thing up while I was walking around the area. I wonder if you can put this to good use.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Here! Please accept it!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_27_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_28_0">
    <VALUE Lang="th">Ah, I really appreciate it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's actually a valuable collectible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I was so upset because I had such a hard time finding it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you ever tried to collect something, you might understand how I feel...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway, thank you very much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_28_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_29_0">
    <VALUE Lang="th">Ah. The action guide of emergency?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Yes, I have.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Haha, I can't believe my collection is actually helpful!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_29_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_3_0">
    <VALUE Lang="th">Furthering my knowledge in order to have a great career head start is an important goal for me right now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Would you be willing to help me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_3_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
