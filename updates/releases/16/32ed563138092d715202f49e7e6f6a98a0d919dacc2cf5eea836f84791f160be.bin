    <VALUE Lang="th">Exchange for Dynamic Dragon Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_32_0_5">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_33_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_33_0_1"><VALUE Lang="tw">兌換 翔鶴擊（117級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="id">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="cn">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE><VALUE Lang="th">Skill book: Soaring Crane (Lv117, Class=520, Item=176/10)</VALUE></SENTENSE>
