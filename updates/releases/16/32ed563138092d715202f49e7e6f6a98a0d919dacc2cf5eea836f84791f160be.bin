  <SENTENSE Ver="1" Id="npc_1_t_trick.ntk_9_0_1"><VALUE Lang="tw">兌換 擲牌（17級／魔術部）</VALUE><VALUE Lang="GS">Skill book: Card Throw (Lv17, Class=49152, Item=380/2)</VALUE><VALUE Lang="id">Skill book: Card Throw (Lv17, Class=49152, Item=380/2)</VALUE><VALUE Lang="cn">Skill book: Card Throw (Lv17, Class=49152, Item=380/2)</VALUE><VALUE Lang="th">Skill book: Card Throw (Lv17, Class=49152, Item=380/2)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_trick.ntk_9_0_2"><VALUE Lang="tw">兌換 鞭斬（17級／魔術部）</VALUE><VALUE Lang="GS">Skill book: Whip Slash (Lv17, Class=49152, Item=380/23)</VALUE><VALUE Lang="id">Skill book: Whip Slash (Lv17, Class=49152, Item=380/23)</VALUE><VALUE Lang="cn">Skill book: Whip Slash (Lv17, Class=49152, Item=380/23)</VALUE><VALUE Lang="th">Skill book: Whip Slash (Lv17, Class=49152, Item=380/23)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_trick.ntk_9_0_3"><VALUE Lang="tw">兌換 群蝗（17級／魔術部）</VALUE><VALUE Lang="GS">Skill book: Swarming Locusts (Lv17, Class=49152, Item=380/47)</VALUE><VALUE Lang="id">Skill book: Swarming Locusts (Lv17, Class=49152, Item=380/47)</VALUE><VALUE Lang="cn">Skill book: Swarming Locusts (Lv17, Class=49152, Item=380/47)</VALUE><VALUE Lang="th">Skill book: Swarming Locusts (Lv17, Class=49152, Item=380/47)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_trick.ntk_9_0_4"><VALUE Lang="tw">兌換 泰坦意志（17級／魔術部）</VALUE><VALUE Lang="GS">Skill book: Titan's Will (Lv17, Class=49152, Item=380/69)</VALUE><VALUE Lang="id">Skill book: Titan's Will (Lv17, Class=49152, Item=380/69)</VALUE><VALUE Lang="cn">Skill book: Titan's Will (Lv17, Class=49152, Item=380/69)</VALUE><VALUE Lang="th">Skill book: Titan's Will (Lv17, Class=49152, Item=380/69)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_trick.ntk_9_0_5">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0">
    <VALUE Lang="th">This Terminal controls the access to the Right Dragon Park.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_1">
    <VALUE Lang="th">Confirm Activation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_2">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_3">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_4">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_5">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_6">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_7">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_8">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_9">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_2_0">
    <VALUE Lang="th">The Terminal is operating properly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_3_0">
    <VALUE Lang="th">The Terminal's Force Field function is operating normally.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You'll need 4 Spiritual Spheres to activate the Terminal's Shielding Effect.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_4_0">
    <VALUE Lang="th">The current area's authentication is now done. Please wait until the other area's authentication is complete.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can transfer to the next Terminal to complete the Force Field activation and optimization.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_5_0">
    <VALUE Lang="th">There are evil spirits roaming the Right Dragon Park.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The mobs of monsters possessed by these spirits are causing strange effects to their surroundings.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please try your best to eliminate them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_9_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0">
    <VALUE Lang="th">What seems to be bothering you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_1">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_2">
    <VALUE Lang="th">Bus Driver's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_3">
    <VALUE Lang="th">Construction Supervisor's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_4">
    <VALUE Lang="th">Give the Spare Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_5">
    <VALUE Lang="th">Physics Teacher's Call</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_7">
    <VALUE Lang="th">Check the Report</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_8">
    <VALUE Lang="th">Deliver the Golf Clubs</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_10_0">
    <VALUE Lang="th">Excuse me, can you help me acquire the necessary spare parts for the generator from the Technical Teacher?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_11_0">
    <VALUE Lang="th">I cannot leave this area because these crazy workers might abandon their work stations if I leave.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_12_0">
    <VALUE Lang="th">........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_13_0">
    <VALUE Lang="th">Thank you very much for bringing these spare parts. This can help speed up the construction project for a while until something breaks down again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_14_0">
    <VALUE Lang="th">What's wrong? Why is everyone like this? Everything looks weird around here. Am I in another dimension?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_14_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_15_0">
    <VALUE Lang="th">Student!!??</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, I think so. Now, your teacher is very busy…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Okay...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_15_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_16_0">
    <VALUE Lang="th">Oh, no. I know I keep calling on the students, but there's no other way to solve this problem. We're running out of resources.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Would you collect some golf clubs from the Training Ground?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_17_0">
    <VALUE Lang="th">Oh, that's good enough!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm sorry, I wouldn't be asking favors if our workers actually pulled their own weight.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway, I appreciate your help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Although we like it, the Sacred Financial Group helps people too much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_2_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_3_0">
    <VALUE Lang="th">The deadline for this construction is drawing near, and the project supervisor is missing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_4_0">
    <VALUE Lang="th">It's troubling to know most of the people at the construction site are acting funny and most of the machinery broke down. There's going to be a delay in the construction work, and the site is just full of turmoil.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_4_0_1">
    <VALUE Lang="th">Ask about Crazy People</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_5_0">
    <VALUE Lang="th">Oh, please get rid of those stubborn students! We can't get anything done with them around!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We've got enough trouble as it is!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_5_0_1">
    <VALUE Lang="th">Construction Supervisor's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_6_0">
    <VALUE Lang="th">Student! Please listen to my request...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">In order to complete construction by the deadline, we must replace these crazy workers with efficiently working machinery. The problem is that the generator is broken.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This just makes things more complicated!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_7_0">
    <VALUE Lang="th">My friend from the Sword Section told me that this is not the only area where strange things started to happen. Can you imagine what'll happen to our world if this keeps up?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_7_0_1">
    <VALUE Lang="th">Physics Teacher's Call</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_8_0">
    <VALUE Lang="th">I'm scared about the news that will come from the Physics Teacher at Sacred Gate College.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We need to meet him at the Sacred Gate Ring.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_9_0">
    <VALUE Lang="th">......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0">
    <VALUE Lang="th">Hmmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_1">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_2">
    <VALUE Lang="th">Bus Driver's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_3">
    <VALUE Lang="th">Give the Spare Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_4">
    <VALUE Lang="th">Bus Driver's 2nd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_5">
    <VALUE Lang="th">Ask if he needs help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_6">
    <VALUE Lang="th">Tell him what happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_10_0">
    <VALUE Lang="th">The problem with the bus started a few days ago, and it's been getting worse since then. The bus won't even move at all now. It seems that the other buses in the area are having similar problems.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_11_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_12_0">
    <VALUE Lang="th">Excuse me. Would you be so kind to help me acquire some spare parts from the Technical Teacher located near the college Crossroads so that I can get this bus moving again?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_13_0">
    <VALUE Lang="th">그럼 이 버스도 움직일 수 있게 될 거고, 학생들도 조금은 편해지겠지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_14_0">
    <VALUE Lang="th">"Have you ever been to MP Hole? If so then you must have met those inferior Green Mask (Uncle Potato). Because of their threats I am afraid to drive the bus.</VALUE>
    <VALUE Lang="th">If you can please defeat them and scare them away."</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_14_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_15_0">
    <VALUE Lang="th">Thanks! Now I will be able to drive this bus around.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_15_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_2_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_3_0">
    <VALUE Lang="th">You want to know more about the Bus? Hahaha!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Obviously, the Bus is used by students in order to move from one area to another. It is a more convenient means of transportation compared to walking or running around by foot.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_4_0">
    <VALUE Lang="th">Oops! I'm sorry! I didn't know you were there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I've been very busy trying to find out what the hell is wrong with this wreck!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_4_0_1">
    <VALUE Lang="th">Ask What He is Doing</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_5_0">
    <VALUE Lang="th">Oh! This bus is unoperational. I can't even get this thing to work. I really need to fix this bus so that the students can travel safely. It's dangerous to just walk around with all the chaos in the outskirts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's too bad there aren't any spare parts available to fix this thing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_5_0_1">
    <VALUE Lang="th">Ask the Driver more about Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_6_0">
    <VALUE Lang="th">Based on my assessment of this wreckage, I can say that repairing this bus shouldn't be a major problem. The spare parts required to repair this vehicle, however, need to be acquired as soon as possible. I can't repair this bus unless I can get all the necessary spare parts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_7_0">
    <VALUE Lang="th">Thank you for bringing the spare parts I need. I can finally start repairing this wreck. The students can use the bus to conveniently move from one area to another once I'm done fixing it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_7_0_1">
    <VALUE Lang="th">Bus Driver's 2nd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_8_0">
    <VALUE Lang="th">Please visit the Construction Supervisor located near the crossroads of the Mystic Peak Campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I heard he has a favor to ask from me, but I can't visit him myself because of this bus problem.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_9_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0">
    <VALUE Lang="th">This is the Bus Stop.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Once have your Bus Ticket ready, you can use the Bus Service to move to another area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0_1">
    <VALUE Lang="th">Ride the Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0_2">
    <VALUE Lang="th">Ride the Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0_3">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_1">
    <VALUE Lang="th">This is the Bus Stop.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Once have your Bus Ticket ready, you can use the Bus Service to move to another area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_1_1">
    <VALUE Lang="th">Ride the Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_1_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_2_0">
    <VALUE Lang="th">You can't take bus, now.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0">
    <VALUE Lang="th">I'm not sure how the streets got to be this dangerous. I'm so lucky to have found a safe place to hide!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Sheesh! I really don't know what'll happen to me if I'm not careful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_1">
    <VALUE Lang="th">What are you talking about?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_2">
    <VALUE Lang="th">Listen to Cleaner's Advice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_3">
    <VALUE Lang="th">Delivering the Recycled Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_4">
    <VALUE Lang="th">Deliver Recycled Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_2_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_3_0">
    <VALUE Lang="th">You still have no idea after seeing it? Things suddenly got weird while I was cleaning the streets. You should be careful strolling around this area. It is really dangerous!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_4_0">
    <VALUE Lang="th">Ever since these events happened, we never had the chance to run away. No one is left to do the cleaning up till now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_5_0">
    <VALUE Lang="th">We really have to treasure all kinds of resources. I'll ask for your help later in case you have any spare time to assist me.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll exchange the stuff that you collect for me with any of my other items.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_6_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_7_0">
    <VALUE Lang="th">We'll have problems in the future if we continue to be careless with our resources. Let's help each other gather what we'll need to survive this chaos.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_7_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_8_0">
    <VALUE Lang="th">It'd be a good start if you help me collect Empty Bottles. Please remember to use your medicinal supplies carefully. We need to conserve our resources during these times.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_extraacti.ntk_1_0">
    <VALUE Lang="th">Items which you can earn through Normal Extra Activities are exceptional.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_extraacti.ntk_1_0_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0">
    <VALUE Lang="th">The Terminal located in the Basic Science Classroom is not functioning properly. Please attend to this problem immediately.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_1">
    <VALUE Lang="th">Activate Authentication</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_2">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_3">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_4">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_5">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_6">
    <VALUE Lang="th">Retrieve Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_2_0">
    <VALUE Lang="th">Due to the errors found in the School's</VALUE>
    <VALUE Lang="th">Information Center System,</VALUE>
    <VALUE Lang="th">the Information Room has all the available</VALUE>
    <VALUE Lang="th">information contained within these 2 files.</VALUE>
    <VALUE Lang="th">We will restore all necessary information</VALUE>
    <VALUE Lang="th">as soon as we resolve the situation.</VALUE>
    <VALUE Lang="th">For the meantime, you can stay and browse</VALUE>
    <VALUE Lang="th">through these two documents.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_2_0_1">
    <VALUE Lang="th">Ask about the Sword Section Student named Chi Ri Qing</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_2_0_2">
    <VALUE Lang="th">Ask about the Archery Section Student named Cheng Xi Zhi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_3_0">
    <VALUE Lang="th">Chi Ri Qing is a Sacred Gate Campus 2nd Year Student. He is a former Trainee of the Sword Section Class. His background is very interesting: both of his parents died in a chaotic incident.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Since then, he left the school carrying out his own investigation about the incident.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you have seen or have any information about this student, please contact the Administration Office immediately.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_4_0">
    <VALUE Lang="th">Cheng Xi Zhi is a 2nd Year student from the Sacred Gate Campus, and a former trainee of the Archery Section. Both of her parents died in the catastrophic phenomenon that caused the major problems in our world. She is now using her Evil Spirit to find her mutated older sister.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This student has important information regarding the location of Leonair Campus. We must get in contact with her immediately.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_5_0">
    <VALUE Lang="th">There are no means to keep this Terminal to function Properly.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0">
    <VALUE Lang="th">Say, are you feeling alright?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_1">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_10">
    <VALUE Lang="th">Listen to Rumor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_11">
    <VALUE Lang="th">Listen to Rumor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_12">
    <VALUE Lang="th">Listen to Rumor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_13">
    <VALUE Lang="th">Listen to Rumor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_3">
    <VALUE Lang="th">Guard's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_4">
    <VALUE Lang="th">Give the Note</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_5">
    <VALUE Lang="th">Guard's 2nd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_6">
    <VALUE Lang="th">Verify the Medicine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_7">
    <VALUE Lang="th">Guard's 3rd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_8">
    <VALUE Lang="th">Give the Daggers</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_1_0_9">
    <VALUE Lang="th">Acquire the Documents</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_10_0">
    <VALUE Lang="th">인도로는 가지말고 왠만하면 왼쪽이나 오른쪽 길로 돌아가는게 아마 좋을거야.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">저 정신나간 것들이 그래도 버릇은 남았는지 차도로는 잘 안다닌다니까-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_11_0">
    <VALUE Lang="th">득도의 경지에 이른 ‘마루치’ 와 ‘아라치’ 의 기운이 서로 만나서 이루는 경지를 말하는거 라더군</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">아마도 '나한의 구슬' 과 '깨달음의 열쇠'도 관계가 있을거야</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_11_0_1">
    <VALUE Lang="th">'깨달음의 열쇠' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_11_0_2">
    <VALUE Lang="th">'나한의 구슬' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_11_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_12_0">
    <VALUE Lang="th">예전에 재단에서 온 사람들이 그런 말을 하는 걸 들은 적이 있는데 열쇠가 지금은 조각 조각으로 나뉘어져 있다더군</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">일단은 그 조각들을 합쳐야 할 텐데 말야...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_13_0">
    <VALUE Lang="th">직접 본 적은 없으니까 녹색 구슬이라는 것 밖에는 알 수가 없군</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">더 자세한 건 '학생주임'님께 여쭈 보면 알 수 있지 않을까</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_13_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_14_0">
    <VALUE Lang="th">These mobs bring nothing but destruction to the environment.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_14_0_1">
    <VALUE Lang="th">Ask about What is Happening</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_14_0_2">
    <VALUE Lang="th">Ask about the Situation Outside</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_14_0_3">
    <VALUE Lang="th">Ask for Useful Information</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_14_0_4">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_15_0">
    <VALUE Lang="th">You mean the mail from the Finance Department Headquarters?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I actually had that document earlier, but I'm not sure where I placed it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_15_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_16_0">
    <VALUE Lang="th">Goodness! I almost forgot...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I should have told you at the very beginning. I was thinking of asking you to do something.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I wasn't aware of the full extent of the chaos caused by these weird mobs on the campus grounds and the surrounding area. That is why I'm staying here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_16_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_17_0">
    <VALUE Lang="th">Well, I'll be...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is the note! Thanks for finding it. Even though you found this note, there are still bigger problems that we've got to deal with.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Sigh...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_17_0_2">
    <VALUE Lang="th">Guard's 2nd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_18_0">
    <VALUE Lang="th">Please consider helping me out by delivering this medicine to the Health Advisor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_18_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_19_0">
    <VALUE Lang="th">Oh! You found them all!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you very much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please take all this medicine to the Health Advisor now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The people causing trouble on campus are preventing me from bringing this medicine to the Health Advisor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_19_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_2_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_2_1">
    <VALUE Lang="th">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_20_0">
    <VALUE Lang="th">Hmm?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Did the Health Advisor like it?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh! He did?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_20_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_21_0">
    <VALUE Lang="th">Sorry for troubling you like this, but I really appreciate your hard work, especially since it's making our campus much safer.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm really impressed by your performance.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'll be sure to commend you for all the good you've done for me if I ever meet your teachers again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_21_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_22_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_23_0">
    <VALUE Lang="th">Please note that all previous transformation effects are lost when transformation attempts are unsuccessful.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_23_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_24_0">
    <VALUE Lang="th">........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_25_0">
    <VALUE Lang="th">Ah, it's over here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It might not seem very important, but the Student Director personally requested this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_25_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_26_0">
    <VALUE Lang="th">Maybe he sets a limit on how much he trusts the students.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What's important is that the document is still here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_26_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_27_0">
    <VALUE Lang="th">......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_28_0">
    <VALUE Lang="th">Not so long ago, the note written by the Health Advisor that the Blood Drinker requested was stolen.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_28_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_29_0">
    <VALUE Lang="th">I'm sorry for bothering you, but may I know if you've found the stolen note?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_29_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_3_0">
    <VALUE Lang="th">Sigh... I don't even know where to begin.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">My situation is a bit complicated because I have to take care of the Health Advisor's request to search for first-aid medicine.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I lost the list of medicines!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is a serious problem</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_30_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_31_0">
    <VALUE Lang="th">The Health Advisor has ordered the recovery of the first-aid medicine several times. We need that medicine back as soon as possible.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_31_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_32_0">
    <VALUE Lang="th">Please accept my request for your help again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_32_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_33_0">
    <VALUE Lang="th">There are these fellahs known as the Blood Drinkers that rob people who possess the medicine. It's pretty clear that these Blood Drinkers have the medicine. Please make sure they can't rob people of their medicine again.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_33_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_34_0">
    <VALUE Lang="th">Those crazy people swinging around their knives in the street are pretty dangerous!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Especially that group of mobsters known as the Gangsters!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_34_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_35_0">
    <VALUE Lang="th">So you might see all sorts of folk carrying around daggers dripping with fresh blood, but you don't need to be that afraid of them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_35_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_36_0">
    <VALUE Lang="th">Please help me out by taking the Knives away from those Gangsters.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's probably impossible to get all their knives, but I think getting 10 Knives from them shouldn't be a problem.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_36_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_37_0">
    <VALUE Lang="th">I hear that some strange kind of money has appeared.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">At least that's what I heard. You can learn more about the rumor at the campus's crossroads over there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_37_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_38_0">
    <VALUE Lang="th">I hear that item is very small and easy to lose.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Search for the people that came back from the dead on Leonair Campus and talk to them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You might learn some useful information.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_38_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_39_0">
    <VALUE Lang="th">I hear that item is very small and easy to lose.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Search for the people that came back from the dead on Leonair Campus and talk to them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You might learn some useful information.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_39_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_4_0">
    <VALUE Lang="th">This is the first time in my life that I've encountered a problem that doesn't make any sense at all. I can't even go outside to assess the actual situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Where in the hell are these mobs coming from?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not so long ago, those creatures almost killed me while I was rescuing a friend of mine. I barely died, and I tell ya…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It was horrible!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_4_0_1">
    <VALUE Lang="th">Ask about Situation on the Streets</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_4_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_5_0">
    <VALUE Lang="th">.........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_6_0">
    <VALUE Lang="th">하도 정신이 없어서 누군지</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">얼굴도 기억 나질 않는데</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">하여튼 그 친구가 자기 이름이</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그렇다고 했던 것만 겨우 기억</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">나는군</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_6_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_7_0">
    <VALUE Lang="th">Let me see. Even though I had a tough time coming here, I don't think I have any other information to tell you. Wait! Hold on a minute.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There's something called an Abrasive Potion that you can use to make better equipment.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_7_0_2">
    <VALUE Lang="th">Ask How to Use Abrasive Potions</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_8_0">
    <VALUE Lang="th">Open the Inventory Window and choose the Abrasive Potion. Drag it to the item you want to transform by clicking the top right position of the item, and the item will be upgraded.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_8_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_9_0">
    <VALUE Lang="th">난리도 아니야~</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">여기부터는 최소한 레벨이 35는 돼야 갈 수 있을걸세.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그러니 그냥 얌전히 돌아가서 연습 좀 더 하고 나오게나.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_guard1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
