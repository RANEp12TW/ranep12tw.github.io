    <VALUE Lang="th">Accept Immediately</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_shop1.ntk_1_0_5">
    <VALUE Lang="th">Accept Immediately</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_shop1.ntk_1_0_6">
    <VALUE Lang="th">Accept Immediately</VALUE>
