    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_33_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_33_0_4">
    <VALUE Lang="th">Exchange Item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_33_0_5">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_34_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_34_0_4">
    <VALUE Lang="th">Exchange Item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_34_0_5">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_35_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_35_0_4">
    <VALUE Lang="th">Exchange Item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_35_0_5">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_36_0">
    <VALUE Lang="th">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_36_0_4">
    <VALUE Lang="th">Exchange Item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_36_0_5">
    <VALUE Lang="th">Cancel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_37_0">
    <VALUE Lang="th">.......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_38_0">
    <VALUE Lang="th">Great strength allows you to fulfill two important objectives in battle.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can use your strength to attack your enemies or to protect your friends.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_38_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_39_0">
    <VALUE Lang="th">You know which use of your strength is best without telling me, right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Remember that hurting others can only be considered moral if you do it to protect someone.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_39_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_4_0">
    <VALUE Lang="th">Although you can learn and understand swordsmanship by swinging a sword on your own, please listen to me carefully, even if I'm repeating basics that you already know.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_4_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_40_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_41_0">
    <VALUE Lang="th">You are awarded 3 Stat Points each time your character levels up. Your character's build and growth is determined by how these Stat Points are allocated to your character's attributes.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_41_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_42_0">
    <VALUE Lang="th">If you evenly distribute points to Strength, Stamina, and Dexterity, then your character will grow into a Swordsman with very fast attacks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_42_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_43_0">
    <VALUE Lang="th">If you concentrate on the Strength stat, then your character will become a Swordsman that inflicts great damage to enemies.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_43_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_44_0">
    <VALUE Lang="th">Lastly, distributing the points evenly to Strength, Dexterity, and Intelligence will result in a Skill Type character.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_44_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_45_0">
    <VALUE Lang="th">......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_46_0">
    <VALUE Lang="th">Take note that practitioners in the Sword Section consume a relatively large amount of SP.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_46_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_47_0">
    <VALUE Lang="th">Your Accuracy and attack rate will diminish once your SP is completely depleted. Try to avoid this dangerous scenario.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_47_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_48_0">
    <VALUE Lang="th">Therefore, cast your skills wisely, and don't needlessly overexert yourself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_48_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_49_0">
    <VALUE Lang="th">..........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_5_0">
    <VALUE Lang="th">Stand at the front of your party. Protecting them is your primary job. This is how a Swordsman displays his power.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_5_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_50_0">
    <VALUE Lang="th">You should have more than enough Skill Points at the beginning since the starting skills won't require many Skill Points.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_50_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_51_0">
    <VALUE Lang="th">You'll find, however, that you might not have enough points to learn some of the later skills. Think and plan carefully, and choose the essential skills that you want to learn.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_51_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_52_0">
    <VALUE Lang="th">.....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_53_0">
    <VALUE Lang="th">Oh, and you've got to visit the Student Director at the School Administration Office to register as a student. The office is next to the Welfare Society.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can get your wounds treated at the First-Aid Room. You'd better know how to get there. Sooner or later, you're probably going to get injured!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_53_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_54_0">
    <VALUE Lang="th">......</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_55_0">
    <VALUE Lang="th">This is just my observation, but all the teachers and students from the school came out fine.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please remember that the evil can't control everyone!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There aren't too many normal human beings around anymore. Most have already been transformed into evil monsters. Although it's a really bad situation, it's not like things can't be changed for the better. Please remember this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_55_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_56_0">
    <VALUE Lang="th">The teachers are doing all that they can to return things back the way they should be.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_56_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_57_0">
    <VALUE Lang="th">........</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_58_0">
    <VALUE Lang="th">Like I said before, these violent monsters are wrecking our campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please get out there, and keep them from causing even more destruction.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_58_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_59_0">
    <VALUE Lang="th">Know that carelessness may result in you ending up in a really bad situation.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_59_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_6_0">
    <VALUE Lang="th">Initially, your character's Skill Points are set to 0. You earn 1 additional Skill Point every time your character levels up. You can use these points to learn new skills.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_60_0">
    <VALUE Lang="th">Remember that you'll be entering a world full of dangers once you submit the Exit Approval Form. Please be careful out there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_60_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_61_0">
    <VALUE Lang="th">Oh... So you saw the List of Saints.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's true that there's nothing wrong with the list.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah, but you're probably curious about what's behind it. Am I right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why are there so many students with family problems?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's quite simple, actually.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Not too many loving parents would send their children to an experimental school.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even if extraordinary benefits were offered, most parents would think that traditions set by normal schools are more important.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_61_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_62_0">
    <VALUE Lang="th">Many people raise this question...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">What is forgiveness, and does it work?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Oh, but it's not like I have the right to teach you anything.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why should I force what little I know upon you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You know that there are arenas in the Trading Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can find teachers that can teach you more over there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_62_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
