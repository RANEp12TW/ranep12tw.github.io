  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_9_0">
    <VALUE Lang="th">I've found out that quests are very difficult at first. But now... It's really hard for me to finish them.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_9_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_medic1.ntk_1_0">
    <VALUE Lang="th">Oh my goodness! Why are so many people injured?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_medic1.ntk_1_0_1">
