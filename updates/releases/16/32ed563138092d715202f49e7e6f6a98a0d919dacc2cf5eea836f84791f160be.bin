  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_27_0_4">
    <VALUE Lang="th">Titan's Confidence</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_27_0_5">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_28_0">
    <VALUE Lang="th">If you have Spirit Spheres, you are somehow qualified. Now, which skill do you want?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_28_0_1">
    <VALUE Lang="th">Angry Quack Quack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_28_0_2">
    <VALUE Lang="th">Whipping Artist</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_28_0_3">
    <VALUE Lang="th">Magicknife Illusion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_28_0_4">
    <VALUE Lang="th">Titan's Determination</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_28_0_5">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_3_0">
    <VALUE Lang="th">I know your situation very well, but I cannot take any more risks. I'm sorry, but take this as a consolation.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_4_0">
    <VALUE Lang="th">Take the bus and go to Mystic Peak Lake Shop. Then, eliminate the Stray Dogs.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_5_0">
    <VALUE Lang="th">Go to the MarketPlace. The Assassin Student has the detailed information.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_6_0">
    <VALUE Lang="th">You have to be careful! He is not an easy target.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_7_0">
    <VALUE Lang="th">If you have Spirit Spheres, you are somehow qualified. Now, which skill do you want?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_7_0_1">
    <VALUE Lang="th">Sand Dust</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_7_0_2">
    <VALUE Lang="th">Whipped</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_7_0_3">
    <VALUE Lang="th">Glittering Bees</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_7_0_4">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_8_0">
    <VALUE Lang="th">If you have Spirit Spheres, you are somehow qualified. Now, which skill do you want?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_8_0_1">
    <VALUE Lang="th">Scratch</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_8_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_9_0">
    <VALUE Lang="th">If you have Spirit Spheres, you are somehow qualified. Now, which skill do you want?</VALUE>
  </SENTENSE>
