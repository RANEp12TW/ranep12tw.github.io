  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_26_0_5"><VALUE Lang="tw">兌換 守護之刃（157級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Guardian Blade (Lv157, Class=130, Item=175/12)</VALUE><VALUE Lang="id">Skill book: Guardian Blade (Lv157, Class=130, Item=175/12)</VALUE><VALUE Lang="cn">Skill book: Guardian Blade (Lv157, Class=130, Item=175/12)</VALUE><VALUE Lang="th">Skill book: Guardian Blade (Lv157, Class=130, Item=175/12)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_26_0_7"><VALUE Lang="tw">兌換 奪魂斬（117級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Soul Reaver (Lv117, Class=130, Item=175/32)</VALUE><VALUE Lang="id">Skill book: Soul Reaver (Lv117, Class=130, Item=175/32)</VALUE><VALUE Lang="cn">Skill book: Soul Reaver (Lv117, Class=130, Item=175/32)</VALUE><VALUE Lang="th">Skill book: Soul Reaver (Lv117, Class=130, Item=175/32)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_26_0_8"><VALUE Lang="tw">兌換 烈焰昇騰（157級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Blazes Soar (Lv157, Class=130, Item=175/52)</VALUE><VALUE Lang="id">Skill book: Blazes Soar (Lv157, Class=130, Item=175/52)</VALUE><VALUE Lang="cn">Skill book: Blazes Soar (Lv157, Class=130, Item=175/52)</VALUE><VALUE Lang="th">Skill book: Blazes Soar (Lv157, Class=130, Item=175/52)</VALUE></SENTENSE>
