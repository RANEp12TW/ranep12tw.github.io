  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_magic_sdchange.ntk_8_0_2"><VALUE Lang="tw">兌換 無影踢（97級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Shadowless Kick (Lv97, Class=520, Item=176/7)</VALUE><VALUE Lang="id">Skill book: Shadowless Kick (Lv97, Class=520, Item=176/7)</VALUE><VALUE Lang="cn">Skill book: Shadowless Kick (Lv97, Class=520, Item=176/7)</VALUE><VALUE Lang="th">Skill book: Shadowless Kick (Lv97, Class=520, Item=176/7)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_magic_sdchange.ntk_8_0_3"><VALUE Lang="tw">兌換 致命冰凍（67級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="id">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="cn">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE><VALUE Lang="th">Skill book: Fatal Freeze (Lv67, Class=520, Item=176/28)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_magic_sdchange.ntk_8_0_4"><VALUE Lang="tw">兌換 天界甘霖（67級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Heaven's Rain (Lv67, Class=520, Item=176/49)</VALUE><VALUE Lang="id">Skill book: Heaven's Rain (Lv67, Class=520, Item=176/49)</VALUE><VALUE Lang="cn">Skill book: Heaven's Rain (Lv67, Class=520, Item=176/49)</VALUE><VALUE Lang="th">Skill book: Heaven's Rain (Lv67, Class=520, Item=176/49)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_magic_sdchange.ntk_8_0_5"><VALUE Lang="tw">兌換 雷霆閃電（12級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Lightning Thunder (Lv12, Class=520, Item=176/68)</VALUE><VALUE Lang="id">Skill book: Lightning Thunder (Lv12, Class=520, Item=176/68)</VALUE><VALUE Lang="cn">Skill book: Lightning Thunder (Lv12, Class=520, Item=176/68)</VALUE><VALUE Lang="th">Skill book: Lightning Thunder (Lv12, Class=520, Item=176/68)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_magic_sdchange.ntk_9_0">
    <VALUE Lang="th">Do you want to have a skill scroll of 10th grade?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_magic_sdchange.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_magic_sdchange.ntk_9_0_2"><VALUE Lang="tw">兌換 穿刺（87級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Impale (Lv87, Class=520, Item=176/8)</VALUE><VALUE Lang="id">Skill book: Impale (Lv87, Class=520, Item=176/8)</VALUE><VALUE Lang="cn">Skill book: Impale (Lv87, Class=520, Item=176/8)</VALUE><VALUE Lang="th">Skill book: Impale (Lv87, Class=520, Item=176/8)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_magic_sdchange.ntk_9_0_3"><VALUE Lang="tw">兌換 冤靈召喚（97級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Lemures (Lv97, Class=520, Item=176/29)</VALUE><VALUE Lang="id">Skill book: Lemures (Lv97, Class=520, Item=176/29)</VALUE><VALUE Lang="cn">Skill book: Lemures (Lv97, Class=520, Item=176/29)</VALUE><VALUE Lang="th">Skill book: Lemures (Lv97, Class=520, Item=176/29)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_magic_sdchange.ntk_9_0_4"><VALUE Lang="tw">兌換 岩漿爆破（77級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Magma Explosion (Lv77, Class=520, Item=176/50)</VALUE><VALUE Lang="id">Skill book: Magma Explosion (Lv77, Class=520, Item=176/50)</VALUE><VALUE Lang="cn">Skill book: Magma Explosion (Lv77, Class=520, Item=176/50)</VALUE><VALUE Lang="th">Skill book: Magma Explosion (Lv77, Class=520, Item=176/50)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0">
    <VALUE Lang="th">Would you care to join me?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_1">
    <VALUE Lang="th">Tell him that Suah has sent you here</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_10">
    <VALUE Lang="th">Hand over the letter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_11">
    <VALUE Lang="th">Eliminate Wildlife Species</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_12">
    <VALUE Lang="th">Eliminate Wildlife Species</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_13">
    <VALUE Lang="th">Eliminate Wildlife Species</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_14">
    <VALUE Lang="th">Eliminate Wildlife Species</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_15">
    <VALUE Lang="th">Eliminate Wildlife Species</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_16">
    <VALUE Lang="th">Eliminate Wildlife Species</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_17">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_18">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_19">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_2">
    <VALUE Lang="th">Ask why he is staying here</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_20">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_21">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_22">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_23">
    <VALUE Lang="th">Tell him you want to know more about him</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_24">
    <VALUE Lang="th">Girl without a news</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_25">
    <VALUE Lang="th">Deliver the letter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_26">
    <VALUE Lang="th">Kill Wild species</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_27">
    <VALUE Lang="th">Tell the result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_3">
    <VALUE Lang="th">Ask if he needs help with anything</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_4">
    <VALUE Lang="th">Report Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_5">
    <VALUE Lang="th">Ask if he needs help with anything</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_6">
    <VALUE Lang="th">Tell him what you have heard</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_7">
    <VALUE Lang="th">Ask if he wants him to do anything</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_8">
    <VALUE Lang="th">Deliver the First Aid Medicine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_9">
    <VALUE Lang="th">Hear his story</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_10_0">
    <VALUE Lang="th">Oh.. Don't bother.. You already know that some people have been chasing us, right? Well, it doesn't implicate that we did something very bad. We just have different perspectives. I think behavior is what makes the good or bad, not a single person should be judged as good or bad. Being chased isn't such a great feeling though.. haha</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_10_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_11_0">
    <VALUE Lang="th">It's not a difficult task. Go tell Suah that she doesn't have to worry about the pursuers anymore and I need more medicine because Obi nine's condition has gotten worse. Also, captain is doing fine so tell her not to cry.. hahaha.. I can imagine her worrying her butt off.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_11_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_12_0">
    <VALUE Lang="th">What a load off.. Thank you for your help..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_12_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_13_0">
    <VALUE Lang="th">…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_14_0">
    <VALUE Lang="th">There is a letter to Suah, please just give it to her without saying anything. She is very shy so be cautious. Also, you should not open it, ok? HaHa</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_14_0_1">
    <VALUE Lang="th">Tell him you will deliver it</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_14_0_2">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_15_0">
    <VALUE Lang="th">What a loving couple.. hahaha.. Well received. I will hand this over to captain..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_15_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_16_0">
    <VALUE Lang="th">What a loving couple.. hahaha.. Well received. I will hand this over to captain..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_16_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_17_0">
    <VALUE Lang="th">…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_18_0">
    <VALUE Lang="th">I know you've already helped me once but there are just too many wildlife specimens, please eliminate enough of them. I would really appreciate it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_18_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_19_0">
    <VALUE Lang="th">Thanks. Not enough but I can work something out. I found this while wandering around this place and I think this should be helpful to you. Here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_19_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_2_0">
    <VALUE Lang="th">You are safe.. Thank god, I was so worried.. The wounded member's recovery speed has been really slow, it might be because of the environment but anyways.. Therefore, I could not leave this place..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_20_0">
    <VALUE Lang="th">They carry a metal box and some attack with fire. I can handle them myself but I figure it would be nice to get a help as well.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_20_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_21_0">
    <VALUE Lang="th">You surprise me every time! Here, this is a little compensation. Thank you!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_21_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_22_0">
    <VALUE Lang="th">They must be the sailors cause I saw them on the ship and sometimes they seemed really busy up on the deck. They find me every time when I go near so please do this again!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_22_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_23_0">
    <VALUE Lang="th">They must loved the sea.. All of this has to end.. Her, I hope this can help you..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_24_0">
    <VALUE Lang="th">They are the first people who we encountered when we cam here. There were many of them outside of Hangout. They stop me from looking around Hangout so please help me!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_24_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_25_0">
    <VALUE Lang="th">Now I can finish searching around the building, Thanks!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_25_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_26_0">
    <VALUE Lang="th">…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_27_0">
    <VALUE Lang="th">Well.. You want me to talk about myself.. You are a trust worthy person.. so I think it will be fine to talk about my private stuff. I am a Diplomat. Don't give me that look.. haha Don't judge people by their dresses and looks.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_27_0_1">
    <VALUE Lang="th">Ask about his home</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_28_0">
    <VALUE Lang="th">Our world is divided into two different worlds. One side is bright and warm and another side is dark and cold. People from the bright side wouldn't really know how blessed they are since it's like an air to them..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_28_0_1">
    <VALUE Lang="th">Ask how is the Anther side</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_29_0">
    <VALUE Lang="th">Another side is where our party had come from, people need to rely on each other to survive. On the barren land, people have to fight against the vicious and violent animals to live there.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_29_0_1">
    <VALUE Lang="th">Ask why he came to this world</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_3_0">
    <VALUE Lang="th">When we first arrived here, one of the member got injured and.. I and the captain decided to get separated from the party and stayed here for a while.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_3_0_1">
    <VALUE Lang="th">Ask him where others are</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_30_0">
    <VALUE Lang="th">People need light, even though they live in a dark place. It is a complicated matter but let me put it this way, the reason we are here is to find something that can help us get the light.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_30_0_1">
    <VALUE Lang="th">Ask what he is going to do once he finds it</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_31_0">
    <VALUE Lang="th">We have to go back to our world. And end the long lasted war.. Then I am thinking about making a family of my own with a girl who I love. Hahaha</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_31_0_1">
    <VALUE Lang="th">Ask if he has anyone in his mind</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_32_0">
    <VALUE Lang="th">There is.. an untruthful child.. Haha..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_32_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_33_0">
    <VALUE Lang="th">…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_34_0">
    <VALUE Lang="th">I wanna know how Mr.No-Name is doing. He did me a favor when we last met but since then I have never got a chance to thank him properly. Send him my regards.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_34_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_35_0">
    <VALUE Lang="th">Aww! Thanks!.. Gee.. They've been through a lot..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_35_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_4_0">
    <VALUE Lang="th">It's at the safe place. This is a matter of trust. You might think you can trust but the breach of faith always comes together. Don't you think you have to show me some proof before I can trust you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_4_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_5_0">
    <VALUE Lang="th">The one who always carries a fish and another one carrying two batons are keep interrupting when I tried to go see my captain and friends. If you are not that busy then please help me..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_5_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_6_0">
    <VALUE Lang="th">Good.. This is enough.. They will gather here again eventually but this will help us for a while. Thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_6_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_7_0">
    <VALUE Lang="th">Since you are a reliable person, could I ask you one more thing? It will be a piece of a cake to you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_7_0_1">
    <VALUE Lang="th">Tell him you will help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_8_0">
    <VALUE Lang="th">You will be able to meet an oldman in front of a large building if you go towards the wharf. He was the only one who did not lose his mind when we first arrived to this world. Go find him and ask what exactly happened when the phenomenon occurred here.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_8_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_9_0">
    <VALUE Lang="th">Umm.. The pursuers have.. Eventually they turned out like.. What a load off..</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_9_0_1">
    <VALUE Lang="th">Ask about the pursuers</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_minigame.ntk_1_0">
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The wheel of life will go round and round forever!</VALUE>
    <VALUE Lang="th">I'll tell you what, anything too much isn't good for you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hope you enjoy this appropriately!</VALUE>
    <VALUE Lang="th">I did warn you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">*Bet limit: 1~ 10,000,000 Gold</VALUE>
    <VALUE Lang="th">*Bet will be increased automatically for the consecutive wins.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_minigame.ntk_1_0_1">
    <VALUE Lang="th">Play Dice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0">
    <VALUE Lang="th">I feel good after change battle ground~ What are you here for?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0_1">
    <VALUE Lang="th">Ask about CDM Honor Award.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0_2">
    <VALUE Lang="th">Ask about Honor Award Trade list.</VALUE>
  </SENTENSE>
