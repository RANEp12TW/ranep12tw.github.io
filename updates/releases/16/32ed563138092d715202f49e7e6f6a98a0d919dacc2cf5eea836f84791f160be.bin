  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_12">
    <VALUE Lang="th">Wait a minute, what is this?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Hmm... Do you want to get stronger? I can help you do that.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_12_1">
    <VALUE Lang="th">Accept</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_12_2">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13">
    <VALUE Lang="th">You'll experience the roughest training, even if you give up halfway. It's up to you how long you endure it... I hope you get the best results, though.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
