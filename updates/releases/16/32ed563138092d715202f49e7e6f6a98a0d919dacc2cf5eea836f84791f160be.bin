  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4">
    <VALUE Lang="th">A student can be considered quite powerful if he passes all of the exams.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4_1">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4_2">
    <VALUE Lang="th">Ask about the Old Man at Root Hole</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4_3">
    <VALUE Lang="th">Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5">
    <VALUE Lang="th">I'm curious as to how far the students' capabilities can be tested.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_1">
    <VALUE Lang="th">Ask about Mail</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_2">
    <VALUE Lang="th">Show Rewards</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_3">
    <VALUE Lang="th">Ask about Situation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_4">
    <VALUE Lang="th">Show the Pill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_5">
    <VALUE Lang="th">Ask about What Happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_6">
    <VALUE Lang="th">Accept Confirmed Results</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_7">
    <VALUE Lang="th">Ask about the Old Man at Root Hole</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_8">
    <VALUE Lang="th">Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6">
    <VALUE Lang="th">What are you here for?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_1">
    <VALUE Lang="th">Show the Letter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_2">
    <VALUE Lang="th">Ask about the Mail</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_3">
    <VALUE Lang="th">Ask about the Old Man at Root Hole</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_4">
    <VALUE Lang="th">Result</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_10_0">
    <VALUE Lang="th">Here!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you want to accept the Final Test?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_10_0_2">
    <VALUE Lang="th">Accept the Final Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_10_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_11_0">
    <VALUE Lang="th">This is the Final Test.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Am I making you nervous?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This exam can reflect the capabilities of the students in regards to their power.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You have 8 minutes to finish the test. You are tasked to eliminate 15 Hunk Baldies located in the Golf Field area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_11_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_12_0">
    <VALUE Lang="th">This is great!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Even though it's not complete, the quality is pretty good.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_12_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_13_0">
    <VALUE Lang="th">I am sure that there are "Lights" around us.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know when these "Lights" would be appreciated.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_13_0_2">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_14_0">
    <VALUE Lang="th">Even my own daughter doesn't believe me!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Before the arrival of the abnormal phenomenon, she didn't say a word. She's ignoring the incident and refuses to believe what I say.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The reality is that these terrible things that are happening… They're not normal!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_14_0_2">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_15_0">
    <VALUE Lang="th">...4</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_16_0">
    <VALUE Lang="th">The students are starting to panic, but I think this is only the beginning of our troubles. I can feel that this craziness is going to get worse.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_16_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_17_0">
    <VALUE Lang="th">I need to test the capabilities of students so that they will be prepared for whatever dangers lie ahead.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_17_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_18_0">
    <VALUE Lang="th">....7</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_19_0">
    <VALUE Lang="th">This mail is from the professor who established the Sacred Financial Group.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_19_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_2_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_20_0">
    <VALUE Lang="th">My daughter is also a student of the Sacred Financial Group.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Have you heard about her before?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">She's still at Level 1… She doesn't know that much.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_20_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_21_0">
    <VALUE Lang="th">We have to eliminate the evil Senior Student!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">He's already caused too much trouble.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_21_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_22_0">
    <VALUE Lang="th">That senior transformed like the others into an evil monster! Maybe he belongs to another world now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_22_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_23_0">
    <VALUE Lang="th">....8</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_24_0">
    <VALUE Lang="th">It looks like we may never understand the languages from the other worlds.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_24_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_25_0">
    <VALUE Lang="th">There's another to pronounce these words, actually. Am I confusing you? Sorry!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_25_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_26_0">
    <VALUE Lang="th">There are weird characters around the area of the Sacred Gate Campus and 3rd Floor of the "Green" Underground Foothole Command Center.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Ah! Here's the problem.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Aima, Sarandu, Aida, the existence of connecting these three words can be found in the Trading Hole.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_26_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_27_0">
    <VALUE Lang="th">Did you know that they carry Painkillers? Please acquire 10 Painkillers within 15 minutes.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_27_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_28_0">
    <VALUE Lang="th">....10</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_29_0">
    <VALUE Lang="th">Second Exam completed!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">So did you want to learn more information?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The professor had predicted this would happen a long time ago, ever since the LiuChengYou incident in 1988.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_29_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_3_0">
    <VALUE Lang="th">Oh! Why are you late?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thanks! You came here just to bring my mail?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_3_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_30_0">
    <VALUE Lang="th">Are you talking about the incident?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">A few years later, the Sacred Financial Group was recognized internationally when it became a huge organization.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_30_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_31_0">
    <VALUE Lang="th">I received essential information earlier, which is why I know what is happening right now.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Recently, I thought that the prophecy was wrong.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_31_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_32_0">
    <VALUE Lang="th">The information I received before not only explained what happened at the time, but also indicated what will happen later.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm seeing the prophecy being fulfilled right now, considering the activities of the students in this area!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_32_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_33_0">
    <VALUE Lang="th">The prophecy indicated even more turmoil... I feel we should prepare for what's coming.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_33_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_34_0">
    <VALUE Lang="th">....13</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_35_0">
    <VALUE Lang="th">Please remember that the spreading of war and the abnormal phenomenon are related to the "Light". Students need to think and act as heroes to get ready for the future.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_35_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_36_0">
    <VALUE Lang="th">Someday, I will recover my memories of the peace we enjoyed before all of this happened.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_36_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_37_0">
    <VALUE Lang="th">You must remember that we need to be unified in order to combat the chaos around us!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_37_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_38_0">
    <VALUE Lang="th">Please consider this is the awakening.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">We need plenty of training and should have proven ourselves worthy before we can consider moving to another dimension.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_38_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_39_0">
    <VALUE Lang="th">......14</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_4_0">
    <VALUE Lang="th">Here! I advise you to take a rest first!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_4_0_2">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_4_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_40_0">
    <VALUE Lang="th">Have you seen the sun in Leonair Campus?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There is no Light anymore in that area!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_40_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_41_0">
    <VALUE Lang="th">Have you seen the sun in Leonair Campus?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There is no Light anymore in that place.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">The location of Leonair Campus changed all of a sudden.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_41_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_42_0">
    <VALUE Lang="th">We should always be aware of events around us. We must be ever vigilant during these dark times!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_42_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_43_0">
    <VALUE Lang="th">The LiuChingYou incident was a costly lesson in vigilance to us.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Still, he must have had no regrets…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_43_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_44_0">
    <VALUE Lang="th">Our lives in the next dimension will reflect the lives we have right now. You should remember that!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_44_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_45_0">
    <VALUE Lang="th">Please train yourself until you attain enough power and qualification.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is preparation for the afterlife!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_45_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_46_0">
    <VALUE Lang="th">When the time is right, I'll tell you about the door that connects to the other world.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_46_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_47_0">
    <VALUE Lang="th">Once you enter the next dimension, you might see people that look just like you. You may also encounter much stronger monsters!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Keep this in mind.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_47_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_48_0">
    <VALUE Lang="th">Where was he last time?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'd better check and make sure.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_48_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_49_0">
    <VALUE Lang="th">That's already standardized.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Alright, confirmed. Please bring this to him, and he'll help you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_49_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_5_0">
    <VALUE Lang="th">Firstly, I would like to make sure that students get familiar with Geography. Have you encountered the Cordies, Freezing Halogens, WereWolves, and Shadow Crows?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you remember where they are located?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I will give you 20 Minutes to locate them and collect a specimen of their saliva and feathers.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_5_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_6_0">
    <VALUE Lang="th">Yes! You brought them all?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thanks! It seems that you now know the locations of these creatures!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You passed my First Test!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Congratulations!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_6_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_7_0">
    <VALUE Lang="th">Okay, that's all!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Would you like to take the Second Test?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_7_0_2">
    <VALUE Lang="th">Accept 2nd Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_7_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_8_0">
    <VALUE Lang="th">Antony, Frankno, Salandu, Dalama, Aida, Panarol, Kalasanoya, Huianolu, Aima, Kanaauni!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Do you know who they are?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_8_0_2">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_9_0">
    <VALUE Lang="th">Was it difficult for you to find these Pills?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thanks a lot! You passed the 2nd Test!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_9_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_0">
    <VALUE Lang="th">How are you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You look so tired!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_0_2">
    <VALUE Lang="th">Ask about Problem</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_0_3">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_1">
    <VALUE Lang="th">Welcome!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Would you like to buy some Hot Dogs?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_1_1">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_1_2">
    <VALUE Lang="th">Ask about Lost Child</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2">
    <VALUE Lang="th">How are you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You look so tired!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2_1">
    <VALUE Lang="th">Ask about Problem</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2_4">
    <VALUE Lang="th">Give the Food Ingredients</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2_8">
    <VALUE Lang="th">Ask about Lost Child</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_2_0">
    <VALUE Lang="th">Hmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">All my food ingredients were stolen this morning.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">These ingredients are brought to this area every morning for our food preparations. Whoever did this to me must be planning to stir up trouble.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Can you help me find those ingredients?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_2_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_2_0_6">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_3_0">
    <VALUE Lang="th">Thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Once all the necessary ingredients are found, I'd be willing to give you complementary samples of my Hot Dogs as a token of my gratitude!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_4_0">
    <VALUE Lang="th">Nice! Thanks a lot!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I've got to repay you for your help…</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Wait here for just a bit.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Here's a fresh Hot Dog! Please take it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you so much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_5_0">
    <VALUE Lang="th">Oh! The lost child?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I don't know why the child disappeared. I just remember that child trying to buy some of my Hot Dogs. I am not really sure about it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I remember a group of people trying to find information regarding that lost child!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0">
    <VALUE Lang="th">Welcome!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Would you like to try our delicious Ice Cream?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_10">
    <VALUE Lang="th">Give the Bottles</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_11">
    <VALUE Lang="th">Deliver Dry Ice</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_7">
    <VALUE Lang="th">Trade Items</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_8">
    <VALUE Lang="th">Ask about Ice Cream Stall</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_9">
    <VALUE Lang="th">Collect Recyclable Bottles</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_10_0">
    <VALUE Lang="th">.....6</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_11_0">
    <VALUE Lang="th">Oh yes!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm just a part-timer here, so I'm ashamed to say I don't really know much. I'm fairly confident, though, when it comes to food businesses like coffee and desserts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_11_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_12_0">
    <VALUE Lang="th">I can really make good coffee! If everything goes along fine, I want to run my own coffee shop.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's sad to see the city in upheaval like this.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_12_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_13_0">
    <VALUE Lang="th">Recycling work is difficult, you know?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That's why we try our very best to help out!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_14_0">
    <VALUE Lang="th">Oh, thank you.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">That was fast!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I thought we'd run out of stuff to recycle, so I went around asking for help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Anyway, I won't need to worry about it for a while since you already brought plenty of recyclable trash!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_14_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_2_0">
    <VALUE Lang="th">Oh yes!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I'm just a part-timer here, so I'm ashamed to say I don't really know much. I'm fairly confident, though, when it comes to food businesses like coffee and desserts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I can really make good coffee! If everything goes along fine, I want to run my own coffee shop.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's sad to see the city in upheaval like this. Part of our contribution to help whittle down the chaos is by promoting recycling.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's very difficult, and that's why we need the community to help. Would you be willing to collect recyclable trash to earn some Ice Cream?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_2_0_1">
    <VALUE Lang="th">Accept Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_2_0_6">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_3_0">
    <VALUE Lang="th">고마워요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">재료를 찾아주시면</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">그 재료로 만든 핫도그는 제일 처음 드릴께요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_4_0">
    <VALUE Lang="th">정말 고마워요-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">이런거 그냥 말로만 해서는 안되겠죠?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">잠깐만 기다리세요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">금방 따끈한 핫도그를...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">자, 여기 드세요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">정말 고마웠어요-</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_5_0">
    <VALUE Lang="th">음... 그러네요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">항상 핫도그를 사라왔던 애들이 언제부터인지 보이지 않더니...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">잘은 모르겠어요</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">몇 명이 모여서 근처 산에 놀라간다면서 좋아했던 걸 본 게 마지막이었던 것 같은...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_5_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_6_0">
    <VALUE Lang="th">I'll give you some of our Ice Cream if you help us collect recyclable trash.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Would that be fine with you?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_6_0_1">
    <VALUE Lang="th">Accept Request to Collect Recyclable Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_6_0_2">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_7_0">
    <VALUE Lang="th">This is what you should do.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please collect the bottles from the folks who are carrying light poles accompanied by vile hounds.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">They just little those bottles when they can be recycled pretty easily. Would you help me bring back those bottles?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_8_0">
    <VALUE Lang="th">Oh! Are you done collecting the bottles?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">A little tougher than you thought, right?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Here, please have this Ice Cream!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you'd like to try one more time, please don't hesitate to let me know.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_8_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_9_0">
    <VALUE Lang="th">So... You want to do it again?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You're really helpful! Thank you!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_9_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
