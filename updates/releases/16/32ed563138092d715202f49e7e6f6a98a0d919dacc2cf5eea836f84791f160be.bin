  <SENTENSE Ver="1" Id="2015_6th_anniversary_cake.ntk_1_0">
    <VALUE Lang="th">Finally GS reach 6 years!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_6th_anniversary_cake.ntk_1_0_1">
    <VALUE Lang="th">GS 6th Anniversary Event</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_6th_anniversary_cake.ntk_2_0">
    <VALUE Lang="th">Once a day, talk to me to receive "6th Anniversary Key". Bring this to "6th Anniversary NPC" for some interesting reward as a trade ^__^</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_6th_anniversary_npc.ntk_1_0">
    <VALUE Lang="th">6 Years!!!</VALUE>
    <VALUE Lang="th">Bring me</VALUE>
    <VALUE Lang="th">6th Anniversary Coins</VALUE>
    <VALUE Lang="th">6th Anniversary Golden Key</VALUE>
    <VALUE Lang="th">and I will give you very interesting reward.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_6th_anniversary_npc.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_christmas1.ntk_1_0">
    <VALUE Lang="th">Oh no!!… The gift list is gone because of the Rebellious Rudolph!.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_christmas1.ntk_1_0_1">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_christmas1.ntk_1_0_2">
    <VALUE Lang="th">[Daily limited] Santa's Card Piece</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_christmas1.ntk_2_0">
    <VALUE Lang="th">I can give you one card only in a day, please understand.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_christmas1.ntk_2_0_1">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_christmas2.ntk_1_0">
    <VALUE Lang="th">Ouch… The list is gone because Grandfather Santa is in hurry.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_christmas2.ntk_1_0_1">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_1_0">
    <VALUE Lang="th">This! love! has! taken its toll on me! She said good bye, too many times b4~~~</VALUE>
    <VALUE Lang="th">Oh, hem, hem...were you listening?</VALUE>
    <VALUE Lang="th">Anyway, love is all about effort. Is there anything that can be earned without an effort?</VALUE>
    <VALUE Lang="th">You also make an effort to collect the love and bring it to me! Then I'll give you something in return.</VALUE>
    <VALUE Lang="th">If you want to, you can exchange your heart pieces to a higher one! See you then!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">---------------------------------------------------------------------</VALUE>
    <VALUE Lang="th">*65 Yellow Heart Pieces = Yellow Random Box</VALUE>
    <VALUE Lang="th">*65 Blue Heart Pieces = Blue Random Box</VALUE>
    <VALUE Lang="th">*65 Red Heart Pieces = Red Random Box</VALUE>
    <VALUE Lang="th">---------------------------------------------------------------------</VALUE>
    <VALUE Lang="th">*10 Yellow Heart Pieces = 1 Blue Heart Piece</VALUE>
    <VALUE Lang="th">*10 Blue Heart Pieces = 1 Red Heart Piece</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_1_0_1">
    <VALUE Lang="th">Trade Item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_1_0_2">
    <VALUE Lang="th">Exchange the heart pieces to random box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_1_0_3">
    <VALUE Lang="th">Exchange the heart pieces to a higher grade piece.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_2_0">
    <VALUE Lang="th">Well? How'd it go? What? A piece of cake? Then show me your effort at any time!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_2_0_1">
    <VALUE Lang="th">Exchange 65 Yellow Heart Pieces to Yellow Random Box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_2_0_2">
    <VALUE Lang="th">Exchange 65 Blue Heart Pieces to Blue Random Box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_2_0_3">
    <VALUE Lang="th">Exchange 65 Red Heart Pieces to Red Random Box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_2_0_4">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_3_0">
    <VALUE Lang="th">Ah~you want to 'upgrade' it? Looks like you're aiming for a big fish.? Or is it just your greed? Hehe.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_3_0_1">
    <VALUE Lang="th">Exchange 10 Yellow Heart Pieces to 1 Blue Heart Piece.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_3_0_2">
    <VALUE Lang="th">Exchange 10 Blue Heart Pieces to 1 Red Heart Piece.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_cupid.ntk_3_0_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_event_minigame01.ntk_1_0">
    <VALUE Lang="th">Hello~</VALUE>
    <VALUE Lang="th">My job is to trade your Plain Sphere with some items.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_event_minigame01.ntk_1_0_1">
    <VALUE Lang="th">Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_event_minigame02.ntk_1_0">
    <VALUE Lang="th">Ho Ho Ho Ho, Welcome~~</VALUE>
    <VALUE Lang="th">Bring your Lucky, Copper, Silver and Gold Sphere to me, to trade it with some items.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_event_minigame02.ntk_1_0_1">
    <VALUE Lang="th">Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_event_randombox.ntk_1_0">
    <VALUE Lang="th">Ho.. Ho.. Ho.. Ho.. Ho.. Ho.. Ho..</VALUE>
    <VALUE Lang="th">Come to me everyday and get 1 Daily Random Pouch.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_event_randombox.ntk_1_0_1">
    <VALUE Lang="th">Get the Daily Random Pouch</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_event_randombox.ntk_2_0">
    <VALUE Lang="th">Come back to me tomorrow.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family1.ntk_1_0">
    <VALUE Lang="th">Have you seen my daughter?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">She went out with the allowance but I don't see her coming back for hours…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family1.ntk_1_1">
    <VALUE Lang="th">Have you seen my daughter?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">She went out with the allowance but I don't see her coming back for hours…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family1.ntk_1_1_1">
    <VALUE Lang="th">Give the Carnation.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family1.ntk_2_0">
    <VALUE Lang="th">I never imagined my daughter could come up with such idea!</VALUE>
    <VALUE Lang="th">I am more than happy!!</VALUE>
    <VALUE Lang="th">Thank you for the carnation. This is for you!</VALUE>
    <VALUE Lang="th">-----------------------------------------------------</VALUE>
    <VALUE Lang="th">5 Carnations = "Dad's Random Box"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family1.ntk_2_0_1">
    <VALUE Lang="th">Receive Dad's Random Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family2.ntk_1_0">
    <VALUE Lang="th">Have you seen my daughter..?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's almost time for dinner, but where did she go…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family2.ntk_1_1">
    <VALUE Lang="th">Have you seen my daughter..?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's almost time for dinner, but where did she go…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family2.ntk_1_1_1">
    <VALUE Lang="th">Give the Carnation.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family2.ntk_2_0">
    <VALUE Lang="th">I feel so touched… I should make a special dinner for her!!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Thank you so much for accepting my kid's request.</VALUE>
    <VALUE Lang="th">This is my gratitude to you.</VALUE>
    <VALUE Lang="th">--------------------------------------------------------</VALUE>
    <VALUE Lang="th">5 Carnations = "Mom's Random Box"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family2.ntk_2_0_1">
    <VALUE Lang="th">Receive Mom's Random Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family3.ntk_1_0">
    <VALUE Lang="th">I'm hungry…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family3.ntk_1_1">
    <VALUE Lang="th">Could you do me a favor?</VALUE>
    <VALUE Lang="th">I want to give a carnation gift to my mom and dad, but I feel so shy... I can give you the carnation box, so could you hand it to them for me please? They both like flowers so they will be so happy if I can give them a lot!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Umm...do you have a chocolate by chance? I'm so hungry...If you have one, I can exchange it with some of my stuff.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">---------------------------------------------------------</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">70 Chocolate = "Kid's Random Box"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family3.ntk_1_1_1">
    <VALUE Lang="th">Receive the Carnation Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family3.ntk_1_1_2">
    <VALUE Lang="th">Exchange the Chocolate to Kid's Random Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_family3.ntk_2_0">
    <VALUE Lang="th">I hope my mom and dad are happy receiving this!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph01.ntk_1_0">
    <VALUE Lang="th">Woof! Woof! Bark! Bark! Woof! Woof! Bark! Bark!</VALUE>
    <VALUE Lang="th">Woof! Woof! Bark! Bark! Woof! Woof! Bark! Bark!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph01.ntk_1_0_1">
    <VALUE Lang="th">It seems we need to make him sleep to pass.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph01.ntk_1_0_2">
    <VALUE Lang="th">Feed sleeping pill.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph01.ntk_1_1">
    <VALUE Lang="th">Woof! Woof! Bark! Bark!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph01.ntk_1_1_1">
    <VALUE Lang="th">Cerberos blocks the gate to enter to another dimension.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph01.ntk_1_1_2">
    <VALUE Lang="th">Put Cerberos to sleep.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph01.ntk_2_0">
    <VALUE Lang="th">Zzz...Zzz...Zzz....Zzz</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph01.ntk_3_0">
    <VALUE Lang="th">Fiery Aunty in Trading Hole is carrying burn sleeping pill around.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph02.ntk_1_0">
    <VALUE Lang="th">Hahahaha. Welcome. I have some magical items~~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_gs_ph02.ntk_1_0_1">
    <VALUE Lang="th">Item Sale</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_newyear.ntk_1_0">
    <VALUE Lang="th">In celebration of New Year, my friends went out to celebrate and are now in danger.</VALUE>
    <VALUE Lang="th">Please find them and send them back. I'll give you a present in return.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_newyear.ntk_1_0_1">
    <VALUE Lang="th">[Daily Quest] Sending the Sheeps Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_newyear.ntk_2_0">
    <VALUE Lang="th">Please......</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_ph_compound_1.ntk_1_0">
    <VALUE Lang="th">Welcome to Ran World GS, Student Leaders!</VALUE>
    <VALUE Lang="th">You can exchange your compound materials here!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_ph_compound_1.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_0">
    <VALUE Lang="th">Ah, a student. Good to see you. As you may have felt it, recently students are having a nightmare. Perhaps an expert like you can solve the situation.</VALUE>
    <VALUE Lang="th">I want you to move into their dream and bring the sheep madness to an end.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_0_1">
    <VALUE Lang="th">Receive the Dream Invitation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_0_2">
    <VALUE Lang="th">Travel to Dream Hills(190~)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_1">
    <VALUE Lang="th">Ah, a student. Good to see you. As you may have felt it, recently students are having a nightmare. Perhaps an expert like you can solve the situation.</VALUE>
    <VALUE Lang="th">I want you to move into their dream and bring the sheep madness to an end.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_1_1">
    <VALUE Lang="th">Receive the Dream Invitation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_1_2">
    <VALUE Lang="th">Travel to Dream Hills(131~189)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_2">
    <VALUE Lang="th">Ah, a student. Good to see you. As you may have felt it, recently students are having a nightmare. Perhaps an expert like you can solve the situation.</VALUE>
    <VALUE Lang="th">I want you to move into their dream and bring the sheep madness to an end.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_2_1">
    <VALUE Lang="th">Receive the Dream Invitation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_2_2">
    <VALUE Lang="th">Travel to Dream Hills(30~130)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_1_3">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_sheep.ntk_2_0">
    <VALUE Lang="th">Good luck, student! Although I can't really guarantee that the students will be back on track shortly after they are relieved from the nightmare…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_skill_merchant.ntk_1_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_skill_merchant.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_summer_event.ntk_1_0">
    <VALUE Lang="th">Have you never seen a sheep standing?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_summer_event.ntk_1_1">
    <VALUE Lang="th">I don't even have a place to walk around because of that stupid crabs.... They are spoiling my green field...!..humm..... Will you kill those crazy crabs?.. I will give you very useful items for summer when you give me the evidence of killing them!</VALUE>
    <VALUE Lang="th">-----------------------------------------------------------</VALUE>
    <VALUE Lang="th">(rewarded items will be traded on item trading tab)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2015_summer_event.ntk_1_1_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_april_event1.ntk_1_0">
    <VALUE Lang="th">You can enter after Level 30. Please talk to me again when you are ready.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_april_event1.ntk_1_1">
    <VALUE Lang="th">Do you want to move to Ranny's Waterland? If you want to go there, please complete your daily quest to obtain an entry ticket. Afterwhich, you can enter the Waterland through the next gate.</VALUE>
    <VALUE Lang="th">------------------------------------------------------------</VALUE>
    <VALUE Lang="th">Entry ticket can be obtained by accomplishing daily quests and it can only be used for 30 minutes. You should meet Waterholic Ranny first when you arrive in Ranny's Waterland.</VALUE>
    <VALUE Lang="th">-----------------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_april_event1.ntk_1_1_1">
    <VALUE Lang="th">Receive today's entry ticket.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_april_event1.ntk_2_0">
    <VALUE Lang="th">Do you feel like you are getting closer to Waterholic Ranny? If you are, She will give you more rewards!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_april_event1.ntk_2_0_1">
    <VALUE Lang="th">Back to initial page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_april_event2.ntk_1_0">
    <VALUE Lang="th">Hi Lovely! You finally found me! Hum... I can sense that you are a good good person. But But But! I cannot easily trust someone who I just met for the first time in my life!. If you collect my favorite water droplets, then I will give you some AWESOME gifts!</VALUE>
    <VALUE Lang="th">----------------------------------------------------------</VALUE>
    <VALUE Lang="th">You know.. Water..Water......Water... Water has Big Big SPIRITUAL POWER to purifies people and even gives luck for the year in this Lake Sonkran!. Every year, some people just have a WATER festival for NEW year's event.. Do you know what is the most important thing in Waterholic festival? THAT is Splashing WATER to people to cleanse the other's misfortune. hehe... So.. Would you like to play water splash together?</VALUE>
    <VALUE Lang="th">---------------------------------------------------------</VALUE>
    <VALUE Lang="th">You know, I will be here during the entire event period. Don't worry! I won't leave during this time!.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_april_event2.ntk_1_0_1">
    <VALUE Lang="th">Open store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_battleislandevent.ntk_1_0">
    <VALUE Lang="th">Please help me, I have lost the Battle Islands' flags. Hunt level 190 and above mobs, collect the flags and return them to me please.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_battleislandevent.ntk_1_0_1">
    <VALUE Lang="th">ItemTrade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_1_0">
    <VALUE Lang="th">Quick… I need to find the Stars Fragments quickly…!</VALUE>
    <VALUE Lang="th">There is not much time left!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_1_0_1">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_1_1">
    <VALUE Lang="th">You've managed to collect quite a few! Thank you~</VALUE>
    <VALUE Lang="th">Please give the star fragments to me~ See you again tomorrow!</VALUE>
    <VALUE Lang="th">---------------------------------------------------</VALUE>
    <VALUE Lang="th">Santa's Pouch 1P + Star Fragments 40P = Star Decoration 1P</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_1_1_1">
    <VALUE Lang="th">I have collected them!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_1_1_2">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_1_1_3">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_1_2">
    <VALUE Lang="th">Oh no… Oh no…</VALUE>
    <VALUE Lang="th">The Star Decorations which were supposed to be given to everyone have broken…</VALUE>
    <VALUE Lang="th">How can I look for them alone? I wish someone would be so kind to help…</VALUE>
    <VALUE Lang="th">---------------------------------------------------</VALUE>
    <VALUE Lang="th">Santa's Pouch 1P + Star Fragments 40P = Star Decoration 1P</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_1_2_1">
    <VALUE Lang="th">Help Santa</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_1_2_2">
    <VALUE Lang="th">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_2_0">
    <VALUE Lang="th">Thank you very much for helping me~</VALUE>
    <VALUE Lang="th">I can put some of the fragments that you collected into my magic pouch!</VALUE>
    <VALUE Lang="th">You can receive the star decoration</VALUE>
    <VALUE Lang="th">by collecting them both and bring them to me!</VALUE>
    <VALUE Lang="th">Oh! I have the pouch, you can receive it once per day so don't forget it~!</VALUE>
    <VALUE Lang="th">---------------------------------------------------</VALUE>
    <VALUE Lang="th">Santa's Pouch 1P + Star Fragments 40P = Star Decoration 1P</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_christmas_event2.ntk_1_0">
    <VALUE Lang="th">(Wiggle wiggle) Seems to be alive and moving…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_1_0">
    <VALUE Lang="th">Noo...What do you expect me to do...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_1_1">
    <VALUE Lang="th">Here, here! You should have heard about the news right? I am talking about the mobs attacking the campuses! Unbelieveable.. They heard about the Shaper class and now they took their weapons and are attacking the campuses..</VALUE>
    <VALUE Lang="th">But, they only attack during sp</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_1_1_1">
    <VALUE Lang="th">Let's do this!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_1_1_2">
    <VALUE Lang="th">상점 열기</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_2_0">
    <VALUE Lang="th">Great! I knew you would come out good.</VALUE>
    <VALUE Lang="th">Here, take this bus ticket! You will need this ticket for transport when fighting the mobs</VALUE>
    <VALUE Lang="th">Don't lose it and I wish you luck in killing the boss mob!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_2_0_1">
    <VALUE Lang="th">Receive Ticket</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_3_0">
    <VALUE Lang="th">Thank you, I am really grateful! I have found out the time when the mobs usually attack. They will be attacking the campus entrance areas, please help during these times!</VALUE>
    <VALUE Lang="th">-----------------------------------------------------------------------------</VALUE>
    <VALUE Lang="th">15 : 00 ~ : possible entry and event</VALUE>
    <VALUE Lang="th">21 : 00 ~ : possible entry and event</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_1_0">
    <VALUE Lang="th">Thank you! Because of your help we can easily overcome the attacks!</VALUE>
    <VALUE Lang="th">Oh and, the mobs left an apology letter before they ran away. Collect these letters and exchange them with rewards!</VALUE>
    <VALUE Lang="th">But, don't let your guard down.. These sleazy mobs might change their</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_1_0_1">
    <VALUE Lang="th">No worries!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_1_0_2">
    <VALUE Lang="th">Take the bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_2_0">
    <VALUE Lang="th">Oh! And you can only get out of this area through me!</VALUE>
    <VALUE Lang="th">Please use the bus function that I am providing~</VALUE>
    <VALUE Lang="th">Bye, then~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event3.ntk_1_0">
    <VALUE Lang="th">It's still too dangerous for you..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event3.ntk_1_1">
    <VALUE Lang="th">Great to have you!! Now, prepare yourself for the mobs..</VALUE>
    <VALUE Lang="th">This won't be easy.</VALUE>
    <VALUE Lang="th">Are you ready?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event3.ntk_1_1_1">
    <VALUE Lang="th">Yeap! I am ready!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event3.ntk_1_1_2">
    <VALUE Lang="th">Get on the bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event3.ntk_2_0">
    <VALUE Lang="th">Hop aboard, let's go!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event3.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event4.ntk_1_0">
    <VALUE Lang="th">Here! Are you hurt?</VALUE>
    <VALUE Lang="th">It's good that you are not hurt after clearing the 1st stage</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event4.ntk_1_0_1">
    <VALUE Lang="th">Yeah!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event4.ntk_1_0_2">
    <VALUE Lang="th">Get on the bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event4.ntk_2_0">
    <VALUE Lang="th">Let's move to the 2nd stage!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event4.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event5.ntk_1_0">
    <VALUE Lang="th">Thank you for clearing the 2nd stage! Now is the last part..</VALUE>
    <VALUE Lang="th">Only the boss remains.. Gather all your remaining strength and let's do this!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event5.ntk_1_0_1">
    <VALUE Lang="th">Don't worry!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event5.ntk_1_0_2">
    <VALUE Lang="th">Get on the bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event5.ntk_2_0">
    <VALUE Lang="th">That's the spirit!! Defeat the boss and protect the Shapers and Campuses!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event5.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs7th_event_cake.ntk_1_0">
    <VALUE Lang="th">Hello~! Time flies so fast and it's already Ran GS' 7th anniversary. Let's celebrate!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs7th_event_cake.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs7th_event_helper.ntk_1_0">
    <VALUE Lang="th">Only users level 150 and above can participate in the event.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs7th_event_helper.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs7th_event_helper.ntk_1_1">
    <VALUE Lang="th">Thank you for all the support these 7 wonderful years! I am sure there will be more to come in the future! Let's enjoy and make beautiful memories together with Ran World GS</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs7th_event_helper.ntk_1_1_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs7th_event_helper.ntk_1_1_2">
    <VALUE Lang="th">Receive event reward</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs7th_event_helper.ntk_2_0">
    <VALUE Lang="th">Thank you very much. Please come again tomorrow for more rewards!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_0">
    <VALUE Lang="th">Arrived, have arrived~ the Event Helper, I have arrived!</VALUE>
    <VALUE Lang="th">Oh? This event is for LV30 and higher!</VALUE>
    <VALUE Lang="th">Please try to level up and come back!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_0_1">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_1">
    <VALUE Lang="th">Hi! Ran World friends~ I am in charge of helping users about the event, the Event Helper!</VALUE>
    <VALUE Lang="th">Recently, a new event has just started but it seems like only a few users know about it~</VALUE>
    <VALUE Lang="th">It wouldn't be fun to just let you know about the event, right~?</VALUE>
    <VALUE Lang="th">Every campus' Little Hooligan might have the clue about this event, please find the clue and get back to me. And then I will give you an awesome experience!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_1_1">
    <VALUE Lang="th">Find the clue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_1_2">
    <VALUE Lang="th">Submit the clue</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_1_3">
    <VALUE Lang="th">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_2_0">
    <VALUE Lang="th">Please be safe! You should be able to find the clue easily~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_3_0">
    <VALUE Lang="th">Wow! You have already found the clue? That was quick..</VALUE>
    <VALUE Lang="th">I will let you know about the event, but please don't tell other users! It's a secret, okay?</VALUE>
    <VALUE Lang="th">I will guide you to a place where the lights gather and float around. That place is very beautiful especially at night.</VALUE>
    <VALUE Lang="th">Come on now, go there and see for yourself~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_3_0_1">
    <VALUE Lang="th">Thank you!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_4_0">
    <VALUE Lang="th">You can only do this once per day so come back tomorrow~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event.ntk_1_0">
    <VALUE Lang="th">I need to make the special Egg… but I need more eggs...!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event.ntk_1_0_1">
    <VALUE Lang="th">Receive the entry ticket</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event.ntk_1_0_2">
    <VALUE Lang="th">Kill the Eggmon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event.ntk_2_0">
    <VALUE Lang="th">This is the entry ticket for meadow. Oh, by the way, you can only use it one time in a day and only 30 minutes!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event.ntk_3_0">
    <VALUE Lang="th">Please kill the 'Eggmon' and grab those eggs...!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event2.ntk_1_0">
    <VALUE Lang="th">I'm too busy.. Well..well.. I need more clovers to decorate...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event2.ntk_1_0_1">
    <VALUE Lang="th">Item Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_may_event.ntk_1_0">
    <VALUE Lang="th">Argh!!! Pierrots have stolen my gifts..</VALUE>
    <VALUE Lang="th">Please get back the gifts from Pierrots who appear in each schools map and Hole maps at specific times.</VALUE>
    <VALUE Lang="th">I still have some remaining gifts.. Take it!!</VALUE>
    <VALUE Lang="th">-------------------------------------------------------</VALUE>
    <VALUE Lang="th">Pierrots appeareance time (Each schools/ holes)</VALUE>
    <VALUE Lang="th">Everyday 15:00 ~ 15:30, 20:00 ~ 20:30</VALUE>
    <VALUE Lang="th">-------------------------------------------------------</VALUE>
    <VALUE Lang="th">I am counting on you!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_may_event.ntk_1_0_1">
    <VALUE Lang="th">Receive Marco's gift.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_may_event.ntk_2_0">
