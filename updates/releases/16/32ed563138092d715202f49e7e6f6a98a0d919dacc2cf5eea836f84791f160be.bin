  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_15_0">
    <VALUE Lang="th">It seems the Trading Hole can complete the mission, here it's already over. Me and the students are ultimately heading in the same direction, fighting for the same purpose. *Sigh…*</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_15_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_152_0">
    <VALUE Lang="th">Hurry and Go meet Student Counselor.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_153_0">
    <VALUE Lang="th">Hurry and Come back again.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_154_0">
    <VALUE Lang="th">Then, Help me.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_155_0">
    <VALUE Lang="th">Help me to deliver the important work.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_156_0">
    <VALUE Lang="th">Just take a bus to reach the Prison map.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_16_0">
    <VALUE Lang="th">I'll just give you mission here, and of course Lee Zhen will continue to give you missions. I don't want to make a habit of giving you assignments since I think it's important for you to train yourself.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_16_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_17_0">
    <VALUE Lang="th">Amanuoruoyin? I still can't believe we were able to get this much information about him...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_17_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_18_0">
    <VALUE Lang="th">Hmm... Seems like it'll need more accessories later.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_18_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_19_0">
    <VALUE Lang="th">We don't have much in the way of a collection. What accessories do we still need?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_19_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_2_0">
    <VALUE Lang="th">Oh... This is a waste of time since you're not tough enough for this. Oh well, thanks for your help.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_2_0_1">
