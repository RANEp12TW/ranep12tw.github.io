  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_1">
    <VALUE Lang="th">Composition of Research facilities</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_2">
    <VALUE Lang="th">Absolute Point and Sacred Stone</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_3">
    <VALUE Lang="th">Copy Spirit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_4">
    <VALUE Lang="th">List of Saint</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_5">
    <VALUE Lang="th">Guardian Plan</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_2_0_6">
    <VALUE Lang="th">Company History</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_3_0">
    <VALUE Lang="th">Sacred Financial Group Laboratory - Root Hole, Head Office</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Prison Laboratory - Sacred Private Prison</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Campus Laboratory - Sacred Gate, Mystic Peak, Phoenix, Leonine</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">America Laboratory -Alaska, Lio De Janeiro</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Eurasia Laboratory - Jakarta</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_3_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_4_0">
    <VALUE Lang="th">-Research about Absolute Point</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Like an atom is composed of a nucleus and its electrons, there is a nucleus in the center of a world. It is called the Absolute Point.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Each unique time space has its own Absolute Point, and Absolute point is responsible for protecting and separating current time space from other points in time and space.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It is not sure whether an Absolute Point has its own personality.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_4_0_1">
    <VALUE Lang="th">Next</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_5_0">
    <VALUE Lang="th">- Research on Sacred Stone</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It is used like an antenna around an Absolute stone.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">There can be several Sacred Stones around Absolute Stones.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Each stone might have different functions.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Stones from different time and space, however, won't cooperate and resonate with each other.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_5_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0">
    <VALUE Lang="th">This Terminal is for sharing information on saints.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">If you input any info from a document, you can search for a saint's information.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_1">
    <VALUE Lang="th">Input Piece of Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_2">
    <VALUE Lang="th">Input Piece of Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_3">
    <VALUE Lang="th">Input Piece of Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_4">
    <VALUE Lang="th">Input Piece of Document</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_7_0">
    <VALUE Lang="th">Verifying Input Data....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Please wait for a second.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_7_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_8_0">
    <VALUE Lang="th">Document has been verified successfully.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">You can open and read this document through the Information function.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_8_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_9_0">
    <VALUE Lang="th">- Copy Spirit</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Most creatures that are identified as enemies are the beings that are copied from the original body and spirit.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">In this document, we will call this creature a Copy Spirit.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_9_0_1">
    <VALUE Lang="th">Begin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_1_0">
    <VALUE Lang="th">This is the 30th floor security Terminal.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Password is required to enter 30th floor.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_1_0_1">
    <VALUE Lang="th">Search the password.</VALUE>
  </SENTENSE>
