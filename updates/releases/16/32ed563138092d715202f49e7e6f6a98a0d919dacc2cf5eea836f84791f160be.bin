    <VALUE Lang="th">Whip Slash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_9_0_3">
    <VALUE Lang="th">Swarming Locusts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_9_0_4">
    <VALUE Lang="th">Titan's Will</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_trick.ntk_9_0_5">
    <VALUE Lang="th">Back</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0">
    <VALUE Lang="th">Hey, there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Why do you look so worried?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_1">
    <VALUE Lang="th">Listen to Conversation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_2">
    <VALUE Lang="th">Bus Driver's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_3">
    <VALUE Lang="th">Construction Supervisor's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_4">
    <VALUE Lang="th">Give the Spare Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_5">
    <VALUE Lang="th">Physics Teacher's Call</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_10_0">
    <VALUE Lang="th">Excuse me, can you help me acquire the necessary spare parts from the Technical Teacher?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_10_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_11_0">
    <VALUE Lang="th">I cannot leave this area because these crazy workers might leave their work stations. I just don't trust them...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_12_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_13_0">
    <VALUE Lang="th">That's right! These are the spare parts I'm looking for. Thank you very much!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This can help our construction project for a while until something breaks down again. I'm keeping my fingers crossed that something like that won't happen...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_13_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_14_0">
    <VALUE Lang="th">What's wrong? Why is everyone like this? Everything looks weird around here. Am I in another dimension?</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_14_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_2_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_3_0">
    <VALUE Lang="th">The supervisor in charge of this construction project is hiding!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">This is bad! Our construction deadline is close!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_4_0">
    <VALUE Lang="th">It's troubling to know most of the people at the construction site are acting funny and most of the machinery broke down. There's going to be a delay in the construction work, and the site is just full of turmoil.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_4_0_1">
    <VALUE Lang="th">Ask Who It Is</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_5_0">
    <VALUE Lang="th">Oh, please get rid of those stubborn students! We can't get anything done with them around! We've got enough trouble as it is!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_5_0_1">
    <VALUE Lang="th">Construction Supervisor's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_6_0">
    <VALUE Lang="th">Student! Please listen to my request...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">In order to complete construction by the deadline, we must replace these crazy workers with efficiently working machinery. The problem is that the generator is broken. This just makes things more complicated!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_6_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_7_0">
    <VALUE Lang="th">My friend from the Sword Section told me that this is not the only area where strange things started to happen. Now imagine what would happen to our world if this chaos continues and spreads.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_7_0_1">
    <VALUE Lang="th">Physic's Teacher's Call</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_8_0">
    <VALUE Lang="th">I'm pretty nervous. I'm expecting news from the Physics Teacher at Sacred Gate College. Please find him! He said he would wait near the Sacred Gate Ring.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_9_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0">
    <VALUE Lang="th">This Terminal controls the access to the Art Center Building.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_1">
    <VALUE Lang="th">Confirm Activation</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_10">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_11">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_12">
    <VALUE Lang="th">Art Center Purification</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_13">
    <VALUE Lang="th">Confirm Purification</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_14">
    <VALUE Lang="th">Art Center 2nd Purification</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_15">
    <VALUE Lang="th">Confirm Purification</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_16">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_17">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_2">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_3">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_4">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_5">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_6">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_7">
    <VALUE Lang="th">Force Field Optimization</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_8">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_9">
    <VALUE Lang="th">Test the Terminal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_11_0">
    <VALUE Lang="th">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_12_0">
    <VALUE Lang="th">The primary target in this area are the Street Junkies. Please eliminate 22 Street Junkie targets.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_13_0">
    <VALUE Lang="th">.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_14_0">
    <VALUE Lang="th">The next target are the Sluggers. Please eliminate 24 Slugger targets.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_14_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_2_0">
    <VALUE Lang="th">The terminal is operating normally.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_2_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_3_0">
    <VALUE Lang="th">The Terminal's Force Field function is operating properly. You must gather 13 Spiritual Spheres in order to optimize the Force Field function of this Terminal.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_3_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_4_0">
    <VALUE Lang="th">Force Field Optimization is completed!</VALUE>
    <VALUE Lang="th">Please proceed to the next Terminal and complete the required optimization to learn the Force Field Effects.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_4_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_5_0">
    <VALUE Lang="th">There are evil spirits moving around inside the Art Center. The mobs who are possessed by these evil spirits bring undesirable effects to the environment.</VALUE>
    <VALUE Lang="th">Please do your best to eliminate them.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_5_0_1">
    <VALUE Lang="th">Next page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_6_0">
    <VALUE Lang="th">There are evil spirits moving around inside the Art Center. The mobs who are possessed by these evil spirits bring undesirable effects to the environment.</VALUE>
    <VALUE Lang="th">Please do your best to eliminate them.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_6_0_1">
    <VALUE Lang="th">Next page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_7_0">
    <VALUE Lang="th">The required amount for purification has been achieved. Thank you for your tremendous efforts.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_7_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0">
    <VALUE Lang="th">Hmmmm...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_1">
    <VALUE Lang="th">Talk to Busy Driver</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_2">
    <VALUE Lang="th">Bus Driver's Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_3">
    <VALUE Lang="th">Present the Spare Parts</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_4">
    <VALUE Lang="th">Bus Driver's 2nd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_5">
    <VALUE Lang="th">Ask if he needs help</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_6">
    <VALUE Lang="th">Tell him what happened</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_10_0">
    <VALUE Lang="th">The problem with the bus started a few days ago, and it's been getting worse since then. The bus won't even move at all now. It seems that the other buses in the area are having similar problems.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_10_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_11_0">
    <VALUE Lang="th">"Have you ever been to PH Hole? If so then you must have met those inferior Green Mask (Uncle Potato). Because of their threats I am afraid to drive the bus.</VALUE>
    <VALUE Lang="th">If you can please defeat them and scare them away."</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_11_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_12_0">
    <VALUE Lang="th">Thanks! Now I will be able to drive this bus around.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_12_0_1">
    <VALUE Lang="th">Return</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_2_0">
    <VALUE Lang="th">....</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_3_0">
    <VALUE Lang="th">You want to know more about the Bus? Hahaha!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Obviously, the Bus is used by students in order to move from one area to another. It is a more convenient means of transportation compared to walking or running around by foot.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_3_0_1">
    <VALUE Lang="th">Next Page</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_4_0">
    <VALUE Lang="th">Oops! I'm sorry! I didn't know you were there!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I've been very busy trying to find out what the hell is wrong with this wreck!</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_4_0_1">
    <VALUE Lang="th">Ask What He is Doing</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_5_0">
    <VALUE Lang="th">Oh! This bus is unoperational. I can't even get this thing to work. I really need to fix this bus so that the students can travel safely. It's dangerous to just walk around with all the chaos in the outskirts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">It's too bad there aren't any spare parts available to fix this thing.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_5_0_1">
    <VALUE Lang="th">Ask the Driver more about Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_6_0">
    <VALUE Lang="th">Based on my assessment of this wreckage, I can say that repairing this bus shouldn't be a major problem. The spare parts required to repair this vehicle, however, need to be acquired as soon as possible. I can't repair this bus unless I can get all the necessary spare parts.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_7_0">
    <VALUE Lang="th">Thank you for bringing the spare parts I need. I can finally start repairing this wreck. The students can use the bus to conveniently move from one area to another once I'm done fixing it.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_7_0_1">
    <VALUE Lang="th">Bus Driver's 2nd Request</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_8_0">
    <VALUE Lang="th">Please visit the Construction Supervisor located near the crossroads of the Phoenix Campus.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">I heard he has a favor to ask from me, but I can't visit him myself because of this bus problem.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_9_0">
    <VALUE Lang="th">...</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busteminal.ntk_1_0">
    <VALUE Lang="th">This is the Bus Stop.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
    <VALUE Lang="th">Once have your Bus Ticket ready, you can use the Bus Service to move to another area.</VALUE>
    <VALUE Lang="th">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busteminal.ntk_1_0_1">
    <VALUE Lang="th">Ride the Bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busteminal.ntk_1_0_2">
