    <VALUE Lang="cn">以前的话,是不需要像这些反覆的作业的…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_13_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_14_0">
    <VALUE Lang="cn">아직까지 등록을 못한 학생이 있었군!</VALUE>
