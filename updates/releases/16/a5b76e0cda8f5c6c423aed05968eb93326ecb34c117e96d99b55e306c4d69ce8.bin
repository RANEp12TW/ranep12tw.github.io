  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0">
    <VALUE Lang="cn">有些元素激发了Saint Power Plant No.2.。</VALUE>
    <VALUE Lang="cn">有许多怪物，但他们不是很强。请快消灭他们！</VALUE>
    <VALUE Lang="cn">歼灭越多，可拿到越好的奖励。 您可透过位在各个学院的Elemental Shaman NPC来进入活动地图。</VALUE>
    <VALUE Lang="cn">*</VALUE>
    <VALUE Lang="cn">---开放时间---</VALUE>
    <VALUE Lang="cn">[LV30〜130]</VALUE>
    <VALUE Lang="cn">1:00，5:00，9:00，13:00，17:00，21:00</VALUE>
    <VALUE Lang="cn">[Lv131〜195]</VALUE>
    <VALUE Lang="cn">1:40，5:45，9:45，13:45，17:45，21:45</VALUE>
    <VALUE Lang="cn">[Lv196以上] \</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0_1">
