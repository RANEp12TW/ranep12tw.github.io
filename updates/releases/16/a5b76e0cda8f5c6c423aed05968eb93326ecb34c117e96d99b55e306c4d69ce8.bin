  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_1_0_5">
    <VALUE Lang="cn">위치를 확인한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_1_0_7">
    <VALUE Lang="cn">치료를 부탁한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_1_0_8">
    <VALUE Lang="cn">시작 위치를 변경한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_1_0_9">
    <VALUE Lang="cn">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_1_1">
    <VALUE Lang="cn">이제 학생에게는 저의 도움이 필요하지 않을것 같아요</VALUE>
    <VALUE Lang="cn">다른 선생님들을 만나뵈어 주시겠어요?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_1_1_1">
    <VALUE Lang="cn">시작 위치를 변경한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_1_1_2">
    <VALUE Lang="cn">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_2_0">
    <VALUE Lang="cn">네트워크 연결상태 불량으로 인해 정보 검색은 할 수 없습니다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_2_0_1">
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_3_0">
    <VALUE Lang="cn">진심으로 환영합니다</VALUE>
    <VALUE Lang="cn">이번의 신입생들을 위해서는 특별히 선물을 준비했어요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_3_0_1">
