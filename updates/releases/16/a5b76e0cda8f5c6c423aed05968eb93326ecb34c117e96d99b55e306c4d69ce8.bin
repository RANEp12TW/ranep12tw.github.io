  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_1_0_2">
    <VALUE Lang="cn">交换部件.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_2_0">
    <VALUE Lang="cn">很好, 你找到他们了. 作为回报选择一件你想要的奖励. !</VALUE>
    <VALUE Lang="cn">------------------------------------------------</VALUE>
    <VALUE Lang="cn">1. Volt 50 + Knot 50 + Gear 50</VALUE>
    <VALUE Lang="cn">=&gt;从Rudolf Bike (permanent), Santa Bike (permanent), Santa Board (Permanent)中选择一样.</VALUE>
    <VALUE Lang="cn">2. Volt 50 + Knot 50 + Gear 50 + SSS (Super-Strong-Student) C</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_2_0_1">
