  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_47_0">
    <VALUE Lang="cn">这样以来应该会比之前还要好</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_47_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_48_0">
    <VALUE Lang="cn">如需要我制作的特殊武器,就把需要的材料收集过来吧</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_48_0_1">
