  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_8_0">
    <VALUE Lang="cn">噢！您还没注册？请将Egresses Application Form交给位在Administration Office的 Student Director，可完成注册手续就。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_8_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
