  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0">
    <VALUE Lang="cn">嘿！哈喽！</VALUE>
    <VALUE Lang="cn">您为何这么紧张？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_1">
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_2">
    <VALUE Lang="cn">Bus Driver的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_3">
    <VALUE Lang="cn">Construction Supervisor的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_4">
    <VALUE Lang="cn">传达零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_5">
    <VALUE Lang="cn">Physic Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_10_0">
    <VALUE Lang="cn">不好意思, 可以帮我从Technical Teacher那边拿发电机的零件来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_10_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_11_0">
    <VALUE Lang="cn">我因为那群疯狂的劳工而动弹不得,只怕我一离开他们就会将我已做好的工程都被搞砸了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_11_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_12_0">
    <VALUE Lang="cn">.....7</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_13_0">
    <VALUE Lang="cn">没错! 这就是我之前找的零件</VALUE>
    <VALUE Lang="cn">真是多谢</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_13_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_14_0">
    <VALUE Lang="cn">虽然没有让它不再故障的办法, 不过可以作业好一阵子了.</VALUE>
    <VALUE Lang="cn">不过这到底是怎么搞的, 人们会变成那模样</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_14_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_2_0">
    <VALUE Lang="cn">....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_3_0">
    <VALUE Lang="cn">本来在旁边管理工程, 现在却躲的远远的.</VALUE>
    <VALUE Lang="cn">大事不妙~ 工程期限就快到了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_4_0">
    <VALUE Lang="cn">是该做事没错, 不过人们变的怪怪的, 机器也故障, 实在麻烦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_4_0_1">
    <VALUE Lang="cn">请问是谁？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_5_0">
    <VALUE Lang="cn">喔,把这种学生送走吧</VALUE>
    <VALUE Lang="cn">没时间没办法呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_5_0_1">
    <VALUE Lang="cn">Construction Supervisor的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_6_0">
    <VALUE Lang="cn">听听我的请求</VALUE>
    <VALUE Lang="cn">为了要在期限内完工,必须要使用机器人来代替疯掉的工人们,但是现在竟然连发电机都坏掉了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_6_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_7_0">
    <VALUE Lang="cn">上次听剑道部一个学生朋友说, 不是只有这里这样子..</VALUE>
    <VALUE Lang="cn">唉... 世界将会变成什么样子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_7_0_1">
    <VALUE Lang="cn">Physics Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_8_0">
    <VALUE Lang="cn">阿 差点吓死</VALUE>
    <VALUE Lang="cn">刚刚Sacred Gate College的Physics Teacher那边有消息传来</VALUE>
    <VALUE Lang="cn">他说会去Sacred Gate Ring等您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_9_0">
    <VALUE Lang="cn">.....6</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0">
    <VALUE Lang="cn">询问什么是"端午节"。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_1">
    <VALUE Lang="cn">是的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_2">
    <VALUE Lang="cn">领取经验奖励</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_3">
    <VALUE Lang="cn">交换 Exorcist Ring(15D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_2_0">
    <VALUE Lang="cn">我相信您！您做得到的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0">
    <VALUE Lang="cn">你好~!在这里看起来像个外地来的…</VALUE>
    <VALUE Lang="cn">来这里…因为那些家伙让我无法逃离这地方。</VALUE>
    <VALUE Lang="cn">可以帮我一个忙吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_1">
    <VALUE Lang="cn">进行交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_2">
    <VALUE Lang="cn">Miscellaneos Savior</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_3">
    <VALUE Lang="cn">斯德哥尔摩症候群</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_4">
    <VALUE Lang="cn">收集Terrorist的补给品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_5">
    <VALUE Lang="cn">Heavy Destroyer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_6">
    <VALUE Lang="cn">通行证收集狂</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_7">
    <VALUE Lang="cn">兑换礼票</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_8">
    <VALUE Lang="cn">通行证收集狂</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_2_0">
    <VALUE Lang="cn">咕噜咕噜....唉攸我的肚子。躲在这里好几天都没吃东西，快饿扁了..</VALUE>
    <VALUE Lang="cn">你身上有吃的吗? 帮我找到吃的就送给你我的收藏品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_3_0">
    <VALUE Lang="cn">这几天困在这里发现一件奇怪的事。一开始反抗的工人慢慢和侦搜部队靠拢开始协助他们。</VALUE>
    <VALUE Lang="cn">请尽快阻止他们不要让更多人​​被同化。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_4_0">
    <VALUE Lang="cn">听说侦搜部队每个人都有一张通行证Certificate。曾经看到他们在领取补给品时拿出通行证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_5_0">
    <VALUE Lang="cn">有一些工人看起来是负责重装备技术。想到如果他们把零件组装开始动乱...想到就觉得很可怕。</VALUE>
    <VALUE Lang="cn">你也来一起帮忙说不定可以扭转情势</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_6_0">
    <VALUE Lang="cn">所以。这里是Terrorist Area！</VALUE>
    <VALUE Lang="cn">您的反应真快！怎么会知道我想要的是什么？</VALUE>
    <VALUE Lang="cn">哈哈！现在身上没有这个东西，不过只要搜集兑换券交给我，就可以给你我的收藏品。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert_chainsaw.ntk_1_0">
    <VALUE Lang="cn">等...一下!!我跟侦搜部队一点关系也没有!呼...我也看他们很不顺眼，有任何需要尽管跟我说</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert_chainsaw.ntk_1_0_1">
    <VALUE Lang="cn">进行交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0">
    <VALUE Lang="cn">……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_1">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_10">
    <VALUE Lang="cn">取得确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_2">
    <VALUE Lang="cn">询问她是谁？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_3">
    <VALUE Lang="cn">询问Garansanoa的同伴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_4">
    <VALUE Lang="cn">告诉他，您会阻止Lucian。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_5">
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_6">
    <VALUE Lang="cn">取得确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_7">
    <VALUE Lang="cn">净化 Basement</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_8">
    <VALUE Lang="cn">取得确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_9">
    <VALUE Lang="cn">我想要帮Priest的忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_10_0">
    <VALUE Lang="cn">这不是件容易的事情。他们比High Elders还要强大，请您务必要小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_10_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_11_0">
    <VALUE Lang="cn">好姐妹…..请别那么紧绷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_11_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_2_0">
    <VALUE Lang="cn">我是服侍Daian 的Priest。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_2_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_3_0">
    <VALUE Lang="cn">一个叫做Lucian的人，试图要伤害 Garansanoa的朋友Liz，甚至夺取Adoniechus绝对起点。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_3_0_1">
    <VALUE Lang="cn">询问还有其他人吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_4_0">
    <VALUE Lang="cn">这个嘛…. 有个从Roo Tribe来的族人，叫作Gainun。跟我们很不一样，您必须加强警戒，小心提防。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_4_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_5_0">
    <VALUE Lang="cn">这是和您无关的事情。不过，如果您帮我的话，我可以考虑接受您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_5_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_6_0">
    <VALUE Lang="cn">请对付 Hillo。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_7_0">
    <VALUE Lang="cn">不错唷。 你要再试试吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_7_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_8_0">
    <VALUE Lang="cn">请对付Cyclop。它的力量很强，请小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_8_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_9_0">
    <VALUE Lang="cn">很好。请继续净化失去理智的人。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_9_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_battlefield_helper.ntk_1_0">
    <VALUE Lang="cn">我可以帮你什么忙吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_battlefield_helper.ntk_1_0_1">
    <VALUE Lang="cn">出售道具</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0">
    <VALUE Lang="cn">这里是公车站。只要您拥有Bus Ticket ，就可以使用公车服务，畅游各地区唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_1">
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_10">
    <VALUE Lang="cn">传送文件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_3">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_4">
    <VALUE Lang="cn">寄出Skill Document。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_5">
    <VALUE Lang="cn">找出被偷走的Dry Ice。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_6">
    <VALUE Lang="cn">传递 Emergency Action Guide。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_7">
    <VALUE Lang="cn">调查死亡的Police。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_8">
    <VALUE Lang="cn">法术防御机制动作</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_9">
    <VALUE Lang="cn">法术防御机制动作</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_2_0">
    <VALUE Lang="cn">已完成文件的扫描。要发送吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_2_0_1">
    <VALUE Lang="cn">寄出Skill Document。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_3_0">
    <VALUE Lang="cn">处理中……..</VALUE>
    <VALUE Lang="cn">文件已传送完成。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_3_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_4_0">
    <VALUE Lang="cn">Dry ice是储存冰淇淋最重要的东西。但被保管在Warehouse的Dry ice竟然被偷走了。请把它找出来。谢谢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_5_0">
    <VALUE Lang="cn">还是有些地方尚未接收到紧急措施的相关指令。请至Book Store附近领取导览手册， 并发给他们吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_6_0">
    <VALUE Lang="cn">您应该要取得安全监控录像，并报告在监狱里死亡的警察事件。Prisoner已经将该录影带送到某处了。 请从他身上取回录影带。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_7_0">
    <VALUE Lang="cn">许多学生受了法术之伤，特别是 Root Hole的学生伤得最严重。请您从Elemental Sorcerer那儿取回法术技能的文件，并制作防御装置。这是为了要阻挡来自法术的伤害持续扩大。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_8_0">
    <VALUE Lang="cn">完成</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0">
    <VALUE Lang="cn">阿！您是学生吗？</VALUE>
