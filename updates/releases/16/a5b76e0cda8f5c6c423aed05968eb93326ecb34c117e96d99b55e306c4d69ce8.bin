    <VALUE Lang="cn">虽然在警察局有听到一些话不过因为一下恍神所以想不起来</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
