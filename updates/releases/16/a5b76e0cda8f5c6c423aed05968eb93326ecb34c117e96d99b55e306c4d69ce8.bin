  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_10_0_3">
    <VALUE Lang="cn">'옆차기' 를 얻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_10_0_4">
