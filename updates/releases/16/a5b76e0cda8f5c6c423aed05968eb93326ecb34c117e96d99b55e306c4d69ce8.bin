    <VALUE Lang="cn">신입 등록 기념용 빵 지급을 신청한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_1_0_2">
    <VALUE Lang="cn">신입 등록 기념용 빵 지급을 신청한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_main_0.ntk_1_0_3">
