  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0">
    <VALUE Lang="cn">어서 와라</VALUE>
    <VALUE Lang="cn">뭘 도와줄까?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_1">
    <VALUE Lang="cn">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_2">
    <VALUE Lang="cn">검도부에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_3">
    <VALUE Lang="cn">수행 방법에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_4">
    <VALUE Lang="cn">전투 방법에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_1">
    <VALUE Lang="cn">다른 부원들은 다 나가!</VALUE>
    <VALUE Lang="cn">정신 사납다.</VALUE>
    <VALUE Lang="cn">아니면 뭐냐,</VALUE>
    <VALUE Lang="cn">볼 일이라도 있는거냐?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_1_1">
    <VALUE Lang="cn">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_0">
    <VALUE Lang="cn">우선 기본적인 것들을 다시 한번 알려 줄테니 잘 들어.</VALUE>
    <VALUE Lang="cn">너희들에겐 레벨업을 하는 순간 3개의 '포인트'가 할당된다.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_0_1">
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_1">
    <VALUE Lang="cn">호오? 연습을 꽤 했나 보군!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_1_1">
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_11_0">
    <VALUE Lang="cn">그리고 그 포인트들을 분배하는 방법에 따라 너희들의 '성장 방향'이 달라지게 되지.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_11_0_1">
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_12_0">
    <VALUE Lang="cn">만약 힘과 체력과 민첩에 분배한다면 검으로 보다 빠른 공격을 할 수 있는 '속공형'이 될테고,</VALUE>
    <VALUE Lang="cn">힘에만 집중하다면 검이 아니라 도를 사용하며 파괴력 높은 공격을하는 '필살형'이 될거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_12_0_1">
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_13_0">
    <VALUE Lang="cn">.....5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_0">
    <VALUE Lang="cn">선두에 서서 동료들을 지키는게 너희들이 해야 할 일이야.</VALUE>
    <VALUE Lang="cn">힘이 있으면 당연히 그래야지!</VALUE>
    <VALUE Lang="cn">주의해야 할 점은 검도부원으로서 성장한 너희들이 '스태미너'를 상대적으로 많이 소비한다는 거야</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_0_1">
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_1">
    <VALUE Lang="cn">이거 정말 대단하군!</VALUE>
    <VALUE Lang="cn">너 언제 그렇게 강해진거냐?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_1_1">
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_2_0">
    <VALUE Lang="cn">어느쪽이 될 지는 선택하기 나름이겠지만 ,</VALUE>
    <VALUE Lang="cn">누군가를 보호하기 위할 때에만 상대를 해하는 행동이 용서된다는 걸 명심해.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0">
    <VALUE Lang="cn">어느쪽이 될 지는 선택하기 나름이겠지만 ,</VALUE>
    <VALUE Lang="cn">누군가를 보호하기 위할 때에만 상대를 해하는 행동이 용서된다는 걸 명심해.</VALUE>
