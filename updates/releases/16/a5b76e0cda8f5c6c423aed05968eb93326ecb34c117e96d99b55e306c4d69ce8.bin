<?xml version="1.0" encoding="utf-8"?>
<TEXT>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0">
    <VALUE Lang="cn">Pierrot过渡忙于RAN学生的活动，结果竟然变身为Joker了。若不赶紧抓到Joker的话，校园秩序会大乱的。请将Joker一开始要给学生们准备的礼物带过来唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_1">
    <VALUE Lang="cn">我可以在哪儿找到Joker？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_2">
    <VALUE Lang="cn">我可以在哪里拿到副本的入场卷呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_3">
    <VALUE Lang="cn">取得礼盒的位置？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0">
    <VALUE Lang="cn">Joker 正躲在封闭的副本里。那边有许多危险的陷阱，您要找到他是很不容易的。记得，要有入场卷，才能进去唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0_2">
    <VALUE Lang="cn">取得入场卷的方法？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0">
    <VALUE Lang="cn">Ran的怪物都被 Joker的邪恶心灵给污染了。它们现在会掉落Matryoshka Boxes！</VALUE>
    <VALUE Lang="cn">没有人知道开启礼盒之后，会拿到什么物品。但您一定可以找到被Joker给藏起来的入场卷。请努力获得更多礼盒，并开启它们吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0_2">
    <VALUE Lang="cn">取得礼物的方法？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0">
    <VALUE Lang="cn">追寻副本内怪物的脚步，就可找到Boss的踪迹。消灭怪物，就有机会获得礼盒唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0_2">
    <VALUE Lang="cn">请兑换。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0">
    <VALUE Lang="cn">为了取得礼物，您需要准备以下内容：</VALUE>
    <VALUE Lang="cn">--</VALUE>
    <VALUE Lang="cn">Pierrot Badge 100ea + Joker Badge 80ea</VALUE>
    <VALUE Lang="cn">= Jester King's Hat</VALUE>
    <VALUE Lang="cn">Pierrot Badge 150ea + Joker Badge 100ea +</VALUE>
    <VALUE Lang="cn">Joker Card 100ea</VALUE>
    <VALUE Lang="cn">= Joker Look Box (7D)</VALUE>
    <VALUE Lang="cn">Pierrot Badge 200ea + Joker Badge 150ea +</VALUE>
    <VALUE Lang="cn">Joker Card 150ea</VALUE>
    <VALUE Lang="cn">= Jo</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_1">
    <VALUE Lang="cn">我要Jester King's Hat！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_2">
    <VALUE Lang="cn">我要Joker Look Box！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_3">
    <VALUE Lang="cn">我要Joker Bike！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_event_club.ntk_1_0">
    <VALUE Lang="cn">我是Super Robot，专门卖ClubWar重要的补给品。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_event_club.ntk_1_0_1">
    <VALUE Lang="cn">兑换糖果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_0">
    <VALUE Lang="cn">呜呜！呜呜！汪汪！汪汪！呜呜！呜呜！汪汪！汪汪！</VALUE>
    <VALUE Lang="cn">呜呜！呜呜！汪汪！汪汪！呜呜！呜呜！汪汪！汪汪！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_1">
    <VALUE Lang="cn">呜呜！呜呜！汪汪！汪汪！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_1_1">
    <VALUE Lang="cn">我们好像应该要哄他入睡才能通过。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_1_1_2">
    <VALUE Lang="cn">喂吃安眠药</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th01.ntk_2_0">
    <VALUE Lang="cn">Zzz...Zzz...Zzz....Zzz</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th02.ntk_1_0">
    <VALUE Lang="cn">哈哈哈！欢迎！我有一些魔法物品哟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th02.ntk_1_0_1">
    <VALUE Lang="cn">贩卖物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th03.ntk_1_0">
    <VALUE Lang="cn">Ran World正举办Ran的4周年庆典。请给我们一些掌声与祝贺吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_gs4th03.ntk_1_0_1">
    <VALUE Lang="cn">领取4周年礼盒</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_0">
    <VALUE Lang="cn">不想和童话故事中的白马王子见面吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_1">
    <VALUE Lang="cn">您有搭过吗？这真的很棒！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_2">
    <VALUE Lang="cn">他们只爱正妹~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_3">
    <VALUE Lang="cn">哔哔哔~！吓到了吗？哦…您没有被吓到啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_1_3_1">
    <VALUE Lang="cn">不给糖就捣蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_2_0">
    <VALUE Lang="cn">我还会再给您一颗Candy，请明天再过来一趟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween01.ntk_2_0_1">
    <VALUE Lang="cn">询问除了Candy之外，还有其他东西吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_0">
    <VALUE Lang="cn">或许他才是Halloween day真正的主角。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_1">
    <VALUE Lang="cn">这个很容易着火。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_2">
    <VALUE Lang="cn">他们的床非常地黑暗，即使是天亮，也不会有人知道。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_3">
    <VALUE Lang="cn">哔哔哔~！吓到了吗？哦…您没有被吓到啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_1_3_1">
    <VALUE Lang="cn">不给糖就捣蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_2_0">
    <VALUE Lang="cn">我还会再给您一颗Candy，请明天再过来一趟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween02.ntk_2_0_1">
    <VALUE Lang="cn">询问除了Candy之外，还有其他东西吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_0">
    <VALUE Lang="cn">我无法理解，为何那个丑八怪人缘那么好。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_1">
    <VALUE Lang="cn">每当家里有客人来时，他就会变得很忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_2">
    <VALUE Lang="cn">他们总是和蚊子进行战斗。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_3">
    <VALUE Lang="cn">哔哔哔~！吓到了吗？哦…您没有被吓到啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_1_3_1">
    <VALUE Lang="cn">不给糖就捣蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_2_0">
    <VALUE Lang="cn">我还会再给您一颗Candy，请明天再过来一趟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween03.ntk_2_0_1">
    <VALUE Lang="cn">询问除了Candy之外，还有其他东西吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_0">
    <VALUE Lang="cn">您知道 π 是什么意思吗？据我所知，好像是 3，14….什么的….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_1">
    <VALUE Lang="cn">看到他们的人头落地，我的心情好难受。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_2">
    <VALUE Lang="cn">他们出生于Romania。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_3">
    <VALUE Lang="cn">哔哔哔~！吓到了吗？哦…您没有被吓到啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_1_3_1">
    <VALUE Lang="cn">不给糖就捣蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_2_0">
    <VALUE Lang="cn">我还会再给您一颗Candy，请明天再过来一趟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween04.ntk_2_0_1">
    <VALUE Lang="cn">询问除了Candy之外，还有其他东西吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_0">
    <VALUE Lang="cn">今天我的头特别痒。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_1">
    <VALUE Lang="cn">听说他很擅长倒立唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_2">
    <VALUE Lang="cn">只有在深夜时，才能看见他们的存在。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_3">
    <VALUE Lang="cn">哔哔哔~！吓到了吗？哦…您没有被吓到啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_1_3_1">
    <VALUE Lang="cn">不给糖就捣蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_2_0">
    <VALUE Lang="cn">我还会再给您一颗Candy，请明天再过来一趟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween05.ntk_2_0_1">
    <VALUE Lang="cn">询问除了Candy之外，还有其他东西吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_1_0">
    <VALUE Lang="cn">这是Pumpkin box，长得就像我的头！由于非常珍贵，所以一天只能领取一次唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_1_1">
    <VALUE Lang="cn">这是Pumpkin box，长得就像我的头！由于非常珍贵，所以一天只能领取一次唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_1_1_1">
    <VALUE Lang="cn">领取Pumpkin box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_2_0">
    <VALUE Lang="cn">每周六和日我都会提供Pumpkin box，请您要记得来找我唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween07.ntk_1_0">
    <VALUE Lang="cn">这是Pumpkin box，长得就像我的头！由于非常珍贵，所以一天只能领取一次唷。</VALUE>
