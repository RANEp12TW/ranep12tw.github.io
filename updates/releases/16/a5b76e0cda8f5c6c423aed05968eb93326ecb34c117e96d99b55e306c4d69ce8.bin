  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_29_0">
    <VALUE Lang="cn">达到特定等级，就能拿到Spiritual Spheres。您可自由使用Spiritual Spheres来选择可学的技能唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_29_0_3">
