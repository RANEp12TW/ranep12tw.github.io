  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0">
    <VALUE Lang="cn">嘿！哈喽！</VALUE>
    <VALUE Lang="cn">您在担心什么？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_1">
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_2">
    <VALUE Lang="cn">Bus Driver的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_3">
    <VALUE Lang="cn">Construction Supervisor的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_4">
    <VALUE Lang="cn">传达零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_1_0_5">
    <VALUE Lang="cn">Physics Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_10_0">
    <VALUE Lang="cn">不好意思, 可以帮我从Technical Teacher那边拿发电机的零件来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_10_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_11_0">
    <VALUE Lang="cn">我因为那群疯狂的劳工而动弹不得,只怕我一离开他们就会将我已做好的工程都被搞砸了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_11_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_12_0">
    <VALUE Lang="cn">....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_13_0">
    <VALUE Lang="cn">没错! 这就是我之前找的零件</VALUE>
    <VALUE Lang="cn">真是多谢</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_13_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_14_0">
    <VALUE Lang="cn">虽然没有让它不再故障的办法, 不过可以作业好一阵子了.</VALUE>
    <VALUE Lang="cn">不过这到底是怎么搞的, 人们会变成那模样?</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_14_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_2_0">
    <VALUE Lang="cn">... …..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_3_0">
    <VALUE Lang="cn">本来在旁边管理工程现在却躲的远远的</VALUE>
    <VALUE Lang="cn">大事不妙~ 工程期限就快到了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_4_0">
    <VALUE Lang="cn">是该做事没错, 不过人们变的怪怪的, 机器也故障, 实在麻烦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_4_0_1">
    <VALUE Lang="cn">询问是谁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_5_0">
    <VALUE Lang="cn">喔, 把这种学生送走吧</VALUE>
    <VALUE Lang="cn">没时间没办法呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_5_0_1">
    <VALUE Lang="cn">Construction Supervisor的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_6_0">
    <VALUE Lang="cn">听听我的请求</VALUE>
    <VALUE Lang="cn">为了要在期限内完工,必须要使用机器人来代替疯掉的工人们,但是现在竟然连发电机都坏掉了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_6_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_7_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">上次听剑道部一个学生朋友说, 不是只有这里这样子..</VALUE>
    <VALUE Lang="cn">唉... 世界将会变成什么样子..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_7_0_1">
    <VALUE Lang="cn">Physic's Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_8_0">
    <VALUE Lang="cn">阿 差点吓死</VALUE>
    <VALUE Lang="cn">刚刚Sacred Gate College的Physics Teacher那边有消息传来</VALUE>
    <VALUE Lang="cn">他说会去Sacred Gate Ring等您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_9_0">
    <VALUE Lang="cn">....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
