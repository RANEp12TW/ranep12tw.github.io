  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_1_2_1">
    <VALUE Lang="cn">倾听故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_1_2_3">
    <VALUE Lang="cn">宣布结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_1_2_4">
    <VALUE Lang="cn">宣布结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_1_3">
    <VALUE Lang="cn">您好，我是 Ami。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_1_3_1">
    <VALUE Lang="cn">倾听故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_1_3_2">
    <VALUE Lang="cn">帮助她</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_1_3_3">
    <VALUE Lang="cn">宣布结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_2_0">
    <VALUE Lang="cn">市民需要您的协助。</VALUE>
    <VALUE Lang="cn">我帮不上忙，但您绝对可以胜任的！</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_3_0">
    <VALUE Lang="cn">我早就跟您说过，有位好市民需要您的帮忙！相信您可以的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_3_0_1">
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_3_0_5">
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_4_0">
    <VALUE Lang="cn">谢谢您。</VALUE>
    <VALUE Lang="cn">这里有许多黑道分子参与绑架案件。 您要小心做准备，否则会遭殃的。请保重！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_5_0">
    <VALUE Lang="cn">真的吗？我有点担心。</VALUE>
    <VALUE Lang="cn">见到了你，我就放心了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_1_0">
    <VALUE Lang="cn">您好！</VALUE>
    <VALUE Lang="cn">我是Ami。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_1_0_1">
    <VALUE Lang="cn">聆听故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_1_0_2">
    <VALUE Lang="cn">接受她的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_1_0_3">
    <VALUE Lang="cn">兑换Extra S card 入场卡</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_2_0">
    <VALUE Lang="cn">市民需要您的协助。</VALUE>
    <VALUE Lang="cn">我帮不上忙，但您绝对可以胜任的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_0">
    <VALUE Lang="cn">我之前有告诉过您，有一位善良的市民区要您的拯救。这次，我相信您可以的！请帮她。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_0_1">
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_0_5">
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_0_6">
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_1">
    <VALUE Lang="cn">您需要Entry Card才能进入Extra Stage S级。</VALUE>
    <VALUE Lang="cn">可惜的是，您没有这张认证卡。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_4_0">
    <VALUE Lang="cn">谢谢..</VALUE>
    <VALUE Lang="cn">请保重</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_5_0">
    <VALUE Lang="cn">真的吗？</VALUE>
    <VALUE Lang="cn">我一直在担心.....现在终于能心安了。非常感激您的帮忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_0">
    <VALUE Lang="cn">您真的…. 可以帮我吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_0_3">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_0_4">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_0_5">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_0_6">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_0_7">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_0_8">
    <VALUE Lang="cn">询问发生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_1">
    <VALUE Lang="cn">您真的…. 可以帮我吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_1_3">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_1_4">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_1_5">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_1_6">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_1_7">
    <VALUE Lang="cn">询问发生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_2">
    <VALUE Lang="cn">您真的…. 可以帮我吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_2_3">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_2_4">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_2_5">
    <VALUE Lang="cn">询问发生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_3">
    <VALUE Lang="cn">您真的…. 可以帮我吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_3_3">
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_3_4">
    <VALUE Lang="cn">询问发生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_2_0">
    <VALUE Lang="cn">我不知道为何我会在这里….. 我只知道，当我醒来时，我就看到一堆的可疑男子在旁边绕。 站在这里好辛苦！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_5_0">
    <VALUE Lang="cn">谢谢您。我原本很绝望的，但现在，我……. 非常地感谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_0">
    <VALUE Lang="cn">您有收集到我的50个Gold Coin吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_0_1">
    <VALUE Lang="cn">是的，当然！来，50 Gold Coin在这儿。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_1">
    <VALUE Lang="cn">您有收集到我的50个Gold Coin吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_1_1">
    <VALUE Lang="cn">50？噢！还没。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_2">
    <VALUE Lang="cn">邪恶歹徒把我的Gold Coin给抢走了......哦，我的天啊！......我该怎么办？......（呜呜）......</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_2_1">
    <VALUE Lang="cn">怎么了？别哭了！你想和我谈谈吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_10_0">
    <VALUE Lang="cn">嘿！你想收集这些Gold Coin然后再得到一次的Lucky Green Hat吗？如果你有兴趣的话，请再继续收集Gold Coin，并把它交给我。我手中的帽子还有剩很多唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_2_0">
    <VALUE Lang="cn">（呜呜）......有一天，某个怪物恶棍跑来抢走了我的 Gold Coin。</VALUE>
    <VALUE Lang="cn">这些 Gold Coin是我的最宝贵的财富…..</VALUE>
    <VALUE Lang="cn">有好心人愿意帮助我吗？</VALUE>
    <VALUE Lang="cn">嗯，现在再看看您，感觉您长的挺壮硕的…..</VALUE>
    <VALUE Lang="cn">可以请您帮帮我吗？可以吗？</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_2_0_1">
    <VALUE Lang="cn">OK! 我会帮您的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_2_0_2">
    <VALUE Lang="cn">不！抱歉！（回到最初）</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_3_0">
    <VALUE Lang="cn">太好了！我就知道你会帮我！请您从怪物那边夺回我的50 Gold Coin！如果您能为我做到的话，我会给您一个很好的奖励。</VALUE>
    <VALUE Lang="cn">要当心！那些怪物非常强悍… 小心安全！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_3_0_1">
    <VALUE Lang="cn">回到最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_4_0">
    <VALUE Lang="cn">请快点！在那些混蛋拿着我的金币消失之前，请快点解决它们啊！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_4_0_1">
    <VALUE Lang="cn">回到最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_5_0">
    <VALUE Lang="cn">啊哈啊哈啊哈〜终于这些闪亮亮的Gold Coin再度回到我身边了...... （嘿嘿）......简单嘛....（哈哈）</VALUE>
    <VALUE Lang="cn">谢谢您，我现在已经得到了强大力量了......（呼呼）</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_5_0_1">
    <VALUE Lang="cn">您在说啥？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_6_0">
    <VALUE Lang="cn">你还是不懂，对吧？真是个小傻瓜......（呵呵）</VALUE>
    <VALUE Lang="cn">事实上，那些您已经“惩罚”过的怪物，都是Gold Coin的真正持有者。相信我的话，并找它们夺取金币吧！.....（哈哈）......这些金币其实给了那些怪物不少的魔法力。</VALUE>
    <VALUE Lang="cn">我一直嫉妒它们，但它们太强我无法打败，一直无法进行任何事情。</VALUE>
    <VALUE Lang="cn">这个计划已经很久了，现在似乎可以用捉弄您的方式来实现我的梦想。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_6_0_1">
    <VALUE Lang="cn">啧啧….所以......你骗了我！你坏坏！</VALUE>
    <VALUE Lang="cn">去把Gold Coin给拿回来！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_7_0">
    <VALUE Lang="cn">（颗颗）......噢，你现在明白了吗？......但是现在您能做些什么呢？</VALUE>
    <VALUE Lang="cn">我不打算把这些珍贵的宝物还给你！ （嘿嘿）...</VALUE>
    <VALUE Lang="cn">不过，我以男人的尊严向你保证！</VALUE>
    <VALUE Lang="cn">我会给你相对于Gold Coin的奖励的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_7_0_1">
    <VALUE Lang="cn">奖励…？那是啥？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_8_0">
    <VALUE Lang="cn">好了，现在这个时刻，怪物正疯狂似的到处找您，…..</VALUE>
    <VALUE Lang="cn">您深陷危险中唷…...（啧啧）</VALUE>
    <VALUE Lang="cn">我的奖励品将能帮助您逃脱怪物们的追杀...（嘿嘿）</VALUE>
    <VALUE Lang="cn">怪物随时都会出现！我不想被牵扯到，所以快点决定是否要跟我领取奖励，还是要离开这个地方！请快点。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_8_0_1">
    <VALUE Lang="cn">领取奖励</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_8_0_2">
    <VALUE Lang="cn">不收奖励</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_9_0">
    <VALUE Lang="cn">噢…..拜托...我很抱歉欺骗了你......！现在，在怪物闯进这个地方之前，我们需要这个！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_9_0_1">
    <VALUE Lang="cn">虽然生气，但还是接受礼物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_suryun.ntk_1_0">
    <VALUE Lang="cn">哈喽……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_suryun.ntk_1_0_1">
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0">
    <VALUE Lang="cn">这个是竞技场.</VALUE>
    <VALUE Lang="cn">如果要进入,快点购买</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_1">
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_2">
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_3">
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_4">
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_5">
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_6">
    <VALUE Lang="cn">购买公车票</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0">
    <VALUE Lang="cn">我来这里是负责执行自圣财团指派的任务。</VALUE>
    <VALUE Lang="cn">有什么想要知道的吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_1">
    <VALUE Lang="cn">歼灭Life Weapon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_2">
    <VALUE Lang="cn">收集薄纸标本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_3">
    <VALUE Lang="cn">交付薄纸标本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_4">
    <VALUE Lang="cn">确认撤退路线</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_2_0">
    <VALUE Lang="cn">Ryuin提到的事情等我的任务完成再跟他回报也可以。可以先帮我吗？</VALUE>
    <VALUE Lang="cn">雖然是機密任務.....不過一個人要完成還是有困難....聽說敵軍有變種生物已經確認他們確實存在，</VALUE>
    <VALUE Lang="cn">可以帮忙消灭他们吗？拜托你了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_3_0">
    <VALUE Lang="cn">Saint Foundation预测的没错！我自己前往一定会有危险。可以拜托你一件事吗？</VALUE>
    <VALUE Lang="cn">帮忙消灭Biological weapons，然后把搜集到的Tissue samples交给我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_4_0">
    <VALUE Lang="cn">还是你最值得信任，谢谢你！等这里的情况处理完一定会给你奖励！</VALUE>
    <VALUE Lang="cn">如果你有缺什么道具可以去找这里的Physics Teacher。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_5_0">
    <VALUE Lang="cn">真的很不好意思，还有一件事需要请你帮忙。</VALUE>
    <VALUE Lang="cn">我需要回去圣财团回报，不过因为路上有太多敌人回不去。</VALUE>
    <VALUE Lang="cn">可不可以请你帮忙确认撤退路线。这次真的是最后一次拜托你了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0">
    <VALUE Lang="cn">我专门提供药物给学生。有什么需要我帮忙的，请尽管说，不用客气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_1">
    <VALUE Lang="cn">物品交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_2">
    <VALUE Lang="cn">设为起点位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_3">
    <VALUE Lang="cn">取得 First-aid kit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_4">
    <VALUE Lang="cn">转交 First-aid kit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_2_0">
    <VALUE Lang="cn">我在来的路上，一堆怪物突然跑出来，并且抢走了大部分的First-aid box 。现在我想要帮助学生都很困难，现在可以麻烦您帮我把这些‘急救箱’夺回来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_3_0">
    <VALUE Lang="cn">很谢谢您。请把更多的First-aid box 交给我好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0">
    <VALUE Lang="cn">欢迎来到 Ground Zero。这里比您想象中的还要艰辛困难。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_1">
    <VALUE Lang="cn">和Student Director进行对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_10">
    <VALUE Lang="cn">最后回报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_11">
    <VALUE Lang="cn">达成等级 225</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_12">
    <VALUE Lang="cn">达成等级 230</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_13">
    <VALUE Lang="cn">达成等级 235</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_14">
    <VALUE Lang="cn">达成等级 240</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_15">
    <VALUE Lang="cn">回报达成等级 225</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_16">
    <VALUE Lang="cn">回报达成等级 230</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_17">
    <VALUE Lang="cn">回报达成等级 235</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_18">
    <VALUE Lang="cn">回报达成等级 240</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_19">
    <VALUE Lang="cn">挥之不去的过去</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_2">
    <VALUE Lang="cn">歼灭 Scouter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_20">
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_21">
    <VALUE Lang="cn">最后攻击的召唤</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_3">
    <VALUE Lang="cn">歼灭 Elite Scouter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_4">
    <VALUE Lang="cn">取得 Scouter 徽章</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_5">
    <VALUE Lang="cn">转交 Scouter 徽章</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_6">
    <VALUE Lang="cn">取得侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_7">
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_8">
    <VALUE Lang="cn">转达 攻击指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_9">
    <VALUE Lang="cn">歼灭 Commander</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_10_0">
    <VALUE Lang="cn">哎….终于到了要一决胜负的时候了。对方可是首领，绝不可大意。虽然非赢不可，但安全是最重要的！祝您好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_10_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_11_0">
    <VALUE Lang="cn">您真的很厉害！相信无论是多么危险的情况，我们一定可以大获全胜的。我们永远会记得您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_11_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_12_0">
    <VALUE Lang="cn">您终于来了！后勤支援进入了Chaos Island，破坏了最后一道防线。现在是需要大家支援的时候了。即便是微薄之力。您可以帮忙支援吗？拜托您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_12_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_13_0">
    <VALUE Lang="cn">谢谢您！非常感谢。您拯救了我们！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_13_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_2_0">
    <VALUE Lang="cn">谢谢您加入招募选拔。不晓得我们会遭遇多大的危险，各位一定要帮帮忙。这将会是一场激励了的战斗。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_3_0">
    <VALUE Lang="cn">先锋部队已经掌握了敌军的行踪！请按照顺序，先消灭最靠近您的Scouter。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_4_0">
    <VALUE Lang="cn">先锋部队已经掌握了敌军的行踪！请按照顺序，先消灭最靠近您的Elite Scouter。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_5_0">
    <VALUE Lang="cn">为了不让敌人离开Ground Zero，一定要建立最后一道防线。绝不能让他们逃出这里。请把他们消灭后，回报给我，如此您将能得到奖励。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_6_0">
    <VALUE Lang="cn">太好了！希望您可以继续撑住！一定要守住最后一道防线。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_7_0">
    <VALUE Lang="cn">敌军似乎是收到指令才开始行动的！那个指令一定藏在某人身上。请消灭他们，并拦截那份指令书。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_8_0">
    <VALUE Lang="cn">噢！是真的！他们的确是根据指令在行动的。不过，该指令书已加了密，无法进行阅读。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_8_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_9_0">
    <VALUE Lang="cn">Technical Teacher 应该能帮忙解码。请把这份指令交给他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_9_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0">
    <VALUE Lang="cn">这情况不太对劲！.您能帮帮我们吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_1">
    <VALUE Lang="cn">传达解码的侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_10">
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_11">
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_12">
    <VALUE Lang="cn">争取时间</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_13">
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_2">
    <VALUE Lang="cn">消灭 Chaser</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_3">
    <VALUE Lang="cn">寻找Dispatched agent 的行踪</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_4">
    <VALUE Lang="cn">领取Attack指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_5">
    <VALUE Lang="cn">转达Attack指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_6">
    <VALUE Lang="cn">确认进攻路线</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_7">
    <VALUE Lang="cn">询问最后的攻击指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_8">
    <VALUE Lang="cn">混乱的开始</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_9">
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_10_0">
    <VALUE Lang="cn">谢谢您！多亏您的帮忙，在后方支援的学生才免于迫害。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_10_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_11_0">
    <VALUE Lang="cn">为了救受伤的刺客，你能帮我争取点时间吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_11_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_12_0">
    <VALUE Lang="cn">谢谢你，由于你的帮助成功拯救了刺客.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_12_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_2_0">
    <VALUE Lang="cn">是Technical Teacher派您来的吗？ 请稍等唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_3_0">
    <VALUE Lang="cn">他们一定是有根据某种指令，才有办法如此井然有序地到处执行任务。</VALUE>
    <VALUE Lang="cn">嗯，每个人都向 Chaser作报告，所以Chaser 肯定就是敌军的首领。</VALUE>
    <VALUE Lang="cn">很好！她就是您最先要消灭的对象！没有时间了！上吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_4_0">
    <VALUE Lang="cn">为了学生，我需要将 Lost City 的状况报告给Saint Foundation，并请求支援。但有位Dispatched agent下落不明，可以请您帮忙找到他，并代替我告诉他这里的状况吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_5_0">
    <VALUE Lang="cn">根据搜查结果显示，敌军主力兵似乎正在传送攻击指令。如果您可以先拦截指令，那么他们的攻击力就会稍微降低。拜托您了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_6_0">
    <VALUE Lang="cn">干得好！请继续拦截收集更多的指令！万事拜托了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_7_0">
    <VALUE Lang="cn">Scientist Teacher 寄更多的细节给我们了。. 敌军的总指挥应该是位在Chaos Island得最隐秘处，所以您将会在前方遇到许多的怪物。现在，请您消灭他们，并确保可以进攻的正确路线。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_8_0">
    <VALUE Lang="cn">太谢谢您了！ 现在我们可以直接去找最终极的首领了！首先，请您将此结果报告给 Student Director，并请他发布最后一道攻击指令！我会在这儿等您唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_8_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_9_0">
    <VALUE Lang="cn">感觉这边怪怪的。假设敌人预先进行攻击，那么在后方支援的学生们就会遭到极大的伤害。您可以帮我们争取更多的时间吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_9_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0">
    <VALUE Lang="cn">为何我被派遣到这儿？…. 是为了收集技术资源。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_1">
    <VALUE Lang="cn">传达侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_2">
    <VALUE Lang="cn">取得解码工具</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_3">
    <VALUE Lang="cn">转交解码工具</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_4">
    <VALUE Lang="cn">确认进攻路线 1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_5">
    <VALUE Lang="cn">确认进攻路线 2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_6">
    <VALUE Lang="cn">收集武器零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_7">
    <VALUE Lang="cn">收集武器零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_8">
    <VALUE Lang="cn">转交解码的侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_9">
    <VALUE Lang="cn">再次转交解码的侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_10_0">
    <VALUE Lang="cn">噢！这是最新的搜查敌军指令吗？我马上进行解码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_10_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_2_0">
    <VALUE Lang="cn">Student Director给的敌军指令密码的构造太难解了。我实在是无法胜任。不过要是您有解码工具的话，我可以成功的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_3_0">
    <VALUE Lang="cn">可能有不少敌人已经拿到解码工具了。如果我拿到它，我就可以进行快速的解码了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_4_0">
    <VALUE Lang="cn">我们发现这加密手续方式很不寻常，不易解开。请您试着从敌方那儿取得解码工具。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_5_0">
    <VALUE Lang="cn">又见面了！解码的手续快结束了！等等我就会把它交给 Ryuin。可是有一群怪物卡在那儿。您可以帮他确认安全的入口路线吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_6_0">
    <VALUE Lang="cn">感激您的帮忙。但还是有很多怪物在那儿。请继续奋斗！拜托您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_7_0">
    <VALUE Lang="cn">敌人武器的火力似乎比我们强很多。您能帮我们收集一些零件过来吗？我会分析它们，并研发出对我们有益的成果。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_8_0">
    <VALUE Lang="cn">谢谢您！但是有个部分破损了，我正在研究中。这部分的零件越多，我的研究就越顺利。您可以继续帮我收集吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_8_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_9_0">
    <VALUE Lang="cn">我终于解码成功！这重要的信息是属于先锋部队的。您能帮我交给 Ryuin吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_9_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0">
    <VALUE Lang="cn">这次的情况没办法用物理学来解释。出现这种情况不知道会不会带来什么灾难</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_1">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_2">
    <VALUE Lang="cn">传递血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_3">
    <VALUE Lang="cn">封锁补给路线</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_4">
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_5">
    <VALUE Lang="cn">歼灭Transformer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_6">
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_2_0">
    <VALUE Lang="cn">阿...吓我一跳! 你怎么找到我的?刚好有件事需要请人帮忙，我正在等那个人出现，刚好你就出现了!</VALUE>
    <VALUE Lang="cn">来这里之前超能部指导老师曾经拜托我一件事。后来因为太忙竟然忘记告诉他结果。可以拜托你帮忙转达吗?听说超能部指导老师在被摧毁的都市。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_3_0">
    <VALUE Lang="cn">我躲起来前往市中心的时候发现大批敌军前往居住地，带着大批行李看起来像是补给物资。</VALUE>
    <VALUE Lang="cn">可以帮忙拦截敌军的物资吗?对了!要小心体型庞大的人!有种不好的预感</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_4_0">
    <VALUE Lang="cn">这次的任务是有难度的，你还是完成了真厉害!</VALUE>
    <VALUE Lang="cn">看来帮后勤支援减轻不少负担。真的是谢谢你!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_5_0">
    <VALUE Lang="cn">在那里调查时发现双臂机械人。因为那个家伙中断我的调查。</VALUE>
    <VALUE Lang="cn">虽然很危险不过我想你应该可以胜任，是吧?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_6_0">
    <VALUE Lang="cn">果然..我的眼光很准。谢谢你!现在终于可以继续调查了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0">
    <VALUE Lang="cn">嗯..这里的生物还真特别..让我愈来愈感到有兴趣。</VALUE>
    <VALUE Lang="cn">好想赶快掌握这里的情况回到实验室</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_1">
    <VALUE Lang="cn">交付血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_2">
    <VALUE Lang="cn">交付敌军相关的研究报告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_3">
    <VALUE Lang="cn">取得 Mutant Citizen的血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_4">
    <VALUE Lang="cn">转交 Mutant Citizen的血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_5">
    <VALUE Lang="cn">取得Twisted Soldier的血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_6">
    <VALUE Lang="cn">转交Twisted Soldier的血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_7">
    <VALUE Lang="cn">交付敌军兵力相关的研究报告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_2_0">
    <VALUE Lang="cn">终于找到了。真的很需要这样东西，辛苦你了。</VALUE>
    <VALUE Lang="cn">有一个东西需要交给Ryuin....不过放在哪里呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_3_0">
    <VALUE Lang="cn">阿...!找到了。调查被摧毁的都市时制作的调查报告，帮我交给Ryuin。</VALUE>
    <VALUE Lang="cn">他一定会需要这份报告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_4_0">
    <VALUE Lang="cn">这里有很多稀有的生物。不过他们看起来好像很残暴。</VALUE>
    <VALUE Lang="cn">因为我个人的好奇才特别拜托你的。如果可以帮忙采集血液样本，</VALUE>
    <VALUE Lang="cn">我一定会好好谢谢你</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_5_0">
    <VALUE Lang="cn">谢谢你。愈来愈有研究的欲望</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_6_0">
    <VALUE Lang="cn">不好意思。看样子需要再请你帮一个忙。</VALUE>
    <VALUE Lang="cn">有看到一个手臂很长的生物吗?虽然长的很可怕不过还是想研究看看!</VALUE>
    <VALUE Lang="cn">可以帮忙采集血液样本吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_7_0">
    <VALUE Lang="cn">再困难的请求你都可以轻松解决呢!真的是很谢谢你。</VALUE>
    <VALUE Lang="cn">等这里的事情处理完，我一定会给你奖励的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0">
    <VALUE Lang="cn">是到地下2楼去的专用电梯。</VALUE>
    <VALUE Lang="cn">不知道密码的话, 无法使用。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0_1">
    <VALUE Lang="cn">输入密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0_4">
    <VALUE Lang="cn">输入密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0_5">
    <VALUE Lang="cn">阅读资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_4_0">
    <VALUE Lang="cn">密码出现错误，请确认后再试一次。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_5_0">
    <VALUE Lang="cn">密码输入成功！请使用电梯。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_5_0_1">
    <VALUE Lang="cn">阅读资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_5_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_6_0">
    <VALUE Lang="cn">地下2楼部份的实验体正开始扩散。</VALUE>
    <VALUE Lang="cn">先看到这个留言的人, 请将目前地下发生的状况告知外面。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0">
    <VALUE Lang="cn">我不存...</VALUE>
    <VALUE Lang="cn">这个世上有我吗...</VALUE>
    <VALUE Lang="cn">在我心中有世上吗...</VALUE>
    <VALUE Lang="cn">对我而言我不存在, 对世上而言那个世上也不存在...</VALUE>
    <VALUE Lang="cn">呵呵..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0_1">
    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0_2">
    <VALUE Lang="cn">询问Sacred Financial Group的社服活动内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1">
    <VALUE Lang="cn">拜 拜托...</VALUE>
    <VALUE Lang="cn">知.. 知道我..我能通过这扇门的方法吗?</VALUE>
    <VALUE Lang="cn">因..因此…你...要给我帮忙呀</VALUE>
    <VALUE Lang="cn">那样才行</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_1">
    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_2">
    <VALUE Lang="cn">询问委托什么</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_3">
    <VALUE Lang="cn">交付百科全书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_4">
    <VALUE Lang="cn">交付羽毛</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_5">
    <VALUE Lang="cn">询问Sacred Financial Group的社服活动内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_6">
    <VALUE Lang="cn">询问异变当天的情况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_2">
    <VALUE Lang="cn">还是...</VALUE>
    <VALUE Lang="cn">以那样的程度, 是无法通过这扇门</VALUE>
    <VALUE Lang="cn">要怎么做才能</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_2_1">
    <VALUE Lang="cn">变更开始地点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_10_0">
    <VALUE Lang="cn">圣…圣…圣…徒…</VALUE>
    <VALUE Lang="cn">非常… 讨厌… 坟墓里的尸体…</VALUE>
    <VALUE Lang="cn">防碍了安…安息处…安息…那些家伙…</VALUE>
    <VALUE Lang="cn">不承认…秩序…危险</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_11_0">
    <VALUE Lang="cn">异…..异变？您在说什么咚咚？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_11_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_2_0">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_2_0_1">
    <VALUE Lang="cn">已变更开始地点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_3_0">
    <VALUE Lang="cn">这..这门</VALUE>
    <VALUE Lang="cn">时间不够了, 是呀...</VALUE>
    <VALUE Lang="cn">想要通过门, 要有这认证书才行</VALUE>
    <VALUE Lang="cn">我可以制..制作</VALUE>
    <VALUE Lang="cn">因此, 才拜..拜托你</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_3_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_4_0">
    <VALUE Lang="cn">谢..谢谢</VALUE>
    <VALUE Lang="cn">现在…有点想起来了…</VALUE>
    <VALUE Lang="cn">我需要Shadow Crow的8个黑色羽毛（Black Feather）。</VALUE>
    <VALUE Lang="cn">请带给我好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_5_0">
    <VALUE Lang="cn">羽毛.. 8个</VALUE>
    <VALUE Lang="cn">好, 好..</VALUE>
    <VALUE Lang="cn">这里…认证书… 和簿子一样</VALUE>
    <VALUE Lang="cn">拿着这个的话, 现在起就可通过那扇了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_5_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_6_0">
    <VALUE Lang="cn">.....3</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_7_0">
    <VALUE Lang="cn">现在我的..脑袋好奇怪…想不太起来</VALUE>
    <VALUE Lang="cn">把书..书找给我</VALUE>
    <VALUE Lang="cn">蔷薇, 从颜色褪掉的蔷薇...</VALUE>
    <VALUE Lang="cn">把书找给我</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_8_0">
    <VALUE Lang="cn">.....5</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_9_0">
    <VALUE Lang="cn">只要通.. 通过一次, 从下次开始, 就可自由进..进入</VALUE>
    <VALUE Lang="cn">来, 去看看</VALUE>
    <VALUE Lang="cn">但是… 我是谁呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_9_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0">
    <VALUE Lang="cn">哈哈哈！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_1">
    <VALUE Lang="cn">询问怎么回事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_10">
    <VALUE Lang="cn">询问是否需要帮忙？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_2">
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_3">
    <VALUE Lang="cn">分享食物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_4">
    <VALUE Lang="cn">询问他是否为Suna Jo的朋友</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_5">
    <VALUE Lang="cn">回复说是Suna Jo派你来的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_6">
    <VALUE Lang="cn">询问发生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_7">
    <VALUE Lang="cn">转达 Evilplate Monk 的问候</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_8">
    <VALUE Lang="cn">询问是否需要帮忙？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_9">
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_10_0">
    <VALUE Lang="cn">噢，是Suna派您来的啊。从您上次来访后，我的记忆开始慢慢地恢复了。之前的确有好一阵子我的神智不是很清醒，也一直都很饿。虽然现在也没好到哪里去…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_10_0_1">
    <VALUE Lang="cn">告诉他您想知道发生了什么事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_11_0">
    <VALUE Lang="cn">我只记得某人有在帮助我一路走来平安无事。她有着美丽又悲伤的双眼，但跟她走在一起的那些人看起来就很可怕……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_11_0_1">
    <VALUE Lang="cn">询问后来那些人怎么样了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_12_0">
    <VALUE Lang="cn">我们在Main Gate说再见之后， 他们就往Trading Hole的方向走了。然后，我跑去与Leonine学院的Student Director见面了。我真的很想知道那个孩子过的如何，如果您有时间的话，可以帮我问候一下她吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_12_0_1">
    <VALUE Lang="cn">告诉他您会找找的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_13_0">
    <VALUE Lang="cn">谢谢您，我真的很开心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_13_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_14_0">
    <VALUE Lang="cn">他应该很担心我…….但我想先找点什么东西…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_14_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_15_0">
    <VALUE Lang="cn">以前有个学生叫做Stoner，他曾跟我一起到了Leonine学院，但是，当我幌了一下神，回过头来看，他竟然消失了！最近有个孩子跟我说，他经过Leonine学院的B3时，似乎有找到Stoner的相关线索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_15_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_16_0">
    <VALUE Lang="cn">噢…..Stoner.. 哇！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_16_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0">
    <VALUE Lang="cn">请将这封信交给他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0_2">
    <VALUE Lang="cn">请传递信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_2_0">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_3_0">
    <VALUE Lang="cn">好可怕……...之前不是这样子的。自从那个孩子离奇死亡后，大家都变得跟原本不一样了….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_4_0">
    <VALUE Lang="cn">我好饿，因为我躲在这里太久了……..我也不敢到外头去找食物…. 外头太危险了。请问您有食物可以分给我吗？真的拜托您了……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_5_0">
    <VALUE Lang="cn">食物？是吃的？！太谢谢您了！现在我可以在这多躲一会儿了！我会坚持下去的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_6_0">
    <VALUE Lang="cn">…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_7_0">
    <VALUE Lang="cn">Suna……..好像是Suna Jo…嗯，我想我应该知道她是谁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_7_0_1">
    <VALUE Lang="cn">告诉他，您来这儿是为了完成寻找他的任务。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_8_0">
    <VALUE Lang="cn">Suna，他是我的朋友阿！我怎么会忘记朋友的名字了呢？他一定很担心我，您可以帮我跟他说一声吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_8_0_1">
    <VALUE Lang="cn">请他别担心</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_9_0">
    <VALUE Lang="cn">请将这封信转交给Suna，拜托您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_9_0_1">
    <VALUE Lang="cn">领取信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0">
    <VALUE Lang="cn">你.. 你是.. 人..</VALUE>
    <VALUE Lang="cn">自从.. 结界.. 解除以来..</VALUE>
    <VALUE Lang="cn">所有的人.. 都变了....</VALUE>
    <VALUE Lang="cn">我也..正慢慢的.. 改变..</VALUE>
    <VALUE Lang="cn">啊.. 虽然我有.. 一些药品..</VALUE>
    <VALUE Lang="cn">但是因为.. 非常.. 稀有.....</VALUE>
    <VALUE Lang="cn">所以.. 只能卖你.. 贵一些了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_1">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_2">
    <VALUE Lang="cn">询问她会不会害怕</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_3">
    <VALUE Lang="cn">告诉她事情的真相</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_4">
    <VALUE Lang="cn">询问她会不会害怕</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_5">
    <VALUE Lang="cn">告诉她事情的真相</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_6">
    <VALUE Lang="cn">询问异变当天的状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_2_0">
    <VALUE Lang="cn">每…天晚上….那些男....人打给我…我不想见他们…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_2_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_3_0">
    <VALUE Lang="cn">他…们不…会再…过来了……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_4_0">
    <VALUE Lang="cn">老…师在…呼叫我…...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_4_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_5_0">
    <VALUE Lang="cn">他…们不…会再…过来了……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_5_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_6_0">
    <VALUE Lang="cn">我…..什么都想不起来了……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_1_0">
    <VALUE Lang="cn">我肚子好饿……… 没有学生在受饥饿之苦的…..我们为什么会这样呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_1_0_1">
    <VALUE Lang="cn">钥匙的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_1_0_2">
    <VALUE Lang="cn">传递吃的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_2_0">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_3_0">
    <VALUE Lang="cn">是啊！我指的就是那个钥匙。这是哪里的钥匙呢？Classroom？Information Center？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_3_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_4_0">
    <VALUE Lang="cn">吃的东西！！！！太好了！来！把钥匙拿走吧！您是个好学生。下次的考试，我会给您高分的。呵呵呵………</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_5_0">
    <VALUE Lang="cn">.....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_6_0">
    <VALUE Lang="cn">这是录影带？</VALUE>
    <VALUE Lang="cn">那么，您要给我什么？</VALUE>
    <VALUE Lang="cn">你给我收，我给你收，将才能维持好平衡啊。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_6_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_7_0">
    <VALUE Lang="cn">但是…..</VALUE>
    <VALUE Lang="cn">请您帮我带点吃的来好吗？</VALUE>
    <VALUE Lang="cn">我看见有人在外面吃东西。</VALUE>
    <VALUE Lang="cn">请帮我带点食物进来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_ex1.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0">
    <VALUE Lang="cn">我的学生在哪里？他们都走了？！</VALUE>
    <VALUE Lang="cn">我感觉他们的灵魂漫游在这个怪异的建筑里！</VALUE>
    <VALUE Lang="cn">我该怎么帮你？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_1">
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_10">
    <VALUE Lang="cn">询问异变当天的情况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_11">
    <VALUE Lang="cn">询问他是否需要帮助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_12">
    <VALUE Lang="cn">交出所找到的东西</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_13">
    <VALUE Lang="cn">询问他是否遇到麻烦了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_2">
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_3">
    <VALUE Lang="cn">询问资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_4">
    <VALUE Lang="cn">归还钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_5">
    <VALUE Lang="cn">领取卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_6">
    <VALUE Lang="cn">拿出珠子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_7">
    <VALUE Lang="cn">询问卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_8">
    <VALUE Lang="cn">询问要进入Basement Level 2的密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_1_0_9">
    <VALUE Lang="cn">询问Sacred Financial Group的社服活动内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_10_0">
    <VALUE Lang="cn">学生们在上课时应该有学到一些18年前的事吧?</VALUE>
    <VALUE Lang="cn">一天内只在亚洲北部发生令人质疑的日蚀和流星雨现象…不,应该说是事件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_10_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_11_0">
    <VALUE Lang="cn">所有的…纪录…都…</VALUE>
    <VALUE Lang="cn">带过去…秀给他看…</VALUE>
    <VALUE Lang="cn">安... 神特</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_11_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_12_0">
    <VALUE Lang="cn">咳…喝…</VALUE>
    <VALUE Lang="cn">咳哈哈哈哈…</VALUE>
    <VALUE Lang="cn">我确实知道号码</VALUE>
    <VALUE Lang="cn">好…你分明就知道…</VALUE>
    <VALUE Lang="cn">但是记不太清楚了现在</VALUE>
    <VALUE Lang="cn">实验体..2..8…号</VALUE>
    <VALUE Lang="cn">我…写的…便条纸…带过去了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_12_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_13_0">
    <VALUE Lang="cn">.......10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_14_0">
    <VALUE Lang="cn">所有事情都在那时开始,设立我们4个学院的神圣财团也因为那件事之契机而创立</VALUE>
    <VALUE Lang="cn">虽然已经知道那流星雨并非单纯的天体现象,但实际却无法了解</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_14_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_15_0">
    <VALUE Lang="cn">这所有事情的起点…</VALUE>
    <VALUE Lang="cn">…现在也没有什么好隐瞒的就把它讲出来吧</VALUE>
    <VALUE Lang="cn">那流星雨是我们现在生存的世界和其他世界之间传送要素的痕迹</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_15_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_16_0">
    <VALUE Lang="cn">大概就是说,那边是真正的世界,这边是假的世界,事实上人类受到机器的支配,只是精髓被吸收掉了</VALUE>
    <VALUE Lang="cn">也许有人这样认为,但确实来讲不是这样的</VALUE>
    <VALUE Lang="cn">严格说来两个世界各自独立在两个空间…</VALUE>
    <VALUE Lang="cn">嗯!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_16_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_17_0">
    <VALUE Lang="cn">还有…精神…</VALUE>
    <VALUE Lang="cn">虽然还有很多想教给你们的…却….没有什么时间了</VALUE>
    <VALUE Lang="cn">还是…还是有可能可以堵住的</VALUE>
    <VALUE Lang="cn">挡住光明那件事 都堵起来!"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_17_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_18_0">
    <VALUE Lang="cn">哎呀… 突然精神有点…</VALUE>
    <VALUE Lang="cn">学生是…不久前带来过红色珠子是吧?</VALUE>
    <VALUE Lang="cn">为什么… 突然…</VALUE>
    <VALUE Lang="cn">财团? 可是…财团的确可以说是以好的形象做好事的正义一方。</VALUE>
    <VALUE Lang="cn">至少…这里还是虎令学院为止</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_18_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_19_0">
    <VALUE Lang="cn">危险啊…已经是方向歪曲的实验… 认定使用活体的实验…</VALUE>
    <VALUE Lang="cn">但是这个… 那些家伙打算放弃这个世界</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_19_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_2_0">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_20_0">
    <VALUE Lang="cn">那..天...没有发生什么特别不一样的事情呀....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">我回想一下...完全想不起来</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_20_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_21_0">
    <VALUE Lang="cn">对了!! 有一本手...册...</VALUE>
    <VALUE Lang="cn">我把全部的事情都纪录在..那本手册..</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">虎令学院的男同学女同学分别把那本手册拿走了</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">去找他们...应该可以知道..一切经过</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_21_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_22_0">
    <VALUE Lang="cn">现在...有了这本手册,我想应该就可以知道整件事情的来龙去脉了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_22_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_23_0">
    <VALUE Lang="cn">这本手册你拿去...现在不需要我出马了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_23_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_3_0">
    <VALUE Lang="cn">同学们！我珍贵的学生在哪儿？</VALUE>
    <VALUE Lang="cn">现在是怎么回事？</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_4_0">
    <VALUE Lang="cn">亲爱的学生：在走廊闲逛时要小心安全，注意邪灵正在到处游荡！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_5_0">
    <VALUE Lang="cn">啊…资料…资料加了些情报了…</VALUE>
    <VALUE Lang="cn">那么…文件,日志…带子!</VALUE>
    <VALUE Lang="cn">带子…有录影带…</VALUE>
    <VALUE Lang="cn">但是锁住了</VALUE>
    <VALUE Lang="cn">钥匙呢…</VALUE>
    <VALUE Lang="cn">2年…3…班</VALUE>
    <VALUE Lang="cn">不要在走廊上奔跑</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_6_0">
    <VALUE Lang="cn">钥匙…钥匙…</VALUE>
    <VALUE Lang="cn">这钥匙没错,但是…</VALUE>
    <VALUE Lang="cn">但是…弯曲了</VALUE>
    <VALUE Lang="cn">这把钥匙..不行</VALUE>
    <VALUE Lang="cn">要修理才行…给工友…</VALUE>
    <VALUE Lang="cn">现在的话…2年…7…班</VALUE>
    <VALUE Lang="cn">不要在走道上奔跑</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_7_0">
    <VALUE Lang="cn">带子…这里…</VALUE>
    <VALUE Lang="cn">这里…都…拍了</VALUE>
    <VALUE Lang="cn">分明…都…</VALUE>
    <VALUE Lang="cn">拜托..我们…</VALUE>
    <VALUE Lang="cn">不要在走廊上奔跑</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_8_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">珠…珠子…叩…叩!</VALUE>
    <VALUE Lang="cn">抠搂! 抠搂!</VALUE>
    <VALUE Lang="cn">这,这里…到底发生什么事?</VALUE>
    <VALUE Lang="cn">不对啊, Administration Office怎么会变这样?</VALUE>
    <VALUE Lang="cn">教师们都到哪里去了?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_8_0_1">
    <VALUE Lang="cn">解释状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_8_0_2">
    <VALUE Lang="cn">要求资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_8_0_3">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_9_0">
    <VALUE Lang="cn">真的这样…</VALUE>
    <VALUE Lang="cn">这个发生异像的都市啊…</VALUE>
    <VALUE Lang="cn">不是啊,如果是之前的事情的话,不是只有一个都市毁灭而已</VALUE>
    <VALUE Lang="cn">真希望不会发生那样的事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_t_t_master1.ntk_9_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_0">
    <VALUE Lang="cn">我该毁了这份差事呢？还是改善它呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_0_1">
    <VALUE Lang="cn">要求修理钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1">
    <VALUE Lang="cn">天花板坍塌，桥面也断了......</VALUE>
    <VALUE Lang="cn">窗户掉了下来......我应该先做些什么好呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1_1">
    <VALUE Lang="cn">要求修理钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1_2">
    <VALUE Lang="cn">询问可能需要的帮助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1_3">
    <VALUE Lang="cn">交付 Towel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_1_1_4">
    <VALUE Lang="cn">交付 Glove</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_10_0">
    <VALUE Lang="cn">如果我用太多的力量，它会变形得很严重。</VALUE>
    <VALUE Lang="cn">知道如何控制力量是非常重要的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_10_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_11_0">
    <VALUE Lang="cn">.....4</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_12_0">
    <VALUE Lang="cn">蜘蛛网是最糟糕的部分！还有出现裂缝的墙壁、书桌以及黑板。哎呀！我没有毛巾和手套！这要我怎么做事情？！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_12_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_13_0">
    <VALUE Lang="cn">嗯~</VALUE>
    <VALUE Lang="cn">请先帮我找来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_13_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_14_0">
    <VALUE Lang="cn">我想我的毛巾是放在1楼的 Locker。可以请您帮我拿来吗？手套的部分，我想我可以自己试试看的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_14_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_15_0">
    <VALUE Lang="cn">....5</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_16_0">
    <VALUE Lang="cn">这意思就是我必须要工作得非常努力。如果我想要顺利地进行工作，那就得先拿到毛巾。就是那样！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_16_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_17_0">
    <VALUE Lang="cn">但是，怎么到现在都还没找到手套…….</VALUE>
    <VALUE Lang="cn">仔细想想，噢对了！我把它放在Shop House的架子上面了。对吧？请帮我找找，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_17_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_18_0">
    <VALUE Lang="cn">......6</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_19_0">
    <VALUE Lang="cn">您可以走了。我可以自己完成。请把这Crystal交给Student Director，现在我不需要它了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_19_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_2_0">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_3_0">
    <VALUE Lang="cn">所以，这个是我们必须先完成的意思吗？</VALUE>
    <VALUE Lang="cn">嗯，不需要花太多的时间，也不是很难。</VALUE>
    <VALUE Lang="cn">只需要轻轻按一下就可以。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_3_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_4_0">
    <VALUE Lang="cn">我一个人把学校的设备全部都整顿好了。其实很简单的，不过，我不知道该从那边下手。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_4_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_5_0">
    <VALUE Lang="cn">噢！我的毛巾。嗯，如果我能拥有一条毛巾的话，我就会工作得更努力的。因为我现在没有可以擦汗的东西。如果手是滑滑湿湿的，就无法抓住东西。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_5_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_6_0">
    <VALUE Lang="cn">手套！我的手套！</VALUE>
    <VALUE Lang="cn">现在我可以开始正常工作了！！</VALUE>
    <VALUE Lang="cn">嗯，从何开始好呢？</VALUE>
    <VALUE Lang="cn">现在我该先做什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_6_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_7_0">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_7_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_8_0">
    <VALUE Lang="cn">.....3</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_9_0">
    <VALUE Lang="cn">我需要知道如何把这个放在一起…… 绝不能让这个标识一下子轻按就被弹出来。</VALUE>
    <VALUE Lang="cn">弯曲的地方不要用力。我觉得在反方向的地方，它会变得弯曲.....一定要恢复原形。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_work1.ntk_9_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0">
    <VALUE Lang="cn">……找我什么事?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_1">
    <VALUE Lang="cn">商店贩售</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_10">
    <VALUE Lang="cn">扫荡高利贷 (重复)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_11">
    <VALUE Lang="cn">再次搜查</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_12">
    <VALUE Lang="cn">消灭高利贷头目</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_13">
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_2">
    <VALUE Lang="cn">设定开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_3">
    <VALUE Lang="cn">调查周边</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_4">
    <VALUE Lang="cn">报告调查结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_5">
    <VALUE Lang="cn">制服商人</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_6">
    <VALUE Lang="cn">制服商人 (重复)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_7">
    <VALUE Lang="cn">调查光爆炸原因</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_8">
    <VALUE Lang="cn">传达成分分析表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_1_0_9">
    <VALUE Lang="cn">扫荡高利贷</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_10_0">
    <VALUE Lang="cn">…辛苦了. 他们已经没有了头目，应该会自动解散.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_10_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_2_0">
    <VALUE Lang="cn">…开始调查周边情况. 你去调查那边.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_2_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_3_0">
    <VALUE Lang="cn">…辛苦了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_4_0">
    <VALUE Lang="cn">…商人们…看起来很奇怪. 将他们制服，并带到这里.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_4_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_5_0">
    <VALUE Lang="cn">…我不是很清楚. 你可以去找超能部指导教师来协助调查.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_5_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_6_0">
    <VALUE Lang="cn">…辛苦了. 这个由我来处理.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_7_0">
    <VALUE Lang="cn">…目标已确定. 去消灭高利贷.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_7_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_8_0">
    <VALUE Lang="cn">…已经处理的差不多了. 放大调查范围.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_8_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_9_0">
    <VALUE Lang="cn">…只要消灭头目，其他人都是乌合之众. 让我们去消灭头目.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_1.ntk_9_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0">
    <VALUE Lang="cn">……找我有什么事?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_1">
    <VALUE Lang="cn">商店贩售</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_10">
    <VALUE Lang="cn">声东击西</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_11">
    <VALUE Lang="cn">消灭暴力团头目</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_12">
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_13">
    <VALUE Lang="cn">扫荡暴力团 (重复)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_2">
    <VALUE Lang="cn">设定开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_3">
    <VALUE Lang="cn">搜查周边</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_4">
    <VALUE Lang="cn">报告调查结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_5">
    <VALUE Lang="cn">搜集情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_6">
    <VALUE Lang="cn">新情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_7">
    <VALUE Lang="cn">桥的另一边</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_8">
    <VALUE Lang="cn">报告调查结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_1_0_9">
    <VALUE Lang="cn">全力探索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_10_0">
    <VALUE Lang="cn">…找到暴力团头目的所在地了. 去帮我消灭头目.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_10_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_11_0">
    <VALUE Lang="cn">…辛苦你了. 真是帮了我一个大忙.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_11_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_12_0">
    <VALUE Lang="cn">…消灭剩余的残党.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_12_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_2_0">
    <VALUE Lang="cn">…看来我们需要确保据点. 能请你帮忙搜查吗.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_2_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_3_0">
    <VALUE Lang="cn">…原来如此..? 这地方也是..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_4_0">
    <VALUE Lang="cn">…向居民大厅这里的状况.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_4_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_5_0">
    <VALUE Lang="cn">…做得好. 现在到桥的另一边..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_5_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_6_0">
    <VALUE Lang="cn">…在桥的另一边准备开始攻击. 在这之前先进行侦查.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_7_0">
    <VALUE Lang="cn">…与居民说的一样. 知道了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_7_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_8_0">
    <VALUE Lang="cn">…我们先要了解敌人的战力.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_8_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_9_0">
    <VALUE Lang="cn">…可能比预想的要艰难. 我先潜入进去，你按照作战计划进行.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_9_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_0">
    <VALUE Lang="cn">好了.</VALUE>
    <VALUE Lang="cn">现在可以移动到那边的隧道了.</VALUE>
    <VALUE Lang="cn">路上请小心!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_1">
    <VALUE Lang="cn">不是那边!!</VALUE>
    <VALUE Lang="cn">可不可以在快点?!</VALUE>
    <VALUE Lang="cn">哎..呸..干活又不是一天两天………嗯? 什么是?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_1_1">
    <VALUE Lang="cn">说明你是调查志愿者.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_1_2">
    <VALUE Lang="cn">交给整备仓库钥匙.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_2_0">
    <VALUE Lang="cn">啊, 原来是调查志愿者..</VALUE>
    <VALUE Lang="cn">哎…该怎么办? 工程还没完工.</VALUE>
    <VALUE Lang="cn">挖掘机出现了故障，需要零件来修理.</VALUE>
    <VALUE Lang="cn">你可不可以帮我拿回整备仓库的钥匙?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_2_0_1">
    <VALUE Lang="cn">接收请求.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_3_0">
    <VALUE Lang="cn">我忘了以前把钥匙交给谁保管了.</VALUE>
    <VALUE Lang="cn">没办法，只能用备用钥匙了.</VALUE>
    <VALUE Lang="cn">去学院广场找生活指导教师问问.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_4_0">
    <VALUE Lang="cn">哇~~~太谢谢你了!</VALUE>
    <VALUE Lang="cn">托你的福，可以按时完工了. 呵呵呵.</VALUE>
    <VALUE Lang="cn">再等一会，马上就要完工了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_4_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_0">
    <VALUE Lang="cn">啊..啊啊啊..救救我..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_0_1">
    <VALUE Lang="cn">说明不是要害他.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_0_2">
    <VALUE Lang="cn">询问有关桥的另一边.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_1">
    <VALUE Lang="cn">啊啊..其他人怎么样了…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_1_1">
    <VALUE Lang="cn">暴力团肆虐 (重复)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_1_2">
    <VALUE Lang="cn">询问发生了什么事.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_2_0">
    <VALUE Lang="cn">啊..啊啊..真, 真的吗?</VALUE>
    <VALUE Lang="cn">谢, 谢谢你. 非常感谢你.</VALUE>
    <VALUE Lang="cn">好不容易从暴力团逃出来..</VALUE>
    <VALUE Lang="cn">如, 如果再被抓回去，那我就彻底完蛋了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_2_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_3_0">
    <VALUE Lang="cn">异, 异变后有一段时间还是很好的.</VALUE>
    <VALUE Lang="cn">虽然隧道崩塌，但是我还是能自己活下去...</VALUE>
    <VALUE Lang="cn">但是 从不久前开始, 突然出现了一些怪人.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_3_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_4_0">
    <VALUE Lang="cn">刚, 刚开始我还以为是小混混</VALUE>
    <VALUE Lang="cn">他们杀人放火，囚禁居民, 并控制住了这个城市.</VALUE>
    <VALUE Lang="cn">现在还有很多人被他们所奴役，并强制劳动着.</VALUE>
    <VALUE Lang="cn">请帮我们教训教训那些坏蛋! 哼哼哼..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_4_0_1">
    <VALUE Lang="cn">暴力团肆虐</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_5_0">
    <VALUE Lang="cn">啊啊..谢谢你… 非常感谢你.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_5_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_6_0">
    <VALUE Lang="cn">我, 我担心目前还被他们所囚禁的人.</VALUE>
    <VALUE Lang="cn">为了其他人也能够像我一样逃出来，去教训教训那些坏人.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_7_0">
    <VALUE Lang="cn">你, 你说的是桥的另一边?</VALUE>
    <VALUE Lang="cn">那, 那里基本上属于暴力团大本营.</VALUE>
    <VALUE Lang="cn">到处都是手里拿着枪，头上蒙着面罩的恶汉..</VALUE>
    <VALUE Lang="cn">而且还有拿着大长刀的可怕的女人们..</VALUE>
    <VALUE Lang="cn">想想也觉得可, 可怕.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_7_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0">
    <VALUE Lang="cn">嗨. 你来了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_1">
    <VALUE Lang="cn">商店发售</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_10">
    <VALUE Lang="cn">[每日限定] 消失的账本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_11">
    <VALUE Lang="cn">转交账本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_2">
    <VALUE Lang="cn">询问是不是写字条的人.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_3">
    <VALUE Lang="cn">递交外账</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_4">
    <VALUE Lang="cn">切断资金链</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_5">
    <VALUE Lang="cn">切断资金链 (重复)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_6">
    <VALUE Lang="cn">吵闹的暴走族</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_7">
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_8">
    <VALUE Lang="cn">[每日限定] 幕后黑手</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_9">
    <VALUE Lang="cn">무기 부품 전달</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_10_0">
    <VALUE Lang="cn">现在需要管理的事情越来越多. 但是，这几天由于暴走族每天晚上都闹的太吵，使得我无法集中精神.</VALUE>
    <VALUE Lang="cn">虽然一般的暴走族我们自己能对付，但是要对付他们的头目可不简单.</VALUE>
    <VALUE Lang="cn">请你去帮我教训教训他们的头目.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_10_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_11_0">
    <VALUE Lang="cn">非常感谢你.</VALUE>
    <VALUE Lang="cn">现在应该能睡个安稳觉了. 嘻嘻.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_11_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_12_0">
    <VALUE Lang="cn">这条街大部分已经整理完毕了.</VALUE>
    <VALUE Lang="cn">这都时拖了你的福. 嘻嘻.</VALUE>
    <VALUE Lang="cn">接下来我想要扩张到武器交易方面..</VALUE>
    <VALUE Lang="cn">你能帮我带回来一点蒙面人的武器零件吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_12_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_13_0">
    <VALUE Lang="cn">非常了不起.</VALUE>
    <VALUE Lang="cn">我对你的处理方式很满意. 嘻嘻.</VALUE>
    <VALUE Lang="cn">那么，下次再拜托你了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_13_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_14_0">
    <VALUE Lang="cn">哎..现在快忙死了..</VALUE>
    <VALUE Lang="cn">嗯..昨晚有个家伙偷走了我的账本?</VALUE>
    <VALUE Lang="cn">我大概能猜到是谁干的..</VALUE>
    <VALUE Lang="cn">帮我教训那些流氓，并帮我找回账本.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_14_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_15_0">
    <VALUE Lang="cn">谢谢你.</VALUE>
    <VALUE Lang="cn">你, 有没有兴趣一直跟我合作下去?</VALUE>
    <VALUE Lang="cn">….嘻嘻. 开个玩笑.</VALUE>
    <VALUE Lang="cn">明天再见.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_15_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_2_0">
    <VALUE Lang="cn">嗯. 是的.</VALUE>
    <VALUE Lang="cn">听说你前几天来到了 "东城路".</VALUE>
    <VALUE Lang="cn">感觉你是个可靠的人，所以我才找你帮忙.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_2_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_3_0">
    <VALUE Lang="cn">我先自我介绍.</VALUE>
    <VALUE Lang="cn">我是这里的 Bar "The Blue"的老板娘. 我叫 "老板娘 S".</VALUE>
    <VALUE Lang="cn">“The Blue”是东城路的“暴力团”所掌管的酒吧.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_3_0_1">
    <VALUE Lang="cn">询问找我来的理由.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_4_0">
    <VALUE Lang="cn">哎, 你先别急. 嘻嘻</VALUE>
    <VALUE Lang="cn">我之所以找你来，是为了想跟你做一笔交易.</VALUE>
    <VALUE Lang="cn">这笔交易肯定对我们彼此都会有所帮助.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_4_0_1">
    <VALUE Lang="cn">交易?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_5_0">
    <VALUE Lang="cn">我虽然隶属于 "暴力团"..嗯…反正这都无所谓了.</VALUE>
    <VALUE Lang="cn">我的目的只有一个，就是成为这条街的主人.</VALUE>
    <VALUE Lang="cn">为此我必须要先解决周边其他的竞争店面..</VALUE>
    <VALUE Lang="cn">这也是证明你实力的好机会. 你要帮助我吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_5_0_1">
    <VALUE Lang="cn">知道了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_6_0">
    <VALUE Lang="cn">很好.</VALUE>
    <VALUE Lang="cn">那么第一步，你能先帮我要回一些客人拖欠的外账吗.</VALUE>
    <VALUE Lang="cn">如果他们反抗，使用武力也无所谓. 哈哈</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_7_0">
    <VALUE Lang="cn">一张, 两张, 三张, 四张…….金额无误. 谢了.</VALUE>
    <VALUE Lang="cn">你教训的那些客人都是些麻烦的家伙，亏你能这么快解决.</VALUE>
    <VALUE Lang="cn">证明你还是很有实力的? 哈哈.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_7_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_8_0">
    <VALUE Lang="cn">既然已经证明了实力，那我们正式开始谈谈交易内容吧?</VALUE>
    <VALUE Lang="cn">这里的大部分商业店面，基本上都属于“暴力团”的资金链.</VALUE>
    <VALUE Lang="cn">如果处理了由他们所掌管的商业店面，对“暴力团”的打击也是很大的.</VALUE>
    <VALUE Lang="cn">当然, 对我也有处? 哈哈.</VALUE>
    <VALUE Lang="cn">帮我教训其他店的管理者.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_8_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_9_0">
    <VALUE Lang="cn">虽然已经处理了一些，但其数量还是剩很多.</VALUE>
    <VALUE Lang="cn">请继续帮我处理他们.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_9_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0">
    <VALUE Lang="cn">探索新事物总是让人觉得很愉快. 嘻嘻嘻</VALUE>
    <VALUE Lang="cn">需要我帮忙吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_1">
    <VALUE Lang="cn">商店贩售</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_10">
    <VALUE Lang="cn">[每日限定] 执著地家伙们</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_11">
    <VALUE Lang="cn">转交药物样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_2">
    <VALUE Lang="cn">说明商人们的状态</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_3">
    <VALUE Lang="cn">请求调查药物成分</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_4">
    <VALUE Lang="cn">烦人的艺术家们</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_5">
    <VALUE Lang="cn">烦人的艺术家们 (重复)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_6">
    <VALUE Lang="cn">请求检查狂暴化 II</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_7">
    <VALUE Lang="cn">获得成分分析表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_8">
    <VALUE Lang="cn">请求追踪发信地</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_1_0_9">
    <VALUE Lang="cn">确认追踪结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_10_0">
    <VALUE Lang="cn">已成功追踪发信地.</VALUE>
    <VALUE Lang="cn">由于是追踪加密的线路，所以消耗点时间…但是没问题~</VALUE>
    <VALUE Lang="cn">所有信息都是从那边的区域传送过来的.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_10_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_11_0">
    <VALUE Lang="cn">这帮高利贷就像一群蟑螂!</VALUE>
    <VALUE Lang="cn">这次又对商人们使用其他药物了.</VALUE>
    <VALUE Lang="cn">虽然忍术部长给了我药物样本，但是数量还是不足.</VALUE>
    <VALUE Lang="cn">需要在找一些样本过来.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_11_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_12_0">
    <VALUE Lang="cn">谢谢你!</VALUE>
    <VALUE Lang="cn">有关分析结果，我会亲自报告给忍术部长.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_12_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_2_0">
    <VALUE Lang="cn">嗯~你的意思是不分青红皂白，就像发疯似的攻过来了?</VALUE>
    <VALUE Lang="cn">就算让他们镇定下来，过不久后还是会再次发狂?</VALUE>
    <VALUE Lang="cn">没有其他别的特殊事项吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_2_0_1">
    <VALUE Lang="cn">商人们附近一直徘徊着一些奇怪的人们..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_3_0">
    <VALUE Lang="cn">奥..你不觉得很奇怪吗? 嘻嘻</VALUE>
    <VALUE Lang="cn">真相永远只有一个!...应该就是这样!</VALUE>
    <VALUE Lang="cn">去调查那些人.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_3_0_1">
    <VALUE Lang="cn">请求检查狂暴化 I</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_4_0">
    <VALUE Lang="cn">我就知道会是那样..拿过来看看.</VALUE>
    <VALUE Lang="cn">目前我的装备不是很好，检查结果需要一段时间.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_4_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_5_0">
    <VALUE Lang="cn">一个打扮奇怪的人，偷走了我们的补给物资.</VALUE>
    <VALUE Lang="cn">被偷走的物资中，也有以前委托调查的药物…</VALUE>
    <VALUE Lang="cn">马上去夺回被偷走的东西!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_5_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_6_0">
    <VALUE Lang="cn">上次的那些家伙，又再次偷走了我们的补给物资.</VALUE>
    <VALUE Lang="cn">马上去夺回被偷走的东西!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_7_0">
    <VALUE Lang="cn">上一次委托我的成分调查结果已经出来了.</VALUE>
    <VALUE Lang="cn">稍等一下~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_7_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_8_0">
    <VALUE Lang="cn">嗯….这里!</VALUE>
    <VALUE Lang="cn">好像是此成分对商人们的大脑产生了反应，让他们变得疯狂.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_8_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_9_0">
    <VALUE Lang="cn">你是想让我追踪此信息的发信地点?</VALUE>
    <VALUE Lang="cn">稍等一下~</VALUE>
    <VALUE Lang="cn">马上就好.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_9_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0">
    <VALUE Lang="cn">你好~ 我是魔术宠物专门训练师. 找我有什么事吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_1">
    <VALUE Lang="cn">商店贩售</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_2">
    <VALUE Lang="cn">雇佣宠物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_3">
    <VALUE Lang="cn">训练师的委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_4">
    <VALUE Lang="cn">训练师的委托 (重复)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_5">
    <VALUE Lang="cn">无法舍弃的依恋</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_6">
    <VALUE Lang="cn">无法找到特殊的方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_7">
    <VALUE Lang="cn">[每日限定] 变异的线索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_1_0_8">
    <VALUE Lang="cn">转交变异之核</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_10_0">
    <VALUE Lang="cn">其他搜查组好像发现了能够随意驯服它们的人.</VALUE>
    <VALUE Lang="cn">或者..能帮我找到那个人并询问驯服动物的方法吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_10_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_11_0">
    <VALUE Lang="cn">是吗..?</VALUE>
    <VALUE Lang="cn">…我真的该放弃了吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_11_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_12_0">
    <VALUE Lang="cn">喂，说你呢~</VALUE>
    <VALUE Lang="cn">难道你对那些动物突然变异不觉得好奇吗?</VALUE>
    <VALUE Lang="cn">我好像在死掉的动物身上看到了奇怪的核. 我对此感到非常的好奇.</VALUE>
    <VALUE Lang="cn">你能帮我找点变异之核过来吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_12_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_13_0">
    <VALUE Lang="cn">谢谢你~!</VALUE>
    <VALUE Lang="cn">调查这些东西，应该能找到点线索.</VALUE>
    <VALUE Lang="cn">那么，下次再拜托你了~!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_13_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_2_0">
    <VALUE Lang="cn">如果想要雇佣魔术宠物，需要优先学习宠物魔术学. 你是否学过宠物魔术?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_2_0_1">
    <VALUE Lang="cn">是的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_2_0_2">
    <VALUE Lang="cn">不是</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_3_0">
    <VALUE Lang="cn">很遗憾，你还没有学习宠物魔术学. 如果有兴趣你可以试着学一学.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_4_0">
    <VALUE Lang="cn">我先给你简单说明一下有关宠物魔术学.</VALUE>
    <VALUE Lang="cn">你所雇佣的战斗宠物，随着你自身的能力值的强化，它们也将会变得更强大. 而且可以通过指令技能，在适当的场合命令战斗宠物使用它们独有的四种技能. 而且每只战斗宠物都很可爱哦. 那么~现在让我们看看每只战斗宠物的特征吧?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_4_0_1">
    <VALUE Lang="cn">询问有关老虎.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_4_0_2">
    <VALUE Lang="cn">询问有关花猫.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_4_0_3">
    <VALUE Lang="cn">询问有关猫头鹰.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_5_0">
    <VALUE Lang="cn">魔术宠物 老虎</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">指令1. 1.5秒内 拉近目标, 移动速度 -30%, HP吸收 +10%</VALUE>
    <VALUE Lang="cn">指令2. 1.5秒内 移动速度 -20%, HP吸收 +10%,, 技能射程 -70</VALUE>
    <VALUE Lang="cn">指令3. 1.5秒内 迅速接近目标, HP吸收 +10%,, 固定目标, 禁用药水</VALUE>
    <VALUE Lang="cn">指令4. 0.8秒内 昏厥, HP吸收 +10%, 防御力 -10%</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">宠物具有攻击型技能.</VALUE>
    <VALUE Lang="cn">是不是很想与老虎一起冒险呢??</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_5_0_1">
    <VALUE Lang="cn">雇佣老虎.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_5_0_2">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_6_0">
    <VALUE Lang="cn">魔术宠物 花猫</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">指令1. 1.5秒内 每秒+100, 移除debuff效果, 防止状态异常/恢复</VALUE>
    <VALUE Lang="cn">指令2. 1.5秒内 吸收物理伤害+10%, 防御力+5%, HP+MP+SP恢复率0.01%</VALUE>
    <VALUE Lang="cn">指令3. 2秒内 攻击力 +15%, 命中率 +30</VALUE>
    <VALUE Lang="cn">指令4. 1秒内 吸收魔法伤害+10%, HP恢复率 +0.2%, 抗性+20, 攻击速度+20%, 移动速度+20%</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">宠物具有buff型技能.</VALUE>
    <VALUE Lang="cn">是不是很想与花猫一起冒险呢?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_6_0_1">
    <VALUE Lang="cn">雇佣花猫.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_6_0_2">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_7_0">
    <VALUE Lang="cn">魔术宠物 猫头鹰</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">指令1. 2秒内 防御-10%, 攻击速度 -20%, HP吸收 +10%,</VALUE>
    <VALUE Lang="cn">指令2. 2秒内 防御-10%, 技能延迟+10%, HP吸收 +10%</VALUE>
    <VALUE Lang="cn">指令3. 1.5秒内 防御-30%, 命中 -45, 攻击力 -30%, HP吸收 +10%,</VALUE>
    <VALUE Lang="cn">指令4. 0.8秒内 防御-10%, 禁用技能, 禁用药水, HP吸收 +10%</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">宠物具有debuff型技能.</VALUE>
    <VALUE Lang="cn">是不是很想与猫头鹰一起冒险呢?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_7_0_1">
    <VALUE Lang="cn">雇佣猫头鹰.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_7_0_2">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_8_0">
    <VALUE Lang="cn">请问...</VALUE>
    <VALUE Lang="cn">在附近遭到动物们攻击的人是你吧?</VALUE>
    <VALUE Lang="cn">我想要训练它们.</VALUE>
    <VALUE Lang="cn">你能帮助我吗?</VALUE>
    <VALUE Lang="cn">帮我捕获各10只动物过来~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_8_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_9_0">
    <VALUE Lang="cn">我作为动物专家受到了很大的打击.</VALUE>
    <VALUE Lang="cn">如果无法驯服也就没办法了.</VALUE>
    <VALUE Lang="cn">帮我消灭它们.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_tricker_animal.ntk_9_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper1.ntk_1_0">
    <VALUE Lang="cn">我专门提供药物给学生。有什么需要我帮忙的，请尽管说，不用客气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper1.ntk_1_0_1">
    <VALUE Lang="cn">物品交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper1.ntk_1_0_2">
    <VALUE Lang="cn">设为起点位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper2.ntk_1_0">
    <VALUE Lang="cn">好久没见到人类了。有什么问题，请尽管来找我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper2.ntk_1_0_1">
    <VALUE Lang="cn">物品交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_infinitystairs.ntk_1_0">
    <VALUE Lang="cn">先做好完全准备，否则您会后悔的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_infinitystairs.ntk_1_0_1">
    <VALUE Lang="cn">物品贩售</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0">
    <VALUE Lang="cn">嘿，新生！你属于哪部门的？</VALUE>
    <VALUE Lang="cn">我会给你你部门里使用的武器。告诉我，你是终极部的也可以使用它。但是，武器将只提供给学生谁达到10级以上的人。</VALUE>
    <VALUE Lang="cn">当你达到30级，50级和70级时，我会再给您换个更好的武器，别忘了来拿你的武器。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_1">
    <VALUE Lang="cn">剑道部新成员向大家招呼！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_10">
    <VALUE Lang="cn">申请新手武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_11">
    <VALUE Lang="cn">新忍术部成员进行礼貌的招呼</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_12">
    <VALUE Lang="cn">作为一个魔术部的新成员有礼貌的打招呼.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_2">
    <VALUE Lang="cn">我会给你，你的圈子使用的武器。告诉我，你是属于！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_3">
    <VALUE Lang="cn">弓箭部新成员向大家招呼！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_4">
    <VALUE Lang="cn">至尊级的也可以使用它。然而，武器将只提供给学生谁达到10级后，我会当你达到30级，50和70，因此换到一个更好的武器，别忘了来拿你的武器。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_5">
    <VALUE Lang="cn">新超能部成员进行礼貌的招呼</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_6">
    <VALUE Lang="cn">告诉他，您是终极部的剑道高手。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_7">
    <VALUE Lang="cn">告诉他，您是终极部的格斗高手。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_8">
    <VALUE Lang="cn">告诉他，您是终极部的弓箭高手。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_0_9">
    <VALUE Lang="cn">告诉他，您是终极部的气功高手。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1">
    <VALUE Lang="cn">新生的等级需为30级或30级以上，才能得到合适的武器唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_1">
    <VALUE Lang="cn">我想要适合我的剑道部专用武器。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_2">
    <VALUE Lang="cn">我想要适合我的格斗部专用武器。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_3">
    <VALUE Lang="cn">我想要适合我的弓箭部专用武器。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_4">
    <VALUE Lang="cn">我想要适合我的气功部专用武器。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_5">
    <VALUE Lang="cn">我想要适合我的超能部专用武器。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_6">
    <VALUE Lang="cn">我想要适合我的忍术部专用武器。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_1_7">
    <VALUE Lang="cn">我想要一个适合我的魔术师的武器.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_2">
    <VALUE Lang="cn">您是新生吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_1_2_1">
    <VALUE Lang="cn">听取他的故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_10_0">
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_11_0">
    <VALUE Lang="cn">能够唤醒世界的沉睡，并超越时空间的强大咒语时气功部最终的研磨目标。气功部的基本功就从‘棒子’开始练起吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_11_0_1">
    <VALUE Lang="cn">领取一般型 'Staff'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_11_0_2">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0">
    <VALUE Lang="cn">我可以看到你已经变得更强大了，很快就会需要新的武器。一旦你到达30，50和70级时，请回到我身边来交换你的武器。另外，退还或更换是不可以的。知道吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_1">
    <VALUE Lang="cn">兑换 Lv. 30 'Staff'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_2">
    <VALUE Lang="cn">兑换 Lv. 50 'Staff'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_3">
    <VALUE Lang="cn">兑换 power type spear.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_4">
    <VALUE Lang="cn">兑换 spirit type staff.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_5">
    <VALUE Lang="cn">兑换敏捷类型的Lance.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_12_0_6">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_13_0">
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0">
    <VALUE Lang="cn">超能部用枪是为了要迅速压制敌人。您要哪种武器呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0_1">
    <VALUE Lang="cn">枪支-敏捷型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0_2">
    <VALUE Lang="cn">枪支-力量型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0_3">
    <VALUE Lang="cn">枪支-精神型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_14_0_4">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0">
    <VALUE Lang="cn">我可以看到你已经变得更强大了，很快就会需要新的武器。一旦你到达30，50和70级时，请回到我身边来交换你的武器。另外，退还或更换是不可以的。知道吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_1">
    <VALUE Lang="cn">兑换 Lv. 30 Dex type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_10">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_2">
    <VALUE Lang="cn">兑换 Lv. 30 Power type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_3">
    <VALUE Lang="cn">兑换 Lv. 30 Spirit type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_4">
    <VALUE Lang="cn">兑换 Lv. 50 Dex type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_5">
    <VALUE Lang="cn">兑换 Lv. 50 Power type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_6">
    <VALUE Lang="cn">兑换 Lv. 50 Spirit type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_7">
    <VALUE Lang="cn">兑换 Lv. 70 Dex type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_8">
    <VALUE Lang="cn">兑换 Lv. 70 Power type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_9">
    <VALUE Lang="cn">兑换 Lv. 70 Spirit type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_16_0">
    <VALUE Lang="cn">…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_17_0">
    <VALUE Lang="cn">通常新生练到10级就可以来找我领取武器。尚未符合资格的学生请继续加油哟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_17_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_18_0">
    <VALUE Lang="cn">你还没有达到10级。</VALUE>
    <VALUE Lang="cn">这是一块蛋糕，成为10级后，我会给你一个不错的武器作为礼物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_18_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_19_0">
    <VALUE Lang="cn">…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_19_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0">
    <VALUE Lang="cn">剑术是一个非常高的智力研究领域，可培养一个人的身体和精神。你想使用哪个武器？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_1">
    <VALUE Lang="cn">'Sword' 敏捷型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_2">
    <VALUE Lang="cn">'Blade' 力量型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_3">
    <VALUE Lang="cn">'Vital Sword' 精神型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_4">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0">
    <VALUE Lang="cn">忍术部是利用固定石力量和自古流传下来的法术，在任何情况下都可以制服敌人的超强人气职业。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_1">
    <VALUE Lang="cn">敏捷型 "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_2">
    <VALUE Lang="cn">力量型 "Scythe"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_3">
    <VALUE Lang="cn">精神型 "Shuriken"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_4">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0">
    <VALUE Lang="cn">我可以看到你已经变得更强大了，很快就会需要新的武器。一旦你到达30，50和70级时，请回到我身边来交换你的武器。另外，退还或更换是不可以的。知道吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_1">
    <VALUE Lang="cn">兑换 30 Lv. "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_10">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_2">
    <VALUE Lang="cn">兑换 30 Lv. "Scythe"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_3">
    <VALUE Lang="cn">兑换 30 Lv. "Shuriken"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_4">
    <VALUE Lang="cn">兑换 50 Lv. "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_5">
    <VALUE Lang="cn">兑换 50 Lv. "Scythe"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_6">
    <VALUE Lang="cn">兑换 50 Lv. "Shuriken"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_7">
    <VALUE Lang="cn">兑换 70 Lv. "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_8">
    <VALUE Lang="cn">兑换 70 Lv. "Scythe"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_9">
    <VALUE Lang="cn">兑换 70 Lv. "Shuriken"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_22_0">
    <VALUE Lang="cn">…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0">
    <VALUE Lang="cn">魔术师使用轻巧的双手和一些戏法击败他们的敌人. 你想要什么样的武器？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_1">
    <VALUE Lang="cn">戏法魔术师的“Cube”</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_2">
    <VALUE Lang="cn">驯服魔术师的“Whip”</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_3">
    <VALUE Lang="cn">幻觉魔术师的“Magic Wand”</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_4">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0">
    <VALUE Lang="cn">当你的等级到达了30, 50, 70级的时候再来找我,就能帮你把现有的武器换成更强大的.找我对话的时候不要忘了把你的武器从装备栏里卸下来,放在背包了哦. ^__^</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_1">
    <VALUE Lang="cn">换取 30级 Cube</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0_10">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
