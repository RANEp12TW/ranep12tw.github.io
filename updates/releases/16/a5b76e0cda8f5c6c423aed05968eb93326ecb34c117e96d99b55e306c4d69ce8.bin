  <SENTENSE Ver="1" Id="2013_halloween08.ntk_8_0_9">
    <VALUE Lang="cn">西瓜</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0">
    <VALUE Lang="cn">噼里啪啦！知道我是谁吗？答对就给奖。噢！不！世上没有免费的东西！我要吃甜点！我不能没有糖果。我不要小的！我要大颗的！</VALUE>
    <VALUE Lang="cn">5 颗 Halloween 糖果 = 谜题试卷 I</VALUE>
    <VALUE Lang="cn">5 颗 Halloween 糖果 + 1个大Halloween银色棒棒糖= 谜题试卷r II</VALUE>
    <VALUE Lang="cn">5 颗 Halloween 糖果 + 1个大Halloween金色棒棒糖 =谜题试卷 III</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0_4">
    <VALUE Lang="cn">5 颗糖果兑换 谜题试卷 I.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0_5">
    <VALUE Lang="cn">5 颗糖果 1 个大银色棒棒糖 兑换 谜题试卷 II.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween08.ntk_9_0_6">
    <VALUE Lang="cn">5 颗糖果 1 个大金色棒棒糖 兑换 谜题试卷 III</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0">
    <VALUE Lang="cn">哈喽！您喜欢吃糖吗？不喜欢的话，可以把它给我吗？</VALUE>
    <VALUE Lang="cn">2颗Halloween 糖果 = Pet skin card [Jack-o’-Lantern] (15D)</VALUE>
    <VALUE Lang="cn">1个大的Halloween银色棒棒糖 = 1 南瓜礼盒</VALUE>
    <VALUE Lang="cn">1个大的 Halloween金色棒棒糖 = Death bike (30D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_1">
    <VALUE Lang="cn">2颗糖果 兑换 Pet skin card</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_2">
    <VALUE Lang="cn">Big silver lollipop 兑换 Pumpkin box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_3">
    <VALUE Lang="cn">Big gold lollipop 兑换 Death bike(30D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_4">
    <VALUE Lang="cn">交换糖果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0">
    <VALUE Lang="cn">看你费尽千辛万苦终于来到这里。</VALUE>
    <VALUE Lang="cn">现在总算知道要找到我是多么不容易的吧！</VALUE>
    <VALUE Lang="cn">现在就让你瞧瞧利用勋章跟卡片变成其它道具的魔法！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0_1">
    <VALUE Lang="cn">兑换特别物品需要什么样的材料呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0_2">
    <VALUE Lang="cn">我拿到材料了！给我特别物品吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_2_0">
    <VALUE Lang="cn">Pierrot Badge 50个 + Joker Badge 40个</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">= Jester King's Hat</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Pierrot Badge 75个 + Joker Badge 50个 +</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Joker Card 50个</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">= Joker Look Box (7D)</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Pierrot Badge 100个 + Joker Badge 75个 +</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Joker Card 7个</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">= Joker Bike (7D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_2_0_1">
    <VALUE Lang="cn">好！现在给我物品吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0">
    <VALUE Lang="cn">您想要那种道具呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_1">
    <VALUE Lang="cn">我要Jester King的帽子。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_2">
    <VALUE Lang="cn">我想要Joker Look Box！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_3">
    <VALUE Lang="cn">我想要Joker Bike！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_0">
    <VALUE Lang="cn">哇！您打败了 Medusa了！ 去收集奖杯吧！</VALUE>
    <VALUE Lang="cn">我会帮您合成的。</VALUE>
    <VALUE Lang="cn">________________________________________________________</VALUE>
    <VALUE Lang="cn">[选单]</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Hair of Medusa (30ea) + Snake Scale (30ea)</VALUE>
    <VALUE Lang="cn">+ Piece of Snake Stone (30ea) + Vitality of Medusa (10ea)</VALUE>
    <VALUE Lang="cn">+ 100,000 Gold = Medusa Trophy A\r\</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_0_1">
    <VALUE Lang="cn">合成奖杯</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1">
    <VALUE Lang="cn">您知道2013年是蛇年吗？</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">现在校园充斥着Medusa蛇妖的气息，牠不停地在Ran世界里制造破坏。</VALUE>
    <VALUE Lang="cn">我们需要各位同学帮忙，一起消灭Medusa，拯救校园。</VALUE>
    <VALUE Lang="cn">我是一个伤兵，没办法跟你一起去。有什么其它问题再来问我吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_1">
    <VALUE Lang="cn">我该如何召唤Medusa呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_2">
    <VALUE Lang="cn">请提示我该如何消灭 Medusa。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_3">
    <VALUE Lang="cn">我已经消灭了Medusa！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0">
    <VALUE Lang="cn">想要找到 Medusa必须使用Flute！</VALUE>
    <VALUE Lang="cn">学校的怪物身上有机会可找到这些笛子Flute！</VALUE>
    <VALUE Lang="cn">记得使用不同的笛子可以召唤不同的Medusa奖励也会有差异</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0_1">
    <VALUE Lang="cn">噢！我了解！</VALUE>
    <VALUE Lang="cn">您能提示我关于如何能打败Medusa吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0_2">
    <VALUE Lang="cn">我已经消灭了Medusa！我可以拿奖励了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0">
    <VALUE Lang="cn">Medusa拥有石化的技能效果大家要小心</VALUE>
    <VALUE Lang="cn">如果使用抗石化头盔就可以有防护效果</VALUE>
    <VALUE Lang="cn">合成时还可有其他效果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0_1">
    <VALUE Lang="cn">请再告诉我一次召唤Medusa的方法。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0_2">
    <VALUE Lang="cn">我已经消灭了Medusa！我可以拿奖励了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_4_0">
    <VALUE Lang="cn">哇！您已经歼灭了Medusa！</VALUE>
    <VALUE Lang="cn">快快收集奖杯吧！成后把战利品带来使用合成可以获得奖励!</VALUE>
    <VALUE Lang="cn">合成有失败的机率!Hair of Medusa (30ea) + Snake Scale (30个) + Piece of Snake Stone (30个) + Vitality of Medusa (10个)+ 100,000 Gold = Medusa Trophy A</VALUE>
