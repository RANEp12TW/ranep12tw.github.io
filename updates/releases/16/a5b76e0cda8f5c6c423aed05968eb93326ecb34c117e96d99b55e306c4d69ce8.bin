    <VALUE Lang="cn">兑换 Astral Gravel(15D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_event02.ntk_1_0">
    <VALUE Lang="cn">嘿~有什么需要我帮的吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_event02.ntk_1_0_1">
    <VALUE Lang="cn">交换Astral Fragment(15D)</VALUE>
