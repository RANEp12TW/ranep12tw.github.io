  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_6_0">
    <VALUE Lang="cn">只要让隧道里的那些猛兽们知道，我们是比他们强的就行了。集中精神，无视它们的存在，直接通过隧道吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_knight.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
