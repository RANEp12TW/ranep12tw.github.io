  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_45_0_9">
    <VALUE Lang="cn">取得改造的Vital Bow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_46_0">
    <VALUE Lang="cn">应该需要用到加工线String…</VALUE>
    <VALUE Lang="cn">加工线String可以从Skating Master</VALUE>
    <VALUE Lang="cn">的身上取得。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_46_0_1">
