  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_3_0">
    <VALUE Lang="cn">忍术部是利用固定之石力量和自古流传下来的术法,在任何情况下都可制伏敌人技巧闻名的职业</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_3_1">
    <VALUE Lang="cn">你还有很多东西需要学习,慢慢来不要着急。先去完成其它校内任务再来找我吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_3_1_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
