    <VALUE Lang="cn">Urga的测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_urga.ntk_2_0">
    <VALUE Lang="cn">嗯， 除非它是一条好吃的鲑鱼，不然我是不会…… 噢耶！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_urga.ntk_2_0_1">
