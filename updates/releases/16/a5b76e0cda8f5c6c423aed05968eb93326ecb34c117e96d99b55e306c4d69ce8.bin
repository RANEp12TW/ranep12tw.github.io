  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_38_0">
    <VALUE Lang="cn">…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_39_0">
