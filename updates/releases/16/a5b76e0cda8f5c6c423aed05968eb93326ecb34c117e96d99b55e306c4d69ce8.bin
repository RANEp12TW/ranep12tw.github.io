    <VALUE Lang="cn">请选择想要的类型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_34_0_1">
    <VALUE Lang="cn">选择 Sword</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_34_0_2">
