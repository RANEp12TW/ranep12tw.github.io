  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_29_0_3"><VALUE Lang="tw">兌換 煙幕（127級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE><VALUE Lang="id">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE><VALUE Lang="cn">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE><VALUE Lang="th">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_29_0_4">
    <VALUE Lang="cn">学习Titan's Force</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_29_0_6">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_3_0">
    <VALUE Lang="cn">忍术部是利用固定之石力量和自古流传下来的术法，在任何情况下都可制伏敌人技巧闻名的职业。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_3_1">
    <VALUE Lang="cn">您还有很多东西需要学习。慢慢来不要着急。先去完成其它校内任务再来找我吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_3_1_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_30_0">
    <VALUE Lang="cn">噢！恭喜您获得灵珠。请来挑一个您想学的技能文书吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_30_0_1"><VALUE Lang="tw">兌換 黑洞（147級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="id">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="cn">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="th">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_30_0_2"><VALUE Lang="tw">兌換 迷醉（147級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="id">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="cn">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="th">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_30_0_3"><VALUE Lang="tw">兌換 火焰傳送（137級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Fireport (Lv137, Class=12288, Item=362/55)</VALUE><VALUE Lang="id">Skill book: Fireport (Lv137, Class=12288, Item=362/55)</VALUE><VALUE Lang="cn">Skill book: Fireport (Lv137, Class=12288, Item=362/55)</VALUE><VALUE Lang="th">Skill book: Fireport (Lv137, Class=12288, Item=362/55)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_30_0_4">
    <VALUE Lang="cn">学习Titan's Vigor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_30_0_5">
    <VALUE Lang="cn">学习Dragon Fire Ⅱ</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_30_0_6">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_31_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_32_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_33_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_34_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_35_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_36_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_37_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_38_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_39_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_4_0">
    <VALUE Lang="cn">仔细听！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_4_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_40_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_41_0">
    <VALUE Lang="cn">每当角色成功晋级，就会发送了3个能力点数。依据该点数的各个属性分配，角色会以相同方式被朔造定型。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_41_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_42_0">
    <VALUE Lang="cn">如果您集中在敏捷， 将能成为超快速的双剑高手。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_42_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_43_0">
    <VALUE Lang="cn">如果您集中在力量，将能成为强大的大镰刀高手，还能带给敌人超高的伤害量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_43_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_44_0">
    <VALUE Lang="cn">如果您集中在精神，将能成为法术、Shuriken和Toxic bomb的高手。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_44_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_45_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_46_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_47_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_48_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_49_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_5_0">
    <VALUE Lang="cn">忍术部的特征是在任何情况下可以迅速压制敌人。所以记得要尽可能让攻击动作更敏捷，不管在什么情况下，忍术部的攻击是果断敏捷的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_5_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_50_0">
    <VALUE Lang="cn">怎么还没完成学院注册呢？就是因为您都不做好准备，所以才会发生这种事情。先去本馆前面的资料终端机找找看吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_50_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_51_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_52_0">
    <VALUE Lang="cn">新部门刚成立不久，每天都忙得晕头转向。因为突发的异变事件，害得整个学院都不得安宁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_52_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_53_0">
    <VALUE Lang="cn">在学院四周徘徊的那些人，原本跟您一样都是好人。但异变发生之后，举止越来越怪异，甚至到处破坏东西。请您不要对他们心软，也要努力找出异变的真正原因。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_53_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_54_0">
    <VALUE Lang="cn">要是这里没有发生异变，我也不会来到这里了。我会尽量协助您，有问题尽管问我唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_54_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_55_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_56_0">
    <VALUE Lang="cn">因为异变的恶影响，校外的情况比校内更为严重。据情报显示，这种现象将持续非常久。在情况好转之前，请您务必小心行事。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_56_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_57_0">
    <VALUE Lang="cn">一旦您申请了外出证，那就代表您将付起全数的责任了！加油！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_57_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_58_0">
    <VALUE Lang="cn">……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_59_0">
    <VALUE Lang="cn">Saint List的部分是小事。当您越接近事实，就会发现更多的真相。虽然现在手边的事情很重要，但希望您可以主动去发掘真相，激发更多的想法。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_59_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_6_0">
    <VALUE Lang="cn">技能点数从0个开始计算，每当角色等级晋级时，就会增加 1个技能点数。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_60_0">
    <VALUE Lang="cn">我知道您一定感到很困惑。前往Trading Hole去拜访Sia。她会告诉您更多圣徒列表的事情。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_60_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_nin.ntk_61_0">
    <VALUE Lang="cn">噢！恭喜您获得灵珠。请来挑一个您想学的技能文书吧。</VALUE>
  </SENTENSE>
