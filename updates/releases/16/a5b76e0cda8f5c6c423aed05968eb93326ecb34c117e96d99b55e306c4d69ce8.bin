    <VALUE Lang="cn">选择 Vital Sword</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_35_0">
    <VALUE Lang="cn">请选择想要的类型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_35_0_1">
    <VALUE Lang="cn">选择 Bow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_35_0_2">
    <VALUE Lang="cn">选择 Strong Bow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_35_0_3">
    <VALUE Lang="cn">选择 Vital Bow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_36_0">
    <VALUE Lang="cn">请选择想要的类型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_36_0_1">
    <VALUE Lang="cn">选择 Staff</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_37_0">
    <VALUE Lang="cn">请选择想要的类型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_37_0_1">
    <VALUE Lang="cn">选择Gun</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_37_0_2">
    <VALUE Lang="cn">选择Railgun</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_37_0_3">
    <VALUE Lang="cn">选择Portal Gun</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_38_0">
    <VALUE Lang="cn">你说戒指？我正需要它！你可以帮我取得吗？</VALUE>
    <VALUE Lang="cn">此款式可以从Hell Scissors身上取得唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_38_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_39_0">
    <VALUE Lang="cn">你找来了啊...那么，我就给你你想要的东西！要好好使用啊</VALUE>
    <VALUE Lang="cn">！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_39_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_4_0">
    <VALUE Lang="cn">我们科学部平常都在本馆地下进行研究的活动。</VALUE>
    <VALUE Lang="cn">所以，你们几乎没什么机会可以看到我们。</VALUE>
    <VALUE Lang="cn">我们和其他社团不同的是，我们在接受Saint foundation的任务指令。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_4_0_1">
    <VALUE Lang="cn">请问您专攻哪门科系的呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_40_0">
    <VALUE Lang="cn">需要的东西还真多…项链必须要有图案才能制作。或许在Sacred Gate Hole出没的Bomber Clown身上可以取得…应该可以吧…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_40_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_41_0">
    <VALUE Lang="cn">"我果然没有记错啊.. 等我一下我马上做给你</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_41_0_1">
    <VALUE Lang="cn">请稍等</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_42_0">
    <VALUE Lang="cn">好了.. 不过因为是第一次制作的东西所以我不能保障他的功效… 但有总比没有好吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_42_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_43_0">
    <VALUE Lang="cn">如想要更强力的武器就需要有更特殊的材料。</VALUE>
    <VALUE Lang="cn">材料的话，您可以从Got Milk的身上取得。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_43_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_44_0">
    <VALUE Lang="cn">…....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_45_0">
    <VALUE Lang="cn">请选择想要的武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_45_0_1">
    <VALUE Lang="cn">我需要敏捷型武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_45_0_10">
    <VALUE Lang="cn">取得改造的Spear</VALUE>
  </SENTENSE>
