  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_34_0_2">
    <VALUE Lang="cn">'지령지원격'를 얻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_34_0_3">
    <VALUE Lang="cn">물품으로 교환한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_34_0_4">
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_35_0">
    <VALUE Lang="cn">정령구슬을 지니고 있다면 어느 정도 인정을 받았다는 얘기군. 자, 원하는 기술을 골라 봐</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
