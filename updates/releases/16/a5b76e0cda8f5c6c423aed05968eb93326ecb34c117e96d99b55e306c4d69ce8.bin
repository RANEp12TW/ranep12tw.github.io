  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_11_0">
    <VALUE Lang="cn">噢是的。我只是工读生，说来羞愧，我懂得其实不多。不过，谈到食品业，例如咖啡甜点，我有着十足的信心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_11_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_12_0">
    <VALUE Lang="cn">我能煮很棒的咖啡！情况稳定之后，我想要经营一家属于我自己的咖啡店。</VALUE>
    <VALUE Lang="cn">看到城市变成这样，我感到非常地难过。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_12_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_13_0">
    <VALUE Lang="cn">资源回收不简单。 这也是为什么我们需要大家一起来做的原因。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_13_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_14_0">
    <VALUE Lang="cn">哎呀！谢谢您！真快！我以为会不够用，所以又申请了一次。总之，托您的福，我可以高枕无忧好一阵子了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_14_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_2_0">
    <VALUE Lang="cn">噢是的。我只是工读生，说来羞愧，我懂得其实不多。不过，谈到食品业，例如咖啡甜点，我有着十足的信心。我能煮很棒的咖啡！情况稳定之后，我想要经营一家属于我自己的咖啡店。</VALUE>
    <VALUE Lang="cn">看到城市变成这样，我感到非常地难过。为了减少混乱现象，我们可以贡献的部分就是促进资源回收。</VALUE>
    <VALUE Lang="cn">这不简单。 这也是为什么我们需要大家一起来做的原因。您愿意一起收集“可回收的垃圾”，并交换好吃的 Ice Cream吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_2_0_1">
    <VALUE Lang="cn">接收请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_2_0_6">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_3_0">
    <VALUE Lang="cn">고마워요</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">재료를 찾아주시면</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">그 재료로 만든 핫도그는 제일 처음 드릴께요</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_4_0">
    <VALUE Lang="cn">정말 고마워요-</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">이런거 그냥 말로만 해서는 안되겠죠?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">잠깐만 기다리세요</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">금방 따끈한 핫도그를...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">자, 여기 드세요</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">정말 고마웠어요-</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_5_0">
    <VALUE Lang="cn">음... 그러네요</VALUE>
