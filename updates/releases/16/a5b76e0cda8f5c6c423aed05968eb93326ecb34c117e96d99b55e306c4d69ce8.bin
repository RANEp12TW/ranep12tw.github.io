    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">*</VALUE>
    <VALUE Lang="cn">1,000 kill</VALUE>
    <VALUE Lang="cn">-&gt; Fresh water</VALUE>
    <VALUE Lang="cn">8,000 kill</VALUE>
    <VALUE Lang="cn">-&gt; Costume (1D) 或是 Fresh water (Item to compound potion)</VALUE>
    <VALUE Lang="cn">50,000 kill</VALUE>
    <VALUE Lang="cn">-&gt; Costume (7D) or Taxi c</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_4_0">
