  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_3_0">
    <VALUE Lang="cn">圣财团直属Laboratory - Root Hole、Head Office</VALUE>
    <VALUE Lang="cn">监狱Laboratory - Sacred Private Prison</VALUE>
    <VALUE Lang="cn">学院Laboratory - Sacred Gate、Mystic Peak、Phoenix、Leonine</VALUE>
    <VALUE Lang="cn">美洲Laboratory - Alaska、Lio De Janeiro</VALUE>
    <VALUE Lang="cn">欧亚大陆Laboratory - Jakarta</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_3_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_4_0">
    <VALUE Lang="cn">绝对起点的研究</VALUE>
    <VALUE Lang="cn">如同物体的组成要素有原子和电子。那样的世界中心起核心作用之后，所产生的基准点就叫做‘绝对起点’。</VALUE>
    <VALUE Lang="cn">以空间和时间区分的每个范围都有~~的存在。它们有着划分邻接范围与边界范围的作用，甚至有保护区域内的效果。</VALUE>
    <VALUE Lang="cn">不过，无法非常的肯定的是，现在的绝对起点是否仍保有它的本质。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_4_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_5_0">
    <VALUE Lang="cn">圣石的研究报告</VALUE>
    <VALUE Lang="cn">在绝对起点的周围，它有着天线的作用。不太确定每个范围是否有圣石的数值出现，不过可以确定的是，每个圣石都有着不同的用处。可是，不同时间和不同空间的圣石会相互排斥。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_5_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0">
    <VALUE Lang="cn">该终端机具有共享圣财团的资料机能。</VALUE>
    <VALUE Lang="cn">若您输入了文件里的任何资料，您将可以进行搜寻圣财团的情报。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_1">
    <VALUE Lang="cn">文件的输入件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_2">
    <VALUE Lang="cn">文件的输入件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_3">
    <VALUE Lang="cn">文件的输入件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_6_0_4">
    <VALUE Lang="cn">文件的输入件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_7_0">
    <VALUE Lang="cn">正在阅读输入的文件，请稍微等一下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_7_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_8_0">
    <VALUE Lang="cn">文件审核完成。您可透过资料功能来开启阅读该档案。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_8_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_9_0">
    <VALUE Lang="cn">复制灵-</VALUE>
    <VALUE Lang="cn">一般来说，被认定是敌人的生命体，几乎都是以正常的精神与肉体来做成的基础复制品。在本实验里，我们称它们为复制灵。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_9_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_1_0">
    <VALUE Lang="cn">30楼出入控制型终端机。</VALUE>
    <VALUE Lang="cn">要上30楼必须有该地区的密码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_1_0_1">
    <VALUE Lang="cn">寻找密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_1_1">
    <VALUE Lang="cn">30楼出入控制型终端机。</VALUE>
    <VALUE Lang="cn">要上30楼必须有该地区的密码。请输入密码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_1_1_1">
    <VALUE Lang="cn">输入密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_1_2">
    <VALUE Lang="cn">已经认证了30楼出入。允许出入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_2_0">
    <VALUE Lang="cn">确认密码, 已经认证了30楼出入</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_3_0">
    <VALUE Lang="cn">密码是单词分散的档，此文件在1楼被分散。</VALUE>
    <VALUE Lang="cn">如果要出入，必须搜集分散的档里记录的附文完成密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_3_0_1">
    <VALUE Lang="cn">开始寻找密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_4_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">搜集密码的附文再次通过终端机输入组合的密码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_1_0">
    <VALUE Lang="cn">50楼出入控制型终端机。</VALUE>
    <VALUE Lang="cn">要上50楼必须有该地区的ID和密码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_1_0_1">
    <VALUE Lang="cn">搜寻ID和密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_1_1">
    <VALUE Lang="cn">50楼出入控制型终端机。</VALUE>
    <VALUE Lang="cn">要上50楼必须有该地区的ID和密码。请输入ID和密码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_1_1_1">
    <VALUE Lang="cn">输入ID和密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_1_2">
    <VALUE Lang="cn">50楼出入已经验证了。允许出入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_2_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">ID和密码已确认。验证了50楼出入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_2_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_3_0">
    <VALUE Lang="cn">把ID和密码的单词分散后给了有关要员。如果要出入那必须从有关要员那里受到允许，完成密码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal50f.ntk_3_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_1_0">
    <VALUE Lang="cn">"90楼出入控制型终端机。</VALUE>
    <VALUE Lang="cn">要上90楼必须有该地区的ID和密码。 "</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_1_0_1">
    <VALUE Lang="cn">搜寻ID和密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_1_1">
    <VALUE Lang="cn">90楼出入控制型终端机。</VALUE>
    <VALUE Lang="cn">要上90楼必须有该地区的ID和密码。请输入ID和密码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_1_1_1">
    <VALUE Lang="cn">输入ID和密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_1_2">
    <VALUE Lang="cn">90楼出入已经验证了。允许出入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_2_0">
    <VALUE Lang="cn">ID和密码已确认。验证了90楼出入</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_2_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_3_0">
    <VALUE Lang="cn">把ID和密码的单词分散后给了有关要员。如果要出入那必须从有关要员那里受到允许，完成密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal90f.ntk_3_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_0">
    <VALUE Lang="cn">限制地区出入的电梯</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_1">
    <VALUE Lang="cn">限制地区出入的电梯。请输入密码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_1_1">
    <VALUE Lang="cn">请输入密码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_2">
    <VALUE Lang="cn">限制地区出入的电梯。已验证完成。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_2_0">
    <VALUE Lang="cn">密码验证完成。允许出入此地。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0">
    <VALUE Lang="cn">嘿！哈咯！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0_1">
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0_2">
    <VALUE Lang="cn">询问关于地下Laboratory的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0_3">
    <VALUE Lang="cn">展示材料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_1_0_4">
    <VALUE Lang="cn">展示零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_10_0">
    <VALUE Lang="cn">刚刚说的朋友就是那种感觉。</VALUE>
    <VALUE Lang="cn">给你一个忠告?</VALUE>
    <VALUE Lang="cn">地下为何变成这样等没有根据的想像之前先想想我现在要做什么.</VALUE>
    <VALUE Lang="cn">不是那么大的存在~ 所谓人类的动物是</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_10_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_11_0">
    <VALUE Lang="cn">啊,是不是找到什么了?</VALUE>
    <VALUE Lang="cn">能给我看吗?</VALUE>
    <VALUE Lang="cn">呵呵?喂~ 这个是不是时间机器啊?</VALUE>
    <VALUE Lang="cn">这里记载的文字有些我也会读,虽然看过…</VALUE>
    <VALUE Lang="cn">是加尼尔文字吧？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_11_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_12_0">
    <VALUE Lang="cn">好象是… 为了跨越什么的设备…</VALUE>
    <VALUE Lang="cn">Vector?</VALUE>
    <VALUE Lang="cn">不知道基准是空间还是时间…</VALUE>
    <VALUE Lang="cn">我可以肯定使用这个可以联系到往其大地方的范围"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_12_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_13_0">
    <VALUE Lang="cn">可是这个现在还不是很完善…</VALUE>
    <VALUE Lang="cn">不完善的同时还不能运作。</VALUE>
    <VALUE Lang="cn">那里有剩余的零件。</VALUE>
    <VALUE Lang="cn">可能把剩余的全部搜集的话就可以找出重要的东西</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_13_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_14_0">
    <VALUE Lang="cn">真的值得尊敬…</VALUE>
    <VALUE Lang="cn">怎么会在这样的施工仓里找到?</VALUE>
    <VALUE Lang="cn">以后开服务中心如何?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_14_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_15_0">
    <VALUE Lang="cn">我不能保证我是软体专家…</VALUE>
    <VALUE Lang="cn">但是这些零件就已经很充分了。进行组合的话可能需要细微的东西。</VALUE>
    <VALUE Lang="cn">问题是…</VALUE>
    <VALUE Lang="cn">不知道如何使用这些…</VALUE>
    <VALUE Lang="cn">应该有使用说明书或待人注意书… 还是开发中制作的资料吧。</VALUE>
    <VALUE Lang="cn">其他人可能比较难开口,但你对这方面比较擅长，所以顺便找找看如何?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_15_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_16_0">
    <VALUE Lang="cn">不是平凡的考勤本，这点知道吧?</VALUE>
    <VALUE Lang="cn">是的,我不管财团的意念如何，异界的意念如何，都与我无关。</VALUE>
    <VALUE Lang="cn">但是… 为了那些虚假的好的目标，不赞成强烈要求其他牺牲的行为。</VALUE>
    <VALUE Lang="cn">那些假面具…最终只是借口而已。洪承日, 如果是那家伙可能会高兴的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_16_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_2_0">
    <VALUE Lang="cn">您应该有很多疑问的……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_2_0_1">
    <VALUE Lang="cn">询问关于他的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_2_0_2">
    <VALUE Lang="cn">询问关于圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_3_0">
    <VALUE Lang="cn">我曾在Sacred Gate Campus 的2年级，并加入了剑道部。虽然不是我的本意，但是还是满不错的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_3_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_4_0">
    <VALUE Lang="cn">别这样看我〜</VALUE>
    <VALUE Lang="cn">我不是一个会说好听话的人，而且我不是会照顾别人的那种类型。</VALUE>
    <VALUE Lang="cn">我不在乎任何人。但由于我的性格，我伤害了许多我的朋友。</VALUE>
    <VALUE Lang="cn">有一天，他被某种迷信给害了... 但我却无法做任何事情…...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_4_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_5_0">
    <VALUE Lang="cn">如果我不阻止他，他就无法恢复正常了。</VALUE>
    <VALUE Lang="cn">我简直不敢相信，他很害怕他的化身形象和记忆......</VALUE>
    <VALUE Lang="cn">所以...我应该这么做...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_5_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_6_0">
    <VALUE Lang="cn">So Seung Il死后我实在是无法离开这个地方…</VALUE>
    <VALUE Lang="cn">但是这不代表这里什么都没有。</VALUE>
    <VALUE Lang="cn">听说这附近肯定有S.F.G的private laboratory…</VALUE>
    <VALUE Lang="cn">这周围的怪物肯定是受到那里的影响或从那里流出来的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_6_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_7_0">
    <VALUE Lang="cn">我个人认为… 实验室的存在已经不会有任何帮助的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_7_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_8_0">
    <VALUE Lang="cn">很多怪物… 但是这些家伙不只是在地下？</VALUE>
    <VALUE Lang="cn">这个程度该是确定了。</VALUE>
    <VALUE Lang="cn">在实验室里进行了生体实验…</VALUE>
    <VALUE Lang="cn">那也是为了制造武器而进行的实验。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_8_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_9_0">
    <VALUE Lang="cn">为什么?成立4个正式教育机关财团的监狱? 以及实验室…</VALUE>
    <VALUE Lang="cn">真的是为了守护我们生活的地方，目的在于防卫吗?</VALUE>
    <VALUE Lang="cn">嘿嘿…</VALUE>
    <VALUE Lang="cn">看吧~ 如果这样想的话容易进入不必要的空想里</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_9_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0">
    <VALUE Lang="cn">这边离太远了…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_1">
    <VALUE Lang="cn">变更起点位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_2">
    <VALUE Lang="cn">请求治疗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_3">
    <VALUE Lang="cn">开启商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_4">
    <VALUE Lang="cn">倾听故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_5">
    <VALUE Lang="cn">请求协助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_6">
    <VALUE Lang="cn">传递发夹</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_1_0_7">
    <VALUE Lang="cn">通知 [Hong Ji Yoon的求助]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_10_0">
    <VALUE Lang="cn">我和Dae Yook站在门前，然后要前往Restroom，但却无法利用正常的方法进去。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_10_0_1">
    <VALUE Lang="cn">回到开始</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_11_0">
    <VALUE Lang="cn">请问您有看见飘在空中的物体吗？如同所见，此地既不稳定，时间是静止的。您应该可以利用它来使用restroom的。 在那儿有些破裂的窗户，透过窗户，您可以到达Toilet。由于这边的诡异时间，我们是可以随意毁坏和搬移任何物体的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_11_0_1">
    <VALUE Lang="cn">回到开始</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_12_0">
    <VALUE Lang="cn">您已经找到了吗？噢！我忘记了！您已经不能再越过这通路了。诡异吧！您可以无限制地进入，但一旦您到达终点，就无法在进行入场了。也许这隧道有什么特别规定吧。总之，还会有一条类似的地方的！别担心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_12_0_1">
    <VALUE Lang="cn">回到开始</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_13_0">
    <VALUE Lang="cn">Lee Da Xu…噢！这个人... Da Xu 是我的朋友，没错！他现在正受失忆之苦吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_14_0">
    <VALUE Lang="cn">他想不起任何事情吗？我想总有一天，他的记忆一定会回来的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_15_0">
    <VALUE Lang="cn">Lee Da Xu 这个人? 他还活着啊？真不敢相信！ Da Xu和我是非常好的朋友…不过他是怎么失忆的呢？如果他需要我的帮助来恢复记忆，请您一定要跟我说唷。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_15_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0">
    <VALUE Lang="cn">问题太多了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0_1">
    <VALUE Lang="cn">询问她是谁？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0_2">
    <VALUE Lang="cn">询问 Head Office Building</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0_3">
    <VALUE Lang="cn">询问 Bathroom</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_2_0_4">
    <VALUE Lang="cn">询问 Restroom</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_3_0">
    <VALUE Lang="cn">很抱歉我还没做自我介绍。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_3_0_1">
    <VALUE Lang="cn">询问有关 Hong Mi Ran</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_4_0">
    <VALUE Lang="cn">噢！您见过我妈？事件发生之后，我都找不到她了。我人现在在这里，请问我妈妈过的还好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_4_0_1">
    <VALUE Lang="cn">询问她是如何过来的？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_5_0">
    <VALUE Lang="cn">我有一个暗恋的学长，他完美到不像地球人。比我更漂亮的女生也都喜欢他。甚至还倒追他。可是，异变发生后，大家都消失不见，学长竟然变成怪物了。我很想守护他，可是我真的不知所措。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_5_0_1">
    <VALUE Lang="cn">询问那位男孩是谁？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_6_0">
    <VALUE Lang="cn">我杀了格斗部部长Joo Seong。</VALUE>
    <VALUE Lang="cn">我没有别的选择，如果我不杀他的话，他会杀死更多的人。我不后悔我这么做。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_6_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_7_0">
    <VALUE Lang="cn">我曾有一个总是在我身边守护我的男朋友。他的名字是Lee Dae Yook。他看过异世界之后，没跟我商量，就跑去了异世界。真的是伤透了我的心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_7_0_1">
    <VALUE Lang="cn">回到开始</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_8_0">
    <VALUE Lang="cn">我不清楚这栋大楼有多少层，但紧急逃生口的楼梯已被毁坏，电梯也故障了。这栋大楼会有10楼以上吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_8_0_1">
    <VALUE Lang="cn">询问更多的讯息</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_9_0">
    <VALUE Lang="cn">小事一件…</VALUE>
    <VALUE Lang="cn">就像研究笔记…</VALUE>
    <VALUE Lang="cn">我已经记不起细节内容了…</VALUE>
    <VALUE Lang="cn">我只记得我很兴奋，因为要去拜访异世界。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_hongjiyoun1.ntk_9_0_1">
    <VALUE Lang="cn">询问Another World怎么去？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0">
    <VALUE Lang="cn">啊？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_1">
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_2">
    <VALUE Lang="cn">交付注册申请单</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_3">
    <VALUE Lang="cn">询问受害内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_4">
    <VALUE Lang="cn">传达新服饰</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_5">
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_1_0_6">
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_2_0">
    <VALUE Lang="cn">谢谢〜处理我文件的人说，它消失了。</VALUE>
    <VALUE Lang="cn">然后，他也跟着消失了。</VALUE>
    <VALUE Lang="cn">现在我不能做任何事情，直到我发现这些表格…</VALUE>
    <VALUE Lang="cn">无论如何，谢谢您了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_2_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_3_0">
    <VALUE Lang="cn">不能说是逃避…</VALUE>
    <VALUE Lang="cn">只是稍微被打住而已…</VALUE>
    <VALUE Lang="cn">我大概需要接受更多的训练来赶上我的同学。</VALUE>
    <VALUE Lang="cn">一切都会好起来的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_3_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_4_0">
    <VALUE Lang="cn">啊！</VALUE>
    <VALUE Lang="cn">谢谢,我会好好用的~</VALUE>
    <VALUE Lang="cn">只要有这个就不会再被那些家伙打！</VALUE>
    <VALUE Lang="cn">等着瞧吧！我会追到的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_4_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_5_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">看样子这里什么都好，可是就是没有游戏区。</VALUE>
    <VALUE Lang="cn">我们是猴子吗？</VALUE>
    <VALUE Lang="cn">继续跳着玩？</VALUE>
    <VALUE Lang="cn">到底是以什么想法制造出这种原始性的气氛…….</VALUE>
    <VALUE Lang="cn">做成一个人安静玩的多好啊~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_5_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_6_0">
    <VALUE Lang="cn">我朋友说他已经为我找到文件了。所以我正在等他。</VALUE>
    <VALUE Lang="cn">嗯……但他一直没来耶。</VALUE>
    <VALUE Lang="cn">您可以帮我拿到那份文件吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_6_0_1">
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_6_0_2">
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_7_0">
    <VALUE Lang="cn">他们不喜欢我，应该是分数的关系。我得比他们更用功念书才行。您可以教我如何念书才会念的又快又好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_7_0_1">
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_7_0_2">
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_8_0">
    <VALUE Lang="cn">谢谢您。</VALUE>
    <VALUE Lang="cn">如果他们有回来的话，他们会来找我的。</VALUE>
    <VALUE Lang="cn">现在我能做的就只有等待。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_8_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_9_0">
    <VALUE Lang="cn">我会在这边一个人好好念书。谢谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_joon1.ntk_9_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
