  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_21_0">
    <VALUE Lang="cn">........</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_22_0">
    <VALUE Lang="cn">反正学生或是老师都会定期考试来测定能力, 希望你不要觉得烦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_22_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_23_0">
    <VALUE Lang="cn">敌人的能力也在变, 稍微有变强, 要顺便消除自负的态度</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_23_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_24_0">
    <VALUE Lang="cn">.........</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_25_0">
    <VALUE Lang="cn">是啊看起来跟钱没两样, 不过仔细看是伪钞</VALUE>
    <VALUE Lang="cn">但问题是询问之后却有并非伪钞的反应出现</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_25_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_26_0">
    <VALUE Lang="cn">而且纸币周围反射奇怪的文字, 似乎是古代的神秘暗号。</VALUE>
    <VALUE Lang="cn">总之，这些纸币本身似乎带有什么意义, 拜托你拿去确定一下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_26_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_27_0">
    <VALUE Lang="cn">啊！这必须由老师保管，拿去给Technical Teacher 吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_27_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_28_0">
    <VALUE Lang="cn">.......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_29_0">
    <VALUE Lang="cn">而且那个位置, 从以前就有的东西, 比如说像建筑物, 现在却被入侵的人们占据</VALUE>
    <VALUE Lang="cn">虽说与异变发生的时间点相同</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_29_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_3_0">
    <VALUE Lang="cn">什么？你问的问题就像第一次来这里的人似的。</VALUE>
    <VALUE Lang="cn">朝着Sacred Gate Park，往右边走是Phoenix学院；往左边走的话是Mystic Peak学院；往后面走是Sacred Gate学院。</VALUE>
    <VALUE Lang="cn">好吧, 现在想起来没？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_30_0">
    <VALUE Lang="cn">问题不出在那, 而是Leonair Campus现在到底在哪里？</VALUE>
    <VALUE Lang="cn">有人说在Sacred Gate Park的南边, 也有人说在北边, 不直接去确定的话根本无法得知。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_30_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_31_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">但是听说刚好有个叫做Cheng Xi Zhi的弓箭部学生, 确定了Leonair Campus的位置, 还做了张地图。</VALUE>
    <VALUE Lang="cn">那地图却被怪人抢夺, 被撕成一片一片的..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_31_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_32_0">
    <VALUE Lang="cn">虽然不知道那怪人是谁重要的是如何找到那被撕成一片片的地图</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_32_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_33_0">
    <VALUE Lang="cn">地图被撕破的时候附近有小丑这样会找不到吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_33_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_34_0">
    <VALUE Lang="cn">........</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_35_0">
    <VALUE Lang="cn">来看看 剩不到七张 怎么这么乱阿</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_35_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_36_0">
    <VALUE Lang="cn">哎呀不管老师再怎么拼凑都不行的吧</VALUE>
    <VALUE Lang="cn">字太草, 图案也不规则, 损伤很严重, 连接线不确实</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_36_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_37_0">
    <VALUE Lang="cn">Student Director有做过遗迹挖掘的工作, 搞不好可以拼凑的起来</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_37_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_38_0">
    <VALUE Lang="cn">.....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_39_0">
    <VALUE Lang="cn">不管怎样因为人力不足就这样放任她们变多的话后果将不堪射想</VALUE>
    <VALUE Lang="cn">即使只有一点点余力如能将会造成祸端的东西消失就太好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_39_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_4_0">
    <VALUE Lang="cn">以前来玩的时候有很多鸟跟小孩，现在却变的杀气腾腾。</VALUE>
    <VALUE Lang="cn">那时小丑Clown还边卖气球边跟我们玩，真是开心啊。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_40_0">
    <VALUE Lang="cn">......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_41_0">
    <VALUE Lang="cn">啊, 不要操心了</VALUE>
    <VALUE Lang="cn">是老师自己在那边讲的</VALUE>
    <VALUE Lang="cn">总之, 辛苦啦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_41_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_42_0">
    <VALUE Lang="cn">......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_43_0">
    <VALUE Lang="cn">到底财团有没有意思要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_43_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_44_0">
    <VALUE Lang="cn">真是抱歉</VALUE>
    <VALUE Lang="cn">你们还需要再教育往后有事情的话才可以应付</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_44_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_45_0">
    <VALUE Lang="cn">.......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_46_0">
    <VALUE Lang="cn">虽然当下会觉得闷闷的</VALUE>
    <VALUE Lang="cn">事实上我们的老师知道的并不多</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_46_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_47_0">
    <VALUE Lang="cn">能够告诉我们的正反面还不一定是对的</VALUE>
    <VALUE Lang="cn">怎么说哩…说一加一不等于二, 不就让人无法理解吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_47_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_48_0">
    <VALUE Lang="cn">哇，都主动要考试，真不简单!</VALUE>
    <VALUE Lang="cn">那么不需要说废话了吧?</VALUE>
    <VALUE Lang="cn">看看…要找适当的题材不容易耶。</VALUE>
    <VALUE Lang="cn">好，那种程度应该可以…</VALUE>
    <VALUE Lang="cn">依你的程度应该知道 '寒冰将领' 吧?</VALUE>
    <VALUE Lang="cn">吓什么…</VALUE>
    <VALUE Lang="cn">这次的考试课题就是打倒那家伙。</VALUE>
    <VALUE Lang="cn">不会像之前的考试一样有限制时间。</VALUE>
    <VALUE Lang="cn">不管几次挑战看看吧!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_48_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_49_0">
    <VALUE Lang="cn">?</VALUE>
    <VALUE Lang="cn">真的打败那个寒冰将领?</VALUE>
    <VALUE Lang="cn">真的变的这么强。</VALUE>
    <VALUE Lang="cn">他给人的感觉冷冰冰的实在是不想去惹他…</VALUE>
    <VALUE Lang="cn">反正考试是合格了!</VALUE>
    <VALUE Lang="cn">以后可能不需要透过老师考试了。</VALUE>
    <VALUE Lang="cn">也找不到适合的题材。</VALUE>
    <VALUE Lang="cn">话说回来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_49_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0">
    <VALUE Lang="cn">득도의 경지에 이른 ‘마루치’ 와 ‘아라치’ 의 기운이 서로 만날 때 이르는 경지를 가리키는 말인데</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">본래는 소승불교에서 모든 번뇌를 뚫고 이치를 깨달아 열반의 경지에 이른 성자를 말이고 ‘나한’ 이라고도 하지</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0_1">
    <VALUE Lang="cn">'깨달음의 열쇠' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0_2">
    <VALUE Lang="cn">'나한의 구슬' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_5_0_3">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_50_0">
    <VALUE Lang="cn">要会到本洞那里吗。</VALUE>
    <VALUE Lang="cn">时间停止真是意外。</VALUE>
    <VALUE Lang="cn">以为空间轴会变</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_50_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_51_0">
    <VALUE Lang="cn">......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_52_0">
    <VALUE Lang="cn">财团的社会活动？我们学院都属于同一个财团，这当然知道。</VALUE>
    <VALUE Lang="cn">这么说上课时间里没有提过财团的事情。</VALUE>
    <VALUE Lang="cn">嗯… 我说这些话可能会觉得我没有责任心,但是对这些财团的背景还是有距离感… 太详细的内容, 我也不是非常的清楚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_53_0">
    <VALUE Lang="cn">听说 Leonine学院负责调查异变事件的Dispatched Agent已经被 Saint Private Guards(= Sacred Gate Defender)弄得不勘其扰。请你帮忙把它们赶走让Dispatched Agent可以专心调查。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_53_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_6_0">
    <VALUE Lang="cn">그 열쇠를 지니고 있다면 재단에 보관중인 걸 받을 수도 있게 된다는 얘기는 들었지</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">하지만 지금은 조각조각으로 나뉘어져 있을테니까 일단 7조각을 모으게 되면 나한테 가져오도록 해</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_7_0">
    <VALUE Lang="cn">아, 그 녹색 구슬 말이지?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">그냥 하나씩만으로는 별다를 게 없는데 30개를 다 합쳐서 목걸이를 만들면 꽤 쓸만해 진다지</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0">
    <VALUE Lang="cn">嗯…. 您想问什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0_1">
    <VALUE Lang="cn">询问方向</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0_2">
    <VALUE Lang="cn">询问关于Sacred Gate Park的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0">
    <VALUE Lang="cn">啊? 听Construction Supervisor 说过</VALUE>
    <VALUE Lang="cn">你接受我的请托 真是非常感谢</VALUE>
    <VALUE Lang="cn">他们也知道现在的状况在某种程度上来说是很奇怪的, 所以尽可能帮你, 做的真是太好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0_1">
    <VALUE Lang="cn">申请考试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_1_0">
    <VALUE Lang="cn">欢迎来到格斗部！如果您不属于此单位，请各自回到您的所属区域。谢谢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_1_0_1">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_1_0_2">
    <VALUE Lang="cn">说明新生的状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_1_1">
    <VALUE Lang="cn">有什么需要我效劳的吗？</VALUE>
  </SENTENSE>
