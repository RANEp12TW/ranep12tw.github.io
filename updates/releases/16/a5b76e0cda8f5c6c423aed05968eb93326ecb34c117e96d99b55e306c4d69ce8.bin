  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_3_0">
    <VALUE Lang="cn">要不断地使用技能，才有办法攻破敌人的致命要害。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_3_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
