  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_49_0_9">
    <VALUE Lang="cn">取得Vital Bow</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_5_0">
    <VALUE Lang="cn">我们通常在研究量子力学、次元物理学,或者是反重力理论等等。</VALUE>
    <VALUE Lang="cn">啊! 你说不知道那是什么吗?</VALUE>
    <VALUE Lang="cn">你认为是什么原因造成异变发生?</VALUE>
    <VALUE Lang="cn">异界为什么会和我们的世界有连接呢?</VALUE>
    <VALUE Lang="cn">发掘那些真相本来就是我们的工作</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_5_0_1">
    <VALUE Lang="cn">您为何在这里？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_50_0">
    <VALUE Lang="cn">如果对自己收集商品的能力值有不满意,一定会想要贩卖掉的吧?只要收集几样材料后制成商店营业许可证了… 但奇怪的是.. 这个调制的方法令人怀疑啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_50_0_1">
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_51_0">
    <VALUE Lang="cn">需要的材料有Bone Powder、Fermentation Water、Cigarette Butt。不知道是否能够成功呢！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_51_0_1">
    <VALUE Lang="cn">相信你一定可以的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_52_0">
    <VALUE Lang="cn">恩.. 管不了那么多了. 你可以帮我收集材料吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_52_0_1">
    <VALUE Lang="cn">答应帮忙收集材料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_53_0">
    <VALUE Lang="cn">你找来了啊.. 那么我就来做做看吧..等我一下唷</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_53_0_1">
    <VALUE Lang="cn">等候一下</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_54_0">
    <VALUE Lang="cn">制作完成了.虽然功效还不算完整..但应该也能贩卖商品了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_54_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_55_0">
    <VALUE Lang="cn">不认为这是失礼的问题? 恩… 是有一个很要好的朋友,但自从发生异变后就失联了.后来..在几天前有听到说有个非常相似的人在Leonine学院的本馆。你可以帮我去确认看看吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_55_0_1">
    <VALUE Lang="cn">答应帮忙寻找</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_56_0">
    <VALUE Lang="cn">她的名字叫Mr.No-Name。听见到他的人说，她目前似乎有些怪怪的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_56_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_57_0">
    <VALUE Lang="cn">太棒了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_57_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_58_0">
    <VALUE Lang="cn">我还要知道更多发生在 Mr.No-Name身上的事情…</VALUE>
    <VALUE Lang="cn">拜托您了。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_58_0_1">
    <VALUE Lang="cn">别担心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_59_0">
    <VALUE Lang="cn">谢谢你.. 日后我一定会报答你的</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_59_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_6_0">
    <VALUE Lang="cn">这是一个很笨的问题.</VALUE>
    <VALUE Lang="cn">""不久之前,在本馆地下的结界石处倒榻了! ""</VALUE>
    <VALUE Lang="cn">难道你希望我变成复制灵吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_6_0_1">
    <VALUE Lang="cn">诉说抱歉</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_60_0">
    <VALUE Lang="cn">请选择物品类型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_60_0_1">
    <VALUE Lang="cn">选择Dual Spear</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_60_0_2">
    <VALUE Lang="cn">选择Scythe</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_60_0_3">
    <VALUE Lang="cn">选择Shuriken</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_61_0">
    <VALUE Lang="cn">选择物品类型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_61_0_1">
    <VALUE Lang="cn">获得一个Cube</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_61_0_2">
    <VALUE Lang="cn">获得一个Whip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_61_0_3">
    <VALUE Lang="cn">获得一个Magic Wand</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_62_0">
    <VALUE Lang="cn">没多少时间了，请快点试一试吧.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_62_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_63_0">
    <VALUE Lang="cn">恭喜你，干得好，作为在Chaos Island帮助Ryuin的奖励你将能获得Theojelite belt scroll.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_63_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_7_0">
    <VALUE Lang="cn">所以以后表现好一点!</VALUE>
    <VALUE Lang="cn">你不知道部门的人都去哪里了吗?</VALUE>
    <VALUE Lang="cn">你让我觉得你是很善良的学弟的话...</VALUE>
    <VALUE Lang="cn">帮你一点吧? 嘿嘿</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_8_0">
    <VALUE Lang="cn">……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_9_0">
    <VALUE Lang="cn">您有看见那个东西飞出去还发出呼噜噜的声音吗？咦？</VALUE>
    <VALUE Lang="cn">你知道它的名字吗？我想您知道不少情报。看不来您其实是个很聪明的人唷。哇，太棒了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_9_0_1">
    <VALUE Lang="cn">感到被冒犯，但还是询问她更多细节。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_1_0">
    <VALUE Lang="cn">这里的情况逐渐恶化…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_1_0_1">
    <VALUE Lang="cn">设定开始位置</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_1_0_2">
    <VALUE Lang="cn">物品买卖</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_1_0_3">
    <VALUE Lang="cn">寻求帮手</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_1_0_4">
    <VALUE Lang="cn">不经意的发现</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_1_0_5">
    <VALUE Lang="cn">交付Unidentified Necklace</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_1_0_6">
    <VALUE Lang="cn">问题的关联性</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_1_0_7">
    <VALUE Lang="cn">自我牺牲</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_1_0_8">
    <VALUE Lang="cn">净化Power Facility</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_2_0">
    <VALUE Lang="cn">现在我的处境也不好。你和我不认识的情况下还厚着脸皮拜托你也是不得已的。不过还是要看你愿不愿你接受我的提议</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_2_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_3_0">
    <VALUE Lang="cn">以前一起在这里工作的突变技术研究员同事被感染了。</VALUE>
    <VALUE Lang="cn">真的很难过。如果这些病毒传至学院将会发生不可预料的灾害。</VALUE>
    <VALUE Lang="cn">请帮忙清除这些危险的突变技术研究员。如果过程中有发现研究员的项链请交给我</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_4_0">
    <VALUE Lang="cn">唉...虽然已在预料之中...不过还是要谢谢你帮忙确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_4_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_5_0">
    <VALUE Lang="cn">我有一个双胞胎弟弟。再说个让你更惊讶的事情，以前和弟弟一起在这里工作。他有杰出的才能，所以被拿来当作实验的对象。</VALUE>
    <VALUE Lang="cn">事件爆发后为了寻找弟弟才会再回来这里。可以帮忙协助搜寻吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_5_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_6_0">
    <VALUE Lang="cn">确定是我弟弟吗?听你这么一说好像没错。</VALUE>
    <VALUE Lang="cn">不过还需要花时间进行更详细的确认</VALUE>
    <VALUE Lang="cn">在完成确认之前请帮忙照顾我的弟弟</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_lresearcher.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
