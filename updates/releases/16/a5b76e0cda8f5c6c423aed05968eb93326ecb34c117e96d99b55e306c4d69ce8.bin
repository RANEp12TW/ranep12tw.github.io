  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_10_0">
    <VALUE Lang="cn">对, 这没错.</VALUE>
    <VALUE Lang="cn">就是以前资料上看的那个叶子.</VALUE>
    <VALUE Lang="cn">可是这好奇怪, 其他都变了, 怎么这个还是老样子..?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_10_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_11_0">
    <VALUE Lang="cn">您无法进入此地区。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_11_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_12_0">
    <VALUE Lang="cn">很好，刚好就这样。</VALUE>
    <VALUE Lang="cn">就像我说的，我现在在这里动弹不得。</VALUE>
    <VALUE Lang="cn">请您进去Leonair Campus里头了解一下大概的状况。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_12_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_13_0">
    <VALUE Lang="cn">这是什么? 绷带Bandage?</VALUE>
    <VALUE Lang="cn">而且这腐蚀的状态, 应该是从尸体身上撕下来的吧?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_13_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_14_0">
    <VALUE Lang="cn">不管怎么说, 情报都太少了..</VALUE>
    <VALUE Lang="cn">植物实验体跟预测的一样, 不过除此之外的.</VALUE>
    <VALUE Lang="cn">到底什么死掉的家伙会走来走去</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_14_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_15_0">
    <VALUE Lang="cn">虽然我不是这一方面的专家, 不过这上面沾有这么多的异物, 只要一看就知道应该很难读取的到吧.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_15_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_16_0">
    <VALUE Lang="cn">虽然Sacred Financial Group Research Center可以轻易复原它，但现在却不​​行。</VALUE>
    <VALUE Lang="cn">听说Trading Hole有一位这方面的专家。带去拜托他应该就可以复原了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_16_0_1">
    <VALUE Lang="cn">询问有关 Sacred Financial Group Research Center的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_16_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_17_0">
    <VALUE Lang="cn">我好像说了太多废话.</VALUE>
    <VALUE Lang="cn">不要想太多.</VALUE>
    <VALUE Lang="cn">只是因为仅剩单纯的技术研究所了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_17_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_18_0">
    <VALUE Lang="cn">如果真是如此, 那就麻烦了..</VALUE>
    <VALUE Lang="cn">如果要去地下二楼就要去三楼的专用电梯.</VALUE>
    <VALUE Lang="cn">而且要去三楼的话要有特别的ID卡</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_18_0_1">
    <VALUE Lang="cn">询问特殊ID Card。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_18_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0">
    <VALUE Lang="cn">复原成功了.</VALUE>
    <VALUE Lang="cn">虽然花了不少时间, 不过真是辛苦你了.</VALUE>
    <VALUE Lang="cn">说的也是, 看的到内容吧?</VALUE>
    <VALUE Lang="cn">不管看到什么, 暂时还是别说出去比较好</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_1">
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_2">
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_3">
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_4">
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_19_0_5">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_2_0">
    <VALUE Lang="cn">....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_20_0">
    <VALUE Lang="cn">带子的状态有点怪...</VALUE>
    <VALUE Lang="cn">不会是给谁看过了吧?</VALUE>
    <VALUE Lang="cn">那有什么关系吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_20_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_21_0">
    <VALUE Lang="cn">各学院的 Administration Office会保管特殊时刻用的卡片。</VALUE>
    <VALUE Lang="cn">请取得卡片，并复制卡片。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_21_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_22_0">
    <VALUE Lang="cn">好, 这就是Leonair Campus。</VALUE>
    <VALUE Lang="cn">不但带了地图，就连认证书都一起带过来了。看来您是略有所闻喔。但还是先后退吧。</VALUE>
    <VALUE Lang="cn">你是说看不见从那里面渗出来不均衡的元素吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_22_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_23_0">
    <VALUE Lang="cn">嗯, 很好..</VALUE>
    <VALUE Lang="cn">反正正好需要有人代替我进去, 借机测验一下你的能力吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_23_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_24_0">
    <VALUE Lang="cn">给你40分钟，抓20名Sacred Gate Defender来，我就佩服您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_24_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_25_0">
    <VALUE Lang="cn">我给你一句忠告, 那群家伙的电气攻击厉害的不得了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_25_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_26_0">
    <VALUE Lang="cn">不管你讨厌或喜欢，都要听我的请求。</VALUE>
    <VALUE Lang="cn">现在 Leonair campus里面某些东西正在成长。</VALUE>
    <VALUE Lang="cn">已经有几个知道发生什么事情，虽然进去过，却只将那奇怪的气息扩大。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_26_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_27_0">
    <VALUE Lang="cn">那么, 请告诉我里面究竟怎么了?</VALUE>
    <VALUE Lang="cn">我说了, 因为我要代替作出结界, 没办法了.</VALUE>
    <VALUE Lang="cn">进去里面看的话, 是草吗? 就是有满满的植物体</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_27_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_28_0">
    <VALUE Lang="cn">去取得一个叫做Smallpox leave的叶子五片来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_28_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_29_0">
    <VALUE Lang="cn">如果跟以前的结构一样的话, 一进去会有反覆的阶梯.</VALUE>
    <VALUE Lang="cn">爬完阶梯后, 经过操场会有一条路, 去拿样本回来</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_29_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_3_0">
    <VALUE Lang="cn">圣财团的调查派遣人员? 确定现在正扩散的异常现象是否从这附近而来</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_3_0_1">
    <VALUE Lang="cn">询问关于Sacred Financial Group的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_30_0">
    <VALUE Lang="cn">那里面有尸体走来走去吗?</VALUE>
    <VALUE Lang="cn">虽然不超过预期想像的, 不过状况不是太好.</VALUE>
    <VALUE Lang="cn">总之用这程度的样本看来, 似乎不是可以掌握的状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_30_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_31_0">
    <VALUE Lang="cn">不好意思请帮我调查一下Leonair Campus。</VALUE>
    <VALUE Lang="cn">还有，请帮我看看是否 Student director 到现在还活着？</VALUE>
    <VALUE Lang="cn">我相信您办得到的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_31_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_32_0">
    <VALUE Lang="cn">这样就太好了.</VALUE>
    <VALUE Lang="cn">遇见跟你一样的人就可以拜托吧</VALUE>
    <VALUE Lang="cn">因为信任你, 所以小心点喔</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_32_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_33_0">
    <VALUE Lang="cn">게다가 이런 구식 기록매체를 아직까지 쓰고 있다니...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">아무래도 전문가에게 보여야 겠는걸, 일단은 내가 보관하고 있도록 하지</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_33_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_34_0">
    <VALUE Lang="cn">并非单纯潮湿所造成的损伤.</VALUE>
    <VALUE Lang="cn">这是要在一定的热度下经过很长的时间才会出现的伤口</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_34_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_35_0">
    <VALUE Lang="cn">如果说症状不只呼吸, 就连神经都受到影响的话..</VALUE>
    <VALUE Lang="cn">难说是不是..."</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_35_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_36_0">
    <VALUE Lang="cn">最近开始有人询问那个病, 虽然来这之前有确认过资料, 总之好像是植物体实验的影响</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_36_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_37_0">
    <VALUE Lang="cn">但就单纯的速度来说, 影响不会扩散这么远.</VALUE>
    <VALUE Lang="cn">会不会跟Leonair学院地下二楼的排水管有关系</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_37_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_38_0">
    <VALUE Lang="cn">在这里一边整理情况, 怎么想都觉得目前学生的能力将难以承担往后的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_38_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_39_0">
    <VALUE Lang="cn">去 Trading Hole找Master of Taoist Rites。如果可以请求授课就太好了。即使只变强一点点都会有帮助的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_39_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_4_0">
    <VALUE Lang="cn">似乎对学院漠不关心.</VALUE>
    <VALUE Lang="cn">没道理不知道这周边成立了四间很奇怪的学院.</VALUE>
    <VALUE Lang="cn">那个后援团体就是我们圣财团</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_40_0">
    <VALUE Lang="cn">... ……</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_41_0">
    <VALUE Lang="cn">太久没有动了，只是站着也会晕，居然会有家伙找这种麻烦。</VALUE>
    <VALUE Lang="cn">好！首先去问问这个人，并帮助他之后再来找我。据说是Construction Supervisor，他正对财团发邮件要求帮助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_41_0_1">
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_41_0_2">
    <VALUE Lang="cn">决绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_42_0">
    <VALUE Lang="cn">不要问为什么，需要帮助的人就给予帮助，不需要帮助的人，亲自访问需要什么样的帮助。</VALUE>
    <VALUE Lang="cn">就像现在你所做的事情那样，从小开始到国家单位为止… 仅仅是规模不同而已，内容都相似。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_42_0_1">
    <VALUE Lang="cn">询问细节</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_43_0">
    <VALUE Lang="cn">不清楚。是啊… 我只能说到这里…</VALUE>
    <VALUE Lang="cn">最好寻找周围的老师了解一下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_44_0">
    <VALUE Lang="cn">没错。不是很难的事情，快去快回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_45_0">
    <VALUE Lang="cn">虽然不大好，但好像不是能拒绝的立场啊。如果不帮我，我也不再多说什么了。就当作做件好事，快去快回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_46_0">
    <VALUE Lang="cn">学生谢谢你帮忙把它们赶走</VALUE>
    <VALUE Lang="cn">辛苦你了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_46_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_47_0">
    <VALUE Lang="cn">我现在正在调查异变的发生，不过人手不足。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">想要请你帮忙，不过那个地方实在是非常危险。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_47_0_1">
    <VALUE Lang="cn">我会帮助您的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_48_0">
    <VALUE Lang="cn">很高兴你有心要协助调查，不过以你现在的实力要去Leonine学院....实在是很危险</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">请再继续完成更艰难训练累积实力后，再来找我吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_48_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_49_0">
    <VALUE Lang="cn">哇！竟然这么快就取得Bine Hands mutatant man eating Poison Ivy！看来这段时间训练的成效还不错！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_49_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_5_0">
    <VALUE Lang="cn">哼哼！！！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_5_0_1">
    <VALUE Lang="cn">您是谁？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_5_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_50_0">
    <VALUE Lang="cn">最近听说异变事件发生后到现在Leonine 学院还有人存活...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">去找它们打听应该可以知道异变当天到底发生了什么事情</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">这次的任务非常危险确定要帮忙打听实际的情况吗?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_50_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_51_0">
    <VALUE Lang="cn">这本 Leonine手册虽然已经严重损毁不过它可是纪录很多当时发生异变的情况</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">真的很谢谢你~帮忙找到这本珍贵的手册</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_51_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_6_0">
    <VALUE Lang="cn">只要我稍微退后, 我现在的位置应该就会被取代了.</VALUE>
    <VALUE Lang="cn">了解的话就打起精神.后退呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_6_0_1">
    <VALUE Lang="cn">要求进入 Leonair Campus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_6_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_7_0">
    <VALUE Lang="cn">你要从那边进去?</VALUE>
    <VALUE Lang="cn">我现在站在这里动也不能动, 你还说这种话.</VALUE>
    <VALUE Lang="cn">莫名其妙!不知是笨还是厉害</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_7_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_8_0">
    <VALUE Lang="cn">不差吧? 算还可以的...</VALUE>
    <VALUE Lang="cn">我只是想问一下你.</VALUE>
    <VALUE Lang="cn">没事啦! 算了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_8_0_1">
    <VALUE Lang="cn">Special Agent的请托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_8_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_9_0">
    <VALUE Lang="cn">我在这里动弹不得, 可以帮我一个忙吗? 没关系吧?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_saint1.ntk_9_0_1">
