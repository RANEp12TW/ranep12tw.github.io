  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_9">
    <VALUE Lang="cn">询问发生何事了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_10_0">
    <VALUE Lang="cn">真是多谢,</VALUE>
    <VALUE Lang="cn">我被抢的书是MinFuLeiSi Special 出版社出的，书名是"Programming RPGs for DirectX."。</VALUE>
    <VALUE Lang="cn">刚刚被名叫Clown ICE的人抢走了。请您帮我找回来好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_10_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0">
    <VALUE Lang="cn">现在看到我应该只有想到书吧,</VALUE>
    <VALUE Lang="cn">总之要有书,才可度过这类难关,</VALUE>
    <VALUE Lang="cn">再说也有拜托您的人</VALUE>
    <VALUE Lang="cn">可以再帮我一次吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0_1">
    <VALUE Lang="cn">接受请求</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_12_0">
    <VALUE Lang="cn">现在看到我应该只有想到书吧,</VALUE>
    <VALUE Lang="cn">总之要有书,才可度过这类难关,</VALUE>
    <VALUE Lang="cn">再说也有拜托您的人</VALUE>
    <VALUE Lang="cn">可以再帮我一次吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_12_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_13_0">
    <VALUE Lang="cn">真的找回来哩.</VALUE>
    <VALUE Lang="cn">拜托归拜托,不过没想到找回来了,</VALUE>
    <VALUE Lang="cn">真是感谢</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_13_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_14_0">
    <VALUE Lang="cn">果然找回来了,</VALUE>
    <VALUE Lang="cn">上次已经帮过我,这次是不是更辛苦,我一直在想</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_14_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_15_0">
    <VALUE Lang="cn">......2</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_16_0">
    <VALUE Lang="cn">你问什么?</VALUE>
    <VALUE Lang="cn">程式?游戏程式?</VALUE>
    <VALUE Lang="cn">我做人们看见的与听见的</VALUE>
    <VALUE Lang="cn">所以也做某程度的调查跟准备</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_16_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_17_0">
    <VALUE Lang="cn">做什么都可以贩卖,请看这里,</VALUE>
    <VALUE Lang="cn">大部分市民都处于无法做事的状态嘛.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_17_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_18_0">
