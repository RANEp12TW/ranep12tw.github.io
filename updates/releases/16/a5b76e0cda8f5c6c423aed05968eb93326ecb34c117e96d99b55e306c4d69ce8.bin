  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_6">
    <VALUE Lang="cn">询问进入大楼的方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_7">
    <VALUE Lang="cn">询问“Green”的机密据点</VALUE>
  </SENTENSE>
