    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busteminal.ntk_1_0_2">
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busteminal.ntk_1_0_3">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busteminal.ntk_1_1">
    <VALUE Lang="cn">这里是公车站。只要您拥有Bus Ticket ，就可以使用公车服务，畅游各地区唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busteminal.ntk_1_1_1">
