  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0_3">
    <VALUE Lang="cn">我已经歼灭完成！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_2_0">
    <VALUE Lang="cn">您可透过位在各个学院的Elemental Shaman NPC来进入活动地图。</VALUE>
    <VALUE Lang="cn">*</VALUE>
    <VALUE Lang="cn">---开放时间---</VALUE>
    <VALUE Lang="cn">[Lv30~130]</VALUE>
    <VALUE Lang="cn">1:00, 5:00, 9:00, 13:00, 17:00, 21:00</VALUE>
