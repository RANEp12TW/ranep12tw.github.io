  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_7_0_1">
    <VALUE Lang="cn">?쩊홁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_70_0">
    <VALUE Lang="cn">角色达到某特定级数，已成功获取灵珠。现在可用灵珠来学习新技能唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_70_0_10">
    <VALUE Lang="cn">兑换 Blazing Gear物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_70_0_11">
    <VALUE Lang="cn">兑换Oktagon Arrow物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_70_0_12">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_70_0_5">
    <VALUE Lang="cn">兑换Lightning Arrow物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0">
    <VALUE Lang="cn">您想问什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_1">
    <VALUE Lang="cn">询问关于弓箭部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_2">
    <VALUE Lang="cn">询问修炼方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_3">
    <VALUE Lang="cn">询问战斗方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_4">
    <VALUE Lang="cn">询问技能点数</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_8_0_5">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_9_0">
    <VALUE Lang="cn">这儿没有回头路。</VALUE>
    <VALUE Lang="cn">但千万不能大意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_9_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0">
    <VALUE Lang="cn">噢！可以见到正常人真是开心！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_1">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_2">
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_3">
    <VALUE Lang="cn">申请公车零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_4">
    <VALUE Lang="cn">申请发电机零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_5">
    <VALUE Lang="cn">收集未验证纸币</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_6">
    <VALUE Lang="cn">Technical Teacher的测验</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_7">
    <VALUE Lang="cn">确认测验结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_1_0_8">
    <VALUE Lang="cn">传达命令书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_10_0">
    <VALUE Lang="cn">是吗？那纸币明明就有问题！</VALUE>
    <VALUE Lang="cn">在大问题发生之前确认出有危险实在太好了。</VALUE>
    <VALUE Lang="cn">请尽量持续传达这份Order Document。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_10_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_11_0">
    <VALUE Lang="cn">已经到可以测验的程度了吗?</VALUE>
    <VALUE Lang="cn">比想像中学习的速度快呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_11_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_12_0">
    <VALUE Lang="cn">很好 这程度就合格了</VALUE>
    <VALUE Lang="cn">但是这算比想像中的差所以以后要多练习</VALUE>
    <VALUE Lang="cn">虽然上课时都听懂了但你无法猜对何时那些有两只手两只脚的家伙会不会以你敌人的身分出现"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_12_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_13_0">
    <VALUE Lang="cn">.......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_14_0">
    <VALUE Lang="cn">总之老师所带的东西里头没有这种零件。</VALUE>
    <VALUE Lang="cn">位在Construction Site 4th Hole的Supervisor搞不好有带着。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_14_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_15_0">
    <VALUE Lang="cn">你可以从你的头头那边取得所需零件。</VALUE>
    <VALUE Lang="cn">他位在 4th Hole的建筑工地。</VALUE>
    <VALUE Lang="cn">你必须要先证明自己，</VALUE>
    <VALUE Lang="cn">他们一开始可能会有点严格粗暴。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_15_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_16_0">
    <VALUE Lang="cn">.......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_17_0">
    <VALUE Lang="cn">혹시나 해서 현금지급기에서 확인도 해 봤더니 정품으로 인식하더라구</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_17_0_1">
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_18_0">
    <VALUE Lang="cn">아까 물어보니까 청소부들이 이런 지폐를 다발로 모으고 있다는 소리까지 들리는 거 보니까 이대로 놔두면 문제가 커질 것 같아</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_18_0_1">
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_19_0">
    <VALUE Lang="cn">가져가서 한번 확인 좀 해 봐라</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_19_0_1">
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_2_0">
    <VALUE Lang="cn">...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_2_0_1">
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_2_0_2">
    <VALUE Lang="cn">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_20_0">
    <VALUE Lang="cn">....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_21_0">
    <VALUE Lang="cn">很好,那么</VALUE>
    <VALUE Lang="cn">出题之前我会再跟你们说一次之前讲的本次测验的目的,你们平时上格斗课的目标绝对不是一般人</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_21_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_22_0">
    <VALUE Lang="cn">所以要定期举行这种能力考试,可以学到更多需要学习的部分</VALUE>
    <VALUE Lang="cn">虽说情况比预定的进行的快,但不会只到现在</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_22_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_23_0">
    <VALUE Lang="cn">因为你们真正要战斗的敌人,他们的水准并非这程度,所以以后要持续学习</VALUE>
    <VALUE Lang="cn">了解了吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_23_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_3_0">
    <VALUE Lang="cn">嗯如果有听课的话可以猜出大概的样子</VALUE>
    <VALUE Lang="cn">比起预计的是快了不过早就预料到啦从18年前"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_4_0">
    <VALUE Lang="cn">虽然早已预想到事件的大概,现在却全然不知会怎样</VALUE>
    <VALUE Lang="cn">再加上至今仍不知当初预知的事情是否正确</VALUE>
    <VALUE Lang="cn">那必须先做确定</VALUE>
    <VALUE Lang="cn">多收集可能的情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_5_0">
    <VALUE Lang="cn">本来是有人决定管理这个不过不知道跑去哪里了</VALUE>
    <VALUE Lang="cn">所以暂时由我来看管是针对社服的特性再做强化的产品模样</VALUE>
    <VALUE Lang="cn">心意一样但想就这样分配掉掉点可惜耶</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0">
    <VALUE Lang="cn">嗯…. 您想问什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0_1">
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0_2">
    <VALUE Lang="cn">询问该做什么才好？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0_3">
    <VALUE Lang="cn">询问奇特服装</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_6_0_4">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_7_0">
    <VALUE Lang="cn">阿 你在找修理公车用的零件吧</VALUE>
    <VALUE Lang="cn">最近虽然有几个人收走一样的零件却因为出车祸又来找我</VALUE>
    <VALUE Lang="cn">如果这次可以确实带走就好了</VALUE>
    <VALUE Lang="cn">虽然为了应付这类事情准备很多东西但现在零件几乎没剩了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_8_0">
    <VALUE Lang="cn">又是零件 全部都被包走了</VALUE>
    <VALUE Lang="cn">看一下这是以前的规格也有点不一样吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_8_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_9_0">
    <VALUE Lang="cn">又是来买零件吗? 真是的</VALUE>
    <VALUE Lang="cn">嗯, 这是哪里奇怪的纸币呀? 这里有耶</VALUE>
    <VALUE Lang="cn">我虽无法正确指出是哪里, 不过这纸币就是怪怪的</VALUE>
    <VALUE Lang="cn">好像有去现金提款机确认过, 不过告知是真的呀</VALUE>
    <VALUE Lang="cn">刚刚问过, 从清洁工人说这种纸币包成一束来看, 这样下去问题会扩大</VALUE>
    <VALUE Lang="cn">带去再确认一次</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_9_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_0">
    <VALUE Lang="cn">아, 그거 혹시 열쇠 조각 ...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">잠깐 줘 볼래?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">어쩌면 그 ‘깨달음의 열쇠’ 일지도 모르겠는데!</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">정말 ‘깨달음의 열쇠’ 라면 ‘세인트 재단’ 에게서 뭔가를 받기 위한 증표가 될 거야</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_0_1">
    <VALUE Lang="cn">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_0_2">
    <VALUE Lang="cn">열쇠 조각 들을 합친다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_1">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_2">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_3">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_4">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5">
    <VALUE Lang="cn">来这里真是辛苦呀</VALUE>
    <VALUE Lang="cn">物品还有一点,有需要的话要说阿</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_1">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_10">
    <VALUE Lang="cn">接受指示 (消灭 Hell Scissors)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_11">
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_12">
    <VALUE Lang="cn">交付药品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_13">
    <VALUE Lang="cn">申请考试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_14">
    <VALUE Lang="cn">确认考试结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_2">
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_3">
    <VALUE Lang="cn">调查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_4">
    <VALUE Lang="cn">申请考试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_5">
    <VALUE Lang="cn">确认考试结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_6">
    <VALUE Lang="cn">接受指示（纸币验证）</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_7">
    <VALUE Lang="cn">传达命令书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_8">
    <VALUE Lang="cn">询问 Leonair Campus的位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_9">
    <VALUE Lang="cn">确认Map的纸片</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_10_0">
    <VALUE Lang="cn">自发性地接受考试是不错啦</VALUE>
    <VALUE Lang="cn">反正学生或是老师都会定期考试来测定能力希望你不要觉得烦</VALUE>
    <VALUE Lang="cn">敌人的能力也在变,稍微有变强,要顺便消除自负的态度</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_11_0">
    <VALUE Lang="cn">嗯 很好 算是良好的</VALUE>
    <VALUE Lang="cn">这种程度是稳要可以过的用这试着去想以后这样想的话就理所当然的东西也…</VALUE>
    <VALUE Lang="cn">总之定期能力测验就这样了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_11_0_1">
    <VALUE Lang="cn">接受指示(验证纸币)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_11_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_12_0">
    <VALUE Lang="cn">事​​实上久前清道夫大叔给我这就走了</VALUE>
    <VALUE Lang="cn">是阿看起来跟钱没两样不过仔细看是伪钞</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_12_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_13_0">
    <VALUE Lang="cn">那纸币似乎确实有什么重要的东西</VALUE>
    <VALUE Lang="cn">现在在路上常会看见有掉落的东西先捡起来收着吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_13_0_1">
    <VALUE Lang="cn">询问Leonair Campus的位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_14_0">
    <VALUE Lang="cn">以前明明就在那边Trading Hole隧道的附近，</VALUE>
    <VALUE Lang="cn">但是某天突然消失不见了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_14_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_15_0">
    <VALUE Lang="cn">地图的纸片真的还在呀</VALUE>
    <VALUE Lang="cn">搞不好老师也不知道至今还在,真是太好了</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_15_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_16_0">
    <VALUE Lang="cn">嗯,要不然之前是有要你做的事情啦</VALUE>
    <VALUE Lang="cn">为了确保学生跟市民最基本的安全,是持续整理中没错</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_16_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_17_0">
    <VALUE Lang="cn">很好,做的很好</VALUE>
    <VALUE Lang="cn">往后财团中有补给或支援的时候,要你做的事情会很多喔</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_17_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_18_0">
    <VALUE Lang="cn">事​​情进行到这样,财团本部却什么话都没说</VALUE>
    <VALUE Lang="cn">虽然消息有说要派重要人员来,会不会都是财团内部…</VALUE>
    <VALUE Lang="cn">阿 不要操心了</VALUE>
    <VALUE Lang="cn">是老师自己在那边讲的</VALUE>
    <VALUE Lang="cn">总之 辛苦啦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_18_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_19_0">
    <VALUE Lang="cn">......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_2_0">
    <VALUE Lang="cn">...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_2_0_1">
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_2_0_2">
    <VALUE Lang="cn">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_20_0">
    <VALUE Lang="cn">现在没办法拉哩拉杂说一堆,我只告诉你一句话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_20_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_21_0">
    <VALUE Lang="cn">现在周围几乎没有正常的人,千万不要只因为外表就去接近</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_21_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_22_0">
    <VALUE Lang="cn">.......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_23_0">
    <VALUE Lang="cn">但问题是，询问之后却有并非伪钞的反应出现。</VALUE>
    <VALUE Lang="cn">而且纸币周围反射奇怪的文字，似乎是古代的神秘暗号。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_23_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_24_0">
    <VALUE Lang="cn">总之这些纸币本身似乎带有什么意义,拜托你拿去确定一下</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_24_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_25_0">
    <VALUE Lang="cn">阿！这必须由老师保管，拿去给 Technical Teacher 吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_25_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_26_0">
    <VALUE Lang="cn">.....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_27_0">
    <VALUE Lang="cn">而且那个位置阿从以前就原有的东西像建筑物现在却被侵入的人们占据</VALUE>
    <VALUE Lang="cn">虽说异象出现的时机精确的一致</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_27_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_28_0">
    <VALUE Lang="cn">问题不出在那，而是Leonair学院现在到底在哪里。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_28_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_29_0">
    <VALUE Lang="cn">有人说在Sacred Gate Park的南边,也有人说在北边不直接去确定的话根本无法得知</VALUE>
    <VALUE Lang="cn">但是听说刚好有个叫做 Cheng Xi Zhi的射箭部学生，他确定了Leonair学院的位置，还做了张地图。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_29_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_3_0">
    <VALUE Lang="cn">就像第一次来这里的人问的。</VALUE>
    <VALUE Lang="cn">朝着Sacred Gate Park，往右边走是Phoenix学院；往左边走的话是Mystic Peak学院；往后面走是Sacred Gate学院阿！</VALUE>
    <VALUE Lang="cn">好吧,现在想起来没？</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_30_0">
    <VALUE Lang="cn">那地图却被怪人抢夺,被撕成一片一片的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_30_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_31_0">
    <VALUE Lang="cn">"虽然不知道那怪人是谁,重要的是如何找到那被撕成一片片的地图</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_31_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_32_0">
    <VALUE Lang="cn">地图被撕破的时候附近有小丑Clown，这样会找不到吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_32_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_33_0">
    <VALUE Lang="cn">......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_34_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">"来看看 剩不到七张,怎么这么乱阿</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_34_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_35_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">"哎呀不管老师再怎么拼凑都不行的吧</VALUE>
    <VALUE Lang="cn">字太草,图案也不规则,损伤很严重,连接线不确实</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_35_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_36_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Student Director有做过遗迹挖掘，搞不好可以拼凑的起来</VALUE>
    <VALUE Lang="cn">。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_36_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_37_0">
    <VALUE Lang="cn">....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_38_0">
    <VALUE Lang="cn">但最近这周围为非作歹的家伙变多了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_38_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_39_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">"不管怎样因为数字不足就这样放着,往后不知该怎办</VALUE>
    <VALUE Lang="cn">即使只有一点点余力,如能将会造成祸端的东西消失就太好了</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_39_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_4_0">
    <VALUE Lang="cn">用这样一脸无知的表情问的话,教你们的老师会很忧郁的</VALUE>
    <VALUE Lang="cn">哎呀,现在那个老师不知走到多远去了</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_4_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_40_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">"喔, 听说试验付出很多, 很奇特喔!</VALUE>
    <VALUE Lang="cn">是啊 序论 好像没有必要?</VALUE>
    <VALUE Lang="cn">哪里... 适当的课题找起来有点难.</VALUE>
    <VALUE Lang="cn">对啊, 那 程度的话没问题...</VALUE>
    <VALUE Lang="cn">学生有程度的话所谓'冰专家' 者知道吗?</VALUE>
    <VALUE Lang="cn">什么真吃惊...</VALUE>
    <VALUE Lang="cn">这次试验的课题一直把那人们撂倒.</VALUE>
    <VALUE Lang="cn">和以前的试验一样没有时间的限制</VALUE>
    <VALUE Lang="cn">做几次挑战都可以试试看!"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_40_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_41_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">"从容应变?</VALUE>
    <VALUE Lang="cn">那冰玦听说真的很少见?</VALUE>
    <VALUE Lang="cn">这个真的是以无时不做程度完成的吗.</VALUE>
    <VALUE Lang="cn">心情不佳却来找碴，根本是想惹事的家伙们...</VALUE>
    <VALUE Lang="cn">反正试验已经合格了!</VALUE>
    <VALUE Lang="cn">在上面恐怕没有老师痛恨的试验.</VALUE>
    <VALUE Lang="cn">听说满满的课题也找不到.</VALUE>
    <VALUE Lang="cn">那样真好."</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_41_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_42_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">您正前往 Root Hole吗？</VALUE>
    <VALUE Lang="cn">对把时间停止东西有点意外.</VALUE>
    <VALUE Lang="cn">把空间轴做变化的思维...</VALUE>
    <VALUE Lang="cn">说实在的，它连想像都有点费力, 空间轴是如何把它改变呢...</VALUE>
    <VALUE Lang="cn">财团总社在本洞有不同的东西你知道吗?</VALUE>
    <VALUE Lang="cn">总社内部可以确认的的话就好了…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_42_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_5_0">
    <VALUE Lang="cn">득도의 경지에 이른 ‘마루치’ 와 ‘아라치’ 의 기운이 서로 만날 때 이르는 경지를 가리키는 말인데</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">본래는 소승불교에서 모든 번뇌를 뚫고 이치를 깨달아 열반의 경지에 이른 성자를 말이고 ‘나한’ 이라고도 하지</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_5_0_1">
    <VALUE Lang="cn">'깨달음의 열쇠' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_5_0_2">
    <VALUE Lang="cn">'나한의 구슬' 에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_5_0_3">
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_6_0">
    <VALUE Lang="cn">그 열쇠를 지니고 있다면 재단에 보관중인 걸 받을 수도 있게 된다는 얘기는 들었지</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">하지만 지금은 조각조각으로 나뉘어져 있을테니까 일단 7조각을 모으게 되면 나한테 가져오도록 해</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_6_0_1">
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_7_0">
    <VALUE Lang="cn">아, 그 녹색 구슬 말이지?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">그냥 하나씩만으로는 별다를 게 없는데 30개를 다 합쳐서 목걸이를 만들면 꽤 쓸만해 진다지</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_7_0_1">
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_8_0">
    <VALUE Lang="cn">OK！让我想想.....</VALUE>
    <VALUE Lang="cn">我该怎么跟您解释呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_8_0_1">
    <VALUE Lang="cn">询问方向</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_8_0_2">
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_9_0">
    <VALUE Lang="cn">阿！听Construction Supervisor说过</VALUE>
    <VALUE Lang="cn">你接受我的请托 真是非常感谢</VALUE>
    <VALUE Lang="cn">他们也知道现在的状况在某种程度上来说是很奇怪的,所以尽可能帮你,做的真是太好了</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_9_0_1">
    <VALUE Lang="cn">申请考试</VALUE>
  </SENTENSE>
