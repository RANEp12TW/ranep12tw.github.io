  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_3_0">
    <VALUE Lang="cn">谢谢!!</VALUE>
    <VALUE Lang="cn">找到材料的话,我用那材料做的热狗,第一个就给您</VALUE>
  </SENTENSE>
