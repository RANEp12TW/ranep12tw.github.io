  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_1_0">
    <VALUE Lang="cn">…..嗯…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_1_0_1">
    <VALUE Lang="cn">与Bus Driver进行对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_1_0_2">
    <VALUE Lang="cn">Bus Driver的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_1_0_3">
    <VALUE Lang="cn">交付零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_1_0_4">
    <VALUE Lang="cn">Bus Driver的请求2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_1_0_5">
    <VALUE Lang="cn">询问他是否需要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_1_0_6">
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_10_0">
    <VALUE Lang="cn">不好意思，您可以帮我从Technical Teacher那儿要一点零件过来吗？ 他就在学院交叉路口那里。唯有如此我才能修好公车，使它发动成功！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_11_0">
    <VALUE Lang="cn">您有去过SG Hole了吗？如果有去过的话，那您一定有见过那些坏心的 Green Mask (Uncle Potato)。因为他们威胁我，甚至想我勒索。因此我连公车都不敢开了。</VALUE>
    <VALUE Lang="cn">如果可以的话，请您帮我打退他们。好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_11_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_12_0">
    <VALUE Lang="cn">谢谢您，现在我终于可以开公车载学生上下学了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_12_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_2_0">
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_3_0">
    <VALUE Lang="cn">哈哈！是的。您可以利用校车来通勤。搭车比步行的方式好太多了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_3_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_4_0">
    <VALUE Lang="cn">噢！我很抱歉，我不知道您在这儿！ 我正忙着找出这些不对劲的原因。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_4_0_1">
    <VALUE Lang="cn">询问他在做什么？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_5_0">
    <VALUE Lang="cn">噢！这台公车无法使用。连我都无法用它来进行工作。我得把它修好，这样学生们才能安全使用。毕竟在这混乱地区独自行走，是非常危险的事情。但现在没有修理用的零件，情况真糟糕。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_5_0_1">
    <VALUE Lang="cn">询问Driver关于更多的公车情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_6_0">
    <VALUE Lang="cn">根据公车残骸的报告评估，我可以说，修理这辆车不应该是个大问题。修复此车所需的零件，需要尽快收集到才行。在我能得到所有必要的配备之前，我是无法进行修理的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_6_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_7_0">
    <VALUE Lang="cn">谢谢您带来我要的零件了！我终于可以开始修 破损的公车了！从现在起，学生们往来其他地区间时，会更加的方便与安全唷！</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_7_0_1">
    <VALUE Lang="cn">Bus Driver的请求2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_8_0">
    <VALUE Lang="cn">请您去拜访Construction Supervisor，他位在Sacred Gate Campus的交叉路那儿。我听说他想请我帮忙，但我无法去找他，因为我得处理公车的问题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_9_0">
    <VALUE Lang="cn">几天前开始，公车就故障了。而且越来越严重，连发动都成问题了。好像此地区的其他公车也都有类似的问题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_busdriver1.ntk_9_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
