  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_10_0">
    <VALUE Lang="cn">学生...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">期待这位老年人什么?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">他呀!!</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">异常地尊重对方时，一定是有什么目的，不是吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">那么想给什么?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">虽想摆脱这危险的地方, 但以那么虚弱的身体，不要做梦了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_10_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_11_0">
    <VALUE Lang="cn">说什么来看看，自然可理解吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">在完全龟裂的街道上，飘了飘停在那固定的纸和车子...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">那样的话，这地方的时间也并非完全停止...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">目前为止，学生所学过的常识</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">是完全都停止的状况吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">我认为不想要理解，也是好事 ...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">哼， 那样看来，确实是一个是可理解的</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">这停止的时间是自然的自我防御本能</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn"> 扮演中继角色的, 就是财团本公司建筑物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_11_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_12_0">
    <VALUE Lang="cn">哈哈哈</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">听了这个而来</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">你真有两下啊</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">在那方面，我所知道的...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">那泼妇附带地说连礼物都给了</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">好像相当信任学生。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_12_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_13_0">
    <VALUE Lang="cn">是呀，照这那说，这老年人本来也是一位</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">那时, 和另一个世界接壤，虽不是那样，现在，那里完全一样的家伙，好像遍布都是的样子。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">财团的年轻人看了这个，称为『复制令』</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">理由是连区分谁是本尊的意义都没有</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">简言之，无法再以人的种类来区隔</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_13_0_1">
    <VALUE Lang="cn">听取劝告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_14_0">
    <VALUE Lang="cn">不想转达一句有助益的话吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">我认为多少要分享一点情报</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">要先说什么?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">是呀...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">现在马上就要见到学生真实的模样</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">很久以前, 存在于完全不同世界时的模样</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">那个，谁也不知道是得或是失</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">不知道那个模样也是好事</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">现在, 在此非要和怪物打架的理由是什么...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_14_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_15_0">
    <VALUE Lang="cn">学生曾想过吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">虽相然是说为了活下来而做的，但一半是错误答案</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">正无意识中调整仅存的责任感</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">也有可能拒绝责任感??</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">是噢!!</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_15_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_16_0">
    <VALUE Lang="cn">从观望者的立场中可看出光明和黑暗的战争机会</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">指的是透过这样的事故所给的</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">如何</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">这财团制造那种机会是向学生表达谢意吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">不然的话，是像诱惑吃善恶果的蛇一样的吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">呵呵!!</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">想着想着，还是蛮有趣的事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_16_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0">
    <VALUE Lang="cn">能使学生们变得更强大且能够发挥潜力，在目前没有自我提升的状况，只要再努力试看看，他的能力就能够一样地完全开放出来的东西….。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">怎样,要告诉你方法吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0_1">
    <VALUE Lang="cn">打听其传达方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0_2">
    <VALUE Lang="cn">打听其传达方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_17_0_3">
    <VALUE Lang="cn">打听其传达方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_18_0">
    <VALUE Lang="cn">如果要改变的学生程度，视学生自身情况而运用适当的道具是必要且免不了的.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">帮助这老人变成值得去做的事，要创造一些方法可以去了解他们所说的话..</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">如何, 了解吗? 知道吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_18_0_1">
    <VALUE Lang="cn">打听其传达方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_19_0">
    <VALUE Lang="cn">坚硬无比的地压戒指... 是那样地效果,</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">受到若干冲击的影响，可以使身体的机能受到催化的道具呀.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">当然，只有有预期的效果, 每个人身体才会一点一滴地成长, 这个道具是针对每个人专用目的而制造，而且可以看到改变后的效果，有达到原先的预期吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">换句话说...，为学生门了解并收集相关资料，才可以正确地制造适合他们的道具.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_19_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0">
    <VALUE Lang="cn">您想告诉老人什么事情？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_1">
    <VALUE Lang="cn">询问有关附近经过的学生</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_2">
    <VALUE Lang="cn">询问有关 圣财团的 HQ</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_3">
    <VALUE Lang="cn">询问有关老人的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_4">
    <VALUE Lang="cn">郑重的呈上问候</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_2_0_5">
    <VALUE Lang="cn">询问周遭的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_20_0">
    <VALUE Lang="cn">辛苦了.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">但是在这过程中要相当正确的收集.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">因为只有材料的话，并不能马上结束...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">唉, 这里有.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">使用看看吧.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">而且，这戒指上还可以再做些改良.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">主任的能力值增加的话，如果针对他的方法，也可以一起成长.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">适当的时候，要再进行一次搜寻.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_20_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_21_0">
    <VALUE Lang="cn">我偶然地发现珍贵的资料并在手上..</VALUE>
    <VALUE Lang="cn">听说不久前学生制造的戒指，如果再加以改良，就可以一样制作出更好的戒指。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_21_0_1">
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_21_0_2">
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_22_0">
    <VALUE Lang="cn">我刚好手上有些贵重的材料..</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">学生们如果加入这些材料的话，说不定可以制作出更好戒指。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_22_0_1">
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_22_0_2">
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_23_0">
    <VALUE Lang="cn">刚好破掉了, 真好!</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">好的方法要广为宣传.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">不过学生们的经验都还不足...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">万一比你强一点的对手找碴，也就可以明白因应之道. .</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">这样的程度的方法我喜欢，因为这些家伙们最近在找我们的碴.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_23_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_24_0">
    <VALUE Lang="cn">嗯…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">我这个老顽固没白活…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">你那样问我,是不是怀疑我的判断啊.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">我不是负责人，虽然我不是很清楚，但是看到你目前所做的事情，都值得称赞。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_24_0_1">
    <VALUE Lang="cn">询问财团的业绩</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_25_0">
    <VALUE Lang="cn">叫什么民俗学者?是那财团的创立者吗…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">刚开始创立财团时比较轰动。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">是啊… 据说合并全世界的教育机关。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">领来特别选出的学生，进行免费训练。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_25_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_26_0">
    <VALUE Lang="cn">据说援助了生活费…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">不仅仅是帮助学生，甚至连学生的家族都有援助.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">因此这附近的很多设施都重新建筑了。积极的参与很多社会福利的事业.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_26_0_1">
    <VALUE Lang="cn">询问他注意到的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_27_0">
    <VALUE Lang="cn">安分守己的普通市民很难亲眼目睹那些事情。是啊，是不是在虎令学院前面穿上黑色大衣的年轻人？</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">如果是他，因为是负责人，应该更清楚, 不是吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_27_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_28_0">
    <VALUE Lang="cn">其他地方都比较开放，只有这个建筑物感到有点封闭。以前看过据说有两个阶段的保安步骤…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">第一关，用眼睛看不到的晶片，移植到皮肤的人们,就能通过第一关。第二关是声音辨识，如果没有做注册的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_28_0_1">
    <VALUE Lang="cn">询问更加详细的内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_29_0">
    <VALUE Lang="cn">呵呵，我也不是负责人，能正确知道吗?说不定有第三个保安步骤。啊，对了，你到码头就可以见到跟我一样的老人。你去问问他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_29_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_3_0">
    <VALUE Lang="cn">学生? 是呀…看到了几个人...</VALUE>
    <VALUE Lang="cn">有趣啊</VALUE>
    <VALUE Lang="cn">在这停止的时间里，来要进行什么</VALUE>
    <VALUE Lang="cn">那样的话，应该要把时间连结起来...</VALUE>
    <VALUE Lang="cn">不是吗??</VALUE>
    <VALUE Lang="cn">我好像太高估了!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_30_0">
    <VALUE Lang="cn">为什么会有这么不堪的保安设备，是否准备好通过那些保安设备…有点担心啊.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">现在就算那样也只能是进去看，这更让人担心…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">虽然有收到资讯…但是先进去的学生打算等从1楼进来的学生。首先去正门前面，会自动完成保安步骤。好好利用能判读研究资料的终端机.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_30_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_31_0">
    <VALUE Lang="cn">自古以来这样的感觉是特别的…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">这Eight signs of divine… 不像是我们世界的.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">分明是能够离开这个世界的钥匙。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">那么，是不是想使用这个?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">如果是的话又得见血…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">这家伙… 正在寻找血。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">嘴也非常刁…</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">在那顶峰处,可能有适合这家伙口味的一群家伙。 …</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">不管怎样小心啊。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_31_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_4_0">
    <VALUE Lang="cn">学生们完全不知道自己的学院在哪里。</VALUE>
    <VALUE Lang="cn">更何况，怎么知道那财团的背景，</VALUE>
    <VALUE Lang="cn">简言之，圣财团当初创立的目的是不要破坏世界的均衡，</VALUE>
    <VALUE Lang="cn"> 是呀, 就是当初的目的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_4_0_1">
    <VALUE Lang="cn">询问关于Sacred Gate Financial Group的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_5_0">
    <VALUE Lang="cn">学生的性格好像很顽固。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">话虽如此，但我不喜欢那样的性格，因为年轻人一点也没有回头的意思，没有一天不发生冲突的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_5_0_1">
    <VALUE Lang="cn">询问关于Sacred Gate Financial Group HQ Building的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_6_0">
    <VALUE Lang="cn">我该忽视Old man的忠告吗？</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">和其他学生没什么不同啊</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">你是说想了解这大楼吗?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">至目前为止，还没有任何腹案， 其中倒底有什么问题??</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">不知道有什么事会发生!!</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">不知道是不是即使了解，也无法说明。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_7_0">
    <VALUE Lang="cn">在这里什么也不做地站着，好像蛮奇怪的</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">如何来这里的...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">如何不遭受损害...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">学生向大人请教什么时，必须先做自我介绍，连这种基本礼节都没有，有什么话好说?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_7_0_1">
    <VALUE Lang="cn">和老人顶嘴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_8_0">
    <VALUE Lang="cn">还真是血气旺盛的学生啊</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">我指的只是那样容易冲动</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">这个只会更令人担心</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">未来要打架的对象, 即使是他自己也...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">明显是百战百胜</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">学生要懂得先控制自己的情绪</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_8_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_9_0">
    <VALUE Lang="cn">虽有几个人经过这位老年人</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">担心我身体的，学生倒是一个呀</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">虽不知道是做做样子，还是真心的</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">即使如此，重要的是有所表示</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">嗯，我没必要担心</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">这附近空气比所见的还好</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">由于时间停止，故连关节炎什么的也没有</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_9_0_1">
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_9_0_2">
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_9_0_3">
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0">
    <VALUE Lang="cn">发生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_1">
    <VALUE Lang="cn">变更起点位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_10">
    <VALUE Lang="cn">听取任务内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_11">
    <VALUE Lang="cn">交出特别灵珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_12">
    <VALUE Lang="cn">警察的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_13">
    <VALUE Lang="cn">警察的测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_2">
    <VALUE Lang="cn">询问状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_3">
    <VALUE Lang="cn">询问有关 Main Hole</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_4">
    <VALUE Lang="cn">讨论状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_5">
    <VALUE Lang="cn">出示气象资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_6">
    <VALUE Lang="cn">询问天气状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_7">
    <VALUE Lang="cn">打开商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_8">
    <VALUE Lang="cn">传达抢来的爆竹</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_1_0_9">
    <VALUE Lang="cn">询问火灾状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_10_0">
    <VALUE Lang="cn">这区的火灾很多。罪魁祸首就是烟火。请没收这些烟火，并把它们都交给我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_10_0_1">
    <VALUE Lang="cn">开始进行"Collect Fireworks"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_10_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_11_0">
    <VALUE Lang="cn">感谢您。祝您好运。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_11_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_12_0">
    <VALUE Lang="cn">我想对灵珠做个比较。Bakulaw也许有个很特别的灵珠。请从Bakulaw那儿取得特别灵珠给我。谢谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_12_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_13_0">
    <VALUE Lang="cn">这是复制品。我们得做进一步的调查。在那之前，我想给您个灵珠，作为谢礼。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_13_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_14_0">
    <VALUE Lang="cn">我很高兴您来了。在这边，我只想帮您获取更多的能力。只要通过考验，您将能得到灵珠，学习新的能力唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_14_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_15_0">
    <VALUE Lang="cn">请歼灭在Root Hole的 Haring Braso。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_15_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_2_0">
    <VALUE Lang="cn">我不知道该说啥才好…那边不是山顶，但..时间是静止的。就算突然发生了大巨变，我们也一样看不到。不知道该笑还是该哭….总之，请参观一下周遭环境，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_3_0">
    <VALUE Lang="cn">人们在这里能感到安心。在这里呆再久皮肤不会变老，肚子不会变饿。噢，如果您受伤了，是不会痊愈的。还有件事情您可能不知道…我猜时间不是全部都停止的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_3_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_4_0">
    <VALUE Lang="cn">在发生的瞬间，是不会运作的。若亲自前往查看，您将会明白。位在Main Hole的Sacred Financial Group总公司有着许多有趣的设施。但，空气中，总流露一丝丝的懊恼与遗憾的味道。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_5_0">
    <VALUE Lang="cn">空气很清新，但我没能看到结果。从这通信设备可以传送到实验研究室。我认为我们应该要仔细调查一番，找线索是不容易滴。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_5_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_6_0">
    <VALUE Lang="cn">噢！可以请您告诉我Sacred Financial Group发生了什么大事吗？刚刚有个学生跑到Head Office building后，竟传出了一声很大的爆炸声响。我很担心，想过去看看，但为了要顾好这通信设备，以及取得与所有人的联络，我不能离开这个位置。所以，请您帮帮我好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_7_0">
    <VALUE Lang="cn">我听说如果您运气够好，马上就可以找到线索的。也许还可以找到更多的线索唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_7_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_8_0">
    <VALUE Lang="cn">我们需进行更深入更彻底的调查活动。现在的人手与场地根本不够支援。对我来说，这儿的空气有点闷。越靠近Main Hole越令人感到紧张，甚至是快窒息的感觉。我不确定是否是火灾所带来的影响，也许原本情况就是这么糟糕，不管怎样，我有点怀疑那正在燃烧的火焰。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_8_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_9_0">
    <VALUE Lang="cn">谢谢您。这些烟火需要被妥善的保管。现在，您已经知道许多关于Middle Hole和Root Hole的灾难事故了。我也很清楚，要杜绝这些烟火商的流通是不可能的。不过，我想只要做好消防宣传，增强防火意识，大概就不会有太多的问题了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e2_police.ntk_9_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_0">
    <VALUE Lang="cn">非常感谢您</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_0_1">
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_0_2">
    <VALUE Lang="cn">聊聊复制灵的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_1">
    <VALUE Lang="cn">欢迎！</VALUE>
    <VALUE Lang="cn">虽然我已经自顾不暇了，但我很开心能在这儿见到您。</VALUE>
    <VALUE Lang="cn">现在我可以请您帮个忙吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_1_1">
    <VALUE Lang="cn">寻求帮助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_1_2">
    <VALUE Lang="cn">寻求帮助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_1_1_3">
    <VALUE Lang="cn">聊聊关于复制灵的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_10_0">
    <VALUE Lang="cn">具有十分重要几何理论的基础工作已经完成。可惜该理论很快就被取用，理论尚未完整的状况下，应用在各各技术上,其中一个是D引擎，用在航空飞机上, 在非常狭窄的范围上压缩时间和空间，并减少飞行时间。</VALUE>
    <VALUE Lang="cn">在模拟实验上没有问题，但在最后的测试实用引擎时，整个实验器材突然消失了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_10_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_11_0">
    <VALUE Lang="cn">因为那个事件的缘故,取消了其他进行的计画案,全都当做机密处理,从此都已非公开的方式获得支援,越是如此就​​有更多的人有兴趣,反而使得流星雨现象的实验报告获得了肯定,虽然不是正式的,却能容易的成立了圣财团</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_11_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_12_0">
    <VALUE Lang="cn">起初，我想准备的像军队一样，但我看到在名单上的年龄太年轻。想让那些年轻人既不排斥,又能自然的受教育, 只有加入正规的教育课程,而且刚好也有适合的环境</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_12_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_13_0">
    <VALUE Lang="cn">因此加上了监护人项目, 使用了额外的强制力,或许你会认为那只是借口, 让未成年者去决定自己的未来,这世界还是太乱了一点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_13_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_14_0">
    <VALUE Lang="cn">虽然我们现在看不到另一个太阳，其实这里有两个太阳，但并不会觉得那么热，因为有充分的日照，提供了良好的环境，可是地球的另一边完全感受不到这种恩泽</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_14_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_15_0">
    <VALUE Lang="cn">糟糕！我用了"地球"这个名词，就像电影或者漫画中出现的一样，这里也有我们曾经住过的地方一样的空气，一样的土地，现在所站着地面也是一样，通过艰困的次元门槛来到的世界，竟然有这样的共同点，不觉得很奇怪吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_15_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_16_0">
    <VALUE Lang="cn">因为经过长时间战争的缘故，造成如此荒废的样子。是的，这里就如前面说的是地球。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_16_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_17_0">
    <VALUE Lang="cn">财团成立,学院准备好之后,后来才发现我们所知道的异界,就是我们所居住地方的遥远未来,这是非常不好的时间点,在我们没有万全的准备下,得到这意想不到的结果,我们能够知道一些异界的历史.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_17_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_18_0">
    <VALUE Lang="cn">我们称呼异界的这个地方, 完全的享受不到光的祝福。而且有个一直认为那是理所当然的叫"Daramai"的种族，在一次偶然的机会知道，他们一直以来是处在不公平的孤立状态。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_18_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_19_0">
    <VALUE Lang="cn">’Ragia‘"这种族不但拒绝了一起分享阳光的请求，还认为他们是被神遗弃的种族，甚至于想要灭杀"Daramai"种族，因此在异界发生光与黑暗的战争，造成这样的结果产生。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_19_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_2_0">
    <VALUE Lang="cn">应该不是很困难的事情.</VALUE>
    <VALUE Lang="cn">发展到现在, 比其过去所遭受的境遇,应该觉得像寻宝一样…</VALUE>
    <VALUE Lang="cn">虽然不是什么很值得高兴的宝物,</VALUE>
    <VALUE Lang="cn">现在这附近某处应该会有我的复制灵存在.</VALUE>
    <VALUE Lang="cn">我感觉到有距离感来看, 应该是我无法靠近的地方.所以我拜托你,只是去帮我了解一下在何处以何种型态存在着就可以了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_20_0">
    <VALUE Lang="cn">但是…发现"Daramai"的位置和我们财团大楼 SFG Head Office 的位置是相同的。是的！为了使"Daramai"的后代能够代代相传到未来, 他们困在Sacred Gate特殊区域引发战争。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_20_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_21_0">
    <VALUE Lang="cn">我只好改变想法了…,由于为了拯救世界,所累积的力量,却造成自己困在其中,而不可能独自承受所有的不利,反正这是历史的话,尽可能想变成有利的情况,我们吸收异界的知识,加上过去一直所准备的你们的力量,我们自己想要改变有个更好的未来</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_21_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_22_0">
    <VALUE Lang="cn">拆掉Leonine学院的屏障,准备生化武器的开发,终于有一天, 演变成连我自己都无法控制的状况.</VALUE>
    <VALUE Lang="cn">为了更高的目标,牺牲是无法避免的想法之下,招集了你们,但不知何时开始,所以失去了目标和方向,盲目的往前行</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_22_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_23_0">
    <VALUE Lang="cn">看你们如此卖命的样子,发现过去我所做的事情太自私了!</VALUE>
    <VALUE Lang="cn">现在时机到了,应​​该是把所有的东西交给你们的时候。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_23_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_24_0">
    <VALUE Lang="cn">对…</VALUE>
    <VALUE Lang="cn">希望是那样了吧?</VALUE>
    <VALUE Lang="cn">在我的房间里,应该看到跟我一样的一些人吧.</VALUE>
    <VALUE Lang="cn">那也是对的.</VALUE>
    <VALUE Lang="cn">但我也是真的…</VALUE>
    <VALUE Lang="cn">互相都认为是真的, 不是吗?</VALUE>
    <VALUE Lang="cn">你若愿意相信我, 我想拜托你一件事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_24_0_1">
    <VALUE Lang="cn">询问委托一事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_3_0">
    <VALUE Lang="cn">这样啊 … 在那种地方…</VALUE>
    <VALUE Lang="cn">以那个样子存在着.</VALUE>
    <VALUE Lang="cn">还好…我没有再靠近是一件聪明的事情.</VALUE>
    <VALUE Lang="cn">反而我会被消灭掉也说不定.</VALUE>
    <VALUE Lang="cn">若是那样至少两个世界互相纠缠在一起后会被自灭掉</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0">
    <VALUE Lang="cn">我有漏说什么吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0_1">
    <VALUE Lang="cn">询问圣徒之表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0_2">
    <VALUE Lang="cn">询问有关财团SFG</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0_3">
    <VALUE Lang="cn">询问有关学院</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_4_0_4">
    <VALUE Lang="cn">询问有关异世界</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_5_0">
    <VALUE Lang="cn">不用标上那么夸张的名字..</VALUE>
    <VALUE Lang="cn">不过是单纯的名单罢了…</VALUE>
    <VALUE Lang="cn">不管它的用途是什么? 结果只是制作人名单而已.</VALUE>
    <VALUE Lang="cn">若是成为问题的话</VALUE>
    <VALUE Lang="cn">就是把那些名单里面的人, 太过积极努力的召唤罢了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_5_0_1">
    <VALUE Lang="cn">询问关于受伤的学生</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_6_0">
    <VALUE Lang="cn">当然知道</VALUE>
    <VALUE Lang="cn">都是我指示的.</VALUE>
    <VALUE Lang="cn">其实…</VALUE>
    <VALUE Lang="cn">我自己认为我说出内情,大家就会奉献是一种错误的想法.</VALUE>
    <VALUE Lang="cn">剩下时间不足,名单里面的人无法顺利的招集在一起</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_6_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_7_0">
    <VALUE Lang="cn">想要成为英雄的想法之类的…</VALUE>
    <VALUE Lang="cn">不是, 或许曾经有过那样的想法…</VALUE>
    <VALUE Lang="cn">想要成为英雄表示肯定其他人的存在之意义.</VALUE>
    <VALUE Lang="cn">但是我没有那个样子.</VALUE>
    <VALUE Lang="cn">不管人如何, 我希望其他的东西继续保留着</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_7_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_8_0">
    <VALUE Lang="cn">决定我不在乎听到任何的抱怨.</VALUE>
    <VALUE Lang="cn">刚好改变历史的事情, 甚至于瞬间伤害他人的事都得到支援,</VALUE>
    <VALUE Lang="cn">那种程度的强制力,可以轻易的使用.</VALUE>
    <VALUE Lang="cn">甚至不会感觉到一丝丝的罪恶感</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_8_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_9_0">
    <VALUE Lang="cn">18年前参加调查流星雨现象的研究团队的当时,只是认为那是非常奇特的自然现象.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">谁知道它能打破了整个我们原来的认知. 发现调查毫无进展之后,调查团队就解散了. 调查的权限也转到了他人的手中,但还不到一年的时间,重新成立了调查团队,在第二次调查的现场,发现了空间的龟裂</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_boss1.ntk_9_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_brian1.ntk_1_0">
    <VALUE Lang="cn">…</VALUE>
