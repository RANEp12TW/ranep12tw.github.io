  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_2"><VALUE Lang="tw">兌換 碧波劍氣（87級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="id">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="cn">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="th">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_3"><VALUE Lang="tw">兌換 震撼噴流（57級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="id">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="cn">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="th">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_4"><VALUE Lang="tw">兌換 無盡怒氣（87級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="id">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="cn">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="th">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_0">
    <VALUE Lang="cn">你看起来不像是一个魔术师…. 我也不是一个友善的老人….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_0_1">
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1">
    <VALUE Lang="cn">你肯定是一个魔术师, 是吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_1">
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_10">
    <VALUE Lang="cn">听取如何提高魔术等级的建议.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_2">
    <VALUE Lang="cn">询问Dahlia的含义.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_3">
    <VALUE Lang="cn">听取如何提高魔术等级的建议.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_4">
    <VALUE Lang="cn">获得Crucio的青睐.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_5">
    <VALUE Lang="cn">提交你调查的信息</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_6">
    <VALUE Lang="cn">学习Crucio的第一节课</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_7">
    <VALUE Lang="cn">学习Crucio的第二节课</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_8">
    <VALUE Lang="cn">学习Crucio的第三节课</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_9">
    <VALUE Lang="cn">听取如何提高魔术等级的建议.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_10_0">
    <VALUE Lang="cn">我会在这里等着的.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_11_0">
    <VALUE Lang="cn">我真愚蠢, 居然不知道真相.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_12_0">
    <VALUE Lang="cn">祝你好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0">
    <VALUE Lang="cn">试着去猜猜的答案.</VALUE>
    <VALUE Lang="cn">你可以在试一次, 不要灰心.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_1">
    <VALUE Lang="cn">热情的爱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_2">
    <VALUE Lang="cn">永恒的爱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_3">
    <VALUE Lang="cn">非常感谢你的照顾.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_4">
    <VALUE Lang="cn">纯洁的灵魂</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_3_0">
    <VALUE Lang="cn">那就是Rose所象征的含义，在想一想.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_3_0_1">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_4_0">
    <VALUE Lang="cn">那就是Lily所象征的含义，在想一想.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_4_0_1">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_5_0">
    <VALUE Lang="cn">你是对的, 让我给你你应得的奖励.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_5_0_1">
    <VALUE Lang="cn">获取奖励.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_6_0">
    <VALUE Lang="cn">那就是Gypsophila所象征的含义，在想一想.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_6_0_1">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_7_0">
    <VALUE Lang="cn">希望你开心.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_8_0">
    <VALUE Lang="cn">与魔术训练师对话.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0">
    <VALUE Lang="cn">你正在看着一位老人，可我曾经是一个伟大的战士. 为了爱人我曾经与伟大的魔法师，’Valentino‘战斗过. 不幸的是，我失败了. 我跑到悬崖上，藏在山洞里. 但幸运的是我没有放弃. 我活了下来. 你可以去Sacred gate Police找出一些关于我爱人的消息吗？我将把我的技能传授给你.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0_1">
    <VALUE Lang="cn">告诉他，获得他的好感.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0_2">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_1_0">
    <VALUE Lang="cn">Abra Kadabra~我是Animal Trainer, 我能为你做什么?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_1_0_1">
    <VALUE Lang="cn">获得一只魔术宠物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0">
    <VALUE Lang="cn">想获得一只魔术宠物, 你需要学习Animal Mastery, 你学会该技能了吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0_1">
    <VALUE Lang="cn">是的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0_2">
    <VALUE Lang="cn">没有</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_3_0">
    <VALUE Lang="cn">很遗憾, 你还没有学习Animal Mastery. 先学习此技能吧.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_3_0_1">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0">
    <VALUE Lang="cn">你已经学会了Animal Mastery. 但是最好先让我给你说明一下. 这些宠物都有技能, 可以把等级从 orders 1升到4. 每升级一个技能它们就会变得越来越强大. 你现在要看看这些技能吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_1">
    <VALUE Lang="cn">询问关于Tiger</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_2">
    <VALUE Lang="cn">询问关于Cat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_3">
    <VALUE Lang="cn">询问关于Owl</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0">
    <VALUE Lang="cn">魔术宠物 老虎</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">指令1. 持续1.5秒 将目标拉向自己, 移动速度-30%, HP吸收+10%</VALUE>
    <VALUE Lang="cn">指令2. 持续1.5秒 移动速度-20%, HP吸收+10%, 技能范围-70</VALUE>
    <VALUE Lang="cn">指令3. 持续1.5秒 迅速接近目标, HP吸收+10%, 固定目标, 禁用恢复药水</VALUE>
    <VALUE Lang="cn">指令4. 持续0.8秒 使目标眩晕, HP吸收+10%, 防御 -10%</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">宠物技能属于攻击技能.</VALUE>
    <VALUE Lang="cn">是不是想和它一起在战场上战斗呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0_1">
    <VALUE Lang="cn">获得Tiger</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0_2">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0">
    <VALUE Lang="cn">魔术宠物 猫</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">指令1. 持续1.5秒 每秒+100, 移除 debuff, 防止状态异常/恢复</VALUE>
    <VALUE Lang="cn">指令2. 持续1.5秒 吸收物理伤害+10%, 防御力+5%, HP+MP+SP恢复率0.01%</VALUE>
    <VALUE Lang="cn">指令3. 持续2秒 攻击力+15%, 命中力+30</VALUE>
    <VALUE Lang="cn">指令4. 1秒内 魔法损坏 吸收+10%, HP恢复率 +0.2%, 抵抗 +20, 攻击速度 +20%, 移动速度+20%</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">拥有增益技能.</VALUE>
    <VALUE Lang="cn">不想和可爱的猫咪一起战斗吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0_1">
    <VALUE Lang="cn">获得Cat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0_2">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_7_0">
    <VALUE Lang="cn">魔术宠物 猫头鹰</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">指令1. 持续2秒 防御力-10%, 攻速-20%, HP吸收+10%,</VALUE>
    <VALUE Lang="cn">指令2. 持续2秒 防御力-10%, 技能冷却时间+10%, HP吸收+10%</VALUE>
    <VALUE Lang="cn">指令3. 持续1.5秒 防御力-30%, 命中-45, 攻击力-30%, HP吸收+10%,</VALUE>
    <VALUE Lang="cn">指令4. 持续0.8秒 防御力-10%, 禁用技能, 禁用药水, HP吸收+10%</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">拥有攻击技能.</VALUE>
    <VALUE Lang="cn">不想和拥有降低敌人能力值技能的猫头鹰一起战斗吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_7_0_1">
    <VALUE Lang="cn">获得Owl</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_7_0_2">
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_ruin.ntk_1_0">
    <VALUE Lang="cn">敌人随时都会来抢夺据点，不要放松警惕!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_ruin.ntk_1_0_1">
    <VALUE Lang="cn">出售道具</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_sia.ntk_1_0">
    <VALUE Lang="cn">由于是财团的方针，所以不能加以干涉…但是情况看起来不是很好..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_sia.ntk_1_0_1">
    <VALUE Lang="cn">出售道具</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_0">
    <VALUE Lang="cn">你好？你是这里的学生吗? 很高兴见到你, 我以前也是这里的学生, 可是现在已经毕业，并获得了很大的成功，呵呵呵.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">--------------------------------------------------</VALUE>
    <VALUE Lang="cn">我经常带着各种礼物来这里找学生们.</VALUE>
    <VALUE Lang="cn">想要礼物吗? 哈哈.. 但是不可以那么轻易就给你. 我很喜欢玩.. 想不想和我一起玩呢? 跟我一起玩的话我就给你礼物. 呵呵</VALUE>
    <VALUE Lang="cn">--------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_0_1">
    <VALUE Lang="cn">商店出售</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_0_2">
    <VALUE Lang="cn">给我礼物吗? 怎么才能够获得?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_1">
    <VALUE Lang="cn">你好？你是这里的学生吗? 很高兴见到你, 我以前也是这里的学生, 可是现在已经毕业，并获得了很大的成功，呵呵呵.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">--------------------------------------------------</VALUE>
    <VALUE Lang="cn">我经常带着各种礼物来这里找学生们. 可是你的等级有点低，还不能跟我一起玩. 等级到达 30以后再来找我，我就可以和你一起玩了. 努力提升等级吧. 我会等着你.</VALUE>
    <VALUE Lang="cn">---------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_2_0">
    <VALUE Lang="cn">哈哈. 那得看你的表现了, 那么开始狂欢吧?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">--------------------------------------------------</VALUE>
    <VALUE Lang="cn">想兑换礼物的话，得先吃我的便当获得力量，才能从怪物身上获得我美丽的肖像画碎片. 将搜集到的一定数量此碎片交给我，你就能兑换到你想要的礼物. 哈哈 虽然我们的狂欢每天都进行着，可是必须得吃上便当才能开始，且时许时间只有3个小时哦. 好好加油吧.</VALUE>
    <VALUE Lang="cn">---------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_2_0_1">
    <VALUE Lang="cn">好吧. 我也很喜欢玩. (开始任务)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_3_0">
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">我很欣赏你? 一起狂欢吧. 哈哈</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">----------------------------------------------</VALUE>
    <VALUE Lang="cn">如果完成了日常任务将获得用于兑换代表着狂欢开始的箱子的兑换券. 箱子里面装有我的特别便当. 呵呵 那么好好加油吧.</VALUE>
    <VALUE Lang="cn">-----------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_1_0">
    <VALUE Lang="cn">시험을 치르기 위해 한 학생이 시험지를 배부받아갔다더니 그게 자네군... 그래 얼마나 열심히 공부했는지 볼까?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_1_0_1">
    <VALUE Lang="cn">시험을 시작한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_1_0_3">
    <VALUE Lang="cn">반성문을 제출한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_10_0">
    <VALUE Lang="cn">음... 그렇다면 기숙사에 있는 쓰레기장에서 청소를 하며 반성문을 모아오시게 그러면 다시한번 생각을 해보겠네.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_10_0_1">
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_2_0">
    <VALUE Lang="cn">축하하네. 학교에 이런학생이 있었다니 가슴이 벅차오르는군. 이 의견서를 교무실에 계신 학생 주임에게 드리게.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_2_0_2">
    <VALUE Lang="cn">의견서를 배부받는다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0">
    <VALUE Lang="cn">다음 중 함수 y=2x+4의 그래프 위에 있는 점은 무엇인가?</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_1">
    <VALUE Lang="cn">1. (0,2)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_2">
    <VALUE Lang="cn">2. (1,6)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_3">
    <VALUE Lang="cn">3. (-1,-2)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_4">
    <VALUE Lang="cn">4. (2,6)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0">
    <VALUE Lang="cn">남학생은 한 명이 10일 동안 여학생은 한명이 15일 동안 걸려서 할 수 있는 일을 남학생과 여학생을 합해 12명이 하루에 끝내려고 한다. 남학생은 최소한 몇 명이 필요한가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_1">
    <VALUE Lang="cn">1. 4명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_2">
    <VALUE Lang="cn">2. 5명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_3">
    <VALUE Lang="cn">3. 6명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_4">
    <VALUE Lang="cn">4. 7명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0">
    <VALUE Lang="cn">합이 163인 두 자연수가 있다. 큰 수를 작은 수로 나누면 몫이 7이고 나머지는 3이다. 두 자연수 중에서 작은 수를 구하면 무엇인가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_1">
    <VALUE Lang="cn">1. 7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_2">
    <VALUE Lang="cn">2. 20</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_3">
    <VALUE Lang="cn">3. 52</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_4">
    <VALUE Lang="cn">4. 77</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0">
    <VALUE Lang="cn">연립 방정식 2x+y=4x-3y=5를 푼다면 과연 x,y의 값은 얼마인가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_1">
    <VALUE Lang="cn">1. x=-1, y=3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_2">
    <VALUE Lang="cn">2. x=2, y=1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_3">
    <VALUE Lang="cn">3. x=-2, y=-1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_4">
    <VALUE Lang="cn">4. x=1, y=2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0">
    <VALUE Lang="cn">톱니의 수가 30개, 42개인 두 톱니바퀴가 맞물려 돌아가고 있다. 두 톱니가 한 번 맞물린 후 같은 톱니에서 다시 맞물릴 때까지 큰 톱니바퀴는 몇 바퀴를 돌아야 하는가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_1">
    <VALUE Lang="cn">1. 3바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_2">
    <VALUE Lang="cn">2. 4바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_3">
    <VALUE Lang="cn">3. 5바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_4">
    <VALUE Lang="cn">4. 6바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_8_0">
    <VALUE Lang="cn">아직 수양이 부족한 것 같군. 이래서 어떻게 시험을 볼 생각을 했는지....쯧쯧.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_8_0_1">
    <VALUE Lang="cn">다시한번 시험을 치르고 싶다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_9_0">
    <VALUE Lang="cn">그렇군 반성문을 적어왔군. 이제는 정말 잘할 자신이 있겠지. 좋아... 다시한번 기회를 주지. 이번에는 잘해보게나</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_9_0_1">
    <VALUE Lang="cn">시험을 재도전한다.</VALUE>
  </SENTENSE>

