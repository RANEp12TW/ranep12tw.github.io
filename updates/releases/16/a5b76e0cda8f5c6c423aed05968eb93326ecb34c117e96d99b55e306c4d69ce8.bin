  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_0">
    <VALUE Lang="cn">来了来了~ 活动小帮手来了!</VALUE>
    <VALUE Lang="cn">咦 ? 只有LV30以上的玩家才能参加此次的活动!</VALUE>
    <VALUE Lang="cn">你的等级还不够哦!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_0_1">
    <VALUE Lang="cn">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_1">
    <VALUE Lang="cn">大家好! 同学们~ 我是来通知大家有关此次活动的各种消息的!</VALUE>
    <VALUE Lang="cn">前几天刚开始了一个活动，有可能很多同学们都对此不是很了解，所以我是特地赶来通知大家的~</VALUE>
    <VALUE Lang="cn">是不是对此次的活动很感兴趣呢~?</VALUE>
    <VALUE Lang="cn">消灭各学院中的Little Hooligan，帮我找回线索!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_1_1">
    <VALUE Lang="cn">寻找线索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_july_event.ntk_1_1_2">
