  <SENTENSE Ver="1" Id="npc_cs_storage.ntk_1_0">
    <VALUE Lang="cn">金库的保安系统一切正常。和其他置物箱的连接状态也非常安全。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cube01.ntk_1_0">
    <VALUE Lang="cn">哈喽！</VALUE>
    <VALUE Lang="cn">欢迎来到 Cubelaps。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cube01.ntk_1_0_1">
    <VALUE Lang="cn">开启商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_1_0">
    <VALUE Lang="cn">控管办公室出入口的认证终端机：正常运作中！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_1_0_1">
    <VALUE Lang="cn">认证执行</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_1_0_2">
    <VALUE Lang="cn">认证执行</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_2_0">
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_3_0">
    <VALUE Lang="cn">认证执行成功。获准控管办公室的进出。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_3_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_4_0">
    <VALUE Lang="cn">密码错误。无法出入此地。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_4_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_1_0">
    <VALUE Lang="cn">额吼….</VALUE>
    <VALUE Lang="cn">我现在是要怎么活下去？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_1_0_1">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_1_0_2">
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_1_0_3">
    <VALUE Lang="cn">给看弯曲的钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_1_0_4">
    <VALUE Lang="cn">给看弯曲的钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_1_0_5">
    <VALUE Lang="cn">想要知道当初异变发生的当天的更多详细的情况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_10_0">
    <VALUE Lang="cn">之后正在考虑要报警的时候，就突然听到3楼有爆炸的声音，且在爆炸的同时，所有的玻璃窗全都破碎，然后周围所有的人，就一个个开始变成了怪物……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_10_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_11_0">
    <VALUE Lang="cn">我这个老人还能怎样…..我也只能站在那边发抖。就在那个时候，有一群人踢开铁门冲了出来。再隔了一阵子，就看到两个男生扶着另一个受伤的人走出来。那个人伤的很重，全身上下的衣物都被血染红了…..实在是太恐怖了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_11_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_12_0">
    <VALUE Lang="cn">虽然有与其中几个人对到眼睛，但我实在不敢开口询问。在这群人全部离开后，隔了一阵子，又有一群非常可疑的人跑过来，然后其中两人朝着先前那些人离开的方向跑去，而其他人就全部跑散了。有些人朝着码头跑过去，有些人朝着仓库的方向跑过去….现在回想起来，他们的穿着实在是有点奇怪。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_12_0_1">
    <VALUE Lang="cn">问他是否之后再也没见过他们了呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_13_0">
    <VALUE Lang="cn">之后我就没有见到他们了.. 正确来说再也没有看过保持清醒的人了.虽然偶尔也会看到一些人来来回回的跑,但看起来这些人的精神状态都是很不稳定的,所以我也不赶贸然跟他们搭话。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_13_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_2_0">
    <VALUE Lang="cn">….....</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_3_0">
    <VALUE Lang="cn">现在这建筑物仍继续管制中无可奈何只好帮忙不这样怎办哩</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_3_0_2">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_4_0">
    <VALUE Lang="cn">嗯....</VALUE>
    <VALUE Lang="cn">现在仍有要做的事情,</VALUE>
    <VALUE Lang="cn">可以合成钥匙做成一把完整的吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_4_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_5_0">
    <VALUE Lang="cn">......3</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_6_0">
    <VALUE Lang="cn">青的人虽然长得凶恶,不过有礼貌又亲切,</VALUE>
    <VALUE Lang="cn">但是那群人现在完全失了神</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_6_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_7_0">
    <VALUE Lang="cn">.....4</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_8_0">
    <VALUE Lang="cn">来！</VALUE>
    <VALUE Lang="cn">不是很难。</VALUE>
    <VALUE Lang="cn">我年轻的时候就很厉害了。</VALUE>
    <VALUE Lang="cn">来!</VALUE>
    <VALUE Lang="cn">做好了!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_8_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_9_0">
    <VALUE Lang="cn">那天的天气非常的好。不论是水手或者在码头边从事各行各业的人，都在准备着要去上班。除了许多学生跑进建筑物内的事情以外。这些家伙…​​根本就是目中无人。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_9_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_helper.ntk_1_0">
    <VALUE Lang="cn">能告诉我你在找什么吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_helper.ntk_1_0_1">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_0">
    <VALUE Lang="cn">幸会。可以拜托你帮忙一个简单的任务吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_0_1">
    <VALUE Lang="cn">接受可疑人士的请托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_1">
    <VALUE Lang="cn">嘿~.</VALUE>
    <VALUE Lang="cn">真的都找回来了呀,</VALUE>
    <VALUE Lang="cn">真开心啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_1_1">
    <VALUE Lang="cn">转交经典</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_2">
    <VALUE Lang="cn">嘿!</VALUE>
    <VALUE Lang="cn">还真是可靠的朋友啊!</VALUE>
    <VALUE Lang="cn">但是, 衣服怎么穿这样</VALUE>
    <VALUE Lang="cn">人家说佛要金装, 人要衣装</VALUE>
    <VALUE Lang="cn">刚好我这有准备好的衣服, 我去拿来给你</VALUE>
    <VALUE Lang="cn">老人家认为是偶尔给个礼物, 我却非常感激啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_2_1">
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_3">
    <VALUE Lang="cn">嘿!</VALUE>
    <VALUE Lang="cn">还真是可靠的朋友啊!</VALUE>
    <VALUE Lang="cn">但是, 衣服怎么穿这样</VALUE>
    <VALUE Lang="cn">人家说佛要金装, 人要衣装</VALUE>
    <VALUE Lang="cn">刚好我这有准备好的衣服, 我去拿来给你</VALUE>
    <VALUE Lang="cn">老人家认为是偶尔给个礼物, 我却非常感激啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_3_1">
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_4">
    <VALUE Lang="cn">嘿!</VALUE>
    <VALUE Lang="cn">还真是可靠的朋友啊!</VALUE>
    <VALUE Lang="cn">但是, 衣服怎么穿这样</VALUE>
    <VALUE Lang="cn">人家说佛要金装, 人要衣装</VALUE>
    <VALUE Lang="cn">刚好我这有准备好的衣服, 我去拿来给你</VALUE>
    <VALUE Lang="cn">老人家认为是偶尔给个礼物, 我却非常感激啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_4_1">
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_5">
    <VALUE Lang="cn">嘿!</VALUE>
    <VALUE Lang="cn">还真是可靠的朋友啊!</VALUE>
    <VALUE Lang="cn">但是, 衣服怎么穿这样</VALUE>
    <VALUE Lang="cn">人家说佛要金装, 人要衣装</VALUE>
    <VALUE Lang="cn">刚好我这有准备好的衣服, 我去拿来给你</VALUE>
    <VALUE Lang="cn">老人家认为是偶尔给个礼物, 我却非常感激啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_5_1">
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_6">
    <VALUE Lang="cn">哇!</VALUE>
    <VALUE Lang="cn">身体看起来相当的强壮!</VALUE>
    <VALUE Lang="cn">可是衣服怎么穿成那样?</VALUE>
    <VALUE Lang="cn">佛要金装,人要衣装才可以,</VALUE>
    <VALUE Lang="cn">刚好我有帮你准备了,你去找一下拿去穿吧.</VALUE>
    <VALUE Lang="cn">就当作是老人家送给你的礼物吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_6_1">
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7">
    <VALUE Lang="cn">海的味道，是这里唯一让我感到平静的东西。</VALUE>
    <VALUE Lang="cn">那些可恶歹徒掌控了设备的控制。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_1">
    <VALUE Lang="cn">向Old Man打招呼</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_10">
    <VALUE Lang="cn">询问文件书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_11">
    <VALUE Lang="cn">兑换 13 灵珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_12">
    <VALUE Lang="cn">询问要进入Head Office的安全密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_13">
    <VALUE Lang="cn">询问植入密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_2">
    <VALUE Lang="cn">询问发生了何事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_3">
    <VALUE Lang="cn">传达空瓶</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_4">
    <VALUE Lang="cn">询问发生了何事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_5">
    <VALUE Lang="cn">传达零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_6">
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_7">
    <VALUE Lang="cn">传达卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_8">
    <VALUE Lang="cn">询问卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_7_9">
    <VALUE Lang="cn">传达已修复好的卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_8">
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_10_0">
    <VALUE Lang="cn">看起来好像长期受潮的样子。</VALUE>
    <VALUE Lang="cn">还有不少盐分。</VALUE>
    <VALUE Lang="cn">去找Trading Hole 的影像专家 Image Expert，拜托他修复带子。</VALUE>
    <VALUE Lang="cn">是我认识的朋友，二话不说就会帮忙了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_10_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_11_0">
    <VALUE Lang="cn">嗯…</VALUE>
    <VALUE Lang="cn">辛苦了，学生。</VALUE>
    <VALUE Lang="cn">帮忙修复的朋友没说叫什么吗?</VALUE>
    <VALUE Lang="cn">行了，没关系…</VALUE>
    <VALUE Lang="cn">一时之间，先把带子的事忘掉。</VALUE>
    <VALUE Lang="cn">别婆婆妈妈的了。</VALUE>
    <VALUE Lang="cn">日前孩子们不知是被绑架了，还是消失了…</VALUE>
    <VALUE Lang="cn">探听之下，原来是那些人…</VALUE>
    <VALUE Lang="cn">还是全都忘掉才好。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_11_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_12_0">
    <VALUE Lang="cn">.......</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_13_0">
    <VALUE Lang="cn">以前虽听说要到No. 4 Wharf，但并未明确要给何人，所以就暂时搁着。</VALUE>
    <VALUE Lang="cn">虽没有帮手，但不难找。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_13_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_14_0">
    <VALUE Lang="cn">以后麻烦的事还多著呢。</VALUE>
    <VALUE Lang="cn">相信你会好好干的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_14_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_16_0">
    <VALUE Lang="cn">来到这种地方，看他问什么，即使不说，也大概知道是为了那份文件…我现在可没有那份文件…不久前扛着好像鱼的男子来过，全都带走了，什么…</VALUE>
    <VALUE Lang="cn">从文件到书籍，凡是用纸做的东西全都带走了。</VALUE>
    <VALUE Lang="cn">还真…做得很好。</VALUE>
    <VALUE Lang="cn">你如果把那些找回来的话，我不会忘记，一定会向您致谢的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_16_0_1">
    <VALUE Lang="cn">听取Old Man的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_16_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_17_0">
    <VALUE Lang="cn">谢谢…</VALUE>
    <VALUE Lang="cn">虽然剩下的书大多是旧书， 但对我而言则是重要的…</VALUE>
    <VALUE Lang="cn">保重，祝你好运</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_17_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_18_0">
    <VALUE Lang="cn">喂…收下。</VALUE>
    <VALUE Lang="cn">不是特殊的珠子吗?</VALUE>
    <VALUE Lang="cn">不是啦…已经很普遍了。</VALUE>
    <VALUE Lang="cn">当作纪念也好，不然的话，以后必要时，我也可以用文件来交换。</VALUE>
    <VALUE Lang="cn">你方便就好</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_18_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0">
    <VALUE Lang="cn">哼…我给您的珠子又还给我了吗？有些意外…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_1">
    <VALUE Lang="cn">获得Dance of the Warrior 技能文书</VALUE>
  </SENTENSE>
