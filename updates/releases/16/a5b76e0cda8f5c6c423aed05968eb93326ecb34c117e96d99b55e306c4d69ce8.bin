  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_13_0_3"><VALUE Lang="tw">兌換 迅捷斬（127級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Swift Slash (Lv127, Class=130, Item=175/30)</VALUE><VALUE Lang="id">Skill book: Swift Slash (Lv127, Class=130, Item=175/30)</VALUE><VALUE Lang="cn">Skill book: Swift Slash (Lv127, Class=130, Item=175/30)</VALUE><VALUE Lang="th">Skill book: Swift Slash (Lv127, Class=130, Item=175/30)</VALUE></SENTENSE>
