  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_28_0">
    <VALUE Lang="cn">喔,好,辛苦了</VALUE>
    <VALUE Lang="cn">用这个就可以使用必要的设备了</VALUE>
    <VALUE Lang="cn">.....等一下,不会等很久的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_28_0_1">
