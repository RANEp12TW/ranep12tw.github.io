  <SENTENSE Ver="1" Id="2017_level_dungeon.ntk_2_0">
    <VALUE Lang="cn">祝你好运!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_1_0">
    <VALUE Lang="cn">你好! 很高兴再次见面</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_1_1">
    <VALUE Lang="cn">你好! 很高兴再次见面</VALUE>
    <VALUE Lang="cn">额!!! 别走 别走啊 ~ 这次不是来麻烦你的.</VALUE>
    <VALUE Lang="cn">稍等一下啊~  看！！ 这是我为你准备的小礼物~</VALUE>
    <VALUE Lang="cn">在我这里拿到入场券,从那个门进去便可以</VALUE>
    <VALUE Lang="cn">别犹豫了~快去拿礼物吧 希望你们能够拿到很多礼物！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_1_1_1">
    <VALUE Lang="cn">接收Park of Presents Entry Ticket</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_2_0">
    <VALUE Lang="cn">但是一天只有30分钟的时间可以随便的领取礼物 快点行动吧!!~</VALUE>
    <VALUE Lang="cn">晚一点的话你想要的礼物也许会被比人抢走！ 快点行动!!~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_2_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_0">
    <VALUE Lang="cn">你好！ 我是来自于奇幻森林的 Chloe~</VALUE>
    <VALUE Lang="cn">我非常喜欢绿色,因为绿色让我感觉很平静,很舒服.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_0_1">
    <VALUE Lang="cn">开店铺</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_1">
    <VALUE Lang="cn">你好！ 我是来自于奇幻森林的 Chloe~</VALUE>
    <VALUE Lang="cn">可以听我说话么？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_1_1">
    <VALUE Lang="cn">有什么事 ?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_1_2">
    <VALUE Lang="cn">开店铺</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_0">
    <VALUE Lang="cn">三叶草代表幸运的象征</VALUE>
    <VALUE Lang="cn">所以希望你在今年一年里能够幸福</VALUE>
    <VALUE Lang="cn">但是用幸福能够转换成话那是一件多么好的事啊？</VALUE>
    <VALUE Lang="cn">请接收我的祝福并在规定的时间内筹集三叶草</VALUE>
    <VALUE Lang="cn">我会把幸福转换成幸运.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_0_1">
    <VALUE Lang="cn">好!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_1">
    <VALUE Lang="cn">三叶草代表幸运的象征</VALUE>
    <VALUE Lang="cn">所以希望你在今年一年里能够幸福</VALUE>
    <VALUE Lang="cn">但是如果能用幸福转换幸运的话那是一件多么好的事情啊？</VALUE>
    <VALUE Lang="cn">请接收我的祝福并在规定的时间内筹集三叶草</VALUE>
    <VALUE Lang="cn">我会把幸福转为幸运.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_1_1">
    <VALUE Lang="cn">好!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_2">
    <VALUE Lang="cn">三叶草代表幸运的象征</VALUE>
    <VALUE Lang="cn">所以希望你在今年一年里能够幸福</VALUE>
    <VALUE Lang="cn">但是用幸福和幸运换的话那是一件多么好的事啊？</VALUE>
    <VALUE Lang="cn">请接收我的祝福并在规定的时间内筹集三叶草</VALUE>
    <VALUE Lang="cn">我会把幸福转换成幸运.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_2_1">
    <VALUE Lang="cn">好!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_3_0">
    <VALUE Lang="cn">对了~ 这个祝福有效时间是1小时30分！</VALUE>
    <VALUE Lang="cn">希望能够留意这一点！</VALUE>
    <VALUE Lang="cn">祝你愉快~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_0">
    <VALUE Lang="cn">咕咕咕咕~！ 这里是哪里？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_0_1">
    <VALUE Lang="cn">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_1">
    <VALUE Lang="cn">圣诞老爷爷好像把我忘在这里了…….</VALUE>
    <VALUE Lang="cn">拜托找出圣诞老爷爷的痕迹,把我送回圣诞老爷爷身边！</VALUE>
    <VALUE Lang="cn">走之前请接收我的礼物~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_1_1">
    <VALUE Lang="cn">接收礼物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_1_2">
    <VALUE Lang="cn">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_2_0">
    <VALUE Lang="cn">明天还要来呦!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_2_0_1">
    <VALUE Lang="cn">返回首页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc1.ntk_1_0">
    <VALUE Lang="cn">快点来啊！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc1.ntk_1_0_1">
    <VALUE Lang="cn">我从道具商城里偷来了道具! 快点过来购买~！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc2.ntk_1_0">
    <VALUE Lang="cn">在找什么？我这里有材料道具请帮我兑换成游戏币吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc2.ntk_1_0_1">
    <VALUE Lang="cn">상점</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc3.ntk_1_0">
    <VALUE Lang="cn">我在道具城偷走服饰道具！买一个？ 给我游戏币我便把服饰给你！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc3.ntk_1_0_1">
    <VALUE Lang="cn">상점</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_0">
    <VALUE Lang="cn">啊… 怎么办啊 ……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_0_1">
    <VALUE Lang="cn">打开商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_1">
    <VALUE Lang="cn">喜欢我？ 不喜欢我？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_1_1">
    <VALUE Lang="cn">发生什么事情了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_1_2">
    <VALUE Lang="cn">打开商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_2_0">
    <VALUE Lang="cn">啊~ 你来的太是时候了！</VALUE>
    <VALUE Lang="cn">我有喜欢的人了, 不知道她是不是也喜欢我…..</VALUE>
    <VALUE Lang="cn">你可不可以代替我去确认一下她的想法？</VALUE>
    <VALUE Lang="cn">我一看到她就发抖,紧张的一句话也说不出来</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_2_0_1">
    <VALUE Lang="cn">那算不上什么~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_3_0">
    <VALUE Lang="cn">谢谢！ 对了!还有一个事也要拜托你</VALUE>
    <VALUE Lang="cn">怪兽把我给她的巧克力抢走了! 如果你能帮我这两个忙 我一定报答你!</VALUE>
    <VALUE Lang="cn">那么就等你的好消息喽~</VALUE>
    <VALUE Lang="cn">拜托啦！~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_1_0">
    <VALUE Lang="cn">你好~ 你是哪里不舒服么？ 等一下…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_1_1">
    <VALUE Lang="cn">你好~ 找我有什么事情么？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_1_1_1">
    <VALUE Lang="cn">说明</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_2_0">
    <VALUE Lang="cn">啊 ,想起来了！</VALUE>
    <VALUE Lang="cn">前段时间 他受了点伤 我帮他治疗过</VALUE>
    <VALUE Lang="cn">但是 他想知道我对他的想法？</VALUE>
    <VALUE Lang="cn">恩……. 那么你能帮我转达一下 我也对他有好感？</VALUE>
    <VALUE Lang="cn">还有 你告诉他 说我希望他能够直接来和我告白！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_2_0_1">
    <VALUE Lang="cn">知道了！我帮你传达！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_3_0">
    <VALUE Lang="cn">谢谢! 那么我们下次再见~  你也会很快的遇到你的另一半~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_3_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="costumesell_kr.ntk_1_0">
    <VALUE Lang="cn">嗨！对我的服饰风格有兴趣吗？想变得像我一样吗？我这里有很多你可能会感兴趣的东西，想不想看一看？这些衣服很适合你-看一下吧 哈哈哈！ - 在服饰上也能注入属性哦. 赶快进行购买吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="costumesell_kr.ntk_1_0_1">
    <VALUE Lang="cn">상점열기</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="event_npc_0806.ntk_1_0">
    <VALUE Lang="cn">你好...</VALUE>
    <VALUE Lang="cn">手推车开张~</VALUE>
    <VALUE Lang="cn">现在只有某些物品可选择，未来将更新其他品项〜</VALUE>
    <VALUE Lang="cn">请不要说价格昂贵，我拥有的东西不多〜</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="event_npc_0806.ntk_1_0_1">
    <VALUE Lang="cn">商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="kr_exchange_weapon.ntk_1_0">
    <VALUE Lang="cn">如果你有武器交换卷… 以后我们还会在见面的. 请好好参观.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="kr_exchange_weapon.ntk_1_0_1">
    <VALUE Lang="cn">打开商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0">
    <VALUE Lang="cn">嗯….这似乎有点不好……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_1">
    <VALUE Lang="cn">询问他是谁？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_10">
    <VALUE Lang="cn">转交机器零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_11">
    <VALUE Lang="cn">击败 Mutant Guard Dog (Elite)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_2">
    <VALUE Lang="cn">生还者搜救兵</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_3">
    <VALUE Lang="cn">报告生还者的搜救情况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_4">
    <VALUE Lang="cn">搜集 Hydropower Facility 的情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_5">
    <VALUE Lang="cn">搜集 Nuclear Power Facility 的情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_6">
    <VALUE Lang="cn">搜集 Solar Power Facility 的情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_7">
    <VALUE Lang="cn">搜集 Thermal Power Facility 的情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_8">
    <VALUE Lang="cn">搜集 Wind Power Facility 的情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_1_0_9">
    <VALUE Lang="cn">实用的 Guard Robot</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_10_0">
    <VALUE Lang="cn">当我在做管理员时，有一个以最新科技研发出的Guard Robot 。它们是100%纯正的机器人，所以不受人类控制。但我很惊讶的是，由于病毒的感染，它们竟然突变为半人半机器。我为了与Power Researcher P一起进入 Power plant，正努力制作一项简单的机器，但我们缺少了一项零件。此项零件可在Guard Robot身上找到。请帮我们打倒 Guard Robot，并给我们这些零件好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_10_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_adminps.ntk_11_0">
