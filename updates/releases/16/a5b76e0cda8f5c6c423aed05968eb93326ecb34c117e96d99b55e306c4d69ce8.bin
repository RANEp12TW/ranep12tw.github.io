  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_35_0">
    <VALUE Lang="cn">位在Head.B U-ground的Seung Hee Yoon希望您能够获得新力量。请去拜访他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_35_0_1">
