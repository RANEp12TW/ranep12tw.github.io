  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_69_0_9">
    <VALUE Lang="cn">兑换 Destructive Arrow物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_7_0">
    <VALUE Lang="cn">신입생처럼 굴기는...</VALUE>
