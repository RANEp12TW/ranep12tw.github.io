  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0">
    <VALUE Lang="cn">街道为何会变成这幅模样？</VALUE>
    <VALUE Lang="cn">我算幸运的了，至少可以躲到这里。</VALUE>
    <VALUE Lang="cn">稍微一不注意，可能连我也会遭殃的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_1">
    <VALUE Lang="cn">您指的是谁？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_10">
    <VALUE Lang="cn">交付 Key</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_11">
    <VALUE Lang="cn">领取 Golf Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_12">
    <VALUE Lang="cn">交付 Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_13">
    <VALUE Lang="cn">询问一切都还好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_14">
    <VALUE Lang="cn">交付 Golf Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_15">
    <VALUE Lang="cn">询问关于问题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_16">
    <VALUE Lang="cn">找出结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_17">
    <VALUE Lang="cn">询问垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_18">
    <VALUE Lang="cn">传递Oil</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_19">
    <VALUE Lang="cn">询问关于垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_20">
    <VALUE Lang="cn">询问关于垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_21">
    <VALUE Lang="cn">询问关于垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_4">
    <VALUE Lang="cn">谈到资源回收</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_5">
    <VALUE Lang="cn">询问失踪的孩子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_6">
    <VALUE Lang="cn">寻求指引</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_7">
    <VALUE Lang="cn">自愿收集垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_8">
    <VALUE Lang="cn">交付资源回收垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_1_0_9">
    <VALUE Lang="cn">询问一切都还好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_10_0">
    <VALUE Lang="cn">你认为这个垃圾还需要收集吗？对我们来说，如果所有的垃圾和垃圾都进行分类收集，当然是最好不过了。请帮助我们，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_10_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_11_0">
    <VALUE Lang="cn">我们很高兴地你在这里帮忙。</VALUE>
    <VALUE Lang="cn">有这些怪物，不停地阻扰我们清扫街道。。那些长毛狗拖着奶瓶车的模样真是令人看了毛骨悚然。小心，他们会咬伤你！</VALUE>
    <VALUE Lang="cn">我是认真的。这不是不可能的事情，了解吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_11_0_1">
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_11_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_12_0">
    <VALUE Lang="cn">您真的希望我把它给您吗？</VALUE>
    <VALUE Lang="cn">这边，请收下。牠的身躯很大，请小心安全。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_12_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_13_0">
    <VALUE Lang="cn">哇！看起来你已经解决了怪物狗的问题。</VALUE>
    <VALUE Lang="cn">您是怎么做到的呢？</VALUE>
    <VALUE Lang="cn">非常感谢您的帮助。</VALUE>
    <VALUE Lang="cn">终于！我现在可以开始打扫街道，不必再担心那些猎狗咬我了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_13_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_14_0">
    <VALUE Lang="cn">也许你不会相信，但我真的认为处理这些所有的垃圾是很重要的事情。我的意思是，它的确是一种污染物，但还有更多安脏东西存在。我无法一个人胜任，请大家帮忙我一起收集垃圾。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_14_0_1">
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_14_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_15_0">
    <VALUE Lang="cn">有人说，他们看到它带走了一群奇怪的人叫Wrestler。 虽然我不知道他们是否还拿着垃圾，但还是需要您的帮助来了找一下。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_15_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_16_0">
    <VALUE Lang="cn">哇！天啊！！您找到了！</VALUE>
    <VALUE Lang="cn">嗯... 如果我拿这个去研究所对他们进行分析，应该归很不错。我怀疑，我们不会从中得到益处，但…就是有种不是好事的感觉。</VALUE>
    <VALUE Lang="cn">噢~对不起！我只是在自言自语。不要理我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_16_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_17_0">
    <VALUE Lang="cn">我只是想清扫Golf Course。突然间，我发现自己被携带黄金俱乐部的这些女孩追打了起来。</VALUE>
    <VALUE Lang="cn">我甚至无法完成打扫，因为这些疯子在这里追了我一整天。如果没人打扫的话，你不会认为世界会变得很脏吗？</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_17_0_1">
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_17_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_18_0">
    <VALUE Lang="cn">哦！拜托...</VALUE>
    <VALUE Lang="cn">看到这些球杆瞄准了我，还真是起了鸡皮疙瘩！ 此外，那些携带炸弹的小怪！当心他们！</VALUE>
    <VALUE Lang="cn">那些怪物体型超大的！请小心！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_18_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_19_0">
    <VALUE Lang="cn">黄金俱乐部！我已经看过这些人了，但我不是很熟悉这一地带。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_19_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_2_0">
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_20_0">
    <VALUE Lang="cn">当地人的生活区域是非常有限的。可恶的流氓制造混乱，使的住在这里的人都深感不安。</VALUE>
    <VALUE Lang="cn">这些人甚至害的某些学生滞留，无法顺利离开！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_20_0_1">
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_20_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_21_0">
    <VALUE Lang="cn">虽然流氓数量不算太多，但还是请您尽量捉住20名！ 我相信您的实力足够强大，把他们赶走！尽全力消灭他们。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_21_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_22_0">
    <VALUE Lang="cn">我们真的很感谢您在这儿的帮忙。</VALUE>
    <VALUE Lang="cn">像你这样的学生，在经历混乱后，是应该要被关心的。</VALUE>
    <VALUE Lang="cn">我们都认为这种奇怪的现象，是必须要尽快解决的议题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_22_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_23_0">
    <VALUE Lang="cn">.....4</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_24_0">
    <VALUE Lang="cn">连物资都不够，到处都乱七八糟，再募集不到的话，往后就会更惨了。</VALUE>
    <VALUE Lang="cn">其他的先别管，请先帮我收集好空瓶，不管怎样，我们一定要保管好药品！</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_24_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_25_0">
    <VALUE Lang="cn">.....6</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_26_0">
    <VALUE Lang="cn">该不会是哪里出了大事了吧？</VALUE>
    <VALUE Lang="cn">也许他在哪里偷偷做了改造手术，结果变成了半机械人了吧？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_26_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_27_0">
    <VALUE Lang="cn">.....7</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_28_0">
    <VALUE Lang="cn">...11</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_28_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_29_0">
    <VALUE Lang="cn">重点是他们不停地在街道上丢弃“不可回收的垃圾”。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_29_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_3_0">
    <VALUE Lang="cn">您还不明白吗？当我在清扫街道时，就发生了这些事情了。喷血的怪物真是把我吓破了胆呢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_3_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_30_0">
    <VALUE Lang="cn">....8</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_31_0">
    <VALUE Lang="cn">垃圾的内容没必要看了，对吧？</VALUE>
    <VALUE Lang="cn">请尽快拿过去。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_31_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_32_0">
    <VALUE Lang="cn">.....9</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_33_0">
    <VALUE Lang="cn">噢~是的。</VALUE>
    <VALUE Lang="cn">如果是这样的话，请到Financial Group Research Institute！</VALUE>
    <VALUE Lang="cn">哦，等一下......不！这是在另一个地方。</VALUE>
    <VALUE Lang="cn">抱歉，请到Recycling Research Center，它应该会在那里。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_33_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_34_0">
    <VALUE Lang="cn">哈哈~这不是什么值得费心的事情。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_34_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_35_0">
    <VALUE Lang="cn">...10</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_36_0">
    <VALUE Lang="cn">嗯？您不用先确认看看垃圾的内容吗？</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_36_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_37_0">
    <VALUE Lang="cn">...11</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_38_0">
    <VALUE Lang="cn">我想清扫高尔夫球场，但一只巨大的狗抢走了我的钥匙。那是我的打扫工具箱的钥匙。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_38_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_39_0">
    <VALUE Lang="cn">...14</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_4_0">
    <VALUE Lang="cn">예전에는 그래도 매일 청소를 했으니까 재활용품 수집도 그럭저럭 됐는데</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">요즘 같아서는 청소가 문제가 아니라 도망다니기도 바쁘네 원...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_4_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_40_0">
    <VALUE Lang="cn">嗯……我该怎么说呢？某人把不该扔的东西乱丢在路上了。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_40_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_41_0">
    <VALUE Lang="cn">...15</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_42_0">
    <VALUE Lang="cn">可以请您去检查垃圾中的内容吗？如果已经找到了我要的东西，就请马上把它带回来给我。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_42_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_43_0">
    <VALUE Lang="cn">....19</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_44_0">
    <VALUE Lang="cn">让我来处理这个问题。</VALUE>
    <VALUE Lang="cn">我真的很抱歉一直打扰你。</VALUE>
    <VALUE Lang="cn">这应该是我打扫完之后再拿给您的东西。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_44_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_45_0">
    <VALUE Lang="cn">看起来没什么大碍。看起来垃圾已经妥善地分类好了。您帮了我很大的忙，我不知道这份谢礼够不够表达我的谢意，但…可以请您收下我的这份心意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_45_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_46_0">
    <VALUE Lang="cn">这是我在清扫中无意听到的话。听说不久前，有陌生的"Green" 组织]不良分子在骚扰民众。</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_46_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_47_0">
    <VALUE Lang="cn">没多久我也瞥见了那杀气腾腾的模样，听说学生们是被推挤结果窒息而死的。实在是太可怕了！为什么没人早一步伸出援手呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_47_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_48_0">
    <VALUE Lang="cn">....22</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_49_0">
    <VALUE Lang="cn">这里的警察数量不多，我们需要动员更多的人来侦察整个区域。听说暴力的“绿色”组织正躲在附近码头仓库里面。它位在Trading Hole No. 1 Passage。你有他们任何的情报吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_49_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_5_0">
    <VALUE Lang="cn">수고했어 학생</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">물자는 아껴 써야 하니까 앞으로도 시간이 되면 또 부탁해요</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">그냥 모아오면 다른 걸로 바꿔줄테니까</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_5_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_50_0">
    <VALUE Lang="cn">如果学生们走失了，我们该怎么办？</VALUE>
    <VALUE Lang="cn">......啊，是啊！这也是扫地扫到一般捡到的。对不起，又要麻烦你了......您要拿去吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_50_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_51_0">
    <VALUE Lang="cn">虽然我不记得什么时候开始的，大量的箱子到处流窜。我之前也有遇过这种事情，随便一晃，就知道一定是研磨剂之类的。</VALUE>
    <VALUE Lang="cn">问题是，这个箱子很难打开，如果有润滑油是最好。 我真的不知道箱内有什么，不过，最近油类真的太难求了。我想我应该打不开这箱子。也许，您可以试试看哟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_51_0_1">
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_51_0_2">
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_52_0">
    <VALUE Lang="cn">鲔鱼油是最合适的，在这地区，你可以很容易地找到它唷。 在Wharf里有许多工人在鲔鱼渔船工作。但您要知道，你不能使用随便一种的鲔鱼油，有些鲔鱼油的质量并不是很好。所以，可以请您收集高品质的鲔鱼油10瓶过来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_52_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_53_0">
    <VALUE Lang="cn">哎呀！辛苦了！箱子在这里，试着打开看看吧。祝您好运。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_53_0_1">
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_6_0">
    <VALUE Lang="cn">让我想想，您是说那个吵闹的小孩吗？有一阵子没看到他了。难不成他被诱拐了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_6_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_7_0">
    <VALUE Lang="cn">可以请您把那垃圾交给我吗？您应该是可以一边清扫，一遍收集可回收的垃圾的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_7_0_1">
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_7_0_2">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_8_0">
    <VALUE Lang="cn">滑着直排轮到处跑的女疯子和拿着螺丝起子跑跳的女孩子，是乱丢垃圾的主犯。只要扫除那群肇事者，街道就会变干净了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_8_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_9_0">
    <VALUE Lang="cn">果然拿不出我所料。收集垃圾应该对您不难，请把它交给我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_9_0_1">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
