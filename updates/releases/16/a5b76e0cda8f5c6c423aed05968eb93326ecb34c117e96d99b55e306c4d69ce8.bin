  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_3"><VALUE Lang="tw">兌換 終極．毒煙（217級／終極部）</VALUE><VALUE Lang="GS">Skill book: Poison Smoke (Lv217, Class=48, Item=179/22)</VALUE><VALUE Lang="id">Skill book: Poison Smoke (Lv217, Class=48, Item=179/22)</VALUE><VALUE Lang="cn">Skill book: Poison Smoke (Lv217, Class=48, Item=179/22)</VALUE><VALUE Lang="th">Skill book: Poison Smoke (Lv217, Class=48, Item=179/22)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_4"><VALUE Lang="tw">兌換 終極．不朽重擊（77級／終極部）</VALUE><VALUE Lang="GS">Skill book: Immortal Blow (Lv77, Class=48, Item=179/36)</VALUE><VALUE Lang="id">Skill book: Immortal Blow (Lv77, Class=48, Item=179/36)</VALUE><VALUE Lang="cn">Skill book: Immortal Blow (Lv77, Class=48, Item=179/36)</VALUE><VALUE Lang="th">Skill book: Immortal Blow (Lv77, Class=48, Item=179/36)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_5"><VALUE Lang="tw">兌換 終極．踏擊連環（217級／終極部）</VALUE><VALUE Lang="GS">Skill book: Stomp Chain Attack (Lv217, Class=48, Item=179/50)</VALUE><VALUE Lang="id">Skill book: Stomp Chain Attack (Lv217, Class=48, Item=179/50)</VALUE><VALUE Lang="cn">Skill book: Stomp Chain Attack (Lv217, Class=48, Item=179/50)</VALUE><VALUE Lang="th">Skill book: Stomp Chain Attack (Lv217, Class=48, Item=179/50)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_6"><VALUE Lang="tw">兌換 終極．召靈（77級／終極部）</VALUE><VALUE Lang="GS">Skill book: Evocation (Lv77, Class=48, Item=179/64)</VALUE><VALUE Lang="id">Skill book: Evocation (Lv77, Class=48, Item=179/64)</VALUE><VALUE Lang="cn">Skill book: Evocation (Lv77, Class=48, Item=179/64)</VALUE><VALUE Lang="th">Skill book: Evocation (Lv77, Class=48, Item=179/64)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_7"><VALUE Lang="tw">兌換 終極．爆裂衝擊（217級／終極部）</VALUE><VALUE Lang="GS">Skill book: Explosive Blast (Lv217, Class=48, Item=179/78)</VALUE><VALUE Lang="id">Skill book: Explosive Blast (Lv217, Class=48, Item=179/78)</VALUE><VALUE Lang="cn">Skill book: Explosive Blast (Lv217, Class=48, Item=179/78)</VALUE><VALUE Lang="th">Skill book: Explosive Blast (Lv217, Class=48, Item=179/78)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_8"><VALUE Lang="tw">兌換 終極．戰吼（117級／終極部）</VALUE><VALUE Lang="GS">Skill book: War Cry (Lv117, Class=48, Item=179/96)</VALUE><VALUE Lang="id">Skill book: War Cry (Lv117, Class=48, Item=179/96)</VALUE><VALUE Lang="cn">Skill book: War Cry (Lv117, Class=48, Item=179/96)</VALUE><VALUE Lang="th">Skill book: War Cry (Lv117, Class=48, Item=179/96)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_9_0_9"><VALUE Lang="tw">兌換 終極．致命堡壘（127級／終極部）</VALUE><VALUE Lang="GS">Skill book: Fatal Fort (Lv127, Class=48, Item=179/97)</VALUE><VALUE Lang="id">Skill book: Fatal Fort (Lv127, Class=48, Item=179/97)</VALUE><VALUE Lang="cn">Skill book: Fatal Fort (Lv127, Class=48, Item=179/97)</VALUE><VALUE Lang="th">Skill book: Fatal Fort (Lv127, Class=48, Item=179/97)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_0">
    <VALUE Lang="cn">你好！我是Sia，现任忍术部会长。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_0_1">
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1">
    <VALUE Lang="cn">Assassin Instructor在学院本馆。你需要帮忙时，也可以问问我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_1">
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_10">
    <VALUE Lang="cn">修炼</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_11">
    <VALUE Lang="cn">自愿加入Leonine Campus的调查工作</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_12">
    <VALUE Lang="cn">有什么不对劲的吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_2">
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_3">
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_4">
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_5">
    <VALUE Lang="cn">传达 Dispatched agent的信息</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_6">
    <VALUE Lang="cn">回报修炼结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_7">
    <VALUE Lang="cn">回报修炼结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_8">
    <VALUE Lang="cn">交出资料册</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1_9">
    <VALUE Lang="cn">修炼</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_10_0">
    <VALUE Lang="cn">最近商洞附近出现扰民的帮派分子Skating Boy。请帮忙消灭他们。去吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_10_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_11_0">
    <VALUE Lang="cn">您的实力比以前好太多了。不过攻击上的坏习惯以及不够熟练的动作都应该注意一下。只要继续修炼，我想是没问题的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_11_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_12_0">
    <VALUE Lang="cn">看来您对Leonine Campus发生的事情很感兴趣。以您现在的实力，协助调查异变事件应该是没有问题的。不过负责调查案件的Dispatched Agent似乎不是很信任您。</VALUE>
    <VALUE Lang="cn">先这样吧！您先消灭Leonine Campus里的突变植物Poison Ivy ，并搜集牠们的藤蔓，让Dispatched Agent瞧瞧您的真金不怕火实力。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_12_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_13_0">
    <VALUE Lang="cn">有一本记录异变事件前各种意象的手册。原本怕被偷走，每天小心翼翼地保管，但最后还是被一群捣蛋鬼给偷走了。不过因为忍术部老师交待我更重要的事情，所以我一时走不开。可以请您帮我找回来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_13_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_2_0">
    <VALUE Lang="cn">忍术部对于18年前的流星雨事件已略有所闻。理事长似乎开始在关注异世界与现实世界两边的变化了。这两边世界的战斗中所引起的异象，即将给我们带来前所未有的可怕灾难。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_2_0_1">
    <VALUE Lang="cn">继续听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_3_0">
    <VALUE Lang="cn">整个事件就像流行雨引起的一样。因为不正常的东西是不可能穿越来到现实世界的。正因为如此，异世界的生命体才会变成寄生体。我们这些人的名字已经被记录在意见书里面了。所以我们一定可以平安度过这次的异变。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_3_0_1">
    <VALUE Lang="cn">继续听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_4_0">
    <VALUE Lang="cn">我猜这可能是要在发生异变时，为了方便我们聚在一起而作的准备。看来大家奋斗都是为了活下去。成人的世界也不就是这样子嘛~~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_4_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_5_0">
    <VALUE Lang="cn">我很想要让您去支援Leonine Campus的调查工作，但您的实力还不够，所以先继续接受训练，会比较好。别担心！我保证让您好好接受训练，以后一定可以胜任调查工作的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_5_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_6_0">
    <VALUE Lang="cn">这次的试炼感觉如何呢？看您平安归来，想必您的实力已经到了不错的水准。真为您感到骄傲。不过，别高兴得太早唷。这只是开胃菜，后面还有更刺激的呢！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_6_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_7_0">
    <VALUE Lang="cn">这次的任务对您来说似乎难度太高了。不过看您平安归来，我也放心了不少。记得下次不要太逞强，否则还会像这次一样，受重伤差点儿回不来呢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_7_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_8_0">
    <VALUE Lang="cn">您从Freezing Clown找到我的笔记本了吗？真的很谢谢您。当初千辛万苦找到的资料被偷走时，还对您迁怒大小声….真抱歉。这次真是多亏了您的帮忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_8_0_1">
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_9_0">
    <VALUE Lang="cn">迅速压制敌人的攻击是我们忍术部保命的动作。请记得要尽可能地让攻击动作更敏捷。不要光说不练，您一定要实际进行训练之后，才能真正发现自己的缺点。一粒米养百样人，您要想办法突破瓶颈，超越别人。快去接受能加强攻击的实际训练法吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_9_0_1">
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nurse_sport.ntk_1_0">
    <VALUE Lang="cn">噢！我的天啊！为何有那么多的人受伤呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_nurse_sport.ntk_1_0_1">
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_obinain.ntk_1_0">
    <VALUE Lang="cn">你们竟然能击退Tagger Choi博士， 真的很厉害！</VALUE>
    <VALUE Lang="cn">可惜的是没能给他致命一击~</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">嗯。。我所担心的事还是发生了。</VALUE>
    <VALUE Lang="cn">如果我没有猜错的话, Tagger Choi博士征服异界结束后目前正在吸收能量石以恢复自身的力量.</VALUE>
    <VALUE Lang="cn">他回到现世应该就是为了寻找剩余的能量石.</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">Tagger Choi博士通过吸收能量石, 马上就可以恢复这次所受到的伤害，在不久的将来会再次出现在我们的面前.</VALUE>
    <VALUE Lang="cn">快点回学院做好准备吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_obinain.ntk_1_0_1">
    <VALUE Lang="cn">出售物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_obinain.ntk_1_0_2">
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_obinain.ntk_2_0">
    <VALUE Lang="cn">该研究所需的材料为“Faint Dimension Trace”, 你们可以在击退Tagger博士的过程中获得此物品.</VALUE>
    <VALUE Lang="cn">搜集 "Faint Dimension Trace" 以后可以兑换各种物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olditemexch.ntk_1_0">
    <VALUE Lang="cn">你好~ 快来~</VALUE>
    <VALUE Lang="cn">我是以前用制作道具兑换新用户道具的管理员。</VALUE>
    <VALUE Lang="cn">需要兑换的话随时可以使用.</VALUE>
    <VALUE Lang="cn">另外 还有一个新项目是相关说明, 销售制作掉落所有新道具的附加效果(绿色)和随机属性(天蓝色)可以随便使用~ 如果不称心的话使用附加效果(绿色)和改造卡(天蓝色)可以变更并进行使用.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olditemexch.ntk_1_0_1">
    <VALUE Lang="cn">물품매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_oldskillbook.ntk_1_0">
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_oldskillbook.ntk_1_0_1">
    <VALUE Lang="cn">Item Trade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_0">
    <VALUE Lang="cn">올림픽 주화를 모두 모아 오셨네요.</VALUE>
    <VALUE Lang="cn">모아오신 올림픽 주화를 모두 드리지는 못하고...</VALUE>
    <VALUE Lang="cn">기념하는 의미로 한개만 드릴께요</VALUE>
    <VALUE Lang="cn">하지만 이 주화는 18일이 지나면 사라지는 거라서 기념용이라고 하기에는 좀...</VALUE>
    <VALUE Lang="cn">한국이 획득할 거라고 예상되는 총 메달수가 적힌 티켓으로 바꾸셔서 보관하시는 게 좋을거예요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_0_1">
    <VALUE Lang="cn">올림픽 주화를 전달한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1">
    <VALUE Lang="cn">한국이 최종적으로 획득할 거라고 예상되는 메달의 수를 선택하세요</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">제 1군 : 20 ~ 25</VALUE>
    <VALUE Lang="cn">제 2군 : 26 ~ 30</VALUE>
    <VALUE Lang="cn">제 3군 : 31 ~ 35</VALUE>
    <VALUE Lang="cn">제 4군 : 35 ~ 40</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1_1">
    <VALUE Lang="cn">제 1군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1_2">
    <VALUE Lang="cn">제 2군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1_3">
    <VALUE Lang="cn">제 3군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_1_4">
    <VALUE Lang="cn">제 4군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_2">
    <VALUE Lang="cn">올림픽이 끝나고 총 메달수 획득수가 확인된 후에 가지고 계신 티켓의 숫자와 메달수가 일치한다면 메달수 X 10000 의 금액으로 환전하실 수 있게 될 거예요</VALUE>
    <VALUE Lang="cn">음... 아마 9월 1일부터 환전이 가능해질 것 같군요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_3">
    <VALUE Lang="cn">지금 아테네 올림픽이 개최되고 있다는 건 아시죠?</VALUE>
    <VALUE Lang="cn">교통망이 정상이 아니라서 직접 가 볼수는 없지만 멀리서나마 응원할 수 있도록 하는 이벤트를 만들었어요</VALUE>
    <VALUE Lang="cn">과연 최종적으로 한국이 획득하는 총 메달의 수는 몇개나 될까요?</VALUE>
    <VALUE Lang="cn">잘 맞추시면 큰 행운도 따라올거예요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_1_3_1">
    <VALUE Lang="cn">올림픽 주화를 입수한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_2_0">
    <VALUE Lang="cn">한국이 최종적으로 획득할 거라고 예상되는 총 메달 수를 고르세요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_2_0_1">
    <VALUE Lang="cn">한국이 최종적으로 획득할 거라고 예상되는 총 메달 수를 고르세요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_olympic.ntk_2_0_2">
    <VALUE Lang="cn">한국이 최종적으로 획득할 거라고 예상되는 총 메달 수를 고르세요</VALUE>
