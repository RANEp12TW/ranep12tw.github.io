  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_4_0">
    <VALUE Lang="cn">真是谢谢!!</VALUE>
    <VALUE Lang="cn">不能只用言语感谢</VALUE>
    <VALUE Lang="cn">请等我一下</VALUE>
    <VALUE Lang="cn">等下热腾腾的热狗</VALUE>
    <VALUE Lang="cn">来!请吃</VALUE>
    <VALUE Lang="cn">真是太感谢了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_4_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_5_0">
    <VALUE Lang="cn">嗯 是呀</VALUE>
    <VALUE Lang="cn">总是要我去买热狗回来的孩子不知何时不见了</VALUE>
    <VALUE Lang="cn">实在是不清楚</VALUE>
    <VALUE Lang="cn">几个聚在一起要去附近的山上看喜欢的东西那是最后一次的样子</VALUE>
