    <VALUE Lang="cn">50,000 kill</VALUE>
    <VALUE Lang="cn">-&gt; Costume (7D) or Taxi card (10P)</VALUE>
    <VALUE Lang="cn">80,000 kill</VALUE>
    <VALUE Lang="cn">-&gt; Costume (15D) or Gold beret (15D) or Ring costu</VALUE>
  </SENTENSE>
