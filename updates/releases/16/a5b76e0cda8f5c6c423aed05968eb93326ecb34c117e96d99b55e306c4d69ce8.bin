    <VALUE Lang="cn">......28</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_94_0">
    <VALUE Lang="cn">考虑到你目前的水平，现在，就没有必要读取文档的其余部分。 把Suggestion book拿过来就好。</VALUE>
  </SENTENSE>
