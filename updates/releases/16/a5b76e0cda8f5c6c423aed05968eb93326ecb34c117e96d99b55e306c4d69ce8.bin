    <VALUE Lang="cn">'마루치기서' 를 변환한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_t_master1.ntk_1_6">
    <VALUE Lang="cn">‘아라치 기서’ 라...</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
    <VALUE Lang="cn">용케도 그런 걸 찾아냈구나</VALUE>
    <VALUE Lang="cn">Skip</VALUE>
