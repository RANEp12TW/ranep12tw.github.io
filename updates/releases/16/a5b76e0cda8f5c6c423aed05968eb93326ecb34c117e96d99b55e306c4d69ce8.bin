  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_maingate1.ntk_1_0_3">
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_maingate1.ntk_2_0">
    <VALUE Lang="cn">技能测试系统已启动！</VALUE>
    <VALUE Lang="cn">该系统的主要目的是为了保护学生，也是一项便利措施，以确保学生的能力有超过一定的水平。 学生们！祝好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_maingate1.ntk_2_0_1">
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_maingate1.ntk_3_0">
    <VALUE Lang="cn">终端机的结界机能正常运转中.</VALUE>
    <VALUE Lang="cn">但没有方法能进出学院的Main Gate，除非有得到认可.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_maingate1.ntk_3_0_1">
