  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_31_0">
    <VALUE Lang="cn">角色达到某特定级数，已成功获取灵珠。现在可用灵珠来学习新技能唷。</VALUE>
  </SENTENSE>
