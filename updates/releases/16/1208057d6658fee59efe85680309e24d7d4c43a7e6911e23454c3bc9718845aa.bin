        <VALUE Lang="tw">去見在聖德門研究院的卡拉賽諾</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_773_000_P_1">
        <VALUE Lang="tw">去找黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_773_000_D_1">
        <VALUE Lang="tw">去見黎斯傳達卡拉賽諾的話</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_774_000">
        <VALUE Lang="tw">[組隊] 勇士的心臟</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_774_000">
        <VALUE Lang="tw">為了控制受到火靈艾巴努(魯西安)的影響漸漸變得不穩定的關鍵，需要紫晶的眼淚，請從研究基地地下的墮落熾天使和重力生化人中蒐集108個紫晶的眼淚後，交給黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_774_000_P_0">
        <VALUE Lang="tw">蒐集紫晶的眼淚</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_774_000_D_0">
        <VALUE Lang="tw">從墮落熾天使和重力生化人中蒐集108個紫晶的眼淚</VALUE>
    </SENTENSE>
