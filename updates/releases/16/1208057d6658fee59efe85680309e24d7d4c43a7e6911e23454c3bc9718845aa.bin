    <SENTENSE Ver="1" Id="QN_532_000">
        <VALUE Lang="tw">成熙燕的委託</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_532_000">
        <VALUE Lang="tw">受到在B1成熙燕的請求, 把姐姐的話轉告給在聖財團1F的成熙知. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_532_000_P_0">
        <VALUE Lang="tw">請去見成熙知. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_532_000_D_0">
        <VALUE Lang="tw">請去見成熙知傳達訊息. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_532_000_P_1">
        <VALUE Lang="tw">去見成熙燕</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_532_000_D_1">
        <VALUE Lang="tw">把成熙知的訊息傳達給成熙燕. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_533_000">
        <VALUE Lang="tw">完成八怪星</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_533_000">
        <VALUE Lang="tw">有關新生的秘密, 好像只有親自去見理事長確認才有辦法,現在為了加快八怪星的組合, 請去找影像專家. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_533_000_P_0">
        <VALUE Lang="tw">請去見影像專家. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_533_000_D_0">
        <VALUE Lang="tw">去找影像專家, 拜託他幫忙組合八怪星. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_533_000_P_1">
        <VALUE Lang="tw">在監獄中尋找礦物. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_533_000_D_1">
        <VALUE Lang="tw">為了製作組合八怪星所需要的黏著劑, 接到去監獄實驗場找一種礦石的請求. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_533_000_P_2">
        <VALUE Lang="tw">請去找聖財團前面的老頭. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_533_000_D_2">
        <VALUE Lang="tw">拿著組合完成的八怪星,交給聖財團前面的老頭. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_533_000_P_3">
        <VALUE Lang="tw">請到理事長室.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_533_000_D_3">
        <VALUE Lang="tw">為了再一次的進入理事長室,請到90F去.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_534_000">
        <VALUE Lang="tw">時間停止的地方2</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_534_000">
        <VALUE Lang="tw">為了再一次的進入理事長室,請利用破裂的窗戶進去. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_534_000_P_0">
        <VALUE Lang="tw">請找破裂的窗戶. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_534_000_D_0">
        <VALUE Lang="tw">請去找能到外牆的破裂窗戶. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_534_000_P_1">
        <VALUE Lang="tw">請去找另一個出口. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_534_000_D_1">
        <VALUE Lang="tw">曾經爬過的外牆,無法再使用第二次,請尋找另一個通道. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_534_000_P_2">
        <VALUE Lang="tw">請到理事長室去.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_534_000_D_2">
        <VALUE Lang="tw">請利用另一邊的外牆,移動到有理事長室的最高樓層. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_535_000">
        <VALUE Lang="tw">啟動八怪星</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_535_000">
        <VALUE Lang="tw">調查到現在,發現在理事長室有秘密實驗室,在那裏使用八怪星, 就能移動到異界,請找出隱藏在理事長室的祕密實驗室, 請啟動八怪星. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_535_000_P_0">
        <VALUE Lang="tw">請找出在理事長室裡的實驗室. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_535_000_D_0">
        <VALUE Lang="tw">拿著八怪星進入到隱藏在理事長室的實驗室. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_535_000_P_1">
        <VALUE Lang="tw">準備八怪星. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_535_000_D_1">
        <VALUE Lang="tw">為了啟動八怪星,請塗上從紅衣單槍手身上取回的溶液.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_535_000_P_2">
        <VALUE Lang="tw">啟動八怪星</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_535_000_D_2">
        <VALUE Lang="tw">請把沾有紅衣單槍手血液的八怪星, 拿到通往異界的通道前面去. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_536_000">
        <VALUE Lang="tw">通往異界</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_536_000">
        <VALUE Lang="tw">成功的啟動了 八怪星, 請往異界移動吧. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_536_000_P_0">
        <VALUE Lang="tw">通往異界</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_536_000_D_0">
        <VALUE Lang="tw">請移動到異界去. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_536_000_P_1">
        <VALUE Lang="tw">調查異界</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_536_000_D_1">
        <VALUE Lang="tw">請調查一下異界. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_536_000_P_2">
        <VALUE Lang="tw">請與理事長對話</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_536_000_D_2">
        <VALUE Lang="tw">不小心進入的房間裡,看到有個長得很像理事長的人, 請與他對話. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_537_000">
        <VALUE Lang="tw">理事長的真實,還有結局. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_537_000">
        <VALUE Lang="tw">我很驚訝的聽到那個人 就是真正成立聖財團的崔泰圭理事長. 然後關在隔壁房間的是他最後一個剩下的複製靈魂, 並且受到了將它消滅掉的請求. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_537_000_P_0">
        <VALUE Lang="tw">確認理事長的複製靈魂. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_537_000_D_0">
        <VALUE Lang="tw">由於理事長的請求,仔細確認關在隔壁房間裡面理事長的複製靈魂. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_537_000_P_1">
        <VALUE Lang="tw">與理事長對話</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_537_000_D_1">
        <VALUE Lang="tw">請再次的與理事長進行對話.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_538_000">
        <VALUE Lang="tw">調查人工心臟研發室</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_538_000">
        <VALUE Lang="tw">位於地下的人工心臟研發室裡面的心臟, 或許可能不是真正使用人工的方法所製造的, 請查明一下心臟的脈搏數和周圍跳動的情況 .</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_538_000_P_0">
        <VALUE Lang="tw">請檢查一下人工心臟的前面部位. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_538_000_D_0">
        <VALUE Lang="tw">請到地下的人工心臟實驗室,比較一下心臟周圍的跳動及脈搏數. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_538_000_P_1">
        <VALUE Lang="tw">請檢查一下人工心臟的右邊部位. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_538_000_D_1">
        <VALUE Lang="tw">請到地下的人工心臟實驗室,比較一下心臟周圍的跳動及脈搏數. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_538_000_P_2">
        <VALUE Lang="tw">請檢查一下人工心臟的後面部位. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_538_000_D_2">
        <VALUE Lang="tw">請到地下的人工心臟實驗室,比較一下心臟周圍的跳動及脈搏數. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_538_000_P_3">
        <VALUE Lang="tw">請檢查一下人工心臟的左邊部位. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_538_000_D_3">
        <VALUE Lang="tw">請到地下的人工心臟實驗室,比較一下心臟周圍的跳動及脈搏數. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_538_000_P_4">
        <VALUE Lang="tw">請告訴成熙燕 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_538_000_D_4">
        <VALUE Lang="tw">把調查結果告訴成熙燕.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_539_000">
        <VALUE Lang="tw">幫助新生</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_539_000">
        <VALUE Lang="tw">聽說有些學生遺失了申請入學的文件, 因此還沒能夠辦理申請入學的手續, 或許你最近在某處看過, 請幫忙找找看.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_539_000_P_0">
        <VALUE Lang="tw">請找入學申請書.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_539_000_D_0">
        <VALUE Lang="tw">請尋找掉落在教務處的入學申請書. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_539_000_P_1">
