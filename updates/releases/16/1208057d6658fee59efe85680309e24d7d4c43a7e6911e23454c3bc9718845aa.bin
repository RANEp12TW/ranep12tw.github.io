    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2128_000_D_3">
        <VALUE Lang="tw">請打倒在碼頭附近出沒的10隻殘酷光頭猛男</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2128_000_P_4">
        <VALUE Lang="tw">向霸天雲回報結果</VALUE>
    </SENTENSE>
