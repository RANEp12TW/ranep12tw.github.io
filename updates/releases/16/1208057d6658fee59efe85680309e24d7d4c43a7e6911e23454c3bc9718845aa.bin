    <SENTENSE Ver="1" Id="QN_712_000">
        <VALUE Lang="tw">學院服務活動 I</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_712_000">
        <VALUE Lang="tw">據說最近在各學院的正門附近有一群太陽堂-短劍阿迪,正在擾亂學生們.請打倒10隻太陽堂-短劍阿迪後,向生活輔導老師領取特殊卡片吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_712_000_P_0">
        <VALUE Lang="tw">請打倒10隻太陽堂-短劍阿迪</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_712_000_D_0">
        <VALUE Lang="tw">請打倒在各學院附近出沒的10隻太陽堂-短劍阿迪</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_712_000_P_1">
