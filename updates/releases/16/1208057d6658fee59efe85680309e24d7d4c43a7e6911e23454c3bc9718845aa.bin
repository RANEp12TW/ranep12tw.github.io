    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_506_000">
        <VALUE Lang="tw">修復文件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_506_000">
        <VALUE Lang="tw">從成熙知拿到的四種文件紙片當中, 請到1F去找第一種文件的其他剩餘的部份,再將其拼在一起. </VALUE>
