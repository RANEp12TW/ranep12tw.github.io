    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2374_000">
        <VALUE Lang="tw">執著的這些傢伙</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2374_000">
        <VALUE Lang="tw">為了消滅拳部高利貸成員，沒想到她們使用更強的藥物試圖阻止我們。&#x0D;&#x0A;想要試圖分析藥物成分，但是樣本太少了，請再幫忙蒐集一些樣本過來</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2374_000_P_0">
        <VALUE Lang="tw">蒐集藥物樣本</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2374_000_D_0">
        <VALUE Lang="tw">制伏高利貸成員，蒐集並帶回藥物樣本</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2374_000_P_1">
        <VALUE Lang="tw">轉交藥物樣本</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2374_000_D_1">
        <VALUE Lang="tw">將藥物樣本交給超能部 指導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2375_000">
        <VALUE Lang="tw">異變的線索</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2375_000">
        <VALUE Lang="tw">訓練失敗了，但是好像無法忍受對強大異變動物的好奇心。&#x0D;&#x0A;消滅變異動物，蒐集並帶來異變之核</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2375_000_P_0">
        <VALUE Lang="tw">蒐集異變之核</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2375_000_D_0">
        <VALUE Lang="tw">消滅異變的動物，蒐集並帶回異變之核</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2375_000_P_1">
        <VALUE Lang="tw">轉交異變之核</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2375_000_D_1">
        <VALUE Lang="tw">將異變之核交給&apos;魔術動物 訓練師&apos;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2376_000">
        <VALUE Lang="tw">幕後黑手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2376_000">
        <VALUE Lang="tw">為了掌控整條街，她一步一步進行自己的計畫&#x0D;&#x0A;蒐集並帶回蒙面人的武器零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2376_000_P_0">
        <VALUE Lang="tw">蒐集武器零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2376_000_D_0">
        <VALUE Lang="tw">制伏蒙面人，蒐集並帶回武器零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2376_000_P_1">
