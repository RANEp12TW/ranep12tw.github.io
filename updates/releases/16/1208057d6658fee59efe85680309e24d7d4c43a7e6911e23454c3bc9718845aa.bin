    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2122_000_D_1">
        <VALUE Lang="tw">請去找聖門洞的護士，把任務結果告訴她。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2123_000">
