    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_646_000_D_1">
        <VALUE Lang="tw">在玄巖學院資料室中所找到的資料,請交給李大旭. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_647_000">
        <VALUE Lang="tw">請掃除瘋狂教師. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_647_000">
        <VALUE Lang="tw">在虎令學院本館會出現的瘋狂教師,即使身為教師, 卻失去了理性.&#x0D;&#x0A;可使從複製靈的手中獲得解放,像虎令學院的情況而言,可以幫忙的人非常少,  &#x0D;&#x0A;因此李真囑咐行動要格外的小心. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_647_000_P_0">
        <VALUE Lang="tw">請掃除瘋狂教師. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_647_000_D_0">
        <VALUE Lang="tw">請掃除可以在虎令學院本館看到的瘋狂教師.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_647_000_P_1">
        <VALUE Lang="tw">請告訴結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_647_000_D_1">
        <VALUE Lang="tw">請告訴李真安全的完成了任務. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_648_000">
        <VALUE Lang="tw">請收集附屬零件 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_648_000">
        <VALUE Lang="tw">李真知道可以透過特殊的機械來救他的朋友,&#x0D;&#x0A;但卻不告訴崔英錫事實,自己開始偷偷的收集所有能收集到的附屬零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_648_000_P_0">
        <VALUE Lang="tw">請收集附屬零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_648_000_D_0">
        <VALUE Lang="tw">從聖門學院公車司機那裡,收集一些公車零件回來吧.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_648_000_P_1">
        <VALUE Lang="tw">請收集附屬零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_648_000_D_1">
        <VALUE Lang="tw">請撿回聖門洞工地,丟棄在地上的零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_648_000_P_2">
        <VALUE Lang="tw">請傳送零件.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_648_000_D_2">
        <VALUE Lang="tw">先把收集回來的幾個零件交給李真. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_649_000">
        <VALUE Lang="tw">請掃除脫窗可滷.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_649_000">
        <VALUE Lang="tw">&apos;清除在商洞廣場周圍出現的脫窗可滷的課題,曾經在脫窗可滷身上找出過小孩子的衣服,所以非常的危險 ,請多加小心. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_649_000_P_0">
        <VALUE Lang="tw">請掃除脫窗可滷.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_649_000_D_0">
        <VALUE Lang="tw">請掃除出現在商洞周圍的脫窗可滷.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_649_000_P_1">
        <VALUE Lang="tw">請告訴結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_649_000_D_1">
        <VALUE Lang="tw">請告訴李真安全的完成了任務. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_650_000">
        <VALUE Lang="tw">請掃除浩呆</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_650_000">
        <VALUE Lang="tw">&apos;和脫窗可滷一樣,在商洞廣場周圍出沒的浩呆,因為他們拿著很沉重的筆竿,所以不能快速攻擊, 但是就因為他們會拿著筆竿攻擊, 做近距離攻擊的學生們要特別的小心.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_650_000_P_0">
        <VALUE Lang="tw">請掃除浩呆</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_650_000_D_0">
        <VALUE Lang="tw">請掃除出沒在商洞廣場周圍的浩呆 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_650_000_P_1">
        <VALUE Lang="tw">請告訴結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_650_000_D_1">
        <VALUE Lang="tw">請告訴李真安全的完成了任務. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_651_000">
        <VALUE Lang="tw">請掃除烈燄媽媽桑</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_651_000">
        <VALUE Lang="tw">在商洞高爾夫球場發現的烈燄媽媽桑,和過去在市中心出現的媽媽桑比其來, &#x0D;&#x0A;根本是無法相比的超強的目標.雖然怪物的數目非常的少,但卻是不能掉以輕心的敵人,  &#x0D;&#x0A;希望不要有任何的鬆懈.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_651_000_P_0">
        <VALUE Lang="tw">請掃除烈燄媽媽桑</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_651_000_D_0">
        <VALUE Lang="tw">請掃除商洞高爾夫球場周圍出現的烈燄媽媽桑.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_651_000_P_1">
        <VALUE Lang="tw">請告訴結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_651_000_D_1">
        <VALUE Lang="tw">請告訴崔英錫安全的完成了任務.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_652_000">
        <VALUE Lang="tw">虎令學院期中檢定 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_652_000">
        <VALUE Lang="tw">為了想知道學生的能力提昇了多少,崔英錫提出了幾項課題給學生. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_652_000_P_0">
        <VALUE Lang="tw">請掃除鎖鏈官 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_652_000_D_0">
        <VALUE Lang="tw">請掃除在虎令學院3樓出沒的鎖鏈官.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_652_000_P_1">
        <VALUE Lang="tw">請掃除筷子手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_652_000_D_1">
        <VALUE Lang="tw">請掃除出沒在虎令學院地下的筷子手. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_652_000_P_2">
        <VALUE Lang="tw">請告訴結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_652_000_D_2">
        <VALUE Lang="tw">請告訴崔英錫安全的完成了任務.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_653_000">
        <VALUE Lang="tw">請掃除高爾夫正咩</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_653_000">
        <VALUE Lang="tw">只能在商洞高爾夫球場可以看到的高爾夫正咩&#x0D;&#x0A;,他是拿著高爾夫球桿來攻擊的敵人, &#x0D;&#x0A;不管近距離或者長距離都能做攻擊的敵人. 一定要集中精神來進行這個任務.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_653_000_P_0">
        <VALUE Lang="tw">請掃除高爾夫正咩</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_653_000_D_0">
        <VALUE Lang="tw">請掃除出現在商洞高爾夫球場的高爾夫正咩. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_653_000_P_1">
        <VALUE Lang="tw">請告訴結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_653_000_D_1">
        <VALUE Lang="tw">請告訴崔英錫安全的完成了任務.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_654_000">
        <VALUE Lang="tw">請收集附屬零件.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_654_000">
        <VALUE Lang="tw">以前是到市中心去找零件的. &#x0D;&#x0A;現在或許在商洞也會有一些零件,請去收集一些回來.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_654_000_P_0">
        <VALUE Lang="tw">請去見影像專家.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_654_000_D_0">
        <VALUE Lang="tw">請去找影像專家拿一些他不用的&#x0D;&#x0A;零件回來.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_654_000_P_1">
        <VALUE Lang="tw">去拿油瓶回來.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_654_000_D_1">
        <VALUE Lang="tw">不僅是零件,或許連油都可以當作材料也說不定.&#x0D;&#x0A;請在加油站找一些油瓶回來.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_654_000_P_2">
        <VALUE Lang="tw">請送零件和油瓶.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_654_000_D_2">
        <VALUE Lang="tw">把收集到的零件和油瓶,請交給李真. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_655_000">
        <VALUE Lang="tw">請掃除大痘花. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_655_000">
        <VALUE Lang="tw">在虎令學院地下出現的大痘花,他雖然不是人的樣子,但他會使用特別的方法去攻擊學生,請你熟悉攻擊方法,&#x0D;&#x0A;使得能夠進行此項任務.  </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_655_000_P_0">
        <VALUE Lang="tw">請掃除大痘花</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_655_000_D_0">
        <VALUE Lang="tw">請掃除在虎令學院地下出現的大痘花. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_655_000_P_1">
        <VALUE Lang="tw">請去確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_655_000_D_1">
        <VALUE Lang="tw">請去找崔英錫告訴他達成任務了. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_656_000">
        <VALUE Lang="tw">請掃除漁夫. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_656_000">
        <VALUE Lang="tw">在碼頭附近的敵人比其他地區的敵人還要強,&#x0D;&#x0A;這次的任務是掃除碼頭的敵人當中能力最弱的漁夫,&#x0D;&#x0A;雖然在碼頭的怪物當中其力量最弱,但是因為與過去所對付的怪物仍然有所不同, 請多加注意,不可放鬆心情.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_656_000_P_0">
        <VALUE Lang="tw">請掃除漁夫. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_656_000_D_0">
        <VALUE Lang="tw">請掃除碼頭的漁夫.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_656_000_P_1">
        <VALUE Lang="tw">請去確認. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_656_000_D_1">
        <VALUE Lang="tw">請告訴李真安全的達成任務了.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_657_000">
        <VALUE Lang="tw">請尋找零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_657_000">
        <VALUE Lang="tw">因為在碼頭停泊的船隻很多,所以會有很多船隻需要的零件.&#x0D;&#x0A; &#x0D;&#x0A;目前去搜索所有的船隻應該比較困難,希望先去上第一個船隻&#x0D;&#x0A;看看是否有一些掉落的零件.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_657_000_P_0">
        <VALUE Lang="tw">請尋找零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_657_000_D_0">
        <VALUE Lang="tw">請到第一船隻上面找一找是否有掉落的零件.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_657_000_P_1">
        <VALUE Lang="tw">請繼續再找零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_657_000_D_1">
        <VALUE Lang="tw">請再找找看是否還有多餘的零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_657_000_P_2">
        <VALUE Lang="tw">請再找一些零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_657_000_D_2">
        <VALUE Lang="tw">最後再去看一看是否還有其他的零件.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_657_000_P_3">
        <VALUE Lang="tw">請交零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_657_000_D_3">
        <VALUE Lang="tw">請把找到的幾個零件交給李真.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_658_000">
        <VALUE Lang="tw">請掃除殘暴水手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_658_000">
        <VALUE Lang="tw">這次的任務是清除在碼頭的船隻附近可以看到的 &#x0D;&#x0A;殘暴水手. 水手瞬間發出的力量非常強.&#x0D;&#x0A;在對付的過程中,&#x0D;&#x0A;請小心不要受傷了. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_658_000_P_0">
        <VALUE Lang="tw">請掃除殘暴水手. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_658_000_D_0">
        <VALUE Lang="tw">請掃除出現在碼頭船隻附近的殘暴水手. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_658_000_P_1">
        <VALUE Lang="tw">請去確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_658_000_D_1">
        <VALUE Lang="tw">請告訴李真安全的達成任務了.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_659_000">
        <VALUE Lang="tw">請尋找零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_659_000">
        <VALUE Lang="tw">不但是碼頭,在青基地&#x0D;&#x0A;或許會有一些以前青組織人員所收集的一些零件,&#x0D;&#x0A; &#x0D;&#x0A;請去查看一下 &#x0D;&#x0A;是不是真的有零件.(分流1)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_659_000_P_0">
        <VALUE Lang="tw">請到一樓去查看一下.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_659_000_D_0">
        <VALUE Lang="tw">請到青組織1F入口處,查看一下在堆積的箱子之間, &#x0D;&#x0A;是否有一些零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_659_000_P_1">
        <VALUE Lang="tw">請在二樓尋找零件.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_659_000_D_1">
        <VALUE Lang="tw">從青組織2要到3F的樓梯前面, &#x0D;&#x0A;找一下看看是否有零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_659_000_P_2">
        <VALUE Lang="tw">請傳送零件.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_659_000_D_2">
        <VALUE Lang="tw">請把在青組織找到的一些零件, &#x0D;&#x0A;交給李真 .</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_660_000">
        <VALUE Lang="tw">請接受期中檢定. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_660_000">
        <VALUE Lang="tw">在青組織檢定過去所修練的能力, &#x0D;&#x0A;希望不要受傷來完成這項任務. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_660_000_P_0">
        <VALUE Lang="tw">請掃除伊賀流. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_660_000_D_0">
        <VALUE Lang="tw">請掃除攻擊速度非常快的伊賀流. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_660_000_P_1">
        <VALUE Lang="tw">請掃除兔女郎</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_660_000_D_1">
        <VALUE Lang="tw">請掃除密集在中央桌面的兔女郎</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_660_000_P_2">
        <VALUE Lang="tw">請去確認. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_660_000_D_2">
        <VALUE Lang="tw">請去傳達完成了期中檢定的任務. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_661_000">
        <VALUE Lang="tw">要求考試. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_661_000">
        <VALUE Lang="tw">‘ 阿瑪諾儒應’認為自己未完成的工作 , &#x0D;&#x0A;或許學生可以幫他完成, &#x0D;&#x0A;所以他希望測試一下學生們能力的到底有多少? </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_661_000_P_0">
        <VALUE Lang="tw">請掃除機械賊頭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_661_000_D_0">
        <VALUE Lang="tw">請掃除出現在監獄的『『機械賊頭』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_661_000_P_1">
        <VALUE Lang="tw">請掃除典獄部長</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_661_000_D_1">
        <VALUE Lang="tw">請掃除出現在監獄裡的『典獄部長』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_661_000_P_2">
        <VALUE Lang="tw">請掃除模範-巨鎚猛男</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_661_000_D_2">
        <VALUE Lang="tw">請掃除出現在監獄裡的1名『模範-巨鎚猛男』 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_661_000_P_3">
        <VALUE Lang="tw">請去告訴結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_661_000_D_3">
        <VALUE Lang="tw">請向’ 阿瑪諾儒應’報告任務結果 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_662_000">
        <VALUE Lang="tw">傳達消息. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_662_000">
        <VALUE Lang="tw">‘阿瑪諾儒應’在學生的物品當中發現了屬於崔英錫的東西,&#x0D;&#x0A;他雖然不知道原因,在那些東西當中也發現了屬於李真的東西, &#x0D;&#x0A;準備去問李真這到底是怎麼一回事情.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_662_000_P_0">
        <VALUE Lang="tw">請去見李真 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_662_000_D_0">
        <VALUE Lang="tw">請告訴李真有關’阿瑪諾儒應’的存在. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_662_000_P_1">
        <VALUE Lang="tw">請傳遞信件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_662_000_D_1">
        <VALUE Lang="tw">請把李真所寫的有關於崔英錫的事情,以及他想要做的事情, 將此信交給’阿瑪諾儒應</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_663_000">
        <VALUE Lang="tw">傳達意見 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_663_000">
        <VALUE Lang="tw">雖然他不相信崔英錫, 卻相信李真的’阿瑪諾儒應’, &#x0D;&#x0A;他寫了若有幫助的話,自已也會幫忙的信, 準備要送給李真 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_663_000_P_0">
        <VALUE Lang="tw">請傳遞書信. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_663_000_D_0">
        <VALUE Lang="tw">把若自己有所幫助的話,就會全力相助的信件, &#x0D;&#x0A;請交給李真. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_663_000_P_1">
        <VALUE Lang="tw">請傳達感謝之意. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_663_000_D_1">
        <VALUE Lang="tw">讀完信件的李真,至今才表達過去的辛苦 , &#x0D;&#x0A;表達感激之心.請告訴這份心情.  </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_664_000">
        <VALUE Lang="tw">請掃除模範-碎岩人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_664_000">
        <VALUE Lang="tw">現在開始’阿瑪諾儒應’&#x0D;&#x0A;會對修練有所幫助. &#x0D;&#x0A;第一個課題是掃除模範-碎岩人&#x0D;&#x0A;在之前測試當中,李真揣測到其能力有多少,所以他現在認為有充分的能力可以對抗敵人. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_664_000_P_0">
        <VALUE Lang="tw">請掃除模範-碎岩人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_664_000_D_0">
        <VALUE Lang="tw">在監獄出現的『模範-碎岩人』利用岩石進行攻擊。請小心不要受傷。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_664_000_P_1">
        <VALUE Lang="tw">請接受確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_664_000_D_1">
        <VALUE Lang="tw">請告訴’阿瑪諾儒應’安全的完成任務了。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_665_000">
        <VALUE Lang="tw">請掃除派遣的十字鎬工頭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_665_000">
        <VALUE Lang="tw">這次的任務是掃除派遣的十字鎬工頭&#x0D;&#x0A;敵人的力量愈來愈強壯,&#x0D;&#x0A;希望不要像以前學生一樣受傷, 請務必要小心提防. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_665_000_P_0">
        <VALUE Lang="tw">請掃除『派遣的十字鎬工頭』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_665_000_D_0">
        <VALUE Lang="tw">請掃除主要出現在中洞的『派遣的十字鎬工頭』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_665_000_P_1">
        <VALUE Lang="tw">請去接受確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_665_000_D_1">
        <VALUE Lang="tw">請告訴’阿瑪諾儒應’安全的達成了任務的消息 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_666_000">
        <VALUE Lang="tw">請收集零件.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_666_000">
        <VALUE Lang="tw">從中洞燃燒的汽車當中, &#x0D;&#x0A;可以找到一些零件, 請從汽車當中收集一些零件, 希望對李真有所幫助. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_666_000_P_0">
        <VALUE Lang="tw">請去找燃燒的汽車. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_666_000_D_0">
        <VALUE Lang="tw">在入口處依照順序在燃燒的汽車當中,&#x0D;&#x0A;找一些零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_666_000_P_1">
        <VALUE Lang="tw">請多找一些零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_666_000_D_1">
        <VALUE Lang="tw">在入口處依照順序來燃燒的汽車當中,&#x0D;&#x0A;找一些零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_666_000_P_2">
        <VALUE Lang="tw">請傳送零件. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_666_000_D_2">
        <VALUE Lang="tw">從燃燒的汽車當中,所找到的零件收集好之後, &#x0D;&#x0A;請交給李真. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_667_000">
        <VALUE Lang="tw">請掃除光魔導士. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_667_000">
        <VALUE Lang="tw">這次任務是掃除常常出現在本洞的光魔導士,&#x0D;&#x0A;在本洞出現各種魔導士,&#x0D;&#x0A;他們都會利用魔法攻擊的敵人, &#x0D;&#x0A;不要放鬆心情,而受到任何的傷害, &#x0D;&#x0A;希望特別的小心,&#x0D;&#x0A;請全力灌注這次的任務.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_667_000_P_0">
        <VALUE Lang="tw">請消除『光魔導士- 克拉』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_667_000_D_0">
        <VALUE Lang="tw">請掃除出現在本洞的『光魔導士- 克萊爾』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_667_000_P_1">
        <VALUE Lang="tw">確認結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_667_000_D_1">
        <VALUE Lang="tw">請告訴’阿瑪諾儒應’安全的達成任務了. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_668_000">
        <VALUE Lang="tw">請收集財團的資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_668_000">
        <VALUE Lang="tw">&apos;阿瑪諾英’認為可以解除自己&#x0D;&#x0A;封印的資料, 應該在財團1F處 ,他拜託學生請收集一些資料.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_668_000_P_0">
        <VALUE Lang="tw">請尋找資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_668_000_D_0">
        <VALUE Lang="tw">在財團1F閱覽型的終端機附近,請尋找資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_668_000_P_1">
        <VALUE Lang="tw">再多找一些資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_668_000_D_1">
        <VALUE Lang="tw">出入地下用的終端機附近找到的資料以外,看看是否還有其他的資料,請找找看. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_668_000_P_2">
        <VALUE Lang="tw">請傳送資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_668_000_D_2">
        <VALUE Lang="tw">請把找到的資料交給’阿瑪諾英’. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_669_000">
        <VALUE Lang="tw">請找阿瑪諾英的實驗日誌. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_669_000">
        <VALUE Lang="tw">從收集資料的學生口中聽到奇怪的事情,他得知在研究實驗日誌上, 有記載著自己名字的文件之事實, 雖然阿瑪諾英對自己是財團實驗對象的事情,並不會感到特別的驚訝, 但他想詳細的知道到底進行了哪一種的實驗. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_669_000_P_0">
        <VALUE Lang="tw">尋找實驗日誌 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_669_000_D_0">
        <VALUE Lang="tw">在崔泰圭博士的實驗室中,請找阿瑪諾英的實驗日誌. &#x0D;&#x0A;聖財團30F上研究資料4室裡面有許多資料, &#x0D;&#x0A;請從那裡開始慢慢找找看,是否有資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_669_000_P_1">
        <VALUE Lang="tw">請傳送資料 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_669_000_D_1">
        <VALUE Lang="tw">把找到的實驗日誌請交給阿瑪諾英. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_670_000">
        <VALUE Lang="tw">請找崔英錫的實驗日誌. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_670_000">
        <VALUE Lang="tw">自己的實驗日誌還不夠,他知道另外還有理事長孫子&#x0D;&#x0A;崔英錫的實驗日誌,他未了提防未來不可預測的事情,他再次拜託學生幫忙收集崔英錫的實驗日誌.  </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_670_000_P_0">
        <VALUE Lang="tw">尋找實驗日誌 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_670_000_D_0">
        <VALUE Lang="tw">請在尋找阿瑪諾英實驗日誌的實驗室裡面,&#x0D;&#x0A;找一找崔英錫的實驗日誌. &#x0D;&#x0A;聽說財團50F資料管理室裡,有許多資料在裡面保管, 請從那裡開始找找看. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_670_000_P_1">
        <VALUE Lang="tw">請傳遞資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_670_000_D_1">
        <VALUE Lang="tw">把找到的實驗日誌交給阿瑪諾英 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_671_000">
        <VALUE Lang="tw">請傳送資料 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_671_000">
        <VALUE Lang="tw">從學生口中得知崔英錫、阿瑪諾儒應與李真的下落之後, &#x0D;&#x0A;阿瑪諾英既高興,又認為應該要幫助他們,所以把到現在收集到的資料,以及把自己整理的內容,拜託學生交給他們 .</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_671_000_P_0">
        <VALUE Lang="tw">請傳送資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_671_000_D_0">
        <VALUE Lang="tw">請把資料交給李真. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_671_000_P_1">
        <VALUE Lang="tw">請傳送資料.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_671_000_D_1">
        <VALUE Lang="tw">請把資料交給崔英錫. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_672_000">
        <VALUE Lang="tw">請分析阿瑪諾英的資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_672_000">
        <VALUE Lang="tw">雖然收集了零件,&#x0D;&#x0A;但是感覺很渺茫的李真,看到英所提供的資料後,開始分析對自己有所幫助的部份&#x0D;&#x0A;在分析的過程中,他發現需要物理老師和技術老師的幫忙,所以決定找兩位老師的請求幫忙.  </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_672_000_P_0">
        <VALUE Lang="tw">請去找技術老師 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_672_000_D_0">
        <VALUE Lang="tw">把資料交給鳳凰學院的的技術老師, &#x0D;&#x0A;請求幫忙分析資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_672_000_P_1">
        <VALUE Lang="tw">請去見物理老師. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_672_000_D_1">
        <VALUE Lang="tw">把資料交給鳳凰學院的的物理老師, &#x0D;&#x0A;請求幫忙分析資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_672_000_P_2">
        <VALUE Lang="tw">請接受意見書 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_672_000_D_2">
        <VALUE Lang="tw">請技術老師手中接受有關做分析之後,所提出的意見書 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_672_000_P_3">
        <VALUE Lang="tw">請接受意見書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_672_000_D_3">
        <VALUE Lang="tw">請物理老師手中接受有關做分析之後,所提出的意見書 .</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_672_000_P_4">
        <VALUE Lang="tw">請傳送意見書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_672_000_D_4">
        <VALUE Lang="tw">從技術老師和物理老師手中拿到的意見書, 請交給李真. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_673_000">
        <VALUE Lang="tw">請分析英的資料. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_673_000">
        <VALUE Lang="tw">雖然知道李真已經拜託做分析,&#x0D;&#x0A;但是崔英錫另外再委託去做分析.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_673_000_P_0">
        <VALUE Lang="tw">請去找物理老師. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_673_000_D_0">
        <VALUE Lang="tw">把資料送給聖門洞的物理老師, 請求幫忙分析. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_673_000_P_1">
        <VALUE Lang="tw">請傳送意見書.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_673_000_D_1">
        <VALUE Lang="tw">從物理老師手中接受有關分析的意見書.&#x0D;&#x0A;請把意見書交給崔英錫. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_674_000">
        <VALUE Lang="tw">請傳送意見書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_674_000">
        <VALUE Lang="tw">李真把從老師們所給的意見書和自己所做的分析結果中, &#x0D;&#x0A;製作把幾個重要的事實刪掉的意見書, &#x0D;&#x0A;把該份意見書要送給崔英錫. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_674_000_P_0">
        <VALUE Lang="tw">請傳送意見書 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_674_000_D_0">
        <VALUE Lang="tw">把李真的意見書交給崔英錫. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_675_000">
        <VALUE Lang="tw">請傳送意見書. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_675_000">
        <VALUE Lang="tw">崔英錫從聖門洞物理教師那裡,雖然知道幾件重要的事實, &#x0D;&#x0A;但是他只把自己的意見寫成的意見書 &#x0D;&#x0A;交給李真. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_675_000_P_0">
        <VALUE Lang="tw">請傳送意見書 </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_675_000_D_0">
        <VALUE Lang="tw">把崔英錫的意見書交給李真. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_676_000">
        <VALUE Lang="tw">請求洪智燕的幫忙. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_676_000">
        <VALUE Lang="tw">至今仍未恢復記憶的李大旭, 從學生的口中&#x0D;&#x0A;聽到洪智燕的名字,雖然記不起來,但是不是很陌生的名字!!&#x0D;&#x0A;他抱著或許能找回記憶的一線希望, 他請求幫忙. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_676_000_P_0">
        <VALUE Lang="tw">請去見洪智燕. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_676_000_D_0">
        <VALUE Lang="tw">請傳達李大旭的訊息. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_676_000_P_1">
        <VALUE Lang="tw">請傳遞物品. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_676_000_D_1">
        <VALUE Lang="tw">洪智燕是李大旭小時後的朋友之事實,還有小時後的幾件物品,請把這些交給李大旭. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_677_000">
        <VALUE Lang="tw">請說服阿瑪諾儒應. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_677_000">
        <VALUE Lang="tw">李真非常清楚阿瑪諾儒應&#x0D;&#x0A;對他妹妹的愛有多深,他把阿瑪諾英給他的書信交給阿瑪諾儒應,希望阿瑪諾儒應從罪惡感中脫離, &#x0D;&#x0A;能夠幫助妹妹.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_677_000_P_0">
        <VALUE Lang="tw">請傳遞書信. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_677_000_D_0">
        <VALUE Lang="tw">把阿瑪諾英的書信交給他哥哥阿瑪諾儒應. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_677_000_P_1">
        <VALUE Lang="tw">請求原諒. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_677_000_D_1">
        <VALUE Lang="tw">接到妹妹的信件和資料後,由於過去拒絕妹妹的事情,&#x0D;&#x0A;請求原諒. 藉著這次的重逢,想要補償過去對妹妹的虧欠,&#x0D;&#x0A;他寫了一封希望妹妹稍微再加努力撐著的信件,&#x0D;&#x0A;請把信交給阿瑪諾英. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_678_000">
        <VALUE Lang="tw">傳送感謝的書信. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_678_000">
        <VALUE Lang="tw">受到物品的李大旭,還是沒有辦法記起任何的事情,但心中感到一絲的溫情, &#x0D;&#x0A;他對努力想幫助他的洪智燕想要表達感謝之意. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_678_000_P_0">
        <VALUE Lang="tw">他送髮夾給洪智燕. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_678_000_D_0">
        <VALUE Lang="tw">請把以前學生送給他的髮夾, &#x0D;&#x0A;請送給洪智燕. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_679_000">
        <VALUE Lang="tw">請收集附屬品. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_679_000">
        <VALUE Lang="tw">看到意見書的崔英錫,他開始背著李真,偷偷的收集一些製造人體分離器所需要的附屬品.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_679_000_P_0">
        <VALUE Lang="tw">請收集附屬品</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_679_000_D_0">
        <VALUE Lang="tw">請在財團地下室中,收集一些製作人體分離器所需要的附屬品回來. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_679_000_P_1">
        <VALUE Lang="tw">請再多收集一些附屬品回來. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_679_000_D_1">
        <VALUE Lang="tw">請在財團地下室中,收集一些製作人體分離器所需要的附屬品回來.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_679_000_P_2">
        <VALUE Lang="tw">請再多收集一些附屬品回來</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_679_000_D_2">
