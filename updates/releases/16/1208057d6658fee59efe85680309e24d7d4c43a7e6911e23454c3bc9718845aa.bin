    <SENTENSE Ver="1" Id="QN_901_000">
        <VALUE Lang="tw">1-1教室的國語考試</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_901_000">
        <VALUE Lang="tw">這是到固定時間就要一定要考的考試的一部分</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_901_000_P_0">
