    <SENTENSE Ver="1" Id="QD_763_000">
        <VALUE Lang="tw">為了對於南方地區有些甚麼東西感到好奇的卡拉賽諾，請去向生化熊多了解一些</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_763_000_P_0">
        <VALUE Lang="tw">去找生化熊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_763_000_D_0">
        <VALUE Lang="tw">去見生化熊聽更多故事</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_763_000_P_1">
        <VALUE Lang="tw">去找黑羽祭司</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_763_000_D_1">
        <VALUE Lang="tw">去見達拉米亞的黑羽祭司獲得更多的資訊吧!</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_764_000">
        <VALUE Lang="tw">過去的記憶</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_764_000">
        <VALUE Lang="tw">憑藉著零碎的過去記憶，將可做為治療藥的雷加圖斯的寶珠和死靈的碎片，交給混亂的黑羽祭司</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_764_000_P_0">
        <VALUE Lang="tw">去找黑羽祭司</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_764_000_D_0">
        <VALUE Lang="tw">把雷加圖斯的寶珠和死靈的碎片交給黑羽祭司</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_765_000">
        <VALUE Lang="tw">復仇的決心</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_765_000">
        <VALUE Lang="tw">黑羽祭司發誓要向那些給自己做過身體實驗的科學家進行報復，但是因為還在恢復的階段，必須幫助他。請消滅異變生物科學家和異變感染科學家替他完成報仇</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_765_000_P_0">
        <VALUE Lang="tw">去消滅異變生物研究家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_765_000_D_0">
        <VALUE Lang="tw">消滅20名異變生物研究家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_765_000_P_1">
        <VALUE Lang="tw">去消滅異變感染科學家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_765_000_D_1">
        <VALUE Lang="tw">消滅20名異變感染科學家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_765_000_P_2">
        <VALUE Lang="tw">去找科學家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_765_000_D_2">
        <VALUE Lang="tw">去找科學家告訴他黑羽祭司要報仇的事。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_765_000_P_3">
        <VALUE Lang="tw">去完成確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_765_000_D_3">
        <VALUE Lang="tw">消滅科學家後告訴黑羽祭司</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_766_000">
        <VALUE Lang="tw">眼淚的蒸發</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_766_000">
        <VALUE Lang="tw">請幫生化熊消滅因為身體實驗結果而變得很粗暴的朋友後，再去向生化熊取得確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_766_000_P_0">
        <VALUE Lang="tw">消滅鈦晶生化熊王</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_766_000_D_0">
        <VALUE Lang="tw">去消滅10隻鈦晶生化熊王</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_766_000_P_1">
        <VALUE Lang="tw">去完成確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_766_000_D_1">
        <VALUE Lang="tw">去找生化熊確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_767_000">
        <VALUE Lang="tw">研究基地地下道</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_767_000">
        <VALUE Lang="tw">卡拉賽諾沒多久前曾透過黑羽祭司得知同伴們去的地方，去找黑羽祭司了解詳細情形，再去前往地下的入口</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_767_000_P_0">
        <VALUE Lang="tw">去找黑羽祭司</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_767_000_D_0">
        <VALUE Lang="tw">去找黑羽祭司聽有關地下室的故事</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_767_000_P_1">
        <VALUE Lang="tw">去研究院地下室入口</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_767_000_D_1">
        <VALUE Lang="tw">去中央公園的環境控制塔找通往地下的出入口</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_768_000">
        <VALUE Lang="tw">[組隊] 世界的棟樑</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_768_000">
        <VALUE Lang="tw">沉默的熾天使要阻止火靈艾巴努(魯西安)的野心，請在50分鐘內找到火靈艾巴努(魯西安)並消滅他，再去找被關起來的黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_768_000_P_0">
        <VALUE Lang="tw">去消滅火靈艾巴努(魯西安)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_768_000_D_0">
        <VALUE Lang="tw">消滅在地底深處的火靈艾巴努(魯西安)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_768_000_P_1">
        <VALUE Lang="tw">去找黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_768_000_D_1">
        <VALUE Lang="tw">火靈艾巴努(魯西安)去找看守地下通道的黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_769_000">
        <VALUE Lang="tw">[組隊] 勇士的精神</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_769_000">
        <VALUE Lang="tw">神祕的「藍色靈魂之珠」可從火靈艾巴努(魯西安)那取得，請蒐集5個交給黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_769_000_P_0">
        <VALUE Lang="tw">獲得藍色靈魂之珠</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_769_000_D_0">
        <VALUE Lang="tw">消滅火靈艾巴努(魯西安)把蒐集5個&apos;藍色靈魂之珠</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_769_000_P_1">
        <VALUE Lang="tw">拿去給黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_769_000_D_1">
        <VALUE Lang="tw">把5個 &apos;藍色靈魂之珠&apos;給黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_770_000">
        <VALUE Lang="tw">[組隊] 異界之門</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_770_000">
        <VALUE Lang="tw">請壓制守護異界之門的熾天使米亞，並說出關於火靈艾巴努(魯西安)的陰謀</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_770_000_P_0">
        <VALUE Lang="tw">去壓制熾天使米亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_770_000_D_0">
        <VALUE Lang="tw">去壓制熾天使米亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_770_000_P_1">
        <VALUE Lang="tw">去找失敗的米亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_770_000_D_1">
        <VALUE Lang="tw">去找失敗的米亞告訴她火靈艾巴努(魯西安)的陰謀</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_770_000_P_2">
        <VALUE Lang="tw">去找黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_770_000_D_2">
        <VALUE Lang="tw">把和熾天使米亞的事告訴 黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_771_000">
        <VALUE Lang="tw">[組隊] 殘酷的命運</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_771_000">
        <VALUE Lang="tw">請在30分鐘內消滅50名因為身體實驗而失去原本模樣的雙刃生化人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_771_000_P_0">
        <VALUE Lang="tw">去消滅雙刃生化人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_771_000_D_0">
        <VALUE Lang="tw">30分鐘內消滅50名 雙刃生化人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_771_000_P_1">
        <VALUE Lang="tw">去完成確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_771_000_D_1">
        <VALUE Lang="tw">去找沉默的熾天使確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_772_000">
        <VALUE Lang="tw">[組隊] 不屈的意志</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_772_000">
        <VALUE Lang="tw">請在30分鐘內消滅30名因為身體實驗而失去原本模樣的雙拳生化人</VALUE>
    </SENTENSE>
