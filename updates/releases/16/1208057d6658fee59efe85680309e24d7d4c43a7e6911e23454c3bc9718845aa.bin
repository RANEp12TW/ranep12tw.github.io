    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1412_000_P_0">
        <VALUE Lang="tw">找回書本</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1412_000_D_0">
        <VALUE Lang="tw">買來的書被滑輪高手搶走了。幫忙從他們身上找回來。書名是&lt;遊戲研發C++&gt;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1412_000_P_1">
        <VALUE Lang="tw">轉交書本</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1412_000_D_1">
        <VALUE Lang="tw">找到&lt;遊戲研發C++&gt;這本書後請交給商洞書店前的鄭課長</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1413_000">
        <VALUE Lang="tw">書籍回收3</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1413_000">
        <VALUE Lang="tw">偷偷購買的書籍被不良分子偷走了。&#x0D;&#x0A;請幫忙把書本找回來。&#x0D;&#x0A;點選&lt;詳細&gt;按鍵可以確認更多有用的資訊。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1413_000_P_0">
        <VALUE Lang="tw">找回書本</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1413_000_D_0">
        <VALUE Lang="tw">買來的書被浩呆搶走了。幫忙從他們身上找回來。書名是&lt;特效遊戲程式&gt;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1413_000_P_1">
        <VALUE Lang="tw">轉交書本</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1413_000_D_1">
        <VALUE Lang="tw">找到&lt;特效遊戲程式&gt;這本書後請交給商洞書店前的鄭課長</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1414_000">
        <VALUE Lang="tw">書籍回收4</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1414_000">
        <VALUE Lang="tw">偷偷購買的書籍被不良分子偷走了。&#x0D;&#x0A;請幫忙把書本找回來。&#x0D;&#x0A;點選&lt;詳細&gt;按鍵可以確認更多有用的資訊。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1414_000_P_0">
        <VALUE Lang="tw">找回書本</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1414_000_D_0">
        <VALUE Lang="tw">買來的書被冰凍小丑搶走了。幫忙從他們身上找回來。書名是&lt;RPGforDirectX&gt;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1414_000_P_1">
        <VALUE Lang="tw">轉交書本</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1414_000_D_1">
        <VALUE Lang="tw">找到&lt;RPGforDirectX&gt;這本書後請交給商洞書店前的鄭課長</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1415_000">
        <VALUE Lang="tw">警衛的請求</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1415_000">
        <VALUE Lang="tw">收到管理辦公室前的警衛說有跟自己長得一模一樣的人在擾亂，需要有人幫忙代替他阻止他們的請求。去聖門洞把他們身上的警棍搶過來。&#x0D;&#x0A;點選&lt;詳細&gt;按鍵可以確認其它更詳細的資訊。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1415_000_P_0">
        <VALUE Lang="tw">蒐集聖門保全的警棍</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1415_000_D_0">
        <VALUE Lang="tw">來自建築物前方私人警衛的委託，需要有人幫忙清除分身。消滅聖門洞的聖門保全蒐集警棍。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1415_000_P_1">
        <VALUE Lang="tw">轉交警棍</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1415_000_D_1">
        <VALUE Lang="tw">將蒐集到的警棍交給管理辦公室前方的私人警衛</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1416_000">
        <VALUE Lang="tw">掃蕩野生物種</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1416_000">
        <VALUE Lang="tw">霸天雲想送給學生禮物當作幫忙消滅四周怪物的代價。依序消滅漁夫、焊接技師、殘暴水手、殘酷光頭猛男可以獲得禮物。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1416_000_P_0">
        <VALUE Lang="tw">消滅漁夫</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1416_000_D_0">
        <VALUE Lang="tw">消滅公共倉庫四周的漁夫3位</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1416_000_P_1">
        <VALUE Lang="tw">消滅焊接技師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1416_000_D_1">
        <VALUE Lang="tw">2- 消滅碼頭四周的焊接技師5位</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1416_000_P_2">
        <VALUE Lang="tw">消滅殘暴水手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1416_000_D_2">
        <VALUE Lang="tw">4- 消滅冰庫四周的殘暴水手7位</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1416_000_P_3">
        <VALUE Lang="tw">消滅殘酷光頭猛男</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1416_000_D_3">
        <VALUE Lang="tw">5- 消滅碼頭四周的殘酷光頭猛男10位</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1416_000_P_4">
        <VALUE Lang="tw">跟霸天雲回報結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1416_000_D_4">
        <VALUE Lang="tw">找霸天雲回報結果領取獎勵</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1417_000">
        <VALUE Lang="tw">傳說的起源 - Episode 2</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1417_000">
        <VALUE Lang="tw">失去眼前心愛的人。演出為了使用魔術無法保護心愛的人，所以想要求魔術的改革。去找魔術部指導老師提出改革建議。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1417_000_P_0">
        <VALUE Lang="tw">魔術部改革建議</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1417_000_D_0">
        <VALUE Lang="tw">找魔術部指導老師提出魔術部改革建議</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1418_000">
        <VALUE Lang="tw">傳說的起源 - Episode 2</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1418_000">
        <VALUE Lang="tw">失去眼前心愛的人。演出為了使用魔術無法保護心愛的人，所以想要求魔術的改革。去找魔術部指導老師提出改革建議。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1418_000_P_0">
        <VALUE Lang="tw">魔術部改革建議</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1418_000_D_0">
        <VALUE Lang="tw">找魔術部指導老師提出魔術部改革建議</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1420_000">
        <VALUE Lang="tw">變身部的加入</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1420_000">
        <VALUE Lang="tw">其他學院的學生向你發出了請求. 如果幫助他們，將會改變他們對變身部的看法，並會重新接受你們. 請消滅所有學生們都畏懼的 &quot;派遣的雙槍殺手&quot;.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1420_000_P_0">
        <VALUE Lang="tw">消滅位於中洞的 &apos;派遣的雙槍殺手&apos;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1420_000_D_0">
        <VALUE Lang="tw">消滅派遣的雙槍殺手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1421_000">
        <VALUE Lang="tw">變身部的人氣</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1421_000">
        <VALUE Lang="tw">變身部創建後，收到了很多學生們的求助. 請消滅本洞的 &quot;勁辣美魔女&quot;. 數個月前的本洞原本人來人往，但是自從遭到襲擊後，變得死氣沉沉.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1421_000_P_0">
        <VALUE Lang="tw">消滅位於本洞的 &apos;勁辣美魔女&apos;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1421_000_D_0">
        <VALUE Lang="tw">消滅勁辣美魔女</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1422_000">
        <VALUE Lang="tw">變身部的存在感</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1422_000">
        <VALUE Lang="tw">&apos;雙槍刺客&apos;原本是聖財團的警備員. 但是現在被崔博士精神控制後，變成了無情的殺手集團. 請消滅他們.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1422_000_P_0">
        <VALUE Lang="tw">消滅位於聖財團11層的 &apos;雙槍刺客&apos;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1422_000_D_0">
        <VALUE Lang="tw">消滅雙槍刺客</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1953_000">
        <VALUE Lang="tw">3rd Evolution</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1953_000">
        <VALUE Lang="tw">Please go see Potential Warlock to receive new power which he has prepared for you.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1953_000_P_0">
        <VALUE Lang="tw">New Power</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1953_000_D_0">
        <VALUE Lang="tw">Please go see Potential Warlock to receive new power which he has prepared for you.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2000_000">
        <VALUE Lang="tw">端午節活動</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2000_000">
        <VALUE Lang="tw">擊倒50隻白蛇, 即可獲得獎勵.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2000_000_P_0">
        <VALUE Lang="tw">擊倒白蛇</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2000_000_D_0">
        <VALUE Lang="tw">端午節活動期間, 有許多白蛇出現在學院外, 需要同學們一起到學院外消滅牠. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2000_000_P_1">
        <VALUE Lang="tw">獲得獎勵經驗值</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2000_000_D_1">
        <VALUE Lang="tw">學生們在擊倒50隻白蛇後, 回報給學院廣場的維莉保安長官, 即可獲得獎勵經驗值.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2001_000">
        <VALUE Lang="tw">Duration of Sector 9</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2001_000">
        <VALUE Lang="tw">You can stay in Sector 9 for certain time only. You will have to defeat monsters in such duration. After 24 hours have passed, you will be forced out from Sector 9.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2001_000_P_0">
        <VALUE Lang="tw">Defeat monsters at Sector 9 during its duration.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2001_000_D_0">
        <VALUE Lang="tw">Try achieving everything before the Sector 9 duration ends.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2004_000">
        <VALUE Lang="tw">詭殖擊 輝塭!!</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2004_000">
        <VALUE Lang="tw">陛梱遴 夠擎 嬴棲雖虜 螢葡檜 偃譆腎堅 氈棻 棲棻.&#x0D;&#x0A;獄 檜漸朝 婁翱 措曖 詭殖 菜熱朝 橡葆釭 腆梱 薄藥 爾堅 遴紫 援萵 熱 氈朝 晦陛 腆 熱 氈擊 匙殮棲棻.&#x0D;&#x0A;螢葡 輿蒂 菜 詭殖 菜熱陛 瞳 鰍戲煎 掖紫煙 褊衛螃&#x0D;&#x0A;&apos;濠撮&apos; 幗擊 援腦衛賊 撮睡瞳檣 頂辨擊 爾褒 熱 氈蝗棲棻.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2004_000_P_0">
        <VALUE Lang="tw">螢葡 輿蒂 賅嬴塭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2004_000_D_0">
        <VALUE Lang="tw">獄婦 擅縑 氈朝 羹檣菟煎睡攪 5偃曖 螢葡 輿蒂 殮熱褊衛螃.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2004_000_P_1">
        <VALUE Lang="tw">螢葡 鰍 掖錳縑啪 瞪殖塭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2004_000_D_1">
        <VALUE Lang="tw">螢葡 輿 5偃蒂 殮熱朝 等縑 撩奢樟棻賊 &apos;螢葡 鰍 掖錳&apos;縑啪 陛螳棻 輿褊衛螃</VALUE>
    </SENTENSE>
