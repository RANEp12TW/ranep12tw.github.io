    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1226_000">
        <VALUE Lang="tw">回收彈珠</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1226_000">
        <VALUE Lang="tw">有一群怪人棲息在本洞&#x0D;&#x0A;就資料顯示他們所發揮的力量來自一種彈珠，請搶回這種彈珠。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1226_000_P_0">
        <VALUE Lang="tw">搶回『魂靈珠』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1226_000_D_0">
        <VALUE Lang="tw">出現擁有超能力般的人，請搶下他們手上的『魂靈珠』。</VALUE>
