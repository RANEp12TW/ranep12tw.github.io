    <SENTENSE Ver="1" Id="QN_3117_000">
        <VALUE Lang="tw">[每日限定] 愛護學弟妹</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3117_000">
        <VALUE Lang="tw">很高興認識你, 我是這個學院畢業的, 目前事業有成&#x0D;&#x0A;偶爾會回來看看我可愛的學弟妹送他們一些禮物&#x0D;&#x0A;和我一起享受這派對吧!</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3117_000_P_0">
        <VALUE Lang="tw">接受學姊愛的禮物</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3117_000_D_0">
        <VALUE Lang="tw">活動期間內美麗的學姊會送出很多禮物喔!&#x0D;&#x0A;※在她附近的話任務會自動完成</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3118_000">
        <VALUE Lang="tw">[每日限定] 聖誕老人的卡片碎片</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3118_000">
        <VALUE Lang="tw">禮物清單飛走了..幸好我還有X碎片可以送給你</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3118_000_P_0">
        <VALUE Lang="tw">收下卡片碎片</VALUE>
    </SENTENSE>
