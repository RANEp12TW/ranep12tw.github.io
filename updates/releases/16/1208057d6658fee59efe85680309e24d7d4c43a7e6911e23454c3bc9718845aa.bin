    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_921_000_P_0">
        <VALUE Lang="tw">取得考試卷</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_921_000_D_0">
        <VALUE Lang="tw">去找商店的店員拿考試卷</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_921_000_P_1">
        <VALUE Lang="tw">去考試機那裡開始接受考試</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_921_000_D_1">
        <VALUE Lang="tw">去位於1-2教室的考試機考試</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_921_000_P_2">
        <VALUE Lang="tw">取得成績單</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_921_000_D_2">
        <VALUE Lang="tw">順利地考完試後,去拿考試機給的成績單</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_921_000_P_3">
        <VALUE Lang="tw">提出成績單</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_921_000_D_3">
        <VALUE Lang="tw">試都考完後把從考試機那裡拿到的成績單交給考試用的終端機</VALUE>
    </SENTENSE>
