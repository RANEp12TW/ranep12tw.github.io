        <VALUE Lang="tw">回收攻擊指令 (反覆)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2315_000">
        <VALUE Lang="tw">偵查指令似乎隱藏突擊兵攻擊指令部分技術。看來他們是根據攻擊指令運作。&#x0A;請幫忙協助回收攻擊指令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2315_000_P_0">
        <VALUE Lang="tw">回收攻擊指令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2315_000_D_0">
