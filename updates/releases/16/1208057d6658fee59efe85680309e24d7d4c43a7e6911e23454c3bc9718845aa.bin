    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2129_000_D_0">
        <VALUE Lang="tw">隨著向滑輪小子們回收GPS,請也跟著移動</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2129_000_P_1">
        <VALUE Lang="tw">找尋商洞書店</VALUE>
    </SENTENSE>
