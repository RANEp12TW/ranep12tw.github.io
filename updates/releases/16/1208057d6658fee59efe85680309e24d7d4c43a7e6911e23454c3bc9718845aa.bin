    <SENTENSE Ver="1" Id="QD_547_000_D_3">
        <VALUE Lang="tw">請將準備好的服裝, 安全的交給布萊恩. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_548_000">
        <VALUE Lang="tw">尋找乾冰</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_548_000">
        <VALUE Lang="tw">為了保存冰淇淋,需要一些乾冰, 剛好放在倉庫的乾冰被偷走了, 請幫忙找被偷走的乾冰. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_548_000_P_0">
        <VALUE Lang="tw">請找乾冰</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_548_000_D_0">
        <VALUE Lang="tw">從在碼頭冷凍倉庫裡的賊頭槍手之手中, 找回乾冰. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_548_000_P_1">
        <VALUE Lang="tw">請傳遞乾冰. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_548_000_D_1">
        <VALUE Lang="tw">將找回來的乾冰交給商洞的冰淇淋販賣員. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_549_000">
        <VALUE Lang="tw">回收舊書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_549_000">
        <VALUE Lang="tw">從很久以前,就開始收集的舊書,被商洞的筋肉人搶走了 ,請幫忙找回舊書,並交給商洞的鄭課長. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_549_000_P_0">
        <VALUE Lang="tw">請收集舊書. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_549_000_D_0">
        <VALUE Lang="tw">從筋肉人手中找回舊書. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_549_000_P_1">
        <VALUE Lang="tw">請找回古籍. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_549_000_D_1">
        <VALUE Lang="tw">從媽媽桑手中找回古籍. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_549_000_P_2">
        <VALUE Lang="tw">請去見鄭課長. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_549_000_D_2">
        <VALUE Lang="tw">請把收集的舊書和古籍, 交給鄭課長. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_550_000">
        <VALUE Lang="tw">回收警衛證件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_550_000">
        <VALUE Lang="tw">綜合碼頭內的冷凍倉庫, 因有人侵入無法正常的管理 , 尤其是已經離職的警衛,仍然帶著可自由進出的證件, 為了讓他們無法隨意進出, 請幫忙回收出入証件.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_550_000_P_0">
        <VALUE Lang="tw">請回收出入証.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_550_000_D_0">
        <VALUE Lang="tw">在綜合碼頭的警掍賊頭和賊頭槍手中, 回收10個出入證. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_550_000_P_1">
        <VALUE Lang="tw">請傳遞出入證. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_550_000_D_1">
        <VALUE Lang="tw">把收集的出入證件請交給商洞的警察. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_551_000">
        <VALUE Lang="tw">收集研磨劑</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_551_000">
        <VALUE Lang="tw">雖然手中保管一些裝有研磨劑的盒子, 但是要打開這些盒子需要油, 因為無法確定盒子裡,到底裝了什麼, 請收集油後, 打開盒子看看吧!</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_551_000_P_0">
        <VALUE Lang="tw">請收集油.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_551_000_D_0">
        <VALUE Lang="tw">從在綜合碼頭的漁夫手中,請收集10瓶油. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_551_000_P_1">
        <VALUE Lang="tw">請傳遞油. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_551_000_D_1">
        <VALUE Lang="tw">將收集好的油,交給商洞的清潔工人.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_555_000">
        <VALUE Lang="tw">收集發生異變之前的資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_555_000">
        <VALUE Lang="tw">商洞的代理師傅們對於異變發生的前後,知道的少之又少, 剛好在發生異變之前,市民們把當時的日常生活做紀錄,做成了&apos;時間膠囊&apos; , 埋在地底下, 請找回&apos;時間膠囊&apos;交給代理師傅. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_555_000_P_0">
        <VALUE Lang="tw">請找時間膠囊1號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_555_000_D_0">
        <VALUE Lang="tw">請在第一排最右邊的洞裡面 ,找出時間膠囊1號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_555_000_P_1">
        <VALUE Lang="tw">請找時間膠囊2號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_555_000_D_1">
        <VALUE Lang="tw">請在第一排中央的洞裡面 ,找出時間膠囊2號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_555_000_P_2">
        <VALUE Lang="tw">請找時間膠囊3號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_555_000_D_2">
        <VALUE Lang="tw">請在第一排最左邊的洞裡面 ,找出時間膠囊3號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_555_000_P_3">
        <VALUE Lang="tw">請交給劍道道場代理師傅.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_555_000_D_3">
        <VALUE Lang="tw">請把它交給在商洞的劍道道場代理師傅手中. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_556_000">
        <VALUE Lang="tw">收集發生異變之前的資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_556_000">
        <VALUE Lang="tw">商洞的代理師傅們對於異變發生的前後,知道的少之又少, 剛好在發生異變之前,市民們把當時的日常生活做紀錄,做成了&apos;時間膠囊&apos; , 埋在地底下, 請找回&apos;時間膠囊&apos;交給代理師傅. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_556_000_P_0">
        <VALUE Lang="tw">請找時間膠囊1號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_556_000_D_0">
        <VALUE Lang="tw">請在第一排最右邊的洞裡面 ,找出時間膠囊1號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_556_000_P_1">
        <VALUE Lang="tw">請找時間膠囊2號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_556_000_D_1">
        <VALUE Lang="tw">請在第一排中央的洞裡面 ,找出時間膠囊2號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_556_000_P_2">
        <VALUE Lang="tw">請找時間膠囊3號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_556_000_D_2">
        <VALUE Lang="tw">請在第一排最左邊的洞裡面 ,找出時間膠囊3號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_556_000_P_3">
        <VALUE Lang="tw">請交給弓箭道場代理師傅.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_556_000_D_3">
        <VALUE Lang="tw">請把它交給在商洞的弓箭道場代理師傅手中. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_557_000">
        <VALUE Lang="tw">收集發生異變之前的資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_557_000">
        <VALUE Lang="tw">商洞的代理師傅們對於異變發生的前後,知道的少之又少, 剛好在發生異變之前,市民們把當時的日常生活做紀錄,做成了&apos;時間膠囊&apos; , 埋在地底下, 請找回&apos;時間膠囊&apos;交給代理師傅. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_557_000_P_0">
        <VALUE Lang="tw">請找時間膠囊4號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_557_000_D_0">
        <VALUE Lang="tw">請在第二排最左邊的洞裡面 ,找出時間膠囊4號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_557_000_P_1">
        <VALUE Lang="tw">請找時間膠囊5號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_557_000_D_1">
        <VALUE Lang="tw">請在第二排中央的洞裡面 ,找出時間膠囊5號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_557_000_P_2">
        <VALUE Lang="tw">請找時間膠囊6號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_557_000_D_2">
        <VALUE Lang="tw">請在第一排最右邊的洞裡面 ,找出時間膠囊6號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_557_000_P_3">
        <VALUE Lang="tw">請交給格鬥道場代理師傅.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_557_000_D_3">
        <VALUE Lang="tw">請把它交給在商洞的格鬥道場代理師傅手中. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_558_000">
        <VALUE Lang="tw">收集發生異變之前的資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_558_000">
        <VALUE Lang="tw">商洞的代理師傅們對於異變發生的前後,知道的少之又少, 剛好在發生異變之前,市民們把當時的日常生活做紀錄,做成了&apos;時間膠囊&apos; , 埋在地底下, 請找回&apos;時間膠囊&apos;交給代理師傅. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_558_000_P_0">
        <VALUE Lang="tw">請找時間膠囊4號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_558_000_D_0">
        <VALUE Lang="tw">請在第二排最左邊的洞裡面 ,找出時間膠囊4號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_558_000_P_1">
        <VALUE Lang="tw">請找時間膠囊5號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_558_000_D_1">
        <VALUE Lang="tw">請在第二排中央的洞裡面 ,找出時間膠囊5號.  </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_558_000_P_2">
        <VALUE Lang="tw">請找時間膠囊6號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_558_000_D_2">
        <VALUE Lang="tw">請在第一排最右邊的洞裡面 ,找出時間膠囊6號. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_558_000_P_3">
        <VALUE Lang="tw">請交給氣功道場代理師傅.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_558_000_D_3">
        <VALUE Lang="tw">請把它交給在商洞的氣功道場代理師傅手中. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_559_000">
        <VALUE Lang="tw">傳遞緊急行動手冊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_559_000">
        <VALUE Lang="tw">當緊急時要實施的應變手冊,聽說有一些地方沒有送到,請在書店附近拿到手冊後發給大家. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_559_000_P_0">
        <VALUE Lang="tw">請去找鄭課長</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_559_000_D_0">
        <VALUE Lang="tw">請去找在商洞的鄭課長,接受武器書籍、護理書籍和法律書籍.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_559_000_P_1">
        <VALUE Lang="tw">請去見警察</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_559_000_D_1">
        <VALUE Lang="tw">請去找在商洞的警察 , 將法律書籍交給他. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_559_000_P_2">
        <VALUE Lang="tw">請去找武器店長</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_559_000_D_2">
        <VALUE Lang="tw">把武器書籍交給在中洞的武器店長. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_559_000_P_3">
        <VALUE Lang="tw">請去找護士</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_559_000_D_3">
        <VALUE Lang="tw">把護理書籍交給在中洞的護士. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_560_000">
        <VALUE Lang="tw">加強治安措施</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_560_000">
        <VALUE Lang="tw">異變發生後, 隨著時間的流逝, 危險的要素愈來愈有增加的情形,為了加強防禦措施,請找出曾在監獄使用過的武器,預備 將來重新再使用. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_560_000_P_0">
        <VALUE Lang="tw">請到監獄入口處</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_560_000_D_0">
        <VALUE Lang="tw">請找出放在監獄的入口處(第三哨口)旁邊的武器. (如 M16,鐵鎚等等 ) </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_560_000_P_1">
        <VALUE Lang="tw">請去找武器店長</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_560_000_D_1">
        <VALUE Lang="tw">把找到的武器交給中洞的武器店長. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_561_000">
        <VALUE Lang="tw">搶救市民</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_561_000">
        <VALUE Lang="tw">異變發生後,在中洞有一些市民來不及逃走, 請去找這些市民 給予協助. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_561_000_P_0">
        <VALUE Lang="tw">請找出市民</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_561_000_D_0">
        <VALUE Lang="tw">聽到在中洞有些市民來不及逃難的消息, 請你找出他們, 聽說在(86),(51)附近有發現到他們, 請參考. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_561_000_P_1">
        <VALUE Lang="tw">請去見商洞護士</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_561_000_D_1">
        <VALUE Lang="tw">從護士那裡拿急救用的藥品袋. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_561_000_P_2">
        <VALUE Lang="tw">請去見熱狗販賣員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_561_000_D_2">
        <VALUE Lang="tw">請準備熱狗當做備用糧食. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_561_000_P_3">
        <VALUE Lang="tw">請取得緊急行動手冊. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_561_000_D_3">
        <VALUE Lang="tw">請在商洞警察身上 ,領取危險狀況時使用的行動手冊. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_561_000_P_4">
        <VALUE Lang="tw">請發給市民 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_561_000_D_4">
        <VALUE Lang="tw">一分一秒都不能等,請快點把準備好的物品送給在中洞的市民. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_562_000">
        <VALUE Lang="tw">調查殉職事件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_562_000">
        <VALUE Lang="tw">為了知道在監獄殉職的警察死亡經過,必須要回收監獄的監視錄影帶, 但是這些錄影帶已經被囚犯放到別處去了 ,請從囚犯手中找回該錄影帶. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_562_000_P_0">
        <VALUE Lang="tw">請找監視錄影帶. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_562_000_D_0">
        <VALUE Lang="tw">透過在監獄內部裝置的CCTV, 雖然可以了解整個事件的經過,可是不幸的錄影帶被 『罪囚-大圈仔』 跟『模範-大圈仔』偷走了,請找回被搶走的錄影帶。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_562_000_P_1">
        <VALUE Lang="tw">請交給警察</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_562_000_D_1">
        <VALUE Lang="tw">請把找到的事件經過報告和錄影帶交給商洞的警察。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_563_000">
        <VALUE Lang="tw">回收爆竹</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_563_000">
        <VALUE Lang="tw">火災零星的發生, 其實是因為處理易燃物的方法上出了問題,請在本洞的長頸魔偶手中, 收回爆竹 . </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_563_000_P_0">
        <VALUE Lang="tw">請取回爆竹.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_563_000_D_0">
        <VALUE Lang="tw">請在本洞的長頸魔偶手中取回30個爆竹. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_563_000_P_1">
        <VALUE Lang="tw">請見本洞的警察. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_563_000_D_1">
        <VALUE Lang="tw">請把取回的爆竹交給本洞的警察. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_564_000">
        <VALUE Lang="tw">魔法系防禦活動</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_564_000">
        <VALUE Lang="tw">因為受到魔法系的攻擊, 許多學生受到傷害,尤其是在本洞意外事件發生 的次數較多, 為了對建立防禦政策有所幫助, 請從魔導士們的手中取回技能文書. .</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_564_000_P_0">
        <VALUE Lang="tw">請取得技能文書. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_564_000_D_0">
        <VALUE Lang="tw">請取回毒魔導士所使用的技能文書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_564_000_P_1">
        <VALUE Lang="tw">請取得技能文書. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_564_000_D_1">
        <VALUE Lang="tw">請取回光魔導士所使用的技能文書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_564_000_P_2">
        <VALUE Lang="tw">請取得技能文書. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_564_000_D_2">
        <VALUE Lang="tw">請取回火魔導士所使用的技能文書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_564_000_P_3">
        <VALUE Lang="tw">請取得技能文書. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_564_000_D_3">
        <VALUE Lang="tw">請取回冰魔導士所使用的技能文書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_564_000_P_4">
        <VALUE Lang="tw">請傳送技能文書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_564_000_D_4">
        <VALUE Lang="tw">請把收集到的技能文書經由公車站傳送過去.&#x0D;&#x0A;但是請注意,不要利用各學院前面的終端機來傳送.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_565_000">
        <VALUE Lang="tw">收集魂靈珠II</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_565_000">
        <VALUE Lang="tw">趁這個城市還沒發生問題前,武器店長需要靈珠來修理武器.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_565_000_P_0">
        <VALUE Lang="tw">收集魂靈珠</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_565_000_D_0">
        <VALUE Lang="tw">武器店長說從暴怒工頭身上可以找到魂靈珠</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_565_000_P_1">
        <VALUE Lang="tw">收集青珠</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_565_000_D_1">
        <VALUE Lang="tw">武器店長說從十字鎬肥仔身上可以找到青珠</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_565_000_P_2">
        <VALUE Lang="tw">將這些珠交回給武器店長[中洞]</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_565_000_D_2">
        <VALUE Lang="tw">將這些珠交回給武器店長[中洞]</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_566_000">
        <VALUE Lang="tw">收集靈珠III</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_566_000">
        <VALUE Lang="tw">聽說鋼筋地魔身上有很特別的靈珠. &#x0D;&#x0A;本洞的警察想要調查這件事情,希望能夠幫忙協助調查.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_566_000_P_0">
        <VALUE Lang="tw">從鋼筋地魔身上找回靈珠.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_566_000_D_0">
        <VALUE Lang="tw">根據本洞警察的說法, 鋼筋地魔身上有很特別的靈珠. &#x0D;&#x0A;請仔細檢查一下鋼筋地魔身上所有的物品.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_566_000_P_1">
        <VALUE Lang="tw">交給本洞警察.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_566_000_D_1">
        <VALUE Lang="tw">請把複製靈珠交給本洞的警察.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_567_000">
        <VALUE Lang="tw">尋找零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_567_000">
        <VALUE Lang="tw">趙善雅說需要些在自己搭乘的滑板上面的部分零件。 &#x0D;&#x0A;聽說那些零件可以在本洞的冰冷波動拳王、冰冷美艷陰陽師、憤怒的波動拳王和憤怒的美艷陰陽師身上找得到，希望找到後送給趙善雅 。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_567_000_P_0">
        <VALUE Lang="tw">尋找冰冷波動拳王、冰冷美艷陰陽師、憤怒的波動拳王和憤怒的美艷陰陽師身上的零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_567_000_D_0">
        <VALUE Lang="tw">根據趙善雅的說法冰冷波動拳王、冰冷美艷陰陽師、憤怒的波動拳王和憤怒的美艷陰陽師身上可以找的到零件。請把找到的零件交給趙善雅</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_567_000_P_1">
        <VALUE Lang="tw">請交給趙善雅。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_567_000_D_1">
        <VALUE Lang="tw">請把需要的零件交給趙善雅。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_568_000">
        <VALUE Lang="tw">檢定戰鬥能力 I</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_568_000">
        <VALUE Lang="tw">消除本洞的火魔導士- 李歐3名之後,請向麗娜接受戰鬥能力的檢定.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_568_000_P_0">
        <VALUE Lang="tw">請消除『火魔導士- 李歐』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_568_000_D_0">
        <VALUE Lang="tw">請消除『火魔導士- 李歐』 3名之後,向麗娜接受確認.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_568_000_P_1">
        <VALUE Lang="tw">請向麗娜確認結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_568_000_D_1">
        <VALUE Lang="tw">請向各學院的麗娜接受確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_569_000">
        <VALUE Lang="tw">檢定戰鬥能力 II</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_569_000">
        <VALUE Lang="tw">消除光魔導士- 克萊爾4名之後,請向麗娜接受戰鬥能力的檢定.</VALUE>
