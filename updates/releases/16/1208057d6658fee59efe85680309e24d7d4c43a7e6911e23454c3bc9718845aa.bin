    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2103_000">
        <VALUE Lang="tw">結界認證</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2103_000">
        <VALUE Lang="tw">學院內有著使用終端機設下的特殊結界&#x0D;&#x0A;眾多的人和生物都受到這異常現象的影響，並開始產生突變的狀況。 但在學院內卻沒有受到太大的影響，這都該歸功於結界。&#x0D;&#x0A;如果能從結界處得到認證，可獲得些許的力量。&#x0D;&#x0A;因此，務必要在各建築物所設置的結界上取得認證，並提升能力。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2103_000_P_0">
        <VALUE Lang="tw">『學習2館』終端機測試</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2103_000_D_0">
        <VALUE Lang="tw">請先至『『學習2館』』，並尋找終端機，如果找到請啟動之，以測試是否正常。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2103_000_P_1">
        <VALUE Lang="tw">『學習2館』取得『靈靈珠』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2103_000_D_1">
        <VALUE Lang="tw">為了獲得結界的認證, 請從『學習2館』附近的『小俗辣』那奪回『靈靈珠 2個』。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2103_000_P_2">
        <VALUE Lang="tw">『學習2館』結界認證</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2103_000_D_2">
        <VALUE Lang="tw">利用所取得之『靈靈珠』來獲得結界認證。&#x0D;&#x0A;一定要有次序性的取得結界認證，才能得到力量。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2103_000_P_3">
        <VALUE Lang="tw">『右龍公園』 終端機測驗</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2103_000_D_3">
        <VALUE Lang="tw">位在『右龍公園』設有一台終端機，請試著測試它是否正常運作</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2103_000_P_4">
        <VALUE Lang="tw">『右龍公園』取得『靈靈珠』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2103_000_D_4">
