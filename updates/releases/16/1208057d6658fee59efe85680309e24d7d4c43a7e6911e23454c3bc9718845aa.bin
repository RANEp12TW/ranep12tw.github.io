    <SENTENSE Ver="1" Id="QN_2033_000">
        <VALUE Lang="tw">4th Anniversary Event</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2033_000">
        <VALUE Lang="tw">Thanks for your 4 years loyalty. Get the box to complete the Extra Activity and let use the firework to commemorate our anniversary.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2033_000_P_0">
        <VALUE Lang="tw">Receive 4th Anniversary Gift Box</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2033_000_D_0">
        <VALUE Lang="tw">Receive 4th Anniversary Gift Box</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2035_000">
        <VALUE Lang="tw">Leprechaun&apos;s Request(Repeatable)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2035_000">
        <VALUE Lang="tw">Monsters have taken the Gold Coins which is one of the most precious treasures of Leprechaun. Please help poor Leprechaun by retrieving stolen Gold Coins for him. &#x0D;&#x0A;Press &apos;Details&apos; button for more information.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2035_000_P_0">
        <VALUE Lang="tw">Retrieve the Gold Coins</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2035_000_D_0">
        <VALUE Lang="tw">Leprechaun has promised to repay you for finding 50 Gold Coins. Gold Coins can be found by eliminating monsters which has greenish color. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2035_000_P_1">
        <VALUE Lang="tw">Go See Leprechaun</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2035_000_D_1">
        <VALUE Lang="tw">you have found all 50 of gold coins then, bring it back to Leprechaun NPC for reward</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2061_000">
        <VALUE Lang="tw">Launching Event(Level 100 Achievenment)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2061_000">
        <VALUE Lang="tw">The Grocery Merchant is in charge of guiding new students. . Click the [Details] button for further instructions.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2061_000_P_0">
        <VALUE Lang="tw">Reach Level 100</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2061_000_D_0">
        <VALUE Lang="tw">Reach Level 100</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2081_000">
        <VALUE Lang="tw">Ran World on Style</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2081_000">
        <VALUE Lang="tw">Continuous war has intoxicated the environment and there were too many contaminants left abandoned and we decided to spray antidotes over it for people. However, the antidote had  side effect that caused change of hair color and hair styles. Therefore, Director of Saint Foundation has prepared remedy for students.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2081_000_P_0">
        <VALUE Lang="tw">I want to change my hair style!</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2081_000_D_0">
        <VALUE Lang="tw">Change your hair style as you&apos;ve always wanted!</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2082_000">
        <VALUE Lang="tw">GentleGirl&apos;s Present</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2082_000">
        <VALUE Lang="tw">It&apos;s already summer so let&apos;s forget all the bad memories in the past. Of course I&apos;m not giving away Oblivion Potion for free because I&apos;m afraid it will get rotten.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2082_000_P_0">
        <VALUE Lang="tw">Receives Oblivion Potion.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2082_000_D_0">
        <VALUE Lang="tw">Receives Oblivion Potion.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2095_000">
        <VALUE Lang="tw">前輩的禮物</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2095_000">
        <VALUE Lang="tw">勇校前輩趙善雅為了各位辛苦的學員，送來了全新的腰帶製作書，去找她領取隕石腰帶製作書。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2095_000_P_0">
        <VALUE Lang="tw">達到260等級後去接受確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2095_000_D_0">
        <VALUE Lang="tw">達到260等級後去找學院廣場的趙善雅接受確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2096_000">
        <VALUE Lang="tw">[每日任務] 爭取時間</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2096_000">
        <VALUE Lang="tw">為了治療路西和負傷的忍術部學員，必須爭取時間。處決在巴洞和浮游島佈陣的敵人以爭取一些時間。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2096_000_P_0">
        <VALUE Lang="tw">處決特種突擊兵(少尉)50隻</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2096_000_D_0">
        <VALUE Lang="tw">處決巴洞的特種突擊兵(少尉)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2096_000_P_1">
        <VALUE Lang="tw">處決特種異變傭兵100隻</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2096_000_D_1">
        <VALUE Lang="tw">處決浮游島的特種異變傭兵</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2096_000_P_2">
        <VALUE Lang="tw">處決變種重力人(猛)100隻</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2096_000_D_2">
        <VALUE Lang="tw">處決浮游島的變種重力人(猛)</VALUE>
    </SENTENSE>
