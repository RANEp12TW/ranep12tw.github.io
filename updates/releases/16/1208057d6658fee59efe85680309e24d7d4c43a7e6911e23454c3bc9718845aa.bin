    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2361_000">
        <VALUE Lang="tw">沒有懊悔不斷做壞事的暴徒該讓他們嘗點苦頭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2361_000_P_0">
        <VALUE Lang="tw">除掉暴徒</VALUE>
    </SENTENSE>
