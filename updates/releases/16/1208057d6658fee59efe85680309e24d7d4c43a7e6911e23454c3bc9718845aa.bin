    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2121_000">
        <VALUE Lang="tw">打倒研究員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2121_000">
        <VALUE Lang="tw">根據卡拉賽諾說的，物流管理員因為每天晚上襲擊物流倉庫的這些怪人們搞的很累.請幫忙物流管理員打倒足夠數量的怪物.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2121_000_P_0">
        <VALUE Lang="tw">去找物流管理員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2121_000_D_0">
        <VALUE Lang="tw">請去找物流管理員詢問需要幫忙的事情</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2121_000_P_1">
