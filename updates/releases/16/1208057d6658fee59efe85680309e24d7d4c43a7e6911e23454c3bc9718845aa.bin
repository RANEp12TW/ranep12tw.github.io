        <VALUE Lang="tw">消滅特種偵查傭兵(下士)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2302_000_D_1">
        <VALUE Lang="tw">消滅巴洞特種偵查傭兵(下士)50隻</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2303_000">
        <VALUE Lang="tw">掌握動態 2</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2303_000">
        <VALUE Lang="tw">我們正在掌握敵人動態，請先在巴洞消滅&apos;特種偵查兵(上士)&apos;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2303_000_P_0">
        <VALUE Lang="tw">消滅 特種偵查兵(上士)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2303_000_D_0">
        <VALUE Lang="tw">請消滅巴洞的特種偵查兵(上士)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2303_000_P_1">
        <VALUE Lang="tw">消滅 特種偵查傭兵(上士)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2303_000_D_1">
        <VALUE Lang="tw">請消滅巴洞的特種偵查傭兵(上士)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2304_000">
        <VALUE Lang="tw">建立最後防線(反覆)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2304_000">
        <VALUE Lang="tw">已經掌握進入巴洞的消息。為了阻止他們繼續前往其它地區&#x0D;&#x0A;請幫忙消滅特種偵查兵(少尉)建立最後一道防線</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2304_000_P_0">
        <VALUE Lang="tw">取得特種偵查兵徽章</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2304_000_D_0">
        <VALUE Lang="tw">消滅偵查部隊(偵查兵、偵查傭兵 下士/上士/少尉)蒐集徽章</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2304_000_P_1">
        <VALUE Lang="tw">轉交特種偵查兵徽章</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2304_000_D_1">
        <VALUE Lang="tw">把蒐集到的徽章交給巴洞的學生主任(派遣)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2305_000">
        <VALUE Lang="tw">攔截偵查指令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2305_000">
        <VALUE Lang="tw">有情報顯示特種偵查兵(少尉)身上有偵查指令。請幫忙攔截偵查指令。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2305_000_P_0">
        <VALUE Lang="tw">取得偵查指令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2305_000_D_0">
        <VALUE Lang="tw">消滅特種偵查兵(少尉)取得偵查指令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2305_000_P_1">
        <VALUE Lang="tw">回報結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2305_000_D_1">
        <VALUE Lang="tw">向巴洞學生主任(派遣)回報結果&#x0D;&#x0A;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2306_000">
        <VALUE Lang="tw">轉交偵查指令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2306_000">
        <VALUE Lang="tw">偵查指令有加密無法得知詳細的內容。&#x0A;請交給技術老師協助解讀。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2306_000_P_0">
        <VALUE Lang="tw">轉交偵查指令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2306_000_D_0">
        <VALUE Lang="tw">將偵查指令轉交給巴洞的技術老師(派遣)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2307_000">
        <VALUE Lang="tw">密碼解讀 1</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2307_000">
        <VALUE Lang="tw">打開偵查指令發現和我們使用的加密方式有很大差異不易解讀。&#x0A;解碼工具一定在其他人手上。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2307_000_P_0">
        <VALUE Lang="tw">取得解碼工具</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2307_000_D_0">
        <VALUE Lang="tw">消滅巴洞特種突擊兵、突擊傭兵(下士)蒐集解碼工具</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2307_000_P_1">
        <VALUE Lang="tw">轉交解碼工具</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2307_000_D_1">
        <VALUE Lang="tw">將蒐集到的解碼工具交給技術老師(派遣)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2308_000">
        <VALUE Lang="tw">確保路線 1</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2308_000">
        <VALUE Lang="tw">按照偵查指令描述，敵人的大本營位於湖對面，請確保可以抵達敵人陣營的路線</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2308_000_P_0">
        <VALUE Lang="tw">確保出口1</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2308_000_D_0">
        <VALUE Lang="tw">請消滅 &apos;特種偵查兵(上士)&apos;並確保出口</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2308_000_P_1">
        <VALUE Lang="tw">確保出口2</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2308_000_D_1">
        <VALUE Lang="tw">請消滅 &apos;特種突擊兵(上士)&apos;並確保出口</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2308_000_P_2">
        <VALUE Lang="tw">確保出口3</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2308_000_D_2">
        <VALUE Lang="tw">請消滅 &apos;特種偵查兵(少尉)&apos;並確保出口</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2308_000_P_3">
        <VALUE Lang="tw">確保出口4</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2308_000_D_3">
        <VALUE Lang="tw">請消滅 &apos;特種突擊兵(少尉)&apos;並確保出口</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2309_000">
        <VALUE Lang="tw">回收急救箱(反覆)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2309_000">
        <VALUE Lang="tw">護士的急救箱在巴洞被其它怪物搶走了。&#x0A;幸好有同學幫忙才沒有讓全部的東西被搶走。&#x0A;請幫忙把遺失的急救箱找回來。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2309_000_P_0">
        <VALUE Lang="tw">回收急救箱</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2309_000_D_0">
        <VALUE Lang="tw">消滅特種偵察兵、偵查傭兵 (少尉)蒐集急救箱</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2309_000_P_1">
        <VALUE Lang="tw">轉交急救箱</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2309_000_D_1">
        <VALUE Lang="tw">請把蒐集的急救箱交給巴洞護士(派遣)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2310_000">
        <VALUE Lang="tw">確保路線 2</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2310_000">
        <VALUE Lang="tw">敵人激烈反抗，請突破封鎖線進攻敵人的大本營</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2310_000_P_0">
        <VALUE Lang="tw">突破封鎖線 1</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2310_000_D_0">
        <VALUE Lang="tw">請消滅巴洞的&apos;特種突擊兵(少尉)&apos;並突破防線</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2310_000_P_1">
        <VALUE Lang="tw">突破封鎖線 2</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2310_000_D_1">
        <VALUE Lang="tw">請消滅巴洞的&apos;特種突擊傭兵(少尉)&apos;並突破防線</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2311_000">
        <VALUE Lang="tw">蒐集武器零件 (反覆)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2311_000">
        <VALUE Lang="tw">技術老師(派遣)對敵人使用的武器很感興趣。把蒐集到的武器零件交給技術老師&#x0A;應該對研究有很大的幫助</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2311_000_P_0">
        <VALUE Lang="tw">蒐集武器零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2311_000_D_0">
        <VALUE Lang="tw">消滅特種突擊部隊(突擊兵、突擊傭兵 下士/少尉/上尉)蒐集武器零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2311_000_P_1">
        <VALUE Lang="tw">轉交武器零件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2311_000_D_1">
        <VALUE Lang="tw">請把蒐集到的零件交給技術老師(派遣)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2312_000">
        <VALUE Lang="tw">密碼解讀  2</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2312_000">
        <VALUE Lang="tw">這個偵查指令對先鋒隊應該有很大幫助。&#x0D;&#x0A;請幫忙把解碼的偵查指令交給浮游島的路西安。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2312_000_P_0">
        <VALUE Lang="tw">轉交解碼的偵查指令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2312_000_D_0">
        <VALUE Lang="tw">請把解碼的偵查指令交給浮游島的路西</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2313_000">
        <VALUE Lang="tw">消滅法拉諾瓦-亞斯娜</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2313_000">
        <VALUE Lang="tw">路西看過解碼的指令後認為法拉諾瓦-亞斯娜是非常危險的人物。&#x0D;&#x0A;他希望有人可以協助消滅法拉諾瓦-亞斯娜的任務。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2313_000_P_0">
        <VALUE Lang="tw">消滅法拉諾瓦-亞斯娜</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2313_000_D_0">
        <VALUE Lang="tw">請幫忙消滅巴洞的法拉諾瓦-亞斯娜</VALUE>
    </SENTENSE>
