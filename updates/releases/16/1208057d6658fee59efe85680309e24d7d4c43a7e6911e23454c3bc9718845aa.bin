        <VALUE Lang="tw">傳遞推薦書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_749_000_D_1">
        <VALUE Lang="tw">霸天雲為表示感謝之意,特地寫了一封推薦書給秀娥,請將推薦書拿去給秀娥吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_750_000">
        <VALUE Lang="tw">蘇承日的委託</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_750_000">
        <VALUE Lang="tw">蘇承日說最近在三號發電室附近有感應到熟悉的氣息.請在附近搜尋看看能否發現任何線索</VALUE>
