    <SENTENSE Ver="1" Id="QN_2116_000">
        <VALUE Lang="tw">報告狀況</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2116_000">
        <VALUE Lang="tw">由於囚犯們引起暴動,監獄陷入了危急的狀態,接到委託去通知商洞的警棻.</VALUE>
    </SENTENSE>
