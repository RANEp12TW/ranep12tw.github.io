        <VALUE Lang="tw">把紫晶的眼淚拿給黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_775_000">
        <VALUE Lang="tw">[組隊] 墮落靈魂的蒸發</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_775_000">
        <VALUE Lang="tw">請在30分鐘內消滅10名因為身體實驗而墮落的熾天使</VALUE>
    </SENTENSE>
