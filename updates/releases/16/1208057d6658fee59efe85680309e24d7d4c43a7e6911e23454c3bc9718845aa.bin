    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_776_000">
        <VALUE Lang="tw">[組隊] 勇士的靈魂</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_776_000">
        <VALUE Lang="tw">從黎斯獲得的勇士的心臟提煉之後，就能做出開啟異界之門的鎖匙，請消滅守護異界之門的熾天使米亞，再將魔力的靈魂石交給黎斯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_776_000_P_0">
        <VALUE Lang="tw">消滅熾天使米亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_776_000_D_0">
        <VALUE Lang="tw">消滅熾天使米亞就可以獲得魔力的靈魂石</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_776_000_P_1">
