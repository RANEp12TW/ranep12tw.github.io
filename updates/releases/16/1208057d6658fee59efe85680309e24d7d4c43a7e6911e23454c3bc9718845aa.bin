    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3005_000">
        <VALUE Lang="tw">結界認證</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3005_000">
        <VALUE Lang="tw">在學院內利用終端機所設置的特殊結界正在變化&#x0D;&#x0A;不僅許多人和生物受到影響引發變形, 在學院內所受到的影響較小也是因為結界的緣故吧&#x0D;&#x0A;萬一從這些結界取得認證的話, 可以分到一點力量&#x0D;&#x0A;所以請從學院內的許多建築物和設施所設置的結界開始, 取得認證提高能力</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3005_000_P_0">
        <VALUE Lang="tw">學習2館 終端機測驗</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3005_000_D_0">
        <VALUE Lang="tw">確定[學習2館]的位置以及所設置的終端機是否正常運作，試試開機考試。</VALUE>
    </SENTENSE>
