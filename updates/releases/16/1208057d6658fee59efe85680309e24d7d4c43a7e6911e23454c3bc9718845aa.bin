    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2358_000_D_1">
        <VALUE Lang="tw">請調查希望公園步道周邊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2358_000_P_2">
        <VALUE Lang="tw">調查內容報告</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2358_000_D_2">
        <VALUE Lang="tw">調查的內容請向&quot;忍術部長&quot;報告</VALUE>
    </SENTENSE>
