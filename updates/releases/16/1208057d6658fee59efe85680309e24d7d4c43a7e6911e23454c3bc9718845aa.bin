    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2357_000_P_2">
        <VALUE Lang="tw">確認發信地調查結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2357_000_D_2">
        <VALUE Lang="tw">從’超能部 指導教師‘確認委託結果.</VALUE>
    </SENTENSE>
