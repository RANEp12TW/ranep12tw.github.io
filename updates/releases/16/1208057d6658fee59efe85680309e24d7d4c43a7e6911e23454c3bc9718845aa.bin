        <VALUE Lang="tw">聖財團秘密任務 1</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2317_000">
        <VALUE Lang="tw">派遣員接受在聖財團執行某個秘密任務。請協助派遣員一起完成任務</VALUE>
    </SENTENSE>
