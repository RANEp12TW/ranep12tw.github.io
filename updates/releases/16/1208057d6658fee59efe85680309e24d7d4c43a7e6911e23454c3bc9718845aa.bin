    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_015_000">
        <VALUE Lang="tw">護士的請託_聖門</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_015_000">
        <VALUE Lang="tw">『護士[聖門學院]』為了治療受傷的學生，因此非常忙碌。但不幸的是『病歷表用紙』都用光了。 &#x0D;&#x0A;因此無法進行文書作業，因此提出協助到商店購買的請求。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_015_000_P_0">
        <VALUE Lang="tw">取得『病歷表用紙』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_015_000_D_0">
        <VALUE Lang="tw">找尋『福利社販售員』，並取得『病歷表用紙』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_015_000_P_1">
        <VALUE Lang="tw">傳遞『病歷表用紙』</VALUE>
    </SENTENSE>
