    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2359_000">
        <VALUE Lang="tw">調查中從居民那裡探聽到有關這個區域的資訊。請跟那位女士打聽現在的情況</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2359_000_P_0">
        <VALUE Lang="tw">與居民對話</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2359_000_D_0">
        <VALUE Lang="tw">與居民對話並蒐集情報</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2360_000">
        <VALUE Lang="tw">暴力集團的肆虐</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2360_000">
        <VALUE Lang="tw">剝削居民的&quot;暴力集團&quot;又開始胡作非為了。快點除掉他們，懲罰他們到目前為止犯下的罪</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2360_000_P_0">
