        <VALUE Lang="tw">轉交攻擊指令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2315_000_D_1">
        <VALUE Lang="tw">請把攻擊指令交給路西</VALUE>
    </SENTENSE>
