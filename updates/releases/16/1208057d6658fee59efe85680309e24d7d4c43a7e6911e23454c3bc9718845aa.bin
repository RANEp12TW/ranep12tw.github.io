    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_632_000">
        <VALUE Lang="tw">請掃除炸彈小丑</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_632_000">
        <VALUE Lang="tw">這次的課題是掃除主要出現在聖門洞公園附近的炸彈小丑. &#x0D;&#x0A;在市中心可以看到的敵人當中,其力量是屬於較強的一方, 所以要格外的小心才可以. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_632_000_P_0">
