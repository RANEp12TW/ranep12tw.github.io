    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2343_000_D_0">
        <VALUE Lang="tw">請把攻擊商家的殘暴商人制伏後帶過來</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2343_000_P_1">
