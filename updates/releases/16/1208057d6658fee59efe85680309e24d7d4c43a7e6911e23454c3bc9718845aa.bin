    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3004_000_P_5">
        <VALUE Lang="tw">『右龍公園』結界認證</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3004_000_D_5">
        <VALUE Lang="tw">利用所取得之『靈靈珠』來獲得結界認證。&#x0D;&#x0A;一定要有次序性的取得結界認證，才能得到力量。</VALUE>
    </SENTENSE>
