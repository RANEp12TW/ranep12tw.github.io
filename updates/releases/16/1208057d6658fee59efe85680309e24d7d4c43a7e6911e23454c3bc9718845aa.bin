    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_322_000_P_1">
        <VALUE Lang="tw">找尋商洞書店</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_322_000_D_1">
        <VALUE Lang="tw">依著GPS的標示之118, 105位置移動,並確認商洞書店的位置</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_322_000_P_2">
        <VALUE Lang="tw">找尋商洞4號隧道</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_322_000_D_2">
        <VALUE Lang="tw">依著GPS指示的133, 117位置移動,並確認商洞4號隧道的位置</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_322_000_P_3">
        <VALUE Lang="tw">找尋綜合運動場</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_322_000_D_3">
        <VALUE Lang="tw">依著GPS標示的96, 143位置移動,並確認綜合運動場的位置</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_322_000_P_4">
        <VALUE Lang="tw">找尋被埋葬的東西</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_322_000_D_4">
        <VALUE Lang="tw">依著GPS所標示的113, 180位置移動,找出被埋葬的東西</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_322_000_P_5">
        <VALUE Lang="tw">傳達時光膠囊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_322_000_D_5">
        <VALUE Lang="tw">若是依著指示移動找到時光膠囊的話,就回到氣功道場交付東西</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_323_000">
        <VALUE Lang="tw">警察局報到</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_323_000">
        <VALUE Lang="tw">從道場的師傅那,收到警察局呼叫的訊息&#x0D;&#x0A;去找附近的商洞警察局&#x0D;&#x0A;按下&apos;詳情&apos;鈕的話,可以看到更多訊息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_323_000_P_0">
        <VALUE Lang="tw">找尋商洞警局</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_323_000_D_0">
        <VALUE Lang="tw">隨著道場師傅的指示,去找商洞警察局看他們有什麼需求</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_324_000">
        <VALUE Lang="tw">信件回收</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_324_000">
        <VALUE Lang="tw">警察說有重要的信件，麻煩我們去取回&#x0D;&#x0A;因為治安不良的影響,人手變得相當不夠,請幫助我們&#x0D;&#x0A;按下&apos;詳情&apos;鈕的話,可以看到更多訊息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_324_000_P_0">
        <VALUE Lang="tw">回收信件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_324_000_D_0">
        <VALUE Lang="tw">看到滑輪高手們拿著信件&#x0D;&#x0A;從他們那邊回收被偷的信件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_324_000_P_1">
        <VALUE Lang="tw">送達信件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_324_000_D_1">
        <VALUE Lang="tw">如果成功回收信件的話,就回去商洞警察局,把東西歸還</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_324_000_P_2">
        <VALUE Lang="tw">去找信件碎片</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_324_000_D_2">
        <VALUE Lang="tw">回收的信件並不是之前全部的一整張&#x0D;&#x0A;不把它們集中起來對的話,有可能會誤解內容,請一定要把剩下的紙片找回來</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_324_000_P_3">
        <VALUE Lang="tw">提出信件紙片</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_324_000_D_3">
        <VALUE Lang="tw">如果成功找回信件的6份紙片,就回去商洞警察局,把東西歸還</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_325_000">
        <VALUE Lang="tw">警察的委託</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_325_000">
        <VALUE Lang="tw">從警察局那裡接到委託 希望蒐集關於不久前行蹤不明的孩子們的情報&#x0D;&#x0A;雖然警察的委託是有點困難,但還是請盡力蒐集到最多的情報&#x0D;&#x0A;按下&apos;詳情&apos;鈕的話,可以看到更多訊息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_325_000_P_0">
        <VALUE Lang="tw">去探訪影像專家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_325_000_D_0">
        <VALUE Lang="tw">是否有失蹤小孩的消息,去見出租店的影像專家並向他請教</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_325_000_P_1">
        <VALUE Lang="tw">去探訪清潔工人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_325_000_D_1">
        <VALUE Lang="tw">去見商洞市民廣場的清潔工人,詢問他是否有失蹤小孩的消息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_325_000_P_2">
        <VALUE Lang="tw">去探訪賣熱狗的小販</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_325_000_D_2">
        <VALUE Lang="tw">去找商洞市民廣場的熱狗販賣員, 詢問他是否有失蹤小孩的消息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_325_000_P_3">
        <VALUE Lang="tw">傳達意見書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_325_000_D_3">
        <VALUE Lang="tw">探訪都結束之後,回到警察局提出意見書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_325_000_P_4">
        <VALUE Lang="tw">去拿到復原磁碟</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_325_000_D_4">
        <VALUE Lang="tw">利用警察的資料庫,想要理出點頭緒&#x0D;&#x0A;但是因為程式錯誤的影響,就沒有辦法使用終端機&#x0D;&#x0A;為了要重新設定所以需要備用磁碟,去玄巖學院拿</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_325_000_P_5">
        <VALUE Lang="tw">送回復原磁碟</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_325_000_D_5">
        <VALUE Lang="tw">拿到的磁碟交給警察局,使警察署的終端機能恢復正常化</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_325_000_P_6">
        <VALUE Lang="tw">確認脫窗可滷</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_325_000_D_6">
        <VALUE Lang="tw">不久前又接到有大狗銜著小孩的衣服的情報&#x0D;&#x0A;也許跟小孩子們下落不明的案子有關係,請前往確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_325_000_P_7">
        <VALUE Lang="tw">將取的的東西交回警察局</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_325_000_D_7">
        <VALUE Lang="tw">抓到脫窗可滷 並把東西交給警察局&#x0D;&#x0A;這分明就和孩子們下落不明的事件有關聯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_326_000">
        <VALUE Lang="tw">調查實驗體</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_326_000">
        <VALUE Lang="tw">在脫窗可滷的口水裡頭找到的DNA和失蹤的孩子其中ㄧ名的DNA相同,拿變種相近的實驗和神聖財團的關係就可以確認,因此我想有必要知道所謂實驗體倒底是什麼&#x0D;&#x0A;去找老師們問清楚那是怎麼樣的情況&#x0D;&#x0A;按下&apos;詳情&apos;鈕的話,可以看到更多訊息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_326_000_P_0">
        <VALUE Lang="tw">去見聖門學院的學生主任</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_326_000_D_0">
        <VALUE Lang="tw">去找神聖財團的第一個學院也就是聖門學院,跟學生主任老師確認事實</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_326_000_P_1">
        <VALUE Lang="tw">去見技術老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_326_000_D_1">
        <VALUE Lang="tw">去見聖門洞學院交叉路附近駐守的聖門學院技術老師,問關於實驗體的情報</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_326_000_P_2">
        <VALUE Lang="tw">去見物理老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_326_000_D_2">
        <VALUE Lang="tw">去見駐守在聖門圓環的聖門學院物理老師,問關於實驗體的情報</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_326_000_P_3">
        <VALUE Lang="tw">回去商洞警察局</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_326_000_D_3">
        <VALUE Lang="tw">雖然想要確認,但就是得不到一定程度以上的情報,回到商洞警察局 在警察資料庫裡看能不能得到什麼</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_327_000">
        <VALUE Lang="tw">取得食材</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_327_000">
        <VALUE Lang="tw">賣熱狗的小販說所有的食物材料都被偷走了&#x0D;&#x0A;沒有材料的話,就沒辦法做食物去賣,所以請找到食材&#x0D;&#x0A;按下&apos;詳情&apos;鈕的話,可以看到更多訊息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_327_000_P_0">
        <VALUE Lang="tw">找尋食物材料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_327_000_D_0">
        <VALUE Lang="tw">滑輪小子們為了要作熱狗,所以攜帶著材料&#x0D;&#x0A;從他們那邊找回材料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_327_000_P_1">
        <VALUE Lang="tw">交回材料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_327_000_D_1">
        <VALUE Lang="tw">如果成功找回熱狗的食材,請轉達給賣熱狗的小販</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_328_000">
        <VALUE Lang="tw">收集回收型垃圾</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_328_000">
        <VALUE Lang="tw">聽說有把從清潔工人那裡搶過來的垃圾亂灑在街上的傢伙&#x0D;&#x0A;從那群人身上找回垃圾,街道上就不會變髒了&#x0D;&#x0A;按下&quot;詳情&quot;鈕的話,可以看到更多訊息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_328_000_P_0">
        <VALUE Lang="tw">尋找資源回收的垃圾</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_328_000_D_0">
        <VALUE Lang="tw">聽說滑輪小子、G奶七仔、滑輪高手，把垃圾亂丟在街道上請向他們奪回垃圾</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_328_000_P_1">
        <VALUE Lang="tw">交還垃圾</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_328_000_D_1">
        <VALUE Lang="tw">如果成功回收垃圾的話,請轉達給商洞市民公園的清潔工人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_329_000">
        <VALUE Lang="tw">蒐集玻璃瓶做資源回收</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_329_000">
        <VALUE Lang="tw">聽說市民們的活動越來越少,資源回收也越來越少&#x0D;&#x0A;集中玻璃瓶來幫助收集再利用物品&#x0D;&#x0A;按下&apos;詳情&apos;鈕的話,可以看到更多訊息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_329_000_P_0">
        <VALUE Lang="tw">搶回再利用玻璃瓶</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_329_000_D_0">
        <VALUE Lang="tw">脫窗可滷和浩呆想要把可以再利用的玻璃瓶打破&#x0D;&#x0A;從他們那邊搶回玻璃瓶</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_329_000_P_1">
        <VALUE Lang="tw">交回玻璃瓶</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_329_000_D_1">
        <VALUE Lang="tw">成功回收玻璃瓶的話,請轉達給商洞市民公園的冰淇淋小販</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_330_000">
        <VALUE Lang="tw">回收書籍(一)_格鬥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_330_000">
        <VALUE Lang="tw">買回來的書籍被不良份子們搶走了&#x0D;&#x0A;請把書再找回來&#x0D;&#x0A;按下&apos;詳情&apos;鈕的話,可以看到更多訊息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_330_000_P_0">
        <VALUE Lang="tw">『回收書籍』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_330_000_D_0">
        <VALUE Lang="tw">聽說買來的書被『拐子手』搶走了&#x0D;&#x0A;從他們那邊回收書籍&#x0D;&#x0A;書的標題是『線上遊戲程式設計指南』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_330_000_P_1">
        <VALUE Lang="tw">『交還書籍』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_330_000_D_1">
        <VALUE Lang="tw">找回『線上遊戲程式設計指南』的話,請交給在商洞書店前面等著的『鄭課長』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_331_000">
        <VALUE Lang="tw">回收書籍(一)_劍道</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_331_000">
        <VALUE Lang="tw">買回來的書籍被不良份子們搶走了&#x0D;&#x0A;請把書再找回來&#x0D;&#x0A;按下&apos;詳情&apos;鈕的話,可以看到更多訊息</VALUE>
