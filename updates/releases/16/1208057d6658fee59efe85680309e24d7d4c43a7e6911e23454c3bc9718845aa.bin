    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_501_000_D_0">
        <VALUE Lang="tw">去見向財團申訴的聖門洞作業班長,聽取詳細的申訴內容. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_501_000_P_1">
        <VALUE Lang="tw">尋找高爾夫球桿</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_501_000_D_1">
        <VALUE Lang="tw">因作業班長的請求, 到商洞高爾夫球場收集高爾夫球桿. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_501_000_P_2">
        <VALUE Lang="tw">去見聖門洞作業班長</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_501_000_D_2">
        <VALUE Lang="tw">將高爾夫球桿交給聖門洞作業班長. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_501_000_P_3">
        <VALUE Lang="tw">去見特遣人員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_501_000_D_3">
        <VALUE Lang="tw">再去找特遣人員,了解聖財團的社區服務情形. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_502_000">
        <VALUE Lang="tw">財團背後的真實</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_502_000">
        <VALUE Lang="tw">依據聖財團做社會服務所做的紀錄, 去訪問周圍的人是否屬實.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_502_000_P_0">
        <VALUE Lang="tw">去找聖門洞的物理老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_502_000_D_0">
        <VALUE Lang="tw">去找聖門洞的物理老師, 詢問有關聖財團的社區服務狀況. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_502_000_P_1">
        <VALUE Lang="tw">去找圓環的護士</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_502_000_D_1">
        <VALUE Lang="tw">去找在圓環的護士, 詢問一下對聖財團的印象如何. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_502_000_P_2">
        <VALUE Lang="tw">去找虎令學院的魂靈</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_502_000_D_2">
        <VALUE Lang="tw">去找因為異變而受影響的虎令學院魂靈, 盡力的去了解一下聖財團.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_502_000_P_3">
        <VALUE Lang="tw">去找虎令學院的學生主任</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_502_000_D_3">
        <VALUE Lang="tw">去找虎令學院的學生主任,去確認聖財團的社區服務情形. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_502_000_P_4">
        <VALUE Lang="tw">去找中洞的武器店長</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_502_000_D_4">
        <VALUE Lang="tw">把在虎令學院拿到與人體實驗有關的東西, 送給中洞的武器店長看看, 確認一下相關資料. 螃</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_503_000">
        <VALUE Lang="tw">詭異的旋律</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_503_000">
        <VALUE Lang="tw">請到聖財團去確認, 在虎令學院所收集到的生體實驗資料 , 是否屬實.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_503_000_P_0">
        <VALUE Lang="tw">去找聖財團前面的老頭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_503_000_D_0">
        <VALUE Lang="tw">詢問能夠進入聖財團的方法. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_503_000_P_1">
        <VALUE Lang="tw">去找綜合碼頭的老人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_503_000_D_1">
        <VALUE Lang="tw">進入聖財團,需要經過雙重保全程序, 第一要移植晶片, 因此先要去找綜合碼頭的老人. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_503_000_P_2">
        <VALUE Lang="tw">取回晶片</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_503_000_D_2">
        <VALUE Lang="tw">請到青基地3F去找鐵頭取得晶片</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_503_000_P_3">
        <VALUE Lang="tw">去找綜合碼頭的老人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_503_000_D_3">
        <VALUE Lang="tw">把手中的晶片交給老人,請他幫忙移植. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_503_000_P_4">
        <VALUE Lang="tw">去找影像專家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_503_000_D_4">
        <VALUE Lang="tw">進入本部,需要經過雙重保全程序中,第二步驟是需要辨識聲音, 因此請去找商洞的影像專家. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_503_000_P_5">
        <VALUE Lang="tw">去找聖財團前面的老頭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_503_000_D_5">
        <VALUE Lang="tw">通過了保全程序,請到聖財團前面見老頭,聽取建議. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_503_000_P_6">
        <VALUE Lang="tw">請到聖財團入口處</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_503_000_D_6">
        <VALUE Lang="tw">請到聖財團入口處,讓保全程序自動進行. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_504_000">
        <VALUE Lang="tw">進入聖財團</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_504_000">
        <VALUE Lang="tw">通過了所有的保全程序, 請進入聖財團1F. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_504_000_P_0">
        <VALUE Lang="tw">請進入聖財團內部. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_504_000_D_0">
        <VALUE Lang="tw">因為通過了所有的保全程序, 請進入聖財團1F. </VALUE>
    </SENTENSE>
