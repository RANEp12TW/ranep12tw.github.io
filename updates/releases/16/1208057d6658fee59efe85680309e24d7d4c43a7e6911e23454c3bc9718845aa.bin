        <VALUE Lang="tw">回報結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2313_000_D_1">
        <VALUE Lang="tw">請向路西回報結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2314_000">
        <VALUE Lang="tw">達成225級</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2314_000">
        <VALUE Lang="tw">持續成長才不會辜負大家的期望。&#x0A;成長至225等級後去找巴洞的學生主任(派遣)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2314_000_P_0">
        <VALUE Lang="tw">回報完成225等級</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2314_000_D_0">
        <VALUE Lang="tw">請找巴洞學生主任(派遣)回報完成指定等級任務</VALUE>
    </SENTENSE>
