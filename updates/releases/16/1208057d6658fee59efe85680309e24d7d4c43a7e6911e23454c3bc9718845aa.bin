    <SENTENSE Ver="1" Id="QN_621_000">
        <VALUE Lang="tw">請掃除滴一滴血</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_621_000">
        <VALUE Lang="tw">不同於過去 &#x0D;&#x0A;現在需要培養可以對付所有的領域和所有的攻擊的能力.&#x0D;&#x0A;雖然學生只需要做修練就可以,但是現在的情況不是這樣,在對抗學院周圍的怪物 ,並同時一起做修練的方法比較好,雖然開始有點困難,希望盡力掃除怪物.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_621_000_P_0">
        <VALUE Lang="tw">請掃除滴一滴血</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_621_000_D_0">
        <VALUE Lang="tw">請掃除在學院正門前面妨礙學生通行的滴一滴血.</VALUE>
