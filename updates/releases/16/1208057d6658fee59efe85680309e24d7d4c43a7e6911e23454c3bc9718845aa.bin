        <VALUE Lang="tw">回去找路西</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2096_000_D_3">
        <VALUE Lang="tw">去找浮游島的路西接受確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2098_000">
        <VALUE Lang="tw">New challenge</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2098_000">
        <VALUE Lang="tw">Reached the 100LV, Ready for New challenge.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2098_000_P_0">
        <VALUE Lang="tw">Meet Extreme Counselor in Market place.</VALUE>
