    <SENTENSE Ver="1" Id="QN_2128_000">
        <VALUE Lang="tw">殲滅怪物</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2128_000">
        <VALUE Lang="tw">只要幫霸天雲殲滅附近的怪物,就可獲得一些非常實用的裝備.請依序打倒3隻漁夫,5隻焊接技師,7隻殘暴水手,10隻殘酷光頭猛男後,再找霸天雲領取獎勵吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2128_000_P_0">
        <VALUE Lang="tw">打倒漁夫</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2128_000_D_0">
        <VALUE Lang="tw">請打倒在共用倉庫附近出沒的3隻漁夫</VALUE>
    </SENTENSE>
