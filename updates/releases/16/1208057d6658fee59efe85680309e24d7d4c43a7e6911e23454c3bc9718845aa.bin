        <VALUE Lang="tw">凝聚分散的力量</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_773_000">
        <VALUE Lang="tw">請說出有關黎斯去見卡拉賽諾的消息，以及最近發生的事</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_773_000_P_0">
        <VALUE Lang="tw">去找卡拉賽諾</VALUE>
    </SENTENSE>
