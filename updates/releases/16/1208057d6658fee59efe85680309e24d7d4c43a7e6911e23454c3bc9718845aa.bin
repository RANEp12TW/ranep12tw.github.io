    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2318_000">
        <VALUE Lang="tw">聖財團機密任務2</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2318_000">
        <VALUE Lang="tw">聖財團機密任務是尋找變種生物組織樣本，目的是為了要進行敵人變種生物的研究。&#x0A;請幫忙派遣人員繼續完成機密任務。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2318_000_P_0">
        <VALUE Lang="tw">採集變種生物組織樣本</VALUE>
    </SENTENSE>
