        <VALUE Lang="tw">[Daily limited] Help me</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3119_000">
        <VALUE Lang="tw">Help Confession Man who is experiencing a one-sided love to confess his love. Let&apos;s talk with him to find out how we can help.</VALUE>
    </SENTENSE>
