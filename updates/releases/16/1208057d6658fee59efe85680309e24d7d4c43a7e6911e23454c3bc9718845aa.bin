        <VALUE Lang="tw">派遣人員的下落</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2316_000">
        <VALUE Lang="tw">為了能盡快連絡聖財團請幫忙尋找派遣人員的下落，傳達路西所說過的內容。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2316_000_P_0">
        <VALUE Lang="tw">尋找派遣人員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2316_000_D_0">
        <VALUE Lang="tw">幫忙把路西交代的事情轉述給派遣人員</VALUE>
    </SENTENSE>
