    <SENTENSE Ver="1" Id="QN_3007_000">
        <VALUE Lang="tw">新生的秘密</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3007_000">
        <VALUE Lang="tw">組合八卦星時遇到蘇承日,從他的口中聽到了有關新生的祕密,&#x0D;&#x0A;請去找老師確認一下是否真有其事,&#x0D;&#x0A;這可能是解決異界的問題之前,先要去處理的問題.&#x0D;&#x0A;按&quot;詳情&quot;按鈕,可以看到輔助性的附加內容.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3007_000_P_0">
        <VALUE Lang="tw">尋找聖財團意見表相關資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3007_000_D_0">
        <VALUE Lang="tw">在地下實驗室幫忙找一下蘇承日看到的聖財團意見書和相關的舊資料.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3007_000_P_1">
        <VALUE Lang="tw">與學生主任[聖門]進行對話</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3007_000_D_1">
        <VALUE Lang="tw">去找學生主任[聖門]確認收集到的資料.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3007_000_P_2">
        <VALUE Lang="tw">與忍術部指導老師進行對話</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_3007_000_D_2">
        <VALUE Lang="tw">去找忍術部指導老師確認資料.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_3007_000_P_3">
        <VALUE Lang="tw">與忍術部部長進行對話 </VALUE>
    </SENTENSE>
