    <SENTENSE Ver="1" Id="QN_1201_000">
        <VALUE Lang="tw">達成120級</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1201_000">
        <VALUE Lang="tw">再過不久就會進入藍色區域這個地方除了碼頭之外，還有一些勁敵，再者也沒有人可以幫助學生。 &#x0D;&#x0A;學生主任有特別拜託該區域前的警察，多多給予協助。因為警察不會陪同進入此區域，他們只會協助學生加強訓練。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1201_000_P_0">
        <VALUE Lang="tw">達成120級</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1201_000_D_0">
        <VALUE Lang="tw">請先具備進入區域的條件。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1201_000_P_1">
        <VALUE Lang="tw">打退『殘酷光頭猛男』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1201_000_D_1">
        <VALUE Lang="tw">進入區域內會看到很多從未看到過的怪。第一項訓練科目就是要具備能夠抵擋他們的能力。&#x0D;&#x0A;請驅逐藍色區域內的『殘酷光頭猛男』。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1201_000_P_2">
        <VALUE Lang="tw">打退『賊頭槍手』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1201_000_D_2">
        <VALUE Lang="tw">第二項訓練科目。&#x0D;&#x0A;請驅逐在藍色區域出沒的『賊頭槍手』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1201_000_P_3">
        <VALUE Lang="tw">向警察報告</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1201_000_D_3">
        <VALUE Lang="tw">如果已完成所有的訓練科目,請向警察報告.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1202_000">
        <VALUE Lang="tw">找尋嫌犯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1202_000">
        <VALUE Lang="tw">未知的老頭有件包袱被偷走了 。 因為包袱裡的東西對老頭非常重要，因此老頭希望能幫他找回他的包袱。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1202_000_P_0">
        <VALUE Lang="tw">找尋偷竊者，並找回『古書籍』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1202_000_D_0">
        <VALUE Lang="tw">根據老頭說包袱好像是被拿著海鮮的人給搶走。 &#x0D;&#x0A;請到碼頭附近找出這些人，請搶回『古書籍』。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1202_000_P_1">
        <VALUE Lang="tw">找回剩餘物品</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1202_000_D_1">
        <VALUE Lang="tw">漁夫將包袱打開並拿走『古書籍』，其他的部分被『焊接技師』拿走了。請找尋『焊接技師』並取回其餘物品。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1202_000_P_2">
        <VALUE Lang="tw">找回最後物品</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1202_000_D_2">
        <VALUE Lang="tw">『焊接技師』只有拿走舊書，其餘的東西被『警棍賊頭』給拿走了。 請找尋『警棍賊頭』並搶回其他的物品。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1202_000_P_3">
        <VALUE Lang="tw">將物品還給老頭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1202_000_D_3">
        <VALUE Lang="tw">請將找回的物品還給老頭。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1203_000">
        <VALUE Lang="tw">找尋證物</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1203_000">
        <VALUE Lang="tw">消失在青基地的學生，不久前成為屍體。 警察為了調查這件事情想要進入區域，但是因為某種奇特的力量導致他們無法接近，可否代替警察找尋一些證物。&#x0D;&#x0A;(學生消失在該區域 1樓內側的冰庫。)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1203_000_P_0">
        <VALUE Lang="tw">找尋第一波證據資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1203_000_D_0">
        <VALUE Lang="tw">冰庫某處會有一些可佐證的資料.請將資料找回.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1203_000_P_1">
        <VALUE Lang="tw">找尋第二波證據資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1203_000_D_1">
        <VALUE Lang="tw">冰庫某處會有一些可佐證的資料。請將資料找回。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1203_000_P_2">
        <VALUE Lang="tw">找尋第三波證據資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1203_000_D_2">
        <VALUE Lang="tw">冰庫某處會有一些可佐證的資料。請將資料找回。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1203_000_P_3">
        <VALUE Lang="tw">交給警察</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1203_000_D_3">
        <VALUE Lang="tw">請將收集到的資料交給警察</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1204_000">
        <VALUE Lang="tw">找尋救急用藥品</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1204_000">
        <VALUE Lang="tw">虎令學院的結界被破壞後，就開始有很多的學生受傷。 因此對於藥品的需求就比其他學院多，但目前呈現供不應求的狀況，目前最快的方法為前往虎令學院地下 1樓找尋瘋狂護士長來補所需的藥品。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1204_000_P_0">
        <VALUE Lang="tw">前往虎令本館B1</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1204_000_D_0">
        <VALUE Lang="tw">為了找尋『瘋狂護士長』，請到地下1樓</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1204_000_P_1">
        <VALUE Lang="tw">取得藥品</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1204_000_D_1">
        <VALUE Lang="tw">請向『瘋狂護士長』取得緊急要用的藥品</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1204_000_P_2">
        <VALUE Lang="tw">交給『護士』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1204_000_D_2">
        <VALUE Lang="tw">請將藥品放到虎令學院1樓『護士』的身邊。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1205_000">
        <VALUE Lang="tw">通過3號隧道</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1205_000">
        <VALUE Lang="tw">隧道的慘狀猶如商洞隧道一般,幾乎被禽獸佔領. 為了要通過隧道,所以要有我們比他們強的意識才行.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1205_000_P_0">
        <VALUE Lang="tw">通過隧道</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1205_000_D_0">
        <VALUE Lang="tw">隧道內的重要出口都被怪給擋住，一定要表現出 &apos;強悍&apos;才能從隧道中出來。請在20分鐘內通過3號隧道。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1206_000">
        <VALUE Lang="tw">懸賞逃犯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1206_000">
        <VALUE Lang="tw">請逮捕突然開槍掃射同伴並逃跑的覺醒的機械大大.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1206_000_P_0">
        <VALUE Lang="tw">逮捕『覺醒的機械大大』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1206_000_D_0">
        <VALUE Lang="tw">請逮捕開槍掃射同伴的『覺醒的機械大大』。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1207_000">
        <VALUE Lang="tw">找尋失蹤者</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1207_000">
        <VALUE Lang="tw">在發生事故後，有人報案說要找失蹤的小孩。請協助警察的搜索，並到中洞找尋孩童的線索。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1207_000_P_0">
        <VALUE Lang="tw">找尋線索</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1207_000_D_0">
        <VALUE Lang="tw">剛剛收到孩童失蹤的報案。&#x0D;&#x0A;請以地毯式的搜索方式搜索中洞廣場附近。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1207_000_P_1">
        <VALUE Lang="tw">再次找尋線索</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1207_000_D_1">
        <VALUE Lang="tw">周圍應該還會有一些線索，請再找找看。&#x0D;&#x0A;請以地毯式的搜索方式搜索中洞廣場附近。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1207_000_P_2">
        <VALUE Lang="tw">還要再找一些線索</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1207_000_D_2">
        <VALUE Lang="tw">目前的資訊還是不足，請再仔細的找找看。&#x0D;&#x0A;請以地毯式的搜索方式搜索中洞廣場附近。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1207_000_P_3">
        <VALUE Lang="tw">將結果報給商洞警察局</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1207_000_D_3">
        <VALUE Lang="tw">已確認失蹤孩童已經死亡，請將這個訊息告知商洞的警察局。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1208_000">
        <VALUE Lang="tw">懸賞逃犯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1208_000">
        <VALUE Lang="tw">請協助逮捕殘害市民和搶走金飾的搖滾台客</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1208_000_P_0">
        <VALUE Lang="tw">逮捕『搖滾台客』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1208_000_D_0">
        <VALUE Lang="tw">已確定要逮捕對市民施暴並奪取財物的『搖滾台客』。&#x0D;&#x0A;消息指出，『搖滾台客』正往中洞逃走。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1209_000">
        <VALUE Lang="tw">懸賞逃犯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1209_000">
        <VALUE Lang="tw">請協助逮捕殘害市民和搶走金飾的派遣的嘻哈嗆妹</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1209_000_P_0">
        <VALUE Lang="tw">逮捕『派遣的嘻哈嗆妹』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1209_000_D_0">
        <VALUE Lang="tw">已確定要逮捕對市民施暴並奪取財物的『派遣的嘻哈嗆妹』。&#x0D;&#x0A;消息指出，『派遣的嘻哈嗆妹』正往中洞逃走。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1210_000">
        <VALUE Lang="tw">回收偽造證明書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1210_000">
        <VALUE Lang="tw">發現有人使用偽造證明書。 從殺手身上取得證明書。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1210_000_P_0">
        <VALUE Lang="tw">搶回偽造證明書</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1210_000_D_0">
        <VALUE Lang="tw">在中洞目擊到使用偽造證明書的人，請逮捕後搶回證明書並焚燒之。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1211_000">
        <VALUE Lang="tw">回收偽鈔</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1211_000">
        <VALUE Lang="tw">發現有人使用偽鈔。 從殺手身上取得偽鈔。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1211_000_P_0">
        <VALUE Lang="tw">搶回10張偽鈔</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1211_000_D_0">
        <VALUE Lang="tw">在中洞目擊到使用偽鈔書的人，請逮捕後搶回偽鈔並焚燒之。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1212_000">
        <VALUE Lang="tw">懸賞逃犯</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1212_000">
        <VALUE Lang="tw">請協助逮捕殘害市民和搶走金飾的勁辣美魔女</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1212_000_P_0">
        <VALUE Lang="tw">逮捕『勁辣美魔女』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1212_000_D_0">
        <VALUE Lang="tw">已確定要逮捕對市民施暴並奪取財物的『勁辣美魔女』&#x0D;&#x0A;消息指出『勁辣美魔』正往中洞逃走。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1213_000">
        <VALUE Lang="tw">傳遞消息_聖門</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1213_000">
        <VALUE Lang="tw">回到好久沒回去的的學院，並將中洞的狀況告訴他們。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1213_000_P_0">
        <VALUE Lang="tw">找尋各自所屬學校的學生主任</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1213_000_D_0">
        <VALUE Lang="tw">好久沒有跟聖門的學生主任聯絡，也請順便將中洞的狀況也告訴他。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1214_000">
        <VALUE Lang="tw">傳遞消息_玄巖</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1214_000">
        <VALUE Lang="tw">回到好久沒回去的的學院，並將中洞的狀況告訴他們。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1214_000_P_0">
        <VALUE Lang="tw">找尋各自所屬學校的學生主任</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1214_000_D_0">
        <VALUE Lang="tw">好久沒有跟玄嚴的學生主任聯絡，也請順便將中洞的狀況也告訴他。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1215_000">
        <VALUE Lang="tw">傳遞消息_鳳凰</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1215_000">
        <VALUE Lang="tw">回到好久沒回去的的學院，並將中洞的狀況告訴他們。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1215_000_P_0">
        <VALUE Lang="tw">找尋各自所屬學校的學生主任</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1215_000_D_0">
        <VALUE Lang="tw">好久沒有跟鳳凰的學生主任聯絡，也請順便將中洞的狀況也告訴他。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1216_000">
        <VALUE Lang="tw">傳遞資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1216_000">
        <VALUE Lang="tw">學生主任老師想要將資料傳給商洞的警察局，相信一定是非常重要的資料，請迅速拿到警察局。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1216_000_P_0">
        <VALUE Lang="tw">傳遞資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1216_000_D_0">
        <VALUE Lang="tw">得知中洞消息的學生主任表示，我這裡有些資料會對這件事有幫助，學生主任提出委託，請協助將這些資料交給商洞的警察局。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1219_000">
        <VALUE Lang="tw">回收偽鈔</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1219_000">
        <VALUE Lang="tw">發現有人在使用偽鈔。請從邪惡小丑身上搶回偽鈔。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1219_000_P_0">
        <VALUE Lang="tw">搶回偽鈔</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1219_000_D_0">
        <VALUE Lang="tw">在本洞目擊到使用偽鈔書的人，請逮捕後搶回偽鈔並焚燒之。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1220_000">
        <VALUE Lang="tw">定期測驗_聖門</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1220_000">
        <VALUE Lang="tw">又到了要定期測驗的時候了。找尋各學院的物理老師請求測驗</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1220_000_P_0">
        <VALUE Lang="tw">找尋各自所屬學校的物理老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1220_000_D_0">
        <VALUE Lang="tw">為了接受定期測驗，請找尋所屬學院的物理老師。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1220_000_P_1">
        <VALUE Lang="tw">打倒『寒冰將領』</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1220_000_D_1">
        <VALUE Lang="tw">測驗項目為打倒『寒冰將領』。無時間限制，請打倒在藍色區域內的『寒冰將領』。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1220_000_P_2">
        <VALUE Lang="tw">從『物理老師(聖門)』那裡確認結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1220_000_D_2">
        <VALUE Lang="tw">如果已打倒『寒冰將領』，請確認結果。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1221_000">
        <VALUE Lang="tw">定期測驗_玄嚴</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1221_000">
        <VALUE Lang="tw">又到了要定期測驗的時候了。找尋各學院的物理老師請求測驗</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_1221_000_P_0">
        <VALUE Lang="tw">找尋各自所屬學校的物理老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_1221_000_D_0">
