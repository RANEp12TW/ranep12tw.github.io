        <VALUE Lang="tw">有關文件的記憶</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_505_000">
        <VALUE Lang="tw">請到1樓去見老人曾說過的學生 .</VALUE>
