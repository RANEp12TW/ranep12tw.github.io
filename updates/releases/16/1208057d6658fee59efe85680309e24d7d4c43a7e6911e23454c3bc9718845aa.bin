    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2121_000_D_1">
        <VALUE Lang="tw">請打倒每天晚上瘋狂出現的異變生物研究家20隻</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2121_000_P_2">
        <VALUE Lang="tw">去找物流管理員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2121_000_D_2">
        <VALUE Lang="tw">請去找物流管理員把處理結果告訴他</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2122_000">
        <VALUE Lang="tw">打倒酒鬼</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2122_000">
        <VALUE Lang="tw">酒鬼到處徘徊在搶奪酒精和鎮定劑。我要幫學生治療很難去處理那件事.請打倒足夠數量的酒鬼。</VALUE>
    </SENTENSE>
