    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2344_000">
        <VALUE Lang="tw">把恢復平靜的商人們送回去,但是過不久他們還會再來攻擊.快把它們制伏並帶過來</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2344_000_P_0">
        <VALUE Lang="tw">制伏 殘暴商人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2344_000_D_0">
        <VALUE Lang="tw">請把殘暴商人制伏後帶過來</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2344_000_P_1">
        <VALUE Lang="tw">制伏 肉販大叔</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2344_000_D_1">
        <VALUE Lang="tw">請把肉販大叔制伏後帶過來</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2345_000">
        <VALUE Lang="tw">變異原因調查邀請</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2345_000">
        <VALUE Lang="tw">平靜下來的商人還在持續攻擊，他們需要可以徹底解決的對策. 請找&quot;超能部 指導老師&quot;諮詢</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2345_000_P_0">
        <VALUE Lang="tw">找超能部 指導老師諮詢</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2345_000_D_0">
        <VALUE Lang="tw">為了掌握商人變異的原因，請找“超能部 指導教師”咨詢</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2346_000">
        <VALUE Lang="tw">變異調查委託 I</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2346_000">
        <VALUE Lang="tw">&quot;超能部 指導教師&quot;告訴我們，如果調查商人身邊的“高利貸業者”，說不定會有頭緒</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2346_000_P_0">
        <VALUE Lang="tw">調查高利貸</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2346_000_D_0">
        <VALUE Lang="tw">商人們為了掌握變異原因找“超能部指導教師”諮詢</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2346_000_P_1">
        <VALUE Lang="tw">藥物調查委託</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2346_000_D_1">
        <VALUE Lang="tw">把&quot;高利貸業者&quot;身上的藥物成份交給&quot;超能部 指導老師&quot;分析</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2347_000">
        <VALUE Lang="tw">令人頭痛的藝術家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2347_000">
        <VALUE Lang="tw">瘋狂的藝術家正在掠奪補給物資。請除掉他們.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2347_000_P_0">
        <VALUE Lang="tw">除掉 高蹺小丑</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2347_000_D_0">
        <VALUE Lang="tw">請除掉帶來不良影響的 &quot;高蹺小丑&quot;.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2347_000_P_1">
        <VALUE Lang="tw">除掉 無名畫家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2347_000_D_1">
        <VALUE Lang="tw">請除掉帶來不良影響的 &quot;無名畫家&quot;.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2348_000">
        <VALUE Lang="tw">令人頭痛的藝術家 (重覆)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2348_000">
        <VALUE Lang="tw">瘋狂的藝術家一直對周邊的人造成威脅. 請除掉他們.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2348_000_P_0">
        <VALUE Lang="tw">除掉 高蹺小丑</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2348_000_D_0">
        <VALUE Lang="tw">請除掉帶來不良影響的 &quot;高蹺小丑&quot;.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2348_000_P_1">
        <VALUE Lang="tw">除掉 無名畫家</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2348_000_D_1">
        <VALUE Lang="tw">請除掉帶來不良影響的 &quot;無名畫家&quot;.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2349_000">
        <VALUE Lang="tw">變異調查委託 II</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2349_000">
        <VALUE Lang="tw">藥物成份已分析完畢.請找&quot;超能部 指導老師&quot;領取 成份分析表後交給&quot;忍術部長&quot;.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2349_000_P_0">
        <VALUE Lang="tw">領取 成份分析表</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2349_000_D_0">
        <VALUE Lang="tw">請找&quot;超能部 指導教師&quot;領取成份分析表</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2349_000_P_1">
        <VALUE Lang="tw">轉交 成份分析表</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2349_000_D_1">
        <VALUE Lang="tw">請將成份分析表轉交給&quot;忍術部長&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2350_000">
        <VALUE Lang="tw">掃蕩高利貸</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2350_000">
        <VALUE Lang="tw">發現了商人們攻擊的原因.高利貸好像利用藥物讓商人增加攻擊。請消滅罪魁禍首的高利貸成員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2350_000_P_0">
        <VALUE Lang="tw">掃蕩 高利貸小弟</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2350_000_D_0">
        <VALUE Lang="tw">請除掉 &quot;高利貸小弟&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2350_000_P_1">
        <VALUE Lang="tw">掃蕩 高利貸推銷員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2350_000_D_1">
        <VALUE Lang="tw">請除掉 &quot;高利貸推銷員&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2350_000_P_2">
        <VALUE Lang="tw">掃蕩 高利貸討債員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2350_000_D_2">
        <VALUE Lang="tw">請除掉 &quot;高利貸討債員&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2351_000">
        <VALUE Lang="tw">掃蕩高利貸(重覆)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2351_000">
        <VALUE Lang="tw">必須趕走這一帶犯罪的集團成員。請掃蕩高利貸成員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2351_000_P_0">
        <VALUE Lang="tw">掃蕩 高利貸小弟</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2351_000_D_0">
        <VALUE Lang="tw">請除掉 &quot;高利貸小弟&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2351_000_P_1">
        <VALUE Lang="tw">掃蕩 高利貸推銷員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2351_000_D_1">
        <VALUE Lang="tw">請除掉 &quot;高利貸推銷員&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2351_000_P_2">
        <VALUE Lang="tw">掃蕩 高利貸討債員</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2351_000_D_2">
        <VALUE Lang="tw">請除掉 &quot;高利貸討債員&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2352_000">
        <VALUE Lang="tw">重新蒐查</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2352_000">
        <VALUE Lang="tw">因為掃蕩而延遲的工作請再次展開調查。請往更裡面移動。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2352_000_P_0">
        <VALUE Lang="tw">通往深處</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2352_000_D_0">
        <VALUE Lang="tw">請移動到更深處調查 &quot;瑞珍樹&quot;周邊.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2352_000_P_1">
        <VALUE Lang="tw">襲擊防禦 I</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2352_000_D_1">
        <VALUE Lang="tw">搜查中殘暴的猛獸展開了襲擊. 請除掉猛獸.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2352_000_P_2">
        <VALUE Lang="tw">襲擊防禦 II</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2352_000_D_2">
        <VALUE Lang="tw">搜查中殘暴的猛獸展開了襲擊. 請除掉猛獸.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2353_000">
        <VALUE Lang="tw">馴獸師的請求</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2353_000">
        <VALUE Lang="tw">“魔術動物 訓練師”對動物真的是充滿熱情。是否能成功馴服那些猛獸，還得在等一段時間..</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2353_000_P_0">
        <VALUE Lang="tw">捕獲 變異的動物 I</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2353_000_D_0">
        <VALUE Lang="tw">請制伏並捕獲 &quot;變異獵豹&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2353_000_P_1">
        <VALUE Lang="tw">捕獲 變異的動物 II</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2353_000_D_1">
        <VALUE Lang="tw">請制伏並捕獲 &quot;變異犀牛&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2354_000">
        <VALUE Lang="tw">馴獸師的請求(重覆)</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2354_000">
        <VALUE Lang="tw">即使充滿熱情也還是有力不從心的時候。看來變異動物是沒辦法訓服了，請除掉它們確保安全。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2354_000_P_0">
        <VALUE Lang="tw">除掉 變異的動物 I</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2354_000_D_0">
        <VALUE Lang="tw">請除掉 &quot;變異獵豹&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2354_000_P_1">
        <VALUE Lang="tw">除掉 變異的動物 II</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2354_000_D_1">
        <VALUE Lang="tw">請除掉 &quot;變異犀牛&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2355_000">
        <VALUE Lang="tw">無法放棄的迷戀</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2355_000">
        <VALUE Lang="tw">在動物園看到有人可以控制那些變異動物。請找到那個人，並探聽訓服變異動物的方法</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2355_000_P_0">
        <VALUE Lang="tw">制服 ‘鋼鐵獵人’</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2355_000_D_0">
        <VALUE Lang="tw">請制伏 &quot;鋼鐵獵人&quot;並打聽一下訓練猛獸的秘密</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2355_000_P_1">
        <VALUE Lang="tw">結果報告</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2355_000_D_1">
        <VALUE Lang="tw">請向 &quot;魔術動物馴獸師&quot;報告結果.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2356_000">
        <VALUE Lang="tw">除掉高利貸老大</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2356_000">
        <VALUE Lang="tw">讓人頭痛的高利貸老大在哪裡？ 請除掉老大，摧毀集團。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2356_000_P_0">
        <VALUE Lang="tw">除掉高利貸老闆</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2356_000_D_0">
        <VALUE Lang="tw">請除掉&quot;高利貸老闆&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2356_000_P_1">
        <VALUE Lang="tw">結果報告</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2356_000_D_1">
        <VALUE Lang="tw">請向&quot;忍術部長&quot;報告結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2357_000">
        <VALUE Lang="tw">取得線索</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2357_000">
        <VALUE Lang="tw">從高利貸_討債員掉落的手機中，我們發現了行動指令. 為了了解更多情報，請蒐集更多的手機資料.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2357_000_P_0">
        <VALUE Lang="tw">取得手機資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2357_000_D_0">
        <VALUE Lang="tw">請除掉 ’高利貸_討債員‘，並蒐集手機資料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2357_000_P_1">
        <VALUE Lang="tw">發信地調查委託</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2357_000_D_1">
