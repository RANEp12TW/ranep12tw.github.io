    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2340_000_D_0">
        <VALUE Lang="tw">想要填寫支援書請到學院廣場與&quot;生活輔導老師&quot;對?.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2340_000_P_1">
