    <SENTENSE Ver="1" Id="QN_682_000">
        <VALUE Lang="tw">報告狀況</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_682_000">
        <VALUE Lang="tw">監獄裡的囚犯們製造暴動,監獄快要被消滅的狀況,請把這種情形快點告訴商洞的警察局.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_682_000_P_0">
        <VALUE Lang="tw">請把監獄的狀況告訴警察局. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_682_000_D_0">
        <VALUE Lang="tw">因為監獄發生了暴動,監獄的情況非常的不妙,請把這種狀況向商洞警察局報案. </VALUE>
    </SENTENSE>
