    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_624_000">
        <VALUE Lang="tw">請掃除水泥工肥仔</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_624_000">
        <VALUE Lang="tw">&apos;在進行掃除過程中,酒鬼曾講了奇怪的話. 當然崔英錫是沒有說的很清楚, 我們聽到的是對於目前的狀況,崔英錫一直都在騙我們,一邊掃除水泥工肥仔,一邊要收集水泥工肥仔身上有的有關聖財團的冊子. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_624_000_P_0">
        <VALUE Lang="tw">請尋找冊子</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_624_000_D_0">
        <VALUE Lang="tw">請找回水泥工肥仔身上的冊子. &#x0D;&#x0A;不知道哪一個水泥工肥仔身上才有冊子, 所以要仔細的搜索. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_624_000_P_1">
        <VALUE Lang="tw">請隱藏冊子</VALUE>
