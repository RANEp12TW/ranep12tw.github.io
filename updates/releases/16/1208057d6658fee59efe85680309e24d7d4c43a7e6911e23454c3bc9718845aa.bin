    <SENTENSE Ver="1" Id="QN_684_000">
        <VALUE Lang="tw">請找阿瑪諾英</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_684_000">
        <VALUE Lang="tw">從研究室主任的口中知道阿瑪諾英還活著,但需要確認是否屬實. </VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_684_000_P_0">
