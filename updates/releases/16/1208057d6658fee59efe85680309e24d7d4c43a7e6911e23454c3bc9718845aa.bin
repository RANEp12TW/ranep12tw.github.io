    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2362_000_D_1">
        <VALUE Lang="tw">從居民聽到的內容告訴&quot;忍術部長&quot;</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2363_000">
