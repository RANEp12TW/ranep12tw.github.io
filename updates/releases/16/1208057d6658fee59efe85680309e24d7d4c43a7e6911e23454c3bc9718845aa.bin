        <VALUE Lang="tw">確定基礎科學室</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_003_000_D_2">
        <VALUE Lang="tw">請使用基礎科學室的終端機閱覽資料&#x0D;&#x0A;基礎科學教室位於1樓玄關經過置物室的地方&#x0D;&#x0A;如果找不到的話，請參考座標 X:22 Y:3。</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_003_000_P_3">
