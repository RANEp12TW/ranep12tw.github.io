    <SENTENSE Ver="1" Id="QN_747_000">
        <VALUE Lang="tw">毫無音訊的少女</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_747_000">
        <VALUE Lang="tw">霸天雲想要向許久前認識的藏匿者問安.但無奈於自己無法離開綜合碼頭,請代替霸天雲向藏匿者問安吧</VALUE>
