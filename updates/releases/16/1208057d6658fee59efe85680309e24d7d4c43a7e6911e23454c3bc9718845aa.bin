    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2358_000_D_0">
        <VALUE Lang="tw">請調查希望廣場周邊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2358_000_P_1">
