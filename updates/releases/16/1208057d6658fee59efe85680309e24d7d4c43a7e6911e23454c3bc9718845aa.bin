    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_2320_000">
        <VALUE Lang="tw">超能部指導老師的請求</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_2320_000">
        <VALUE Lang="tw">這是超能部指導老師(派遣)請我幫忙提供的血液樣本容器。&#x0A;請幫我把這個容器交給他。</VALUE>
