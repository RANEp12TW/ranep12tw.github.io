    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_712_000_D_1">
        <VALUE Lang="tw">請去找生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_713_000">
        <VALUE Lang="tw">學院服務活動 II</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_713_000">
        <VALUE Lang="tw">據說最近在各學院的正門附近有一群酒鬼,正在擾亂學生們.請打倒10隻酒鬼後,向生活輔導老師領取特殊卡片</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_713_000_P_0">
        <VALUE Lang="tw">請打倒10隻酒鬼</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_713_000_D_0">
        <VALUE Lang="tw">請打倒在各學院附近出沒的10隻酒鬼</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_713_000_P_1">
        <VALUE Lang="tw">請去找生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_713_000_D_1">
        <VALUE Lang="tw">請去找生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_714_000">
        <VALUE Lang="tw">學院服務活動 III</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_714_000">
        <VALUE Lang="tw">聽說聖門洞,鳳凰洞,玄巖洞一帶的可滷和清潔工數量突然遽增而造成學生們的困擾.請消滅10隻可滷和10隻清潔工後,找生活輔導老師領取特殊的項鍊吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_714_000_P_0">
        <VALUE Lang="tw">請打倒10隻可滷</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_714_000_D_0">
        <VALUE Lang="tw">請打倒在市區附近出沒的10隻可滷</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_714_000_P_1">
        <VALUE Lang="tw">請打倒10隻清潔工</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_714_000_D_1">
        <VALUE Lang="tw">請打倒在市區附近出沒的10隻清潔工</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_714_000_P_2">
        <VALUE Lang="tw">請去找生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_714_000_D_2">
        <VALUE Lang="tw">請去找生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_715_000">
        <VALUE Lang="tw">不明的圖案</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_715_000">
        <VALUE Lang="tw">生活輔導老師從一位聖門學院的學生手中得到了一份畫有奇異紋樣的圖案,而為了進行相關的解碼,必須要尋求趙善亞的幫忙,請去找趙善亞並請她幫忙解讀吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_715_000_P_0">
        <VALUE Lang="tw">請將圖案拿給趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_715_000_D_0">
        <VALUE Lang="tw">請把從生活輔導老師那取得的不明的圖案拿給趙善亞,請她幫忙解讀吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_715_000_P_1">
        <VALUE Lang="tw">請尋找解碼器</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_715_000_D_1">
        <VALUE Lang="tw">請從鳳凰學院的皮皮挫身上取得解碼器並交給趙善亞吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_715_000_P_2">
        <VALUE Lang="tw">請傳達解碼器</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_715_000_D_2">
        <VALUE Lang="tw">請將解碼器交給趙善亞,並等待結果出爐吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_715_000_P_3">
        <VALUE Lang="tw">傳達已完成解讀的圖案</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_715_000_D_3">
        <VALUE Lang="tw">請將已完成解讀的圖案轉交給生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_716_000">
        <VALUE Lang="tw">飾品製作 I</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_716_000">
        <VALUE Lang="tw">只要幫趙善亞找到她想要的加工圖案,以後她就可以幫忙製作一些飾品類的道具,請尋找戒指加工圖案,並交給趙善亞吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_716_000_P_0">
        <VALUE Lang="tw">尋找戒指加工圖案</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_716_000_D_0">
        <VALUE Lang="tw">為了製作戒指,並需要先找到戒指加工圖案.請從在玄巖洞出沒的奪命剪刀手身上取得戒指加工圖案吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_716_000_P_1">
        <VALUE Lang="tw">請將戒指加工圖案交給趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_716_000_D_1">
        <VALUE Lang="tw">請將戒指加工圖案交給趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_717_000">
        <VALUE Lang="tw">學院服務活動 IV</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_717_000">
        <VALUE Lang="tw">生活輔導老師一直以來都很想把在校園內欺負新生們的暗黑刀神_Jr趕出校園.請協助打倒暗黑刀神_Jr來維護校園內的和平吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_717_000_P_0">
        <VALUE Lang="tw">請打倒暗黑刀神_Jr</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_717_000_D_0">
        <VALUE Lang="tw">請打倒在學院內運動場附近出沒的暗黑刀神_Jr</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_717_000_P_1">
        <VALUE Lang="tw">請去找生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_717_000_D_1">
        <VALUE Lang="tw">請找生活輔導老師來進行確認</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_718_000">
        <VALUE Lang="tw">飾品製作 II</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_718_000">
        <VALUE Lang="tw">只要幫趙善亞找到她想要的加工圖案,以後她就可以幫忙製作一些飾品類的道具,請尋找戒指加工圖案,並交給趙善亞吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_718_000_P_0">
        <VALUE Lang="tw">尋找項鍊加工圖案</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_718_000_D_0">
        <VALUE Lang="tw">為了製作項鍊,並需要先找到項鍊加工圖案.請從在聖門洞出沒的炸彈小丑身上取得項鍊加工圖案吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_718_000_P_1">
        <VALUE Lang="tw">請將項鍊加工圖案交給趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_718_000_D_1">
        <VALUE Lang="tw">請將項鍊加工圖案交給趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_719_000">
        <VALUE Lang="tw">武器改造</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_719_000">
        <VALUE Lang="tw">趙善亞正在做有關武器改造的研究,請將適當的材料拿給她,並領取改造的武器吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_719_000_P_0">
        <VALUE Lang="tw">收集改造武器所需的材料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_719_000_D_0">
        <VALUE Lang="tw">請從出沒在商洞的G奶七仔身上取得特殊磨刀石</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_719_000_P_1">
        <VALUE Lang="tw">打倒滑輪小子</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_719_000_D_1">
        <VALUE Lang="tw">請打倒一定數量的滑輪小子</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_719_000_P_2">
        <VALUE Lang="tw">收集改造武器所需的材料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_719_000_D_2">
        <VALUE Lang="tw">請再從G奶七仔身上取得五個特殊磨刀石</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_719_000_P_3">
        <VALUE Lang="tw">請去找趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_719_000_D_3">
        <VALUE Lang="tw">請將收集好的材料交給趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_720_000">
        <VALUE Lang="tw">飾品製作 III</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_720_000">
        <VALUE Lang="tw">聽說趙善亞可以幫忙製作比先前還要強力的戒指.但為了製作此戒指需要有特殊的工具,請從商洞地區的滑輪高手身上取得必要的工具並交給趙善亞吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_720_000_P_0">
        <VALUE Lang="tw">請從滑輪高手身上取得必要的材料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_720_000_D_0">
        <VALUE Lang="tw">請從徘徊在商洞四號隧道附近的滑輪高手身上取得加工線</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_720_000_P_1">
        <VALUE Lang="tw">請去找趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_720_000_D_1">
        <VALUE Lang="tw">請將加工線交給趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_721_000">
        <VALUE Lang="tw">學院的照顧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_721_000">
        <VALUE Lang="tw">聽說為提供學生能更加快速的移動到各個地方, 便有計程車開始營運了.請先去找生活輔導老師和鳳凰學院的技術老師[鳳凰]聽取相關的資訊後,再使用看看吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_721_000_P_0">
        <VALUE Lang="tw">聽取相關的資訊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_721_000_D_0">
        <VALUE Lang="tw">請去找位於鳳凰洞的技術老師[鳳凰]來聽取使用計程車的相關資訊吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_721_000_P_1">
        <VALUE Lang="tw">請去找生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_721_000_D_1">
        <VALUE Lang="tw">請去找生活輔導老師來領取計程車卡吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_722_000">
        <VALUE Lang="tw">科學社的實驗 I</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_722_000">
        <VALUE Lang="tw">近來趙善亞在進行改造武器的實驗,但目前因欠缺一些物品而無法進行,請收集死炎的核,冷卻劑和融合器並交給趙善亞吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_722_000_P_0">
        <VALUE Lang="tw">收集死炎的核</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_722_000_D_0">
        <VALUE Lang="tw">請從虎令學院的死炎身上收集5個死炎的核</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_722_000_P_1">
        <VALUE Lang="tw">收集冷卻劑</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_722_000_D_1">
        <VALUE Lang="tw">請從在聖門洞出沒的冰凍可滷身上取得5個冷卻劑.</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_722_000_P_2">
        <VALUE Lang="tw">取得融合器</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_722_000_D_2">
        <VALUE Lang="tw">請從出沒在鳳凰洞的焊接工身上取得融合器</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_722_000_P_3">
        <VALUE Lang="tw">請去找趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_722_000_D_3">
        <VALUE Lang="tw">請將收集到的物品交給趙善亞</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_723_000">
        <VALUE Lang="tw">科學社的實驗 II</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_723_000">
        <VALUE Lang="tw">據說趙善亞正在針對到達100級的玩家測試商店營業許可證(3T)的效能,請去找趙善亞請協助她完成實驗吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_723_000_P_0">
        <VALUE Lang="tw">尋找商店營業許可證(3T)的材料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_723_000_D_0">
        <VALUE Lang="tw">為製作商店營業許可證(3T)需要用到骨粉、殘留在菸蒂上的尼古丁和唾液,另外還需要發酵超過10天以上的水.而這些材料可以從宿舍的垃圾堆中取得</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_723_000_P_1">
        <VALUE Lang="tw">傳達材料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_723_000_D_1">
        <VALUE Lang="tw">如材料都已收集完畢,請將材料拿給趙善亞吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_724_000">
        <VALUE Lang="tw">端莊的學生</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_724_000">
        <VALUE Lang="tw">聽說生活輔導老師要提供學生非常實用的制服,但前提是必須要從宿舍的垃圾堆中收集一些舊書籍和古書籍候拿給他,趕緊去執行吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_724_000_P_0">
        <VALUE Lang="tw">收集舊書籍</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_724_000_D_0">
        <VALUE Lang="tw">請從宿舍的垃圾堆中取得30本舊書籍</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_724_000_P_1">
        <VALUE Lang="tw">收集古書籍</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_724_000_D_1">
        <VALUE Lang="tw">請從宿舍的垃圾堆中取得30本古書籍</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_724_000_P_2">
        <VALUE Lang="tw">請去找生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_724_000_D_2">
        <VALUE Lang="tw">請把收集的舊書籍和古書籍交給生活輔導老師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_730_000">
        <VALUE Lang="tw">失聯的朋友</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_730_000">
        <VALUE Lang="tw">趙善亞最近發現似乎可以找到與她失聯許久的朋友的線索,由線索中可以得知,這個友人似乎就在虎令學院裡,請到虎令學院的本館一樓尋找趙善亞的朋友吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_730_000_P_0">
        <VALUE Lang="tw">傳遞消息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_730_000_D_0">
        <VALUE Lang="tw">據說趙善亞的朋友就在虎令學院本館的一樓,請找到他並傳遞消息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_730_000_P_1">
        <VALUE Lang="tw">傳達信件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_730_000_D_1">
        <VALUE Lang="tw">好不容易恢復記憶的藏匿者,想要寄封信給趙善亞,請把這封信件轉交給趙善亞吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_731_000">
        <VALUE Lang="tw">趙善亞的委託</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_731_000">
        <VALUE Lang="tw">趙善亞在收到藏匿者的信件後,想要更詳細的了解這位藏匿者所經歷的事情,請幫趙善亞去了解一下吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_731_000_P_0">
        <VALUE Lang="tw">請去找藏匿者</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_731_000_D_0">
        <VALUE Lang="tw">請去找藏匿者並聽取相關的資訊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_732_000">
        <VALUE Lang="tw">迷之少女</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_732_000">
        <VALUE Lang="tw">據藏匿者所言,在當初發生異變時,他是因為得到一位少女及他的同伴的幫忙才得以獲救,而那位少女朝著商洞的方向走掉了,請前去確認看看吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_732_000_P_0">
        <VALUE Lang="tw">請再虎令學院的校門前尋找線索</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_732_000_D_0">
        <VALUE Lang="tw">出沒於虎令學院正門附近的東星烏鴉,有著蒐集發亮的物品的習性,請調查這群東星烏鴉,看看能否找到一些線索</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_732_000_P_1">
        <VALUE Lang="tw">請去找位於商洞隧道前方的警察[聖門洞]</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_732_000_D_1">
        <VALUE Lang="tw">據說在商洞隧道前站崗的警察[聖門洞]有見過包含這位少女的旅行團,請去找他並聽取詳細的內容吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_732_000_P_2">
        <VALUE Lang="tw">請去找位於商洞的劍道道場代理師傅</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_732_000_D_2">
        <VALUE Lang="tw">據說位於商洞劍道道場代理師傅知道此旅團的去向,請去找他並了解一下他們的去向吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_732_000_P_3">
        <VALUE Lang="tw">前往商洞四號隧道</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_732_000_D_3">
        <VALUE Lang="tw">由劍道道場道理師傅那得知,少女等一夥人往商洞四號隧道的方向走過去了,請前往商洞四號隧道尋找看看吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_733_000">
        <VALUE Lang="tw">驅離怪客</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_733_000">
        <VALUE Lang="tw">據說秀娥正被魅影殺手所監視,使他非常的痛苦,請幫忙驅離怪人吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_733_000_P_0">
        <VALUE Lang="tw">打倒魅影殺手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_733_000_D_0">
        <VALUE Lang="tw">監視著秀娥的魅影殺手有著很強大的力量,請務必小心</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_733_000_P_1">
        <VALUE Lang="tw">請去找秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_733_000_D_1">
        <VALUE Lang="tw">已打倒魅影殺手了,請去找秀娥吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_734_000">
        <VALUE Lang="tw">魯西安的行蹤</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_734_000">
        <VALUE Lang="tw">因為秀娥無法擺脫魅影殺手的監視,因此想要去尋找當初給魅影殺手下達命令的魯西安,請前往商洞四號隧道的盡頭探聽一下魯西安的下落吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_734_000_P_0">
        <VALUE Lang="tw">尋找魯西安的線索</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_734_000_D_0">
        <VALUE Lang="tw">請沿著隧道尋找魯西安的線索吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_734_000_P_1">
        <VALUE Lang="tw">打倒狂暴魅影殺手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_734_000_D_1">
        <VALUE Lang="tw">請打倒阻擋著去路的狂暴魅影殺手,並取得魯西安的緊急書令</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_734_000_P_2">
        <VALUE Lang="tw">請去找秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_734_000_D_2">
        <VALUE Lang="tw">請將魯西安的緊急書令轉交給秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_735_000">
        <VALUE Lang="tw">真相大白</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_735_000">
        <VALUE Lang="tw">雖然已經找到似是魯西安所寫的緊急書令,但還是需要更多的資訊.請從狂暴魅影殺手手中取得更多的資訊吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_735_000_P_0">
        <VALUE Lang="tw">打倒狂暴魅影殺手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_735_000_D_0">
        <VALUE Lang="tw">請打倒狂暴魅影殺手並獲取有用的資訊</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_735_000_P_1">
        <VALUE Lang="tw">請去找秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_735_000_D_1">
        <VALUE Lang="tw">請將魯西安給魅影殺手的便條紙拿給秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_736_000">
        <VALUE Lang="tw">問安的少女</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_736_000">
        <VALUE Lang="tw">秀娥想要對自己喜歡的人問安並想要得知他們的下落.請去尋找位於綜合碼頭附近的同夥霸天雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_736_000_P_0">
        <VALUE Lang="tw">請去找霸天雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_736_000_D_0">
        <VALUE Lang="tw">秀娥透過使用自身的能力將玩家傳到綜合碼頭了.請調查綜合碼頭的周圍</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_737_000">
        <VALUE Lang="tw">消滅怪物</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_737_000">
        <VALUE Lang="tw">得知秀娥下落的霸天雲,雖然很想要見秀娥,但他目前必須要保護受傷的同伴而無法離開,請幫忙消滅附近的怪物吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_737_000_P_0">
        <VALUE Lang="tw">打倒5隻漁夫</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_737_000_D_0">
        <VALUE Lang="tw">請打倒五隻漁夫</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_737_000_P_1">
        <VALUE Lang="tw">打倒5隻警棍賊頭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_737_000_D_1">
        <VALUE Lang="tw">請打倒5隻警棍賊頭</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_737_000_P_2">
        <VALUE Lang="tw">請去找霸天雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_737_000_D_2">
        <VALUE Lang="tw">請將結果回報給霸天雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_738_000">
        <VALUE Lang="tw">追擊者的行蹤</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_738_000">
        <VALUE Lang="tw">霸天雲猜想當初在發生異變時,追蹤著自己的追擊者都躲到青的據點了.但這不過是猜測,因此霸天雲希望你去問問附近的人們看看是否能夠得到一些消息</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_738_000_P_0">
        <VALUE Lang="tw">請去找倉庫管理人</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_738_000_D_0">
        <VALUE Lang="tw">請去找發生異變時依然保持清醒的倉庫管理人,問問當時的情況如何</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_738_000_P_1">
        <VALUE Lang="tw">請去找霸天雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_738_000_D_1">
        <VALUE Lang="tw">請將結果回報給霸天雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_739_000">
        <VALUE Lang="tw">重要的同伴</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_739_000">
        <VALUE Lang="tw">霸天雲說目前必須要先將追蹤者的行蹤告知秀娥,並從秀娥那取得一些急救藥品.請前往商洞四號隧道找秀娥傳遞相關的消息,並取得急救藥品</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_739_000_P_0">
        <VALUE Lang="tw">去見秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_739_000_D_0">
        <VALUE Lang="tw">請將追蹤者的行蹤以及同伴們的狀況告知秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_739_000_P_1">
        <VALUE Lang="tw">收集材料</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_739_000_D_1">
        <VALUE Lang="tw">因秀娥身上的急救藥品已用完.因此必須要從隧道內的死炎身上取得?死炎的碎片來製作急救藥品,請收集7個死炎的碎片並交給秀娥吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_739_000_P_2">
        <VALUE Lang="tw">請去找秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_739_000_D_2">
        <VALUE Lang="tw">請將收集好的死炎的碎片拿給秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_739_000_P_3">
        <VALUE Lang="tw">傳遞急救藥品</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_739_000_D_3">
        <VALUE Lang="tw">請將秀娥製作的急救藥品傳遞給霸天雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_740_000">
        <VALUE Lang="tw">傳遞貝奴的信件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_740_000">
        <VALUE Lang="tw">霸天雲所屬的機動隊隊長&quot;貝奴&quot;想要將信件傳遞給秀娥.請從霸天雲手中取得信件並轉交給秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_740_000_P_0">
        <VALUE Lang="tw">傳遞給秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_740_000_D_0">
        <VALUE Lang="tw">請將貝奴的信件傳遞給位於商洞四號隧道中的秀娥</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_741_000">
        <VALUE Lang="tw">傳遞秀娥的信件</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_741_000">
        <VALUE Lang="tw">秀娥想要去見貝奴,但無奈於無法離開,因此希望你可以將信件轉達給霸天雲,再請霸天雲轉交給貝奴</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_741_000_P_0">
        <VALUE Lang="tw">將信件傳遞給霸天雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_741_000_D_0">
        <VALUE Lang="tw">請將秀娥的信件傳遞給位於綜合碼頭的霸天雲</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_742_000">
        <VALUE Lang="tw">殲滅怪物</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_742_000">
        <VALUE Lang="tw">只要幫霸天雲殲滅附近的怪物,就可獲得一些非常實用的裝備.請依序打倒3隻漁夫,5隻焊接技師,7隻殘暴水手,10隻殘酷光頭猛男後,再找霸天雲領取獎勵吧</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_742_000_P_0">
        <VALUE Lang="tw">打倒漁夫</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_742_000_D_0">
        <VALUE Lang="tw">請打倒在共用倉庫附近出沒的3隻漁夫</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_742_000_P_1">
        <VALUE Lang="tw">打倒焊接技師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_742_000_D_1">
        <VALUE Lang="tw">請打倒在碼頭附近出沒的5隻焊接技師</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_742_000_P_2">
        <VALUE Lang="tw">打倒殘暴水手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_742_000_D_2">
        <VALUE Lang="tw">請打倒出沒在冷凍倉庫附近的7隻殘暴水手</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_742_000_P_3">
        <VALUE Lang="tw">打倒殘酷光頭猛男</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_742_000_D_3">
        <VALUE Lang="tw">請打倒在碼頭附近出沒的10隻殘酷光頭猛男</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QN_742_000_P_4">
        <VALUE Lang="tw">向霸天雲回報結果</VALUE>
    </SENTENSE>
    <SENTENSE Ver="1" Id="QD_742_000_D_4">
        <VALUE Lang="tw">請向霸天雲回報結果,並領取獎勵</VALUE>
    </SENTENSE>
