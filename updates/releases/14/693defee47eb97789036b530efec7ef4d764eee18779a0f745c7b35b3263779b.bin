  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_haksen1_1.ntk_15_0">
    <VALUE Lang="GS">The primary targets for this area are the Punks. Please eliminate 36 of them.</VALUE>
    <VALUE Lang="id">Musuh yang diutamanan di tempat ini adalah Renegade</VALUE>
    <VALUE Lang="id">Jatuhkan 36 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为 Punk。请除掉36只Punk，维持良好校园风气。</VALUE>
  </SENTENSE>
