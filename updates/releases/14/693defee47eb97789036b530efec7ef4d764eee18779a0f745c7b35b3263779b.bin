  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0">
    <VALUE Lang="GS">Exchange your 'Check In Badges' here!</VALUE>
    <VALUE Lang="GS">No rebate once exchanged! Please be advised, no rebate once exchanged!</VALUE>
    <VALUE Lang="id">Tukar 'Check In Badges' di sini!</VALUE>
    <VALUE Lang="id">Kamu akan mendapatkan harga khusus!</VALUE>
    <VALUE Lang="cn">请在这边兑换您的'Check In Badges'！</VALUE>
    <VALUE Lang="cn">兑换之后是没有折扣的 ！请注意，兑换之后是没有折扣的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_1">
    <VALUE Lang="GS">How can I get a Check In Badge?</VALUE>
    <VALUE Lang="id">Bagaimana cara mendapatkan item Check In Badge?</VALUE>
    <VALUE Lang="cn">我该如何得到徽章呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_2">
    <VALUE Lang="GS">Exchange 10 Check In Badges for a 'I-Ran Man Suit Prototype (7D)'</VALUE>
    <VALUE Lang="id">Tukar 10 Check In Badges dengan 'I-Ran Man Suit Prototype (7D)'</VALUE>
    <VALUE Lang="cn">拿10 Check In Badges 去兑换1个 'I-Ran Man Suit Prototype (7D)'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_3">
    <VALUE Lang="GS">Exchange 15 Check In Badges for a 'I-Ran Man Suit Prototype (15D)'</VALUE>
    <VALUE Lang="id">Tukar 15 Check In Badges dengan 'I-Ran Man Suit Prototype (15D)'</VALUE>
    <VALUE Lang="cn">拿15 Check In Badges 去兑换1个 'I-Ran Man Suit Prototype (15D)'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_1_0_4">
    <VALUE Lang="GS">Exchange 20 Check In Badges for a 'I-Ran Man Suit Prototype (30D)'</VALUE>
    <VALUE Lang="id">Tukar 20 Check In Badges dengan 'I-Ran Man Suit Prototype (30D)'</VALUE>
    <VALUE Lang="cn">拿20 Check In Badges 去兑换1个 'I-Ran Man Suit Prototype (30D)'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_2_0">
    <VALUE Lang="GS">‘Check In Badges’ can be acquired from the Student Counselor NPC at the Market Place during the event. Please note that you need to be logged on at least 30 minutes or more and Ran Time is applied so don’t forget to watch the time.</VALUE>
    <VALUE Lang="id">‘Check In Badges’ didapatkan dari Student Counselor NPC di Market Place selama masa event.</VALUE>
    <VALUE Lang="cn">在活动期间，可向位在Market Place的Student Counselor NPC索取“Check In Badges”。 不过请注意，您需要登录至少30分钟以上，Ran时间已经开始计算，别忘了看时间。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_checkbadge.ntk_2_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_1_0">
    <VALUE Lang="GS">This Machine is operating normally!</VALUE>
    <VALUE Lang="id">Berfungsi dengan normal</VALUE>
    <VALUE Lang="cn">终端机正常运作中！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_1_0_11">
    <VALUE Lang="GS">Start Authentication</VALUE>
    <VALUE Lang="id">Memulai sertifikasi</VALUE>
    <VALUE Lang="cn">启动验证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_1_0_12">
    <VALUE Lang="GS">Change Tax Rate</VALUE>
    <VALUE Lang="id">Mengubah Tax</VALUE>
    <VALUE Lang="cn">变更税率</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_2_0">
    <VALUE Lang="GS">네트워크 연결상태 불량으로 인해 정보 검색은 할 수 없습니다</VALUE>
    <VALUE Lang="id">네트워크 연결상태 불량으로 인해 정보 검색은 할 수 없습니다</VALUE>
    <VALUE Lang="cn">네트워크 연결상태 불량으로 인해 정보 검색은 할 수 없습니다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_2_0_1">
    <VALUE Lang="GS">처음으로</VALUE>
    <VALUE Lang="id">처음으로</VALUE>
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_3_0">
    <VALUE Lang="GS">Set the tax rate within the governed area.</VALUE>
    <VALUE Lang="GS">The default setting is 5.</VALUE>
    <VALUE Lang="id">Anda bisa mengatur pajak jual-beli pada daerah yang bersangkutan.</VALUE>
    <VALUE Lang="id">Kalau tidak diatur maka persentasi dasar akan diaplikasikan.</VALUE>
    <VALUE Lang="cn">"可设定管辖区域内的税率.</VALUE>
    <VALUE Lang="cn">如没有特别做设定, 那么税率会自动设定成5%"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_3_0_1">
    <VALUE Lang="GS">Change Tax Rate</VALUE>
    <VALUE Lang="id">Mengubah komisi</VALUE>
    <VALUE Lang="cn">变更税率</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_computer.ntk_3_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0">
    <VALUE Lang="GS">Welcome!</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">欢迎！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0_10">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah posisi awal</VALUE>
    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0_11">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0_12">
    <VALUE Lang="GS">Ask about [E]</VALUE>
    <VALUE Lang="id">Bertanya tentang [E]</VALUE>
    <VALUE Lang="cn">询问关于[E]的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_1_0_13">
    <VALUE Lang="GS">Hand over 'Master CD'</VALUE>
    <VALUE Lang="id">Mengeluarkan master CD</VALUE>
    <VALUE Lang="cn">交付‘Master的CD’</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_10_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_10_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_11_0">
    <VALUE Lang="GS">There are powers of Dragon, Tiger, Phoenix and Turtle at Sacred Gate, Mystic Peak, Phoenix and Trading Hole. However, these powers were too strong and gave damages to people. Therefore, 'Director' had built the E-Rooms at where there was too much power to seal it.</VALUE>
    <VALUE Lang="id">Ada naga, macan, phoenix dan dewa kematian dengan kata lain energi kematian yang mengalir di Sacred Gate, Mystic Peak, Phoenix dan Trading Hole.</VALUE>
    <VALUE Lang="id">Tapi kekuatan yang ada pada energi itu terlalu besar sehingga melukai orang-orang</VALUE>
    <VALUE Lang="id">Karena itulah Directo</VALUE>
    <VALUE Lang="cn">在Sacred Gate、Mystic Peak、Phoenix Hole、Trading Hole里,充满了龙、虎、凤凰、乌龟等'四神兽'的气在当中。</VALUE>
    <VALUE Lang="cn">但是因为这'四神兽'的气太强的缘故,给人们带来太多的伤害。</VALUE>
    <VALUE Lang="cn">因此'理事长''Director'选择在'四神兽'的气最强的地方,设立'电算室'’E-Room‘来将气封印起来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_11_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_12_0">
    <VALUE Lang="GS">Since then, people found a way to use the holy power after continuous research. However, it was coded and 'Master CD' given at 'Lead Club' authentication is needed. If you give me the 'Master CD', I will help you use it temporarily.</VALUE>
    <VALUE Lang="id">Setelah melakukan penelitian, saya sudah menemukan cara agar kekuatan itu bisa digukanan oleh manusia secara sementara</VALUE>
    <VALUE Lang="id">Tapi berada dalam keadaan pintu yang terkunci, untuk membukanya dibutuhkan Master CD yang diterima pada saat melakukan verifikasi</VALUE>
    <VALUE Lang="cn">在经过研究之后, 终于找出人可以'暂时'使用那个力量的方法.</VALUE>
    <VALUE Lang="cn">但是那个方法是用暗语写的, 为了能够解读暗语,必须要有'领导组织'认证时所得到的'正版CD' .</VALUE>
    <VALUE Lang="cn">若把'正版CD'交给我,我会帮助你暂时地拥有那个力量.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_12_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cs_helper.ntk_13_0">
    <VALUE Lang="GS">Decoding is done. Please select the class which you would like to receive weapon.</VALUE>
    <VALUE Lang="id">Proses detoksifikasi sudah selesai dilaksanakan. Dari jurusan manakah senjata yang ingin kamu dapatkan, silahkan pilih</VALUE>
    <VALUE Lang="cn">解码完毕。请选择您想要的职业别武器。</VALUE>
  </SENTENSE>
