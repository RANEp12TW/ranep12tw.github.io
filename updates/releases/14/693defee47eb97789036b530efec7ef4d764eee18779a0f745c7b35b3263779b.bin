    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_shop1.ntk_7_0">
    <VALUE Lang="GS">득도의 경지에 이른 남성적 기운... 이래요</VALUE>
    <VALUE Lang="GS">소문이지만,</VALUE>
    <VALUE Lang="GS">‘마루치 기서’ 라는 책이 찢어진 채로 떠돌아 다닌다는 군요</VALUE>
    <VALUE Lang="id">득도의 경지에 이른 남성적 기운... 이래요</VALUE>
    <VALUE Lang="id">소문이지만,</VALUE>
    <VALUE Lang="id">‘마루치 기서’ 라는 책이 찢어진 채로 떠돌아 다닌다는 군요</VALUE>
    <VALUE Lang="cn">득도의 경지에 이른 남성적 기운... 이래요</VALUE>
    <VALUE Lang="cn">소문이지만,</VALUE>
    <VALUE Lang="cn">‘마루치 기서’ 라는 책이 찢어진 채로 떠돌아 다닌다는 군요</VALUE>
