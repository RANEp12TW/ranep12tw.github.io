    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Terminal Test</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_17">
    <VALUE Lang="GS">Force Field Optimization</VALUE>
    <VALUE Lang="id">Authenticate the Protective Barrier</VALUE>
    <VALUE Lang="cn">结界认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_2">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_3">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_4">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_5">
    <VALUE Lang="GS">Force Field Optimization</VALUE>
    <VALUE Lang="id">Autentikasi Force Field</VALUE>
    <VALUE Lang="cn">结界认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_6">
    <VALUE Lang="GS">Force Field Optimization</VALUE>
    <VALUE Lang="id">Autentikasi Force Field</VALUE>
    <VALUE Lang="cn">结界认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_7">
    <VALUE Lang="GS">Force Field Optimization</VALUE>
    <VALUE Lang="id">Autentikasi Force Field</VALUE>
    <VALUE Lang="cn">结界认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_8">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_9">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_11_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_12_0">
    <VALUE Lang="GS">The primary target in this area are the Street Junkies. Please eliminate 22 Street Junkie targets.</VALUE>
    <VALUE Lang="id">Di lokasi ini targetnya adalah Street Junkie</VALUE>
    <VALUE Lang="id">Jatuhkan 22 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为Street Junky。请除掉22只Street Junky，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_13_0">
    <VALUE Lang="GS">.....</VALUE>
    <VALUE Lang="id">.....</VALUE>
    <VALUE Lang="cn">.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_14_0">
    <VALUE Lang="GS">The next target are the Sluggers. Please eliminate 24 Slugger targets.</VALUE>
    <VALUE Lang="id">Musuh yang diutamakan di sini adalah Batter</VALUE>
    <VALUE Lang="id">Lumpuhkanlah 24 orang dari mereka</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为Slugger。请除掉24只Slugger，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_14_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_2_0">
    <VALUE Lang="GS">The terminal is operating normally.</VALUE>
    <VALUE Lang="id">Terminal beroperasi secara normal</VALUE>
    <VALUE Lang="cn">终端机正常运作中</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_3_0">
    <VALUE Lang="GS">The Terminal's Force Field function is operating properly. You must gather 13 Spiritual Spheres in order to optimize the Force Field function of this Terminal.</VALUE>
    <VALUE Lang="id">Pengoperasian Force Field di Terminal berfungsi secara normal</VALUE>
    <VALUE Lang="id">Kalau mau mendapatkan efek authentication kamu harus mengumpulkan spiritual sphere dan mendapatkan konfirmasi, untuk konfirmasi authentication kali ini kamu harus mengumpulkan 13 buah spirit</VALUE>
    <VALUE Lang="cn">终端机的结界机能正常运作中。您需要13颗灵珠才能通过认证，并得到结界的能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_4_0">
    <VALUE Lang="GS">Force Field Optimization is completed!</VALUE>
    <VALUE Lang="GS">Please proceed to the next Terminal and complete the required optimization to learn the Force Field Effects.</VALUE>
    <VALUE Lang="id">Autentikasi Force Field telah selesai</VALUE>
    <VALUE Lang="id">Jika sisa autentikasi Force Field telah selesai hasilnya bisa di dapatkan dan untuk autentikasi Force Field berikutnya harap gunakan terminal yang sesuai</VALUE>
    <VALUE Lang="cn">本结界认证已结束。请前往下个终端机，并完成结界认证。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_5_0">
    <VALUE Lang="GS">There are evil spirits moving around inside the Art Center. The mobs who are possessed by these evil spirits bring undesirable effects to the environment.</VALUE>
    <VALUE Lang="GS">Please do your best to eliminate them.</VALUE>
    <VALUE Lang="id">Sebagian dari roh jelmaan sedang berkeliaran di Library</VALUE>
    <VALUE Lang="id">Roh Jelmaan ini dapat mempengaruhi situasi disekelilingnya. Tolong bersihkan Roh Jelmaan ini sebelum terjadi hal yang lebih buruk</VALUE>
    <VALUE Lang="cn">许多恶灵在 Art Center 里徘徊游荡。被这些恶灵所附着的怪物身上有着不良物质，导致周遭环境出现奇怪现象。请您尽全力处理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_5_0_1">
    <VALUE Lang="GS">Next page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_6_0">
    <VALUE Lang="GS">There are evil spirits moving around inside the Art Center. The mobs who are possessed by these evil spirits bring undesirable effects to the environment.</VALUE>
    <VALUE Lang="GS">Please do your best to eliminate them.</VALUE>
    <VALUE Lang="id">Sebagian dari roh jelmaan sedang berkeliaran di Library</VALUE>
    <VALUE Lang="id">Roh Jelmaan ini dapat mempengaruhi situasi disekelilingnya. Tolong bersihkan Roh Jelmaan ini sebelum terjadi hal yang lebih buruk</VALUE>
    <VALUE Lang="cn">许多恶灵在 Art Center 里徘徊游荡。被这些恶灵所附着的怪物身上有着不良物质，导致周遭环境出现奇怪现象。请您尽全力处理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_6_0_1">
    <VALUE Lang="GS">Next page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_7_0">
    <VALUE Lang="GS">The required amount for purification has been achieved. Thank you for your tremendous efforts.</VALUE>
    <VALUE Lang="id">Konfirmasi target pembersihan musuh telah selesai</VALUE>
    <VALUE Lang="id">Terima kasih atas kerja keras kalian</VALUE>
    <VALUE Lang="cn">已经确认了目标物与其数量净化的完成。 谢谢您，辛苦您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0">
    <VALUE Lang="GS">Hmmmm...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">…..嗯…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_1">
    <VALUE Lang="GS">Talk to Busy Driver</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">与Bus Driver进行对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_2">
    <VALUE Lang="GS">Bus Driver's Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan Bus Driver</VALUE>
    <VALUE Lang="cn">Bus Driver的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_3">
    <VALUE Lang="GS">Present the Spare Parts</VALUE>
    <VALUE Lang="id">Menyerahkan Genuine Parts</VALUE>
    <VALUE Lang="cn">交付零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_4">
    <VALUE Lang="GS">Bus Driver's 2nd Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan kedua Bus Driver</VALUE>
    <VALUE Lang="cn">Bus Driver的请求2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_5">
    <VALUE Lang="GS">Ask if he needs help</VALUE>
    <VALUE Lang="id">Tanya apa dia butuh bantuan</VALUE>
    <VALUE Lang="cn">询问他是否需要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_1_0_6">
    <VALUE Lang="GS">Tell him what happened</VALUE>
    <VALUE Lang="id">Beritahu apa yang terjadi</VALUE>
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_10_0">
    <VALUE Lang="GS">The problem with the bus started a few days ago, and it's been getting worse since then. The bus won't even move at all now. It seems that the other buses in the area are having similar problems.</VALUE>
    <VALUE Lang="id">Sejak beberapa hari lalu kondisi bus tiba-tiba mulai aneh, bahkan sekarang tidak bergerak sama sekali…</VALUE>
    <VALUE Lang="id">Bus-bus yang lainnya juga tidak kelihatan, mungkin terjadi masalah yang sama.</VALUE>
    <VALUE Lang="cn">几天前开始，公车就故障了。而且越来越严重，连发动都成问题了。好像此地区的其他公车也都有类似的问题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_11_0">
    <VALUE Lang="GS">"Have you ever been to PH Hole? If so then you must have met those inferior Green Mask (Uncle Potato). Because of their threats I am afraid to drive the bus.</VALUE>
    <VALUE Lang="GS">If you can please defeat them and scare them away."</VALUE>
    <VALUE Lang="id">Apa kamu pernah ke PH Hole ? Jika iya, kamu pasti pernah bertemu dengan Green Mask. Karena kelakuannya, Saya jadi takut untuk mengendarai bus.</VALUE>
    <VALUE Lang="id">Bisakah kamu mengalahkannya?</VALUE>
    <VALUE Lang="cn">您有去过SG Hole了吗？如果有去过的话，那您一定有见过那些坏心的 Green Mask (Uncle Potato)。因为他们威胁我，甚至想我勒索。因此我连公车都不敢开了。</VALUE>
    <VALUE Lang="cn">如果可以的话，请您帮我打退他们。好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_12_0">
    <VALUE Lang="GS">Thanks! Now I will be able to drive this bus around.</VALUE>
    <VALUE Lang="id">Terima kasih! Sekarang saya merasa jauh lebih tenang.</VALUE>
    <VALUE Lang="cn">谢谢您，现在我终于可以开公车载学生上下学了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_2_0">
    <VALUE Lang="GS">....</VALUE>
    <VALUE Lang="id">....</VALUE>
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_3_0">
    <VALUE Lang="GS">You want to know more about the Bus? Hahaha!</VALUE>
    <VALUE Lang="GS">Obviously, the Bus is used by students in order to move from one area to another. It is a more convenient means of transportation compared to walking or running around by foot.</VALUE>
    <VALUE Lang="id">hoho…</VALUE>
    <VALUE Lang="id">Tentu saja, naiklah Bus.</VALUE>
    <VALUE Lang="id">Andai saja busnya bisa digunakan pasti akan sangat mudah berpergian, sekarang harus berlari deh.</VALUE>
    <VALUE Lang="cn">当然，公车曾被学生们当作通勤的工具。可以传送地点是真的非常方便的事情。比起用跑的，公车真的太方便了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_3_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_4_0">
    <VALUE Lang="GS">Oops! I'm sorry! I didn't know you were there!</VALUE>
    <VALUE Lang="GS">I've been very busy trying to find out what the hell is wrong with this wreck!</VALUE>
    <VALUE Lang="id">Euhm, sebentar</VALUE>
    <VALUE Lang="cn">噢！我很抱歉，我不知道您在这儿！ 我正忙着找出这些不对劲的原因。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_4_0_1">
    <VALUE Lang="GS">Ask What He is Doing</VALUE>
    <VALUE Lang="id">Bertanya apa yang harus dilakukan</VALUE>
    <VALUE Lang="cn">询问他在做什么？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_5_0">
    <VALUE Lang="GS">Oh! This bus is unoperational. I can't even get this thing to work. I really need to fix this bus so that the students can travel safely. It's dangerous to just walk around with all the chaos in the outskirts.</VALUE>
    <VALUE Lang="GS">It's too bad there aren't any spare parts available to fix this thing.</VALUE>
    <VALUE Lang="id">Euhm, kenapa nieh bis nggak mau jalan sieh?</VALUE>
    <VALUE Lang="id">Yah….. partnya juga nggak ada, gimana nieh?</VALUE>
    <VALUE Lang="cn">噢！这台公车无法使用。连我都无法用它来进行工作。我得把它修好，这样学生们才能安全使用。毕竟在这混乱地区独自行走，是非常危险的事情。但现在没有修理用的零件，情况真糟糕。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_5_0_1">
    <VALUE Lang="GS">Ask the Driver more about Bus</VALUE>
    <VALUE Lang="id">Bertanya tentang bus</VALUE>
    <VALUE Lang="cn">询问Driver关于更多的公车情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_6_0">
    <VALUE Lang="GS">Based on my assessment of this wreckage, I can say that repairing this bus shouldn't be a major problem. The spare parts required to repair this vehicle, however, need to be acquired as soon as possible. I can't repair this bus unless I can get all the necessary spare parts.</VALUE>
    <VALUE Lang="id">Bukan rusak yang berat…</VALUE>
    <VALUE Lang="id">Tidak ada genuine partnya jadi tidak bisa dibetulin?!..</VALUE>
    <VALUE Lang="id">Maaf. Tapi…. bisa minta tolong ambilkan parts dari Technical Teacher yang ada di 4th Industrial Zone</VALUE>
    <VALUE Lang="id">Supaya bus dapat digunakan dan pelajar pun menjadi lebih terbantu</VALUE>
    <VALUE Lang="cn">根据公车残骸的报告评估，我可以说，修理这辆车不应该是个大问题。修复此车所需的零件，需要尽快收集到才行。在我能得到所有必要的配备之前，我是无法进行修理的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_7_0">
    <VALUE Lang="GS">Thank you for bringing the spare parts I need. I can finally start repairing this wreck. The students can use the bus to conveniently move from one area to another once I'm done fixing it.</VALUE>
    <VALUE Lang="id">Naah, ini genuine part yang dicari</VALUE>
    <VALUE Lang="id">Akhirnya sekarang bisa juga dibetulin</VALUE>
    <VALUE Lang="id">Sekarang para pelajar pun bisa naik bus dan berpergian dengan mudah</VALUE>
    <VALUE Lang="cn">谢谢您带来我要的零件了！我终于可以开始修 破损的公车了！从现在起，学生们往来其他地区间时，会更加的方便与安全唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_7_0_1">
    <VALUE Lang="GS">Bus Driver's 2nd Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan kedua Bus Driver</VALUE>
    <VALUE Lang="cn">Bus Driver的请求2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_8_0">
    <VALUE Lang="GS">Please visit the Construction Supervisor located near the crossroads of the Phoenix Campus.</VALUE>
    <VALUE Lang="GS">I heard he has a favor to ask from me, but I can't visit him myself because of this bus problem.</VALUE>
    <VALUE Lang="id">Bisa minta tolong temui Construction Supervisor yang ada di sekitar Worker's Dormitory nggak?</VALUE>
    <VALUE Lang="id">Ada pekerjaan yang sulit sehingga dia memanggil, karena bus tidak jalan jadi aku susah pergi kesana</VALUE>
    <VALUE Lang="cn">请您去拜访Construction Supervisor，他位在Sacred Gate Campus的交叉路那儿。我听说他想请我帮忙，但我无法去找他，因为我得处理公车的问题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busdriver1.ntk_9_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busteminal.ntk_1_0">
    <VALUE Lang="GS">This is the Bus Stop.</VALUE>
    <VALUE Lang="GS">Once have your Bus Ticket ready, you can use the Bus Service to move to another area.</VALUE>
    <VALUE Lang="id">Informasi rute bus kota</VALUE>
    <VALUE Lang="id">Untuk menggunakan bus cukup menunjukan tiket</VALUE>
    <VALUE Lang="cn">这里是公车站。只要您拥有Bus Ticket ，就可以使用公车服务，畅游各地区唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busteminal.ntk_1_0_1">
    <VALUE Lang="GS">Ride the Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_busteminal.ntk_1_0_2">
    <VALUE Lang="GS">Ride the Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
