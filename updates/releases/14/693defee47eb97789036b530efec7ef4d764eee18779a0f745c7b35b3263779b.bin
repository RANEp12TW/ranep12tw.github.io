    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_haksen1_1.ntk_1_0">
    <VALUE Lang="GS">This Terminal controls the access to the Student Center 1.</VALUE>
    <VALUE Lang="id">Ini adalah Terminal Classroom Center 1</VALUE>
    <VALUE Lang="id">Mengontrol fungsi keluar masuk ke Terminal Classroom Center 1</VALUE>
    <VALUE Lang="cn">这个终端机掌控着Student Center 1的入口机能。</VALUE>
  </SENTENSE>
