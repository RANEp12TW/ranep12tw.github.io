  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_7_0">
    <VALUE Lang="GS">Oh, a new student?</VALUE>
    <VALUE Lang="id">Oh, Pelajar Baru?</VALUE>
    <VALUE Lang="cn">噢！是新生！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_7_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_8_0">
    <VALUE Lang="GS">Oh, and you've got to visit the Student Director at the School Administration Office to register as a student. The office is next to the Welfare Society.</VALUE>
    <VALUE Lang="id">Kamu harus mengunjungi Student Director di School Administration Office untuk mendaftar sebagai Pelajart. Terletak di samping Welfare Society.</VALUE>
    <VALUE Lang="cn">噢！您还没注册？您必须去拜访一下那位在Welfare Society旁边Administration Office里的Student Director先生。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_9_0">
    <VALUE Lang="GS">Ah! Can I help you with anything?</VALUE>
    <VALUE Lang="id">Iya, jadi kamu penasaran kan?</VALUE>
    <VALUE Lang="cn">我可以帮您什么忙呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_fighter1.ntk_9_0_1">
    <VALUE Lang="GS">Ask about the Brawler Section</VALUE>
    <VALUE Lang="id">Bertanya tentang brawler</VALUE>
    <VALUE Lang="cn">询问关于格斗部</VALUE>
