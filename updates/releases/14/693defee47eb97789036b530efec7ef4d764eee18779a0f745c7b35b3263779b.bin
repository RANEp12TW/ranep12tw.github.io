    <VALUE Lang="GS">Ask about Sword Section</VALUE>
    <VALUE Lang="id">Bertanya tentang Swordsman</VALUE>
    <VALUE Lang="cn">询问剑道部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_8_0_2">
    <VALUE Lang="GS">Ask about Training Methods</VALUE>
    <VALUE Lang="id">Bertanya tentang cara mengerjakan tugas</VALUE>
    <VALUE Lang="cn">询问修练方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_8_0_3">
    <VALUE Lang="GS">Ask about Combat Methods</VALUE>
    <VALUE Lang="id">Bertanya tentang cara bertarung</VALUE>
    <VALUE Lang="cn">询问战斗方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_8_0_4">
    <VALUE Lang="GS">Ask about Skill Points</VALUE>
    <VALUE Lang="id">Bertanya tentang Skill Point</VALUE>
    <VALUE Lang="cn">询问技能点数</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_8_0_5">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_9_0">
    <VALUE Lang="GS">I've found out that quests are very difficult at first. But now... It's really hard for me to finish them.</VALUE>
    <VALUE Lang="id">Sampai beberapa waktu lalu saja proses tugas tidak pernah seperti ini, saya pikir juga ini sudah sangat keterlaluan.</VALUE>
    <VALUE Lang="cn">一开始，这些任务对我来说真的是比登天还难，而现在，要完成它们，仍是需要挤尽我吃奶的力气，非常的难。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_9_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_medic1.ntk_1_0">
    <VALUE Lang="GS">Oh my goodness! Why are so many people injured?</VALUE>
    <VALUE Lang="id">Ah~</VALUE>
    <VALUE Lang="id">Kenapa begini banyak anak-anak yang terluka</VALUE>
    <VALUE Lang="cn">啊！为什么这么多人受伤？！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_medic1.ntk_1_0_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_medic1.ntk_1_0_10">
    <VALUE Lang="GS">Give the Papers for Medical Report</VALUE>
    <VALUE Lang="id">Menyerahkan Medicines</VALUE>
    <VALUE Lang="cn">交付病历用纸</VALUE>
  </SENTENSE>
