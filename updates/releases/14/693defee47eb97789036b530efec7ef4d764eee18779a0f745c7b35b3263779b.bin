  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_1_0">
    <VALUE Lang="GS">Please leave if you don't have any reason to be here. Was there something you wanted to see?</VALUE>
    <VALUE Lang="id">Apakah ada yang ingin ditanyakan?</VALUE>
    <VALUE Lang="cn">如果您没有事情的话，请离开吧。</VALUE>
