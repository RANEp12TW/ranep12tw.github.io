  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_22_7">
    <VALUE Lang="GS">Accept Confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">接受确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_22_8">
    <VALUE Lang="GS">Tell the Truth</VALUE>
    <VALUE Lang="id">Memberitahukan keberadaan</VALUE>
    <VALUE Lang="cn">说出真相</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_22_9">
    <VALUE Lang="GS">Deliver Proposal</VALUE>
    <VALUE Lang="id">Menyerahkan Letter of Opinion</VALUE>
    <VALUE Lang="cn">传达意见书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_3">
    <VALUE Lang="GS">Is that the design layout that you're holding?</VALUE>
    <VALUE Lang="id">Yang kamu bawa itu Piece of Blueprint yah?</VALUE>
    <VALUE Lang="cn">请问手上拿的是不是设计图纸块呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_3_1">
    <VALUE Lang="GS">Deliver Accessory</VALUE>
    <VALUE Lang="id">Menyerahkan genuine parts</VALUE>
    <VALUE Lang="cn">传递零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_4">
    <VALUE Lang="GS">What are you holding?</VALUE>
    <VALUE Lang="id">Ada perlu apa? Kamu bawa apa itu?</VALUE>
    <VALUE Lang="cn">什么事？请问你手上拿的是什么东西</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_4_1">
    <VALUE Lang="GS">Deliver Accessory</VALUE>
    <VALUE Lang="id">Menyerahkan genuine parts</VALUE>
    <VALUE Lang="cn">传递零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_5">
    <VALUE Lang="GS">It might be messy and troublesome to collect so many accessories, but you might find it useful in the future.</VALUE>
    <VALUE Lang="id">Masih banyak genuine parts yang bisa dikumpulkan, walau sedikit repot kalau terus dikumpulkan suatu saat nanti pasti membantu.</VALUE>
    <VALUE Lang="cn">好像有很多零件需要收集回来，积少成多，以后会有需要的地方。虽然有点麻烦，但还是多拜托您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_5_1">
    <VALUE Lang="GS">Deliver Accessory</VALUE>
    <VALUE Lang="id">Menyerahkan genuine parts</VALUE>
    <VALUE Lang="cn">传递零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_6">
    <VALUE Lang="GS">Quick! Show me the letter.</VALUE>
    <VALUE Lang="id">Kamu bawa Letter? Mana coba saya lihat?</VALUE>
    <VALUE Lang="cn">快点！给我看信件！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_6_1">
    <VALUE Lang="GS">Deliver letter</VALUE>
    <VALUE Lang="id">Melaporkan hasil</VALUE>
    <VALUE Lang="cn">传递信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_7">
    <VALUE Lang="GS">Seem like you have to go through Semester Test. Perhaps, it won't be too difficult.</VALUE>
    <VALUE Lang="id">Sepertinya saya harus melakukan inspeksi pertengahan. Saya percaya bahwa kamu tidak akan merasa kesulitan pada inspeksi pertengahan ini</VALUE>
    <VALUE Lang="cn">您好像需要通过期中考检定。希望这次的期中考对您来说不会太难。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_7_1">
    <VALUE Lang="GS">Accept Semester Test Confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi inspeksi pertengahan</VALUE>
    <VALUE Lang="cn">接受期中考的认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_8">
    <VALUE Lang="GS">It might be messy and troublesome to collect so many accessories, but you might find it useful in the future. &lt;/TEXT&gt;.</VALUE>
    <VALUE Lang="id">Masih banyak genuine parts yang bisa dikumpulkan, walau sedikit repot kalau terus dikumpulkan suatu saat nanti pasti membantu.</VALUE>
    <VALUE Lang="cn">好像有很多零件需要收集回来，积少成多，以后会有需要的地方。虽然有点麻烦，但还是多拜托您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_8_1">
    <VALUE Lang="GS">Deliver Accessory</VALUE>
    <VALUE Lang="id">Menyerahkan Genuine Parts</VALUE>
    <VALUE Lang="cn">传递信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_9">
    <VALUE Lang="GS">It might be messy and troublesome to collect so many accessories, but you might find it useful in the future. &lt;/TEXT&gt;</VALUE>
    <VALUE Lang="id">Masih banyak genuine parts yang bisa dikumpulkan, walau sedikit repot kalau terus dikumpulkan suatu saat nanti pasti membantu.</VALUE>
    <VALUE Lang="cn">好像有很多零件需要收集回来，积少成多，以后会有需要的地方。虽然有点麻烦，但还是多拜托您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_9_1">
    <VALUE Lang="GS">Deliver Accessory</VALUE>
    <VALUE Lang="id">Menyerahkan genuine parts</VALUE>
    <VALUE Lang="cn">传递信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_10_0">
    <VALUE Lang="GS">Erm… Please collect the parts when you're free, and please do not tell anyone, but I'm collecting accessories.</VALUE>
    <VALUE Lang="id">Sepertinya ini kurang….Setiap ada waktu kumpulkan sedikit demi sedikit. O iya, jangan sampai orang lain tahu bahwa saya mengumpulkan genuine parts yah</VALUE>
    <VALUE Lang="cn">嗯......这点好像不够......。有空时请你一点一点的收集，还有请你不要告诉别人，我在收集零件。</VALUE>
    <VALUE Lang="cn">“</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_11_0">
    <VALUE Lang="GS">Erm... Wharf Passage... The Green Group was missing last time.</VALUE>
    <VALUE Lang="GS">I know I need to do my very best. I need to push myself a little more…</VALUE>
    <VALUE Lang="id">Passage….Dulu saya pernah berpikir bahwa dunia bisa menjadi damai andai saja komplotan Red Axe itu tidak ada. Tapi kalau sekarang malah saya merindukan saat-saat itu. Saya jadi cerita yang nggak-nggak. Saya tahu kamu sedang berusaha dengan keras tapi teru</VALUE>
    <VALUE Lang="cn">“嗯码头......以前认为只要没有青组织的话。，天下就会太平但是现在反而很怀念那个时候，唉〜我不该提的，我知道都在尽最大的努力，希望再多努力一点。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_12_0">
    <VALUE Lang="GS">Even though things might not seem so hard, just know that stronger opponents are always waiting just around the corner. Don't give up, and never lose focus.</VALUE>
    <VALUE Lang="id">Euhm…tidak begitu sulit rupanya…mulai dari sekarang kamu akan menghadapi musuh yang tidak bisa dibandingkan dengan musuh-musuh yang sekarang. Saya harap kamu tidak lengah walaupun kemampuan kamu sudah meningkat</VALUE>
    <VALUE Lang="cn">…嗯…好像没有很难吧.果然是….从现在开始要对付与现在根本无法相比的超强敌人,会使能力大大提升,请不要放松心情, 全神贯注.</VALUE>
    <VALUE Lang="cn">"</VALUE>
    <VALUE Lang="cn">“</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_13_0">
    <VALUE Lang="GS">Can you please repeat again that? Are you saying "Amanuoruoyin?" How come…? Please wait for a while.</VALUE>
    <VALUE Lang="GS">Please give this letter, and say "Amanuoruoyin.".</VALUE>
    <VALUE Lang="id">Bisa tolong katakan sekali lagi? Tadi kamu bilang Amanoruin? Tidak mungkin….eh bukan saatnya kita seperti ini. Tunggu sebentar.</VALUE>
    <VALUE Lang="id">Nah di sini ada Letter. Tolong sampaikan kepada orang yang bernama Amanoruin</VALUE>
    <VALUE Lang="cn">请你再说一次好吗？你说是'Amanuoruoyin'吗？怎么会...... 请您等一下。</VALUE>
    <VALUE Lang="cn">这里有信件，请帮忙传达，并说一声：'Amanuoruoyin'。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_13_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_14_0">
    <VALUE Lang="GS">What luck! It's really "Amanuoruoyin."</VALUE>
    <VALUE Lang="id">Untung saja, dia benar-benar Amanoruin</VALUE>
    <VALUE Lang="cn">真是幸运，真的是”Amanuoruoyin“！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_14_0_1">
    <VALUE Lang="GS">Ask about who is "Amanuoruoyin"</VALUE>
    <VALUE Lang="id">Bertanya siapakah Amanoruin</VALUE>
    <VALUE Lang="cn">询问谁是 "Amanuoruoyin"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_15_0">
    <VALUE Lang="GS">I told you before, I've lost some friends because of something that happened. "Amanuoruoyin" is one of my friends, and I'm thanking Amanuoruoyin is still giving us help.</VALUE>
    <VALUE Lang="id">Sebelumnya saya pernah bilang. Saya harus menyelamatkan teman-teman saya yang terpencar tidak tahu karena alasan apa dan tidak tahu apakah mereka masih hidup atau tidak. Amanoruin adalah salah satu dari teman-teman tersebut. Amanoruin bilang dia akan memb</VALUE>
    <VALUE Lang="cn">以前我跟你说过，为了某种原因朋友纷纷走失，不知生死。'Amanuoruoyin'就是其中的朋友之一。还好，'Amanuoruoyin'会一直给予帮助, 一个人担当起来,有点困难。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_15_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_16_0">
    <VALUE Lang="GS">This is… Information from Amaruoyin? Amaruoyin is still alive… Professor Chui's Research really did cause the world's chaos? This is the only way to stop it?</VALUE>
    <VALUE Lang="id">Ini…bukannya ini data-data yang dikirim Amana(young)? Amano(young) masih hidup….ternyata sesuai dengan yang saya pikirkan, kekacauan ini terjadi karena penelitian professor Professor Choi …kalau begitu ini satu-satunya jalan untuk menghentikannya?</VALUE>
    <VALUE Lang="cn">这是......”Amaruoyin“所送的资料，不是吗？ 沒想到’Amaruoyin’還活著！果然是崔博士的研究造成這樣的混亂…難道可以阻止的方法只有這一個嗎?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_16_0_1">
    <VALUE Lang="GS">Ask Who is Amaruoyin</VALUE>
    <VALUE Lang="id">Bertanya tentang siapakah Amano(young)?</VALUE>
    <VALUE Lang="cn">询问谁是Amaruoyin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_17_0">
    <VALUE Lang="GS">Amaruoyin is Amanuoruoyin's that came with us to stop the chaotic situation. Amaruoyin slowly lost her mind and memories from what we know. It seems that Amaruoyin was the target of Professor Chui's Experiment.</VALUE>
    <VALUE Lang="id">Amano(young) adalah adik kandung dari Amanoruin. Waktu dia mencari jalan untuk menghentikan kekacauan ini tiba-tiba dia hilang kesadaran sedikit demi sedikit dan akhirnya tidak ingat sama sekali tentang siapa dia. Tapi kalau saya lihat dari data-data ini,</VALUE>
    <VALUE Lang="cn">Amaruoyin'是'Amanuoruoyin”的亲妹妹。她和我们一起寻找阻止混乱的方法的过程中，'Amaruoyin’漸漸失去了意識，結果到最後變成連自己都不記得的狀態。可是看這些資料，好像都是因為崔泰圭博士的實驗的緣故。“Amaruoyin“只是实验的对象而已。唉呀呀..现在不是我闲聊的时候...... 。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_17_0_1">
    <VALUE Lang="GS">Continue</VALUE>
    <VALUE Lang="id">Terus mendengarkan</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_18_0">
    <VALUE Lang="GS">I thought that monster was Amaruoyin. I believe Amanuoruoyin would also agree, caring for his sister.</VALUE>
    <VALUE Lang="GS">That is why he blames himself, and wants to spread the truth about Amanuoruoyin as soon as possible.</VALUE>
    <VALUE Lang="id">Selama ini saya pikir Budi sudah menjadi monster, Amanoruin juga pasti berpikir seperti itu. Dia sangat menyayangi adiknya jadi pasti sekarang masih memendam rasa penyesalan dan menyalahkan dirinya karena dia lemah. Kita harus memberitahukan kabar ini kep</VALUE>
    <VALUE Lang="cn">我现在还以为是Amaruoyin变成怪物了。相信Amanuoruoyin也是这样想的。他很爱他的妹妹，因此对于他妹妹的情况，一直深深的在自责自己的懦弱。因此要我们要赶快把事实告诉Amanuoruoyin才行。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_18_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_19_0">
    <VALUE Lang="GS">I need to concentrate on collecting accessories, but I've heard about this design layout</VALUE>
    <VALUE Lang="id">Mulai sekarang kita harus berkonsentrasi dalam mengumpulkan genuine parts..tapi kayaknya saya dengar ada rumor tentang dimana Piece of Blueprint berada</VALUE>
    <VALUE Lang="cn">从现在开始要集中精神收集零件，可是我听说好像在哪里有设计图</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_19_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_2_0">
    <VALUE Lang="GS">Like the other students, we all want to stop this chaotic situation and find a way to move that place. We found Professor Chui's experiment in hopes of discovering the answer. We followed instructions to chase something, and ended up getting separated, and then suddenly... Well, the tragedy happened. Some of them became Clone Spheres, but I don't have time to say much more. I'll give you the details later if I get the chance.</VALUE>
    <VALUE Lang="id">Sama seperti pelajar yang lain aku dan teman-teman berusaha untuk menghentikan kekacauan ini, saat kami mencari jalan untuk pergi ke dunia lain kami tahu tentang percobaan yang dilakukan oleh Professor Choi Tae Gyu</VALUE>
    <VALUE Lang="id">Kita yang percaya bahwa mungkin saja ca</VALUE>
    <VALUE Lang="cn">我和其他学生一样, 我和几个朋友想要停止这个混乱,我们寻找能移动到异界的方法过程中,知道了崔泰圭博士的实验, 或许按照实验相反的方向去追查,可能会找出结束这混乱的方法,但我们被意想不到的事情而纷纷走失了, 其中几个人却分离为复制灵,为了保护自己又无法动弹的处境,现在是找出可以帮助朋友的方法最重要,我在这样的情况下,没有时间再说明了.</VALUE>
    <VALUE Lang="cn">若以后有机会, 我会全部都告诉你.</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_20_0">
    <VALUE Lang="GS">Erm... After Chui Yin Xi read the proposal, he didn't know about the design layout! Weird…</VALUE>
    <VALUE Lang="id">Euhm kalau Sherman melihat Letter of Opinion ini, dia pasti berpikir kalau Piece of Blueprint itu ada…aneh banget</VALUE>
    <VALUE Lang="cn">"嗯….Chui Yin Xi看到意见书之后，他说没有想到会有设计图这东西！太诡异了…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_20_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_21_0">
    <VALUE Lang="GS">The rumor is true. Although we might need a few parts, it's possible to create a… Human Segregator Machine.</VALUE>
    <VALUE Lang="id">Rumor itu benar rupanya….Beberapa genuine parts mungkin sulit dicari, tapi kayaknya mesin pemisah raga bisa dibuat</VALUE>
    <VALUE Lang="cn">原来传闻是事实,虽然有几个部份很难看的懂,但是应该可以制作….人体分离器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_21_0_1">
    <VALUE Lang="GS">Ask about Human Segregator</VALUE>
    <VALUE Lang="id">Bertanya tentang mesin pemisah raga</VALUE>
    <VALUE Lang="cn">询问人体隔离器的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_22_0">
    <VALUE Lang="GS">Human Segregator... Me and my friends don't really understand. We can only guess it's a counter to the Clone Sphere.</VALUE>
    <VALUE Lang="id">Mesin pemisah raga….Kami tidak tahu tentang hidup mati kami karena suatu alasan, teman-teman saya terpisah menjadi roh jelmaan. Ini semua gara-gara mesin pemisah raga itu. Kalau ini digunakan terbalik mungkin saja saya bisa menyelamatkan teman-teman</VALUE>
    <VALUE Lang="cn">人体分离器….我和一些朋友因为某种理由的缘故,不知彼此的生死状况,朋友们说发生了分离为复制灵的事情,那些都是因为人体分离器的缘故,假如把它当作反向操作,或许可以帮助朋友</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_22_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_23_0">
    <VALUE Lang="GS">Why are you so curious? I'll tell you more about what I know later. I've come here to help my friend, so let me try to do that.</VALUE>
    <VALUE Lang="id">Saya tidak mengerti kenapa kamu tiba-tiba penasaran dengan alasan saya datang ke sini. Mungkin saja saya harus bercerita…tapi kamu cukup tahu bahwa saya kesini untuk menolong teman-teman</VALUE>
    <VALUE Lang="cn">"我不知道你?什么突然对我来这里的理由,这么好奇,以后我会慢慢说,现在我只能说,我是为了帮助朋友而来的.</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_23_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_24_0">
    <VALUE Lang="GS">Thank you, and be careful.</VALUE>
    <VALUE Lang="id">Terimakasih, tolong sampaikan dengan hati-hati</VALUE>
    <VALUE Lang="cn">谢谢您，请小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_24_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_25_0">
    <VALUE Lang="GS">You met Ruoyin? Where?</VALUE>
    <VALUE Lang="GS">Erm....</VALUE>
    <VALUE Lang="GS">Ruoyin found Yin Xi's scent... That's surprising.</VALUE>
    <VALUE Lang="GS">You must inform Yin Xi about this....</VALUE>
    <VALUE Lang="GS">I have many things I need to say, but now I can't... I need help.</VALUE>
    <VALUE Lang="id">Kamu sudah melihat Ruin? Dimana….</VALUE>
    <VALUE Lang="id">Euhm…</VALUE>
    <VALUE Lang="id">Tentu saja sangat mengejutkan kalau Ruin sudah menemukan jejak keberadaan Sherman</VALUE>
    <VALUE Lang="id">Saya harus memberi tahu bahwa Kak Sherman sudah kembali</VALUE>
    <VALUE Lang="id">Ada banyak hal yang harus aku sampaikan secara langsung, tapi ka</VALUE>
    <VALUE Lang="cn">你见到' Ruoyin'了? 在哪里?</VALUE>
    <VALUE Lang="cn">嗯…..</VALUE>
    <VALUE Lang="cn">'Ruoyin'发现了Yin Xi 的踪迹。这当然是一件非常惊讶的事情。</VALUE>
    <VALUE Lang="cn">一定要告诉Yin Xi这件事情……</VALUE>
    <VALUE Lang="cn">我要亲自转达的话非常多，但是现在这样做有点困难。我需要帮忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_25_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_3_0">
    <VALUE Lang="GS">I'll give you more details later, but now there's no time. Please deliver as quickly as you can.</VALUE>
    <VALUE Lang="id">Saya jelaskan nanti, karena sekarang kita tidak ada waktu lagi tolong serahkan ini yah.</VALUE>
    <VALUE Lang="cn">我会给您更详细的说明。但现在我没有时间。请您尽快帮忙传送过去。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_4_0">
    <VALUE Lang="GS">Is it true? Thank you.</VALUE>
    <VALUE Lang="GS">Sorry, I immediately asked for your help because this was so urgent.</VALUE>
    <VALUE Lang="id">Ah..yang benar? Terimakasih</VALUE>
    <VALUE Lang="id">Maaf karena saya bingung jadi langsung meminta bantuan</VALUE>
    <VALUE Lang="cn">这是真的吗？谢谢您。</VALUE>
    <VALUE Lang="cn">噢！抱歉，我会这么紧急的请您帮忙是因为这件事情真的非常重要。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_4_0_1">
    <VALUE Lang="GS">Ask about Problem.</VALUE>
    <VALUE Lang="id">Bertanya ada apa?</VALUE>
    <VALUE Lang="cn">询问是何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_5_0">
    <VALUE Lang="GS">I can't tell you the reason right now, but please be careful.</VALUE>
    <VALUE Lang="id">Saya masih belum bisa mengatakan apa alasannya tapi hati-hati jangan sampa ketahuan</VALUE>
    <VALUE Lang="cn">我现在不能告诉您原因，但请您一定要小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_6_0">
    <VALUE Lang="GS">If I'm not wrong, Chui Yin Xi, Head Office Chief Professor Chui's Grandson, was kidnapped by Green's Group before and lost contact. Why is he here? I've heard Professor Chui's Experiment caused all the weird things that are happening today. Yin Xi has to know something.</VALUE>
    <VALUE Lang="id">Pas sekali dengan apa yang saya perkirakan. Dia adalah orang yang bernama Sherman. Dia juga adalah cucu dari Professor Choi orang yang membangun yayasan saint. Kalau dari rumor yang saya dengar katanya dia menghilang setelah diseret ke komplotan Red Axe,</VALUE>
    <VALUE Lang="cn">我猜想果然不错, 那个人就是Chui Yin Xi，Head Office Chui董事长的孙子。听传闻说他被青组织绑架之后，成为行纵不明的状态，可是怎会出现在这里呢？以前我说过这混乱的原因是崔博士的实验造成了一些影响。身为孙子的Chui Yin Xi不可能不知道吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_6_0_1">
    <VALUE Lang="GS">Listen to the Story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_7_0">
    <VALUE Lang="GS">I saw him in training. Chui Yin Xi is the best of the best among all the students.</VALUE>
    <VALUE Lang="GS">Learning and training is good work and helpful for students. But he never slowed down, and never trusted anyone else very much.</VALUE>
    <VALUE Lang="id">Saya tahu waktu saya melihat cara latihannya. Sherman adalah pelajar yang sangat terlatih karena dia sampai bisa menjadi ketua OSIS. Belajar cara latihan mungkin saja hal baik buat kamu. Tapi jangan sampai lengah dan jangan terlalu percaya pada dia.</VALUE>
    <VALUE Lang="cn">我看到修练方法的时候,就知道了。Chui Yin Xi是连担任学生会长都能担任的非常出色的学生。学习修练方法或许对学生是有益的事情，但是不要太松懈。最好不要太过于相信他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_8_0">
    <VALUE Lang="GS">(Erm.... It might happen.....</VALUE>
    <VALUE Lang="GS">It will be hard to stay safe, my friend. Be careful.</VALUE>
    <VALUE Lang="GS">This unbelievable situation cannot be handled alone. Help and teamwork will be necessary.</VALUE>
    <VALUE Lang="GS">I hope you can give this letter to Chui Yin Xi in the future if you have the chance.</VALUE>
    <VALUE Lang="id">(Euhm…mungkin akan terjadi hal seperti ini….</VALUE>
    <VALUE Lang="id">Kalau dilihat dari situasi saya mungkin akan sulit untuk menyelamatkan teman-teman..tapi, lebih baik berhati-hati</VALUE>
    <VALUE Lang="id">Memang masih belum bisa percaya kepada semuanya tapi hal ini sulit dilakukan sendiri kare</VALUE>
    <VALUE Lang="cn">（嗯...这种事情或许会发生...。以目前我的状况去救朋友，或许会有困难......但是，还是小心一点...）</VALUE>
    <VALUE Lang="cn">虽然现在是人人都可疑的状况，单一自己的力量还是挺沉重的，可能会需要协助。</VALUE>
    <VALUE Lang="cn">若将来有机会，希望也能把我的信件送给Chui Yin Xi。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_9_0">
    <VALUE Lang="GS">That is the truth about power, and it's as true now as it was in the past. Your skills and teamwork are useless unless you work hard. Put more effort into your training.</VALUE>
    <VALUE Lang="id">Inilah awal dari semuanya. Memang benar bahwa kalian sudah menjadi lebih kuat daripada dulu, tapi kalau tidak berusaha keras ini bisa saja jadi sia-sia belaka. Jadi selalulah berusaha keras</VALUE>
    <VALUE Lang="cn">從現在開始具有與過去不同的力量是事實,但是不努力的話,也會變成沒有用的,請你付出最大的努力吧.</VALUE>
    <VALUE Lang="cn">“</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_1_0">
    <VALUE Lang="GS">Hello~</VALUE>
    <VALUE Lang="GS">I'm Ami.</VALUE>
    <VALUE Lang="id">Helo?</VALUE>
    <VALUE Lang="id">Nama saya Ami</VALUE>
    <VALUE Lang="cn">您好，我是 Ami。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_1_0_1">
    <VALUE Lang="GS">Listen to Story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">倾听故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_1_0_2">
    <VALUE Lang="GS">Help with her Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan</VALUE>
    <VALUE Lang="cn">接受她的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_2_0">
    <VALUE Lang="GS">There's a citizen who needs you to save her from some suspicious men.</VALUE>
    <VALUE Lang="GS">I can't help her, but I know you have the power to save her.</VALUE>
    <VALUE Lang="id">Orang-orang yang berada di antara makhluk-makhluk aneh meminta pertolongan… Aku sendiri tak dapat berbuat apa-apa.. Andai ada orang yang mau membantu pasti akan sangat bagus…</VALUE>
    <VALUE Lang="cn">这位平民需要您从一群可疑的男子手中解救她。我帮不了，但我知道您有足够的力量去救她的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_3_0">
    <VALUE Lang="GS">I told you before that there's a good citizen who needs your help. I know, you can do this!</VALUE>
    <VALUE Lang="id">Seperti yang aku bilang sebelumnya, orang-orang yang berada di antara makhluk-makhluk aneh meminta pertolongan. Memang dibutuhkan tenaga yang kuat, tapi aku yakin kalian dapat melakukannya.</VALUE>
    <VALUE Lang="cn">我之前有告诉过您，有一位善良的市民区要您的拯救。这次，我相信您可以的！请帮她。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_3_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_3_0_5">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_4_0">
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="GS">There are lots of shady characters involved in the kidnapping. Prepare yourself well otherwise you will be in great danger.</VALUE>
    <VALUE Lang="GS">Please take care.</VALUE>
    <VALUE Lang="id">Makasih.. Hati-hati ya… banyaknya jumlah makhluk-makhluk aneh itu memungkinkan mereka menyerangmu, kamu bisa dalam bahaya.</VALUE>
    <VALUE Lang="cn">谢谢您。</VALUE>
    <VALUE Lang="cn">有许多黑道分子参与绑架案件。 您要小心做准备，否则会遭殃的。请保重！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_5_0">
    <VALUE Lang="GS">Really?</VALUE>
    <VALUE Lang="GS">I was so worried... What load off, to see you.</VALUE>
    <VALUE Lang="id">Benar rupanya.</VALUE>
    <VALUE Lang="id">Permintaan sih permintaan tapi aku juga sedikit khawatir</VALUE>
    <VALUE Lang="id">Untung saja kamu selamat seperti ini…</VALUE>
    <VALUE Lang="cn">真的吗？我有点担心。</VALUE>
    <VALUE Lang="cn">见到了你，我就放心了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_a.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_b.ntk_1_0">
    <VALUE Lang="GS">Hello~</VALUE>
    <VALUE Lang="GS">I'm Ami.</VALUE>
    <VALUE Lang="id">Helo?</VALUE>
    <VALUE Lang="id">Nama saya Ami</VALUE>
    <VALUE Lang="cn">您好！我是Ami。</VALUE>
  </SENTENSE>
