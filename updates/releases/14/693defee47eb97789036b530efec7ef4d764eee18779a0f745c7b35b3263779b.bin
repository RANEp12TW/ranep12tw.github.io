    <VALUE Lang="GS">Art Center Purification</VALUE>
    <VALUE Lang="id">Pemberesan musuh di Art Centre</VALUE>
    <VALUE Lang="cn">Art Center净化</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_13">
