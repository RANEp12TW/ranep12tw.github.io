  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_9_0">
    <VALUE Lang="GS">- Copy Spirit</VALUE>
    <VALUE Lang="GS">Most creatures that are identified as enemies are the beings that are copied from the original body and spirit.</VALUE>
    <VALUE Lang="GS">In this document, we will call this creature a Copy Spirit.</VALUE>
    <VALUE Lang="id">- Catatan tentang roh gentayangan</VALUE>
    <VALUE Lang="id">Kebanyakan makhluk yang sudah dikonfirmasi sebagai musuh adalah mereka hasil pengopian dari sesuatu yang sebenarnya memiliki jiwa dan raga yang normal</VALUE>
    <VALUE Lang="id">Setelah ini menurut dokumen yang ada di pusat penelitian m</VALUE>
    <VALUE Lang="cn">复制灵-</VALUE>
    <VALUE Lang="cn">一般来说，被认定是敌人的生命体，几乎都是以正常的精神与肉体来做成的基础复制品。在本实验里，我们称它们为复制灵。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal1.ntk_9_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_1_0">
    <VALUE Lang="GS">This is the 30th floor security Terminal.</VALUE>
    <VALUE Lang="GS">Password is required to enter 30th floor.</VALUE>
    <VALUE Lang="id">Terminal untuk mengontrol akses keluar-masuk ke lantai 30</VALUE>
