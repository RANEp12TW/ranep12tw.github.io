    <VALUE Lang="id">Pembersihan musuh Science Center</VALUE>
    <VALUE Lang="cn">Science Center净化</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_1_0_7">
    <VALUE Lang="GS">Confirm Purification</VALUE>
    <VALUE Lang="id">Konfimasi pembersihan musuh</VALUE>
