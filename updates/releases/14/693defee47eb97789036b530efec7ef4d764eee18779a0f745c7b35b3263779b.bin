    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_3_0">
    <VALUE Lang="GS">Hunted mobs in Saint Power Plant No.2 will drop a certificate to certifiy the number of kill. Collect it and I'll help you to exchangewith some useful items. The more kill number the better the reward.</VALUE>
    <VALUE Lang="GS">*</VALUE>
    <VALUE Lang="GS">---[ Exchage Event Helper ]---</VALUE>
    <VALUE Lang="GS">*</VALUE>
    <VALUE Lang="GS">1,000 kill</VALUE>
    <VALUE Lang="GS">-&gt; Fresh water</VALUE>
    <VALUE Lang="GS">8,000 kill</VALUE>
    <VALUE Lang="GS">-&gt; Costume (1D) or Fresh water (Item to compound potion)</VALUE>
    <VALUE Lang="GS">50,000 kill</VALUE>
    <VALUE Lang="GS">-&gt; Costume (7D) or Taxi card (10P)</VALUE>
    <VALUE Lang="GS">80,000 kill</VALUE>
    <VALUE Lang="GS">-&gt; Costume (15D) or Gold beret (15D) or Ring costume (15D)</VALUE>
    <VALUE Lang="GS">150,000 kill</VALUE>
    <VALUE Lang="GS">-&gt; Costume (30D) or Gold Beret (30D) or Ring costume (30D)</VALUE>
    <VALUE Lang="GS">700,000 kill -&gt; Costume (Permanent) or Hat (Permanent)</VALUE>
    <VALUE Lang="GS">*</VALUE>
    <VALUE Lang="GS">---[ Compound ]---</VALUE>
    <VALUE Lang="GS">Red Pudding (Small)[30]</VALUE>
    <VALUE Lang="GS">= Small HP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">Red Pudding (Regular)[30]</VALUE>
    <VALUE Lang="GS">= Medium HP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">Red Pudding (Large)[50]</VALUE>
    <VALUE Lang="GS">= Daramai HP Recovery[50]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">*</VALUE>
    <VALUE Lang="GS">Blue Pudding (Small)[30]</VALUE>
    <VALUE Lang="GS">= Medium MP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">Blue Pudding (Regular)[30]</VALUE>
    <VALUE Lang="GS">= Big MP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">Blue Pudding (Large)[50]</VALUE>
    <VALUE Lang="GS">= Daramai MP Recovery[50]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">*</VALUE>
    <VALUE Lang="GS">Green Pudding (Small)[30]</VALUE>
    <VALUE Lang="GS">= Medium SP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">Green Pudding (Regular)[30]</VALUE>
    <VALUE Lang="GS">= Big SP Recovery Potion[30]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">Green Pudding (Large)[50]</VALUE>
    <VALUE Lang="GS">= Fresh water[1]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">*</VALUE>
    <VALUE Lang="GS">All pudding (Small)[30]</VALUE>
    <VALUE Lang="GS">= Small HP Recovery Potion[10]+Medium MP Recovery Potion[10]</VALUE>
    <VALUE Lang="GS">+Medium SP Recovery Potion[10]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">All pudding (Regular)[30]</VALUE>
    <VALUE Lang="GS">= Medium HP Recovery Potion[10]+Big MP Recovery Potion[10]</VALUE>
    <VALUE Lang="GS">+Big SP Recovery Potion[10]+Fresh water[1]</VALUE>
    <VALUE Lang="GS">All pudding (Large)[50]</VALUE>
    <VALUE Lang="GS">= Daramai HP Recovery[15]+Daramai SP Recovery[15]</VALUE>
    <VALUE Lang="GS">+Daramai MP Recovery[15]+Fresh water[1]</VALUE>
    <VALUE Lang="id">Hunted mobs in Saint Power Plant No.2 will drop a certificate to certifiy the number of kill. Collect it and I'll help you to exchangewith some useful items. The more kill number the better the reward.</VALUE>
    <VALUE Lang="id">*</VALUE>
    <VALUE Lang="id">---[ Exchage Event Helper ]---</VALUE>
    <VALUE Lang="id">*</VALUE>
    <VALUE Lang="id">1,000 kill</VALUE>
    <VALUE Lang="id">-&gt;</VALUE>
    <VALUE Lang="cn">Saint Power Plant No.2 的怪物会掉落一个证书来证明您消灭的数量。收集它，我会帮你兑换些有用的物品。歼灭越多，可拿到越好的奖励。</VALUE>
    <VALUE Lang="cn">--[ 兑换活动小帮手 ]---</VALUE>
    <VALUE Lang="cn">*</VALUE>
    <VALUE Lang="cn">1,000 kill</VALUE>
    <VALUE Lang="cn">-&gt; Fresh water</VALUE>
    <VALUE Lang="cn">8,000 kill</VALUE>
