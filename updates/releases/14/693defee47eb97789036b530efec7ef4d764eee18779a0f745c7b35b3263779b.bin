  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_8_0">
    <VALUE Lang="GS">What do you want to know?</VALUE>
    <VALUE Lang="id">Penasaran tentang apa?</VALUE>
    <VALUE Lang="cn">嗯…. 您想问什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_8_0_1">
    <VALUE Lang="GS">Ask about the Sword Section</VALUE>
    <VALUE Lang="id">Bertanya tentang Swordsman</VALUE>
    <VALUE Lang="cn">询问剑道部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_8_0_2">
    <VALUE Lang="GS">Ask about Training Methods</VALUE>
    <VALUE Lang="id">Bertanya tentang cara mengerjakan tugas</VALUE>
    <VALUE Lang="cn">询问修炼方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_8_0_3">
    <VALUE Lang="GS">Ask about Combat Methods</VALUE>
    <VALUE Lang="id">Bertanya tentang cara bertarung</VALUE>
    <VALUE Lang="cn">询问战斗方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_8_0_4">
    <VALUE Lang="GS">Ask about Skill Points</VALUE>
    <VALUE Lang="id">Bertanya tentang Skill Point</VALUE>
    <VALUE Lang="cn">询问技能点数</VALUE>
