    <VALUE Lang="GS">Exchange for Lv. 70 'Cestus'</VALUE>
    <VALUE Lang="id">Tukar dengan Lv. 70 'Cestus'</VALUE>
    <VALUE Lang="cn">兑换 Lv. 70 'Cestus'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_6_0_8">
    <VALUE Lang="GS">Exchange for Lv. 70 'Heavy Cestus'</VALUE>
    <VALUE Lang="id">Tukar dengan Lv. 70 'Heavy Cestus'</VALUE>
    <VALUE Lang="cn">兑换 Lv. 70 'Heavy Cestus'</VALUE>
  </SENTENSE>
