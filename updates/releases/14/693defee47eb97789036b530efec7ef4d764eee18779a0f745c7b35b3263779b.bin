    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_5">
    <VALUE Lang="GS">Force Field Optimization</VALUE>
    <VALUE Lang="id">Autentikasi Force Field</VALUE>
    <VALUE Lang="cn">结界认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_6">
    <VALUE Lang="GS">Force Field Optimization</VALUE>
    <VALUE Lang="id">Autentikasi Force Field</VALUE>
    <VALUE Lang="cn">结界认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_7">
    <VALUE Lang="GS">Force Field Optimization</VALUE>
    <VALUE Lang="id">Autentikasi Force Field</VALUE>
    <VALUE Lang="cn">结界认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_8">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Terminal Test</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_9">
    <VALUE Lang="GS">Force Field Optimization</VALUE>
    <VALUE Lang="id">Authenticate the Protective Barrier</VALUE>
    <VALUE Lang="cn">结界认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_2_0">
    <VALUE Lang="GS">The Terminal is operating properly.</VALUE>
    <VALUE Lang="id">Terminal beroperasi secara normal</VALUE>
    <VALUE Lang="cn">终端机正常运作中</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_3_0">
    <VALUE Lang="GS">The Terminal's Force Field function is operating normally.</VALUE>
    <VALUE Lang="GS">You'll need 4 Spiritual Spheres to activate the Terminal's Shielding Effect.</VALUE>
    <VALUE Lang="id">Pengoperasian Force Field di Terminal berfungsi secara normal</VALUE>
    <VALUE Lang="id">Untuk mendapatkan hasil dari Force Field kumpulkanlah Spiritual Spheres. Dibutuhkan 4 buah</VALUE>
    <VALUE Lang="cn">终端机的结界机能正常运作中。您需要4颗灵珠才能通过认证，并得到结界的能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_4_0">
    <VALUE Lang="GS">The current area's authentication is now done. Please wait until the other area's authentication is complete.</VALUE>
    <VALUE Lang="GS">You can transfer to the next Terminal to complete the Force Field activation and optimization.</VALUE>
    <VALUE Lang="id">Autentikasi Force Field telah selesai</VALUE>
    <VALUE Lang="id">Jika sisa autentikasi Force Field telah selesai hasilnya bisa di dapatkan dan untuk autentikasi Force Field berikutnya harap gunakan terminal yang sesuai</VALUE>
    <VALUE Lang="cn">已完成此区的认证, 不过要等完成其他区域的认证后, 才能获得其成效, 请移动至下一个区域的终端机.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_5_0">
    <VALUE Lang="GS">There are evil spirits roaming the Right Dragon Park.</VALUE>
    <VALUE Lang="GS">The mobs of monsters possessed by these spirits are causing strange effects to their surroundings.</VALUE>
    <VALUE Lang="GS">Please try your best to eliminate them.</VALUE>
    <VALUE Lang="id">Sebagian roh gentayangan sedang berkeliaran di dalam 'Right Dragon Park'</VALUE>
    <VALUE Lang="id">Roh Jelmaan ini dapat mempengaruhi situasi disekelilingnya. Tolong bersihkan Roh Jelmaan ini sebelum terjadi hal yang lebih buruk</VALUE>
    <VALUE Lang="cn">许多恶灵在 Right Dragon Park 里徘徊游荡。被这些恶灵所附着的怪物身上有着不良物质，导致周遭环境出现奇怪现象。请您尽全力处理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_9_0">
    <VALUE Lang="GS">.....</VALUE>
    <VALUE Lang="id">.....</VALUE>
    <VALUE Lang="cn">.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0">
    <VALUE Lang="GS">What seems to be bothering you?</VALUE>
    <VALUE Lang="id">Kacau…</VALUE>
    <VALUE Lang="cn">您在烦恼什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_2">
    <VALUE Lang="GS">Bus Driver's Request</VALUE>
    <VALUE Lang="id">Permintaan Bus Driver</VALUE>
    <VALUE Lang="cn">Bus Driver的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_3">
    <VALUE Lang="GS">Construction Supervisor's Request</VALUE>
    <VALUE Lang="id">Permintaan Construction Supervisor</VALUE>
    <VALUE Lang="cn">Construction Supervisor的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_4">
    <VALUE Lang="GS">Give the Spare Parts</VALUE>
    <VALUE Lang="id">Memberikan genuine part</VALUE>
    <VALUE Lang="cn">传达零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_5">
    <VALUE Lang="GS">Physics Teacher's Call</VALUE>
    <VALUE Lang="id">Berita panggilan dari Physics Teacher</VALUE>
    <VALUE Lang="cn">Physics Teacher的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_7">
    <VALUE Lang="GS">Check the Report</VALUE>
    <VALUE Lang="id">Mengkonfirmasi laporan</VALUE>
    <VALUE Lang="cn">确认报告书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_1_0_8">
    <VALUE Lang="GS">Deliver the Golf Clubs</VALUE>
    <VALUE Lang="id">Memberikan Golf Sticks</VALUE>
    <VALUE Lang="cn">传递Golf Clubs</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_10_0">
    <VALUE Lang="GS">Excuse me, can you help me acquire the necessary spare parts for the generator from the Technical Teacher?</VALUE>
    <VALUE Lang="id">Maaf sebelumnya, maukah kamu mengambilkan Generator Part dari Technical Teacher?</VALUE>
    <VALUE Lang="cn">不好意思, 可以帮我从Technical Teache那边拿发电机的零件来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_11_0">
    <VALUE Lang="GS">I cannot leave this area because these crazy workers might abandon their work stations if I leave.</VALUE>
    <VALUE Lang="id">Aku tidak bisa kemana-mana karena buruh-buruh stress itu, sedikit saja aku lengah bisa-bisa pekerjaanku hancur..</VALUE>
    <VALUE Lang="cn">我因为那群疯狂的劳工而动弹不得, 只怕我一离开, 他们就会将我已做好的工程都被搞砸了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_12_0">
    <VALUE Lang="GS">........</VALUE>
    <VALUE Lang="id">........</VALUE>
    <VALUE Lang="cn">........</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_13_0">
    <VALUE Lang="GS">Thank you very much for bringing these spare parts. This can help speed up the construction project for a while until something breaks down again.</VALUE>
    <VALUE Lang="id">Benar! Ini lah genuine part yang sedang kucari</VALUE>
    <VALUE Lang="id">Terima kasih banyak ya</VALUE>
    <VALUE Lang="id">Walaupun nantinya kerusakan tidak dapat dicegah, setidaknya untuk sementara waktu aku dapat bekerja</VALUE>
    <VALUE Lang="cn">没错! 这就是我之前找的零件.</VALUE>
    <VALUE Lang="cn">真是多谢.</VALUE>
    <VALUE Lang="cn">虽然没有让它不再故障的办法, 不过可以作业好一阵子了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_14_0">
    <VALUE Lang="GS">What's wrong? Why is everyone like this? Everything looks weird around here. Am I in another dimension?</VALUE>
    <VALUE Lang="id">Ngomong-nngomong apa yang terjadi, mengapa orang-orang berubah seperti itu?</VALUE>
    <VALUE Lang="cn">不过这到底是怎么搞的, 人们会变成那模样?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_15_0">
    <VALUE Lang="GS">Student!!??</VALUE>
    <VALUE Lang="GS">Oh, I think so. Now, your teacher is very busy…</VALUE>
    <VALUE Lang="GS">Okay...</VALUE>
    <VALUE Lang="id">Wooot, ternyata kamu yang diutus ya? Tapi tidak apa-apa, tapi apa boleh buat, sekarang sudah tidak ada waktu lagi</VALUE>
    <VALUE Lang="cn">学生！！？？</VALUE>
    <VALUE Lang="cn">噢！我了解了！您的老师现在很忙……</VALUE>
    <VALUE Lang="cn">好的………….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_15_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_16_0">
    <VALUE Lang="GS">Oh, no. I know I keep calling on the students, but there's no other way to solve this problem. We're running out of resources.</VALUE>
    <VALUE Lang="GS">Would you collect some golf clubs from the Training Ground?</VALUE>
    <VALUE Lang="id">Ups, jadi keterusan manggil para pelajar deh</VALUE>
    <VALUE Lang="id">Tidak bisa, kita saja kekurangan orang dan material jadi sangat kacau</VALUE>
    <VALUE Lang="id">Kita kekurangan material untuk konstruksi interior, jadi sebagai gantinya dibutuhkan material lain yang kira-kira berguna</VALUE>
    <VALUE Lang="id">Jadi, per</VALUE>
    <VALUE Lang="cn">哎！只能继续叫学生。这边人员不足加上物资缺乏，内部工程上使用的材料需要拿这些采用的来替代。可否跑趟Training Ground高尔夫场拿高尔夫球杆过来呢?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_17_0">
    <VALUE Lang="GS">Oh, that's good enough!</VALUE>
    <VALUE Lang="GS">I'm sorry, I wouldn't be asking favors if our workers actually pulled their own weight.</VALUE>
    <VALUE Lang="GS">Anyway, I appreciate your help.</VALUE>
    <VALUE Lang="GS">Although we like it, the Sacred Financial Group helps people too much.</VALUE>
    <VALUE Lang="id">Oo, oke segini saja sudah cukup!</VALUE>
    <VALUE Lang="id">Kalau saja para pekerja kita bisa mengerjakan pekerjaan mereka dengan benar, pasti aku tidak memerlukan bantuan…</VALUE>
    <VALUE Lang="id">Makasih ya</VALUE>
    <VALUE Lang="id">Bagaimanapun, Yayasan Saint telah memberikan sesuatu yang baik~</VALUE>
    <VALUE Lang="id">Tapi, kita yang lebih</VALUE>
    <VALUE Lang="cn">"哦。这些就可以了!</VALUE>
    <VALUE Lang="cn">我们的工人如果好好做事的话我也不会拜托你，谢谢你学生！</VALUE>
    <VALUE Lang="cn">我觉得圣财团这个地方是专门做好事的地方。对我们来说是很好。 "</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_2_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">... …..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_3_0">
    <VALUE Lang="GS">The deadline for this construction is drawing near, and the project supervisor is missing.</VALUE>
    <VALUE Lang="id">Dulu aku yang mengawasi konstruksi ini, sekarang jadi hancur begini.</VALUE>
    <VALUE Lang="id">Gawat sekali~ Padahal batas waktu konstruksinya hampir tiba</VALUE>
    <VALUE Lang="cn">本来在旁边管理工程, 现在却躲的远远的.</VALUE>
    <VALUE Lang="cn">大事不妙~ 工程期限就快到了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_4_0">
    <VALUE Lang="GS">It's troubling to know most of the people at the construction site are acting funny and most of the machinery broke down. There's going to be a delay in the construction work, and the site is just full of turmoil.</VALUE>
    <VALUE Lang="id">Padahal saya harus kerja</VALUE>
    <VALUE Lang="cn">是该做事没错, 不过人们变的怪怪的, 机器也故障, 实在麻烦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_4_0_1">
    <VALUE Lang="GS">Ask about Crazy People</VALUE>
    <VALUE Lang="id">Bertanya siapa anda</VALUE>
    <VALUE Lang="cn">询问那些发狂的人们</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_5_0">
    <VALUE Lang="GS">Oh, please get rid of those stubborn students! We can't get anything done with them around!</VALUE>
    <VALUE Lang="GS">We've got enough trouble as it is!</VALUE>
    <VALUE Lang="id">Wooot, pelajar seperti kamu yang disuruh toh?</VALUE>
    <VALUE Lang="id">Waktu sudah tidak cukup lagi... Terpakas.. Gpp deh?!</VALUE>
    <VALUE Lang="cn">喔, 把这种学生送走吧...</VALUE>
    <VALUE Lang="cn">没时间没办法呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_5_0_1">
    <VALUE Lang="GS">Construction Supervisor's Request</VALUE>
    <VALUE Lang="id">Permintaan Construction Supervisor</VALUE>
    <VALUE Lang="cn">Construction Supervisor的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_6_0">
    <VALUE Lang="GS">Student! Please listen to my request...</VALUE>
    <VALUE Lang="GS">In order to complete construction by the deadline, we must replace these crazy workers with efficiently working machinery. The problem is that the generator is broken.</VALUE>
    <VALUE Lang="GS">This just makes things more complicated!</VALUE>
    <VALUE Lang="id">Aku mau mendengarkan permintaan para pelajar</VALUE>
    <VALUE Lang="id">Untuk menggantikan para buruh yang stress, aku harus menggilir mesin-mesin ini dengan waktu yang terbatas, sekarang, Generator pun rusak</VALUE>
    <VALUE Lang="cn">听听我的请求...</VALUE>
    <VALUE Lang="cn">为了要在期限内完工, 必须要使用机器人来代替疯掉的工人们, 但是现在竟然连发电机都坏掉了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_6_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_7_0">
    <VALUE Lang="GS">My friend from the Sword Section told me that this is not the only area where strange things started to happen. Can you imagine what'll happen to our world if this keeps up?</VALUE>
    <VALUE Lang="id">Beberapa waktu lalu, saya mendengar cerita dari teman saya yang juga seorang pelajar Sword, hanya tempat ini saja yang masih normal?!</VALUE>
    <VALUE Lang="id">wah…benar-benar… kacau…</VALUE>
    <VALUE Lang="cn">听听我的请求...</VALUE>
    <VALUE Lang="cn">为了要在期限内完工, 必须要使用机器人来代替疯掉的工人们, 但是现在竟然连发电机都坏掉了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_7_0_1">
    <VALUE Lang="GS">Physics Teacher's Call</VALUE>
    <VALUE Lang="id">Panggilan dari Physics Teacher</VALUE>
    <VALUE Lang="cn">Physics Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_8_0">
    <VALUE Lang="GS">I'm scared about the news that will come from the Physics Teacher at Sacred Gate College.</VALUE>
    <VALUE Lang="GS">We need to meet him at the Sacred Gate Ring.</VALUE>
    <VALUE Lang="id">Aaaa, hampir saja lupa</VALUE>
    <VALUE Lang="id">Tadi ada telepon dari orang yang mengaku sebagai Physics Teacher di Sacred Gate School</VALUE>
    <VALUE Lang="id">Mungkin dia sedang menunggu di Sacred Gate Ring</VALUE>
    <VALUE Lang="cn">阿. 差点吓死...</VALUE>
    <VALUE Lang="cn">刚刚Sacred Gate College的Physics Teacher那边有消息传来</VALUE>
    <VALUE Lang="cn">我们会去Sacred Gate Ring找他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_workmaster1.ntk_9_0">
    <VALUE Lang="GS">......</VALUE>
    <VALUE Lang="id">......</VALUE>
    <VALUE Lang="cn">......</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0">
    <VALUE Lang="GS">Hmmm...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">…..嗯…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">与Bus Driver进行对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_2">
    <VALUE Lang="GS">Bus Driver's Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan Bus Driver</VALUE>
    <VALUE Lang="cn">Bus Driver的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_3">
    <VALUE Lang="GS">Give the Spare Parts</VALUE>
    <VALUE Lang="id">Menyerahkan Genuine Parts</VALUE>
    <VALUE Lang="cn">交付零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_4">
    <VALUE Lang="GS">Bus Driver's 2nd Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan kedua Bus Driver</VALUE>
    <VALUE Lang="cn">Bus Driver的请求2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_5">
    <VALUE Lang="GS">Ask if he needs help</VALUE>
    <VALUE Lang="id">Tanya apa dia butuh bantuan</VALUE>
    <VALUE Lang="cn">询问他是否需要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_1_0_6">
    <VALUE Lang="GS">Tell him what happened</VALUE>
    <VALUE Lang="id">Beritahu apa yang terjadi</VALUE>
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_10_0">
    <VALUE Lang="GS">The problem with the bus started a few days ago, and it's been getting worse since then. The bus won't even move at all now. It seems that the other buses in the area are having similar problems.</VALUE>
    <VALUE Lang="id">Sejak beberapa hari lalu kondisi bus tiba-tiba mulai aneh, bahkan sekarang tidak bergerak sama sekali…</VALUE>
    <VALUE Lang="id">Bus-bus yang lainnya juga tidak kelihatan, mungkin terjadi masalah yang sama.</VALUE>
    <VALUE Lang="cn">几天前开始，公车就故障了。而且越来越严重，连发动都成问题了。好像此地区的其他公车也都有类似的问题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_11_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_12_0">
    <VALUE Lang="GS">Excuse me. Would you be so kind to help me acquire some spare parts from the Technical Teacher located near the college Crossroads so that I can get this bus moving again?</VALUE>
    <VALUE Lang="id">Maaf, tapi bisa tolong ambil genuine parts dari Technical Teacher yang ada di sekitar Lake Water Park nggak?</VALUE>
    <VALUE Lang="cn">不好意思，您可以帮我从Technical Teacher那儿要一点零件过来吗？ 他就在学院交叉路口那里。唯有如此我才能修好公车，使它发动成功！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_13_0">
    <VALUE Lang="GS">그럼 이 버스도 움직일 수 있게 될 거고, 학생들도 조금은 편해지겠지</VALUE>
    <VALUE Lang="id">그럼 이 버스도 움직일 수 있게 될 거고, 학생들도 조금은 편해지겠지</VALUE>
    <VALUE Lang="cn">그럼 이 버스도 움직일 수 있게 될 거고, 학생들도 조금은 편해지겠지</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_13_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_14_0">
    <VALUE Lang="GS">"Have you ever been to MP Hole? If so then you must have met those inferior Green Mask (Uncle Potato). Because of their threats I am afraid to drive the bus.</VALUE>
    <VALUE Lang="GS">If you can please defeat them and scare them away."</VALUE>
    <VALUE Lang="id">Apa kamu pernah ke MP Hole ? Jika iya, kamu pasti pernah bertemu dengan Green Mask. Karena kelakuannya, Saya jadi takut untuk mengendarai bus.</VALUE>
    <VALUE Lang="id">Bisakah kamu mengalahkannya?</VALUE>
    <VALUE Lang="cn">您有去过SG Hole了吗？如果有去过的话，那您一定有见过那些坏心的 Green Mask (Uncle Potato)。因为他们威胁我，甚至想我勒索。因此我连公车都不敢开了。</VALUE>
    <VALUE Lang="cn">如果可以的话，请您帮我打退他们。好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_14_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_15_0">
    <VALUE Lang="GS">Thanks! Now I will be able to drive this bus around.</VALUE>
    <VALUE Lang="id">Terima kasih! Sekarang saya merasa jauh lebih tenang.</VALUE>
    <VALUE Lang="cn">谢谢您，现在我终于可以开公车载学生上下学了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_15_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_2_0">
    <VALUE Lang="GS">....</VALUE>
    <VALUE Lang="id">....</VALUE>
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_3_0">
    <VALUE Lang="GS">You want to know more about the Bus? Hahaha!</VALUE>
    <VALUE Lang="GS">Obviously, the Bus is used by students in order to move from one area to another. It is a more convenient means of transportation compared to walking or running around by foot.</VALUE>
    <VALUE Lang="id">hoho…</VALUE>
    <VALUE Lang="id">Tentu saja, naiklah Bus.</VALUE>
    <VALUE Lang="id">Andai saja busnya bisa digunakan pasti akan sangat mudah berpergian, sekarang harus berlari deh.</VALUE>
    <VALUE Lang="cn">当然，公车曾被学生们当作通勤的工具。可以传送地点是真的非常方便的事情。比起用跑的，公车真的太方便了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_3_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_4_0">
    <VALUE Lang="GS">Oops! I'm sorry! I didn't know you were there!</VALUE>
    <VALUE Lang="GS">I've been very busy trying to find out what the hell is wrong with this wreck!</VALUE>
    <VALUE Lang="id">Euhm, sebentar</VALUE>
    <VALUE Lang="cn">噢！我很抱歉，我不知道您在这儿！ 我正忙着找出这些不对劲的原因。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_4_0_1">
    <VALUE Lang="GS">Ask What He is Doing</VALUE>
    <VALUE Lang="id">Bertanya apa yang harus dilakukan</VALUE>
    <VALUE Lang="cn">询问他在做什么？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_5_0">
    <VALUE Lang="GS">Oh! This bus is unoperational. I can't even get this thing to work. I really need to fix this bus so that the students can travel safely. It's dangerous to just walk around with all the chaos in the outskirts.</VALUE>
    <VALUE Lang="GS">It's too bad there aren't any spare parts available to fix this thing.</VALUE>
    <VALUE Lang="id">Euhm, kenapa nieh bis nggak mau jalan sieh?</VALUE>
    <VALUE Lang="id">Yah….. partnya juga nggak ada, gimana nieh?</VALUE>
    <VALUE Lang="cn">噢！这台公车无法使用。连我都无法用它来进行工作。我得把它修好，这样学生们才能安全使用。毕竟在这混乱地区独自行走，是非常危险的事情。但现在没有修理用的零件，情况真糟糕。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_5_0_1">
    <VALUE Lang="GS">Ask the Driver more about Bus</VALUE>
    <VALUE Lang="id">Bertanya tentang bus</VALUE>
    <VALUE Lang="cn">询问Driver关于更多的公车情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_6_0">
    <VALUE Lang="GS">Based on my assessment of this wreckage, I can say that repairing this bus shouldn't be a major problem. The spare parts required to repair this vehicle, however, need to be acquired as soon as possible. I can't repair this bus unless I can get all the necessary spare parts.</VALUE>
    <VALUE Lang="id">Bukan rusak yang berat…</VALUE>
    <VALUE Lang="id">Tidak ada genuine partnya jadi tidak bisa dibetulin?!..</VALUE>
    <VALUE Lang="cn">根据公车残骸的报告评估，我可以说，修理这辆车不应该是个大问题。修复此车所需的零件，需要尽快收集到才行。在我能得到所有必要的配备之前，我是无法进行修理的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_6_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_7_0">
    <VALUE Lang="GS">Thank you for bringing the spare parts I need. I can finally start repairing this wreck. The students can use the bus to conveniently move from one area to another once I'm done fixing it.</VALUE>
    <VALUE Lang="id">Naah, ini genuine part yang dicari</VALUE>
    <VALUE Lang="id">Akhirnya sekarang bisa juga dibetulin</VALUE>
    <VALUE Lang="id">Sekarang para pelajar pun bisa naik bus dan berpergian dengan mudah</VALUE>
    <VALUE Lang="cn">谢谢您带来我要的零件了！我终于可以开始修 破损的公车了！从现在起，学生们往来其他地区间时，会更加的方便与安全唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_7_0_1">
    <VALUE Lang="GS">Bus Driver's 2nd Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan kedua Bus Driver</VALUE>
    <VALUE Lang="cn">Bus Driver的请求2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_8_0">
    <VALUE Lang="GS">Please visit the Construction Supervisor located near the crossroads of the Mystic Peak Campus.</VALUE>
    <VALUE Lang="GS">I heard he has a favor to ask from me, but I can't visit him myself because of this bus problem.</VALUE>
    <VALUE Lang="id">Bisa tolong temui Construction Supervisor di sekitar Twin City nggak?</VALUE>
    <VALUE Lang="id">Ada pekerjaan yang sulit sehingga dia memanggil, karena bus tidak jalan jadi aku susah pergi kesana…</VALUE>
    <VALUE Lang="cn">请您去拜访Construction Supervisor，他位在Sacred Gate Campus的交叉路那儿。我听说他想请我帮忙，但我无法去找他，因为我得处理公车的问题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busdriver1.ntk_9_0">
    <VALUE Lang="GS">....</VALUE>
    <VALUE Lang="id">....</VALUE>
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0">
    <VALUE Lang="GS">This is the Bus Stop.</VALUE>
    <VALUE Lang="GS">Once have your Bus Ticket ready, you can use the Bus Service to move to another area.</VALUE>
    <VALUE Lang="id">Informasi rute bus kota</VALUE>
    <VALUE Lang="id">Untuk menggunakan bus cukup menunjukan tiket</VALUE>
    <VALUE Lang="cn">这里是公车站。只要您拥有Bus Ticket ，就可以使用公车服务，畅游各地区唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0_1">
    <VALUE Lang="GS">Ride the Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0_2">
    <VALUE Lang="GS">Ride the Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_0_3">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Beli tiket</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_1">
    <VALUE Lang="GS">This is the Bus Stop.</VALUE>
    <VALUE Lang="GS">Once have your Bus Ticket ready, you can use the Bus Service to move to another area.</VALUE>
    <VALUE Lang="id">Informasi rute bus kota</VALUE>
    <VALUE Lang="id">Untuk menggunakan bus cukup menunjukan tiket</VALUE>
    <VALUE Lang="cn">这里是公车站。只要您拥有Bus Ticket ，就可以使用公车服务，畅游各地区唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_1_1">
    <VALUE Lang="GS">Ride the Bus</VALUE>
    <VALUE Lang="id">Naik bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_1_1_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Beli tiket</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_2_0">
    <VALUE Lang="GS">You can't take bus, now.</VALUE>
    <VALUE Lang="id">Bus sedang rusak, untuk sekarang bus tidak bisa digunakan</VALUE>
    <VALUE Lang="id">Maaf untuk ketidak nyamanan ini</VALUE>
    <VALUE Lang="cn">您现在无法使用公车服务。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_busteminal.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0">
    <VALUE Lang="GS">I'm not sure how the streets got to be this dangerous. I'm so lucky to have found a safe place to hide!</VALUE>
    <VALUE Lang="GS">Sheesh! I really don't know what'll happen to me if I'm not careful.</VALUE>
    <VALUE Lang="id">Entah mengapa wilayah sekitar sini menjadi seperti ini</VALUE>
    <VALUE Lang="id">Beruntung kamu masih bisa bernafas disini</VALUE>
    <VALUE Lang="id">Jika saja kamu ada saat itu, tidak tahu apa yang akan terjadi sekarang…</VALUE>
    <VALUE Lang="cn">街道不知道为什么会变成这样</VALUE>
    <VALUE Lang="cn">最后还可以躲来这里算是幸运了</VALUE>
    <VALUE Lang="cn">一不小心的话现在会变怎样都不知道</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_1">
    <VALUE Lang="GS">What are you talking about?</VALUE>
    <VALUE Lang="id">Bertanya siapa anda</VALUE>
    <VALUE Lang="cn">您在说些什么？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_2">
    <VALUE Lang="GS">Listen to Cleaner's Advice</VALUE>
    <VALUE Lang="id">Mendengarkan nasihat Cleaner</VALUE>
    <VALUE Lang="cn">听取Cleaner的忠告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_3">
    <VALUE Lang="GS">Delivering the Recycled Trash</VALUE>
    <VALUE Lang="id">Menyerahkan item-item Recycle</VALUE>
    <VALUE Lang="cn">交付回收型垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_1_0_4">
    <VALUE Lang="GS">Deliver Recycled Trash</VALUE>
    <VALUE Lang="id">Menyerahkan item-item Recycle</VALUE>
    <VALUE Lang="cn">交付回收型垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_2_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_3_0">
    <VALUE Lang="GS">You still have no idea after seeing it? Things suddenly got weird while I was cleaning the streets. You should be careful strolling around this area. It is really dangerous!</VALUE>
    <VALUE Lang="id">Bisa kamu lihat kan? Tiba-tiba jadi seperti ini kan pada saat bersih-bersih di daerah sini</VALUE>
    <VALUE Lang="cn">看了还不知道吗? 清扫街道的时候突然就变成这样了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_4_0">
    <VALUE Lang="GS">Ever since these events happened, we never had the chance to run away. No one is left to do the cleaning up till now.</VALUE>
    <VALUE Lang="id">Dahulu walaupun dibersihkan setiap hari, pengumpulan item-item Recycled pun juga dilakukan setiap hari</VALUE>
    <VALUE Lang="id">Sekarang jangankan bersih-bersih, saya sibuk melarikan diri kesana kemari</VALUE>
    <VALUE Lang="cn">从那件事情发生之后，我们一直没有机会逃走。到现在没有一个人愿意留下来做打扫……。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_4_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_5_0">
    <VALUE Lang="GS">We really have to treasure all kinds of resources. I'll ask for your help later in case you have any spare time to assist me.</VALUE>
    <VALUE Lang="GS">I'll exchange the stuff that you collect for me with any of my other items.</VALUE>
    <VALUE Lang="id">Terima kasih untuk kerja keras kalian para pelajar</VALUE>
    <VALUE Lang="id">Gunakan material secukupnya, nanti jika waktu memungkinkan mohon bantuannya lagi</VALUE>
    <VALUE Lang="id">Hanya dengan mengumpulkan dan datang saja aku akan menggantikannya dengan yang lain</VALUE>
    <VALUE Lang="cn">辛苦了学生们</VALUE>
    <VALUE Lang="cn">因为要好好珍惜物资,往后有时间再好好拜托你们了</VALUE>
    <VALUE Lang="cn">你们帮我收集来的话就用其他的东西跟你们​​</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_6_0">
    <VALUE Lang="GS">.....</VALUE>
    <VALUE Lang="id">.....</VALUE>
    <VALUE Lang="cn">.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_7_0">
    <VALUE Lang="GS">We'll have problems in the future if we continue to be careless with our resources. Let's help each other gather what we'll need to survive this chaos.</VALUE>
    <VALUE Lang="id">Kebetulan kita sedang kekurangan material, jika sedikit saja tidak bisa dikumpulkan kedepannya akan lebih sulit</VALUE>
    <VALUE Lang="cn">连物资都不够, 乱七八糟, 连一点也募集不到的话, 往后就更惨了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_7_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_8_0">
    <VALUE Lang="GS">It'd be a good start if you help me collect Empty Bottles. Please remember to use your medicinal supplies carefully. We need to conserve our resources during these times.</VALUE>
    <VALUE Lang="id">Kumpulkanlah Empty Bottles saja dan abaikan yang lainnya</VALUE>
    <VALUE Lang="id">Setidaknya kalian harus bisa menjaga Medicines tersebut</VALUE>
    <VALUE Lang="cn">其他都别管,但是请一定帮我收集空瓶过来</VALUE>
    <VALUE Lang="cn">再怎么没办法也要好好保管药品啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_cleaner1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_extraacti.ntk_1_0">
    <VALUE Lang="GS">Items which you can earn through Normal Extra Activities are exceptional.</VALUE>
    <VALUE Lang="id">Yah memang tidak mudah mendapatkan item dari kegiatan ekstrakulikuler menengah.</VALUE>
    <VALUE Lang="cn">中级特别活动可取得的道具当然是比较特别的呀！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_extraacti.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual-beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0">
    <VALUE Lang="GS">The Terminal located in the Basic Science Classroom is not functioning properly. Please attend to this problem immediately.</VALUE>
    <VALUE Lang="id">Terminal Basic Science Classroom</VALUE>
    <VALUE Lang="id">Saat ini di dalam sekolah terjadi kesalahan perhitungan, tolong diperhatikan</VALUE>
    <VALUE Lang="cn">Basic Science Classroom终端机，现在因为学院里面电脑错误无法正常运转。请留意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_1">
    <VALUE Lang="GS">Activate Authentication</VALUE>
    <VALUE Lang="id">Konfirmasi pengaktifan</VALUE>
    <VALUE Lang="cn">启动认证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_2">
    <VALUE Lang="GS">Retrieve Information</VALUE>
    <VALUE Lang="id">Mencari data</VALUE>
    <VALUE Lang="cn">资料检索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_3">
    <VALUE Lang="GS">Retrieve Information</VALUE>
    <VALUE Lang="id">Mencari data</VALUE>
    <VALUE Lang="cn">资料检索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_4">
    <VALUE Lang="GS">Retrieve Information</VALUE>
    <VALUE Lang="id">Mencari data</VALUE>
    <VALUE Lang="cn">资料检索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_5">
    <VALUE Lang="GS">Retrieve Information</VALUE>
    <VALUE Lang="id">Mencari data</VALUE>
    <VALUE Lang="cn">资料检索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_1_0_6">
    <VALUE Lang="GS">Retrieve Information</VALUE>
    <VALUE Lang="id">Mencari data</VALUE>
    <VALUE Lang="cn">资料检索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_2_0">
    <VALUE Lang="GS">Due to the errors found in the School's</VALUE>
    <VALUE Lang="GS">Information Center System,</VALUE>
    <VALUE Lang="GS">the Information Room has all the available</VALUE>
    <VALUE Lang="GS">information contained within these 2 files.</VALUE>
    <VALUE Lang="GS">We will restore all necessary information</VALUE>
    <VALUE Lang="GS">as soon as we resolve the situation.</VALUE>
    <VALUE Lang="GS">For the meantime, you can stay and browse</VALUE>
    <VALUE Lang="GS">through these two documents.</VALUE>
    <VALUE Lang="id">Karena kerusakan yang terjadi pada sitem data base di dalam sekolah, hanya 2 buah data yang tersimpan di Information Room saat ini.</VALUE>
    <VALUE Lang="id">Kami akan berusaha untuk meperbaiki kerusakan secepatnya.</VALUE>
    <VALUE Lang="id">Apakah kamu ingin membaca 2 data tadi?</VALUE>
    <VALUE Lang="cn">因为学院资料库系统故障，资料室现在只能储存2份档案。我们会尽快复原所有重要的资料。请稍微阅读一下这份文件，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_2_0_1">
    <VALUE Lang="GS">Ask about the Sword Section Student named Chi Ri Qing</VALUE>
    <VALUE Lang="id">Pencarian data tentang Chi Ri Qing dari kelas Sword</VALUE>
    <VALUE Lang="cn">询问关于剑道部学生 Chi Ri Qing。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_2_0_2">
    <VALUE Lang="GS">Ask about the Archery Section Student named Cheng Xi Zhi</VALUE>
    <VALUE Lang="id">Pencarian data tentang Cheng Xi Zhi dari kelas Archery</VALUE>
    <VALUE Lang="cn">询问关于弓箭部学生 Cheng Xi Zhi。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_3_0">
    <VALUE Lang="GS">Chi Ri Qing is a Sacred Gate Campus 2nd Year Student. He is a former Trainee of the Sword Section Class. His background is very interesting: both of his parents died in a chaotic incident.</VALUE>
    <VALUE Lang="GS">Since then, he left the school carrying out his own investigation about the incident.</VALUE>
    <VALUE Lang="GS">If you have seen or have any information about this student, please contact the Administration Office immediately.</VALUE>
    <VALUE Lang="id">Sacred Gate School kelas 2</VALUE>
    <VALUE Lang="id">Pelajar training kelas Sword</VALUE>
    <VALUE Lang="id">Keahliannya menggambar sketsa orang</VALUE>
    <VALUE Lang="id">Kedua orang tuanya meninggal karena kecelakaan</VALUE>
    <VALUE Lang="id">Sekarang sedang melakukan penyelidikan di luar sekolah</VALUE>
    <VALUE Lang="id">Apabila telah ditemukan harap segera melaporka</VALUE>
    <VALUE Lang="cn">Chi Ri Qing是Sacred Gate Campus2年级的剑道部修练生。双亲都因为事故而死亡，现在离开学院，单独进行调查。</VALUE>
    <VALUE Lang="cn">万一您有发现新情报的话，请您跟Administration Office连络。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_4_0">
    <VALUE Lang="GS">Cheng Xi Zhi is a 2nd Year student from the Sacred Gate Campus, and a former trainee of the Archery Section. Both of her parents died in the catastrophic phenomenon that caused the major problems in our world. She is now using her Evil Spirit to find her mutated older sister.</VALUE>
    <VALUE Lang="GS">This student has important information regarding the location of Leonair Campus. We must get in contact with her immediately.</VALUE>
    <VALUE Lang="id">Sacred Gate School kelas 2</VALUE>
    <VALUE Lang="id">Pelajar training kelas Archery</VALUE>
    <VALUE Lang="id">Kedua orang tuanya meninggal karena kecelakaan</VALUE>
    <VALUE Lang="id">Saat ini dia sedang beraktivitas mencari kakaknya yang telah menjadi Roh Jelmaan</VALUE>
    <VALUE Lang="id">Ada kabar bahwa lokasi Leonine School telah diketahui, de</VALUE>
    <VALUE Lang="cn">Cheng Xi Zhi是Sacred Gate Campus2年级的弓箭部修练生。双亲都因事故而亡，现在以复制灵追寻已变异的姐姐，单独进行中。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_gichogwahak1.ntk_5_0">
    <VALUE Lang="GS">There are no means to keep this Terminal to function Properly.</VALUE>
    <VALUE Lang="id">Saat ini terminal tidak berfungsi dengan baik</VALUE>
    <VALUE Lang="cn">现在没有方法可以维持终端机的机能正常运转。</VALUE>
  </SENTENSE>
