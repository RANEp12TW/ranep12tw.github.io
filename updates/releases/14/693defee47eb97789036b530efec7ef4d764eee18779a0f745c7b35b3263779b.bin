  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_17_0">
    <VALUE Lang="GS">If you are a new student who has just joined then reach Lv.10 and come back to me for a weapon. However, existing students who doesn't meet the conditions would just better continue their training.</VALUE>
    <VALUE Lang="id">If you are a new student who has just joined then reach Lv.10 and come Kembali to me for a weapon. However, existing students who doesn't meet the conditions would just better continue their training.</VALUE>
    <VALUE Lang="cn">通常新生练到10级就可以来找我领取武器。尚未符合资格的学生请继续加油哟。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_17_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_18_0">
    <VALUE Lang="GS">You haven't reached level 10.</VALUE>
    <VALUE Lang="GS">It's a piece of a cake so become level 10 and come back then, I will give you a fine weapon as a gift.</VALUE>
    <VALUE Lang="id">You haven't reached level 10.</VALUE>
    <VALUE Lang="id">It's a piece of a cake so become level 10 and come Kembali then, I will give you a fine weapon as a gift.</VALUE>
    <VALUE Lang="cn">你还没有达到10级。</VALUE>
    <VALUE Lang="cn">这是一块蛋糕，成为10级后，我会给你一个不错的武器作为礼物。</VALUE>
  </SENTENSE>
