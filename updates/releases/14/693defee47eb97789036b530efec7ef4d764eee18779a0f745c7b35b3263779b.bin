  <SENTENSE Ver="1" Id="npc_e2_oldman.ntk_24_0">
    <VALUE Lang="GS">Hm…</VALUE>
    <VALUE Lang="GS">I'm not just an old man. Let me guess. You're dying to know about the Sacred Financial Group.</VALUE>
