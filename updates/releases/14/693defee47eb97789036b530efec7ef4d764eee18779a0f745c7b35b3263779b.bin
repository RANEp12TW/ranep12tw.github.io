  <SENTENSE Ver="1" Id="npc_1_suryun_1.ntk_1_0">
    <VALUE Lang="GS">Welcome to the Training Yard!</VALUE>
    <VALUE Lang="GS">Feel free to explore and use the facilities available in this area. If you would like to move to another area or Campus, then you may take one of the many buses here. Please remember to have your Bus Ticket ready before using the Bus Services.</VALUE>
    <VALUE Lang="GS">You can change your Save Point here if you like.</VALUE>
    <VALUE Lang="id">Selamat Datang di Training Yard!</VALUE>
    <VALUE Lang="id">Silahkan menggunakan layanan di sini sepuasnya.</VALUE>
    <VALUE Lang="id">Jangan lupa kamu harus mempunyai tiket bus untuk menggunakan busnya.</VALUE>
    <VALUE Lang="id">Kamu dapat menyimpan tempat save kamu di sini.</VALUE>
    <VALUE Lang="cn">欢迎来到Training Yard！</VALUE>
    <VALUE Lang="cn">请尽情探索，并随意使用各种设备。如果您想移动到另一个地区或校园，请你可以选择搭乘公车. 公车有很多辆的.</VALUE>
    <VALUE Lang="cn">请记得先准备好您的Bus Ticket，才能够使用巴士服务.</VALUE>
    <VALUE Lang="cn">如果您愿意，在这边您也可以改变您的开始地点唷.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_suryun_1.ntk_1_0_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Ganti titik awal</VALUE>
    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_1_0">
    <VALUE Lang="GS">This is the Archery Training Room. Please go back to your own place unless you've got something important to ask me.</VALUE>
    <VALUE Lang="id">Menjadi Archery Instructor sangat sibuk</VALUE>
    <VALUE Lang="id">Pelajar lainnya harap menemui instructor masing-masing</VALUE>
    <VALUE Lang="id">Jika urusan kamu cuma mau membuang item, itu lain lagi ceritanya</VALUE>
    <VALUE Lang="cn">这里是弓箭部的房间。若没有急事要求助，请回归属于您部门的地方。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_1_1">
    <VALUE Lang="GS">Hmm? You seem pretty alert and attentive.</VALUE>
    <VALUE Lang="id">Emmm, kerja yang bagus</VALUE>
    <VALUE Lang="cn">嗯~ 您看起来挺用心的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_1_1_1">
