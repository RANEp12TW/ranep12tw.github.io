  <SENTENSE Ver="1" Id="npc_3_library_1.ntk_6_0">
    <VALUE Lang="GS">운동장 내부에는 일부의 복사령들이 활동중입니다</VALUE>
    <VALUE Lang="id">운동장 내부에는 일부의 복사령들이 활동중입니다</VALUE>
    <VALUE Lang="cn">운동장 내부에는 일부의 복사령들이 활동중입니다</VALUE>
