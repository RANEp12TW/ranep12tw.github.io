  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_13_0">
    <VALUE Lang="GS">That's right! These are the spare parts I'm looking for. Thank you very much!</VALUE>
    <VALUE Lang="GS">This can help our construction project for a while until something breaks down again. I'm keeping my fingers crossed that something like that won't happen...</VALUE>
    <VALUE Lang="id">Benar! Ini lah genuine part yang sedang kucari</VALUE>
    <VALUE Lang="id">Terima kasih banyak ya</VALUE>
    <VALUE Lang="id">Walaupun nantinya kerusakan tidak dapat dicegah, setidaknya untuk sementara waktu aku dapat bekerja</VALUE>
    <VALUE Lang="cn">没错! 这就是我之前找的零件</VALUE>
    <VALUE Lang="cn">真是多谢</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_14_0">
    <VALUE Lang="GS">What's wrong? Why is everyone like this? Everything looks weird around here. Am I in another dimension?</VALUE>
    <VALUE Lang="id">Ngomong-nngomong apa yang terjadi, mengapa orang-orang berubah seperti itu?</VALUE>
    <VALUE Lang="id">Beberapa waktu lalu, saya mendengar cerita dari teman saya yang juga seorang pelajar Sword, hanya tempat ini saja yang masih normal?!</VALUE>
    <VALUE Lang="cn">虽然没有让它不再故障的办法, 不过可以作业好一阵子了.</VALUE>
    <VALUE Lang="cn">不过这到底是怎么搞的, 人们会变成那模样?</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_2_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">... …..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_3_0">
    <VALUE Lang="GS">The supervisor in charge of this construction project is hiding!</VALUE>
    <VALUE Lang="GS">This is bad! Our construction deadline is close!</VALUE>
    <VALUE Lang="id">Dulu saya bertugas untuk memperbaik bagian dalam dari gedung ini, kalau sekarang lagi ngungsi</VALUE>
    <VALUE Lang="id">Gawat sekali~ Padahal batas waktu konstruksinya hampir tiba</VALUE>
    <VALUE Lang="cn">本来在旁边管理工程现在却躲的远远的</VALUE>
    <VALUE Lang="cn">大事不妙~ 工程期限就快到了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_4_0">
    <VALUE Lang="GS">It's troubling to know most of the people at the construction site are acting funny and most of the machinery broke down. There's going to be a delay in the construction work, and the site is just full of turmoil.</VALUE>
    <VALUE Lang="id">Padahal saya harus kerja</VALUE>
    <VALUE Lang="cn">是该做事没错, 不过人们变的怪怪的, 机器也故障, 实在麻烦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_4_0_1">
    <VALUE Lang="GS">Ask Who It Is</VALUE>
    <VALUE Lang="id">Bertanya siapa anda</VALUE>
    <VALUE Lang="cn">询问是谁</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_5_0">
    <VALUE Lang="GS">Oh, please get rid of those stubborn students! We can't get anything done with them around! We've got enough trouble as it is!</VALUE>
    <VALUE Lang="id">Wooot, pelajar seperti kamu yang disuruh toh?</VALUE>
    <VALUE Lang="id">Waktu sudah tidak cukup lagi... Terpakas.. Gpp deh?!</VALUE>
    <VALUE Lang="cn">喔, 把这种学生送走吧</VALUE>
    <VALUE Lang="cn">没时间没办法呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_5_0_1">
    <VALUE Lang="GS">Construction Supervisor's Request</VALUE>
    <VALUE Lang="id">Permintaan Construction Supervisor</VALUE>
    <VALUE Lang="cn">Construction Supervisor的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_6_0">
    <VALUE Lang="GS">Student! Please listen to my request...</VALUE>
    <VALUE Lang="GS">In order to complete construction by the deadline, we must replace these crazy workers with efficiently working machinery. The problem is that the generator is broken. This just makes things more complicated!</VALUE>
    <VALUE Lang="id">Aku mau mendengarkan permintaan para pelajar</VALUE>
    <VALUE Lang="id">Untuk menggantikan para buruh yang stress, aku harus menggilir mesin-mesin ini dengan waktu yang terbatas, sekarang, Generator pun rusak</VALUE>
    <VALUE Lang="cn">听听我的请求</VALUE>
    <VALUE Lang="cn">为了要在期限内完工,必须要使用机器人来代替疯掉的工人们,但是现在竟然连发电机都坏掉了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_6_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_7_0">
    <VALUE Lang="GS">My friend from the Sword Section told me that this is not the only area where strange things started to happen. Now imagine what would happen to our world if this chaos continues and spreads.</VALUE>
    <VALUE Lang="id">wah…benar-benar… kacau…</VALUE>
    <VALUE Lang="cn">上次听剑道部一个学生朋友说, 不是只有这里这样子..</VALUE>
    <VALUE Lang="cn">唉... 世界将会变成什么样子..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_7_0_1">
    <VALUE Lang="GS">Physic's Teacher's Call</VALUE>
    <VALUE Lang="id">Panggilan dari Physics Teacher</VALUE>
    <VALUE Lang="cn">Physic's Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_8_0">
    <VALUE Lang="GS">I'm pretty nervous. I'm expecting news from the Physics Teacher at Sacred Gate College. Please find him! He said he would wait near the Sacred Gate Ring.</VALUE>
    <VALUE Lang="id">Aaaa, hampir saja lupa</VALUE>
    <VALUE Lang="id">Tadi ada kontak dari Physics Teacher dari Mystic Peak School</VALUE>
    <VALUE Lang="id">Kalau kamu pergi ke Mystic Peak School Palaza dia pasti ada di sana</VALUE>
    <VALUE Lang="cn">阿 差点吓死</VALUE>
    <VALUE Lang="cn">刚刚Sacred Gate College的Physics Teacher那边有消息传来</VALUE>
    <VALUE Lang="cn">他说会去Sacred Gate Ring等您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_workmaster1.ntk_9_0">
    <VALUE Lang="GS">....</VALUE>
    <VALUE Lang="id">....</VALUE>
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0">
    <VALUE Lang="GS">This Terminal controls the access to the Art Center Building.</VALUE>
    <VALUE Lang="id">Ini adalah Art Centre Terminal</VALUE>
    <VALUE Lang="id">Mengontrol ijin keluar masuk ke Art Centre</VALUE>
    <VALUE Lang="cn">此终端机掌控着 Art Center 的出入机能。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_1">
    <VALUE Lang="GS">Confirm Activation</VALUE>
    <VALUE Lang="id">Konfirmasi pengaktifan</VALUE>
    <VALUE Lang="cn">确认激活</VALUE>
  </SENTENSE>
