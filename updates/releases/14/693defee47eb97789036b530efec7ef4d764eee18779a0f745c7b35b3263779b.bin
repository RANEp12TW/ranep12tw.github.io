  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_57">
    <VALUE Lang="GS">Deliver the Security Monitor Video Tape</VALUE>
    <VALUE Lang="id">Menyerahkan Surveillance Tape</VALUE>
    <VALUE Lang="cn">传送监视器的录影带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_58">
    <VALUE Lang="GS">Start "Report Violent Criminals"</VALUE>
    <VALUE Lang="id">Memulai penangkapan pelaku tindak kekerasan</VALUE>
    <VALUE Lang="cn">“检举暴力犯”开始</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_59">
    <VALUE Lang="GS">Start "Report on Prison Escapees"</VALUE>
    <VALUE Lang="id">Memulai penangkapan tahanan yang melarikan diri</VALUE>
    <VALUE Lang="cn">“检举逃犯”开始</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_6">
    <VALUE Lang="GS">Request for Video Projector</VALUE>
    <VALUE Lang="id">Meminta Broadcasting Tool</VALUE>
    <VALUE Lang="cn">影片放映机的申请</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_60">
    <VALUE Lang="GS">Report the Jail Situation to Police Station</VALUE>
    <VALUE Lang="id">Menyampaikan situasi di Prison</VALUE>
    <VALUE Lang="cn">向警察局报告监狱的现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_61">
    <VALUE Lang="GS">Report the Status</VALUE>
    <VALUE Lang="id">Menyampaikan situasi di Prison</VALUE>
    <VALUE Lang="cn">报告现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_62">
    <VALUE Lang="GS">Confirm Security of Middle Hole</VALUE>
    <VALUE Lang="id">Memulai pengkonfirmasian keamanan di Midtown</VALUE>
    <VALUE Lang="cn">确认Middle Hole的安全</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_63">
    <VALUE Lang="GS">Ask about the Spore Allergy</VALUE>
    <VALUE Lang="id">Ask about the Spore Allergy</VALUE>
    <VALUE Lang="cn">询问孢子过敏</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_64">
    <VALUE Lang="GS">Ask about spore allergy</VALUE>
    <VALUE Lang="id">Tanyakan tentang spore allergy</VALUE>
    <VALUE Lang="cn">询问关于孢子过敏</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_7">
    <VALUE Lang="GS">Request for Video Projector</VALUE>
    <VALUE Lang="id">Meminta Broadcasting Tool</VALUE>
    <VALUE Lang="cn">影片放映机的申请</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_8">
    <VALUE Lang="GS">Request for Video Projector</VALUE>
    <VALUE Lang="id">Meminta Broadcasting Tool</VALUE>
    <VALUE Lang="cn">影片放映机的申请</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_9">
    <VALUE Lang="GS">Authenticate Call</VALUE>
    <VALUE Lang="id">Mengkonfirmasi panggilan</VALUE>
    <VALUE Lang="cn">确定呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_10_0">
    <VALUE Lang="GS">Ah! Thank you very much!</VALUE>
    <VALUE Lang="GS">With this, we can start using the database to continue our investigation.</VALUE>
    <VALUE Lang="GS">Meanwhile, could you help me investigate this rumor? I heard that there is a giant dog wearing children's clothing nearby.</VALUE>
    <VALUE Lang="id">Ah, terimakasih~</VALUE>
    <VALUE Lang="id">Dengan ini kita bisa menggunakan DB secepatnya</VALUE>
    <VALUE Lang="id">Bisa membantu saya untuk menyelidiki sesuatu?</VALUE>
    <VALUE Lang="cn">嘿！非常感谢！</VALUE>
    <VALUE Lang="cn">有了这个，我们就可以使用资料库来进行调查了。</VALUE>
    <VALUE Lang="cn">对了，能否请您帮忙调查一个传闻？</VALUE>
    <VALUE Lang="cn">听说有一只巨大的狗狗正穿着童装在附近闲晃。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_11_0">
    <VALUE Lang="GS">I was surprised!</VALUE>
    <VALUE Lang="GS">Could it be that some kids transformed into dogs? It's possible, considering all the other weird stuff that's happening.</VALUE>
    <VALUE Lang="id">Tidak saya sangka rupanya</VALUE>
    <VALUE Lang="id">Bagaimana mungkin anak-anak berubah menjadi anjing seperti ini…</VALUE>
    <VALUE Lang="id">Kalau dilihat dari bencana yang terjadi memang sih bukan hal yang aneh tapi ini…</VALUE>
    <VALUE Lang="cn">太吓人了！难道是一些由孩子们突变而成的狗吗？从周遭发生的异象来看，似乎这是可能的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_11_0_1">
    <VALUE Lang="GS">Volunteer to Help with Investigation</VALUE>
    <VALUE Lang="id">Melakukan penyelidikkan dengan sukarela</VALUE>
    <VALUE Lang="cn">自愿协助调查</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_11_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_12_0">
    <VALUE Lang="GS">It seems that the Sacred Financial Group might be involved in this.</VALUE>
    <VALUE Lang="GS">We just need to undergo further investigation to prove that.</VALUE>
    <VALUE Lang="id">Bisa tolong begitu?</VALUE>
    <VALUE Lang="id">Para pelajar yayasan saint memang kuat-kuat</VALUE>
    <VALUE Lang="id">Tapi..euhm..apa yah..aku ada perasaan bahwa ini berhubungan dengan sesuatu yang tidak seharusnya kita ganggu…</VALUE>
    <VALUE Lang="cn">看来，Sacred Financial Group可能参与了这一部分。我们只需要进行更细部的调查来证明就可以了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_12_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_13_0">
    <VALUE Lang="GS">Similar things have already happened before, but people just ignored them.</VALUE>
    <VALUE Lang="id">Saya menemukannya pada saat melakukan penyelidikan</VALUE>
    <VALUE Lang="id">Saya menemukan bahwa dulu juga pernah terjadi kejadian yang sama</VALUE>
    <VALUE Lang="id">Tapi pada saat itu hal itu tidak menjadi isu dan terlupakan tanpa kita tahu</VALUE>
    <VALUE Lang="cn">类似的事情已经发生过，但是人们总是忽略了他们。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_14_0">
    <VALUE Lang="GS">I just received confirmation that the Police Department in the other area also lacks manpower. This just causes more trouble for us.</VALUE>
    <VALUE Lang="id">Ya, baru saja menerimanya setelah selesai</VALUE>
    <VALUE Lang="id">Begitu yah….daripihak sana mata uang seperti itu…</VALUE>
    <VALUE Lang="id">Maaf karena kami kamu jadi kerepotan begini</VALUE>
    <VALUE Lang="id">Harus bagaimana lagi karena tenaga kerjanya kurang</VALUE>
    <VALUE Lang="cn">我刚刚收到通知，说警察局在缺乏各部门的人手。这真的是我们的一大担忧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_15_0">
    <VALUE Lang="GS">So the sender is Professor Chui Tai Gui...</VALUE>
    <VALUE Lang="GS">I think Ang Bee Lan, who's in the Trading Hole Residential Area, knows him.</VALUE>
    <VALUE Lang="GS">Anyway, I think you should talk to her.</VALUE>
    <VALUE Lang="id">Begitu yah..kok bisa yah pengirimnya itu adalah Professor Choi Te Gyu</VALUE>
    <VALUE Lang="id">Kalau 'Miranda' kan orang yang sedang tinggal di perumahan di Trading Hole</VALUE>
    <VALUE Lang="id">Walau bagaimanapun juga kayaknya lebih baik kamu sampaikan den mendengar langsung darinya</VALUE>
    <VALUE Lang="cn">所以，发件人是Chui Tai Gui教授...</VALUE>
    <VALUE Lang="cn">我想，住在Trading Hole Residential Area的Ang Bee Lan是认识他的。</VALUE>
    <VALUE Lang="cn">无论如何，我认为你应该跟她进行对话。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_15_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_16_0">
    <VALUE Lang="GS">....2</VALUE>
    <VALUE Lang="id">....2</VALUE>
    <VALUE Lang="cn">....2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_17_0">
    <VALUE Lang="GS">Where did those spores come from? I believe that the disease that's spreading around was caused by that Spore Allergy.</VALUE>
    <VALUE Lang="id">Pokoknya seperti gejala pada saat meminum racun</VALUE>
    <VALUE Lang="id">Untung saja jumlah sporanya tidak banyak, sebenarnya datang dari mana spora-spora itu</VALUE>
    <VALUE Lang="cn">孢子是从何而来的？</VALUE>
    <VALUE Lang="cn">我认为疾病会蔓延各地是受到孢子过敏的缘故。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_17_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_18_0">
    <VALUE Lang="GS">I heard already that there are monsters blowing out the Spores from the Leonair Campus Basement.</VALUE>
    <VALUE Lang="id">Ah, baru saja saya mendapatkan informasi yang mirip</VALUE>
    <VALUE Lang="id">Kamu lihat monster yang menyemburkan spora di Leonine School kan?</VALUE>
    <VALUE Lang="id">Mungkinkah ada hubungannya dengan itu?</VALUE>
    <VALUE Lang="cn">我听说有怪物从Leonair Campus Basement里面把孢子往外吹。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_18_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_19_0">
    <VALUE Lang="GS">....7</VALUE>
    <VALUE Lang="id">....7</VALUE>
    <VALUE Lang="cn">....7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_2_0">
    <VALUE Lang="GS">I think you should get advice from some of the people in this area. Most of them know the "Special Language."</VALUE>
    <VALUE Lang="id">Pemilik rental di depan sana yang bertanya kan?</VALUE>
    <VALUE Lang="id">Saya lupa apa istilah teknisnya</VALUE>
    <VALUE Lang="cn">我想您应该要从这地区的某些人身上获取建议。他们大部分都知道所谓的“特殊语言”。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_2_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_20_0">
    <VALUE Lang="GS">The Force Field function collapsed after that happened.</VALUE>
    <VALUE Lang="id">Euhm…hujan meteor…18 tahun kemudian…4 Authentication area…Keruntuhan…Pengembalian cahaya?</VALUE>
    <VALUE Lang="id">Ini cerita apa-</VALUE>
    <VALUE Lang="cn">事情发生后，结界机能就崩坏了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_20_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_21_0">
    <VALUE Lang="GS">.....8</VALUE>
    <VALUE Lang="id">.....8</VALUE>
    <VALUE Lang="cn">.....8</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_22_0">
    <VALUE Lang="GS">A number of disappearances around this area were also reported not too long ago.</VALUE>
    <VALUE Lang="id">Beberapa waktu lalu kami mendapatkan laporan bahwa anak-anak yang ada di sekitar sini tiba-tiba menghilang pada waktu yang sama</VALUE>
    <VALUE Lang="cn">不久之前有收到许多人在这附近失踪的案件。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_22_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_23_0">
    <VALUE Lang="GS">There's so much happening… We are working as hard as we can, and it's never enough. We can't even perform our normal duties.</VALUE>
    <VALUE Lang="id">Itu terjadi pada waktu kecelakaan mulai terjadi, jadi kita tidak ada waktu untuk menyelidikinya</VALUE>
    <VALUE Lang="cn">有这么多的情况在发生......即使尽了一切努力，仍有许多不足的地方。我们甚至无法完成正常的工作。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_23_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_24_0">
    <VALUE Lang="GS">I don't even have a clue of where to start.</VALUE>
    <VALUE Lang="GS">Excuse me, could you help me collect information regarding the lost children?</VALUE>
    <VALUE Lang="id">Kini saya sudah tidak tahu lagi bagaimana caranya bisa menemukan petunjuk</VALUE>
    <VALUE Lang="id">Maaf tapi bisa tolong saya untuk mencari informasi tentang anak-anak dari orang-orang yang ada di sekitar sini?</VALUE>
    <VALUE Lang="cn">我甚至没有能够进行调查的线索。</VALUE>
    <VALUE Lang="cn">不好意思，能不能请您帮我收集关于走失孩子的信息？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_24_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_25_0">
    <VALUE Lang="GS">....9</VALUE>
    <VALUE Lang="id">....9</VALUE>
    <VALUE Lang="cn">....9</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_26_0">
    <VALUE Lang="GS">If we can access the Police Database, we can find important clues regarding this incident. This will be possible after we get more outlets to produce these resources.</VALUE>
    <VALUE Lang="id">Kayaknya kita bisa mendapatkan sedikit petunjuk kalau bisa mengakses Database kepolisian</VALUE>
    <VALUE Lang="id">Soalnya kebetulan terminal tidak bisa digunakan karena ada error pada system komputer</VALUE>
    <VALUE Lang="cn">等我们多得到几个出口，并生产这些资源之后， 就能进入警方数据库，找到有关事件的重要线索。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_26_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_27_0">
    <VALUE Lang="GS">Excuse me, could you help me acquire the Recovery Disk from the Mystic Peak Campus?</VALUE>
    <VALUE Lang="id">Maaf, tapi bisa tolong pergi ke Phoenix School untuk mencari restoring disc?</VALUE>
    <VALUE Lang="cn">对不起，麻烦您帮我去Mystic Peak Campus那边拿Recovery Disk过来，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_27_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_28_0">
    <VALUE Lang="GS">.....10</VALUE>
    <VALUE Lang="id">.....10</VALUE>
    <VALUE Lang="cn">.....10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_29_0">
    <VALUE Lang="GS">I just need to confirm all the information that I'm receiving.</VALUE>
    <VALUE Lang="id">Ada laporan kalau anjing-anjing besar yang ada di daerah sini sedang menggigit baju anak-anak.</VALUE>
    <VALUE Lang="id">Dulu ada informasi yang mirip tapi saya tidak pernah bisa memeriksanya</VALUE>
    <VALUE Lang="id">Kali ini kita pasti bisa memeriksanya dengan baik kan?</VALUE>
    <VALUE Lang="cn">我只需要确认所有我收到的信息。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_29_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_3_0">
    <VALUE Lang="GS">Sure! I can let you borrow this equipment.</VALUE>
    <VALUE Lang="GS">Did the Image Expert request this? I trust this stuff with you and that shopkeeper because he's a professional that knows how to handle this equipment. Please return it after you're done.</VALUE>
    <VALUE Lang="id">Iya, memang tidak sulit untuk meminjamkannya</VALUE>
    <VALUE Lang="id">Ini permintaan dari pemilik rental di depan sana kan?</VALUE>
    <VALUE Lang="id">Karena hanya bisa dititipkan kepada ahlinya</VALUE>
    <VALUE Lang="id">Setelah memakainya tolong dikembalikan yah karena ini adalah peralatan untuk umum</VALUE>
    <VALUE Lang="cn">当然！我可以借您这个设备。</VALUE>
    <VALUE Lang="cn">是 Image Expert 要求的吗？这只能由专家负责，我相信您和那位老板，因为他是专家。</VALUE>
    <VALUE Lang="cn">由于这也是公家设备，请用完后，尽快交还回来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_30_0">
    <VALUE Lang="GS">.....11</VALUE>
    <VALUE Lang="id">.....11</VALUE>
    <VALUE Lang="cn">.....11</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_31_0">
    <VALUE Lang="GS">Are those dogs really wearing children's clothing? I think we should get their DNA samples from their saliva.</VALUE>
    <VALUE Lang="id">Apakah anjing itu benar-benar menggigit baju?</VALUE>
    <VALUE Lang="id">Sudah mengumpulkan saliva juga rupanya</VALUE>
    <VALUE Lang="id">Kalau ada ini test DNA pun bisa dilakukan…</VALUE>
    <VALUE Lang="cn">那些狗真的穿的童装？我认为我们应该从牠们的口水中取出DNA的样本来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_31_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_32_0">
    <VALUE Lang="GS">One moment please...</VALUE>
    <VALUE Lang="GS">I brought this simple checking machine to verify the information.</VALUE>
    <VALUE Lang="GS">Hmmm....</VALUE>
    <VALUE Lang="id">Tunggu sebentar</VALUE>
    <VALUE Lang="id">Saya punya data dan alat pengecekkan yang sederhana</VALUE>
    <VALUE Lang="id">Euhm…</VALUE>
    <VALUE Lang="id">Ini…?</VALUE>
    <VALUE Lang="cn">请稍候...</VALUE>
    <VALUE Lang="cn">我带来了这台简单式审核机器，是专门验证信息的。</VALUE>
    <VALUE Lang="cn">嗯……………………..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_32_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_33_0">
    <VALUE Lang="GS">This instrument isn't very precise, so we weren't able to learn anything from this sample.</VALUE>
    <VALUE Lang="GS">Hmmm...</VALUE>
    <VALUE Lang="GS">The Dog and kid's DNA are almost the same.</VALUE>
    <VALUE Lang="GS">This is very, very surprising. My guess was right.</VALUE>
    <VALUE Lang="id">Saya tidak bisa langsung memutuskan karena ini bukan pemeriksaan keseluruhan, tapi kalau semirip ini aneh sekali</VALUE>
    <VALUE Lang="id">DNA dari anak dan anjing itu hampir sama..Eh tidak benar-benar sama</VALUE>
    <VALUE Lang="cn">这个仪器不是很精确，所以我们无法从样本中得到任何结果。</VALUE>
    <VALUE Lang="cn">嗯……</VALUE>
    <VALUE Lang="cn">狗狗和孩子的DNA几乎是相同。</VALUE>
    <VALUE Lang="cn">这是非常，非常令人惊讶的结果。我的猜测果然是对的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_33_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_34_0">
    <VALUE Lang="GS">....12</VALUE>
    <VALUE Lang="id">....12</VALUE>
    <VALUE Lang="cn">....12</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_35_0">
    <VALUE Lang="GS">Anyway, I'll use the Police Database to search for more information. I will try my best to solve this case.</VALUE>
    <VALUE Lang="id">Pokoknya yang harus dilakukan harus tetap dilakukan kan?</VALUE>
    <VALUE Lang="id">Saya juga akan mencoba untuk mencari data melalu DBnya polisi</VALUE>
    <VALUE Lang="id">Saya berjanji atas nama kakek saya untuk menyelesaikan kasus ini</VALUE>
    <VALUE Lang="cn">无论如何，我将使用警方的数据资料来搜索更多的信息。我会尽我所能来解决这种情况。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_35_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_36_0">
    <VALUE Lang="GS">...13</VALUE>
    <VALUE Lang="id">...13</VALUE>
    <VALUE Lang="cn">...13</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_37_0">
    <VALUE Lang="GS">This could have been caused by a large-scaled organization. My guess is that this was an experiment conducted by the Sacred Financial Group.</VALUE>
    <VALUE Lang="id">Sepertinya ini berkaitan dengan lembaga yang memiliki kekuasaan tinggi, ternyata memang benar percobaan ini dilaksanakan atas perintah Yayasan Saint</VALUE>
    <VALUE Lang="cn">这可能跟大规模的组织有些关系。我猜这是由 Sacred Financial Group进行的一项实验。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_37_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_38_0">
    <VALUE Lang="GS">Although it's not clear if other organizations might be doing the same thing, I'm sure this is related to the Sacred Financial Group's hidden activities.</VALUE>
    <VALUE Lang="id">Mungkin saja pelakunya adalah kelompok lain yang mempunyai jurus sama. Tapi saya yakin ini ada hubungannya dengan Yayasan Saint.</VALUE>
    <VALUE Lang="cn">虽然还不清楚是否有其他机构可能会做同样的事情，但我敢肯定，这肯定是关系到Sacred Financial Group的秘密活动。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_38_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_39_0">
    <VALUE Lang="GS">......14</VALUE>
    <VALUE Lang="id">......14</VALUE>
    <VALUE Lang="cn">......14</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_4_0">
    <VALUE Lang="GS">Have you sent it to him?</VALUE>
    <VALUE Lang="GS">That was nice! We lack manpower right now, which is why we may ask you to help us with some tasks. I'm sorry if we cause you too much trouble!</VALUE>
    <VALUE Lang="id">Kamu dikirim oleh Agent?</VALUE>
    <VALUE Lang="id">Kebetulan sekali</VALUE>
    <VALUE Lang="id">Saya mau meminta bantuan karena sedang kekurangan tenaga kerja</VALUE>
    <VALUE Lang="cn">您有没有交给他呢？</VALUE>
    <VALUE Lang="cn">很好！我们正缺人，这就是为什么我们现在会要求您帮我们进行一些任务。如果增添了太多的麻烦，请见谅啊！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_4_0_1">
    <VALUE Lang="GS">Listen to Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan</VALUE>
    <VALUE Lang="cn">听取委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_4_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_40_0">
    <VALUE Lang="GS">Come! That Authentication Terminal can give you access in order to proceed with your investigation.</VALUE>
    <VALUE Lang="id">Nah, ada di sini.</VALUE>
    <VALUE Lang="id">Kalau kamu operasikan pada Terminal verifikasi yang ada di sana, izin keluar-masuk akan bisa diterima tanpa ada masalah.</VALUE>
    <VALUE Lang="cn">来吧！该终端机已核准您进入并进行您的调查研究。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_40_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_41_0">
    <VALUE Lang="GS">.....15</VALUE>
    <VALUE Lang="id">.....15</VALUE>
    <VALUE Lang="cn">.....15</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_42_0">
    <VALUE Lang="GS">Here's another reminder...</VALUE>
    <VALUE Lang="id">Dan…</VALUE>
    <VALUE Lang="id">Mungkin beliau bisa membantu kalian</VALUE>
    <VALUE Lang="cn">这里还有一个注意事项……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_42_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_43_0">
    <VALUE Lang="GS">Make sure you bring some of your fellow students to help you. A very dangerous journey lies ahead of you. Good Luck!</VALUE>
    <VALUE Lang="id">Tahukan kalau disamping lapangan golf ada perumahan?</VALUE>
    <VALUE Lang="id">Kamu bisa menemukannya dengan mudah bila pergi ke koordinat 129,138</VALUE>
    <VALUE Lang="cn">请确定您会把一些同伴们带来帮您加油打气。一个非常危险的旅程正等着您。祝好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_43_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_44_0">
    <VALUE Lang="GS">Oh, you mean that corpse?</VALUE>
    <VALUE Lang="GS">I just received the info, and it's just a bit weird…</VALUE>
    <VALUE Lang="GS">That corpse still has a pulse!</VALUE>
    <VALUE Lang="id">Ah, mayat itu rupanya.</VALUE>
    <VALUE Lang="id">Kebetulan beberapa waktu yang lalu saya menerima laporan yang sama</VALUE>
    <VALUE Lang="id">Saya tidak tahu bahwa ada juga benda seperti ini.</VALUE>
    <VALUE Lang="id">Tapi tidakkah mayat itu aneh?</VALUE>
    <VALUE Lang="id">Meskipun tidak bernafas tapi saya tahu dengan pasti denyut nadinya masih</VALUE>
    <VALUE Lang="cn">嗯，您指的是尸体？</VALUE>
    <VALUE Lang="cn">我刚刚收到了一道信息，不过它有点怪......</VALUE>
    <VALUE Lang="cn">那具尸体竟然还有脉搏在跳动！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_44_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_45_0">
    <VALUE Lang="GS">Usually, corpses don't cause too many problems in cases like these…</VALUE>
    <VALUE Lang="GS">But now we have to get the corpse before we have a specialist look at it.</VALUE>
    <VALUE Lang="id">Kalau dulu aku pasti abaikan karena tidak masuk akal</VALUE>
    <VALUE Lang="id">Kalau sekarang kata-kata seperti itu juga tidak bisa hanya saya lewatkan</VALUE>
    <VALUE Lang="id">Anehnya orang-orang di sekitar juga tidak melukainya, kami membiarkannya seperti itu hingga orang ahli datang dan memasti</VALUE>
    <VALUE Lang="cn">通常，在这种情况下，尸体不太会引起太多的问题...</VALUE>
    <VALUE Lang="cn">但现在我们在取得尸体之前， 必须先让一个专家过目一下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_45_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_46_0">
    <VALUE Lang="GS">Last time I collected the same type of stone from one of my friends in the private jail.</VALUE>
    <VALUE Lang="GS">It wasn't noticed since we weren't specialists, but...</VALUE>
    <VALUE Lang="GS">Did someone else find this special ore within the past few years?</VALUE>
    <VALUE Lang="id">Dulu saya pernah mendapatkan batu yang sama dari teman yang bekerja di Saint_Prison</VALUE>
    <VALUE Lang="id">Saya bukan ahlinya jadi tidak tahu lebih jelas lagi</VALUE>
    <VALUE Lang="id">Katanya ini item tambang aneh yang mulai ditemukan sejak beberapa tahun yang lalu?</VALUE>
    <VALUE Lang="id">Dia bercerita hal seperti</VALUE>
    <VALUE Lang="cn">以前我似乎曾经从Private Jail的朋友那边收集过同类型的石头。因为我们不是专家，所以不了解细节，但是...</VALUE>
    <VALUE Lang="cn">是否有人在过去几年内发现了这个特殊的矿石呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_46_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_47_0">
    <VALUE Lang="GS">There's something wrong in the private jail. We need to definitely make sure about the type of stone.</VALUE>
    <VALUE Lang="id">Kalau dilihat dari situasi yang ada kayaknya di Prison juga terjadi sesuatu</VALUE>
    <VALUE Lang="id">Masih belum yakin tapi sesuatu yang sejenis dengan batu ini</VALUE>
    <VALUE Lang="id">Bisa tolong cek apakah ada di dalam prison atau tidak?</VALUE>
    <VALUE Lang="cn">在Private Jail里似乎有什么不对经的地方。我们需要去确认是否有无该类型的石头在内。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_47_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Melakukan permintaan</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_47_0_2">
    <VALUE Lang="GS">Decline</VALUE>
    <VALUE Lang="id">Menolak permintaan</VALUE>
    <VALUE Lang="cn">婉拒</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_48_0">
    <VALUE Lang="GS">Thanks.</VALUE>
    <VALUE Lang="GS">I roughly know the location from looking at the map.</VALUE>
    <VALUE Lang="GS">You need to pass 3 main gates, and you'll find the special ore around there.</VALUE>
    <VALUE Lang="GS">Just be careful to do a thorough search before confirming.</VALUE>
    <VALUE Lang="id">Terimakasih.</VALUE>
    <VALUE Lang="id">Saya tidak pernah pergi ke sana secara langsung tapi saya pernah melihat petanya</VALUE>
    <VALUE Lang="id">Saya tahu strukturnya</VALUE>
    <VALUE Lang="id">Gedung prison harus melewati 3 buah pintu gerbang</VALUE>
    <VALUE Lang="id">Di daerah sekitar sini pasti ada pertambangan</VALUE>
    <VALUE Lang="id">Padahal saya pikir bisa me</VALUE>
    <VALUE Lang="cn">谢谢。</VALUE>
    <VALUE Lang="cn">我从地图上已略知其位置。</VALUE>
    <VALUE Lang="cn">您似乎只需要通过3个主要大门，之后就会发现特殊的矿石集中区。请小心行动。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_49_0">
    <VALUE Lang="GS">You got it from that place, right?</VALUE>
    <VALUE Lang="GS">We can't contact person in charge, and we don't know what the problem is now…</VALUE>
    <VALUE Lang="id">Tuh kan itu memang batu yang ke luar dari sana?</VALUE>
    <VALUE Lang="id">Saya kurang tahu apa yang terjadi karena hubungan dengan prison terputus</VALUE>
    <VALUE Lang="id">Tidak bisa tahu</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">您在那边拿到了石头，对吧？</VALUE>
    <VALUE Lang="cn">我们联系不上负责人，且我们也不知道是发生了什么问题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_49_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_5_0">
    <VALUE Lang="GS">Hmmm...</VALUE>
    <VALUE Lang="GS">Some important mail was stolen, and we must get it back. We're short on hands, and there's no available officers on duty. I'm hoping some students would help us.</VALUE>
    <VALUE Lang="id">Ah…sebagai polisi maaf sekali karena saya harus meminta bantuan seperti ini….</VALUE>
    <VALUE Lang="id">Karena ada perintah untuk mencari kembali surat penting yang dicuri</VALUE>
    <VALUE Lang="id">Tapi karena tenaga kerja benar-benar tidak ada…</VALUE>
    <VALUE Lang="id">Kebetulan dia memperkenalkan pelajar yang bisa memb</VALUE>
    <VALUE Lang="cn">嗯... 一些重要的邮件被偷走了，必须把它找回来。我们缺乏人手，而且也没有足够的人员在值班。希望有同学来帮助我们。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_50_0">
    <VALUE Lang="GS">Is it?</VALUE>
    <VALUE Lang="GS">There's someone staying in the jail… But it's nobody we arrested!</VALUE>
    <VALUE Lang="GS">Hmm, it looks like I could use your help.</VALUE>
    <VALUE Lang="id">Begitu?</VALUE>
    <VALUE Lang="id">Prison berhasil diduduki pada saat kerusuhan terjadi rupanya.</VALUE>
    <VALUE Lang="id">Tapi mungkin penyebabnya bukan hanya kerusuhan yang disebabkan ole h para tahanan</VALUE>
    <VALUE Lang="id">Mungkin ada sesuatu seperti halnya di Leonine school.</VALUE>
    <VALUE Lang="id">Ah, ada satu lagi permintaan dari sa</VALUE>
    <VALUE Lang="cn">是吗？ 有人留在监狱......但我们却没有逮捕任何人！</VALUE>
    <VALUE Lang="cn">嗯，看来我可以向您求助了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_50_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_51_0">
    <VALUE Lang="GS">Now, I've just learned that some instructors have recently disappeared.</VALUE>
    <VALUE Lang="GS">It seems that they were all sent to some private jail. Please rescue them if you can!</VALUE>
    <VALUE Lang="id">Tadi di daerah sekitar Tunnel ada orang-orang yang memakai wearpack</VALUE>
    <VALUE Lang="id">Ada laporan bahwa orang-orang datang dan membuat kerusuhan lalu menghilang</VALUE>
    <VALUE Lang="id">Sudah diterima</VALUE>
    <VALUE Lang="id">Kayaknya mereka melarikan diri ke arah Prison</VALUE>
    <VALUE Lang="id">Tolong tangkap orang-orang itu</VALUE>
    <VALUE Lang="cn">不久前收到了通报，说在隧道附近穿着作业服的人捣乱一阵子后，都突然消失了。似乎他们是逃往监狱的那边去了。请把他们都抓起来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_51_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_52_0">
    <VALUE Lang="GS">When people get mutated, they often lose their sanity.</VALUE>
    <VALUE Lang="GS">We need to take this situation more seriously if we hope to become able to handle it.</VALUE>
    <VALUE Lang="id">Orang-orang yang menjadi gila setelah kecelakaan terjadi rupanya</VALUE>
    <VALUE Lang="id">Sudah hal pastikan kalau mereka tidak akan mau ditangkap dengan baik-baik</VALUE>
    <VALUE Lang="id">Untuk mengurangi korban kita harus mengerti situasi sekarang</VALUE>
    <VALUE Lang="id">Saya harus lebih berhati-hati lagi</VALUE>
    <VALUE Lang="cn">发生突变后，人们都失去理智了。为了减少牺牲，得更小心行动才行。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_52_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_53_0">
    <VALUE Lang="GS">Can you help me check how many criminals are in jail?</VALUE>
    <VALUE Lang="GS">Please go count them for me.</VALUE>
    <VALUE Lang="id">Bisa tolong cek ada berapa banyak kriminal yang dulu mendekam di prison?</VALUE>
    <VALUE Lang="id">Tolong bantu kami, nanti saya akan menghubungi sekolah kamu untuk menyampaikan bahwa kamu sedang membantu kami.</VALUE>
    <VALUE Lang="cn">能不能帮我查一下在监狱里有多少名罪犯在内？ 请帮我数数看，谢谢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_53_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_54_0">
    <VALUE Lang="GS">The document wasn't complete, so we're not sure if we should double check or not.</VALUE>
    <VALUE Lang="id">He, seperti yang saya kira bukan dokumen yang sempurna rupanya.</VALUE>
    <VALUE Lang="id">Setidaknya tidak berubah menjadi serbuk, kalau segini kita masih bisa mencocokkannya.</VALUE>
    <VALUE Lang="id">Lebih baik kamu beristirahat sebentar…eum?</VALUE>
    <VALUE Lang="id">Ini sebentar..kayaknya harus dicek</VALUE>
    <VALUE Lang="cn">该文件不完整，所以我们不知道是否应该再重新检查一次。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_54_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_55_0">
    <VALUE Lang="GS">I guess the names that aren't on that list must still be in the city.</VALUE>
    <VALUE Lang="id">Orang-orang yang ada di daftar teratas adalah mereka yang berbahaya, kalau dilihat bahwa masih belum ada laporan kayaknya mereka masih ada di sekitar sana. Kalau sampai mereka pergi ke Root Hole akan terjadi seuatu hal yang sangat buruk</VALUE>
    <VALUE Lang="cn">我想这个不在名单上的名字仍然存在于这个城市里。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_55_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_56_0">
    <VALUE Lang="GS">It seems the jail is understaffed too, and now they're asking for help.</VALUE>
    <VALUE Lang="id">Karena kekuatan militer di prison sudah tidak bisa dipercaya lagi…</VALUE>
    <VALUE Lang="id">Kamu harus membantu saja</VALUE>
    <VALUE Lang="id">Kini permintaan seperti ini saya lakukan dengan biasa…</VALUE>
    <VALUE Lang="cn">看来监狱现在人手不足，他们正在寻求帮助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_56_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_57_0">
    <VALUE Lang="GS">It's a good thing the list doesn't have the names of truly heinous criminals on it. I've heard of another list of special names, but I don't have enough information to check it out.</VALUE>
    <VALUE Lang="id">Begitu yah….apakah sudah terlalu terlambat?</VALUE>
    <VALUE Lang="id">Euhm, tidak terlambat rupanya karena tidak ada lagi kerugian yang dialami</VALUE>
    <VALUE Lang="id">Setelah saya lihat daftar nama ini untung saja sudah tidak ada lagi orang yang membahayakan.</VALUE>
    <VALUE Lang="id">Ada juga yang bilang kalau ada daft</VALUE>
    <VALUE Lang="cn">列表中并没有真正凶神恶煞的罪犯名字，这真是件好事。我听说还有一份特殊名称的名单，但因没有足够的信息来查证，要调查似乎很困难。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_57_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_58_0">
    <VALUE Lang="GS">Oh, I still have someone collecting information related to the ore.</VALUE>
    <VALUE Lang="GS">He's the Weapon Shop Owner in Middle Hole. You want to visit him?</VALUE>
    <VALUE Lang="id">Ah, mengumpulkan bahan-bahan untuk membuat stone</VALUE>
    <VALUE Lang="id">Ternyata di sana ada orang.</VALUE>
    <VALUE Lang="id">Weapon Specialist yang menjalankan toko senjata di Midtown</VALUE>
    <VALUE Lang="id">Bisa tolong pergi dan temui dia?</VALUE>
    <VALUE Lang="cn">噢，还有到处收集矿石相关资料的人啊？是在Middle Hole经营军火生意的武器专家。要去拜访一下吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_58_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_59_0">
    <VALUE Lang="GS">Sorry, just forget it.</VALUE>
    <VALUE Lang="GS">Now I need your help again. A group of weird men just grabbed the Sacred Gate document.</VALUE>
    <VALUE Lang="id">Maaf tapi cerita itu sepertinya harus didengarkan nanti</VALUE>
    <VALUE Lang="id">Kebetulan sekali kita sedang butuh bantuan karena tadi ada laporan bahwa dokumen penting yang sedang dikirim dari SG_School ke Yayasan Saint dicuri oleh orang-orang yang tidak dikenal</VALUE>
    <VALUE Lang="cn">不好意思，刚才忘了。 现在，我又需要你的帮助了。一群奇怪的人只是抢夺Sacred Gate的文件书。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_59_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_6_0">
    <VALUE Lang="GS">Thank you! That was fast!</VALUE>
    <VALUE Lang="GS">Ermmm....</VALUE>
    <VALUE Lang="GS">The mail was torn into pieces. Could you help me find the other pieces?</VALUE>
    <VALUE Lang="id">Terimakasih.</VALUE>
    <VALUE Lang="id">Bisa menemukannya dengan cepat rupanya</VALUE>
    <VALUE Lang="id">Mana coba</VALUE>
    <VALUE Lang="id">Euhm? Ini…</VALUE>
    <VALUE Lang="id">Suratnya sobek rupanya</VALUE>
    <VALUE Lang="id">Kayaknya ada pecahan yang lain…</VALUE>
    <VALUE Lang="id">Maaf tapi bisa tolong carikan juga sisanya?</VALUE>
    <VALUE Lang="cn">谢谢！真快速！嗯... 邮件被撕成碎片了。您能帮我找到另一片吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_60_0">
    <VALUE Lang="GS">Hunt them down, and get that document back!</VALUE>
    <VALUE Lang="id">Mungkin dia belum pergi jauh, cepat pergi dan carikan kembali</VALUE>
    <VALUE Lang="id">Hampir semua polisi yang bisa bergerak digerakkan karena itu adalah hal yang sangat penting</VALUE>
    <VALUE Lang="id">Tolong cepat-cepat</VALUE>
    <VALUE Lang="cn">去追捕他们，并将该文件取回。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_60_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_61_0">
    <VALUE Lang="GS">Thank you so much!</VALUE>
    <VALUE Lang="GS">You didn't read it, did you?</VALUE>
    <VALUE Lang="id">Terimakasih atas kerja kerasnya</VALUE>
    <VALUE Lang="id">Para prajurit dari pihak kami terluka dan sudah dibawa</VALUE>
    <VALUE Lang="cn">谢谢您，您没看过着内容吧？对吧？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_61_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_62_0">
    <VALUE Lang="GS">Actually, I'll open and read the content, even if I'm not supposed to.</VALUE>
    <VALUE Lang="GS">I heard about the proposal just now, and I'm not sure whether it's a good idea.</VALUE>
    <VALUE Lang="id">Meskipun ini bukan sesuatu yang pantas untuk dibanggakan tapi kalau saya pasti melihatnya walau dengan terpaksa</VALUE>
    <VALUE Lang="id">Mungkin kamu berpikir tidak mungkin karena disegel seperti ini…tapi</VALUE>
    <VALUE Lang="id">Tadi dari sekolah ada yang datang dan membicarakan tentang rencana ap</VALUE>
    <VALUE Lang="cn">事实上，要是我的话，说不准看，我应该也是会看的。我刚还听到了一道意见，但不是很确定是否是好消息。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_62_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_63_0">
    <VALUE Lang="GS">Oh, that's related to the Middle Hole story~</VALUE>
    <VALUE Lang="GS">I also just heard about that…</VALUE>
    <VALUE Lang="GS">Would you please help me confirm it again?</VALUE>
    <VALUE Lang="id">Ah, pasti mau mengatakan tentang kecelakaan yang terjadi di daerah Midtown kan?</VALUE>
    <VALUE Lang="id">Kebetulan ada laporan tentang kecelakaan itu…</VALUE>
    <VALUE Lang="id">Maaf tapi tolong pergi dan periksa sekali lagi</VALUE>
    <VALUE Lang="cn">哦，这是关系到 Middle Hole的故事〜</VALUE>
    <VALUE Lang="cn">我也只是听说而已....</VALUE>
    <VALUE Lang="cn">请您帮我再确认看看。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_63_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_64_0">
    <VALUE Lang="GS">Oh, I see.</VALUE>
    <VALUE Lang="GS">If this is true, then Root Hole will be in grave danger.</VALUE>
    <VALUE Lang="GS">Weird, did you just feel an earthquake?</VALUE>
    <VALUE Lang="GS">The situation at Root Hole's really serious…</VALUE>
    <VALUE Lang="id">Begitu yah…</VALUE>
    <VALUE Lang="id">Kalau Midtown saja seperti itu mungkin Root Hole lebih parah lagi</VALUE>
    <VALUE Lang="id">Aneh sekali, saya tidak tahu ada gempa</VALUE>
    <VALUE Lang="id">Kalau situasi di Root Hole benar-benar telah memburuk….</VALUE>
    <VALUE Lang="cn">哦，我明白了。 如果这是真的话，那么Root Hole将陷入危险之中。 奇怪，你只有地震的感觉而已吗？ 在Root Hole的情况真的很严重的呢！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_64_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_65_0">
    <VALUE Lang="GS">What's happening there?</VALUE>
    <VALUE Lang="GS">An earthquake in Root Hole?</VALUE>
    <VALUE Lang="GS">We don't understand what's going on.</VALUE>
    <VALUE Lang="id">Masuk akal nggak sih kalau ternyata Root Hole itu pusat terjadinya gempa?</VALUE>
    <VALUE Lang="id">Saya benar-benar tidak bisa memahaminya dengan akal sehat</VALUE>
    <VALUE Lang="id">Kok bisa yah dampak yang ditimbulkan dari kerugian seperti itu tidak terasa di tempat yang sedekat ini</VALUE>
    <VALUE Lang="id">Sebenarnya</VALUE>
    <VALUE Lang="cn">这是怎么回事呢？</VALUE>
    <VALUE Lang="cn">Root Hole的地震吗？</VALUE>
    <VALUE Lang="cn">我们不明白这是怎么回事。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_65_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_66_0">
    <VALUE Lang="GS">Oh, something at the Middle Hole Entrance is burning.</VALUE>
    <VALUE Lang="GS">Please go and check it out.</VALUE>
    <VALUE Lang="id">Ah, di daerah pintu masuk Midtown masih banyak mobil-mobil yang terbakar kan?</VALUE>
    <VALUE Lang="id">Mungkin saja kita bisa menemukan sesuatu yang bisa dijadikan petunjuk di sana?</VALUE>
    <VALUE Lang="cn">哦，有东西在Middle Hole的 Entrance那儿燃烧。</VALUE>
    <VALUE Lang="cn">请去看看。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_66_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_67_0">
    <VALUE Lang="GS">It's too dangerous~</VALUE>
    <VALUE Lang="GS">What if the car explodes?</VALUE>
    <VALUE Lang="id">Eh, kamu sudah melakukan sesuatu yang sangat berbahaya!</VALUE>
    <VALUE Lang="id">Gawat sekali kalau sampai mobil itu meledak?</VALUE>
    <VALUE Lang="id">Pada saat seperti itu kamu sampai bisa menemukan hal seperti ini</VALUE>
    <VALUE Lang="id">Meskipun saya tidak tahu hal seperti ini</VALUE>
    <VALUE Lang="id">Sudah pernah belajar di Sekolah Kep</VALUE>
    <VALUE Lang="cn">这太危险了，如果汽车爆炸的话，会怎样呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_67_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_68_0">
    <VALUE Lang="GS">Anyway, it's a bomb!</VALUE>
    <VALUE Lang="GS">No one knows who planted it.</VALUE>
    <VALUE Lang="GS">Wait a minute, is this some terrorist warning? Was that really an earthquake?</VALUE>
    <VALUE Lang="id">Kalau mau lebih gampang itu adalah bom</VALUE>
    <VALUE Lang="id">Sudah pasti part yang itu. Anak lonceng ini pasti salah satu bagian dari sensornya</VALUE>
    <VALUE Lang="id">Tapi kok bisa dia meninggalkan jejak seperti ini. Kalau bukan pemula orang itu pasti sangat berani.</VALUE>
    <VALUE Lang="id">Sebentar, kalau begitu</VALUE>
    <VALUE Lang="cn">无论如何，这是一个炸弹！</VALUE>
    <VALUE Lang="cn">没有人知道是谁埋下的。</VALUE>
    <VALUE Lang="cn">等一下！这是一些恐怖人士的警告？还是真的地震呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_68_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_69_0">
    <VALUE Lang="GS">How can an earthquake only hit such an isolated area?</VALUE>
    <VALUE Lang="GS">This needs to be checked out before it gets even more dangerous.</VALUE>
    <VALUE Lang="id">Saya tidak mengerti. Kok bisa yah membangkitkan getaran kuat seperti itu hanya di area yang dibatasi</VALUE>
    <VALUE Lang="id">Kayaknya akan sangat berbahaya kalau kita melakukan penelitian dengan semiteman</VALUE>
    <VALUE Lang="id">Harus ada cara berhubungan yang berkesinambungan</VALUE>
    <VALUE Lang="cn">地震怎么可能只在一个偏僻的地方发生？</VALUE>
    <VALUE Lang="cn">这需要进行检查，否则只会变得更加危险。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_69_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_7_0">
    <VALUE Lang="GS">This is great!</VALUE>
    <VALUE Lang="GS">You can restore the mail by reassembling its torn pieces. Try to see if you can put them all back together again.</VALUE>
    <VALUE Lang="id">Untung saja.</VALUE>
    <VALUE Lang="id">Padahal jarang sekali kita bisa menemukan kembali sesuatu yang sudah hilang</VALUE>
    <VALUE Lang="id">Ayo kita coba gabungkan untuk melihat apakah potongannya benar atau tidak</VALUE>
    <VALUE Lang="cn">太好了！</VALUE>
    <VALUE Lang="cn">您可以利用重组碎片的方式来复原邮件。试试看，看您能不能修复它们。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_7_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_70_0">
    <VALUE Lang="GS">Please take this walkie-talkie to the Image Expert to fix it.</VALUE>
    <VALUE Lang="GS">You can use this to contact me at anytime.</VALUE>
    <VALUE Lang="id">Ada radio satu tapi setelah kecelakaan terjadi tidak bisa dipakai</VALUE>
    <VALUE Lang="id">Sepertinya ini bisa diperbaiki kalau kamu bawa ke Audio Visual Expert yang ada di sana</VALUE>
    <VALUE Lang="id">Tolong betulkan ini agar kita bisa terus berhubungan ke depannya</VALUE>
    <VALUE Lang="cn">请把”对讲机“交给Image Expert，并请求他进行修复。</VALUE>
    <VALUE Lang="cn">您可以用它来随时联系我唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_70_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_71_0">
    <VALUE Lang="GS">This is really dangerous! What if the car explodes?</VALUE>
    <VALUE Lang="id">Eh, kamu sudah melakukan sesuatu yang sangat berbahaya!</VALUE>
    <VALUE Lang="id">Gawat sekali kalau sampai mobil itu meledak?</VALUE>
    <VALUE Lang="id">Pada saat seperti itu kamu sampai bisa menemukan hal seperti ini</VALUE>
    <VALUE Lang="id">Meskipun saya tidak tahu hal seperti ini</VALUE>
    <VALUE Lang="id">Sudah pernah belajar di Sekolah Kep</VALUE>
    <VALUE Lang="cn">这是非常危险的！如果汽车爆炸的话，会怎样呢?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_71_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_72_0">
    <VALUE Lang="GS">Anyway, it's a bomb.</VALUE>
    <VALUE Lang="GS">No one knows who planted it.</VALUE>
    <VALUE Lang="GS">Wait a minute, is this some terrorist warning? Was that really an earthquake?</VALUE>
    <VALUE Lang="id">Sudah pasti part yang itu. Anak lonceng ini pasti salah satu bagian dari sensornya</VALUE>
    <VALUE Lang="id">Tapi kok bisa dia meninggalkan jejak seperti ini. Kalau bukan pemula orang itu pasti sangat berani.</VALUE>
    <VALUE Lang="id">Sebentar, kalau begitu gempa bumi yang terjadi di sana adalah geta</VALUE>
    <VALUE Lang="cn">无论如何，这是一个炸弹！</VALUE>
    <VALUE Lang="cn">没有人知道是谁埋下的。</VALUE>
    <VALUE Lang="cn">等一下！这是一些恐怖人士的警告？还是真的地震呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_72_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_73_0">
    <VALUE Lang="GS">Still receiving info, let's just keep in contact with each other.</VALUE>
    <VALUE Lang="id">Ada banyak laporan tentang kecelakaan dari banyak tempat</VALUE>
    <VALUE Lang="id">Karena kami meminta banyak bantuan kepada kamu</VALUE>
    <VALUE Lang="id">Lebih baik saling berhubungan terus demi keamanan</VALUE>
    <VALUE Lang="id">Baik kayaknya</VALUE>
    <VALUE Lang="cn">请继续接收信息，让我们保持相互联系。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_73_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_74_0">
    <VALUE Lang="GS">Please take the walkie-talkie to the Image Expert to fix it.</VALUE>
    <VALUE Lang="id">Ada sih radio yang disimpan sebagai peralatan umum</VALUE>
    <VALUE Lang="id">Setelah bencana terjadi tidak bisa dioperasikan sama sekali</VALUE>
    <VALUE Lang="id">Kayaknya ini rusak karena pengaruh sesuatu</VALUE>
    <VALUE Lang="id">Satu-satunya cara untuk berhubungan adalah ini karena itu cobalah betulkan kepada Audio V</VALUE>
    <VALUE Lang="cn">请把对讲机交给Image Expert 进行修复</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_75_0">
    <VALUE Lang="GS">The signal's on! The walkie-talkie is fixed…</VALUE>
    <VALUE Lang="GS">Now we can keep in contact with each other.</VALUE>
    <VALUE Lang="id">Karena sinyalnya tertangkap mungkin saja…</VALUE>
    <VALUE Lang="id">Sudah membetulkan radionya yah</VALUE>
    <VALUE Lang="id">Bagus sekali.</VALUE>
    <VALUE Lang="id">Kalau nanti kita punya masalah kita bisa saling mengetahui</VALUE>
    <VALUE Lang="id">Saya berharap agar hal seperti itu tidak terjadi tapi…</VALUE>
    <VALUE Lang="cn">有信号了！对讲机修好了。</VALUE>
    <VALUE Lang="cn">现在我们可以继续保持联系了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_75_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_76_0">
    <VALUE Lang="GS">Oh, I need some time to clean it up.</VALUE>
    <VALUE Lang="GS">There aren't many good facilities here. It's good cause for worry since we've mostly got weird facilities.</VALUE>
    <VALUE Lang="id">Wah ini penanganannya jadi susah</VALUE>
    <VALUE Lang="id">Untung saja di prison tidak ada peralatan yang hebat, tapi karena gedung utamanya memiliki berbagai alat yang mencurigakan kita tidak bisa lengah karena tahu apa yang akan terjadi</VALUE>
    <VALUE Lang="cn">哦，我需要一些时间来清理。</VALUE>
    <VALUE Lang="cn">这里大多的设施都不是很好。这是很令人担心的部分，因为我们这边的设施都已经开始出现问题了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_76_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_77_0">
    <VALUE Lang="GS">I hear there's a room underground.</VALUE>
    <VALUE Lang="GS">Nobody believed me.</VALUE>
    <VALUE Lang="GS">We'd better go and check.</VALUE>
    <VALUE Lang="id">Di lantai bawah tanah prison ada ruang penelitian anggota badan, di sana mereka mengotopsi makhluk luar angkasa</VALUE>
    <VALUE Lang="id">Pernah ada juga kabar yang mengatakan ada</VALUE>
    <VALUE Lang="id">Tentu saja tidak ada yang percaya dengan cerita seperti itu.</VALUE>
    <VALUE Lang="id">Tapi saya yakin ada sesuatu yan</VALUE>
    <VALUE Lang="cn">我听说有一个地下室的房间。</VALUE>
    <VALUE Lang="cn">可是没有人相信我。</VALUE>
    <VALUE Lang="cn">我们最好去检查一下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_77_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_78_0">
    <VALUE Lang="GS">This is a complete report.</VALUE>
    <VALUE Lang="GS">We need to give a warning, and the students also need to be careful.</VALUE>
    <VALUE Lang="id">Kok bukan apa-apa,,itu laporan yang sangat cukup.</VALUE>
    <VALUE Lang="id">Biar kami saja yang memberi peringatan tentang para buronan</VALUE>
    <VALUE Lang="id">Kamu juga harus hati-hati ke depannya.</VALUE>
    <VALUE Lang="cn">这是一个完整的报告。我们需要给他们一次警告，而你们做学生的也需要小心行动。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_78_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_79_0">
    <VALUE Lang="GS">According to the police document, the prison is using too many resources like medicine and equipment.</VALUE>
    <VALUE Lang="GS">This information needs to be confirmed.</VALUE>
    <VALUE Lang="id">Data dari kepolisian menunjukkan bahwa 'Saint Prison' telah memproduksi obat-obatan dan peralatan dalam jumlah besar</VALUE>
    <VALUE Lang="id">Saya tidak yakin, tapi sepertinya sesuatu yang berbahaya terjadi di sana dan kemungkinan besar berpengaruh ke tempat lain.</VALUE>
    <VALUE Lang="cn">根据警方文件，监狱是使用了太多的资源，如药品和设备。</VALUE>
    <VALUE Lang="cn">这些信息需要被证实才行。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_79_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_8_0">
    <VALUE Lang="GS">I know it's unusual for a Police Officer to beg for help from citizens like you. However, the lack of available manpower in the Station gives us no choice. I'm very thankful that students like you are willing to help us out.</VALUE>
    <VALUE Lang="id">Ini…memang sih kalau polisi meminta bantuan kepada warga sipil seperti ini sedikit.</VALUE>
    <VALUE Lang="id">Mau apa lagi karena sekarang tenaga kerja Polisi sudah banyak berkurang</VALUE>
    <VALUE Lang="cn">我知道警察向公民做请求是很奇怪的一件事情。然而，现在警察局缺乏人手，我们别无选择。非常感激学生您愿意帮助我们。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_8_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_80_0">
    <VALUE Lang="GS">It's pretty funny that this document is fake.</VALUE>
    <VALUE Lang="GS">Even a machine can't tell the difference.</VALUE>
    <VALUE Lang="GS">It seems like real experts were behind this.</VALUE>
    <VALUE Lang="id">Ini benar-benar dokumen tiruan yang menarik</VALUE>
    <VALUE Lang="id">Kalau seperti ini jangankan manusia mesin saja bisa tertipu</VALUE>
    <VALUE Lang="id">Mungkin orang yang benar-benar tahu kelemahan sistem telah membuatnya.</VALUE>
    <VALUE Lang="cn">这是很有趣的，这份文件是假的。</VALUE>
    <VALUE Lang="cn">即使是机器也无法分辨出来。</VALUE>
    <VALUE Lang="cn">似乎有真正的专家们在背后指使。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_80_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_81_0">
    <VALUE Lang="GS">There's no need to bother too much since the internet connection seems to be down.</VALUE>
    <VALUE Lang="GS">Thanks for your information.</VALUE>
    <VALUE Lang="id">Lagipula sekarang jaringannya tidak berjalan dengan baik</VALUE>
    <VALUE Lang="id">Saya tidak percaya dengan mesin….</VALUE>
    <VALUE Lang="id">Kalau bisa memberikan peringatan kepada orang-orang saja kayaknya sudah cukup</VALUE>
    <VALUE Lang="id">Pokoknya terimakasih sudah memberi tahu saya.</VALUE>
    <VALUE Lang="cn">不需要去理会太多，因为互联网连接似乎没有被启动。</VALUE>
    <VALUE Lang="cn">感谢您的资料提供。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_81_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_82_0">
    <VALUE Lang="GS">The same thing also happened in this city last time.</VALUE>
    <VALUE Lang="id">Sebelumnya juga pernah terjadi hal yang sama</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="id">Apakah ini sesuatu yang bahkan tidak perlu di konfirmasikan?</VALUE>
    <VALUE Lang="id">Di kota yang sudah menjadi kacau seperti ini</VALUE>
    <VALUE Lang="cn">上次也有同样的事情发生在这个城市。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_82_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_83_0">
    <VALUE Lang="GS">No, it's the police's responsibility to investigate…</VALUE>
    <VALUE Lang="GS">But we still need help from the students.</VALUE>
    <VALUE Lang="id">Tidak, meskipun begitu memeriksanya adalah pekerjaan kami sebagai polisi</VALUE>
    <VALUE Lang="id">Malah kondisi nya menjadi seperti ini kami meminta bantuan kepada para pelajar</VALUE>
    <VALUE Lang="id">Tiba-tiba saya jadi sangsi dengan keberadaan saya</VALUE>
    <VALUE Lang="cn">不，这调查是警方的责任...</VALUE>
    <VALUE Lang="cn">但我们仍需要学生们的协助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_83_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_84_0">
    <VALUE Lang="GS">The data came from campus?</VALUE>
    <VALUE Lang="GS">If that's true, the situation in Root Hole is getting worse.</VALUE>
    <VALUE Lang="id">Sekolah sudah mengirimkan data rupanya?</VALUE>
    <VALUE Lang="id">Di mana…</VALUE>
    <VALUE Lang="id">Ini banyak sekali</VALUE>
    <VALUE Lang="id">Kalau seperti ini mungkin situasi di Root Hole jauh diluar perkiraan</VALUE>
    <VALUE Lang="id">Ditambah lagi apa ini?</VALUE>
    <VALUE Lang="cn">从校园内寄出去的数据？</VALUE>
    <VALUE Lang="cn">如果这是真的，Root Hole的情况是真的越来越严重了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_84_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_85_0">
    <VALUE Lang="GS">I'm not sure what the problem is now.</VALUE>
    <VALUE Lang="GS">Please go to Root Hole and check on it.</VALUE>
    <VALUE Lang="id">Ada prediksi bahwa komponen porosnya tidak stabil atau tetap?</VALUE>
    <VALUE Lang="id">Saya tidak bisa mengerti maksudnya…</VALUE>
    <VALUE Lang="id">Pokoknya ada kemungkinan kalau sesuatu yang hebat terjadi</VALUE>
    <VALUE Lang="id">Tolong pergi ke Root Hole dan cek situasi disana</VALUE>
    <VALUE Lang="id">Saya berharap masih ada yang bisa dil</VALUE>
    <VALUE Lang="cn">我不确定现在发生了哪些问题。</VALUE>
    <VALUE Lang="cn">请去Root Hole，并进行确认。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_85_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_86_0">
    <VALUE Lang="GS">Thanks. I know this item isn't anything special, but…</VALUE>
    <VALUE Lang="GS">We better request help from the Sacred Financial Group.</VALUE>
    <VALUE Lang="id">Terimakasih atas kerja kerasnya.</VALUE>
    <VALUE Lang="id">Ngomong-ngomong ini kok tidak kelihatan sebagai Sphere luar biasa seperti yang digosipkan?</VALUE>
    <VALUE Lang="id">Saya simpan sebagai contoh item penyelidikkans saja dulu</VALUE>
    <VALUE Lang="id">Benda yang bersifat fenomena seperti ini sulit untuk diperiksa de</VALUE>
    <VALUE Lang="cn">谢谢。我知道这个物品没有什么特别的，但是...</VALUE>
    <VALUE Lang="cn">我们最好还是向Sacred Financial Group请求帮助吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_86_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_87_0">
    <VALUE Lang="GS">Oh, what is it called?</VALUE>
    <VALUE Lang="GS">A Doll?</VALUE>
    <VALUE Lang="id">Ah, soalnya saya harur memeriksa</VALUE>
    <VALUE Lang="id">Tadi kamu bilang bahwa yang membawa…sphere ini adalah boneka?</VALUE>
    <VALUE Lang="id">Bonekanya bergerak kalau ditaruh sphere di dalamnya?</VALUE>
    <VALUE Lang="id">Benar-benar deh…</VALUE>
    <VALUE Lang="cn">哦，它叫什么？</VALUE>
    <VALUE Lang="cn">一个玩偶？！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_87_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_88_0">
    <VALUE Lang="GS">Please arrest RocknRoll.</VALUE>
    <VALUE Lang="id">Pertama tangkap dulu Guitar Singer yang kabur setelah melakukan tindakan kekerasan kepada para citizen dan mencuri item terlarang</VALUE>
    <VALUE Lang="cn">请逮捕RocknRoll</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_88_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_89_0">
    <VALUE Lang="GS">I have one report that I receive every morning.</VALUE>
    <VALUE Lang="GS">There are lots of people that enter and leave the refrigeration warehouse at the main wharf. The operators are unable to maintain the warehouse's temperature.</VALUE>
    <VALUE Lang="GS">We discovered that old employees with their ID Cards would come in and out.</VALUE>
    <VALUE Lang="GS">But we are not sure how many there are… It's not hard to make copies, after all.</VALUE>
    <VALUE Lang="GS">Anyway... Will you help us by gathering ID Cards?</VALUE>
    <VALUE Lang="id">Kebetulan ada satu laporan yang masuk…</VALUE>
    <VALUE Lang="id">Terlalu banyak orang yang masuk ke Ice warehouse yang ada di Wharf Passage sehingga sistem pendinginnya tidak berjalan dengan baik</VALUE>
    <VALUE Lang="id">Setelah kami cari tahu ternyata hal itu terjadi karena orang-orang yang dulu b</VALUE>
    <VALUE Lang="cn">我每天早上都会接到有人报案说，Main wharf Refrigeration Warehouse出入的人太多，导致冷冻状态无法维持。</VALUE>
    <VALUE Lang="cn">我们还发现前任警卫们甚至持着ID Card不停进出。</VALUE>
    <VALUE Lang="cn">不确定它们有多少人在那儿，但毕竟要复制是很容易的。</VALUE>
    <VALUE Lang="cn">总之，您愿意帮我们取回那些ID Card吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_89_0_1">
    <VALUE Lang="GS">Accept</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_89_0_2">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_9_0">
    <VALUE Lang="GS">Good work with the investigation! However, we still lack some clues and evidence.</VALUE>
    <VALUE Lang="id">Ternyata penyelidikkannya berjalan cepat</VALUE>
    <VALUE Lang="id">Mana coba</VALUE>
    <VALUE Lang="id">Begitu rupanya</VALUE>
    <VALUE Lang="id">Tidak ada petunjuk apapun</VALUE>
    <VALUE Lang="cn">良好的工作成果总是需要精密的调查来辅佐！但我们现在仍然缺乏一些线索和证据。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_9_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_90_0">
    <VALUE Lang="GS">There are two kinds of security guards. The one with a gun is usually the tougher kind.</VALUE>
    <VALUE Lang="GS">Higher level security guards have a better chance to holding ID Cards, but they're also more dangerous.</VALUE>
    <VALUE Lang="id">Penjaga dibedakan menjadi dua pangat, para penjaga yang membawa senjata api adalah mereka yang berpangkat tinggi</VALUE>
    <VALUE Lang="id">Semakin tinggi pangkatnya semakin tinggi kemungkinan dia punya kartu izin masuk tapi…harus selalu hati-hati dengan bahaya yang ada.</VALUE>
    <VALUE Lang="cn">警卫分为两个等级。持有枪支的是比较高级的。等级越高，持有ID Card的机率越大。不过，他们很危险的。请小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_90_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_91_0">
    <VALUE Lang="GS">Yes. I received them.</VALUE>
    <VALUE Lang="GS">I appreciate your help.</VALUE>
    <VALUE Lang="GS">I believe it was not an easy task…</VALUE>
    <VALUE Lang="GS">But we still receive the report every morning. So I think there are still many ID Cards. If you have a time, Please help me to collect ID Cards more.</VALUE>
    <VALUE Lang="id">Iya sudah diterima dengan pasti</VALUE>
    <VALUE Lang="id">Terimakasih atas kerja kerasnya.</VALUE>
    <VALUE Lang="id">Padahal pasti susah untuk mencarinya tak seperti dulu…</VALUE>
    <VALUE Lang="id">Kalau dilihat dari laporan yang terus masuk sepertinya kartu izin masuk masih banyak berkeliaran</VALUE>
    <VALUE Lang="id">Kalau nanti kamu punya w</VALUE>
    <VALUE Lang="cn">是的！我拿到了！谢谢您。辛苦了！</VALUE>
    <VALUE Lang="cn">我相信您一定吃了很多苦头。</VALUE>
    <VALUE Lang="cn">但是相关的抗议事件持续不断进来，我想还是有很多 ID Card在他们的手中。</VALUE>
    <VALUE Lang="cn">如果您时间允许，可以再麻烦您帮我们收集更多的ID Cards 吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_91_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_92_0">
    <VALUE Lang="GS">Thank you very much.</VALUE>
    <VALUE Lang="GS">I will use as a reference.</VALUE>
    <VALUE Lang="GS">Actually I was hoping to find this…</VALUE>
    <VALUE Lang="id">Terimakasih.</VALUE>
    <VALUE Lang="id">Akan saya jadikan acuan untuk ke depannya.</VALUE>
    <VALUE Lang="id">Kebetulan saya sedang butuh itu</VALUE>
    <VALUE Lang="cn">非常感谢您。</VALUE>
    <VALUE Lang="cn">我会参考的！</VALUE>
    <VALUE Lang="cn">其实我正刚好需要它~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_92_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_93_0">
    <VALUE Lang="GS">Thanks for visiting us.</VALUE>
    <VALUE Lang="GS">I don't know whether this formal procedure is effective or not, but it might be helpful for somebody.</VALUE>
    <VALUE Lang="id">Terimakasih sudah menemukannya</VALUE>
    <VALUE Lang="id">Kadang saya berpikir apa perlu mengikuti langkah-langkah yang formal seperti ini sekarang</VALUE>
    <VALUE Lang="cn">很感谢您的到访。</VALUE>
    <VALUE Lang="cn">我不知道这道形式上的程序是否会有效果，但也许对某人来说是救命良药也说不定。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_93_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_94_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">…</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_95_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">…</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_0">
    <VALUE Lang="GS">Hey.. I am the Scientist Student Representative..</VALUE>
    <VALUE Lang="id">Euhm…aku Science Club Manager</VALUE>
    <VALUE Lang="cn">嘿！我是超能部的学生代表。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_0_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">进行交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1">
    <VALUE Lang="GS">Scientist Teacher is at school. If you need anything just tell me.</VALUE>
    <VALUE Lang="id">Science club instructor ada di Sekolah, bilang saya saja kalau ada perlu apa-apa</VALUE>
    <VALUE Lang="cn">超能部老师在校内。有啥需要尽管跟我说。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">进行交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_10">
    <VALUE Lang="GS">Give the Time Capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">交付时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_11">
    <VALUE Lang="GS">Accept Instructions</VALUE>
    <VALUE Lang="id">Menerima perintah</VALUE>
    <VALUE Lang="cn">接受指导</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_2">
    <VALUE Lang="GS">Say hello to senior student</VALUE>
    <VALUE Lang="id">Menyapa kakak kelas</VALUE>
    <VALUE Lang="cn">向学长打招呼</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_3">
    <VALUE Lang="GS">Ask about Saint List</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_4">
    <VALUE Lang="GS">Ask about Saint List</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_5">
    <VALUE Lang="GS">Ask about Saint List</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_6">
    <VALUE Lang="GS">Deliver the time capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">交付时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_7">
    <VALUE Lang="GS">Ask if she needs help with anything</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">询问她是否需要任何帮助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_8">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Menerima pelajaran</VALUE>
    <VALUE Lang="cn">参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_1_1_9">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Menerima pelajaran</VALUE>
    <VALUE Lang="cn">参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_10_0">
    <VALUE Lang="GS">Oh! You found it!</VALUE>
    <VALUE Lang="GS">It's been 18 years since I last saw this device by a specialist named Liu Cheng You.</VALUE>
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="id">Untung sekali akhirnya kamu menemukannya</VALUE>
    <VALUE Lang="id">Dikubur sehari setelah kejadian hujan meteor itu terjadi</VALUE>
    <VALUE Lang="id">Terimakasih kamu sudah menemukannya dengan baik…</VALUE>
    <VALUE Lang="cn">找出来了！</VALUE>
    <VALUE Lang="cn">18年前看见Liu Cheng You的隔天埋下的。</VALUE>
    <VALUE Lang="cn">托你的福找到了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_11_0">
    <VALUE Lang="GS">Student! Please remember that consistent training will be part of your quest for victory. There will be times of disappointment ahead but you need not be sad. Just focus on your training and you'll definitely become a more powerful individual.</VALUE>
    <VALUE Lang="id">Eum? Pelajaran?</VALUE>
    <VALUE Lang="id">Kalau sudah berlari-lari seperti itu, bisa dibilang kamu sudah berolahraga kan?</VALUE>
    <VALUE Lang="id">Walaupun kecewa mau apa lagi</VALUE>
    <VALUE Lang="cn">嗯 上课</VALUE>
    <VALUE Lang="cn">那样子跑来跑去大概也算有运动到吧</VALUE>
    <VALUE Lang="cn">就算失望没办法啦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_11_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_12_0">
    <VALUE Lang="GS">If you don't know the importance of physical strength, then it will be very difficult for you to understand future lessons.</VALUE>
    <VALUE Lang="GS">By the way, I need to ask you to do something.</VALUE>
    <VALUE Lang="id">Kelas akan menjadi sangat sulit kalau kamu tidak tahu tentang pentingnya stamina yang paling dasar</VALUE>
    <VALUE Lang="id">Ngomong-ngomong...saya mau minta bantuan sesuatu….</VALUE>
    <VALUE Lang="cn">如果不知道基础体力的重要性后面的课会很辛苦</VALUE>
    <VALUE Lang="cn">那个嘛 还要麻烦你一件事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_12_0_1">
    <VALUE Lang="GS">Accept Instruction</VALUE>
    <VALUE Lang="id">Menerima perintah</VALUE>
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_12_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_13_0">
    <VALUE Lang="GS">Did you see the Police Station nearby?</VALUE>
    <VALUE Lang="GS">There is a police officer waiting for you at the Main Door.</VALUE>
    <VALUE Lang="GS">Just approach him and tell him that I instructed you to look for him. I believe he'll have something for you.</VALUE>
    <VALUE Lang="id">Sudah lihat polisi yang ada di sekitar sini kan?</VALUE>
    <VALUE Lang="id">Akan ada seorang polisi yang menunggu di depan pintu masuk</VALUE>
    <VALUE Lang="id">Kalau kamu pergi ke sana dan bilang bahwa saya mengirim kamu, dia pasti akan memintamu melakukan sesuatu</VALUE>
    <VALUE Lang="cn">有看见附近的警察局吗？</VALUE>
    <VALUE Lang="cn">Main Door前面会有一位警察等你！</VALUE>
    <VALUE Lang="cn">跟他说是我要你去的，那么他就会给你任务。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_13_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_14_0">
    <VALUE Lang="GS">Broaden your horizons! It is great to look at things from different perspectives!</VALUE>
    <VALUE Lang="GS">Imagine this is part of the lesson!</VALUE>
    <VALUE Lang="GS">Someday, this may benefit you and the people you care about.</VALUE>
    <VALUE Lang="id">Pergilah</VALUE>
    <VALUE Lang="id">Kalau berpikir bahwa ini juga adalah bagian dari pelajaran yah….</VALUE>
    <VALUE Lang="id">Baik untuk kedua belah pihak kan?</VALUE>
    <VALUE Lang="cn">尽量去看看吧</VALUE>
    <VALUE Lang="cn">想像这也是课的一环</VALUE>
    <VALUE Lang="cn">这样彼此都会比较好吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_15_0">
    <VALUE Lang="GS">Did you see the Police Station nearby?</VALUE>
    <VALUE Lang="GS">There is a police officer waiting for you at the Main Door.</VALUE>
    <VALUE Lang="GS">Just approach him and tell him that I instructed you to look for him. I believe he'll have something for you.</VALUE>
    <VALUE Lang="id">Sudah lihat polisi yang ada di sekitar sini kan?</VALUE>
    <VALUE Lang="id">Akan ada seorang polisi yang menunggu di depan pintu masuk</VALUE>
    <VALUE Lang="id">Kalau kamu pergi ke sana dan bilang bahwa saya mengirim kamu, dia pasti akan memintamu melakukan sesuatu</VALUE>
    <VALUE Lang="cn">有看见附近的警察局吗？</VALUE>
    <VALUE Lang="cn">Main Door前面会有一位警察等你！</VALUE>
    <VALUE Lang="cn">跟他说是我要你去的，那么他就会给你任务。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_15_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_2_0">
    <VALUE Lang="GS">We, Scientists have found more facts and know more about the meteorite that happened 18 years ago.</VALUE>
    <VALUE Lang="GS">The Director must have found out the relationship between our world and Another World.</VALUE>
    <VALUE Lang="GS">He had said that the phenomena caused by the prior actions of both sides will affect our world.</VALUE>
    <VALUE Lang="id">Kita Gunner Class mengetahui peristiwa hujan meteor yang terjadi 18 tahun lalu lebih banyak</VALUE>
    <VALUE Lang="id">Sepertinya Director Lee sudah sedikit tahu tentang hubungan dari dunia kita dengan dunia lain</VALUE>
    <VALUE Lang="id">Katanya fenomena yang terjadi karena perang diantara kedua be</VALUE>
    <VALUE Lang="cn">我们超能部对于18年前发生的流星雨现象多少有些了解,</VALUE>
    <VALUE Lang="cn">理事长他似乎多多少少猜到了异世界和我们的世界之间的关系,</VALUE>
    <VALUE Lang="cn">他预测双边牵引而产生的一些现象，势必会影响到我们生活的世界</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_2_0_1">
    <VALUE Lang="GS">Continue to listen to her story</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续听取她的故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_3_0">
    <VALUE Lang="GS">The Phenomenon that seemed like meteorite was actually..</VALUE>
    <VALUE Lang="GS">A life form from the Another World could not cross over to our side in one piece so it was divided into so many particles and came over. Saint List is contains the names of us, students. That is how only we have survived the phenomenon.</VALUE>
    <VALUE Lang="id">Yang terlihat seperti hujan meteor yah.</VALUE>
    <VALUE Lang="id">Tidak ada nyawa yang bisa datang seutuhnya dari dunia lain sehingga mereka terbagi menjadi banyak bagian dan datang ke sini</VALUE>
    <VALUE Lang="id">Daftar sint adalah daftar dimana nama-nama orang seperti kita tercantum</VALUE>
    <VALUE Lang="id">Karena it</VALUE>
    <VALUE Lang="cn">看起来像流星雨的现象是因为在异世界的生命体无法以完整的型体来到我们的世界,</VALUE>
    <VALUE Lang="cn">而是变成许多流星雨的型态来到这世界,</VALUE>
    <VALUE Lang="cn">圣财团意见书上面就记载了我们的名字在里面, 因此只有我们能熬过异变的现象。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_3_0_1">
    <VALUE Lang="GS">Continue to listen to her story</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续听取她的故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_4_0">
    <VALUE Lang="GS">He must have planned to prepared the students like us for the time when the phenomenon occur..</VALUE>
    <VALUE Lang="GS">I guess, he must have done things like that because it is the life or death of our world.</VALUE>
    <VALUE Lang="GS">Well, aren't all the adults like that?..</VALUE>
    <VALUE Lang="id">Pada saat bencana terjadi, mereka mencoba untuk melakukan pencegahan dengan cara mengumpulkan pelajar-pelajar seperti kita.</VALUE>
    <VALUE Lang="id">Sepertinya hal itu dilakukan karena keselamatan dunia kita terancam.</VALUE>
    <VALUE Lang="id">Semua orang tua memang begitu…</VALUE>
    <VALUE Lang="cn">发生异变的时候,曾想要召集我们这些学生来避难,</VALUE>
    <VALUE Lang="cn">因为关系着我们世界的生存,所以想要那样做了吧.</VALUE>
    <VALUE Lang="cn">大人们都是那样的想法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_4_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_5_0">
    <VALUE Lang="GS">According to the gym managers around here, people of Trading Hole had buried time capsules before the phenomenon.</VALUE>
    <VALUE Lang="GS">They just buried them a few days before it happened so it must help you understand what was going on before the phenomenon.</VALUE>
    <VALUE Lang="id">Menurut agent yang ada di sekitar sini, orang-orang dari Trading Hole mengubur Time capsule sebelum bencana terjadi</VALUE>
    <VALUE Lang="id">Katanya dikubur beberapa saat sebelum bencana terjadi, kalau kamu bisa menemukannya mungkin kamu bisa tahu apa yang sudah terjadi</VALUE>
    <VALUE Lang="cn">听附近的代理师傅说在发生异变之前Trading Hole的人把时间胶囊埋起来了,</VALUE>
    <VALUE Lang="cn">在还没发生异变的不久之前埋的,你去找找看,就能知道过去发生了哪些事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_5_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_6_0">
    <VALUE Lang="GS">Great! You've got it!</VALUE>
    <VALUE Lang="GS">This will be a super help for me to investigate this area. Thank you!</VALUE>
    <VALUE Lang="id">Sudah menemukannya rupanya</VALUE>
    <VALUE Lang="id">Sepertinya ini akan menjadi bantuan yang besar pada saat menyelidiki daerah sekitar sini</VALUE>
    <VALUE Lang="id">Terimakasih.</VALUE>
    <VALUE Lang="cn">你找回来了,</VALUE>
    <VALUE Lang="cn">这个对调查这附近的情况会有很大的帮助.</VALUE>
    <VALUE Lang="cn">谢谢你</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_6_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_7_0">
    <VALUE Lang="GS">Would you like to have some lessons?</VALUE>
    <VALUE Lang="GS">There's nothing more worthwhile than teaching you students!</VALUE>
    <VALUE Lang="GS">The manager's not around, so I can teach you some lessons myself.</VALUE>
    <VALUE Lang="GS">Is that fine with you?</VALUE>
    <VALUE Lang="id">Heum…pelajaran yah…</VALUE>
    <VALUE Lang="id">Enggak ada yang mau aku ajarkan juga sih</VALUE>
    <VALUE Lang="id">Bisa gawat apalagi pada saat Kepala jurusan Gunner tidak ada di sini</VALUE>
    <VALUE Lang="id">Kalau memang itu mau aku bisa memberikan sedikit bantuan</VALUE>
    <VALUE Lang="cn">"阿!?上课</VALUE>
    <VALUE Lang="cn">又不是值得教的东西</VALUE>
    <VALUE Lang="cn">再说现在馆长不在也是有点麻烦</VALUE>
    <VALUE Lang="cn">虽说如果你希望的话是可以给你一点帮助"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_7_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_8_0">
    <VALUE Lang="GS">There is nothing special about this device!</VALUE>
    <VALUE Lang="GS">You should find the GPS first, and then an input device..</VALUE>
    <VALUE Lang="id">Bukan sesuatu yang begitu luar biasa…</VALUE>
    <VALUE Lang="id">Kamu cari dulu GPSnya lalu temukan item yang dikubur di tempat yang ditunjukkan oleh GPS</VALUE>
    <VALUE Lang="cn">没啥了不起的</VALUE>
    <VALUE Lang="cn">先找到GPS 然后把埋在输入地方的东西找来</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_8_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_9_0">
    <VALUE Lang="GS">This is a stolen GPS! It's great that you found it.</VALUE>
    <VALUE Lang="GS">Ah! I was just talking to myself. You're free to go.</VALUE>
    <VALUE Lang="GS">I'm sorry for acting so strangely.</VALUE>
    <VALUE Lang="id">….Memang sih ini GPS yang dulu dicuri, pada kesempatan ini harus kita temukan nih</VALUE>
    <VALUE Lang="id">Euhm? Ah, aku ngomong sendiri jangan dipedulikan</VALUE>
    <VALUE Lang="id">Nah, pergilah</VALUE>
    <VALUE Lang="cn">虽说是以前被偷的GPS 趁这次机会要找到</VALUE>
    <VALUE Lang="cn">嗯 阿 我自言自语 不要理我</VALUE>
    <VALUE Lang="cn">好 你走吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_s_science.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_0">
    <VALUE Lang="GS">Welcome to the Trading Hole Area!</VALUE>
    <VALUE Lang="GS">I am the Archery Section Agent. How can I help you?</VALUE>
    <VALUE Lang="GS">Please feel free to look around if you like.</VALUE>
    <VALUE Lang="id">Ini adalah club Archery, ada perlu apa yah?</VALUE>
    <VALUE Lang="cn">欢迎来到Trading Hole。</VALUE>
    <VALUE Lang="cn">我是弓箭部服务员。</VALUE>
    <VALUE Lang="cn">需要什么帮忙呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1">
    <VALUE Lang="GS">I'm sorry the Manager isn't here right now.</VALUE>
    <VALUE Lang="GS">Please come back again later.</VALUE>
    <VALUE Lang="GS">In the meantime, is there anything I can do for you?</VALUE>
    <VALUE Lang="id">Sekarang Kepala kantor sedang tidak ada di tempat</VALUE>
    <VALUE Lang="id">Kalau kamu sudah menemukan Kepala kantor nanti bisa tolong datang lagi?</VALUE>
    <VALUE Lang="cn">馆长现在不在。</VALUE>
    <VALUE Lang="cn">请稍后再来。</VALUE>
    <VALUE Lang="cn">或者有什么我能先为您服务的吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_1">
    <VALUE Lang="GS">Request to Attend Class</VALUE>
    <VALUE Lang="id">Meminta latihan</VALUE>
    <VALUE Lang="cn">请求参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_10">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_11">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_14">
    <VALUE Lang="GS">Deliver the Time Capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">传达时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_15">
    <VALUE Lang="GS">Gather Info before the Incident</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">收集事故发生前的资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_4">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Mengikuti latihan</VALUE>
    <VALUE Lang="cn">参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_5">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Mengikuti latihan</VALUE>
    <VALUE Lang="cn">参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_6">
    <VALUE Lang="GS">Give the Time Capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">交付时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_7">
    <VALUE Lang="GS">Accept Instructions</VALUE>
    <VALUE Lang="id">Menerima petunjuk</VALUE>
    <VALUE Lang="cn">接受指导</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_8">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_1_1_9">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_10_0">
    <VALUE Lang="GS">There is nothing special about this device!</VALUE>
    <VALUE Lang="GS">You should find the GPS first, and then an input device.</VALUE>
    <VALUE Lang="id">Bukan sesuatu yang begitu luar biasa…</VALUE>
    <VALUE Lang="id">Kamu cari dulu GPSnya lalu temukan item yang dikubur di tempat yang ditunjukkan oleh GPS</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">这装置没有什么了不起的。您应该先找出GPS ，然后才是设备的输入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_11_0">
    <VALUE Lang="GS">This is a stolen GPS! It's great that you found it.</VALUE>
    <VALUE Lang="GS">Ah! I was just talking to myself.</VALUE>
    <VALUE Lang="GS">Alright, you may go. I'm sorry for acting so strangely.</VALUE>
    <VALUE Lang="id">Memang sih itu adalah GPS yang hilang dulu, di kesempatan ini saya harus bisa menemukannya…</VALUE>
    <VALUE Lang="id">Euhm? Ah, aku ngomong sendiri jangan dipedulikan</VALUE>
    <VALUE Lang="id">Nah, cepat</VALUE>
    <VALUE Lang="cn">这是被偷走的GPS！ 我很高兴您找到它了！噢！我只是在自言自语。您可以走了！我为我奇怪的言行深感歉意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_12_0">
    <VALUE Lang="GS">.......5</VALUE>
    <VALUE Lang="id">.......5</VALUE>
    <VALUE Lang="cn">.......5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_13_0">
    <VALUE Lang="GS">Oh! You found it!</VALUE>
    <VALUE Lang="GS">It's been 18 years since I last saw this device by a specialist named Liu Cheng You.</VALUE>
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="id">Untung sekali akhirnya kamu menemukannya</VALUE>
    <VALUE Lang="id">Aku kubur itu 18 tahun yang lalu bersama teman-teman setelah melihat hujan meteor</VALUE>
    <VALUE Lang="cn">噢！您找到它了！我透过专家Liu Cheng You最后看到这个装置已经是18年前的事情了！</VALUE>
    <VALUE Lang="cn">非常感谢您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_14_0">
    <VALUE Lang="GS">Student! Please remember that consistent training will be part of your quest for victory. There will be times of disappointment ahead but you need not be sad. Just focus on your training and you'll definitely become a more powerful individual.</VALUE>
    <VALUE Lang="id">Eum? Pelajaran?</VALUE>
    <VALUE Lang="id">Kalau sudah berlari-lari seperti itu, bisa dibilang kamu sudah berolahraga kan?</VALUE>
    <VALUE Lang="id">Walaupun kecewa mau apa lagi</VALUE>
    <VALUE Lang="cn">同学！请记住，持续不断的修炼，将成为您的任务内容之一；甚至能引领您前往胜利之路。 一开始可能会有些挫折，但千万不要感到难过。只要集中注意力在修行，您将会明显的感觉出自己的能量是越来越强大的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_15_0">
    <VALUE Lang="GS">.....6</VALUE>
    <VALUE Lang="id">.....6</VALUE>
    <VALUE Lang="cn">.....6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_16_0">
    <VALUE Lang="GS">Broaden your horizons! It is great to look at things from different perspectives!</VALUE>
    <VALUE Lang="GS">Imagine this is part of the lesson!</VALUE>
    <VALUE Lang="GS">Someday, this may benefit you and the people you care about.</VALUE>
    <VALUE Lang="id">Pergilah</VALUE>
    <VALUE Lang="id">Kalau berpikir bahwa ini juga adalah bagian dari pelajaran yah….</VALUE>
    <VALUE Lang="id">Baik untuk kedua belah pihak kan?</VALUE>
    <VALUE Lang="cn">去开拓您的视野吧！从各种角度来看一件事情是很好的。想象一下这是一门必修课！也许在某天，您会发现今天所学的，都将成为您和其他人的精神食粮。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_16_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_17_0">
    <VALUE Lang="GS">Oh. Ok.</VALUE>
    <VALUE Lang="GS">Well, even if he's not here, I can give you more information.</VALUE>
    <VALUE Lang="GS">After the meteor fell 18 years ago, the chairman realized the dangers posed by another world to our world. This included the threat of invasion by destructive monsters.</VALUE>
    <VALUE Lang="id">Begitu yah?</VALUE>
    <VALUE Lang="id">Saya bisa memberitahu kamu sedikit walaupun guru besar tidak ada di sini</VALUE>
    <VALUE Lang="id">Director Lee sudah mengira-ngira hubungan antara dunia ini dan dunia lain setelah kejadian hujan meteor 18 tahun yang lalu. Dia juga memprediksikan bahwa pengaruh</VALUE>
    <VALUE Lang="cn">噢…好！</VALUE>
    <VALUE Lang="cn">嗯！虽然老师不在这儿，但我还是可以给您提供些情报。</VALUE>
    <VALUE Lang="cn">在18年前出现流星雨的时后，社长就领悟到了所谓的异世界危险因子已经来到了我们的世界。 而这些危险因子正夹带着可怕怪物们的凶兆。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_17_0_1">
    <VALUE Lang="GS">Continue</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_18_0">
    <VALUE Lang="GS">It was later discovered that the meteor has made of living biological particles from another world. These transmitted power to organisms on our world. In most cases, this created monsters. In other cases, this resulted in people that became strong enough to survive the ensuing chaos: these are the people whose names are on the List of Saints.</VALUE>
    <VALUE Lang="id">Yang terlihat seperti hujan meteor itu sebenarnya adalah potongan kehidupan yang terkirim dari dunia lain dan kalian adalah media yang membawa kekuatan potongan-potongan itu</VALUE>
    <VALUE Lang="id">Yang namanya daftar saint adalah daftar nama orang-orang yang mempunyai kekuat</VALUE>
    <VALUE Lang="cn">之后才发现，流星是来自异世界的活生物粒子。 这些发射出的力量进入了我们星球的有机生物体内。这种现象在大多数的情况下，会蕴酿出怪物的诞生；抑或是使人类变得过度强大，导致生存的混乱危机发生。而这些人类的名字都已经被抄写在圣徒名单上面了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_18_0_1">
    <VALUE Lang="GS">Continue</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_19_0">
    <VALUE Lang="GS">The people at SFG thought the best way to prevent this disaster from recurring was to gather the people that were strengthened by the meteor's power.</VALUE>
    <VALUE Lang="GS">Unless this new potential was fully explored, and the power from the meteor was properly utilized, then the world would have no protection from otherworldly invaders.</VALUE>
    <VALUE Lang="GS">That is why students were especially chosen to join this campus: the end goal is to fully cultivate and develop power that will hopefully be enough to protect our world.</VALUE>
    <VALUE Lang="GS">That's what happened.</VALUE>
    <VALUE Lang="id">Mengumpulkan orang-orang yang bisa memberikan perintah ditengah-tengah bencana yang terjadi untuk pencegahan</VALUE>
    <VALUE Lang="id">Kalau hal itu tidak terjadi dunia ini mungkin saja akan berakhir</VALUE>
    <VALUE Lang="id">Kita harus memanggil mereka dengan cara apapun…</VALUE>
    <VALUE Lang="id">Hal seperti itulah.</VALUE>
    <VALUE Lang="cn">SFG的人认为预防疾病最好的方法就是收集陨石的力量，来得到被强化的人民。除非新的潜能再度被挖掘，或是陨石的能量被正常地使用，否则这个世界将会被超现实世界的侵略者给破坏。</VALUE>
    <VALUE Lang="cn">这就是为什么学生们选择要加入这个校园的原因。他们的最终目标就是充分地培育，以及发展动力，进而可以充分地保护这个世界。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_19_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_2_0">
    <VALUE Lang="GS">Oh! You really want to learn, huh?</VALUE>
    <VALUE Lang="GS">There's nothing more worthwhile than teaching you students!</VALUE>
    <VALUE Lang="GS">The manager's not around, so I can teach you some lessons myself. Is that fine with you?</VALUE>
    <VALUE Lang="id">Kok pelajaran…</VALUE>
    <VALUE Lang="id">Enggak ada yang mau aku ajarkan juga sih</VALUE>
    <VALUE Lang="id">Bisa gawat apalagi pada saat Kepala kantor tidak berada di sini</VALUE>
    <VALUE Lang="id">Kalau memang itu masalahnya aku bisa membantu sedikit…</VALUE>
    <VALUE Lang="cn">噢！您真的愿意学习吗？</VALUE>
    <VALUE Lang="cn">没有什么事情是比教学生还要有意义的事情了！</VALUE>
    <VALUE Lang="cn">馆长现在不在位置上，所以我想先教您些东西。您愿意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_2_0_1">
    <VALUE Lang="GS">Agree to Attend Class</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">答应参与课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_2_0_6">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_20_0">
    <VALUE Lang="GS">Do you know there is a private prison at the Sacred Financial Group?</VALUE>
    <VALUE Lang="GS">There are special minerals that only come from the mine near that prison. It used to be a working area for prisoners.</VALUE>
    <VALUE Lang="GS">A well-refined mixture of that mineral can enhance steel... Especially weapons and armor with special power...</VALUE>
    <VALUE Lang="GS">The success rate is too low, however, and it requires a large amount of oil.</VALUE>
    <VALUE Lang="GS">Are you still willing to try it?</VALUE>
    <VALUE Lang="id">Apakah kamu tahu ada Penjara Rahasia di Sacred Financial Group?</VALUE>
    <VALUE Lang="id">Terdapat mineral khusus yang hanya muncul di dekat penjara tersebut sehingga para tahanan harus membantu mengeluarkannya.</VALUE>
    <VALUE Lang="id">Mineral tersebut dapat membuat item yang sangat kuatl... Teruta</VALUE>
    <VALUE Lang="cn">您知道在Sacred Financial Group有一间私人监狱吗？那边监狱附近的井底蕴有非常特别的矿石唷！对囚犯来说，那口井是生命之泉。</VALUE>
    <VALUE Lang="cn">这矿石的精练合成物，可以拿来提炼钢铁。特别是这边制作的武器和防具都内含特殊力量。不过，成功的机率非常低。而且，要拥有它们，首先您得尊卑大量的油才行。即使如此，您还是愿意挑战吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_21_0">
    <VALUE Lang="GS">The easiest way to get oil is from the tuna near this area. You could easily find tuna boat workers at the wharf.</VALUE>
    <VALUE Lang="GS">Make sure to check the quality of your tuna oil. Some of it is pretty useless.</VALUE>
    <VALUE Lang="GS">Please get 10 bottles of oil.</VALUE>
    <VALUE Lang="id">Cara termudah mendapatkan minyaknya adalah dari tuna di sekitar area sini. Kamu bisa menemukan mereka di seluruh map ini.</VALUE>
    <VALUE Lang="id">Bawakan saya 10 botol Oil nya.</VALUE>
    <VALUE Lang="cn">最简单的方法就是从附近的鲔鱼大哥那儿取出油源，在Wharf您可以轻易找到鲔鱼线船只的工作人员。请确认好您的鲔鱼油质是否安全，因为有些部分的油源是劣等的油！现在，请您去收集10瓶油唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_22_0">
    <VALUE Lang="GS">Well done.</VALUE>
    <VALUE Lang="GS">I will put that oil in this machine.</VALUE>
    <VALUE Lang="GS">I can't guarantee that it'll create something that will help you...</VALUE>
    <VALUE Lang="GS">Anyway, good luck.</VALUE>
    <VALUE Lang="id">Bagus.</VALUE>
    <VALUE Lang="id">Saya akan meletakkan minyaknya di sini.</VALUE>
    <VALUE Lang="id">Saya tidak bisa menjanjikan jika pasti berhasil tapi saya akan mencoba...</VALUE>
    <VALUE Lang="cn">做得好！</VALUE>
    <VALUE Lang="cn">我会把油加进机器里的。</VALUE>
    <VALUE Lang="cn">但我无法保证结果一定是美好的。</VALUE>
    <VALUE Lang="cn">总之！祝您好运。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_23_0">
    <VALUE Lang="GS">Oh, you received the information that I requested, didn't you? I was so worried about my boss because I couldn't contact him for a long time. I also wasn't able to get any intel around here, so I really appreciate that you were able to deliver this information.</VALUE>
    <VALUE Lang="GS">Now I can relax just a little bit.</VALUE>
    <VALUE Lang="GS">Thank you very much.</VALUE>
    <VALUE Lang="id">Ah, kamu sudah mendengar apa yang saya minta rupanya.</VALUE>
    <VALUE Lang="id">Kami benar-benar kesal karena tidak bisa mengumpulkan informasi tentang daerah sekitar, dan kami juga tidak tahu dimana keberadaan gurgu besar</VALUE>
    <VALUE Lang="id">Saya jadi merasa sedikit tenang karena kamu sudah me</VALUE>
    <VALUE Lang="cn">您已经收到我提出的请求了，对吧？我很担心我的老板，他失联很久了。同时我也无法取得周遭的现况情报，所以很感激您如此的分享资讯给我。现在我的感觉好多了。非常感谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_23_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_24_0">
    <VALUE Lang="GS">Wait... I just remembered something.</VALUE>
    <VALUE Lang="GS">A few days ago, I got another time capsule delivery from another student...</VALUE>
    <VALUE Lang="GS">There were pictures of the Gangsters trading inside the capsule.</VALUE>
    <VALUE Lang="GS">What's weird is that the SFG Flag is on a ship that probably contains the gangsters' trading goods.</VALUE>
    <VALUE Lang="GS">I don't know if this is some weird mistake.</VALUE>
    <VALUE Lang="GS">Well, I hope this information is worth the reward for your delivery.</VALUE>
    <VALUE Lang="id">Ah, hampir saja saya lupa</VALUE>
    <VALUE Lang="id">Dulu saya pernah mendapatkan Time Capsule lain dari pelajar yang lain, isinya….</VALUE>
    <VALUE Lang="id">Sungguh tidak masuk akal karena itu ternyata adalah photo dari anggota komplotan bira yang sedang melakukan transaksi</VALUE>
    <VALUE Lang="id">Ini….</VALUE>
    <VALUE Lang="id">Kamu bisa l</VALUE>
    <VALUE Lang="cn">等等… 我好像想起一些事情了。前几天，我从一个学生身上，拿到了一颗时光胶囊 。胶囊里面画有黑帮们的货物交易图样。奇怪的是SFG 的旗帜在船上，那边非常有可能载有黑帮的货物。</VALUE>
    <VALUE Lang="cn">我不清楚这是否是场误会，但，我希望这情报可以带给您与奖励等值的报酬。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_24_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_25_0">
    <VALUE Lang="GS">Excuse me. I don't know everything, and I'm staying here instead of my teacher, but...</VALUE>
    <VALUE Lang="GS">I've got a story to tell you.</VALUE>
    <VALUE Lang="GS">People used to regularly hold this festival. And then...</VALUE>
    <VALUE Lang="GS">Some time ago, after one of these festivals, there was some kind of problem...</VALUE>
    <VALUE Lang="id">Dengan terpaksa saya mau meminta bantuan</VALUE>
    <VALUE Lang="id">Saya tidak tahu banyak karena setelah guru besar menghilang saya terus berjaga di tempat ini.</VALUE>
    <VALUE Lang="id">Setelah mendengar apa yang kalian katakan ada beberapa hal yang mengganggu saya</VALUE>
    <VALUE Lang="id">Dulu ada acara penguburan Time</VALUE>
    <VALUE Lang="cn">不好意思，我其实什么都不知道。我是代替我的老师在这边待命的。我告诉您一个小故事。人们曾经定期举办这种大会活动。但现在…….在不久之前，一场活动中，发生了一些问题…。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_3_0">
    <VALUE Lang="GS">There is nothing special about this device!</VALUE>
    <VALUE Lang="GS">You should find the GPS first, and then an input device.</VALUE>
    <VALUE Lang="id">Bukan sesuatu yang begitu luar biasa…</VALUE>
    <VALUE Lang="id">Kamu cari dulu GPSnya lalu temukan item yang dikubur di tempat yang ditunjukkan oleh GPS</VALUE>
    <VALUE Lang="cn">这装置没有什么了不起的。您应该先找出GPS ，然后才是设备的输入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_3_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_4_0">
    <VALUE Lang="GS">Would you like to have some lessons?</VALUE>
    <VALUE Lang="GS">There's nothing more worthwhile than teaching you students!</VALUE>
    <VALUE Lang="GS">The manager's not around, so I can teach you some lessons myself.</VALUE>
    <VALUE Lang="GS">Is that fine with you?</VALUE>
    <VALUE Lang="id">Heum…pelajaran yah…</VALUE>
    <VALUE Lang="id">Enggak ada yang mau aku ajarkan juga sih</VALUE>
    <VALUE Lang="id">Bisa gawat apalagi pada saat Kepala kantor tidak berada di sini…</VALUE>
    <VALUE Lang="id">Kalau memang itu mau aku bisa membantu sedikit…</VALUE>
    <VALUE Lang="cn">您想要听更多的课程吗？</VALUE>
    <VALUE Lang="cn">没有什么事情是比教学生还要有意义的事情了！</VALUE>
    <VALUE Lang="cn">馆长现在不在位置上，所以我想先教您些东西。您愿意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_4_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_5_0">
    <VALUE Lang="GS">If you don't know the importance of physical strength, then it will be very difficult for you to understand future lessons.</VALUE>
    <VALUE Lang="GS">By the way, I need to ask you to do something.</VALUE>
    <VALUE Lang="id">Kelas akan menjadi sangat sulit kalau kamu tidak tahu tentang pentingnya stamina yang paling dasar</VALUE>
    <VALUE Lang="id">Ngomong-ngomong...saya mau minta bantuan sesuatu….</VALUE>
    <VALUE Lang="cn">如果您不懂Physical strength的重要性，那么未来的课程对您而言，将会是会非常困难的。顺道一提，我需要请您帮个忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_5_0_1">
    <VALUE Lang="GS">Accept Instruction</VALUE>
    <VALUE Lang="id">Menerima petunjuk</VALUE>
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_5_0_4">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_6_0">
    <VALUE Lang="GS">Did you see the Police Station nearby?</VALUE>
    <VALUE Lang="GS">There is a police officer waiting for you at the Main Door.</VALUE>
    <VALUE Lang="GS">Just approach him and tell him that I instructed you to look for him. I believe he'll have something for you.</VALUE>
    <VALUE Lang="id">Sudah lihat polisi yang ada di sekitar sini kan?</VALUE>
    <VALUE Lang="id">Akan ada seorang polisi yang menunggu di depan pintu masuk</VALUE>
    <VALUE Lang="id">Kalau kamu pergi ke sana dan bilang bahwa saya mengirim kamu, dia pasti akan memintamu melakukan sesuatu</VALUE>
    <VALUE Lang="cn">有看到附近的Police Station吗？</VALUE>
    <VALUE Lang="cn">Main Door有一位Police officer在等您。去拜访他，并告诉他是我介绍您来的。我相信他会给您点什么东西的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_6_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_7_0">
    <VALUE Lang="GS">....3</VALUE>
    <VALUE Lang="id">....3</VALUE>
    <VALUE Lang="cn">....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_8_0">
    <VALUE Lang="GS">This is a stolen GPS! It's great that you found it.</VALUE>
    <VALUE Lang="GS">Ah! I was just talking to myself.</VALUE>
    <VALUE Lang="GS">Alright, you may go. I'm sorry for acting so strangely.</VALUE>
    <VALUE Lang="id">….Memang sih ini GPS yang dulu dicuri, pada kesempatan ini harus kita temukan nih</VALUE>
    <VALUE Lang="id">Euhm? Ah, aku ngomong sendiri jangan dipedulikan</VALUE>
    <VALUE Lang="id">Nah, cepat</VALUE>
    <VALUE Lang="cn">这是被偷走的GPS！ 我很高兴您找到它了！噢！我只是在自言自语。您可以走了！我为我奇怪的言行深感歉意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_archer1.ntk_9_0">
    <VALUE Lang="GS">.....4</VALUE>
    <VALUE Lang="id">.....4</VALUE>
    <VALUE Lang="cn">.....4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_0">
    <VALUE Lang="GS">Welcome to the Trading Hole Area!</VALUE>
    <VALUE Lang="GS">I am the Brawler Section Agent. How can I help you?</VALUE>
    <VALUE Lang="GS">Please feel free to look around if you like.</VALUE>
    <VALUE Lang="id">Selamat datang di Trading Hole!</VALUE>
    <VALUE Lang="id">Saya dari Brawler Section Agen.</VALUE>
    <VALUE Lang="id">Ada yang bisa saya bantu?</VALUE>
    <VALUE Lang="cn">欢迎来到 Trading Hole Area。</VALUE>
    <VALUE Lang="cn">我是格斗部的学生。</VALUE>
    <VALUE Lang="cn">需要帮忙吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1">
    <VALUE Lang="GS">I'm sorry the Manager isn't here right now.</VALUE>
    <VALUE Lang="GS">Please come back again later.</VALUE>
    <VALUE Lang="id">Sekarang Kepala kantor sedang tidak ada di tempat</VALUE>
    <VALUE Lang="id">Silahkan datang lagi kalau kamu sudah menemukan Kepala kantor nanti</VALUE>
    <VALUE Lang="cn">抱歉现在负责人不在位置上。</VALUE>
    <VALUE Lang="cn">请稍候再来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_1">
    <VALUE Lang="GS">Request to Attend Class</VALUE>
    <VALUE Lang="id">Meminta latihan</VALUE>
    <VALUE Lang="cn">申请课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_10">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒之表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_11">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒之表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_14">
    <VALUE Lang="GS">Deliver the Time Capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">传递时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_15">
    <VALUE Lang="GS">Gather Info before the Incident</VALUE>
    <VALUE Lang="id">mengumpulkan info sebelum kecelakaan terjadi</VALUE>
    <VALUE Lang="cn">收集事故前的情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_4">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Mengikuti latihan</VALUE>
    <VALUE Lang="cn">参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_5">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Mengikuti latihan</VALUE>
    <VALUE Lang="cn">参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_6">
    <VALUE Lang="GS">Give the Time Capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">交付时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_7">
    <VALUE Lang="GS">Accept Instructions</VALUE>
    <VALUE Lang="id">Menerima petunjuk</VALUE>
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_8">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_1_1_9">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒之表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_10_0">
    <VALUE Lang="GS">There is nothing special about this device!</VALUE>
    <VALUE Lang="GS">You should find the GPS first, and then an input device.</VALUE>
    <VALUE Lang="id">Bukan sesuatu yang begitu luar biasa…</VALUE>
    <VALUE Lang="id">Kamu cari dulu GPSnya lalu temukan item yang dikubur di tempat yang ditunjukkan oleh GPS</VALUE>
    <VALUE Lang="id">.</VALUE>
    <VALUE Lang="cn">这装置没有什么了不起的。您应该先找出GPS ，然后才是设备的输入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_11_0">
    <VALUE Lang="GS">This is a stolen GPS! It's great that you found it.</VALUE>
    <VALUE Lang="GS">Ah! I was just talking to myself.</VALUE>
    <VALUE Lang="GS">Alright, you may go. I'm sorry for acting so strangely.</VALUE>
    <VALUE Lang="id">….Memang sih ini GPS yang dulu dicuri, pada kesempatan ini harus kita temukan nih</VALUE>
    <VALUE Lang="id">Euhm? Ah, aku ngomong sendiri jangan dipedulikan</VALUE>
    <VALUE Lang="id">Nah, pergilah</VALUE>
    <VALUE Lang="cn">这是被偷走的GPS！ 我很高兴您找到它了！噢！我只是在自言自语。您可以走了！我为我奇怪的言行深感歉意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_12_0">
    <VALUE Lang="GS">.......5</VALUE>
    <VALUE Lang="id">.....5</VALUE>
    <VALUE Lang="cn">.......5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_13_0">
    <VALUE Lang="GS">Oh! You found it!</VALUE>
    <VALUE Lang="GS">It's been 18 years since I last saw this device by a specialist named Liu Cheng You.</VALUE>
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="id">Untung sekali akhirnya kamu menemukannya</VALUE>
    <VALUE Lang="id">Dikubur sehari setelah kejadian hujan meteor itu terjadi</VALUE>
    <VALUE Lang="id">Terimakasih kamu sudah menemukannya dengan baik…</VALUE>
    <VALUE Lang="cn">噢！您找到它了！我透过专家Liu Cheng You最后看到这个装置已经是18年前的事情了！</VALUE>
    <VALUE Lang="cn">非常感谢您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_14_0">
    <VALUE Lang="GS">Student! Please remember that consistent training will be part of your quest for victory. There will be times of disappointment ahead but you need not be sad. Just focus on your training and you'll definitely become a more powerful individual.</VALUE>
    <VALUE Lang="id">Eum? Pelajaran?</VALUE>
    <VALUE Lang="id">Kalau sudah berlari-lari seperti itu, bisa dibilang kamu sudah berolahraga kan?</VALUE>
    <VALUE Lang="id">Walaupun kecewa mau apa lagi</VALUE>
    <VALUE Lang="cn">同学！请记住，持续不断的修炼，将成为您的任务内容之一；甚至能引领您前往胜利之路。 一开始可能会有些挫折，但千万不要感到难过。只要集中注意力在修行，您将会明显的感觉出自己的能量是越来越强大的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_15_0">
    <VALUE Lang="GS">.....6</VALUE>
    <VALUE Lang="id">....6</VALUE>
    <VALUE Lang="cn">.....6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_16_0">
    <VALUE Lang="GS">Broaden your horizons! It is great to look at things from different perspectives!</VALUE>
    <VALUE Lang="GS">Imagine this is part of the lesson!</VALUE>
    <VALUE Lang="GS">Someday, this may benefit you and the people you care about.</VALUE>
    <VALUE Lang="id">Pergilah</VALUE>
    <VALUE Lang="id">Kalau berpikir bahwa ini juga adalah bagian dari pelajaran yah….</VALUE>
    <VALUE Lang="id">Baik untuk kedua belah pihak kan?</VALUE>
    <VALUE Lang="cn">去开拓您的视野吧！从各种角度来看一件事情是很好的。想象一下这是一门必修课！也许在某天，您会发现今天所学的，都将成为您和其他人的精神食粮。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_16_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_17_0">
    <VALUE Lang="GS">Oh. Ok.</VALUE>
    <VALUE Lang="GS">Well, even if he's not here, I can give you more information.</VALUE>
    <VALUE Lang="GS">After the meteor fell 18 years ago, the chairman realized the dangers posed by another world to our world. This included the threat of horrendous monsters.</VALUE>
    <VALUE Lang="id">Begitu yah?</VALUE>
    <VALUE Lang="id">Saya bisa memberitahu kamu sedikit walaupun guru besar tidak ada di sini</VALUE>
    <VALUE Lang="id">Director Lee sudah mengira-ngira hubungan antara dunia ini dan dunia lain setelah kejadian hujan meteor 18 tahun yang lalu. Dia juga memprediksikan bahwa pengaruh</VALUE>
    <VALUE Lang="cn">噢…好！</VALUE>
    <VALUE Lang="cn">嗯！虽然老师不在这儿，但我还是可以给您提供些情报。</VALUE>
    <VALUE Lang="cn">在18年前出现流星雨的时后，社长就领悟到了所谓的异世界危险因子已经来到了我们的世界。 而这些危险因子正夹带着可怕怪物们的凶兆。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_17_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_18_0">
    <VALUE Lang="GS">It was later discovered that the meteor has made of living biological particles from another world. These transmitted power to organisms on our world. In most cases, this created monsters. In other cases, this resulted in people that became strong enough to survive the ensuing chaos: these are the people whose names are on the List of Saints.</VALUE>
    <VALUE Lang="id">Yang terlihat seperti hujan meteor itu sebenarnya adalah potongan kehidupan yang terkirim dari dunia lain dan kalian adalah media yang membawa kekuatan potongan-potongan itu</VALUE>
    <VALUE Lang="id">Yang namanya daftar saint adalah daftar nama orang-orang yang mempunyai kekuat</VALUE>
    <VALUE Lang="cn">之后才发现，流星是来自异世界的活生物粒子。 这些发射出的力量进入了我们星球的有机生物体内。这种现象在大多数的情况下，会蕴酿出怪物的诞生；抑或是使人类变得过度强大，导致生存的混乱危机发生。而这些人类的名字都已经被抄写在圣徒名单上面了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_18_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_19_0">
    <VALUE Lang="GS">The people at SFG thought the best way to prevent this disaster from recurring was to gather the people that were strengthened by the meteor's power.</VALUE>
    <VALUE Lang="GS">Unless this new potential was fully explored, and the power from the meteor was properly utilized, then the world would have no protection from otherworldly invaders.</VALUE>
    <VALUE Lang="GS">That is why students were especially chosen to join this campus: the end goal is to fully cultivate and develop power that will hopefully be enough to protect our world.</VALUE>
    <VALUE Lang="GS">That's what happened.</VALUE>
    <VALUE Lang="id">Mengumpulkan orang-orang yang bisa memberikan perintah ditengah-tengah bencana yang terjadi untuk pencegahan</VALUE>
    <VALUE Lang="id">Kalau hal itu tidak terjadi dunia ini mungkin saja akan berakhir</VALUE>
    <VALUE Lang="id">Kita harus memanggil mereka dengan cara apapun…</VALUE>
    <VALUE Lang="id">Hal seperti itulah.</VALUE>
    <VALUE Lang="cn">SFG的人认为预防疾病最好的方法就是收集陨石的力量，来得到被强化的人民。除非新的潜能再度被挖掘，或是陨石的能量被正常地使用，否则这个世界将会被超现实世界的侵略者给破坏。</VALUE>
    <VALUE Lang="cn">这就是为什么学生们选择要加入这个校园的原因。他们的最终目标就是充分地培育，以及发展动力，进而可以充分地保护这个世界。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_19_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_2_0">
    <VALUE Lang="GS">Oh! You really want to learn, huh?</VALUE>
    <VALUE Lang="GS">There's nothing more worthwhile than teaching you students!</VALUE>
    <VALUE Lang="GS">The manager's not around, so I can teach you some lessons myself. Is that fine with you?</VALUE>
    <VALUE Lang="id">Heum…pelajaran yah…</VALUE>
    <VALUE Lang="id">Enggak ada yang mau aku ajarkan juga sih</VALUE>
    <VALUE Lang="id">Bisa gawat apalagi pada saat Kepala kantor tidak berada di sini</VALUE>
    <VALUE Lang="id">Kalau memang itu mau aku bisa memberikan sedikit bantuan</VALUE>
    <VALUE Lang="cn">噢！您真的愿意学习吗？</VALUE>
    <VALUE Lang="cn">没有什么事情是比教学生还要有意义的事情了！</VALUE>
    <VALUE Lang="cn">馆长现在不在位置上，所以我想先教您些东西。您愿意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_2_0_1">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">没有什么事情是比教学生还要有意义的事情了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_2_0_6">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">馆长现在不在位置上，所以我想先教您些东西。您愿意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_20_0">
    <VALUE Lang="GS">Do you know there is a private prison at the Sacred Financial Group?</VALUE>
    <VALUE Lang="GS">There are special minerals that only come from the mine near that prison. It used to be a working area for prisoners.</VALUE>
    <VALUE Lang="GS">A well-refined mixture of that mineral can enhance steel... Especially weapons and armor with special power...</VALUE>
    <VALUE Lang="GS">The success rate is too low, however, and it requires a large amount of oil.</VALUE>
    <VALUE Lang="GS">Are you still willing to try it?</VALUE>
    <VALUE Lang="id">Apakah kamu tahu ada Penjara Rahasia di Sacred Financial Group?</VALUE>
    <VALUE Lang="id">Terdapat mineral khusus yang hanya muncul di dekat penjara tersebut sehingga para tahanan harus membantu mengeluarkannya.</VALUE>
    <VALUE Lang="id">Mineral tersebut dapat membuat item yang sangat kuatl... Teruta</VALUE>
    <VALUE Lang="cn">您知道在Sacred Financial Group有一间私人监狱吗？那边监狱附近的井底蕴有非常特别的矿石唷！对囚犯来说，那口井是生命之泉。</VALUE>
    <VALUE Lang="cn">这矿石的精练合成物，可以拿来提炼钢铁。特别是这边制作的武器和防具都内含特殊力量。不过，成功的机率非常低。而且，要拥有它们，首先您得尊卑大量的油才行。即使如此，您还是愿意挑战吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_21_0">
    <VALUE Lang="GS">The easiest way to get oil is from the tuna near this area. You could easily find tuna boat workers at the wharf.</VALUE>
    <VALUE Lang="GS">Make sure to check the quality of your tuna oil. Some of it is pretty useless.</VALUE>
    <VALUE Lang="GS">Please get 10 bottles of oil.</VALUE>
    <VALUE Lang="id">Cara termudah mendapatkan minyaknya adalah dari tuna di sekitar area sini. Kamu bisa menemukan mereka di seluruh map ini.</VALUE>
    <VALUE Lang="id">Bawakan saya 10 botol Oil nya.</VALUE>
    <VALUE Lang="cn">最简单的方法就是从附近的鲔鱼大哥那儿取出油源，在Wharf您可以轻易找到鲔鱼线船只的工作人员。请确认好您的鲔鱼油质是否安全，因为有些部分的油源是劣等的油！现在，请您去收集10瓶油唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_22_0">
    <VALUE Lang="GS">Well done.</VALUE>
    <VALUE Lang="GS">I will put that oil in this machine.</VALUE>
    <VALUE Lang="GS">I can't guarantee that it'll create something that will help you...</VALUE>
    <VALUE Lang="GS">Anyway, good luck.</VALUE>
    <VALUE Lang="id">Bagus.</VALUE>
    <VALUE Lang="id">Saya akan meletakkan minyaknya di sini.</VALUE>
    <VALUE Lang="id">Saya tidak bisa menjanjikan jika pasti berhasil tapi saya akan mencoba...</VALUE>
    <VALUE Lang="cn">做得好！</VALUE>
    <VALUE Lang="cn">我会把油加进机器里的。</VALUE>
    <VALUE Lang="cn">但我无法保证结果一定是美好的。</VALUE>
    <VALUE Lang="cn">总之！祝您好运。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_23_0">
    <VALUE Lang="GS">Oh, you received the information that I requested, didn't you? I was so worried about my boss because I couldn't contact him for a long time. I also wasn't able to get any intel around here, so I really appreciate that you were able to deliver this information.</VALUE>
    <VALUE Lang="GS">Now I can relax just a little bit.</VALUE>
    <VALUE Lang="GS">Thank you very much.</VALUE>
    <VALUE Lang="id">Ah, kamu sudah mendengar apa yang saya minta rupanya.</VALUE>
    <VALUE Lang="id">Kami benar-benar kesal karena tidak bisa mengumpulkan informasi tentang daerah sekitar, dan kami juga tidak tahu dimana keberadaan gurgu besar</VALUE>
    <VALUE Lang="id">Saya jadi merasa sedikit tenang karena kamu sudah me</VALUE>
    <VALUE Lang="cn">啊，收到我要求的内容吧。</VALUE>
    <VALUE Lang="cn">师傅一直行踪不明，所以得不到周围的资讯非常郁闷。</VALUE>
    <VALUE Lang="cn">这样找来了资料，减轻了我不少烦躁。谢谢！ "</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_23_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_24_0">
    <VALUE Lang="GS">Wait... I just remembered something.</VALUE>
    <VALUE Lang="GS">A few days ago, I got another time capsule delivery from another student...</VALUE>
    <VALUE Lang="GS">There were pictures of the Gangsters trading inside the capsule.</VALUE>
    <VALUE Lang="GS">What's weird is that the SFG Flag is on a ship that probably contains the gangsters' trading goods.</VALUE>
    <VALUE Lang="GS">I don't know if this is some weird mistake.</VALUE>
    <VALUE Lang="GS">Well, I hope this information is worth the reward for your delivery.</VALUE>
    <VALUE Lang="id">Ah, hampir saja saya lupa</VALUE>
    <VALUE Lang="id">Dulu saya pernah mendapatkan Time Capsule lain dari pelajar yang lain, isinya….</VALUE>
    <VALUE Lang="id">Sungguh tidak masuk akal karena itu ternyata adalah photo dari anggota komplotan bira yang sedang melakukan transaksi</VALUE>
    <VALUE Lang="id">Ini….</VALUE>
    <VALUE Lang="id">Kamu bisa l</VALUE>
    <VALUE Lang="cn">啊"啊，受到我要求的内容吧。</VALUE>
    <VALUE Lang="cn">师傅一直行踪不明，所以得不到周围的资讯非常郁闷。</VALUE>
    <VALUE Lang="cn">这样找来了资料，减轻了我不少烦躁。谢谢！ "</VALUE>
    <VALUE Lang="cn">"啊，差点忘了。</VALUE>
    <VALUE Lang="cn">以前从其他学生那里收到了另外时间小盒， 内容…</VALUE>
    <VALUE Lang="cn">可是好笑的是暴力团在码头进行交易的照片。</VALUE>
    <VALUE Lang="cn">这里…</VALUE>
    <VALUE Lang="cn">为了交易停泊的货物船上面有财团的旗。</VALUE>
    <VALUE Lang="cn">为了伪装故意弄的，或因为失误留下的…</VALUE>
    <VALUE Lang="cn">这个可能是你功劳的报酬</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_24_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_25_0">
    <VALUE Lang="GS">Excuse me. I don't know everything, and I'm staying here instead of my teacher, but...</VALUE>
    <VALUE Lang="GS">I've got a story to tell you.</VALUE>
    <VALUE Lang="GS">People used to regularly hold this festival. And then...</VALUE>
    <VALUE Lang="GS">Some time ago, after one of these festivals, there was some kind of problem...</VALUE>
    <VALUE Lang="id">Dengan terpaksa saya mau meminta bantuan</VALUE>
    <VALUE Lang="id">Saya tidak tahu banyak karena setelah guru besar menghilang saya terus berjaga di tempat ini.</VALUE>
    <VALUE Lang="id">Setelah mendengar apa yang kalian katakan ada beberapa hal yang mengganggu saya</VALUE>
    <VALUE Lang="id">Dulu ada acara penguburan Time</VALUE>
    <VALUE Lang="cn">不好意思，我其实什么都不知道。我是代替我的老师在这边待命的。我告诉您一个小故事。人们曾经定期举办这种大会活动。但现在…….在不久之前，一场活动中，发生了一些问题…。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_3_0">
    <VALUE Lang="GS">There is nothing special about this device!</VALUE>
    <VALUE Lang="GS">You should find the GPS first, and then an input device.</VALUE>
    <VALUE Lang="id">Bukan sesuatu yang begitu luar biasa…</VALUE>
    <VALUE Lang="id">Kamu cari dulu GPSnya lalu temukan item yang dikubur di tempat yang ditunjukkan oleh GPS</VALUE>
    <VALUE Lang="cn">这装置没有什么了不起的。您应该先找出GPS ，然后才是设备的输入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_3_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_4_0">
    <VALUE Lang="GS">Would you like to have some lessons?</VALUE>
    <VALUE Lang="GS">There's nothing more worthwhile than teaching you students!</VALUE>
    <VALUE Lang="GS">The manager's not around, so I can teach you some lessons myself.</VALUE>
    <VALUE Lang="GS">Is that fine with you?</VALUE>
    <VALUE Lang="id">Heum…pelajaran yah…</VALUE>
    <VALUE Lang="id">Enggak ada yang mau aku ajarkan juga sih</VALUE>
    <VALUE Lang="id">Bisa gawat apalagi pada saat Kepala kantor tidak berada di sini</VALUE>
    <VALUE Lang="id">Kalau memang itu mau aku bisa memberikan sedikit bantuan</VALUE>
    <VALUE Lang="cn">您想要听更多的课程吗？</VALUE>
    <VALUE Lang="cn">没有什么事情是比教学生还要有意义的事情了！</VALUE>
    <VALUE Lang="cn">馆长现在不在位置上，所以我想先教您些东西。您愿意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_4_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_5_0">
    <VALUE Lang="GS">If you don't know the importance of physical strength, then it will be very difficult for you to understand future lessons.</VALUE>
    <VALUE Lang="GS">By the way, I need to ask you to do something.</VALUE>
    <VALUE Lang="id">Kelas akan menjadi sangat sulit kalau kamu tidak tahu tentang pentingnya stamina yang paling dasar</VALUE>
    <VALUE Lang="id">Ngomong-ngomong...saya mau minta bantuan sesuatu….</VALUE>
    <VALUE Lang="cn">如果您不懂Physical strength的重要性，那么未来的课程对您而言，将会是会非常困难的。顺道一提，我需要请您帮个忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_5_0_1">
    <VALUE Lang="GS">Accept Instruction</VALUE>
    <VALUE Lang="id">Menerima petunjuk</VALUE>
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_5_0_4">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_6_0">
    <VALUE Lang="GS">Did you see the Police Station nearby?</VALUE>
    <VALUE Lang="GS">There is a police officer waiting for you at the Main Door.</VALUE>
    <VALUE Lang="GS">Just approach him and tell him that I instructed you to look for him. I believe he'll have something for you.</VALUE>
    <VALUE Lang="id">Sudah lihat polisi yang ada di sekitar sini kan?</VALUE>
    <VALUE Lang="id">Akan ada seorang polisi yang menunggu di depan pintu masuk</VALUE>
    <VALUE Lang="id">Kalau kamu pergi ke sana dan bilang bahwa saya mengirim kamu, dia pasti akan memintamu melakukan sesuatu</VALUE>
    <VALUE Lang="cn">有看到附近的Police Station吗？</VALUE>
    <VALUE Lang="cn">Main Door有一位Police officer在等您。去拜访他，并告诉他是我介绍您来的。我相信他会给您点什么东西的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_6_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_7_0">
    <VALUE Lang="GS">....3</VALUE>
    <VALUE Lang="id">......3</VALUE>
    <VALUE Lang="cn">....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_8_0">
    <VALUE Lang="GS">This is a stolen GPS! It's great that you found it.</VALUE>
    <VALUE Lang="GS">Ah, I was just talking to myself.</VALUE>
    <VALUE Lang="GS">You're free to go. I'm so for acting so weirdly.</VALUE>
    <VALUE Lang="id">….Memang sih ini GPS yang dulu dicuri, pada kesempatan ini harus kita temukan nih</VALUE>
    <VALUE Lang="id">Euhm? Ah, aku ngomong sendiri jangan dipedulikan</VALUE>
    <VALUE Lang="id">Nah, pergilah</VALUE>
    <VALUE Lang="cn">这是被偷走的GPS！ 我很高兴您找到它了！噢！我只是在自言自语。您可以走了！我为我奇怪的言行深感歉意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_fighter1.ntk_9_0">
    <VALUE Lang="GS">.....4</VALUE>
    <VALUE Lang="id">......4</VALUE>
    <VALUE Lang="cn">.....4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_0">
    <VALUE Lang="GS">Welcome to the Trading Hole Area!</VALUE>
    <VALUE Lang="GS">I am the Sword Section Agent. How can I help you?</VALUE>
    <VALUE Lang="GS">Please feel free to look around if you like.</VALUE>
    <VALUE Lang="id">Disini adalah Swordsman club, ada perlu apa?</VALUE>
    <VALUE Lang="cn">欢迎来到Trading Hole Area！</VALUE>
    <VALUE Lang="cn">我是剑道部的助手。请问有什么需要的吗？</VALUE>
    <VALUE Lang="cn">请自由参观，不用客气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_0_2">
    <VALUE Lang="GS">Ask if he has seen suspicious travelers</VALUE>
    <VALUE Lang="id">Bertanya apakah ada musafir yang mencurigakan</VALUE>
    <VALUE Lang="cn">问他是否有看到可疑的旅客。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1">
    <VALUE Lang="GS">I'm sorry the Manager isn't here right now.</VALUE>
    <VALUE Lang="GS">Please come back again later.</VALUE>
    <VALUE Lang="id">Sekarang Kepala kantor sedang tidak ada di tempat</VALUE>
    <VALUE Lang="id">Silahkan datang lagi kalau kamu sudah menemukan Kepala kantor nanti</VALUE>
    <VALUE Lang="cn">抱歉现在负责人不在位置上。</VALUE>
    <VALUE Lang="cn">请稍候再来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_1">
    <VALUE Lang="GS">Request to Attend Class</VALUE>
    <VALUE Lang="id">Meminta latihan</VALUE>
    <VALUE Lang="cn">申请课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_10">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_11">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_14">
    <VALUE Lang="GS">Deliver the Time Capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">交付时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_15">
    <VALUE Lang="GS">Gather Info before the Incident</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">请搜集事故发生前的情报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_16">
    <VALUE Lang="GS">Ask if he has seen suspicious travelers</VALUE>
    <VALUE Lang="id">Bertanya apakah ada musafir yang mencurigakan</VALUE>
    <VALUE Lang="cn">问他是否有看到可疑的旅客。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_4">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Mengikuti latihan</VALUE>
    <VALUE Lang="cn">参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_5">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Mengikuti latihan</VALUE>
    <VALUE Lang="cn">参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_6">
    <VALUE Lang="GS">Give the Time Capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">交付时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_7">
    <VALUE Lang="GS">Accept Instructions</VALUE>
    <VALUE Lang="id">Menerima petunjuk</VALUE>
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_8">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_1_1_9">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_10_0">
    <VALUE Lang="GS">There is nothing special about this device!</VALUE>
    <VALUE Lang="GS">You should find the GPS first, and then an input device.</VALUE>
    <VALUE Lang="id">Bukan sesuatu yang begitu luar biasa…</VALUE>
    <VALUE Lang="id">Kamu cari dulu GPSnya lalu temukan item yang dikubur di tempat yang ditunjukkan oleh GPS</VALUE>
    <VALUE Lang="cn">这装置没有什么了不起的。您应该先找出GPS ，然后才是设备的输入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_11_0">
    <VALUE Lang="GS">This is a stolen GPS! It's great that you found it.</VALUE>
    <VALUE Lang="GS">Ah! I was just talking to myself.</VALUE>
    <VALUE Lang="GS">Alright, you may go. I'm sorry for acting so strangely.</VALUE>
    <VALUE Lang="id">….Memang sih ini GPS yang dulu dicuri, pada kesempatan ini harus kita temukan nih</VALUE>
    <VALUE Lang="id">Euhm? Ah, aku ngomong sendiri jangan dipedulikan</VALUE>
    <VALUE Lang="id">Nah, pergilah</VALUE>
    <VALUE Lang="cn">这是被偷走的GPS！ 我很高兴您找到它了！噢！我只是在自言自语。您可以走了！我为我奇怪的言行深感歉意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_12_0">
    <VALUE Lang="GS">.......5</VALUE>
    <VALUE Lang="id">......5</VALUE>
    <VALUE Lang="cn">.......5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_13_0">
    <VALUE Lang="GS">Oh! You found it!</VALUE>
    <VALUE Lang="GS">It's been 18 years since I last saw this device by a specialist named Liu Cheng You.</VALUE>
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="id">Untung sekali akhirnya kamu menemukannya</VALUE>
    <VALUE Lang="id">Dikubur sehari setelah kejadian hujan meteor itu terjadi</VALUE>
    <VALUE Lang="id">Terimakasih kamu sudah menemukannya dengan baik…</VALUE>
    <VALUE Lang="cn">噢！您找到它了！我透过专家Liu Cheng You最后看到这个装置已经是18年前的事情了！</VALUE>
    <VALUE Lang="cn">非常感谢您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_14_0">
    <VALUE Lang="GS">Student! Please remember that consistent training will be part of your quest for victory. There will be times of disappointment ahead but you need not be sad. Just focus on your training and you'll definitely become a more powerful individual.</VALUE>
    <VALUE Lang="id">Eum? Pelajaran?</VALUE>
    <VALUE Lang="id">Kalau sudah berlari-lari seperti itu, bisa dibilang kamu sudah berolahraga kan?</VALUE>
    <VALUE Lang="id">Walaupun kecewa mau apa lagi</VALUE>
    <VALUE Lang="cn">同学！请记住，持续不断的修炼，将成为您的任务内容之一；甚至能引领您前往胜利之路。 一开始可能会有些挫折，但千万不要感到难过。只要集中注意力在修行，您将会明显的感觉出自己的能量是越来越强大的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_15_0">
    <VALUE Lang="GS">.....6</VALUE>
    <VALUE Lang="id">....6</VALUE>
    <VALUE Lang="cn">.....6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_16_0">
    <VALUE Lang="GS">Broaden your horizons! It is great to look at things from different perspectives!</VALUE>
    <VALUE Lang="GS">Imagine this is part of the lesson!</VALUE>
    <VALUE Lang="GS">Someday, this may benefit you and the people you care about.</VALUE>
    <VALUE Lang="id">Pergilah</VALUE>
    <VALUE Lang="id">Kalau berpikir bahwa ini juga adalah bagian dari pelajaran yah….</VALUE>
    <VALUE Lang="id">Baik untuk kedua belah pihak kan?</VALUE>
    <VALUE Lang="cn">去开拓您的视野吧！从各种角度来看一件事情是很好的。想象一下这是一门必修课！也许在某天，您会发现今天所学的，都将成为您和其他人的精神食粮。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_16_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_17_0">
    <VALUE Lang="GS">Oh. Ok.</VALUE>
    <VALUE Lang="GS">Well, even if he's not here, I can give you more information.</VALUE>
    <VALUE Lang="GS">After the meteor fell 18 years ago, the chairman realized the dangers posed by another world to our world. This included the threat of horrendous monsters.</VALUE>
    <VALUE Lang="id">Begitu yah?</VALUE>
    <VALUE Lang="id">Saya bisa memberitahu kamu sedikit walaupun guru besar tidak ada di sini</VALUE>
    <VALUE Lang="id">Director Lee sudah mengira-ngira hubungan antara dunia ini dan dunia lain setelah kejadian hujan meteor 18 tahun yang lalu. Dia juga memprediksikan bahwa pengaruh</VALUE>
    <VALUE Lang="cn">噢…好！</VALUE>
    <VALUE Lang="cn">嗯！虽然老师不在这儿，但我还是可以给您提供些情报。</VALUE>
    <VALUE Lang="cn">在18年前出现流星雨的时后，社长就领悟到了所谓的异世界危险因子已经来到了我们的世界。 而这些危险因子正夹带着可怕怪物们的凶兆。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_17_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_18_0">
    <VALUE Lang="GS">It was later discovered that the meteor has made of living biological particles from another world. These transmitted power to organisms on our world. In most cases, this created monsters. In other cases, this resulted in people that became strong enough to survive the ensuing chaos: these are the people whose names are on the List of Saints.</VALUE>
    <VALUE Lang="id">Yang terlihat seperti hujan meteor itu sebenarnya adalah potongan kehidupan yang terkirim dari dunia lain dan kalian adalah media yang membawa kekuatan potongan-potongan itu</VALUE>
    <VALUE Lang="id">Yang namanya daftar saint adalah daftar nama orang-orang yang mempunyai kekuat</VALUE>
    <VALUE Lang="cn">之后才发现，流星是来自异世界的活生物粒子。 这些发射出的力量进入了我们星球的有机生物体内。这种现象在大多数的情况下，会蕴酿出怪物的诞生；抑或是使人类变得过度强大，导致生存的混乱危机发生。而这些人类的名字都已经被抄写在圣徒名单上面了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_18_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_19_0">
    <VALUE Lang="GS">The people at SFG thought the best way to prevent this disaster from recurring was to gather the people that were strengthened by the meteor's power.</VALUE>
    <VALUE Lang="GS">Unless this new potential was fully explored, and the power from the meteor was properly utilized, then the world would have no protection from otherworldly invaders.</VALUE>
    <VALUE Lang="GS">That is why students were especially chosen to join this campus: the end goal is to fully cultivate and develop power that will hopefully be enough to protect our world.</VALUE>
    <VALUE Lang="GS">That's what happened.</VALUE>
    <VALUE Lang="id">Mengumpulkan orang-orang yang bisa memberikan perintah ditengah-tengah bencana yang terjadi untuk pencegahan</VALUE>
    <VALUE Lang="id">Kalau hal itu tidak terjadi dunia ini mungkin saja akan berakhir</VALUE>
    <VALUE Lang="id">Kita harus memanggil mereka dengan cara apapun…</VALUE>
    <VALUE Lang="id">Hal seperti itulah.</VALUE>
    <VALUE Lang="cn">SFG的人认为预防疾病最好的方法就是收集陨石的力量，来得到被强化的人民。除非新的潜能再度被挖掘，或是陨石的能量被正常地使用，否则这个世界将会被超现实世界的侵略者给破坏。</VALUE>
    <VALUE Lang="cn">这就是为什么学生们选择要加入这个校园的原因。他们的最终目标就是充分地培育，以及发展动力，进而可以充分地保护这个世界。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_19_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_2_0">
    <VALUE Lang="GS">Oh! You really want to learn, huh?</VALUE>
    <VALUE Lang="GS">There's nothing more worthwhile than teaching you students!</VALUE>
    <VALUE Lang="GS">The manager's not around, so I can teach you some lessons myself. Is that fine with you?</VALUE>
    <VALUE Lang="id">Heum…pelajaran yah…</VALUE>
    <VALUE Lang="id">Enggak ada yang mau aku ajarkan juga sih</VALUE>
    <VALUE Lang="id">Bisa gawat apalagi pada saat Kepala kantor tidak berada di sini</VALUE>
    <VALUE Lang="id">Kalau memang itu mau aku bisa memberikan sedikit bantuan</VALUE>
    <VALUE Lang="cn">噢！您真的愿意学习吗？</VALUE>
    <VALUE Lang="cn">没有什么事情是比教学生还要有意义的事情了！</VALUE>
    <VALUE Lang="cn">馆长现在不在位置上，所以我想先教您些东西。您愿意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_2_0_1">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_2_0_6">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_20_0">
    <VALUE Lang="GS">Do you know there is a private prison at the Sacred Financial Group?</VALUE>
    <VALUE Lang="GS">There are special minerals that only come from the mine near that prison. It used to be a working area for prisoners.</VALUE>
    <VALUE Lang="GS">A well-refined mixture of that mineral can enhance steel... Especially weapons and armor with special power...</VALUE>
    <VALUE Lang="GS">The success rate is too low, however, and it requires a large amount of oil.</VALUE>
    <VALUE Lang="GS">Are you still willing to try it?</VALUE>
    <VALUE Lang="id">Apakah kamu tahu ada Penjara Rahasia di Sacred Financial Group?</VALUE>
    <VALUE Lang="id">Terdapat mineral khusus yang hanya muncul di dekat penjara tersebut sehingga para tahanan harus membantu mengeluarkannya.</VALUE>
    <VALUE Lang="id">Mineral tersebut dapat membuat item yang sangat kuatl... Teruta</VALUE>
    <VALUE Lang="cn">您知道在Sacred Financial Group有一间私人监狱吗？那边监狱附近的井底蕴有非常特别的矿石唷！对囚犯来说，那口井是生命之泉。</VALUE>
    <VALUE Lang="cn">这矿石的精练合成物，可以拿来提炼钢铁。特别是这边制作的武器和防具都内含特殊力量。不过，成功的机率非常低。而且，要拥有它们，首先您得尊卑大量的油才行。即使如此，您还是愿意挑战吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_21_0">
    <VALUE Lang="GS">The easiest way to get oil is from the tuna near this area. You could easily find tuna boat workers at the wharf.</VALUE>
    <VALUE Lang="GS">Make sure to check the quality of your tuna oil. Some of it is pretty useless.</VALUE>
    <VALUE Lang="GS">Please get 10 bottles of oil.</VALUE>
    <VALUE Lang="id">Cara termudah mendapatkan minyaknya adalah dari tuna di sekitar area sini. Kamu bisa menemukan mereka di seluruh map ini.</VALUE>
    <VALUE Lang="id">Bawakan saya 10 botol Oil nya.</VALUE>
    <VALUE Lang="cn">最简单的方法就是从附近的鲔鱼大哥那儿取出油源，在Wharf您可以轻易找到鲔鱼线船只的工作人员。请确认好您的鲔鱼油质是否安全，因为有些部分的油源是劣等的油！现在，请您去收集10瓶油唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_22_0">
    <VALUE Lang="GS">Well done.</VALUE>
    <VALUE Lang="GS">I will put that oil in this machine.</VALUE>
    <VALUE Lang="GS">I can't guarantee that it'll create something that will help you...</VALUE>
    <VALUE Lang="GS">Anyway, good luck.</VALUE>
    <VALUE Lang="id">Bagus.</VALUE>
    <VALUE Lang="id">Saya akan meletakkan minyaknya di sini.</VALUE>
    <VALUE Lang="id">Saya tidak bisa menjanjikan jika pasti berhasil tapi saya akan mencoba...</VALUE>
    <VALUE Lang="cn">做得好！</VALUE>
    <VALUE Lang="cn">我会把油加进机器里的。</VALUE>
    <VALUE Lang="cn">但我无法保证结果一定是美好的。</VALUE>
    <VALUE Lang="cn">总之！祝您好运。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_23_0">
    <VALUE Lang="GS">Oh, you received the information that I requested, didn't you? I was so worried about my boss because I couldn't contact him for a long time. I also wasn't able to get any intel around here, so I really appreciate that you were able to deliver this information.</VALUE>
    <VALUE Lang="GS">Now I can relax just a little bit.</VALUE>
    <VALUE Lang="GS">Thank you very much.</VALUE>
    <VALUE Lang="id">Kamu sudah mendapatkan permintaan saya bukan? Saya sangat khawatir karena bos saya sudah tidak bisa dihubungi berhari - hari. Saya juga tidak bisa menghubungi para intel di sini, jadi saya sangat berterima kasih atas bantuanmu.</VALUE>
    <VALUE Lang="id">Sekarang saya bisa beris</VALUE>
    <VALUE Lang="cn">您已经收到我提出的请求了，对吧？我很担心我的老板，他失联很久了。同时我也无法取得周遭的现况情报，所以很感激您如此的分享资讯给我。现在我的感觉好多了。非常感谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_23_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_24_0">
    <VALUE Lang="GS">Wait... I just remembered something.</VALUE>
    <VALUE Lang="GS">A few days ago, I got another time capsule delivery from another student...</VALUE>
    <VALUE Lang="GS">There were pictures of the Gangsters trading inside the capsule.</VALUE>
    <VALUE Lang="GS">What's weird is that the SFG Flag is on a ship that probably contains the gangsters' trading goods.</VALUE>
    <VALUE Lang="GS">I don't know if this is some weird mistake.</VALUE>
    <VALUE Lang="GS">Well, I hope this information is worth the reward for your delivery.</VALUE>
    <VALUE Lang="id">Tunggu... Saya ingat sesuatu.</VALUE>
    <VALUE Lang="id">Beberapa hari lalu, Saya mendapatkan kiriman kapsul dari pelajar lain...</VALUE>
    <VALUE Lang="id">Di dalamnya terdapat foto para gangster sedang bertransaksi.</VALUE>
    <VALUE Lang="id">Yang aneh adalah terdapat bendera SFG di kapal yang memungkinkan para gangster ber</VALUE>
    <VALUE Lang="cn">等等… 我好像想起一些事情了。前几天，我从一个学生身上，拿到了一颗时光胶囊 。胶囊里面画有黑帮们的货物交易图样。奇怪的是SFG 的旗帜在船上，那边非常有可能载有黑帮的货物。</VALUE>
    <VALUE Lang="cn">我不清楚这是否是场误会，但，我希望这情报可以带给您与奖励等值的报酬。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_24_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Begin</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_25_0">
    <VALUE Lang="GS">Excuse me. I don't know everything, and I'm staying here instead of my teacher, but...</VALUE>
    <VALUE Lang="GS">I've got a story to tell you.</VALUE>
    <VALUE Lang="GS">People used to regularly hold this festival. And then...</VALUE>
    <VALUE Lang="GS">Some time ago, after one of these festivals, there was some kind of problem...</VALUE>
    <VALUE Lang="id">Permisi. Saya tidak tahu apapun, saya di sini hanya sebagai pengganti dari guru saya, tetapi...</VALUE>
    <VALUE Lang="id">Ada yang ingin saya beritahukan.</VALUE>
    <VALUE Lang="id">Awalnya orang - orang datang rutin ke acara festival ini. Tetapi...</VALUE>
    <VALUE Lang="id">Terdapat suatu masalah beberapa saat lalu setelah</VALUE>
    <VALUE Lang="cn">不好意思，我其实什么都不知道。我是代替我的老师在这边待命的。我告诉您一个小故事。人们曾经定期举办这种大会活动。但现在…….在不久之前，一场活动中，发生了一些问题…。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_26_0">
    <VALUE Lang="GS">Guessing from their outfits and conversations, I believe that they are not the people from this world. Especially, those two guys did not seem like nice people. They were headed toward Trading Hole and I watched them go. In case, you have to fight them then you better watch out for the guy in the black outfit.</VALUE>
    <VALUE Lang="id">Mengutip dari pembicaraan mereka, saya yakin mereka bukan orang dari dunia ini. Terutama, 2 orang tersebut terlihat sangat tidak bersahabat. Mereka menuju ke arah Trading Hole dan saya sendiri melihatnya. Untuk jaga - jaga, pergilah dan bunuh mereka. Hati</VALUE>
    <VALUE Lang="cn">依照他们的穿着及谈吐来看，我猜他们应该不是现世的人。且那两位男生感觉上也非常的凶神恶煞。我一直看着他们进入 Trading Hole。如果,你是要去对付他们，必须要留意穿着黑色衣服的男生。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_26_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_3_0">
    <VALUE Lang="GS">There is nothing special about this device!</VALUE>
    <VALUE Lang="GS">You should find the GPS first, and then an input device.</VALUE>
    <VALUE Lang="id">Bukan sesuatu yang begitu luar biasa…</VALUE>
    <VALUE Lang="id">Kamu cari dulu GPSnya lalu temukan item yang dikubur di tempat yang ditunjukkan oleh GPS</VALUE>
    <VALUE Lang="cn">这装置没有什么了不起的。您应该先找出GPS ，然后才是设备的输入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_3_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_4_0">
    <VALUE Lang="GS">Would you like to have some lessons?</VALUE>
    <VALUE Lang="GS">There's nothing more worthwhile than teaching you students!</VALUE>
    <VALUE Lang="GS">The manager's not around, so I can teach you some lessons myself.</VALUE>
    <VALUE Lang="GS">Is that fine with you?</VALUE>
    <VALUE Lang="id">Heum…pelajaran yah…</VALUE>
    <VALUE Lang="id">Enggak ada yang mau aku ajarkan juga sih</VALUE>
    <VALUE Lang="id">Bisa gawat apalagi pada saat Kepala kantor tidak berada di sini</VALUE>
    <VALUE Lang="id">Kalau memang itu mau aku bisa memberikan sedikit bantuan</VALUE>
    <VALUE Lang="cn">您想要听更多的课程吗？</VALUE>
    <VALUE Lang="cn">没有什么事情是比教学生还要有意义的事情了！</VALUE>
    <VALUE Lang="cn">馆长现在不在位置上，所以我想先教您些东西。您愿意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_4_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_5_0">
    <VALUE Lang="GS">If you don't know the importance of physical strength, then it will be very difficult for you to understand future lessons.</VALUE>
    <VALUE Lang="GS">By the way, I need to ask you to do something.</VALUE>
    <VALUE Lang="id">Kelas akan menjadi sangat sulit kalau kamu tidak tahu tentang pentingnya stamina yang paling dasar</VALUE>
    <VALUE Lang="id">Ngomong-ngomong...saya mau minta bantuan sesuatu….</VALUE>
    <VALUE Lang="cn">如果您不懂体力的重要性，那么未来的课程对您而言，将会是会非常困难的。顺道一提，我需要请您帮个忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_5_0_1">
    <VALUE Lang="GS">Accept Instruction</VALUE>
    <VALUE Lang="id">Menerima petunjuk</VALUE>
    <VALUE Lang="cn">接受指示</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_5_0_4">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_6_0">
    <VALUE Lang="GS">Did you see the Police Station nearby?</VALUE>
    <VALUE Lang="GS">There is a police officer waiting for you at the Main Door.</VALUE>
    <VALUE Lang="GS">Just approach him and tell him that I instructed you to look for him. I believe he'll have something for you.</VALUE>
    <VALUE Lang="id">Sudah lihat polisi yang ada di sekitar sini kan?</VALUE>
    <VALUE Lang="id">Akan ada seorang polisi yang menunggu di depan pintu masuk</VALUE>
    <VALUE Lang="id">Kalau kamu pergi ke sana dan bilang bahwa saya mengirim kamu, dia pasti akan memintamu melakukan sesuatu</VALUE>
    <VALUE Lang="cn">有看到附近的Police Station吗？</VALUE>
    <VALUE Lang="cn">Main Door有一位Police officer在等您。去拜访他，并告诉他是我介绍您来的。我相信他会给您点什么东西的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_6_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_7_0">
    <VALUE Lang="GS">....3</VALUE>
    <VALUE Lang="id">.....3</VALUE>
    <VALUE Lang="cn">....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_8_0">
    <VALUE Lang="GS">This is a stolen GPS! It's great that you found it.</VALUE>
    <VALUE Lang="GS">Ah, I was just talking to myself.</VALUE>
    <VALUE Lang="GS">You're free to go. I'm so for acting so weirdly.</VALUE>
    <VALUE Lang="id">….Memang sih ini GPS yang dulu dicuri, pada kesempatan ini harus kita temukan nih</VALUE>
    <VALUE Lang="id">Euhm? Ah, aku ngomong sendiri jangan dipedulikan</VALUE>
    <VALUE Lang="id">Nah, pergilah</VALUE>
    <VALUE Lang="cn">这是被偷走的GPS！ 我很高兴您找到它了！噢！我只是在自言自语。您可以走了！我为我奇怪的言行深感歉意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_knight1.ntk_9_0">
    <VALUE Lang="GS">.....4</VALUE>
    <VALUE Lang="id">.....4</VALUE>
    <VALUE Lang="cn">.....4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_0">
    <VALUE Lang="GS">Welcome to the Trading Hole Area!</VALUE>
    <VALUE Lang="GS">I am the Shaman Section Agent. How can I help you?</VALUE>
    <VALUE Lang="GS">Please feel free to look around if you like.</VALUE>
    <VALUE Lang="id">Disini adalah Shamans club, kamu ada perlu apa?</VALUE>
    <VALUE Lang="cn">欢迎来到Trading Hole区！</VALUE>
    <VALUE Lang="cn">我是气功部部门的代理人，需要什么帮忙？请自由随便参观。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1">
    <VALUE Lang="GS">I'm sorry the Manager isn't here right now.</VALUE>
    <VALUE Lang="GS">Please come back again later.</VALUE>
    <VALUE Lang="id">Sekarang Kepala kantor sedang tidak ada di tempat</VALUE>
    <VALUE Lang="id">Kalau kamu sudah menemukan Kepala kantor nanti bisa tolong datang lagi?</VALUE>
    <VALUE Lang="cn">很抱歉，现在负责人不在位置上。 请您稍候再来。谢谢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_1">
    <VALUE Lang="GS">Request to Attend Class</VALUE>
    <VALUE Lang="id">Meminta latihan</VALUE>
    <VALUE Lang="cn">要求参与课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_10">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问 圣徒之表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_11">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问 圣徒之表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_14">
    <VALUE Lang="GS">Deliver the Time Capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">交付时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_15">
    <VALUE Lang="GS">Gather Info before the Incident</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">收集意外发生前的资讯</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_4">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Mengikuti latihan</VALUE>
    <VALUE Lang="cn">参与课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_5">
    <VALUE Lang="GS">Attend Class</VALUE>
    <VALUE Lang="id">Mengikuti latihan</VALUE>
    <VALUE Lang="cn">参与课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_6">
    <VALUE Lang="GS">Give the Time Capsule</VALUE>
    <VALUE Lang="id">Menyerahkan Time Capsule</VALUE>
    <VALUE Lang="cn">交付时光胶囊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_7">
    <VALUE Lang="GS">Accept Instructions</VALUE>
    <VALUE Lang="id">Menerima petunjuk</VALUE>
    <VALUE Lang="cn">接受指导</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_8">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_1_1_9">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问 圣徒之表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_10_0">
    <VALUE Lang="GS">There is nothing special about this device!</VALUE>
    <VALUE Lang="GS">You should find the GPS first, and then an input device.</VALUE>
    <VALUE Lang="id">Bukan sesuatu yang begitu luar biasa…</VALUE>
    <VALUE Lang="id">Kamu cari dulu GPSnya lalu temukan item yang dikubur di tempat yang ditunjukkan oleh GPS</VALUE>
    <VALUE Lang="id">.</VALUE>
    <VALUE Lang="cn">这装置没有什么了不起的。您应该先找出GPS ，然后才是设备的输入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_11_0">
    <VALUE Lang="GS">This is a stolen GPS! It's great that you found it.</VALUE>
    <VALUE Lang="GS">Ah! I was just talking to myself. You're free to go.</VALUE>
    <VALUE Lang="GS">I'm sorry for acting so strangely.</VALUE>
    <VALUE Lang="id">….Memang sih ini GPS yang dulu dicuri, pada kesempatan ini harus kita temukan nih</VALUE>
    <VALUE Lang="id">Euhm? Ah, aku ngomong sendiri jangan dipedulikan</VALUE>
    <VALUE Lang="id">Nah, cepat</VALUE>
    <VALUE Lang="cn">这是被偷走的GPS！ 我很高兴您找到它了！噢！我只是在自言自语。您可以走了！我为我奇怪的言行深感歉意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_12_0">
    <VALUE Lang="GS">.......5</VALUE>
    <VALUE Lang="id">......5</VALUE>
    <VALUE Lang="cn">.......5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_13_0">
    <VALUE Lang="GS">Oh! You found it!</VALUE>
    <VALUE Lang="GS">It's been 18 years since I last saw this device by a specialist named Liu Cheng You.</VALUE>
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="id">Untung sekali akhirnya kamu menemukannya</VALUE>
    <VALUE Lang="id">Aku kubur itu 18 tahun yang lalu bersama teman-teman setelah melihat hujan meteor</VALUE>
    <VALUE Lang="cn">噢！您找到它了！我透过专家Liu Cheng You最后看到这个装置已经是18年前的事情了！</VALUE>
    <VALUE Lang="cn">非常感谢您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_14_0">
    <VALUE Lang="GS">Student! Please remember that consistent training will be part of your quest for victory. There will be times of disappointment ahead but you need not be sad. Just focus on your training and you'll definitely become a more powerful individual.</VALUE>
    <VALUE Lang="id">Eum? Pelajaran?</VALUE>
    <VALUE Lang="id">Kalau sudah berlari-lari seperti itu, bisa dibilang kamu sudah berolahraga kan?</VALUE>
    <VALUE Lang="id">Walaupun kecewa mau apa lagi</VALUE>
    <VALUE Lang="cn">同学！请记住，持续不断的修炼，将成为您的任务内容之一；甚至能引领您前往胜利之路。 一开始可能会有些挫折，但千万不要感到难过。只要集中注意力在修行，您将会明显的感觉出自己的能量是越来越强大的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_15_0">
    <VALUE Lang="GS">.....6</VALUE>
    <VALUE Lang="id">......6</VALUE>
    <VALUE Lang="cn">.....6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_16_0">
    <VALUE Lang="GS">Broaden your horizons! It is great to look at things from different perspectives!</VALUE>
    <VALUE Lang="GS">Imagine this is part of the lesson!</VALUE>
    <VALUE Lang="GS">Someday, this may benefit you and the people you care about.</VALUE>
    <VALUE Lang="id">Pergilah</VALUE>
    <VALUE Lang="id">Kalau berpikir bahwa ini juga adalah bagian dari pelajaran yah….</VALUE>
    <VALUE Lang="id">Baik untuk kedua belah pihak kan?</VALUE>
    <VALUE Lang="cn">去开拓您的视野吧！从各种角度来看一件事情是很好的。想象一下这是一门必修课！也许在某天，您会发现今天所学的，都将成为您和其他人的精神食粮。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_16_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_17_0">
    <VALUE Lang="GS">Oh. Ok.</VALUE>
    <VALUE Lang="GS">Well, even if he's not here, I can give you more information.</VALUE>
    <VALUE Lang="GS">After the meteor fell 18 years ago, the chairman realized the dangers posed by another world to our world. This included the threat of horrendous monsters.</VALUE>
    <VALUE Lang="id">Begitu yah?</VALUE>
    <VALUE Lang="id">Saya bisa memberitahu kamu sedikit walaupun guru besar tidak ada di sini</VALUE>
    <VALUE Lang="id">Director Lee sudah mengira-ngira hubungan antara dunia ini dan dunia lain setelah kejadian hujan meteor 18 tahun yang lalu. Dia juga memprediksikan bahwa pengaruh</VALUE>
    <VALUE Lang="cn">噢…好！</VALUE>
    <VALUE Lang="cn">嗯！虽然老师不在这儿，但我还是可以给您提供些情报。</VALUE>
    <VALUE Lang="cn">在18年前出现流星雨的时后，社长就领悟到了所谓的异世界危险因子已经来到了我们的世界。 而这些危险因子正夹带着可怕怪物们的凶兆。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_17_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_18_0">
    <VALUE Lang="GS">It was later discovered that the meteor has made of living biological particles from another world. These transmitted power to organisms on our world. In most cases, this created monsters. In other cases, this resulted in people that became strong enough to survive the ensuing chaos: these are the people whose names are on the List of Saints.</VALUE>
    <VALUE Lang="id">Yang terlihat seperti hujan meteor itu sebenarnya adalah potongan kehidupan yang terkirim dari dunia lain dan kalian adalah media yang membawa kekuatan potongan-potongan itu</VALUE>
    <VALUE Lang="id">Yang namanya daftar saint adalah daftar nama orang-orang yang mempunyai kekuat</VALUE>
    <VALUE Lang="cn">之后才发现，流星是来自异世界的活生物粒子。 这些发射出的力量进入了我们星球的有机生物体内。这种现象在大多数的情况下，会蕴酿出怪物的诞生；抑或是使人类变得过度强大，导致生存的混乱危机发生。而这些人类的名字都已经被抄写在圣徒名单上面了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_18_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_19_0">
    <VALUE Lang="GS">The people at SFG thought the best way to prevent this disaster from recurring was to gather the people that were strengthened by the meteor's power.</VALUE>
    <VALUE Lang="GS">Unless this new potential was fully explored, and the power from the meteor was properly utilized, then the world would have no protection from otherworldly invaders.</VALUE>
    <VALUE Lang="GS">That is why students were especially chosen to join this campus: the end goal is to fully cultivate and develop power that will hopefully be enough to protect our world.</VALUE>
    <VALUE Lang="GS">That's what happened.</VALUE>
    <VALUE Lang="id">Mengumpulkan orang-orang yang bisa memberikan perintah ditengah-tengah bencana yang terjadi untuk pencegahan</VALUE>
    <VALUE Lang="id">Kalau hal itu tidak terjadi dunia ini mungkin saja akan berakhir</VALUE>
    <VALUE Lang="id">Kita harus memanggil mereka dengan cara apapun…</VALUE>
    <VALUE Lang="id">Hal seperti itulah.</VALUE>
    <VALUE Lang="cn">SFG的人认为预防疾病最好的方法就是收集陨石的力量，来得到被强化的人民。除非新的潜能再度被挖掘，或是陨石的能量被正常地使用，否则这个世界将会被超现实世界的侵略者给破坏。</VALUE>
    <VALUE Lang="cn">这就是为什么学生们选择要加入这个校园的原因。他们的最终目标就是充分地培育，以及发展动力，进而可以充分地保护这个世界。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_19_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_2_0">
    <VALUE Lang="GS">Oh! You really want to learn, huh?</VALUE>
    <VALUE Lang="GS">There's nothing more worthwhile than teaching you students!</VALUE>
    <VALUE Lang="GS">The manager's not around, so I can teach you some lessons myself. Is that fine with you?</VALUE>
    <VALUE Lang="id">Kok pelajaran…</VALUE>
    <VALUE Lang="id">Enggak ada yang mau aku ajarkan juga sih</VALUE>
    <VALUE Lang="id">Bisa gawat apalagi pada saat Kepala kantor tidak berada di sini</VALUE>
    <VALUE Lang="id">Kalau memang itu masalahnya aku bisa membantu sedikit…</VALUE>
    <VALUE Lang="cn">噢！您真的愿意学习吗？</VALUE>
    <VALUE Lang="cn">没有什么事情是比教学生还要有意义的事情了！</VALUE>
    <VALUE Lang="cn">馆长现在不在位置上，所以我想先教您些东西。您愿意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_2_0_1">
    <VALUE Lang="GS">Agree to Attend Class</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">同意参加课程</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_2_0_6">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_20_0">
    <VALUE Lang="GS">Do you know there is a private prison at the Sacred Financial Group?</VALUE>
    <VALUE Lang="GS">There are special minerals that only come from the mine near that prison. It used to be a working area for prisoners.</VALUE>
    <VALUE Lang="GS">A well-refined mixture of that mineral can enhance steel... Especially weapons and armor with special power...</VALUE>
    <VALUE Lang="GS">The success rate is too low, however, and it requires a large amount of oil.</VALUE>
    <VALUE Lang="GS">Are you still willing to try it?</VALUE>
    <VALUE Lang="id">Apakah kamu tahu ada Penjara Rahasia di Sacred Financial Group?</VALUE>
    <VALUE Lang="id">Terdapat mineral khusus yang hanya muncul di dekat penjara tersebut sehingga para tahanan harus membantu mengeluarkannya.</VALUE>
    <VALUE Lang="id">Mineral tersebut dapat membuat item yang sangat kuatl... Teruta</VALUE>
    <VALUE Lang="cn">您知道在Sacred Financial Group有一间私人监狱吗？那边监狱附近的井底蕴有非常特别的矿石唷！对囚犯来说，那口井是生命之泉。</VALUE>
    <VALUE Lang="cn">这矿石的精练合成物，可以拿来提炼钢铁。特别是这边制作的武器和防具都内含特殊力量。不过，成功的机率非常低。而且，要拥有它们，首先您得尊卑大量的油才行。即使如此，您还是愿意挑战吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_21_0">
    <VALUE Lang="GS">The easiest way to get oil is from the tuna near this area. You could easily find tuna boat workers at the wharf.</VALUE>
    <VALUE Lang="GS">Make sure to check the quality of your tuna oil. Some of it is pretty useless.</VALUE>
    <VALUE Lang="GS">Please get 10 bottles of oil.</VALUE>
    <VALUE Lang="id">Cara termudah mendapatkan minyaknya adalah dari tuna di sekitar area sini. Kamu bisa menemukan mereka di seluruh map ini.</VALUE>
    <VALUE Lang="id">Bawakan saya 10 botol Oil nya.</VALUE>
    <VALUE Lang="cn">最简单的方法就是从附近的鲔鱼大哥那儿取出油源，在Wharf您可以轻易找到鲔鱼线船只的工作人员。请确认好您的鲔鱼油质是否安全，因为有些部分的油源是劣等的油！现在，请您去收集10瓶油唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_22_0">
    <VALUE Lang="GS">Well done.</VALUE>
    <VALUE Lang="GS">I will put that oil in this machine.</VALUE>
    <VALUE Lang="GS">I can't guarantee that it'll create something that will help you...</VALUE>
    <VALUE Lang="GS">Anyway, good luck.</VALUE>
    <VALUE Lang="id">Bagus.</VALUE>
    <VALUE Lang="id">Saya akan meletakkan minyaknya di sini.</VALUE>
    <VALUE Lang="id">Saya tidak bisa menjanjikan jika pasti berhasil tapi saya akan mencoba...</VALUE>
    <VALUE Lang="cn">做得好！</VALUE>
    <VALUE Lang="cn">我会把油加进机器里的。</VALUE>
    <VALUE Lang="cn">但我无法保证结果一定是美好的。</VALUE>
    <VALUE Lang="cn">总之！祝您好运。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_23_0">
    <VALUE Lang="GS">Oh, you received the information that I requested, didn't you? I was so worried about my boss because I couldn't contact him for a long time. I also wasn't able to get any intel around here, so I really appreciate that you were able to deliver this information.</VALUE>
    <VALUE Lang="GS">Now I can relax just a little bit.</VALUE>
    <VALUE Lang="GS">Thank you very much.</VALUE>
    <VALUE Lang="id">Ah, kamu sudah mendengar apa yang saya minta rupanya.</VALUE>
    <VALUE Lang="id">Kami benar-benar kesal karena tidak bisa mengumpulkan informasi tentang daerah sekitar, dan kami juga tidak tahu dimana keberadaan gurgu besar</VALUE>
    <VALUE Lang="id">Saya jadi merasa sedikit tenang karena kamu sudah me</VALUE>
    <VALUE Lang="cn">您已经收到我提出的请求了，对吧？我很担心我的老板，他失联很久了。同时我也无法取得周遭的现况情报，所以很感激您如此的分享资讯给我。现在我的感觉好多了。非常感谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_23_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_24_0">
    <VALUE Lang="GS">Wait... I just remembered something.</VALUE>
    <VALUE Lang="GS">A few days ago, I got another time capsule delivery from another student...</VALUE>
    <VALUE Lang="GS">There were pictures of the Gangsters trading inside the capsule.</VALUE>
    <VALUE Lang="GS">What's weird is that the SFG Flag is on a ship that probably contains the gangsters' trading goods.</VALUE>
    <VALUE Lang="GS">I don't know if this is some weird mistake.</VALUE>
    <VALUE Lang="GS">Well, I hope this information is worth the reward for your delivery.</VALUE>
    <VALUE Lang="id">Ah, hampir saja saya lupa</VALUE>
    <VALUE Lang="id">Dulu saya pernah mendapatkan Time Capsule lain dari pelajar yang lain, isinya….</VALUE>
    <VALUE Lang="id">Sungguh tidak masuk akal karena itu ternyata adalah photo dari anggota komplotan bira yang sedang melakukan transaksi</VALUE>
    <VALUE Lang="id">Ini….</VALUE>
    <VALUE Lang="id">Kamu bisa l</VALUE>
    <VALUE Lang="cn">等等… 我好像想起一些事情了。前几天，我从一个学生身上，拿到了一颗时光胶囊 。胶囊里面画有黑帮们的货物交易图样。奇怪的是SFG 的旗帜在船上，那边非常有可能载有黑帮的货物。</VALUE>
    <VALUE Lang="cn">我不清楚这是否是场误会，但，我希望这情报可以带给您与奖励等值的报酬。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_24_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_25_0">
    <VALUE Lang="GS">Excuse me. I don't know everything, and I'm staying here instead of my teacher, but...</VALUE>
    <VALUE Lang="GS">I've got a story to tell you.</VALUE>
    <VALUE Lang="GS">People used to regularly hold this festival. And then...</VALUE>
    <VALUE Lang="GS">Some time ago, after one of these festivals, there was some kind of problem...</VALUE>
    <VALUE Lang="id">Dengan terpaksa saya mau meminta bantuan</VALUE>
    <VALUE Lang="id">Saya tidak tahu banyak karena setelah guru besar menghilang saya terus berjaga di tempat ini.</VALUE>
    <VALUE Lang="id">Setelah mendengar apa yang kalian katakan ada beberapa hal yang mengganggu saya</VALUE>
    <VALUE Lang="id">Dulu ada acara penguburan Time</VALUE>
    <VALUE Lang="cn">不好意思，我其实什么都不知道。我是代替我的老师在这边待命的。我告诉您一个小故事。人们曾经定期举办这种大会活动。但现在…….在不久之前，一场活动中，发生了一些问题…。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_3_0">
    <VALUE Lang="GS">There is nothing special about this device!</VALUE>
    <VALUE Lang="GS">You should find the GPS first, and then an input device.</VALUE>
    <VALUE Lang="id">Bukan sesuatu yang begitu luar biasa…</VALUE>
    <VALUE Lang="id">Kamu cari dulu GPSnya lalu temukan item yang dikubur di tempat yang ditunjukkan oleh GPS</VALUE>
    <VALUE Lang="cn">这装置没有什么了不起的。您应该先找出GPS ，然后才是设备的输入。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_3_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_4_0">
    <VALUE Lang="GS">Would you like to have some lessons?</VALUE>
    <VALUE Lang="GS">There's nothing more worthwhile than teaching you students!</VALUE>
    <VALUE Lang="GS">The manager's not around, so I can teach you some lessons myself.</VALUE>
    <VALUE Lang="GS">Is that fine with you?</VALUE>
    <VALUE Lang="id">Heum…pelajaran yah…</VALUE>
    <VALUE Lang="id">Enggak ada yang mau aku ajarkan juga sih</VALUE>
    <VALUE Lang="id">Bisa gawat apalagi pada saat Kepala kantor tidak berada di sini…</VALUE>
    <VALUE Lang="id">Kalau memang itu mau aku bisa membantu sedikit…</VALUE>
    <VALUE Lang="cn">您想要听更多的课程吗？</VALUE>
    <VALUE Lang="cn">没有什么事情是比教学生还要有意义的事情了！</VALUE>
    <VALUE Lang="cn">馆长现在不在位置上，所以我想先教您些东西。您愿意吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_4_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_5_0">
    <VALUE Lang="GS">If you don't know the importance of physical strength, then it will be very difficult for you to understand future lessons.</VALUE>
    <VALUE Lang="GS">By the way, I need to ask you to do something.</VALUE>
    <VALUE Lang="id">Kelas akan menjadi sangat sulit kalau kamu tidak tahu tentang pentingnya stamina yang paling dasar</VALUE>
    <VALUE Lang="id">Ngomong-ngomong...saya mau minta bantuan sesuatu….</VALUE>
    <VALUE Lang="cn">如果您不懂Physical strength的重要性，那么未来的课程对您而言，将会是会非常困难的。顺道一提，我需要请您帮个忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_5_0_1">
    <VALUE Lang="GS">Accept Instruction</VALUE>
    <VALUE Lang="id">Menerima petunjuk</VALUE>
    <VALUE Lang="cn">接受指导</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_5_0_4">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_6_0">
    <VALUE Lang="GS">Did you see the Police Station nearby?</VALUE>
    <VALUE Lang="GS">There is a police officer waiting for you at the Main Door.</VALUE>
    <VALUE Lang="GS">Just approach him and tell him that I instructed you to look for him. I believe he'll have something for you.</VALUE>
    <VALUE Lang="id">Sudah lihat polisi yang ada di sekitar sini kan?</VALUE>
    <VALUE Lang="id">Akan ada seorang polisi yang menunggu di depan pintu masuk</VALUE>
    <VALUE Lang="id">Kalau kamu pergi ke sana dan bilang bahwa saya mengirim kamu, dia pasti akan memintamu melakukan sesuatu</VALUE>
    <VALUE Lang="cn">有看到附近的Police Station吗？</VALUE>
    <VALUE Lang="cn">Main Door有一位Police officer在等您。去拜访他，并告诉他是我介绍您来的。我相信他会给您点什么东西的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_6_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_7_0">
    <VALUE Lang="GS">....3</VALUE>
    <VALUE Lang="id">.....3</VALUE>
    <VALUE Lang="cn">....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_8_0">
    <VALUE Lang="GS">This is a stolen GPS! It's great that you found it.</VALUE>
    <VALUE Lang="GS">Ah, I was just talking to myself.</VALUE>
    <VALUE Lang="GS">You're free to go. I'm sorry for acting so strangely.</VALUE>
    <VALUE Lang="id">….Memang sih ini GPS yang dulu dicuri, pada kesempatan ini harus kita temukan nih</VALUE>
    <VALUE Lang="id">Euhm? Ah, aku ngomong sendiri jangan dipedulikan</VALUE>
    <VALUE Lang="id">Nah, cepat</VALUE>
    <VALUE Lang="cn">这是被偷走的GPS！ 我很高兴您找到它了！噢！我只是在自言自语。您可以走了！我为我奇怪的言行深感歉意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_9_0">
    <VALUE Lang="GS">.....4</VALUE>
    <VALUE Lang="id">.....4</VALUE>
    <VALUE Lang="cn">.....4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_trick.ntk_1_0">
    <VALUE Lang="GS">What's the matter?</VALUE>
    <VALUE Lang="id">Ada masalah apa?</VALUE>
    <VALUE Lang="cn">有什么事吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_trick.ntk_1_0_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Trade</VALUE>
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_trick.ntk_1_1">
    <VALUE Lang="GS">It seems like a big problem. Anyone experiencing must be in distress.</VALUE>
    <VALUE Lang="id">Kedengarannya seperti masalah yang besar. Orang-orang yang mengalaminya pasti merasa tertekan.</VALUE>
    <VALUE Lang="cn">好像出大事了, 某人肯定遇到了麻烦.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_trick.ntk_1_1_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Trade</VALUE>
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_trick.ntk_1_1_2">
    <VALUE Lang="GS">Ask what you can do.</VALUE>
    <VALUE Lang="id">Tanyakan apa yang bisa kamu lakukan.</VALUE>
    <VALUE Lang="cn">询问你能做什么.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_trick.ntk_2_0">
    <VALUE Lang="GS">We don’t know how we are ever going to face you… We were thoughtless… We should have listened to you… As you know, the Daramains have their eye upon the Large Hadron Collider. However, we are not able to hide it by magic… If you take this job, we will be formally recognizing the use of magic to combat.</VALUE>
    <VALUE Lang="id">Kami tidak tahu bagaimana kami dapat menemuimu lagi.. Kami tidak berpikir panjang.. Seharusnya kami mendengarkanmu.. Seperti yang kamu ketahui, para Daramains menginginkan Large Hadron Collider. Tetapi, kami tidak bisa menyembunyikannya dengan kekuatan si</VALUE>
    <VALUE Lang="cn">我们不知道该怎么面对你…. 我们太轻率了… 我们应该听你的… 如你所知, 那些Daramains注视着Hadron Collider. 然而我们不能用魔术隐藏这些…. 如果你完成了这项工作, 我们将正确的识别出用魔术战斗的方法.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_trick.ntk_2_0_1">
    <VALUE Lang="GS">Tell him you are to take this.</VALUE>
    <VALUE Lang="id">Katakan bahwa kamu akan menerima ini</VALUE>
    <VALUE Lang="cn">告诉他你将接受这个任务.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_t_trick.ntk_3_0">
    <VALUE Lang="GS">Thank you. I wish you well.</VALUE>
    <VALUE Lang="id">Terimakasih. Saya doakan kamu semoga berhasil.</VALUE>
    <VALUE Lang="cn">谢谢你，祝你幸福</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_0">
    <VALUE Lang="GS">I'm sorry! The video rental store is closed!</VALUE>
    <VALUE Lang="GS">All the ruckus in this area is forcing most businesses to quit.</VALUE>
    <VALUE Lang="GS">Anyway, what can I do for you?</VALUE>
    <VALUE Lang="id">Maaf</VALUE>
    <VALUE Lang="id">Sekarang usaha perentalan sedang dihentikan</VALUE>
    <VALUE Lang="cn">"对不起</VALUE>
    <VALUE Lang="cn">现在停止出租业务</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_0_1">
    <VALUE Lang="GS">Request for Cassette Recovery Again</VALUE>
    <VALUE Lang="id">Meminta perbaikan tape lagi</VALUE>
    <VALUE Lang="cn">再次委托复原卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_0_10">
    <VALUE Lang="GS">Request for Cassette recovery</VALUE>
    <VALUE Lang="id">Meminta perbaikan tape</VALUE>
    <VALUE Lang="cn">委托复原卡带</VALUE>
