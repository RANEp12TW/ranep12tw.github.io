    <VALUE Lang="GS">Exchange Protective Potion</VALUE>
    <VALUE Lang="id">Tukar Protective Potion</VALUE>
    <VALUE Lang="cn">换取 Protective Potion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_3">
    <VALUE Lang="GS">Exchange Fine Burr</VALUE>
    <VALUE Lang="id">Tukar Fine Burr</VALUE>
    <VALUE Lang="cn">换取 Fine Burr</VALUE>
  </SENTENSE>
