  <SENTENSE Ver="1" Id="npc_new_cdm_helper1.ntk_3_0">
    <VALUE Lang="GS">You can pick one from the list according to the number of medals~</VALUE>
    <VALUE Lang="GS">1 Honor Award : CDM Honor Award Random Box (A part of Costume(1D), Grind Stone, Crystal, Essence… etc)</VALUE>
    <VALUE Lang="GS">5 Honor Award : Shoes / Gloves(1D), Grindstone Set (2pieces), Fine Crystal(1)</VALUE>
    <VALUE Lang="GS">7 Honor Award : Top / Bottom (1D), Fine Essence(1)</VALUE>
    <VALUE Lang="GS">10 Honor Award : Special Earrings(1D), +11 Costume(1D), Grind Stone Set(4pieces), Fine Crystal(3), Fine Essence(2)</VALUE>
    <VALUE Lang="GS">15 Honor Award : +11 Costume/Necklace(1D), +11 Shoes/Gloves(7D), Grind Stone Set(6pieces), Fine Crystal(5),</VALUE>
    <VALUE Lang="GS">20 Honor Award : +11 Top/Bottom(7D), Fine Essence(4)</VALUE>
    <VALUE Lang="GS">30 Honor Award : Special Earrings(7D), +11 Costume(7D), Grind Stone Set(12pieces), Fine Crystal(10), Fine Essence(7)</VALUE>
    <VALUE Lang="GS">50 Honor Award : +11 Costume / Necklace(7D), Fine Essence(12)</VALUE>
    <VALUE Lang="GS">*Grind Stone Set : Burr(1), Coating Oil(1), Fine Burr(1), Fine Coating Oil(1)</VALUE>
    <VALUE Lang="id">Kamu bisa memilih hadiah di bawah berdasarkan jumlah medal kamu~</VALUE>
    <VALUE Lang="id">1 Honor Award : CDM Honor Award Random Box (A part of Costume(1D), Grind Stone, Crystal, Essence… etc)</VALUE>
    <VALUE Lang="id">5 Honor Award : Shoes / Gloves(1D), Grindstone Set (2pieces), Fine Crystal(1)</VALUE>
    <VALUE Lang="id">7 Honor Award : Top / Bottom (1D), Fine Essence(1)</VALUE>
    <VALUE Lang="id">10 Honor Award : Special Earrings(1D), +11 Costume(1D), Grind Stone Set(4pieces), Fine Crystal(3), Fine Essence(2)</VALUE>
    <VALUE Lang="id">15 Honor Award : +11 Costume/Necklace(1D), +11 Shoes/Gloves(7D), Grind Stone Set(6pieces), Fine Crystal(5),</VALUE>
    <VALUE Lang="id">20 Honor Award : +11 Top/Bottom(7D), Fine Essence(4)</VALUE>
    <VALUE Lang="id">30 Honor Award : Special Earrings(7D), +11 Costume(7D), Grind Stone Set(12pieces), Fine Crystal(10), Fine Essence(7)</VALUE>
    <VALUE Lang="id">50 Honor Award : +11 Costume / Necklace(7D), Fine Essence(12)</VALUE>
    <VALUE Lang="id">*Grind Stone Set : Burr(1), Coating Oil(1), Fine Burr(1), Fine Coating Oil(1)</VALUE>
    <VALUE Lang="cn">您可根据勋章的数量从清单中选择1个。</VALUE>
    <VALUE Lang="cn">1个Honor Award : CDM Honor Award Random Box (A part of Costume(1D), Grind Stone, Crystal, Essence…其它)</VALUE>
    <VALUE Lang="cn">5个Honor Award : Shoes / Gloves(1D), Grindstone Set (2pieces), Fine Crystal(1)</VALUE>
    <VALUE Lang="cn">7个Honor Award : Top / Bottom (1D), Fine Ess</VALUE>
  </SENTENSE>
