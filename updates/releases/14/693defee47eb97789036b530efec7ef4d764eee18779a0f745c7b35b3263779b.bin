    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Menggunakan Locker Room</VALUE>
    <VALUE Lang="cn">开启置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_human.ntk_2_0">
