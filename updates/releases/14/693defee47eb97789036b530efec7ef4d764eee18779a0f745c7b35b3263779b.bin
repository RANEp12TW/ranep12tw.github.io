    <VALUE Lang="id">Pilih Illusion</VALUE>
    <VALUE Lang="cn">领取技能文书 Illusion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_13">
    <VALUE Lang="GS">Get Scroll of Bacteria</VALUE>
    <VALUE Lang="id">Pilih Bacteria</VALUE>
    <VALUE Lang="cn">领取技能文书 Bacteria</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_14">
    <VALUE Lang="GS">Get Scroll of Pain</VALUE>
    <VALUE Lang="id">Pilih Pain</VALUE>
    <VALUE Lang="cn">领取技能文书 Pain</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_15"><VALUE Lang="tw">兌換 獵魔者（107級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Demon Hunter (Lv107, Class=12288, Item=362/11)</VALUE><VALUE Lang="id">Skill book: Demon Hunter (Lv107, Class=12288, Item=362/11)</VALUE><VALUE Lang="cn">Skill book: Demon Hunter (Lv107, Class=12288, Item=362/11)</VALUE><VALUE Lang="th">Skill book: Demon Hunter (Lv107, Class=12288, Item=362/11)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_16"><VALUE Lang="tw">兌換 隱蔽（127級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Cloaking (Lv127, Class=12288, Item=362/33)</VALUE><VALUE Lang="id">Skill book: Cloaking (Lv127, Class=12288, Item=362/33)</VALUE><VALUE Lang="cn">Skill book: Cloaking (Lv127, Class=12288, Item=362/33)</VALUE><VALUE Lang="th">Skill book: Cloaking (Lv127, Class=12288, Item=362/33)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_17"><VALUE Lang="tw">兌換 心靈感應（107級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Telepathy (Lv107, Class=12288, Item=362/52)</VALUE><VALUE Lang="id">Skill book: Telepathy (Lv107, Class=12288, Item=362/52)</VALUE><VALUE Lang="cn">Skill book: Telepathy (Lv107, Class=12288, Item=362/52)</VALUE><VALUE Lang="th">Skill book: Telepathy (Lv107, Class=12288, Item=362/52)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_18"><VALUE Lang="tw">兌換 火環（127級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Fire Rings (Lv127, Class=130, Item=175/50)</VALUE><VALUE Lang="id">Skill book: Fire Rings (Lv127, Class=130, Item=175/50)</VALUE><VALUE Lang="cn">Skill book: Fire Rings (Lv127, Class=130, Item=175/50)</VALUE><VALUE Lang="th">Skill book: Fire Rings (Lv127, Class=130, Item=175/50)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_19">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_2">
    <VALUE Lang="GS">Get Scroll of Upper Jab</VALUE>
    <VALUE Lang="id">Tukar dengan skill scroll Upper Jab</VALUE>
    <VALUE Lang="cn">获得Upper Jab 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_3">
    <VALUE Lang="GS">Get Scroll of Force Push</VALUE>
    <VALUE Lang="id">Tukar dengan skill scroll Force Push</VALUE>
    <VALUE Lang="cn">获得Force Push 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_4"><VALUE Lang="tw">兌換 能量爆發（127級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Energy Burst (Lv127, Class=130, Item=175/10)</VALUE><VALUE Lang="id">Skill book: Energy Burst (Lv127, Class=130, Item=175/10)</VALUE><VALUE Lang="cn">Skill book: Energy Burst (Lv127, Class=130, Item=175/10)</VALUE><VALUE Lang="th">Skill book: Energy Burst (Lv127, Class=130, Item=175/10)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_5"><VALUE Lang="tw">兌換 迅捷斬（127級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Swift Slash (Lv127, Class=130, Item=175/30)</VALUE><VALUE Lang="id">Skill book: Swift Slash (Lv127, Class=130, Item=175/30)</VALUE><VALUE Lang="cn">Skill book: Swift Slash (Lv127, Class=130, Item=175/30)</VALUE><VALUE Lang="th">Skill book: Swift Slash (Lv127, Class=130, Item=175/30)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_6">
    <VALUE Lang="GS">Get Scroll of Death's Dance</VALUE>
    <VALUE Lang="id">Tukar dengan skill scroll Death's Dance</VALUE>
    <VALUE Lang="cn">获得 Death's Dance 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_7">
    <VALUE Lang="GS">Get Scroll of Phoenix's Wrath</VALUE>
    <VALUE Lang="id">Tukar dengan skill scroll Phoenix's Wrath</VALUE>
    <VALUE Lang="cn">获得Phoenix's Wrath 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_8">
    <VALUE Lang="GS">Get Scroll of Heaven's Judgment</VALUE>
    <VALUE Lang="id">Tukar dengan skill scroll Heaven's Judgment</VALUE>
    <VALUE Lang="cn">获得Heaven's Judgment 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_19_0_9"><VALUE Lang="tw">兌換 長槍之舞（127級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Spear Dance (Lv127, Class=520, Item=176/11)</VALUE><VALUE Lang="id">Skill book: Spear Dance (Lv127, Class=520, Item=176/11)</VALUE><VALUE Lang="cn">Skill book: Spear Dance (Lv127, Class=520, Item=176/11)</VALUE><VALUE Lang="th">Skill book: Spear Dance (Lv127, Class=520, Item=176/11)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_2_0">
    <VALUE Lang="GS">....</VALUE>
    <VALUE Lang="id">....</VALUE>
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_20_0">
    <VALUE Lang="GS">Oh, we meet again…</VALUE>
    <VALUE Lang="GS">So. You want to enter the Head office this time?</VALUE>
    <VALUE Lang="GS">You know students aren't allowed to enter this building. Not only it is the center of a place where time is stopped, but it's also full of dangers.</VALUE>
    <VALUE Lang="GS">Still want to go?</VALUE>
    <VALUE Lang="GS">Okay. Anyway, my friend also expected this.</VALUE>
    <VALUE Lang="GS">Bring the code!</VALUE>
    <VALUE Lang="id">Bertemu lagi…</VALUE>
    <VALUE Lang="id">Iya, kali ini kamu mau masuk ke Kantor pusat?</VALUE>
    <VALUE Lang="id">Itu adalah tempat yang tidak boleh dimasuki oleh para pelajar.</VALUE>
    <VALUE Lang="id">Tempat itu adalah tempat di mana waktu terhenti dan pasti ada banyak hal yang lebih membahayakan…apa kamu masih ingin pergi</VALUE>
    <VALUE Lang="cn">又见面了学生…</VALUE>
    <VALUE Lang="cn">好！这次想进Head office是吗?</VALUE>
    <VALUE Lang="cn">那里是学生不能进的地方。比时间停止中心地更危险的地方… 这样还想去吗?</VALUE>
    <VALUE Lang="cn">那没办法了。那位朋友也预料中的事情…</VALUE>
    <VALUE Lang="cn">去把晶片拿来!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_20_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_21_0">
    <VALUE Lang="GS">You… Do you know what this means?</VALUE>
    <VALUE Lang="GS">Actually, this is not just a code. Although the code number is the simplified access code, you cannot escape from this school. Everything that my friend predicted turned out to be true.</VALUE>
    <VALUE Lang="id">Kamu tahu kan apa artinya menanamkan kode pada tubuh?</VALUE>
    <VALUE Lang="id">Saya tegaskan ini bukanlah kode, ini adalah nomor identifikasi yang disederhanakan</VALUE>
    <VALUE Lang="id">Sekarang kamu sudah tidak bisa melarikan diri lagi</VALUE>
    <VALUE Lang="id">Semuanya…sesuai dengan yang dia perkirakan…saya juga tidak</VALUE>
    <VALUE Lang="cn">同学，知道晶片植入在身上是意味着什么吗?</VALUE>
    <VALUE Lang="cn">严格来说这些不是晶片，只是单纯化的变识编号而已。也就是说学生成了无法逃避的立场。 …都是那朋友预料中的事…我一个人是无法阻挡的。你去找一下影像专家。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_21_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_22_0">
    <VALUE Lang="GS">There are so many Fisherman at there. Please try to eliminate some of them.</VALUE>
    <VALUE Lang="id">Banyak sekali Fisherman di sana, tolong bunuh beberapa dari mereka</VALUE>
    <VALUE Lang="cn">前面有很多渔夫 Fisherman在捣乱，请帮忙将他们消灭。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_3_0">
    <VALUE Lang="GS">Why, hello there!</VALUE>
    <VALUE Lang="GS">I've never seen you before. I'm not sure, though. You came here looking for me? Do you want to talk about the Sacred Financial Group?</VALUE>
    <VALUE Lang="GS">Why? What's wrong? Walking to this area must be tiring, right? I bet you're tired. Take a rest first.</VALUE>
    <VALUE Lang="id">Kamu memberi salam kepada saya?</VALUE>
    <VALUE Lang="id">Saya tidak pernah melihat kamu…</VALUE>
    <VALUE Lang="id">Nggak, mungkin saya pernah melihatnya</VALUE>
    <VALUE Lang="id">Kalau kamu datang mencari saya itu artinya kamu adalah pelajar dari yayasan saint</VALUE>
    <VALUE Lang="id">Bagaimana?</VALUE>
    <VALUE Lang="id">Sulit yah melalui jalan ini?</VALUE>
    <VALUE Lang="id">Ini baru jala</VALUE>
    <VALUE Lang="cn">你跟我打招呼吗?</VALUE>
    <VALUE Lang="cn">但我没看过你…</VALUE>
    <VALUE Lang="cn">不是，我搞不清楚到底有没有看过你。</VALUE>
    <VALUE Lang="cn">而且，来找我的话，一定是圣财团学院的学生。</VALUE>
    <VALUE Lang="cn">怎么样?</VALUE>
    <VALUE Lang="cn">在这街上跑会累吗?</VALUE>
    <VALUE Lang="cn">这样只不过是散步的程度，也会累吗?</VALUE>
    <VALUE Lang="cn">我看是运动不够啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_3_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_4_0">
    <VALUE Lang="GS">Did you see the Freezing Warehouse over there? There is also a Water Purification Center before in that area. I heard that it performed basic water purification processes.</VALUE>
    <VALUE Lang="GS">Can you go there and check if the Purification activities are still operational?</VALUE>
    <VALUE Lang="id">Ice warehouse yang terlihat disana…atau mungkin cold warehouse?</VALUE>
    <VALUE Lang="id">Kalau kamu pergi ke bagian tengahnya kamu bisa menemukan tempat yang dulu dipakai sebagai Water Purification</VALUE>
    <VALUE Lang="id">Katanya pemurnian dasar memang dilakukan…</VALUE>
    <VALUE Lang="id">Coba tolong periksa apakah berg</VALUE>
    <VALUE Lang="cn">那边看到的那些Freezing Warehouse… 嗯，是冷冻仓库吗?</VALUE>
    <VALUE Lang="cn">往中间看的话，那里以前是Water Purification Center 净水场。</VALUE>
    <VALUE Lang="cn">听说可以维持基本的净化功能…</VALUE>
    <VALUE Lang="cn">去确认一下能不能正常运作。</VALUE>
    <VALUE Lang="cn">那里有个放瓶子的地方，去找找看，我想确认水质。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_5_0">
    <VALUE Lang="GS">Too late!</VALUE>
    <VALUE Lang="GS">How could you spend so much time looking for just one bottle? You already look so tired. There's still a long, long way to go!</VALUE>
    <VALUE Lang="id">Telat rupanya</VALUE>
    <VALUE Lang="id">Bawa botol satu saja kenapa lama sekali seperti ini?</VALUE>
    <VALUE Lang="id">Ditambah lagi saya sudah susah bernafas</VALUE>
    <VALUE Lang="id">Masih jauh rupanya…jauh</VALUE>
    <VALUE Lang="cn">迟了呀。</VALUE>
    <VALUE Lang="cn">虽然找了一个瓶子来，但怎么那么慢呢?</VALUE>
    <VALUE Lang="cn">而且还喘呼呼的…</VALUE>
    <VALUE Lang="cn">还差得远啊…差得远啊</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_6_0">
    <VALUE Lang="GS">Something seems to be wrong with the Water Purification Center's facilities. The generator is unable to function properly.</VALUE>
    <VALUE Lang="GS">Go and get the spare parts for the generator that you can find at the No.2 Wharf. Also, go and find another empty bottle to replace the one you just gave me.</VALUE>
    <VALUE Lang="id">Water purification sedang tidak berjalan dengan lancar</VALUE>
    <VALUE Lang="id">Kalau dilihat dari warehous yang aneh kayaknya ada masalah di generator</VALUE>
    <VALUE Lang="id">Hei!</VALUE>
    <VALUE Lang="id">Kamu pergi ke sana terus cari Generator parts yang bisa dipakai untuk memperbaiki generator</VALUE>
    <VALUE Lang="id">Kamu bisa menemukan</VALUE>
    <VALUE Lang="cn">净水场Water Purification Center好像并未正常运作。</VALUE>
    <VALUE Lang="cn">仓库那里也怪怪的，发电机有问题…</VALUE>
    <VALUE Lang="cn">学生!</VALUE>
    <VALUE Lang="cn">去找一下能修理发电机的零附件。</VALUE>
    <VALUE Lang="cn">去停泊在No.2 Wharf的货轮甲板上可找的到。</VALUE>
    <VALUE Lang="cn">之后再找一个空瓶回来。把它放回刚才拿回的那个空瓶的位置。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_6_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_7_0">
    <VALUE Lang="GS">What?</VALUE>
    <VALUE Lang="GS">How am I going to deal with your carelessness?</VALUE>
    <VALUE Lang="GS">Nevertheless, I have to pay you since you did some work for me.</VALUE>
    <VALUE Lang="id">Berkeliaran di mana kamu….</VALUE>
    <VALUE Lang="id">Kalau lambat begini bagaimana bisa saya suruh kerja!</VALUE>
    <VALUE Lang="id">Karena sudah menyuruh bekerja saya harus memberikan gaji tapi ini..</VALUE>
    <VALUE Lang="cn">你到哪里去了…</VALUE>
    <VALUE Lang="cn">因为吆喝事情，所以才慢的呀!</VALUE>
    <VALUE Lang="cn">吆喝事情总要给点酬劳吧，但是这个才</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_8_0">
    <VALUE Lang="GS">Something strange is going to happen soon!</VALUE>
    <VALUE Lang="GS">The series of events that occurred in the Management Office of the Green Gangster Headquarters will lead us to disaster. I heard that these vile individuals have an evil plan. This makes me feel so worried.</VALUE>
    <VALUE Lang="GS">The cassette tape recording of the situation that occurred in that office can be acquired in the Management Offices. Please help me steal it so we can further investigate their dastardly deeds.</VALUE>
    <VALUE Lang="id">Sesaat sebelum bencana itu terjadi…</VALUE>
    <VALUE Lang="id">Orang-orang yang berpakaian seperti kamu tiba-tiba menyerang Kantor administrasi dan memulai pertarungan dengan preman-preman yang berjaga di sana</VALUE>
    <VALUE Lang="id">Orang-orang dari komplotan Red Axe</VALUE>
    <VALUE Lang="id">Memang sih dia berandalan ta</VALUE>
    <VALUE Lang="cn">是异变发生之前…</VALUE>
    <VALUE Lang="cn">穿着和学生类似校服的年轻人们往那里的管理办公室建筑物猛撞，随即开始和管理这里的流氓打架。</VALUE>
    <VALUE Lang="cn">是一群叫青的家伙…</VALUE>
    <VALUE Lang="cn">虽然是流氓，但交待的事情比学生还做的好!</VALUE>
    <VALUE Lang="cn">但是， 打架的原则是在彼此实力差不多的状况。学生事情做不好，打人倒蛮会的…</VALUE>
    <VALUE Lang="cn">那个不是打架，是暴行。</VALUE>
    <VALUE Lang="cn">话说回来…在打架中学生们被推了出去，结果却说是逃跑。</VALUE>
    <VALUE Lang="cn">怎么会那样呢?</VALUE>
    <VALUE Lang="cn">而且，异变开始了。动物都疯了，人们则失去理性…</VALUE>
    <VALUE Lang="cn">学生也是从以前开始，听命行事。虽是预料的事，但比预定的时间提早许多。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_9_0">
    <VALUE Lang="GS">That's the video cassette! I hope we can get something substantial in the video for our investigation.</VALUE>
    <VALUE Lang="id">Dan ini adalah tape itu</VALUE>
    <VALUE Lang="id">Tapi dengan keadaan seperti ini…</VALUE>
    <VALUE Lang="cn">这是那卷带子啊…</VALUE>
    <VALUE Lang="cn">但是，这种状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_9_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_0">
    <VALUE Lang="GS">Oh! Students are finally able to access this area! How was your journey? It's dangerous to be in the streets during these times.</VALUE>
    <VALUE Lang="GS">I hope you're here to help.</VALUE>
    <VALUE Lang="id">Hei</VALUE>
    <VALUE Lang="id">Apakah yang asli?</VALUE>
    <VALUE Lang="id">Apakah hanya satu orang yang ada?</VALUE>
    <VALUE Lang="cn">噢！学生们终于进入此地了！一路辛苦了，过得好吗？现在其实走在街道上还是很危险….我希望各位可以伸手相助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_0_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_1">
    <VALUE Lang="GS">Oh! Students are finally able to access this area! How was your journey? It's dangerous to be in the streets during these times.</VALUE>
    <VALUE Lang="GS">I hope you're here to help.</VALUE>
    <VALUE Lang="id">Hei</VALUE>
    <VALUE Lang="id">Apakah yang asli?</VALUE>
    <VALUE Lang="id">Apakah hanya satu orang yang ada?</VALUE>
    <VALUE Lang="cn">噢！学生们终于进入此地了！一路辛苦了，过得好吗？现在其实走在街道上还是很危险….我希望各位可以伸手相助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_1_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_2">
    <VALUE Lang="GS">Oh! Students are finally able to access this area! How was your journey? It's dangerous to be in the streets during these times.</VALUE>
    <VALUE Lang="GS">I hope you're here to help.</VALUE>
    <VALUE Lang="id">Hei</VALUE>
    <VALUE Lang="id">Apakah yang asli?</VALUE>
    <VALUE Lang="id">Apakah hanya satu orang yang ada?</VALUE>
    <VALUE Lang="cn">噢！学生们终于进入此地了！一路辛苦了，过得好吗？现在其实走在街道上还是很危险….我希望各位可以伸手相助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_2_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_3">
    <VALUE Lang="GS">Oh! Students are finally able to access this area! How was your journey? It's dangerous to be in the streets during these times.</VALUE>
    <VALUE Lang="GS">I hope you're here to help.</VALUE>
    <VALUE Lang="id">Hei</VALUE>
    <VALUE Lang="id">Apakah yang asli?</VALUE>
    <VALUE Lang="id">Apakah hanya satu orang yang ada?</VALUE>
    <VALUE Lang="cn">噢！学生们终于进入此地了！一路辛苦了，过得好吗？现在其实走在街道上还是很危险….我希望各位可以伸手相助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_3_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_4">
    <VALUE Lang="GS">My dear student, please accept my request.</VALUE>
    <VALUE Lang="GS">I need your help on this.</VALUE>
    <VALUE Lang="id">Hei</VALUE>
    <VALUE Lang="id">Apakah yang asli?</VALUE>
    <VALUE Lang="id">Apakah hanya satu orang yang ada?</VALUE>
    <VALUE Lang="cn">我亲爱的学生，请接受我的请求。这件事情我急需您的相助！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_4_1">
    <VALUE Lang="GS">Ask What's the Problem</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">询问是什么问题？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_4_2">
    <VALUE Lang="GS">Give the Night Sticks</VALUE>
    <VALUE Lang="id">Menyerahkan stick</VALUE>
    <VALUE Lang="cn">交付 Night Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_4_3">
    <VALUE Lang="GS">Give the Night Sticks</VALUE>
    <VALUE Lang="id">Menyerahkan stick</VALUE>
    <VALUE Lang="cn">交付 Night Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_4_4">
    <VALUE Lang="GS">Give the Night Sticks</VALUE>
    <VALUE Lang="id">Menyerahkan stick</VALUE>
    <VALUE Lang="cn">交付 Night Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_4_5">
    <VALUE Lang="GS">Give the Night Sticks</VALUE>
    <VALUE Lang="id">Menyerahkan stick</VALUE>
    <VALUE Lang="cn">交付 Night Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_4_6">
    <VALUE Lang="GS">Give the Night Sticks</VALUE>
    <VALUE Lang="id">Menyerahkan stick</VALUE>
    <VALUE Lang="cn">交付 Night Stick</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_4_7">
    <VALUE Lang="GS">Ask What's the Problem</VALUE>
    <VALUE Lang="id">Bertanya apa yang terjadi</VALUE>
    <VALUE Lang="cn">询问是什么问题？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_1_4_8">
    <VALUE Lang="GS">Deliver Guard Rods</VALUE>
    <VALUE Lang="id">Antarkan Guard Rods</VALUE>
    <VALUE Lang="cn">把Rods交给警卫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_10_0">
    <VALUE Lang="GS">Originally I was doing some clerical work for Leonair Campus Laboratory. Sadly, not long ago, a war broke out here.</VALUE>
    <VALUE Lang="GS">I came here to offer some support.</VALUE>
    <VALUE Lang="id">Asalnya saya bekerja di Research Complex di Leonine School, beberapa waktu yang lalu katanya ada pertarungan besar di daerah sini jadi saya pindah tugas ke sini</VALUE>
    <VALUE Lang="cn">我原是Leonair Campus Laboratory 的教职员工。但不幸这里最近爆发战争，所以我来给您援助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_11_0">
    <VALUE Lang="GS">Hmmm...</VALUE>
    <VALUE Lang="GS">As soon as I arrived here, I saw this super strong light beam shooting out at me, and then I fainted. I woke up a few days after, looked down at my hands</VALUE>
    <VALUE Lang="id">Saya pingsan begitu sampai ke tempat ini setelah melihat seberkas cahaya yang naik di sekitar sini dan baru tersadar beberapa hari yang lalu.</VALUE>
    <VALUE Lang="id">Eh ternyata di tangan saya ada pisau yang dipenuhi dengan darah…</VALUE>
    <VALUE Lang="cn">嗯….当我到达后，看到了一道强光束猛射上来，结果我就晕倒了。几天后，我醒来看见我的双手……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_11_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_12_0">
    <VALUE Lang="GS">I had no clue who the hell I killed. I can't remember. And now, I started seeing these mobsters that look exactly like me!</VALUE>
    <VALUE Lang="id">Kayaknya dia membunuh seseorang..sialan!</VALUE>
    <VALUE Lang="id">Yang lebih konyol lagi saya sudah melihat secara langsung makhluk-makhluk yang wujudnya sama persis seperti saya</VALUE>
    <VALUE Lang="cn">我完全没办法知道哪个天杀的是被我杀死的。记不起来…..而现在，我还看见了许多怪人和我长得一模一样！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_12_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_13_0">
    <VALUE Lang="GS">I hear from passersby that a bunch of clones patrol the Sacred Hole area.</VALUE>
    <VALUE Lang="id">Saya dengar dari orang-orang yang lewat kemari katanya mereka berkerumun di daerah SG_Town</VALUE>
    <VALUE Lang="id">Gila tidak tuh?</VALUE>
    <VALUE Lang="cn">我听路人说，那些复制人总是群体围绕着Sacred Hole。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_14_0">
    <VALUE Lang="GS">Look at me! Do I look like a violent individual?</VALUE>
    <VALUE Lang="GS">I'd never do anything like that. It did feel like something weird happened… Like, maybe I was possessed or something.</VALUE>
    <VALUE Lang="id">Kenyataan bahwa seseorang yang sama dengan saya sedang mengganggu orang-orang…</VALUE>
    <VALUE Lang="id">Saya juga mungkin seperti ini….</VALUE>
    <VALUE Lang="cn">看看我！我长得很暴力吗？我没做过那些事情，不过，我感觉好像有可怕的事情要发生了…..可能我会被附身……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_15_0">
    <VALUE Lang="GS">....5</VALUE>
    <VALUE Lang="id">....5</VALUE>
    <VALUE Lang="cn">....5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_16_0">
    <VALUE Lang="GS">Sometimes I go into a sudden trance!</VALUE>
    <VALUE Lang="GS">I'm worried that I might kill another person against my will again...</VALUE>
    <VALUE Lang="id">Saya khawatir kalau tidak melakukan sesuatu tiba-tiba saya hilang kesadaran terus membunuh seseorang lagi</VALUE>
    <VALUE Lang="cn">有时候我会幌神，我担心我又会去杀人…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_16_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_17_0">
    <VALUE Lang="GS">.....6</VALUE>
    <VALUE Lang="id">.....6</VALUE>
    <VALUE Lang="cn">.....6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_18_0">
    <VALUE Lang="GS">Are there any other students who came here to help?</VALUE>
    <VALUE Lang="id">Kamu bisa yakin bahwa hanya ada kamu satu di dunia ini?</VALUE>
    <VALUE Lang="cn">有其他学生来这儿请求帮忙吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_18_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_2_0">
    <VALUE Lang="GS">....</VALUE>
    <VALUE Lang="id">....</VALUE>
    <VALUE Lang="cn">.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_3_0">
    <VALUE Lang="GS">Oh! Please, please help me take care of the mobsters that look exactly like me!</VALUE>
    <VALUE Lang="GS">By taking away whatever weapons you find from them, you can help eliminate crime from the streets.</VALUE>
    <VALUE Lang="id">Saya mohon tolong lakukan sesuatu pada orang-orang yang berwajah sama dengan saya itu</VALUE>
    <VALUE Lang="id">Seoerti yang kamu lihat senjata saya direbut</VALUE>
    <VALUE Lang="cn">噢！拜托，请帮忙处理一下那些长得跟我很像的歹徒！他们身上的武器全部都要没收！如此一来，您的打击犯罪，将会使街道变的更干净了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_3_0_2">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_3_0_3">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_3_0_4">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_3_0_5">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_3_0_6">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_3_0_7">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Terima Pesan</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_3_0_8">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_4_0">
    <VALUE Lang="GS">I am very sorry for causing you so much trouble. I just want to clean up the image of the Police Department, give it the respect it deserves. Those mobsters dressed like us to bring disgrace to the police.</VALUE>
    <VALUE Lang="id">Saya minta tolong yah</VALUE>
    <VALUE Lang="id">Tolong musnahkan diri saya yang lain sebanyak-banyaknya</VALUE>
    <VALUE Lang="cn">真的很抱歉给您带来许多麻烦。我只是想要帮忙Police Department营造新的形象。请敬仰他们，他们是值得的！那些歹徒穿着跟我们很像，但总是行动恶劣，使我们警察感到丢脸！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_4_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_5_0">
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="GS">I feel better now. Once again, the good image of the Police Department was restored.</VALUE>
    <VALUE Lang="id">Terimakasih</VALUE>
    <VALUE Lang="id">Seperti mengurangi sedikit beban saya</VALUE>
    <VALUE Lang="id">Tapi….</VALUE>
    <VALUE Lang="id">Kadang saya berpikir bahwa saya juga adalah bagian dari diri saya yang sama.</VALUE>
    <VALUE Lang="cn">太谢谢您了！我的感觉好多了。再声明一次，警察局的良好形象已经恢复的差不多了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_5_0_2">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_6_0">
    <VALUE Lang="GS">These vile mobsters dressed like Police Department Officers are causing havoc in the streets.</VALUE>
    <VALUE Lang="GS">People tend to think that the Police Department has become part of the evil Green Organization.</VALUE>
    <VALUE Lang="id">Pernahkah kamu melihat orang yang serupa dengan kamu?</VALUE>
    <VALUE Lang="id">Ini masalah yang berbeda dengan orang-orang yang serupa</VALUE>
    <VALUE Lang="id">Kalau ada satu orang saja, di tempat lain pasti ada berpuluh-puluh</VALUE>
    <VALUE Lang="cn">这些卑鄙的怪人穿着像Police Department Officers，且正在街道上进行各种大破坏。人们都以为警察已经被感染成怪物了呢！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_6_0_2">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_7_0">
    <VALUE Lang="GS">Am I confusing you?</VALUE>
    <VALUE Lang="GS">I am sorry, this stuff… I doubt you're interested in it. Anyway, I'm very thankful that students like you are here to help.</VALUE>
    <VALUE Lang="id">Saya mau minta tolong tapi…</VALUE>
    <VALUE Lang="id">Sepertinya ini tidak mungkin untuk kamu</VALUE>
    <VALUE Lang="cn">我害您搞混了吗？对不起啊….。这东西，我想您可能不会喜欢，但我真的很感激像您这样热心的学生前来援助。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_7_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_8_0">
    <VALUE Lang="GS">.....3</VALUE>
    <VALUE Lang="id">.....3</VALUE>
    <VALUE Lang="cn">.....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_9_0">
    <VALUE Lang="GS">I am a Guard destined to patrol the Sacred Financial Group facilities.</VALUE>
    <VALUE Lang="GS">My designation here still remains the same.</VALUE>
    <VALUE Lang="id">Saya adalah penjaga yang ditempatkan di setiap fasilitas administrasi yayasan saint</VALUE>
    <VALUE Lang="id">Sekarang juga asalnya tidak berubah tapi…</VALUE>
    <VALUE Lang="cn">我注定一辈子要在Sacred Financial Group facilities 里担任巡逻警卫。这个称号一直都是一样的唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_pguard1.ntk_9_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0">
    <VALUE Lang="GS">This building is currently under supervision.</VALUE>
    <VALUE Lang="GS">It's great to see students like you that are here to help!</VALUE>
    <VALUE Lang="id">Gedung ini dalam pengawasan. Sangat senang melihat kamu berada di sini untuk menolong.</VALUE>
    <VALUE Lang="cn">这栋大楼被监管中。</VALUE>
    <VALUE Lang="cn">因为您的乐善好施，学生们都喜欢您，真是太好了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">变更开始地点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0_10">
    <VALUE Lang="GS">Give the Document</VALUE>
    <VALUE Lang="id">Menyerahkan dokumen</VALUE>
    <VALUE Lang="cn">传达文件</VALUE>
  </SENTENSE>
