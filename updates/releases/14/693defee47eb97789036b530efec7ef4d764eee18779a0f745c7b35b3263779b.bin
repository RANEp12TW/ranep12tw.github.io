  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_6">
    <VALUE Lang="GS">Whoa! What a sturdy looking student you are!</VALUE>
    <VALUE Lang="GS">Hmm, what is wrong with your clothes though?</VALUE>
    <VALUE Lang="GS">A student must wear something proper.</VALUE>
    <VALUE Lang="GS">It's your lucky day!</VALUE>
    <VALUE Lang="GS">I have just prepared something, why don't you go get it?</VALUE>
    <VALUE Lang="GS">Consider it as a present from an old man!</VALUE>
    <VALUE Lang="id">Ehe!</VALUE>
    <VALUE Lang="id">Kamu kelihatan kuat sekali!</VALUE>
    <VALUE Lang="id">Pakaian apa yang kamu pakai itu?</VALUE>
    <VALUE Lang="id">Yang namanya orang itu harus memakai pakaian yang cocok</VALUE>
    <VALUE Lang="id">Kebetulan ada yang sudah saya siapkan pergi dan carilah</VALUE>
    <VALUE Lang="cn">哇!</VALUE>
    <VALUE Lang="cn">身体看起来相当的强壮!</VALUE>
    <VALUE Lang="cn">可是衣服怎么穿成那样?</VALUE>
    <VALUE Lang="cn">佛要金装,人要衣装才可以,</VALUE>
    <VALUE Lang="cn">刚好我有帮你准备了,你去找一下拿去穿吧.</VALUE>
    <VALUE Lang="cn">就当作是老人家送给你的礼物吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_1_6_1">
    <VALUE Lang="GS">Listen to his story</VALUE>
