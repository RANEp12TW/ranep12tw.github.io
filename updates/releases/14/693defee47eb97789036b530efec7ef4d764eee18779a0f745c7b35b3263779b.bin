  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_1_0">
    <VALUE Lang="GS">Do you want to get skill scrolls? Haha, I don't take such trivial filth stuffs for 9th grade or below.</VALUE>
    <VALUE Lang="id">Apakah kamu ingin mendapatkan skill scroll? Haha, Saya tidak menyediakan untuk tingkat 9 ke bawah.</VALUE>
    <VALUE Lang="cn">您想要领取“技能文书”吗？哈哈，我这个人决不接受9等级和9级以下的申请唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_1_0_1">
    <VALUE Lang="GS">Exchange to 10th Grade of Spirit Sphere</VALUE>
    <VALUE Lang="id">Tukar dengan 10th Grade Spirit Sphere</VALUE>
    <VALUE Lang="cn">兑换10等级的Spirit Sphere。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_extreme.ntk_1_0_10">
    <VALUE Lang="GS">Exchange to 21st Grade of Spirit Sphere</VALUE>
    <VALUE Lang="id">Tukar dengan 21st Grade Spirit Sphere</VALUE>
