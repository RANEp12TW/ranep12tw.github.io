  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_62">
    <VALUE Lang="GS">Deliver Proposal. [Please deliver proposal]</VALUE>
    <VALUE Lang="id">Mengantar Proposal. [Tolong kirim Proposal]</VALUE>
    <VALUE Lang="cn">传递意见书 [请传递意见书]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_63">
    <VALUE Lang="GS">Tell that you need Oblivion Potion.</VALUE>
    <VALUE Lang="id">Beritahu bahwa kamu memerlukan Oblivion Potion.</VALUE>
    <VALUE Lang="cn">告知您需要忘却药水</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_64">
    <VALUE Lang="GS">Tell that you will get the Murakano Blood Sample.</VALUE>
    <VALUE Lang="id">Beritahu bahwa kamu akan mendapatkan Murakano Blood Sample.</VALUE>
    <VALUE Lang="cn">告知您会拿到Murakano的血液标本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_65">
    <VALUE Lang="GS">Tell that you will deliver the Expedition Participation Letter.</VALUE>
    <VALUE Lang="id">Katakan bahwa kamu akan mengantar Expedition Participation Letter.</VALUE>
    <VALUE Lang="cn">告诉他您会传达Expedition Participation Letter。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_66">
    <VALUE Lang="GS">Receive the Request.</VALUE>
    <VALUE Lang="id">Menerima Permintaan.</VALUE>
    <VALUE Lang="cn">接受请托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_67">
    <VALUE Lang="GS">Receive the Request collecting Amanuoruoyin's cure medicine.</VALUE>
    <VALUE Lang="id">Terima permintaan untuk mengumpulkan Amanuoruoyin's cure medicine.</VALUE>
    <VALUE Lang="cn">答应接受收集Amanuoruoyin的医疗药物任务。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_68">
    <VALUE Lang="GS">Receive the First Mission.</VALUE>
    <VALUE Lang="id">Menerima First Mission.</VALUE>
    <VALUE Lang="cn">接受第一项任务</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_7">
    <VALUE Lang="GS">Accept Confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">接受确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_8">
    <VALUE Lang="GS">Accept Confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">接受确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_13_9">
    <VALUE Lang="GS">Accept Confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">接受确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_2">
    <VALUE Lang="GS">You're back. Let's see how many you collected.</VALUE>
    <VALUE Lang="id">Sudah kembali rupanya, saya harus lihat seberapa banyak kamu mengumpulkan genuine parts</VALUE>
    <VALUE Lang="cn">您回来了。让我看看您收集了多少回来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_2_1">
    <VALUE Lang="GS">Deliver Proposal</VALUE>
    <VALUE Lang="id">Serahkanlah Letter of Opinion</VALUE>
    <VALUE Lang="cn">传递意见书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_2_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_3">
    <VALUE Lang="GS">Already analyzed?</VALUE>
    <VALUE Lang="id">Sudah selesai menganalisisnya lagi?</VALUE>
    <VALUE Lang="cn">已经分析完了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_3_1">
    <VALUE Lang="GS">Deliver Proposal</VALUE>
    <VALUE Lang="id">Serahkanlah Letter of Opinion</VALUE>
    <VALUE Lang="cn">传递意见书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_3_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_4">
    <VALUE Lang="GS">What is this? Who gave it to you?</VALUE>
    <VALUE Lang="id">Ini apa? Siapa yang memberikannya sama kamu?</VALUE>
    <VALUE Lang="cn">这是什么？是谁给您的？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_4_1">
    <VALUE Lang="GS">Tell the Results</VALUE>
    <VALUE Lang="id">Memberitahukan hasil</VALUE>
    <VALUE Lang="cn">告知结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_4_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_5">
    <VALUE Lang="GS">You're now at half power, stronger than you were before. Remember that you've only managed to tap into half of your potential, though.</VALUE>
    <VALUE Lang="id">Kekuatan kamu sudah berkembang setengahya? Kamu memang lebih kuat daripada pelajar sebelumnya, tapi ingat kekuatan kamu baru sampai setengah saja</VALUE>
    <VALUE Lang="cn">现在只累积了一半的力量。虽然看起来比以前的学生强壮，但是您要记住！您只有一半的力量而已。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_5_1">
    <VALUE Lang="GS">Tell the Results</VALUE>
    <VALUE Lang="id">Memberitahukan hasil</VALUE>
    <VALUE Lang="cn">告知结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_5_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_6">
    <VALUE Lang="GS">I didn't receive the confirmation document.</VALUE>
    <VALUE Lang="id">Setelah sekian lama baru sekarang dapat surat konfirmasi lagi</VALUE>
    <VALUE Lang="cn">我没收到文件的确认。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_6_1">
    <VALUE Lang="GS">Tell the Results</VALUE>
    <VALUE Lang="id">Memberitahukan hasil</VALUE>
    <VALUE Lang="cn">告知结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_6_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_7">
    <VALUE Lang="GS">Hm, you still can't. Please give this letter to Lee Zhen.</VALUE>
    <VALUE Lang="id">Sudah nggak bisa lagi. Sampaikan letter ini pada Louis</VALUE>
    <VALUE Lang="cn">嗯，您还是不行。请把这封信交给Lee Zhen.。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_7_1">
    <VALUE Lang="GS">Accept</VALUE>
    <VALUE Lang="id">Menerima latter</VALUE>
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_7_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_8">
    <VALUE Lang="GS">The students are acting weird recently. Can you help me check what happened?</VALUE>
    <VALUE Lang="id">Sejak beberapa waktu yang lalu para pelajar memperlakukan saya dengan aneh. Bagaimana permintaan saya kemarin? Sebenarnya ada apa sieh?</VALUE>
    <VALUE Lang="cn">最近学生对我的态度很奇怪，您能帮我查查是发生了啥事吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_8_1">
    <VALUE Lang="GS">Accept</VALUE>
    <VALUE Lang="id">Menerima latter</VALUE>
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_8_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_9">
    <VALUE Lang="GS">This ancient item... This special sphere... Can I try to use it? I've never tried before...</VALUE>
    <VALUE Lang="id">Ini kayaknya pusaka untuk bone sphere spesial. Berikan pusaka ini pada saya terus kamu coba gunakan bone sphere spesial itu, gimana? Dulu nggak bisa digunakan…mungkin…</VALUE>
    <VALUE Lang="cn">这个古老的物品......这个特殊的东西......我可以试试看吗？？我从来没有尝试过这东西…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_9_1">
    <VALUE Lang="GS">Ancient Item Confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi Ancient Treasure</VALUE>
    <VALUE Lang="cn">确认古文物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_9_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_10_0">
    <VALUE Lang="GS">Wow...Lee Zhen showed up! That was so bad!</VALUE>
    <VALUE Lang="id">Begitu yah…Louis sudah muncul rupanya….ini bisa jadi masalah besar</VALUE>
    <VALUE Lang="cn">哇...Lee Zhen现身了！大事不妙了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_10_0_1">
    <VALUE Lang="GS">Ask about Problem</VALUE>
    <VALUE Lang="id">Bertanya ada apa?</VALUE>
    <VALUE Lang="cn">询问有什么问题</VALUE>
  </SENTENSE>
