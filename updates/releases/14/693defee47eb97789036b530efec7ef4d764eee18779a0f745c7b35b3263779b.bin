    <VALUE Lang="GS">''Vital Sword' Spirit Type</VALUE>
    <VALUE Lang="id">Vital Sword yang berhubungan dengan INT</VALUE>
    <VALUE Lang="cn">'Vital Sword' 精神型</VALUE>
  </SENTENSE>
