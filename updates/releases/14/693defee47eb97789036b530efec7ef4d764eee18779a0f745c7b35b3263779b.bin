  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_19">
    <VALUE Lang="GS">Report Result</VALUE>
    <VALUE Lang="id">Melaporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_2">
    <VALUE Lang="GS">Ask why he is staying here</VALUE>
    <VALUE Lang="id">Bertanya alasan berada di sini</VALUE>
    <VALUE Lang="cn">询问为何一直呆在这儿</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_20">
    <VALUE Lang="GS">Report Result</VALUE>
    <VALUE Lang="id">Melaporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_21">
    <VALUE Lang="GS">Report Result</VALUE>
    <VALUE Lang="id">Melaporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_22">
    <VALUE Lang="GS">Report Result</VALUE>
    <VALUE Lang="id">Melaporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_23">
    <VALUE Lang="GS">Tell him you want to know more about him</VALUE>
    <VALUE Lang="id">Mengatakan kalau kamu ingin tahu lebih jauh tentang Evilplate Monk</VALUE>
    <VALUE Lang="cn">告诉他，您想知道更多关于他的事情。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_24">
    <VALUE Lang="GS">Girl without a news</VALUE>
    <VALUE Lang="id">Gadis tanpa kabar</VALUE>
    <VALUE Lang="cn">毫无音讯的少女</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_25">
    <VALUE Lang="GS">Deliver the letter</VALUE>
    <VALUE Lang="id">Memberikan letter</VALUE>
    <VALUE Lang="cn">传递信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_26">
    <VALUE Lang="GS">Kill Wild species</VALUE>
    <VALUE Lang="id">Singkirkan Wild Species</VALUE>
    <VALUE Lang="cn">消灭 Wild species</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_27">
    <VALUE Lang="GS">Tell the result</VALUE>
    <VALUE Lang="id">Beritahukan Hasilnya</VALUE>
    <VALUE Lang="cn">告诉结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_3">
    <VALUE Lang="GS">Ask if he needs help with anything</VALUE>
    <VALUE Lang="id">Bertanya apa ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">询问是否需要任何协助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_4">
    <VALUE Lang="GS">Report Result</VALUE>
    <VALUE Lang="id">Melaporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_5">
    <VALUE Lang="GS">Ask if he needs help with anything</VALUE>
    <VALUE Lang="id">Bertanya apa ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">询问是否需要任何协助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_6">
    <VALUE Lang="GS">Tell him what you have heard</VALUE>
    <VALUE Lang="id">Mengatakan kenyataan yang sudah kamu dengar</VALUE>
    <VALUE Lang="cn">转达您听到的消息</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_7">
    <VALUE Lang="GS">Ask if he wants him to do anything</VALUE>
    <VALUE Lang="id">Bertanya apakah ada hal yang harus dilakukan</VALUE>
    <VALUE Lang="cn">询问是否他希望为自己做点什么？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_8">
    <VALUE Lang="GS">Deliver the First Aid Medicine</VALUE>
    <VALUE Lang="id">Menyerahkan First Aid</VALUE>
    <VALUE Lang="cn">传达急救药品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_1_0_9">
    <VALUE Lang="GS">Hear his story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita dari Evilplate Monk</VALUE>
    <VALUE Lang="cn">聆听他的故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_10_0">
    <VALUE Lang="GS">Oh.. Don't bother.. You already know that some people have been chasing us, right? Well, it doesn't implicate that we did something very bad. We just have different perspectives. I think behavior is what makes the good or bad, not a single person should be judged as good or bad. Being chased isn't such a great feeling though.. haha</VALUE>
    <VALUE Lang="id">A, nggak usah dipikirkan…tahu kan kalau kami diburu oleh seseorang? Tapi bukan berarti kami melakukan sesuatu hal yang buruk. Hanya saja kita mempunyai cara berpikir yang berbeda. Menurut saya baik dan buruk hanya bisa dilihat dari kelakuan yang dilakukan</VALUE>
    <VALUE Lang="cn">噢，您已经知道有不少人在追捕我们了，是吧？不过，这不代表我们做了不光彩的事情，而仅是各自的眼光与想法不同罢了。我相信事出必有因，善恶的判定是见仁见智。话说回来，一直被追捕的感觉，还真不舒服呢！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_10_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_11_0">
    <VALUE Lang="GS">It's not a difficult task. Go tell Suah that she doesn't have to worry about the pursuers anymore and I need more medicine because Obi nine's condition has gotten worse. Also, captain is doing fine so tell her not to cry.. hahaha.. I can imagine her worrying her butt off.</VALUE>
    <VALUE Lang="id">Ini tidak sulit. Tolong sampaikan pada Suah kalau kita membutuhkan obat-obatan karena gejala Ovinine semakin memburuk dan dia tidak perlu khawatir lagi tentang orang-orang yang memburu kami. Terus bilang sama dia jangan menangis dan nggak perlu khawatir t</VALUE>
    <VALUE Lang="cn">这件任务并不难，告诉Suah不要再担心追捕者的事情。另外，我需要更多的急救药品。因为Obi nine的状况越来越不乐观。还有，队长没有受伤，请Suah不要再哭了。哈哈哈…我可以想象得到Suah紧张如热锅上的蚂蚁似的表情了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_11_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_12_0">
    <VALUE Lang="GS">What a load off.. Thank you for your help..</VALUE>
    <VALUE Lang="id">Sekarang saya sedikit tenang…terimakasih yah sudah membantu</VALUE>
    <VALUE Lang="cn">真是太令人心安了。非常感激您的帮忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_12_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_13_0">
    <VALUE Lang="GS">…</VALUE>
    <VALUE Lang="id">…</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_14_0">
    <VALUE Lang="GS">There is a letter to Suah, please just give it to her without saying anything. She is very shy so be cautious. Also, you should not open it, ok? HaHa</VALUE>
    <VALUE Lang="id">Ada letter yang ingin saya sampaikan pada Suah, kalau kamu ketemu dia jangan bilang apa-apa dan langsung serahkan saja. Dia pemalu jadi kamu harus hati-hati. Ah, jangan sampai kamu buka surat ini yah! Haha</VALUE>
    <VALUE Lang="cn">这封信是要给Suah的。Suah很害羞，所以不要解释太多，只要安静地，把这封信交给她就可以。还有，您不可以打开偷看唷。知道吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_14_0_1">
    <VALUE Lang="GS">Tell him you will deliver it</VALUE>
    <VALUE Lang="id">Mengatakan kalau kamu akan menyampaikan letter tersebut</VALUE>
    <VALUE Lang="cn">告诉他，您会帮忙转达的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_14_0_2">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Mengatakan kalau kamu tidak mau</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_15_0">
    <VALUE Lang="GS">What a loving couple.. hahaha.. Well received. I will hand this over to captain..</VALUE>
    <VALUE Lang="id">Ini surat penting. Hati-hati karena surat ini dikirim oleh pacarnya dia hahaha</VALUE>
    <VALUE Lang="cn">这对情侣也太甜蜜了…..哈哈哈。收到了。我会交给队长的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_15_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_16_0">
    <VALUE Lang="GS">What a loving couple.. hahaha.. Well received. I will hand this over to captain..</VALUE>
    <VALUE Lang="id">Dasar mereka berdua itu…haha…makasih yah. Saya pasti sampaikan ini kepada pimpinan kami</VALUE>
    <VALUE Lang="cn">这对情侣也太甜蜜了…..哈哈哈。收到了。我会交给队长的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_16_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_17_0">
    <VALUE Lang="GS">…</VALUE>
    <VALUE Lang="id">…</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_18_0">
    <VALUE Lang="GS">I know you've already helped me once but there are just too many wildlife specimens, please eliminate enough of them. I would really appreciate it.</VALUE>
    <VALUE Lang="id">Dulu juga kamu sudah membantu, tapi tetep jumlah orang yang berubah menjadi monster di sini masih banyak. Makasih sekali kalu kamu bisa mengurangi jumlah mereka</VALUE>
    <VALUE Lang="cn">我知道您已经帮助过我一次了。但这边野蛮怪物的量实在是太庞大了。如果您能再继续歼灭一定的数量，我会很感激您的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_18_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_19_0">
    <VALUE Lang="GS">Thanks. Not enough but I can work something out. I found this while wandering around this place and I think this should be helpful to you. Here.</VALUE>
    <VALUE Lang="id">Makasih. Nggak cukup sieh tapi nggak apa-apa lah. Waktu saya memeriksa daerah sekitar sini saya menemukan ini, mungkin bisa membantu kamu</VALUE>
    <VALUE Lang="cn">谢谢您。虽然不是很足够，但至少可以应付一下了。对了，我在附近走动时，发现了这东西，也许对您会有帮助。看看吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_19_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_2_0">
    <VALUE Lang="GS">You are safe.. Thank god, I was so worried.. The wounded member's recovery speed has been really slow, it might be because of the environment but anyways.. Therefore, I could not leave this place..</VALUE>
    <VALUE Lang="id">Selamat rupanya..saya sangat khawatir. Entah karena lingkungan atau alasan apa orang-orang yang terluka sulit untuk sembuh, jadi saya tidak bisa pergi mencari teman-teman</VALUE>
    <VALUE Lang="cn">谢天谢地，您平安无事地回来了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_2_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_20_0">
    <VALUE Lang="GS">They carry a metal box and some attack with fire. I can handle them myself but I figure it would be nice to get a help as well.</VALUE>
    <VALUE Lang="id">Ada rombongan yang membawa drum yang terbuat dari emas dan melakukan serangan dengan menggunakan semburan api. Bisa saja saya yang membereskan mereka, tapi nggak ada salahnya kan meminta bantuan sama kamu.</VALUE>
    <VALUE Lang="cn">那些怪物手中提着金属筒，用它来点火攻击人们。我能单独对付他们，但还是希望透过善心人似的帮助，达到双赢的境界。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_20_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_21_0">
    <VALUE Lang="GS">You surprise me every time! Here, this is a little compensation. Thank you!</VALUE>
    <VALUE Lang="id">Kamu membuat saya terkejut setiap kali. Ini hadiah buat kamu. Makasih</VALUE>
    <VALUE Lang="cn">您每次都让我竞艳！这是我的一点小心意，请笑纳。谢谢您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_21_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_22_0">
    <VALUE Lang="GS">They must be the sailors cause I saw them on the ship and sometimes they seemed really busy up on the deck. They find me every time when I go near so please do this again!</VALUE>
    <VALUE Lang="id">Kelihatannya mereka adalah Vicious Sailor kalau dilihat dari kenyataan bahwa mereka ada di atas kapal dan terlihat sibuk. Mereka benar-benar mengganggu setiap kali saya memeriksa daerah sekitar, saya minta bantuan sekali lagi yah.</VALUE>
    <VALUE Lang="cn">它们一定是水手，因为我有在船上看到它们。有时他们在甲板上忙碌的工作。但每当我靠近时，他们总能快速地抓住我。请帮帮我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_22_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_23_0">
    <VALUE Lang="GS">They must loved the sea.. All of this has to end.. Her, I hope this can help you..</VALUE>
    <VALUE Lang="id">Mungkin dulunya mereka adalah orang-orang yang mencintai laut…Kita harus mengakhiri semuanya. Ini ambil, semoga saja bisa membantu kamu walaupun sedikit</VALUE>
    <VALUE Lang="cn">他们一定很爱海… 是该跟他们做个了断了。来！希望这可以带来好运。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_24_0">
    <VALUE Lang="GS">They are the first people who we encountered when we cam here. There were many of them outside of Hangout. They stop me from looking around Hangout so please help me!</VALUE>
    <VALUE Lang="id">Mereka adalah orang yang bertentangan dengan kita waktu pertama kali datang ke dunia ini. Diluar gedung Hangout juga ada banyak jumlahnya. Setiap kali kita mau memeriksa daerah sekitar hangout mereka sangat mengganggu, harap tolong kami</VALUE>
    <VALUE Lang="cn">他们是我们刚到这里时所遇到的第一批人。这些人总是阻止我们察看Hangout。Hangout外面还有更多。请帮帮我们。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_24_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_25_0">
    <VALUE Lang="GS">Now I can finish searching around the building, Thanks!</VALUE>
    <VALUE Lang="id">Sekarang barulah kita bisa menyelesaikan penyelidikan di daerah sekitar gedung itu</VALUE>
    <VALUE Lang="cn">托您的福，现在我已经完成这栋建筑物的周围调查工作了。非常感谢您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_25_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_26_0">
    <VALUE Lang="GS">…</VALUE>
    <VALUE Lang="id">…</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_27_0">
    <VALUE Lang="GS">Well.. You want me to talk about myself.. You are a trust worthy person.. so I think it will be fine to talk about my private stuff. I am a Diplomat. Don't give me that look.. haha Don't judge people by their dresses and looks.</VALUE>
    <VALUE Lang="id">Euhm…kalau kamu meminta untuk bercerita tentang saya…..karena kamu orang yang bisa dipercaya nggak apa-apa kali yah cerita hal-hal yang pribadi. Saya diplomat. Jangan lihat dengan tatapan seperti itu…hahaha menilai orang dari penampilan atau pakaian yang</VALUE>
    <VALUE Lang="cn">嗯…您希望我说点自己的事情吗？您是值得信赖的人，我想我可以告诉您些私人的事情。我其实是位外交官。噢，别用那种眼神看我。以貌取人是不好的唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_27_0_1">
    <VALUE Lang="GS">Ask about his home</VALUE>
    <VALUE Lang="id">Bertanya tentang kampung halaman</VALUE>
    <VALUE Lang="cn">问问他家乡的故事。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_28_0">
    <VALUE Lang="GS">Our world is divided into two different worlds. One side is bright and warm and another side is dark and cold. People from the bright side wouldn't really know how blessed they are since it's like an air to them..</VALUE>
    <VALUE Lang="id">Dunia kita terbagai dalam dua sisi. Sisi yang satu terang, indah dan sangat hangat sedangkan sisi yang lain gelap, tandus dan dingin. Orang-orang yang tinggal di tempat terang, sudah menikmati hal ini sejak lahir sehingga mereka tidak punya pikiran yang m</VALUE>
    <VALUE Lang="cn">我的星球分为两个部分。一边是暖和明亮的美丽世界；另一边则是贫瘠寒冷的阴暗世界。美丽世界的人们没尝过苦头，因而无法理解他们有多么幸运</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_28_0_1">
    <VALUE Lang="GS">Ask how is the Anther side</VALUE>
    <VALUE Lang="id">Bertanya tentang bagaimana sisi yang lain</VALUE>
    <VALUE Lang="cn">询问他另一边（阴暗世界）的情况如何</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_29_0">
    <VALUE Lang="GS">Another side is where our party had come from, people need to rely on each other to survive. On the barren land, people have to fight against the vicious and violent animals to live there.</VALUE>
    <VALUE Lang="id">Kami datang dari sisi lain yang tadi saya sebutkan, untuk hidup di sana kami harus saling membantu satu sama lain walaupun sumber daya yang ada kurang. Di bumi yang tandus kami harus bertahan hidup bertarung melawan monster yang ganas</VALUE>
    <VALUE Lang="cn">我们正是从阴暗世界来的。在那里，人们需要互相依赖生存。在贫瘠的大地，人们得对抗邪恶又暴力的动物，否则无法生存下去。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_29_0_1">
    <VALUE Lang="GS">Ask why he came to this world</VALUE>
    <VALUE Lang="id">Bertanya kenapa datang ke sisi dunia yang ini</VALUE>
    <VALUE Lang="cn">询问他为何来到这里？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_3_0">
    <VALUE Lang="GS">When we first arrived here, one of the member got injured and.. I and the captain decided to get separated from the party and stayed here for a while.</VALUE>
    <VALUE Lang="id">Waktu pertama kali datang ke dunia ini, salah satu teman saya terluka. Saya dan pimpinan saya berpisah dengan rombongan kami dan tinggal untuk sementara di sini</VALUE>
    <VALUE Lang="cn">我们最初刚到这儿时，因其中一位队友受伤，我和队长于是决定先脱队，3人一起留下来占歇会儿。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_3_0_1">
    <VALUE Lang="GS">Ask him where others are</VALUE>
    <VALUE Lang="id">Bertanya ada di manakah anggota rombongan yang lain</VALUE>
    <VALUE Lang="cn">询问其他人在何处？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_30_0">
    <VALUE Lang="GS">People need light, even though they live in a dark place. It is a complicated matter but let me put it this way, the reason we are here is to find something that can help us get the light.</VALUE>
    <VALUE Lang="id">Orang yang tinggal di dunia gelap sekalipun pasti ingin cahaya. Susah untuk menjelaskanya melalui beberapa kata tapi kalau saya singkat alasan kita datang ke dunia ini adalah untuk mencari sebuah benda yang dibutuhkan agar kami bisa mempunyai cahaya</VALUE>
    <VALUE Lang="cn">就算生在黑暗地带，身为人类，我们还是渴望阳光的。这有点复杂，简单的说就是，我们来这里是为了寻找一个可以帮助我们得到阳光的元素。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_30_0_1">
    <VALUE Lang="GS">Ask what he is going to do once he finds it</VALUE>
    <VALUE Lang="id">Bertanya apa yang akan dilakukan kalau dia sudah menemukannya</VALUE>
    <VALUE Lang="cn">询问找到之后，下一步计划是？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_31_0">
    <VALUE Lang="GS">We have to go back to our world. And end the long lasted war.. Then I am thinking about making a family of my own with a girl who I love. Hahaha</VALUE>
    <VALUE Lang="id">Kembali ke dunia kita dong. Terus perang yang panjang dan membosankan pun akan segera berakhir.</VALUE>
    <VALUE Lang="cn">当然是回到我们的世界啊。同时也得结束这些漫长又烦闷的战争。之后我还打算和我心爱的女孩共组家庭呢。哈哈哈。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_31_0_1">
    <VALUE Lang="GS">Ask if he has anyone in his mind</VALUE>
    <VALUE Lang="id">Bertanya apakah ada orang yang dia suka</VALUE>
    <VALUE Lang="cn">询问是否已经有心上人了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_32_0">
    <VALUE Lang="GS">There is.. an untruthful child.. Haha..</VALUE>
    <VALUE Lang="id">Ada dong…seorang .anak yang nggak bisa jujur hahaha</VALUE>
    <VALUE Lang="cn">当然由啊…是个爱藏秘密的小笨蛋。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_32_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_33_0">
    <VALUE Lang="GS">…</VALUE>
    <VALUE Lang="id">…</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_34_0">
    <VALUE Lang="GS">I wanna know how Mr.No-Name is doing. He did me a favor when we last met but since then I have never got a chance to thank him properly. Send him my regards.</VALUE>
    <VALUE Lang="id">Pengen tahu apa kabarnya Jinsan. Dulu waktu ketemu saya meminta sesuatu sama dia tapi belum bisa membalasnya. Tolong sampaikan kabar saya</VALUE>
    <VALUE Lang="cn">我想知道Mr.No-Name过得好不好。他帮了我很大的忙。但我却没能亲口向他道谢。请您帮我转达给他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_34_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_35_0">
    <VALUE Lang="GS">Aww! Thanks!.. Gee.. They've been through a lot..</VALUE>
    <VALUE Lang="id">Makasih….anak ini…..ada kejadian seperti ini rupanya</VALUE>
    <VALUE Lang="cn">噢！谢谢您！原来有这么一回事啊。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_35_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_4_0">
    <VALUE Lang="GS">It's at the safe place. This is a matter of trust. You might think you can trust but the breach of faith always comes together. Don't you think you have to show me some proof before I can trust you?</VALUE>
    <VALUE Lang="id">Ada di tempat aman. Kayaknya ini masalah kepercayaan. Penghianatan adalah suatu hal yang selalu membuntuti walapun kita berpikir bahwa kita percaya. Tidakkah seharusnya kamu menunjukan sesuatu pada saya yang bisa dipercaya.</VALUE>
    <VALUE Lang="cn">这是一个很安全的地方，且我们是重视诚信的人。希望您可以向我们证明，绝对不会轻易违背誓言，好让我们能相信您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_4_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_5_0">
    <VALUE Lang="GS">The one who always carries a fish and another one carrying two batons are keep interrupting when I tried to go see my captain and friends. If you are not that busy then please help me..</VALUE>
    <VALUE Lang="id">Setiap kali saya dan pemimpin pergi menemui teman-teman, kami diganggu oleh orang yang membawa ikan dan dikedua tangan mereka memegang Stick, Kalau kamu tidak sibuk tolong bantu</VALUE>
    <VALUE Lang="cn">每当我去找队长和其他同伴时，总会被扛着鱼和拿着两根警棍的人骚扰与阻拦。希望您能拨空帮助我，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_5_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_6_0">
    <VALUE Lang="GS">Good.. This is enough.. They will gather here again eventually but this will help us for a while. Thank you!</VALUE>
    <VALUE Lang="id">Oh, sudah cukup rupanya. Walaupun nanti mungkin mereka akan kembali lagi, untuk sekarang kayaknya sudah cukup. Makasih</VALUE>
    <VALUE Lang="cn">太好了。我很满足了。虽然过一段时间后，他们还是会再聚过来，不过这足够让我们撑一下了。谢谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_6_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_7_0">
    <VALUE Lang="GS">Since you are a reliable person, could I ask you one more thing? It will be a piece of a cake to you.</VALUE>
    <VALUE Lang="id">Saya sudah tahu kalau kamu orang yang sangat membantu, karena itu bisa tolong bantu saya satu lagi? Permintaan ini nggak begitu sulit untuk kamu</VALUE>
    <VALUE Lang="cn">您是位实力派的好人。我想再拜托您一件事情。这件事对您而言，是轻而易举的。好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_7_0_1">
    <VALUE Lang="GS">Tell him you will help</VALUE>
    <VALUE Lang="id">Mengatakan kalau kamu bersedia membantu</VALUE>
    <VALUE Lang="cn">告诉他您愿意帮忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_8_0">
    <VALUE Lang="GS">You will be able to meet an oldman in front of a large building if you go towards the wharf. He was the only one who did not lose his mind when we first arrived to this world. Go find him and ask what exactly happened when the phenomenon occurred here.</VALUE>
    <VALUE Lang="id">Kalau kamu pergi sedikit ke arah pelabuhan disana ada gedung besar. Kalau pergi ke depan gedung itu ada seorang orang tua disana. Waktu kita pertama kali tiba di sini dia adalah satu-satunya orang yang tidak hilang kesadarannya. Tolong temui dia dan tanya</VALUE>
    <VALUE Lang="cn">顺着Wharf的方向走，您会看到一位老人，他站在一个大楼的前方。我们第一次到达时，发现他是唯一没有迷失自己的活人。请问问他，当初发生异变时的情况为何。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_8_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_9_0">
    <VALUE Lang="GS">Umm.. The pursuers have.. Eventually they turned out like.. What a load off..</VALUE>
    <VALUE Lang="id">Euhm para pemburu itu…akhirnya terjadi seperti itu…sekarang saya bisa sedikit tenang</VALUE>
    <VALUE Lang="cn">嗯…这些追捕者已经尝到苦果了啊….我终于可以放心了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_mape.ntk_9_0_1">
    <VALUE Lang="GS">Ask about the pursuers</VALUE>
    <VALUE Lang="id">Bertanya tentang pemburu</VALUE>
    <VALUE Lang="cn">询问关于追捕者的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_minigame.ntk_1_0">
    <VALUE Lang="GS">The wheel of life will go round and round forever!</VALUE>
    <VALUE Lang="GS">I'll tell you what, anything too much isn't good for you.</VALUE>
    <VALUE Lang="GS">Hope you enjoy this appropriately!</VALUE>
    <VALUE Lang="GS">I did warn you!</VALUE>
    <VALUE Lang="GS">*Bet limit: 1~ 10,000,000 Gold</VALUE>
    <VALUE Lang="GS">*Bet will be increased automatically for the consecutive wins.</VALUE>
    <VALUE Lang="id">Roda kehidupan terus berputar!</VALUE>
    <VALUE Lang="id">Sedikit saran, sedikit itu selalu lebih baik dari pada kebanyakan.</VALUE>
    <VALUE Lang="id">Semoga kamu mengerti!</VALUE>
    <VALUE Lang="id">Jangan lupa saya sudah menasihatimu!</VALUE>
    <VALUE Lang="id">*Batas Taruhan: 1~ 10,000,000 Gold</VALUE>
    <VALUE Lang="id">*Angaka Taruhan otomatis bertambah jika kamu menang .</VALUE>
    <VALUE Lang="cn">生命之轮永远都是周而复始的！</VALUE>
    <VALUE Lang="cn">我会告诉你，但要适量才能避免失败。</VALUE>
    <VALUE Lang="cn">希望您能正确地、开心地进行！</VALUE>
    <VALUE Lang="cn">我已经警告过您了唷！</VALUE>
    <VALUE Lang="cn">*赌注限制：1〜10,000,000 Gold。</VALUE>
    <VALUE Lang="cn">*在连续得胜的情况下，赌注将自动增加。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_minigame.ntk_1_0_1">
    <VALUE Lang="GS">Play Dice</VALUE>
    <VALUE Lang="id">Lempar Dadu</VALUE>
    <VALUE Lang="cn">掷骰子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0">
    <VALUE Lang="GS">I feel good after change battle ground~ What are you here for?</VALUE>
    <VALUE Lang="id">Saya berasa baik setelah pertarungan di Battleground~ Apa yang kamu inginkan?</VALUE>
    <VALUE Lang="cn">我蛮喜欢战场的变化~不过您来这里是？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0_1">
    <VALUE Lang="GS">Ask about CDM Honor Award.</VALUE>
    <VALUE Lang="id">Bertanya tentang CDM Honor Award.</VALUE>
    <VALUE Lang="cn">询问关于CDM Honor Award.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0_2">
    <VALUE Lang="GS">Ask about Honor Award Trade list.</VALUE>
    <VALUE Lang="id">Bertanya tentang daftar Honor Award Tukar.</VALUE>
    <VALUE Lang="cn">询问关于Honor Award交易名单</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_1_0_3">
    <VALUE Lang="GS">Tell her that you want to exchange Honor Award.</VALUE>
    <VALUE Lang="id">Katakan padanya kamu ingin menukar Honor Award.</VALUE>
    <VALUE Lang="cn">告诉他您想要兑换Honor Award。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0">
    <VALUE Lang="GS">Choose a class for item exchange. (20 Honor Awards)</VALUE>
    <VALUE Lang="id">Pilih Kelas untuk Item yang akan ditukar. (20 Honor Awards)</VALUE>
    <VALUE Lang="cn">选择1个职业的物品来兑换(需20个Honor Awards)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_1">
    <VALUE Lang="GS">Brawler</VALUE>
    <VALUE Lang="id">Brawler</VALUE>
    <VALUE Lang="cn">格斗部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_new_cdm_event.ntk_10_0_2">
    <VALUE Lang="GS">Swordsman</VALUE>
    <VALUE Lang="id">Swordsman</VALUE>
    <VALUE Lang="cn">剑道部</VALUE>
