    <VALUE Lang="cn">아이템 획득에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_shop1.ntk_1_0_3">
    <VALUE Lang="GS">아이템 종류에 대해 묻는다</VALUE>
