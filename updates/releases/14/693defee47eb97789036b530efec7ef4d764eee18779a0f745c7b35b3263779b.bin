    <VALUE Lang="id">'붕권' 을 얻는다</VALUE>
    <VALUE Lang="cn">'붕권' 을 얻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_10_0_2">
