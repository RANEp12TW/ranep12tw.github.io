    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_1_0">
    <VALUE Lang="GS">This section is exclusive to Sword Section Students. You can stay and watch for a while if you'd like.</VALUE>
    <VALUE Lang="id">Kamu harus melewati para Staff yang lain.</VALUE>
    <VALUE Lang="id">Adakah hal yang kamu inginkan?</VALUE>
    <VALUE Lang="cn">这部门专门开放给剑道部的学生。您愿意的话，可以留在这边观望，没关系的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_1_1">
    <VALUE Lang="GS">Is there anything I can help you with?</VALUE>
