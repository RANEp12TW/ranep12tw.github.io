    <VALUE Lang="cn">取消</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_65_0_9"><VALUE Lang="tw">兌換 風迴劍（177級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Aero Boomerang (Lv177, Class=130, Item=175/14)</VALUE><VALUE Lang="id">Skill book: Aero Boomerang (Lv177, Class=130, Item=175/14)</VALUE><VALUE Lang="cn">Skill book: Aero Boomerang (Lv177, Class=130, Item=175/14)</VALUE><VALUE Lang="th">Skill book: Aero Boomerang (Lv177, Class=130, Item=175/14)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_66_0">
    <VALUE Lang="GS">Spiritual Spheres are earned by achieving certain character levels. You can use Spiritual Spheres to learn available skills of your choice.</VALUE>
    <VALUE Lang="id">Jika kamu mempunyai Spiritual Spheres, berarti kekuatan kamu sudah cukup diakui. Pilihlah Skill yang kamu inginkan</VALUE>
    <VALUE Lang="cn">达到特定等级，就能拿到Spiritual Spheres。您可自由使用Spiritual Spheres来选择可学的技能唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_66_0_10"><VALUE Lang="tw">兌換 旋風斬（197級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Whirlwind Strike (Lv197, Class=130, Item=175/36)</VALUE><VALUE Lang="id">Skill book: Whirlwind Strike (Lv197, Class=130, Item=175/36)</VALUE><VALUE Lang="cn">Skill book: Whirlwind Strike (Lv197, Class=130, Item=175/36)</VALUE><VALUE Lang="th">Skill book: Whirlwind Strike (Lv197, Class=130, Item=175/36)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_66_0_11"><VALUE Lang="tw">兌換 赤紅雷電（197級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE><VALUE Lang="id">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE><VALUE Lang="cn">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE><VALUE Lang="th">Skill book: Crimson Lightning (Lv197, Class=130, Item=175/56)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_66_0_12">
