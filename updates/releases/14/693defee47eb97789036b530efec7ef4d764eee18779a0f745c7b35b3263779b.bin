  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_0">
    <VALUE Lang="GS">This is the security elevator for the restricted area.</VALUE>
    <VALUE Lang="id">Ini adalah Elevator untuk akses area terbatas</VALUE>
    <VALUE Lang="cn">限制地区出入的电梯</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_elevator.ntk_1_1">
