  <SENTENSE Ver="1" Id="2014_halloween_01.ntk_1_1">
    <VALUE Lang="GS">Costumes on sale~!!</VALUE>
    <VALUE Lang="cn">套装价优惠中~!!</VALUE>
    <VALUE Lang="id">Costumes on sale~!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_halloween_01.ntk_2_0">
    <VALUE Lang="GS">Bring me the Halloween Invitation if you want to go to Pumpkin Graveyard.</VALUE>
    <VALUE Lang="GS">I don't…really want to go there~.</VALUE>
