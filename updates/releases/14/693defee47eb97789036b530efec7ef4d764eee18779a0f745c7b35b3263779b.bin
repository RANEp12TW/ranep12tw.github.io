    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_1_0_2">
    <VALUE Lang="GS">Announce Situation for New Students</VALUE>
    <VALUE Lang="id">Memberitahukan penderitaan pelajar baru</VALUE>
