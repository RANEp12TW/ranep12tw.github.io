    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_9_0">
    <VALUE Lang="GS">There's no turning back now.</VALUE>
    <VALUE Lang="GS">Please be aware of this.</VALUE>
    <VALUE Lang="id">Sampai saat ini tidak ada masalah dengan tugas…</VALUE>
    <VALUE Lang="id">tapi kalian tetap tidak boleh lengah dan berdiam saja!</VALUE>
    <VALUE Lang="cn">没有回头路了。请记住。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_archer1.ntk_9_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0">
    <VALUE Lang="GS">Oh!</VALUE>
    <VALUE Lang="GS">It's great to see a normal human after all this time!</VALUE>
    <VALUE Lang="id">Senang bisa bertemu dengan sesama manusia</VALUE>
    <VALUE Lang="cn">噢！很高兴能见到能见到像您一样的正常人。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_1_0_1">
