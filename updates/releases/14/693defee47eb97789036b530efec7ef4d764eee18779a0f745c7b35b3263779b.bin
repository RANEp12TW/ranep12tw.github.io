  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_4">
    <VALUE Lang="GS">Open the Shop</VALUE>
    <VALUE Lang="id">Jual Beli Item</VALUE>
    <VALUE Lang="cn">开启商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_5">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问关于圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_6">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问关于圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_7">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问关于圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_8">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问关于圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_9">
    <VALUE Lang="GS">Ask about List of Saints</VALUE>
    <VALUE Lang="id">Bertanya tentang Saint List</VALUE>
    <VALUE Lang="cn">询问关于圣徒列表</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_10_0">
    <VALUE Lang="GS">Maybe there will be another copy spirit that has a better body. If not, please tell her that I was so happy that she could stop me. Also tell her not to feel so weak.</VALUE>
    <VALUE Lang="GS">Please help me.</VALUE>
    <VALUE Lang="id">Mungkin sudah muncul roh gentayangan yang lebih sempurna selain saya</VALUE>
    <VALUE Lang="id">Tapi apabila tidak begitu….</VALUE>
    <VALUE Lang="id">Bisa tolong saya untuk menyampaikannya saja.</VALUE>
    <VALUE Lang="id">Terimakasih karena sudah menghentikan saya..dan ke depannya juga tetaplah kuat seperti itu…</VALUE>
    <VALUE Lang="id">Saya mint</VALUE>
    <VALUE Lang="cn">有可能除了我以外出现比我更完善的复制灵。</VALUE>
    <VALUE Lang="cn">可是如果没有出现…</VALUE>
    <VALUE Lang="cn">那就只是传达一下.</VALUE>
    <VALUE Lang="cn">谢谢他能让我停止…还有希望往后也这么坚强的活下去,那拜托你了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_10_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_11_0">
    <VALUE Lang="GS">Oh. That was the answer.</VALUE>
    <VALUE Lang="GS">I won't ever give up, then!</VALUE>
    <VALUE Lang="GS">Thanks.</VALUE>
    <VALUE Lang="GS">Now I feel better.</VALUE>
    <VALUE Lang="GS">Maybe someday another copy of my spirit will visit Hee Ji since I know her feelings so well.</VALUE>
    <VALUE Lang="GS">Then I will just rest here.</VALUE>
    <VALUE Lang="id">Cocok dengan sifatnya.</VALUE>
    <VALUE Lang="id">Saya tidak menyerah….</VALUE>
    <VALUE Lang="id">Terimakasih.</VALUE>
    <VALUE Lang="id">Kini saya juga bisa tenang</VALUE>
    <VALUE Lang="id">Saya tahu setelah mendengar kabar seperti ini, karena itu suatu saat roh gentayangan saya yang lain pasti akan pergi untuk menemuai kak Fanny</VALUE>
    <VALUE Lang="id">Kalau begitu</VALUE>
    <VALUE Lang="cn">不愧是他啊。绝对不放弃是吧…</VALUE>
    <VALUE Lang="cn">谢谢。</VALUE>
    <VALUE Lang="cn">现在我可以安心了。</VALUE>
    <VALUE Lang="cn">我这样听到消息，总有一天会另外一个我的复制灵去找熙知的。</VALUE>
    <VALUE Lang="cn">我会等下去的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_11_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_12_0">
    <VALUE Lang="GS">It is morally wrong to put enforcement on that list.</VALUE>
    <VALUE Lang="GS">But what will happen without enforcement?</VALUE>
    <VALUE Lang="GS">Now can we talk like this?</VALUE>
    <VALUE Lang="GS">I believe this is the evil is necessary for life to exist.</VALUE>
    <VALUE Lang="id">Secara manusiawi…Meletakkan paksaan pada daftar seperti itu memang suatu kesalahan.</VALUE>
    <VALUE Lang="id">Tapi kalau tidak begitu apakah yang mungkin terjadi?</VALUE>
    <VALUE Lang="id">Mungkinkah setidaknya kita bisa mengobrol di tempat ini sekarang?</VALUE>
    <VALUE Lang="id">Kejahatan relatif yang harus ada…Saya berpi</VALUE>
    <VALUE Lang="cn">从人类性质上，当然强制发动那些列表是不对的。</VALUE>
    <VALUE Lang="cn">但是如果不那么做会变成什么样呢?</VALUE>
    <VALUE Lang="cn">现在在这里可以跟我说话吗?</VALUE>
    <VALUE Lang="cn">只能存在的相对性的恶…那样的绝对恶</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_12_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_13_0">
    <VALUE Lang="GS">Suddenly...</VALUE>
    <VALUE Lang="GS">I thought of something.</VALUE>
    <VALUE Lang="GS">The artificial heart power generator room underground...</VALUE>
    <VALUE Lang="GS">It has been discovered that the electricity is stable in an artificial heart without an outside power supply.</VALUE>
    <VALUE Lang="GS">Is it really an artificial heart? A man-made object?</VALUE>
    <VALUE Lang="GS">For me, its movement is so natural… And looks weird.</VALUE>
    <VALUE Lang="GS">Could you check that place?</VALUE>
    <VALUE Lang="id">Kebetulan….</VALUE>
    <VALUE Lang="id">Ternyata saya jadi berpikir seperti itu.</VALUE>
    <VALUE Lang="id">Ruang pengembangan pencakokan hati yang ada di bawah tanah…</VALUE>
    <VALUE Lang="id">Meskipun rahasia listrik yang terus terjaga meskipun hubungan ke dunia luar sudah terhenti terungkap, tapi</VALUE>
    <VALUE Lang="id">Apakah hati buatan itu</VALUE>
    <VALUE Lang="cn">突然…</VALUE>
    <VALUE Lang="cn">有那种想法。</VALUE>
    <VALUE Lang="cn">在地下的人工心脏发电室…</VALUE>
    <VALUE Lang="cn">与外部所有连接断掉的状态下维持的秘密能被揭开是好事,</VALUE>
    <VALUE Lang="cn">可是那个人工心脏真的从根本开始是人工制作品吗？</VALUE>
    <VALUE Lang="cn">那些自然的移动…太不可思议了。</VALUE>
    <VALUE Lang="cn">可否替我确认一下</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_13_0_1">
    <VALUE Lang="GS">Accept</VALUE>
    <VALUE Lang="id">Menerima permintaan</VALUE>
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_13_0_2">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_14_0">
    <VALUE Lang="GS">If the beat rate is little bit changed... If the vibration is almost same, then it really is an artificial heart.</VALUE>
    <VALUE Lang="id">Bila rata-rata denyut jantung sedikit salah…atau tidak ada sedikit perbedaan pada getarannya, maka itu benar adalah jantung buatan</VALUE>
    <VALUE Lang="cn">如果有稍微相反的跳动数… 还有震动上如果没有稍微差异的话可以看作是人工心脏</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_14_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_15_0">
    <VALUE Lang="GS">Ah, okay…</VALUE>
    <VALUE Lang="GS">You look so tired. If that one is based on a real one...</VALUE>
    <VALUE Lang="GS">Then it won't have that kind of problem.</VALUE>
    <VALUE Lang="GS">Thank you for your help.</VALUE>
    <VALUE Lang="id">Begituyah..</VALUE>
    <VALUE Lang="id">Mungkin saya sudah berpikir terlalu jauh.</VALUE>
    <VALUE Lang="id">Bila itu dibuat dengan dasar sesuatu yang asli yang dibawa dari suatu tempat…</VALUE>
    <VALUE Lang="id">Untuk sekarang kita bisa berpikir bahwa masalah seperti itu tidak ada</VALUE>
    <VALUE Lang="id">Terimakasih sudah mengkonfirmasikannya?</VALUE>
    <VALUE Lang="cn">是吗…</VALUE>
    <VALUE Lang="cn">我想法过分了.</VALUE>
    <VALUE Lang="cn">如果那是从另一个地方拿来的真的心脏作为标本进行的话…</VALUE>
    <VALUE Lang="cn">首先不认为有那样的问题。</VALUE>
    <VALUE Lang="cn">谢谢你的确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_15_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_16_0">
    <VALUE Lang="GS">I'm glad you are coming. I just want to help you earn new power. Pass my exam and you'll get new sphere to learn the power.</VALUE>
    <VALUE Lang="id">Sangat senang kamu datang ke sini. Saya ingin membantumu mendapatkan kekuatan baru. Lewati ujian saya dan kamu akan mendapatkan sphere baru untuk belajar skill baru.</VALUE>
    <VALUE Lang="cn">我很开心您来这里。我想帮您得到新力量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_16_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_17_0">
    <VALUE Lang="GS">Eliminate Multilock in Head.B U-Ground.</VALUE>
    <VALUE Lang="id">Bunuh Multilock di Head.B U-Ground.</VALUE>
    <VALUE Lang="cn">歼灭位在 Head.B U-Ground的Multilock。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_17_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_2_0">
    <VALUE Lang="GS">Is there something that I could help you with?</VALUE>
    <VALUE Lang="id">Apakah ada yang bisa dibantu?</VALUE>
    <VALUE Lang="cn">有没有我能帮的事情呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_2_0_1">
    <VALUE Lang="GS">Ask about Her</VALUE>
    <VALUE Lang="id">Bertanya tentang Dia</VALUE>
    <VALUE Lang="cn">询问她的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_2_0_2">
    <VALUE Lang="GS">Ask about the Underground</VALUE>
    <VALUE Lang="id">Bertanya tentang Underground</VALUE>
    <VALUE Lang="cn">询问地下一楼的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_2_0_3">
    <VALUE Lang="GS">Ask about Copy Spirit</VALUE>
    <VALUE Lang="id">Bertanya tentang Copy Spirit</VALUE>
    <VALUE Lang="cn">询问复制灵的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_3_0">
    <VALUE Lang="GS">I was the vice-representative of archery class in Sacred Gate Campus.</VALUE>
    <VALUE Lang="GS">...But... I died....</VALUE>
    <VALUE Lang="GS">Then I transformed into a monster since I didn't have any power like my sister's.</VALUE>
    <VALUE Lang="id">Dulunya saya Archery Club Manager dari SG_School</VALUE>
    <VALUE Lang="id">….Karens saya sudah mati…seribu…sepuluh ribu..kali</VALUE>
    <VALUE Lang="id">Aku berubah menjadi monster hari itu karena tidak punya kekuatan seperti adikku, terpaksa aku menyerahkan semua beban pada adikku.</VALUE>
    <VALUE Lang="cn">我虽然是Sacred Gate Campus的弓箭部的部长</VALUE>
    <VALUE Lang="cn">…… 但我已经死过一次…</VALUE>
    <VALUE Lang="cn">我没有像妹妹那么有力气，所以那天我变成怪物,把重担托付给妹妹了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_3_0_1">
    <VALUE Lang="GS">Continue</VALUE>
    <VALUE Lang="id">Terus mendengarkan</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_4_0">
    <VALUE Lang="GS">My poor sister killed me eventually.</VALUE>
    <VALUE Lang="GS">It wasn't easy.</VALUE>
    <VALUE Lang="GS">Then she shared her power with me.</VALUE>
    <VALUE Lang="GS">My copied spirit was able to get the same body form and spirit as before.</VALUE>
    <VALUE Lang="id">Adik saya yang perlu dikasihani sudah membantu saya untuk mati</VALUE>
    <VALUE Lang="id">Pasti kamu merasa kesulitan sekali</VALUE>
    <VALUE Lang="id">Dan dia membagikan kekuatannya pada saya.</VALUE>
    <VALUE Lang="id">Berkat itu roh-roh gentayangan bisa sadar dan kembali ke bentuknya semula</VALUE>
    <VALUE Lang="cn">可怜的妹妹把我杀了。应该很痛苦吧。</VALUE>
    <VALUE Lang="cn">然后分担了力量。托妹妹的福，复制灵都可以找回原来的模样和精神</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_4_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_4_0_2">
    <VALUE Lang="GS">Ask about Copy Spirit</VALUE>
    <VALUE Lang="id">Bertanya tentang Roh Jelmaan</VALUE>
    <VALUE Lang="cn">询问复制灵的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_5_0">
    <VALUE Lang="GS">Well, I'm a copy spirit myself.</VALUE>
    <VALUE Lang="GS">Many free spirits are captured in this place, and certain forces keep them trapped here.</VALUE>
    <VALUE Lang="GS">Perhaps a spirit's grudge or attachment?</VALUE>
    <VALUE Lang="id">Saya lebih tahu karena saya sendiri adalah roh gentayangan.</VALUE>
    <VALUE Lang="id">Ini adalah tempat untuk mengikat makhluk-makhluk yang mengembara</VALUE>
    <VALUE Lang="id">Saya mau pergi tapi tidak bisa dan ada kekuatan yang membuat saya tidak punya tempat untuk didatangi</VALUE>
    <VALUE Lang="id">Apakah itu dendam?</VALUE>
    <VALUE Lang="cn">我本身是复制灵，所以更加清楚。这里栖息着彷​​徨的生命。</VALUE>
    <VALUE Lang="cn">想离开却无法离开的,也没有去路的。是怨念吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_5_0_1">
    <VALUE Lang="GS">Continue</VALUE>
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_6_0">
    <VALUE Lang="GS">If possible, I want to leave this place.</VALUE>
    <VALUE Lang="GS">I can't leave because of certain invisible forces.</VALUE>
    <VALUE Lang="GS">I just hope that the other free spirits won't suffer this... Maybe it's my grudge</VALUE>
    <VALUE Lang="id">Kalau bisa saya ingin meninggalkan tempat ini.</VALUE>
    <VALUE Lang="id">Tapi sesuatu yang tidak terlihat sedang menggenggam erat kaki saya</VALUE>
    <VALUE Lang="id">Saya berharap agar roh gentayangan saya yang lain bisa lebih bebas tapi</VALUE>
    <VALUE Lang="cn">可以的话我想离开此地。但是这底下看不见的东西在压我。希望我的其他复制灵能稍微自由些… 是吗，这也是怨念的一种吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_6_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_7_0">
    <VALUE Lang="GS">When two different dimensions cross each other, it can cause an organism to transform into a completely new creature that is bloodthirsty and violent.</VALUE>
    <VALUE Lang="GS">Sometimes the crossing of dimensions causes more than one new kind of life form to be spawned.</VALUE>
    <VALUE Lang="id">Kekuatan yang datang dari dimensi yang berbeda saling berbenturan dan menyebabkan makhluk hidup yang ada di antaranya kacau hingga pada akhirnya kehilangan kekuasaan untuk mengontrol.</VALUE>
    <VALUE Lang="id">Berubah menjadi sesuatu yang mengerikan atau terbagi ke dalam bebera</VALUE>
    <VALUE Lang="cn">可以的话我想离开此地。但是这底下看不见的东西在压我。希望我的其他复制灵能稍微自由些… 是吗，这也是怨念的一种吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_7_0_1">
    <VALUE Lang="GS">Continue</VALUE>
    <VALUE Lang="id">Terus mendengarkan</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_8_0">
    <VALUE Lang="GS">I was one of them.</VALUE>
    <VALUE Lang="GS">Then there are cases where this happens, but the organism doesn't lose its mind or sanity.</VALUE>
    <VALUE Lang="id">Dulu saya begitu</VALUE>
    <VALUE Lang="id">Tapi diantara anjing-anjing ada beberapa kondisi</VALUE>
    <VALUE Lang="id">Contohnya meskipun badannya sudah berubah menjadi monster tapi dia masih memiliki akal sehat</VALUE>
    <VALUE Lang="cn">一段时间我也是。但是其中有很多情况。虽然成为怪物的身体但保持自己的精神或</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_8_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_9_0">
    <VALUE Lang="GS">I wanted to do what my sister did…</VALUE>
    <VALUE Lang="GS">I wanted to hug her instead of being stuck here.</VALUE>
    <VALUE Lang="GS">I'm trapped. There's no way out for me.</VALUE>
    <VALUE Lang="GS">My body isn't even a human body either.</VALUE>
    <VALUE Lang="GS">Will you help me? Please send my sister a message for me?</VALUE>
    <VALUE Lang="id">Sebagai kakak saya sudah melakukan hal yang sangat jahat kan?</VALUE>
    <VALUE Lang="id">Saya tidak mau berada di sini dan berlari untuk memeluknya segera</VALUE>
    <VALUE Lang="id">Tapi…saya tidak bisa meninggalkan tempat ini.</VALUE>
    <VALUE Lang="id">Lucu sekali….sekarangpun dia bukan dalam keadaan manusia yang sempurna</VALUE>
    <VALUE Lang="cn">"作为姐姐做了很多不该做的事情。</VALUE>
    <VALUE Lang="cn">我真想立刻跑去拥抱。但是… 我无法脱离这里。很好笑… 到目前为止还不是完整的人模样。</VALUE>
    <VALUE Lang="cn">很抱歉，拜托你可否传达给我妹妹?"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_9_0_1">
    <VALUE Lang="GS">Accept</VALUE>
    <VALUE Lang="id">Menerima permintaan</VALUE>
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_9_0_2">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0">
    <VALUE Lang="GS">Hi, hello~~</VALUE>
    <VALUE Lang="id">Helo?</VALUE>
    <VALUE Lang="cn">嘿！您好。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_1">
    <VALUE Lang="GS">Listen to the Story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_2">
    <VALUE Lang="GS">Give Enrollment Form</VALUE>
    <VALUE Lang="id">Menyerahkan formulir pendaftaran.</VALUE>
    <VALUE Lang="cn">交付入学申请书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_3">
    <VALUE Lang="GS">Ask about Damage</VALUE>
    <VALUE Lang="id">Menyerahkann formulir pendaftaran.</VALUE>
    <VALUE Lang="cn">询问受害内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_4">
    <VALUE Lang="GS">Deliver the New Suit</VALUE>
    <VALUE Lang="id">Menyerahkan Uniform.</VALUE>
    <VALUE Lang="cn">交付新服饰</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_5">
    <VALUE Lang="GS">I want to help.</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_1_0_6">
    <VALUE Lang="GS">I want to help.</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_2_0">
    <VALUE Lang="GS">Ah, thanks. The officer just told me where I should look. That's why I couldn't do anything…</VALUE>
    <VALUE Lang="id">Terimakasih~</VALUE>
    <VALUE Lang="id">Kalau saja pegawai itu menjelaskan dengan benar saya pasti bisa mendatanginya secara langsung</VALUE>
    <VALUE Lang="id">Jadi selama ini aku tidak bisa mendaftar dan terus begini…</VALUE>
    <VALUE Lang="cn">啊,谢谢~</VALUE>
    <VALUE Lang="cn">如果职员好好告诉我的话我可以亲自找的...</VALUE>
    <VALUE Lang="cn">因此之前都没法注册</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_2_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_3_0">
    <VALUE Lang="GS">I can endure the attacks from those kids, but not for too long. This school uniform doesn't really absorb the brunt of those hits...</VALUE>
    <VALUE Lang="id">Anak-anak kecil datang menyerang terus memukul, sebenarnya kalau sakit sedikit aku masih bisa tahan tapi</VALUE>
    <VALUE Lang="id">Benar-benar sakit kan~</VALUE>
    <VALUE Lang="id">Memang seragam terlalu tipis jadi bermasalah…</VALUE>
    <VALUE Lang="cn">小小的家伙涌过来打，如果一点点痛还能忍住?</VALUE>
    <VALUE Lang="cn">太痛了~</VALUE>
    <VALUE Lang="cn">本来校服就很薄</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_3_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_4_0">
    <VALUE Lang="GS">Oh, look at these clothes. These seem a little sturdier. Maybe I can even counterattack with clothes as tough as these! Anyway, thanks! I think they'll be handy~</VALUE>
    <VALUE Lang="id">Ih baju apa ini?</VALUE>
    <VALUE Lang="id">Kalau segini pasti bisa menahannya kan, anda saja bisa memukulnya sekali saja</VALUE>
    <VALUE Lang="id">Terimakasih, akan aku gunakan dengan baik~</VALUE>
    <VALUE Lang="cn">啊，这个衣服是什么~?</VALUE>
    <VALUE Lang="cn">这个程度的话应该能忍受一定程度吧, 各打一顿也好…</VALUE>
    <VALUE Lang="cn">谢谢,会好好用的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_4_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_5_0">
    <VALUE Lang="GS">There's no welfare for students here…</VALUE>
    <VALUE Lang="GS">I was studying in USA when I heard about a better tuition and scholarship program.</VALUE>
    <VALUE Lang="GS">This is totally different than what I expected, though.</VALUE>
    <VALUE Lang="GS">And how can I study in these filthy conditions?</VALUE>
    <VALUE Lang="GS">Even I feel a little disgusted and uncomfortable.</VALUE>
    <VALUE Lang="id">Di sini tidak ada sistem kesejahteraan untuk pelajar sama sekali~</VALUE>
    <VALUE Lang="id">Padahal aku sedang belajar di Amerika lalu datang ke sini karena katanya perlakuan di sini baik…tapi ini ceritanya beda banget kan~</VALUE>
    <VALUE Lang="id">Apa yang bisa dilakukan di tempat yang tidak higien</VALUE>
    <VALUE Lang="cn">这里没有一点为学生福利的~</VALUE>
    <VALUE Lang="cn">本来是在美国留学中，说会好好宽待所以才来的… 可是完全不一样啊~</VALUE>
    <VALUE Lang="cn">这样不卫生的地方能做什么啊~?</VALUE>
    <VALUE Lang="cn">心情太差了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_5_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_6_0">
    <VALUE Lang="GS">My friend told me that he'd find my document for me.</VALUE>
    <VALUE Lang="GS">So I'm waiting for him now.</VALUE>
    <VALUE Lang="GS">Hmmm, but he's still not here.</VALUE>
    <VALUE Lang="GS">Can you help me find that document?</VALUE>
    <VALUE Lang="id">Harus bagaimana lagi pegawai yang biasanya menerima pendaftaran hilang entah kemana dan tidak kembali</VALUE>
    <VALUE Lang="id">Saya begini karena tidak tahu harus bagaimana</VALUE>
    <VALUE Lang="id">Bisa bantu sedikit?</VALUE>
    <VALUE Lang="cn">我朋友说他已经为我找到文件了。所以我正在等他。</VALUE>
    <VALUE Lang="cn">嗯……但他一直没来耶。</VALUE>
    <VALUE Lang="cn">您可以帮我拿到那份文件吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_6_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima permintaan</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_6_0_2">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak permintaan</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_7_0">
    <VALUE Lang="GS">They don't like me... Maybe because of my scores?</VALUE>
    <VALUE Lang="GS">I'll need to study more than they do.</VALUE>
    <VALUE Lang="GS">Do you think you can teach me how to learn things better and more quickly?</VALUE>
    <VALUE Lang="id">Aku benar-benar tidak tahu bahwa aku akan diganggu hingga seperti ini</VALUE>
    <VALUE Lang="id">Karena kamu tertinggal dalam proses pembelajaran bagaimana kalau kamu mencari sesuatu yang bisa dijadikan tambahan?</VALUE>
    <VALUE Lang="id">Bisa bantu sedikit?</VALUE>
    <VALUE Lang="cn">他们不喜欢我，应该是分数的关系。我得比他们更用功念书才行。您可以教我如何念书才会念的又快又好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_7_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima permintaan</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_7_0_2">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak permintaan</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_8_0">
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="GS">They'll find me if they come back here.</VALUE>
    <VALUE Lang="GS">So I guess all I can do for now is just wait.</VALUE>
    <VALUE Lang="id">Apakah orang itu akan kembali atau tidak, saya tak tahu. Untuk itu saya akan tetap disini</VALUE>
    <VALUE Lang="cn">谢谢您。</VALUE>
    <VALUE Lang="cn">如果他们有回来的话，他们会来找我的。</VALUE>
    <VALUE Lang="cn">现在我能做的就只有等待。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_8_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_9_0">
    <VALUE Lang="GS">I'll study here by myself.</VALUE>
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="id">Makasih, boleh kan aku berlatih sendiri disini?</VALUE>
    <VALUE Lang="cn">我会在这边一个人好好念书。谢谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_9_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0">
    <VALUE Lang="GS">Yo!</VALUE>
    <VALUE Lang="id">Yoow!</VALUE>
    <VALUE Lang="cn">哟呵！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_1">
    <VALUE Lang="GS">Listen to the Story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_2">
    <VALUE Lang="GS">Give Enrollment Form</VALUE>
    <VALUE Lang="id">Menyerahkan formulir pendaftaran.</VALUE>
    <VALUE Lang="cn">交付注册申请书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_3">
    <VALUE Lang="GS">Ask about Damage</VALUE>
    <VALUE Lang="id">Menyerahkann formulir pendaftaran.</VALUE>
    <VALUE Lang="cn">询问受害内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_4">
    <VALUE Lang="GS">Deliver the New Suit</VALUE>
    <VALUE Lang="id">Menyerahkan Uniform.</VALUE>
    <VALUE Lang="cn">传达新服饰</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_5">
    <VALUE Lang="GS">I want to help.</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_1_0_6">
    <VALUE Lang="GS">I want to help.</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_2_0">
    <VALUE Lang="GS">Thanks~</VALUE>
    <VALUE Lang="GS">The guy who processed my document said that it disappeared, and then he vanished too.</VALUE>
    <VALUE Lang="GS">I couldn't do anything because he didn't tell me where he lost it.</VALUE>
    <VALUE Lang="GS">I haven't been able to enroll in anything up till now.</VALUE>
    <VALUE Lang="GS">Anyway, thank you!</VALUE>
    <VALUE Lang="id">Pegawai yang bertugas untuk mengantarkan dokumen itu tiba-tiba menghilang setelah memberi kabar bahwa dokumennya hilang</VALUE>
    <VALUE Lang="id">Setidaknya bilang hilang dimana jadi bisa dicari</VALUE>
    <VALUE Lang="id">Selama ini saya tidak bisa mendaftar….</VALUE>
    <VALUE Lang="id">Pokoknya terimakasih!</VALUE>
    <VALUE Lang="cn">谢谢~</VALUE>
    <VALUE Lang="cn">原本送来书籍的职员突然丢失了书籍，只说一句书籍丢失，然后消失了…</VALUE>
    <VALUE Lang="cn">没说在哪里丢失，所以无法查找~</VALUE>
    <VALUE Lang="cn">一直没有登陆..</VALUE>
    <VALUE Lang="cn">不管怎样谢谢！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_2_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_3_0">
    <VALUE Lang="GS">It's okay…</VALUE>
    <VALUE Lang="GS">Nuts, someone just hit me.</VALUE>
    <VALUE Lang="GS">Aw, it's nothing, I just wasn't fast enough to strike back.</VALUE>
    <VALUE Lang="GS">I probably… Need more practice at this fighting thing.</VALUE>
    <VALUE Lang="id">Bukan kerugian….</VALUE>
    <VALUE Lang="id">Hanya kena pukul sedikit saja…</VALUE>
    <VALUE Lang="id">Padahal mereka bukan apa-apa, kalau saja saya bisa menahan pukulan mereka pasti sudah bisa membalas</VALUE>
    <VALUE Lang="id">Mungkin ketinggalan pelajaran karena sudah telat mendaftar</VALUE>
    <VALUE Lang="cn">不能说是逃避…</VALUE>
    <VALUE Lang="cn">只是稍微被打住而已…</VALUE>
    <VALUE Lang="cn">也不算什么,能挺住被打才能好好反击?</VALUE>
    <VALUE Lang="cn">登陆晚了点所以进度推迟~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_3_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_4_0">
    <VALUE Lang="GS">Oh!</VALUE>
    <VALUE Lang="GS">Thanks, this will be useful~</VALUE>
    <VALUE Lang="GS">I think I could defend myself better with this!</VALUE>
    <VALUE Lang="GS">Huh, I better catch to their skills as soon as I can.</VALUE>
    <VALUE Lang="id">Ah!</VALUE>
    <VALUE Lang="id">Terimakasih, akan saya gunakan dengan baik</VALUE>
    <VALUE Lang="id">Kalau ada ini pasti tidak akan dipukuli lagi oleh orang-orang itu kan!</VALUE>
    <VALUE Lang="id">Tunggu saja karena saya akan mengikuti kamu.</VALUE>
    <VALUE Lang="cn">啊!</VALUE>
    <VALUE Lang="cn">谢谢,我会好好用的~</VALUE>
    <VALUE Lang="cn">只要有这个就不会再被那些家伙打!</VALUE>
    <VALUE Lang="cn">等着瞧吧,我会追到的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_4_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_5_0">
    <VALUE Lang="GS">I transferred here from my old school~</VALUE>
    <VALUE Lang="GS">Then I found the school doesn't provide a dormitory… And it was so hard to enroll in anything.</VALUE>
    <VALUE Lang="GS">I'm going to quit... I want to go back!</VALUE>
    <VALUE Lang="id">Akukan tiba-tiba pindah sekolah padahal di sekolah yang lama juga tidak ada masalah~</VALUE>
    <VALUE Lang="id">Padahal sudah datang dari jauh..apa-apaan ini asrama saja tidak dapat</VALUE>
    <VALUE Lang="id">Tidak membantu saya untuk mendaftar dengan benar….</VALUE>
    <VALUE Lang="id">Aku nggak mau! Aku akan pergi lagi!</VALUE>
    <VALUE Lang="cn">上学好好的突然转学过来的~</VALUE>
    <VALUE Lang="cn">从大老远过来的，这是怎么回事连宿舍都没有…</VALUE>
    <VALUE Lang="cn">也不给注册…</VALUE>
    <VALUE Lang="cn">我不干了!我要回去</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_5_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_6_0">
    <VALUE Lang="GS">My friend told me that he'd find my document for me.</VALUE>
    <VALUE Lang="GS">So I'm waiting for him now.</VALUE>
    <VALUE Lang="GS">Hmmm, but he's still not here.</VALUE>
    <VALUE Lang="GS">Can you help me find that document?</VALUE>
    <VALUE Lang="id">Dia tidak muncul lagi hingga sekarang setelah berjanji untuk mengantarkan dokumen</VALUE>
    <VALUE Lang="id">Setidaknya kita harus tahu ada apa dan di mana baru kita bisa mencoba untuk mencarinya</VALUE>
    <VALUE Lang="id">Bisa bantu sedikit?</VALUE>
    <VALUE Lang="cn">我朋友说他已经为我找到文件了。所以我正在等他。</VALUE>
    <VALUE Lang="cn">嗯……但他一直没来耶。</VALUE>
    <VALUE Lang="cn">您可以帮我拿到那份文件吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_6_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_6_0_2">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_7_0">
    <VALUE Lang="GS">They don't like me... Maybe because of my scores?</VALUE>
    <VALUE Lang="GS">I'll need to study more than they do.</VALUE>
    <VALUE Lang="GS">Do you think you can teach me how to learn things better and more quickly?</VALUE>
    <VALUE Lang="id">Saya tidak pernah menyangka saya akan diperlakukan seperti ini hanya karena sedikit terlambat</VALUE>
    <VALUE Lang="id">Karena kamu tertinggal dalam proses pembelajaran bagaimana kalau kamu mencari sesuatu yang bisa dijadikan tambahan?</VALUE>
    <VALUE Lang="cn">他们不喜欢我，应该是分数的关系。我得比他们更用功念书才行。您可以教我如何念书才会念的又快又好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_7_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima permintaan</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_7_0_2">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak permintaan</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_8_0">
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="GS">They'll find me if they come back here.</VALUE>
    <VALUE Lang="GS">So I guess all I can do for now is just wait.</VALUE>
    <VALUE Lang="id">Terimakasih.</VALUE>
    <VALUE Lang="id">Apakah orang itu akan kembali atau tidak, saya tak tahu. Untuk itu saya akan tetap disini</VALUE>
    <VALUE Lang="cn">谢谢您。</VALUE>
    <VALUE Lang="cn">如果他们有回来的话，他们会来找我的。</VALUE>
    <VALUE Lang="cn">现在我能做的就只有等待。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_8_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_9_0">
    <VALUE Lang="GS">I'll study here by myself.</VALUE>
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="id">Terima kasih, boleh kan aku berlatih sendiri disini?</VALUE>
    <VALUE Lang="cn">我会在这边一个人好好念书。谢谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_zinu1.ntk_9_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0">
    <VALUE Lang="GS">Hi, hello~~</VALUE>
    <VALUE Lang="id">Hi~~</VALUE>
    <VALUE Lang="cn">嗨….. 您好！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_1">
    <VALUE Lang="GS">Listen to the Story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">倾听故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_2">
    <VALUE Lang="GS">Give Enrollment Form</VALUE>
    <VALUE Lang="id">Menyerahkan formulir pendaftaran.</VALUE>
    <VALUE Lang="cn">交付入学申请书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_3">
    <VALUE Lang="GS">Ask about Damage</VALUE>
    <VALUE Lang="id">Menyerahkann formulir pendaftaran.</VALUE>
    <VALUE Lang="cn">询问受害内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_4">
    <VALUE Lang="GS">Deliver the New Suit</VALUE>
    <VALUE Lang="id">Menyerahkan Uniform.</VALUE>
    <VALUE Lang="cn">交付新服饰</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_5">
    <VALUE Lang="GS">I want to help.</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_1_0_6">
    <VALUE Lang="GS">I want to help.</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_2_0">
    <VALUE Lang="GS">Ah... Thanks.</VALUE>
    <VALUE Lang="GS">Ah... Thanks.</VALUE>
    <VALUE Lang="GS">The officer just told me where I should look.</VALUE>
    <VALUE Lang="GS">That's why I couldn't do anything.</VALUE>
    <VALUE Lang="id">Kalau saja pegawai itu menjelaskan dengan benar saya pasti bisa mendatanginya secara langsung</VALUE>
    <VALUE Lang="id">Jadi selama ini aku tidak bisa mendaftar dan terus begini…</VALUE>
    <VALUE Lang="cn">噢…. 谢谢您。谢谢您。</VALUE>
    <VALUE Lang="cn">职员只有告诉我要去哪里找而已，所以我才一直都找不到。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_2_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_3_0">
    <VALUE Lang="GS">I can endure the beatings...</VALUE>
    <VALUE Lang="GS">Still, they really hurt, though…</VALUE>
    <VALUE Lang="GS">This school uniform doesn't really absorb any brunt either...</VALUE>
    <VALUE Lang="id">Anak-anak kecil datang menyerang terus memukul, sebenarnya kalau sakit sedikit aku masih bisa tahan tapi</VALUE>
    <VALUE Lang="id">Benar-benar sakit kan~</VALUE>
    <VALUE Lang="id">Memang seragam terlalu tipis jadi bermasalah…</VALUE>
    <VALUE Lang="cn">我能忍受挨打的滋味。虽然那真的很痛！不过…… 这校服也太薄了吧，如此的不堪一击。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_3_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_4_0">
    <VALUE Lang="GS">Oh, what are these clothes?</VALUE>
    <VALUE Lang="GS">They look sturdier... Maybe I'll even get the chance to fight back if someone hits me!</VALUE>
    <VALUE Lang="GS">Anyway, thanks. This'll be handy~</VALUE>
    <VALUE Lang="id">Kalau segini pasti bisa menahannya kan, anda saja bisa memukulnya sekali saja</VALUE>
    <VALUE Lang="id">Terimakasih, akan aku gunakan dengan baik~</VALUE>
    <VALUE Lang="cn">噢！这衣服是？嗯，看起来不错坚固唷。也许我会有机会反击揍我的那些人。</VALUE>
    <VALUE Lang="cn">总之，谢谢您！帮了我一个大忙了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_4_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_5_0">
    <VALUE Lang="GS">The weird thing is...</VALUE>
    <VALUE Lang="GS">The school campus is very nice!</VALUE>
    <VALUE Lang="GS">The classroom equipment is terrible, though.</VALUE>
    <VALUE Lang="GS">No air conditioning, no heating, no electric fans…</VALUE>
    <VALUE Lang="GS">Then I thought…</VALUE>
    <VALUE Lang="GS">Maybe…</VALUE>
    <VALUE Lang="GS">This school isn't for teaching academics to kids.</VALUE>
    <VALUE Lang="id">Anehnya…..</VALUE>
    <VALUE Lang="id">Perbaikan misalnya…soalnya dekorasi di luar itu sangat keren?</VALUE>
    <VALUE Lang="id">Tapi kenapa kok suasana kelasnya kayak suasana di 20 tahun yang lalu?</VALUE>
    <VALUE Lang="id">Jangankan AC kipas angin saja tidak ada kan….</VALUE>
    <VALUE Lang="id">Pada saat musim dingin itu dingin</VALUE>
    <VALUE Lang="id">Terus saya jadi</VALUE>
    <VALUE Lang="cn">有件很怪异的事情...</VALUE>
    <VALUE Lang="cn">学院真的很好！</VALUE>
    <VALUE Lang="cn">但教室的设备非常的恐怖。</VALUE>
    <VALUE Lang="cn">没有空调，没有暖气设备，没有电风扇...</VALUE>
    <VALUE Lang="cn">我想，也许是…. 没有教学的意愿？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_5_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_6_0">
    <VALUE Lang="GS">My friend told me that he'd find my document for me.</VALUE>
    <VALUE Lang="GS">So I'm waiting for him now.</VALUE>
    <VALUE Lang="GS">Hmmm, but he's still not here.</VALUE>
    <VALUE Lang="GS">Can you help me find that document?</VALUE>
    <VALUE Lang="id">Harus bagaimana lagi pegawai yang biasanya menerima pendaftaran hilang entah kemana dan tidak kembali</VALUE>
    <VALUE Lang="id">Saya begini karena tidak tahu harus bagaimana</VALUE>
    <VALUE Lang="id">Bisa bantu sedikit?</VALUE>
    <VALUE Lang="cn">我朋友说他已经为我找到文件了。所以我正在等他。</VALUE>
    <VALUE Lang="cn">嗯……但他一直没来耶。</VALUE>
    <VALUE Lang="cn">您可以帮我拿到那份文件吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_6_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima permintaan</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_6_0_2">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak permintaan</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_7_0">
    <VALUE Lang="GS">They don't like me... Maybe because of my scores?</VALUE>
    <VALUE Lang="GS">I'll need to study more than they do.</VALUE>
    <VALUE Lang="GS">Do you think you can teach me how to learn things better and more quickly?</VALUE>
    <VALUE Lang="id">Aku benar-benar tidak tahu bahwa aku akan diganggu hingga seperti ini</VALUE>
    <VALUE Lang="id">Karena kamu tertinggal dalam proses pembelajaran bagaimana kalau kamu mencari sesuatu yang bisa dijadikan tambahan?</VALUE>
    <VALUE Lang="id">Bisa bantu sedikit?</VALUE>
    <VALUE Lang="cn">他们不喜欢我，应该是分数的关系。我得比他们更用功念书才行。您可以教我如何念书才会念的又快又好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_7_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima permintaan</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_7_0_2">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak permintaan</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_8_0">
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="GS">They'll find me if they come back here.</VALUE>
    <VALUE Lang="GS">So I guess all I can do for now is just wait.</VALUE>
    <VALUE Lang="id">Apakah orang itu akan kembali atau tidak, saya tak tahu. Untuk itu saya akan tetap disini</VALUE>
    <VALUE Lang="cn">谢谢您。</VALUE>
    <VALUE Lang="cn">如果他们有回来的话，他们会来找我的。</VALUE>
    <VALUE Lang="cn">现在我能做的就只有等待。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_8_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_9_0">
    <VALUE Lang="GS">I'll study here by myself.</VALUE>
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="id">Makasih, boleh kan aku berlatih sendiri disini?</VALUE>
    <VALUE Lang="cn">我会在这边一个人好好念书。谢谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_ziny1.ntk_9_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_0">
    <VALUE Lang="GS">It's incredible that you're still alive. Aside from that, I've got nothing to talk to you about.</VALUE>
    <VALUE Lang="id">Kayaknya saya nggak ada urusan sama kamu…aneh banget kamu masih bisa bertahan dengan tubuh yang lemah kayak gitu</VALUE>
    <VALUE Lang="cn">我好像没什么事要跟你说。</VALUE>
    <VALUE Lang="cn">您这样脆弱，竟然还能活到现在，真是非常神奇。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_0_1">
    <VALUE Lang="GS">Ask about Problem</VALUE>
    <VALUE Lang="id">Bertanya ada apa</VALUE>
    <VALUE Lang="cn">询问有什么问题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_1">
    <VALUE Lang="GS">Ask About Sister</VALUE>
    <VALUE Lang="id">Adik saya? Ngomong apa sieh kamu?</VALUE>
    <VALUE Lang="cn">询问关于妹妹的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_1_1">
    <VALUE Lang="GS">Give the Letter</VALUE>
    <VALUE Lang="id">Menyampaikan letter</VALUE>
    <VALUE Lang="cn">传递信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_2">
    <VALUE Lang="GS">What are you holding? It looks like a letter…</VALUE>
    <VALUE Lang="id">Kamu bawa apa itu? Kayaknya itu letter</VALUE>
    <VALUE Lang="cn">您手中拿着什么呢？看起来很像是信件……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_2_1">
    <VALUE Lang="GS">Give the Letter</VALUE>
    <VALUE Lang="id">Menyampaikan letter</VALUE>
    <VALUE Lang="cn">交付信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_3">
    <VALUE Lang="GS">You said that letter is from Lee Zhen? Quick, give it to me!</VALUE>
    <VALUE Lang="id">Kamu bilang bawa letter dari Louis? Mana coba saya lihat</VALUE>
    <VALUE Lang="cn">您说信件是从Lee Zhen那儿寄来的吗？快把它交给我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_3_1">
    <VALUE Lang="GS">Give the Letter</VALUE>
    <VALUE Lang="id">Menyampaikan letter</VALUE>
    <VALUE Lang="cn">交付信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_4">
    <VALUE Lang="GS">I guess I was right… Would you please come back after the exam?</VALUE>
    <VALUE Lang="id">Tuh kan…ternyata perasaanku nggak salah…..selesai ujian terus langsung ke sini?</VALUE>
    <VALUE Lang="cn">我想我是对的。可以请您考完试后，再过来一趟吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_4_1">
    <VALUE Lang="GS">Tell the Results</VALUE>
    <VALUE Lang="id">Memberitahukan hasil</VALUE>
    <VALUE Lang="cn">告知结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5">
    <VALUE Lang="GS">You received limited abilities because you were late, but they should be enough for you for now.</VALUE>
    <VALUE Lang="id">Tidak banyak kemampuan yang bisa saya sampaikan kepada kamu, tapi saya yakin ini akan sangat membantu kamu karena itu ikuti saya</VALUE>
    <VALUE Lang="cn">因为你出现的比较晚,所以传授的能力,并不是很多.但是一定会对你有所帮助,请不要抱怨跟随我吧!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_1">
    <VALUE Lang="GS">Accept Confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">接受确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_2">
    <VALUE Lang="GS">Accept Confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">接受确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_3">
    <VALUE Lang="GS">Accept Confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">接受确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_4">
    <VALUE Lang="GS">Receive the Murakano Blood Sample.</VALUE>
    <VALUE Lang="id">Menerima Murakano Blood Sample.</VALUE>
    <VALUE Lang="cn">取得Murakano的血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_5">
    <VALUE Lang="GS">Deliver the Amanuoyin's Birthday Gift.</VALUE>
    <VALUE Lang="id">Mengantar Amanuoyin's Birthday Gift.</VALUE>
    <VALUE Lang="cn">传递Amanuoyin的生日礼物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_6">
    <VALUE Lang="GS">Deliver the Refine Pill.</VALUE>
    <VALUE Lang="id">Mengantar Refine Pill.</VALUE>
    <VALUE Lang="cn">传递Refine Pill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_7">
    <VALUE Lang="GS">Receive Amanuoruoyin's Second Request.</VALUE>
    <VALUE Lang="id">Menerima Amanuoruoyin's Second Request.</VALUE>
    <VALUE Lang="cn">取得Amanuoruoyin的第2道委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_1_5_8">
    <VALUE Lang="GS">Receive Amanuoruoyin's Last Request.</VALUE>
    <VALUE Lang="id">Menerima Amanuoruoyin's Last Request.</VALUE>
    <VALUE Lang="cn">取得Amanuoruoyin的最后一道委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_10_0">
    <VALUE Lang="GS">Keep building up your skills and abilities. You've got talent, but you can't stop learning and growing. You need to be stronger than your enemies!</VALUE>
    <VALUE Lang="id">Kayaknya karena kamu meningkatkan kemampuan secara rajin jurus yang kamu gunakan cukup bagus. Tapi dulu juga banyak sekali pelajar dengan jurus yang hebat tapi tetap saja tidak bisa menghentikan kekacauan. Kamu harus lebih kuat daripada mereka baru ada ke</VALUE>
    <VALUE Lang="cn">大概是因为持续不断的培养能力的缘故，你的技术非常的出色。过去虽然有许多学生具备高超的能力，但是也没能阻止混乱。您要比他们还要更出色，才会有胜算唷。就如过去一般。集中精神不停的去培养你的能力….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_11_0">
    <VALUE Lang="GS">I lied… I watched my sister slowly lose her humanity…</VALUE>
    <VALUE Lang="id">Bohong kamu..saya lihat dengan mata kepala saya sendiri ketika adik saya kehilangan kesadarannya…saya nggak punya adik</VALUE>
    <VALUE Lang="cn">我是骗您的… 我看着我妹妹渐渐地失去了人性与理智……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_11_0_1">
    <VALUE Lang="GS">Continue Story</VALUE>
    <VALUE Lang="id">Bercerita lebih banyak lagi</VALUE>
    <VALUE Lang="cn">故事继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_12_0">
    <VALUE Lang="GS">In that place, that one person...... All because of Professor Chui. No, it's my fault too! I hope my sister can forgive me. Please give my message to her, and ask her to be patient. I will go and save her from the suffering I caused her.</VALUE>
    <VALUE Lang="id">Di tempat kayak gitu?sendiri? Ini gara-gara Professor Choi….nggak, ini juga gara-gara saya. Saya mau meminta maaf kepada Amano(young). Tolong sampaikan pada Amano(young) kalau saya akan segera menyelamatkan dia…tunggu saya</VALUE>
    <VALUE Lang="cn">在那种地方，一个人…..都是因为Chui博士的关系。不！也有我的错！我要请求妹妹的原谅，因为我的关系，让她吃苦了。</VALUE>
    <VALUE Lang="cn">请你去告诉她，请她再忍耐一点，我一定会救她。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_13_0">
    <VALUE Lang="GS">Murakano Blood not only can create the Bloody weapon but it can awake the ability of the consumer…</VALUE>
    <VALUE Lang="id">Murakano Blood tidak hanya bisa membuat Bloody weapon tapi itu juga bisa membangkitkan nyawa penggunanya…</VALUE>
    <VALUE Lang="cn">Murakano的血不仅可被制作成血武器，还可以觉醒角色的能力……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_14_0">
    <VALUE Lang="GS">This… Prepared by my sister… It is so pathetic because of my despair.</VALUE>
    <VALUE Lang="GS">Time to wake myself and find the way to look for my sister…</VALUE>
    <VALUE Lang="id">Ini disiapkan oleh adik perempuan saya… Dia pasti sangat menderita sekarang.</VALUE>
    <VALUE Lang="id">Waktunya bangkit dan mencari adik perempuan saya…</VALUE>
    <VALUE Lang="cn">这个… 是我妹妹帮我准备的。真令人感到伤心欲绝。</VALUE>
    <VALUE Lang="cn">必须赶快打起精神！想办法找到她！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_15_0">
    <VALUE Lang="GS">I feel more calm now. Really thank you.</VALUE>
    <VALUE Lang="id">Saya merasa lebih tenang sekarang, benar - benar terima kasih.</VALUE>
    <VALUE Lang="cn">我现在比较冷静些了。真的很谢谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_16_0">
    <VALUE Lang="GS">It is not a big problem for you.</VALUE>
    <VALUE Lang="id">Bukanlah masalah besar bagimu.</VALUE>
    <VALUE Lang="cn">这对您来说应该是简单的事情。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_17_0">
    <VALUE Lang="GS">Sorry because of me you are in danger.</VALUE>
    <VALUE Lang="GS">I will not forget your kindness until I die..</VALUE>
    <VALUE Lang="id">Maaf karena saya kamu dalam masalah.</VALUE>
    <VALUE Lang="id">Saya tidak akan melupakan kebaikanmu..</VALUE>
    <VALUE Lang="cn">让你身陷危险真的很不好意思。</VALUE>
    <VALUE Lang="cn">这份恩情我绝对不会忘记的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_2_0">
    <VALUE Lang="GS">What? You don't know the current state of this horrific world?</VALUE>
    <VALUE Lang="id">Cerita apa? Jangan-jangan kamu kesana-kemari hanya karena mau latihan tanpa mengetahui keadaan dunia saat ini</VALUE>
    <VALUE Lang="cn">什么？您不知道这可怕世界的现状吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_3_0">
    <VALUE Lang="GS">Power… I have something to tell you.....</VALUE>
    <VALUE Lang="id">O, bagus juga….aku mau ngomong sesuatu sama kamu</VALUE>
    <VALUE Lang="cn">力量…我有些事情想告诉您.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_3_0_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_4_0">
    <VALUE Lang="GS">I used to be like you, and wanted to put an end to all of the world's madness. That changed after I entered the Financial Group Tower and found out about Professor Chui's Research Project.</VALUE>
    <VALUE Lang="id">Dulu saya dan teman-teman juga seperti kamu berusaha untuk menghentikan kekacauan eh nggak, mungkin saja dulu saya lebih ingin meningkatkan kekuatan,,,,pokoknya kita masuk ke Main building. Dan akhirnya kita tahu tentang penelitian yang dilakukan oleh Pro</VALUE>
    <VALUE Lang="cn">以前我也像你一样，和朋友一起想要阻止混乱，或许更想培养我们的能力的野心更大了也不一定。不管怎样，我就进入了Financial Group Tower，然后我知道了Chui博士的研究。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_4_0_1">
    <VALUE Lang="GS">I already told you about it…</VALUE>
    <VALUE Lang="id">Memberitahukan bahwa kamu sudah tahu tentang hal itu</VALUE>
    <VALUE Lang="cn">我已经告诉过您了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_5_0">
    <VALUE Lang="GS">Oh? Where did you hear this from? Who else knows about this?</VALUE>
    <VALUE Lang="GS">Lee Zhen?! Lee Zhen is still alive? Great, I need your help, please go and find Lee Zhen. He will know I sent you after you say my name, Amanuoruoyin.</VALUE>
    <VALUE Lang="id">Begitu? Kamu tahu dari mana? Yang tahu tentang masalah ini….</VALUE>
    <VALUE Lang="id">Louis? Louis masih hidup? Untung untung saja…Ada satu permintaan untuk kamu, bisa tolong beritahu Louis kalau saya ada di sini? Dia pasti tahu kalau kamu bilang Amanoruin</VALUE>
    <VALUE Lang="cn">这样啊? 你在哪里听到的? 知道这件事情的有…..</VALUE>
    <VALUE Lang="cn">Lee Zhen? Lee Zhen还活着? 太好了。真的是太好了。我有事请你帮忙。请去告诉Lee Zhen我在这里，只要说我的名字是 Amanuoruoyin，他就会知道了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_6_0">
    <VALUE Lang="GS">Erm… These things happen. Sorry, but can you help me to write a letter and give it to Lee Zhen?</VALUE>
    <VALUE Lang="id">Euhm…ada kejadian seperti ini rupanya. Maaf banget tapi bisa tolong bantu saya sesuatu? Saya akan tulis sebuah letter bisa tolong sampaikan itu kepada Louis?</VALUE>
    <VALUE Lang="cn">嗯… 原来有发生过这些事情.... 抱歉，但我可以请您帮我写信、并把该信件交给 Lee Zhen吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_7_0">
    <VALUE Lang="GS">It's okay, my help might not be all that great, but…</VALUE>
    <VALUE Lang="id">Kok makasih….mungkin saja saya nggak bisa membantu apa-apa</VALUE>
    <VALUE Lang="cn">不用谢。也许我的帮助不会有太多的影响。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_7_0_1">
    <VALUE Lang="GS">Ask About Past</VALUE>
    <VALUE Lang="id">Bertanya maksudnya apa</VALUE>
    <VALUE Lang="cn">询问过去的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_8_0">
    <VALUE Lang="GS">He said want to stop this chaotic situation, and develop his abilities. His biggest goal, though, was to find his lost sister. I couldn't do anything except leave her alone and save her friends. I still think I failed.</VALUE>
    <VALUE Lang="id">Saya bilang sih untuk menghentikan kekacauan atau untuk meningkatkan kekuatan sebenarnya saya melakuakn semua itu dengan harapan bisa menemukan adik saya. Akhirnya saya bisa ketemu dia…tapi saat melihat adik saya yang berubah sedikit demi sedikit saya tid</VALUE>
    <VALUE Lang="cn">他说要阻止混乱，又说要培养能力等等。其实是因为希望能找到妹妹才跟来的。后来我有遇到妹妹，但是看到渐渐改变的妹妹，我却无能为力。我能做的只是抛弃妹妹去救朋友，但是两件事我都失败了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_8_0_1">
    <VALUE Lang="GS">Continue Story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">故事继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_9_0">
    <VALUE Lang="GS">That's all I remember. You can go back now. I hope you can remember what I told you before.</VALUE>
    <VALUE Lang="id">Sampai sini..hanya itu yang bisa saya ingat tidak ada lagi yang bisa saya ceritakan…kamu boleh pergi sekarang, katanya sedang latihan, kamu harus selalu ingat bahwa kami banyak berharap sama kamu</VALUE>
    <VALUE Lang="cn">到此为止啊，我想起来的就是这些，再没有可说的了。您回去吧。我听说您还在修练中，请您记得我们对你抱着很大的期望。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_0">
    <VALUE Lang="GS">....</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_1">
    <VALUE Lang="GS">Hello? Why are you so hurry? Is there anything important?</VALUE>
    <VALUE Lang="id">Ada apa? Kamu terlihat sangat buru - buru sekali</VALUE>
    <VALUE Lang="cn">哈喽？您看起来好忙，发生何事了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_1_1">
    <VALUE Lang="GS">Deliver the Expedition Participation Letter.</VALUE>
    <VALUE Lang="id">Mengantar Expedition Participation Letter.</VALUE>
    <VALUE Lang="cn">传递 Expedition Participation Letter。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_10">
    <VALUE Lang="GS">skip</VALUE>
    <VALUE Lang="id">skip</VALUE>
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_2">
    <VALUE Lang="GS">How can I help you?</VALUE>
    <VALUE Lang="id">Ada yang bisa dibantu?</VALUE>
    <VALUE Lang="cn">我该如何帮您？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_2_1">
    <VALUE Lang="GS">Give Accessory [Collect Accessory]</VALUE>
    <VALUE Lang="id">Memberikan Aksesoris [Collect Accessory]</VALUE>
    <VALUE Lang="cn">交付零件[收集零件]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_3">
    <VALUE Lang="GS">How can I help you?</VALUE>
    <VALUE Lang="GS">You have anything you want to tell me?</VALUE>
    <VALUE Lang="id">Ada yang bisa saya bantu?</VALUE>
    <VALUE Lang="id">Ada yang ingin kamu sampaikan ke saya?</VALUE>
    <VALUE Lang="cn">我该如何帮您？</VALUE>
    <VALUE Lang="cn">您有话要对我说吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_3_1">
    <VALUE Lang="GS">Give Letter [Please Persuade Amanuoruoyin]</VALUE>
    <VALUE Lang="id">Menyerahkan Surat [Please Persuade Amanuoruoyin]</VALUE>
    <VALUE Lang="cn">传递信件 [请说服Amanuoruoyin]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_4">
    <VALUE Lang="GS">Who?</VALUE>
    <VALUE Lang="GS">How did you know I was here?</VALUE>
    <VALUE Lang="GS">Lucky you're a student....</VALUE>
    <VALUE Lang="GS">What happened with the researcher?</VALUE>
    <VALUE Lang="id">Siapa?</VALUE>
    <VALUE Lang="id">Bagaimana kamu tahu aku ada di sini?</VALUE>
    <VALUE Lang="id">Beruntung kamu adalah pelajar....</VALUE>
    <VALUE Lang="id">Apa yang terjadi dengan para peneliti?</VALUE>
    <VALUE Lang="cn">是谁呢？</VALUE>
    <VALUE Lang="cn">您怎么知道我在这儿？</VALUE>
    <VALUE Lang="cn">还好您只是学生。</VALUE>
    <VALUE Lang="cn">那个研究员怎么了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_4_1">
    <VALUE Lang="GS">Confirm Amanuoruoyin</VALUE>
    <VALUE Lang="id">Konfirmasi Amanuoruoyin</VALUE>
    <VALUE Lang="cn">确认Amanuoruoyin。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_5">
    <VALUE Lang="GS">If you are Wan Xing, you can surely help me.</VALUE>
    <VALUE Lang="id">Jika kamu adalah Wan Xing, tentu saya pasti akan membantumu</VALUE>
    <VALUE Lang="cn">如果您是 Wan Xing的话，那您一定可以帮上忙的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_5_1">
    <VALUE Lang="GS">Help</VALUE>
    <VALUE Lang="id">Menolong</VALUE>
    <VALUE Lang="cn">帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_6">
    <VALUE Lang="GS">You're here.</VALUE>
    <VALUE Lang="GS">Thank god you're here, I really appreciate it.</VALUE>
    <VALUE Lang="id">Terima Kasih Tuhan karena telah mengirimmu, Saya benar - benar senang.</VALUE>
    <VALUE Lang="cn">您来了啊！</VALUE>
    <VALUE Lang="cn">谢天谢地！我心存感激。 .</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_6_1">
    <VALUE Lang="GS">Handout</VALUE>
    <VALUE Lang="id">Menyerahkan</VALUE>
    <VALUE Lang="cn">分发</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7">
    <VALUE Lang="GS">Hi? We meet again.</VALUE>
    <VALUE Lang="GS">I don't know anything about it because I've been very busy. Say, why do you look so different from the other students?</VALUE>
    <VALUE Lang="id">Hi? Bertemu lagi.</VALUE>
    <VALUE Lang="id">Saya tidak bisa memberitahu apapun karena saya sangat sibuk. Emm~ kamu terlihat berbeda sekali dengan pelajar lain?</VALUE>
    <VALUE Lang="cn">嗨！我们又见面了。</VALUE>
    <VALUE Lang="cn">我不知道发生了何事，因为我超级忙。现在，请告诉我，为什么您长的跟其他学生不一样？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_1">
    <VALUE Lang="GS">Ask about Person</VALUE>
    <VALUE Lang="id">Bertanya tentang dia</VALUE>
    <VALUE Lang="cn">询问人是？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_2">
    <VALUE Lang="GS">Ask Him to Hear You Out</VALUE>
    <VALUE Lang="id">Minta toling supaya dia mendengarkan</VALUE>
    <VALUE Lang="cn">请他倾听您的故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_3">
    <VALUE Lang="GS">Handout</VALUE>
    <VALUE Lang="id">Menyerahkan</VALUE>
    <VALUE Lang="cn">分发</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_4">
    <VALUE Lang="GS">Ask Him to Hear You Out</VALUE>
    <VALUE Lang="id">Minta toling supaya dia mendengarkan</VALUE>
    <VALUE Lang="cn">请他倾听您的故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_5">
    <VALUE Lang="GS">Handout</VALUE>
    <VALUE Lang="id">Menyerahkan</VALUE>
    <VALUE Lang="cn">分发</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_6">
    <VALUE Lang="GS">Passing Information</VALUE>
    <VALUE Lang="id">Menyerahkan Informasi</VALUE>
    <VALUE Lang="cn">传递资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_7">
    <VALUE Lang="GS">Give the Letter</VALUE>
    <VALUE Lang="id">Menyerahkan Surat</VALUE>
    <VALUE Lang="cn">交付信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_8">
    <VALUE Lang="GS">Ask Him to Hear You Out</VALUE>
    <VALUE Lang="id">Minta toling supaya dia mendengarkan</VALUE>
    <VALUE Lang="cn">请他倾听您的故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7_9">
    <VALUE Lang="GS">Handout</VALUE>
    <VALUE Lang="id">Menyerahkan</VALUE>
    <VALUE Lang="cn">分发</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_8">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_9">
    <VALUE Lang="GS">skip</VALUE>
    <VALUE Lang="id">skip</VALUE>
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_10_0">
    <VALUE Lang="GS">I heard some student said he had the Yin Xi research report.</VALUE>
    <VALUE Lang="GS">They saw on the 50th Floor.</VALUE>
    <VALUE Lang="GS">Can you help me get it?</VALUE>
    <VALUE Lang="id">Saya mendengar bahwa beberapa pelajar mempunyai laporan penelitian Yin Xi.</VALUE>
    <VALUE Lang="id">Mereka terlihat di lantai 50.</VALUE>
    <VALUE Lang="id">Bisakah kamu membantu mengambilnya?</VALUE>
    <VALUE Lang="cn">我听到有些学生说他拥有Yin Xi 研究的报告。他们是在50楼看到的。您可以去帮我拿来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_11_0">
    <VALUE Lang="GS">Yin Xi is the same as me… We were both parts of a weird experiment.</VALUE>
    <VALUE Lang="GS">Did he know the truth?</VALUE>
    <VALUE Lang="GS">Does he know his grandfather did all this?</VALUE>
    <VALUE Lang="id">Yin Xi itu sama seperti saya… Kita adalah korban dari penelitian aneh.</VALUE>
    <VALUE Lang="id">Apakah dia tahu yang sebenarnya?</VALUE>
    <VALUE Lang="id">Apakah dia tahu kalau yang melakukan semua ini adalah kakeknya?</VALUE>
    <VALUE Lang="cn">Yin Xi 和我一样，我们都曾经历过可怕的实验。他应该晓得事实的真相吧？</VALUE>
    <VALUE Lang="cn">他是否知道自己的爷爷做了哪些事情呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_11_0_1">
    <VALUE Lang="GS">Talk about Chui Yin Xi</VALUE>
    <VALUE Lang="id">Bertanya tentang Chui Yin Xi</VALUE>
    <VALUE Lang="cn">聊聊Chui Yin Xi的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_12_0">
    <VALUE Lang="GS">Did you meet Yin Xi?</VALUE>
    <VALUE Lang="GS">You were training with Chui Yin Xi....</VALUE>
    <VALUE Lang="GS">Zhen, Ruoyin, Yin Xi, Da Xu</VALUE>
    <VALUE Lang="id">Apakah kamu bertemu dengan Yin Xi?</VALUE>
    <VALUE Lang="id">Jadi kamu latian bersama Chui Yin Xi....</VALUE>
    <VALUE Lang="id">Zhen, Ruoyin, Yin Xi, Da Xu</VALUE>
    <VALUE Lang="cn">您见到Yin Xi了吗？您跟Chui Yin Xi学习修炼方法了吗？Zhen、Ruoyin、Yin Xi、Da Xu都在耶！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_13_0">
    <VALUE Lang="GS">They should live their own lives as best they can now. I've learned enough to satisfy me. Now, it's time for me to give you some information.</VALUE>
    <VALUE Lang="GS">I gave all my experiment diaries were sent to Yin Xi. The writing's messy, but I tried to finish it early and send all the data to Lee Zhen and Chui Yin Xi.</VALUE>
    <VALUE Lang="id">Mereka seharusnya sih sekarang hidup bahagia. Saya juga sudah sangat bahagia jadi saya akan memberikan kamu informasi yang diperlukan.</VALUE>
    <VALUE Lang="id">Saya memberikan semua data penelitian saya kepada Yin Xi. Acak - acakan sih tapi saya merapikannya dan akan mengirimn</VALUE>
    <VALUE Lang="cn">他们现在应该过得很好。我也学到了某种程度上的牺牲小我，完成大我。现在，是我该提供您情报的时候了。</VALUE>
    <VALUE Lang="cn">我全部的实验日志都寄给 Yin Xi了。笔迹虽缭乱，但我试着要早点全数完成，最后我要把它们寄给 Lee Zhen和 Chui Yin Xi。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_13_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_14_0">
    <VALUE Lang="GS">Oh....Thank you... I'm very happy because I was able to survive for the sake of meeting my brother. Thanks again.</VALUE>
    <VALUE Lang="id">Terima Kasih... Saya sangat senang karena saya sudah bisa bertemu dengan kakak saya lagi.</VALUE>
    <VALUE Lang="cn">噢…..谢谢您！我很开心，因为我可以活着去见我的哥哥了！谢谢您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_14_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_15_0">
    <VALUE Lang="GS">The accessory needed to start the Human Segregator progress can probably be found in the underground laboratory.</VALUE>
    <VALUE Lang="id">Aksesoris diperlukan untuk memulai proses dapat ditemukan di laboratori bawah tanah</VALUE>
    <VALUE Lang="cn">启动人体分离器时，需要些许的零件辅助。您可以在地下室的图书馆找到它们。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_15_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_16_0">
    <VALUE Lang="GS">I still need to be careful. Someone else may find me, and then… Anyway, after we meet again, I'll tell you more about my story.</VALUE>
    <VALUE Lang="id">Saya masih harus berhati - hati. Mereka pasti masih mencari saya dan… Ayo kapan - kapan kita bertemu lagi dan akan kuceritakan lebih lanjut.</VALUE>
    <VALUE Lang="cn">我仍需要小心行事，因为某人可能会找到我。但……. 嗯。总之，下次我们在见面时，再告诉您更多的事情。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_16_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_17_0">
    <VALUE Lang="GS">Oh, you already got it, thank you so much. I'm not sure whether I can successfully complete the process, though…</VALUE>
    <VALUE Lang="id">Oh, kamu sudah mendapatkannya, terima kasih. Saya tidak yakin bisa menyelesaikan prosesnya sih…</VALUE>
    <VALUE Lang="cn">噢！您已经拿到了！太谢谢您了。我不是很确定是否可以完成这部分，但是……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_17_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_18_0">
    <VALUE Lang="GS">Now I'll keep living since I know my brother is still alive...Thank you so much for sending that letter to me. Let me know if you ever need my help.</VALUE>
    <VALUE Lang="id">Sekarang saya akan tetap hidup karena saya tahu kakak saya masih di luar sana…Terima kasih sudah mengantar surat ini.</VALUE>
    <VALUE Lang="cn">现在我知道我的哥哥还活着！这让我重新燃起了活下去的意志。真的很谢谢您传达这封信件给我。如果您有困难，也请让我知道。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_18_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_19_0">
    <VALUE Lang="GS">These are all definitely accessories, but these don't look like they'll be enough. Please collect more for me when you have some free time.</VALUE>
    <VALUE Lang="id">Tolong kumpulkan lagi beberapa aksesorisnya karena saat ini kami kekurangan beberapa.</VALUE>
    <VALUE Lang="cn">这些的确都是零件，但看起来都还不太足够。请您有空时，帮我多收集一些。好吗？谢谢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_19_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_2_0">
    <VALUE Lang="GS">I heard that this building, 1F, contains plenty of information.</VALUE>
    <VALUE Lang="GS">I don't know the name of the file or whatever it is I need there…</VALUE>
    <VALUE Lang="GS">But can you help me get it?</VALUE>
    <VALUE Lang="GS">As you know, it's very dangerous inside this building.</VALUE>
    <VALUE Lang="GS">Just be careful~</VALUE>
    <VALUE Lang="id">Saya dengar di lantai 1 gedung ini mengandung banyak informasi.</VALUE>
    <VALUE Lang="id">Saya tidak tahu nama dokumen ataupun peralatan lain yang saya butuhkan di sini…</VALUE>
    <VALUE Lang="id">Bisakah kamu membantu saya mencarikannya?</VALUE>
    <VALUE Lang="id">Sekedar informasi, di sini sangat berbahaya jadi hati - hati</VALUE>
    <VALUE Lang="cn">我听说这栋建筑物的1F里面有许多资料。</VALUE>
    <VALUE Lang="cn">我不清楚档案的名称，也不知道内容为何。不过，您可以帮我找到它的，对吗？ 另外，我想您应该已经知道，大楼内部危险重重，请您小心行动。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_20_0">
    <VALUE Lang="GS">Request has been checked. Please let him know that I will prepare and deliver it to expedition section.</VALUE>
    <VALUE Lang="id">Permintaan sudah diperiksa. Beritahu bahwa kamu akan mengantarnya ke Expedition Section</VALUE>
    <VALUE Lang="cn">邀请函已确认完成。请告诉他，我会准备并发送邀请函至远征队。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_3_0">
    <VALUE Lang="GS">First you'll need to arrange and organize all your information.</VALUE>
    <VALUE Lang="GS">Seems you have plenty to do. Take care.</VALUE>
    <VALUE Lang="id">Pertama kamu harus mengatur dan merapikan semua informasi yang kamu dapat.</VALUE>
    <VALUE Lang="id">Sepertinya banyak yang harus kamu lakukan, selamat mengerjakan~</VALUE>
    <VALUE Lang="cn">首先，您想要统整一下资料。似乎量很多。请加油。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_4_0">
    <VALUE Lang="GS">Aiya! I'm Amaruoyin!</VALUE>
    <VALUE Lang="GS">I don't know why I'm here.</VALUE>
    <VALUE Lang="id">Aiya! Saya adalah  Amaruoyin!</VALUE>
    <VALUE Lang="id">Saya tidak tahu kenapa saya di sini!!</VALUE>
    <VALUE Lang="cn">哎呀！我叫Amaruoyin！</VALUE>
    <VALUE Lang="cn">我不知道我是怎么来到这儿的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_4_0_1">
    <VALUE Lang="GS">Ask about Amanuoruoyin</VALUE>
    <VALUE Lang="id">Bertanya tentang Amanuoruoyin</VALUE>
    <VALUE Lang="cn">询问 Amanuoruoyin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_5_0">
    <VALUE Lang="GS">Ruoyin? Is it? You're still alive?</VALUE>
    <VALUE Lang="GS">Ruoyin is my brother, but we had to part many years ago.</VALUE>
    <VALUE Lang="GS">I met him again recently, but…</VALUE>
    <VALUE Lang="id">Ruoyin? Apakah kamu masih hidup?</VALUE>
    <VALUE Lang="id">Ruoyin adalah kakak saya, tapi kami terpisah beberapa tahun lalu.</VALUE>
    <VALUE Lang="id">Saya bertemu dia akhir - akhir ini, tetapi…</VALUE>
    <VALUE Lang="cn">Ruoyin？是你吗?你还活着？</VALUE>
    <VALUE Lang="cn">Ruoyin是我哥，但我们几年前不得已被</VALUE>
    <VALUE Lang="cn">拆散了。最近我有再遇到他，但是…………</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_5_0_1">
    <VALUE Lang="GS">Continue to Listen</VALUE>
    <VALUE Lang="id">Lanjut Mendengarkan</VALUE>
    <VALUE Lang="cn">继续听</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_5_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_6_0">
    <VALUE Lang="GS">My body started to mutate into what you call a spirit clone… I had to leave my brother. It hurts, and I know there's some problem in this process…</VALUE>
    <VALUE Lang="id">Badan saya mulai bermutasi menjadi seperti yang kamu sebut roh jelmaan… Saya harus meninggalkan kakak saya. Sakit, tapi saya harus melakukannya</VALUE>
    <VALUE Lang="cn">我的身体开始突变，就像是您说的，一种复制灵的东西…。我当时必须忍痛离开我的哥哥，一定是处理过程中发生了错误，才会变成这样。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_7_0">
    <VALUE Lang="GS">I heard my name in the report during the research process.</VALUE>
    <VALUE Lang="GS">All the research information can be found in 30F Research Information Room 4. Can you help me get it?</VALUE>
    <VALUE Lang="id">Saya mendengar nama saya disebut di laporan</VALUE>
    <VALUE Lang="id">Semua laporan penelitian dapat ditemukan di lantai 30 Research Information Kamar Nomor 4. Bisakah kamu membantu mengambilnya?</VALUE>
    <VALUE Lang="cn">我听到我的名字被记载在研究报告里。在30楼的Research Information Room 4 里面能找到全部的研究资料。您能帮我拿过来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_8_0">
    <VALUE Lang="GS">Thank you very much for your help.</VALUE>
    <VALUE Lang="id">Terima Kasih atas bantuanmu!!</VALUE>
    <VALUE Lang="cn">非常感谢您的帮忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_8_0_1">
    <VALUE Lang="GS">Inform Amaruoyin that She was a Test</VALUE>
    <VALUE Lang="id">Memberitahu Amaruoyin bahwa dia adalah ujian!</VALUE>
    <VALUE Lang="cn">告诉 Amaruoyin她曾经是实验对象之一</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_9_0">
    <VALUE Lang="GS">Yes, I know, but I'm not sure what the experiment was…</VALUE>
    <VALUE Lang="GS">Maybe the report will let me know the truth.</VALUE>
    <VALUE Lang="id">Yah saya tahu, tapi saya tidak tahu tentang apa penelitiannya…</VALUE>
    <VALUE Lang="id">Mungkin dari laporannya kita bisa mengetahui sesuatu?</VALUE>
    <VALUE Lang="cn">是的。我知道。但我不清楚实验的内容为何。 也许这份报告会为我们揭开心中的疑惑。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_0">
    <VALUE Lang="GS">Who are you? You look useless... And nothing can help me. Please just get out of here, okay?</VALUE>
    <VALUE Lang="id">Kamu siapa? Kayaknya kamu belum punya cukup kekuatan untuk membantu aku. Kalau nggak ada yang kamu perlukan lagi bisa tolong pergi sekarang?</VALUE>
    <VALUE Lang="cn">您是谁？您似乎能力还不够。而且，您没有我要的东西。总之，先请您离开吧，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_0_1">
    <VALUE Lang="GS">How can I help you?</VALUE>
    <VALUE Lang="id">Bertanya apa yang bisa dibantu</VALUE>
    <VALUE Lang="cn">我该怎么帮您呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_0_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_1">
    <VALUE Lang="GS">What happened?</VALUE>
    <VALUE Lang="GS">You have anything you want to give me?</VALUE>
    <VALUE Lang="id">Iya, ada apa?</VALUE>
    <VALUE Lang="id">Apa itu yang ada di tangan kamu? Kayaknya itu item yang akan kamu serahkan pada saya</VALUE>
    <VALUE Lang="cn">发生何事了？</VALUE>
    <VALUE Lang="cn">您要给我什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_1_1">
    <VALUE Lang="GS">Give the Accessory. [Collect Accessory].</VALUE>
    <VALUE Lang="id">Serahkanlah Accessory (kumpulkanlah Accessory)</VALUE>
    <VALUE Lang="cn">交付零件 [收集零件].</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_10">
    <VALUE Lang="GS">Wait a minute, what is this?</VALUE>
    <VALUE Lang="GS">Hmm... Do you want to get stronger? I can help you do that.</VALUE>
    <VALUE Lang="id">Sebentar,,,,energi ini apa ini?</VALUE>
    <VALUE Lang="id">Aku sarankan satu hal. Kamu mau lebih kuat daripada siapapun kan? Aku kayaknya bisa membantu kamu…</VALUE>
    <VALUE Lang="cn">等一下！这是什么呢?</VALUE>
    <VALUE Lang="cn">您想变的更强壮吗? 我可以帮您唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_10_1">
    <VALUE Lang="GS">Accept</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_10_2">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_11">
    <VALUE Lang="GS">Wait a minute, what is this?</VALUE>
    <VALUE Lang="GS">Hmm... Do you want to get stronger? I can help you do that.</VALUE>
    <VALUE Lang="id">Sebentar,,,,energi ini apa ini?</VALUE>
    <VALUE Lang="id">Aku sarankan satu hal. Kamu mau lebih kuat daripada siapapun kan? Aku kayaknya bisa membantu kamu…</VALUE>
    <VALUE Lang="cn">等一下！这是什么呢?</VALUE>
    <VALUE Lang="cn">您想变的更强壮吗? 我可以帮您唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_11_1">
