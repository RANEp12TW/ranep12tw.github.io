    <VALUE Lang="cn">制作Aspirin I</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_scmasterpat.ntk_1_0_12">
    <VALUE Lang="GS">Produce Aspirin III</VALUE>
    <VALUE Lang="id">Produksi aspirin III</VALUE>
    <VALUE Lang="cn">制作Aspirin III</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_scmasterpat.ntk_1_0_13">
    <VALUE Lang="GS">Returned Obinine</VALUE>
    <VALUE Lang="id">Kembalinya Obinine</VALUE>
    <VALUE Lang="cn">重生的Obinine</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_scmasterpat.ntk_1_0_14">
