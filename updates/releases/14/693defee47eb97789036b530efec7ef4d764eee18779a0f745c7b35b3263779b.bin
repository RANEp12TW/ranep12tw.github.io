  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_1_0">
    <VALUE Lang="GS">Welcome to the Abandoned Desert, the place to challenge to your limit.</VALUE>
    <VALUE Lang="cn">欢迎来到Abandoned Desert。在此您可挑战自身的极限！</VALUE>
    <VALUE Lang="id">Selamat datang di Abandoned Desert, tempat yang menantang kamu sampai batas.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_1_0_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="cn">交易</VALUE>
    <VALUE Lang="id">Tukar</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_1_0_2">
    <VALUE Lang="GS">First Request</VALUE>
    <VALUE Lang="cn">第一个请求</VALUE>
    <VALUE Lang="id">Permintaan Pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_1_0_3">
    <VALUE Lang="GS">Second Request</VALUE>
    <VALUE Lang="cn">第二个请求</VALUE>
    <VALUE Lang="id">Permintaan Kedua</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_2_0">
    <VALUE Lang="GS">Thank you for doing me the favor. I wish you good luck in your path.</VALUE>
    <VALUE Lang="cn">谢谢您的帮忙。祝您一帆风顺！</VALUE>
    <VALUE Lang="id">Terima Kasih sudah membantu saya. Kudoakan semoga kamu beruntung selalu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_limitdesert.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_1_0">
    <VALUE Lang="GS">It is the First Floor Hall Terminal.</VALUE>
    <VALUE Lang="id">Ini adalah 1F Lobby Terminal</VALUE>
    <VALUE Lang="cn">这是First Floor Hall Terminal。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_1_0_1">
    <VALUE Lang="GS">Retrieve Information</VALUE>
    <VALUE Lang="id">Mencari informasi</VALUE>
    <VALUE Lang="cn">检索资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_1_0_2">
    <VALUE Lang="GS">Distribute Memento Bread to New Students</VALUE>
    <VALUE Lang="id">Meminta Bread yang dibagikan kepada pelajar baru</VALUE>
    <VALUE Lang="cn">发送纪念面包给新生</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_1_0_3">
    <VALUE Lang="GS">Distribute Memento Bread to New Students</VALUE>
    <VALUE Lang="id">Meminta Bread yang dibagikan kepada pelajar baru</VALUE>
    <VALUE Lang="cn">发送纪念面包给新生</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_1_0_4">
    <VALUE Lang="GS">Distribute Memento Bread to New Students</VALUE>
    <VALUE Lang="id">Meminta Bread yang dibagikan kepada pelajar baru</VALUE>
    <VALUE Lang="cn">发送纪念面包给新生</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_1_0_5">
    <VALUE Lang="GS">Begin Change of Position</VALUE>
    <VALUE Lang="id">Mengubah posisi awal</VALUE>
    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_2_0">
    <VALUE Lang="GS">The internet connection isn't working properly; we can't obtain any information for now.</VALUE>
    <VALUE Lang="id">Karena jaringan buruk, pencarian informasi tidak dapat dilakukan</VALUE>
    <VALUE Lang="cn">由于网路连接状况不佳，我们无法马上接收情报。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_2_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_3_0">
    <VALUE Lang="GS">Welcome.</VALUE>
    <VALUE Lang="GS">We have prepared some gifts for the new batch of students.</VALUE>
    <VALUE Lang="GS">Please help yourself to some bread when you enter the Main Center.</VALUE>
    <VALUE Lang="GS">If you do not know where to find the entrance, press the "M" key to display the game map.</VALUE>
    <VALUE Lang="GS">Pressing the "H" key will also help you in other areas. Please go ahead and try it out.</VALUE>
    <VALUE Lang="id">Selamat datang</VALUE>
    <VALUE Lang="id">Kami telah menyiapkan hadiah spesial untuk para pelajar baru</VALUE>
    <VALUE Lang="id">Kami telah menyiapkan Breads di sekitar Main Gate, ambil dan konfirmasikan</VALUE>
    <VALUE Lang="id">Apabila tidak mengetahui dimana lokasinya, tekanlah tombol 'M' pada keyboard untuk menampilkan</VALUE>
    <VALUE Lang="cn">欢迎光临。</VALUE>
    <VALUE Lang="cn">我们准备了许多礼物要给新生。请您前往Main Center领取面包。</VALUE>
    <VALUE Lang="cn">若找不到入口处，请按下键盘的‘M'键，打开地图画面，并搜寻其位置。另外，H键也可以作参考。快试试看吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_loby.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
