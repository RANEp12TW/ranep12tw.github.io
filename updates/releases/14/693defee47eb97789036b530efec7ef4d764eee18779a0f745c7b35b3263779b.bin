  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_10_0_4"><VALUE Lang="tw">兌換 鐵頭功（7級／格鬥部）</VALUE><VALUE Lang="GS">Skill book: Metal Head (Lv7, Class=65, Item=174/41)</VALUE><VALUE Lang="id">Skill book: Metal Head (Lv7, Class=65, Item=174/41)</VALUE><VALUE Lang="cn">Skill book: Metal Head (Lv7, Class=65, Item=174/41)</VALUE><VALUE Lang="th">Skill book: Metal Head (Lv7, Class=65, Item=174/41)</VALUE></SENTENSE>
