  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_19_0">
    <VALUE Lang="GS">가져가서 한번 확인 좀 해 봐라</VALUE>
    <VALUE Lang="id">가져가서 한번 확인 좀 해 봐라</VALUE>
    <VALUE Lang="cn">가져가서 한번 확인 좀 해 봐라</VALUE>
