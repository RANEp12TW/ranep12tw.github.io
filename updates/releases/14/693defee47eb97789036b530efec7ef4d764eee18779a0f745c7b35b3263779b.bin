    <VALUE Lang="GS">Exchange to 10th Grade of Spirit Sphere</VALUE>
    <VALUE Lang="cn">兑换 10th Grade 灵珠</VALUE>
    <VALUE Lang="id">Tukar dengan 10th Grade of Spirit Sphere</VALUE>
  </SENTENSE>
