    <VALUE Lang="id">처음으로</VALUE>
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0">
    <VALUE Lang="GS">Where are you injured?</VALUE>
    <VALUE Lang="id">Di bagian mana kamu terluka?</VALUE>
    <VALUE Lang="cn">您那里受伤了呢?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0_1">
    <VALUE Lang="GS">Ask about the Strange Person</VALUE>
    <VALUE Lang="id">Bertanya tentang Orang-orang tak dikenal</VALUE>
    <VALUE Lang="cn">询问关于怪人</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0_2">
    <VALUE Lang="GS">Ask about the Strange Person's Identity</VALUE>
    <VALUE Lang="id">Bertanya siapa anda</VALUE>
    <VALUE Lang="cn">询问关于怪人的身份</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0_3">
    <VALUE Lang="GS">Ask about the Healing Treatment Situation</VALUE>
    <VALUE Lang="id">Bertanya tentang pengobatan</VALUE>
    <VALUE Lang="cn">询问关于康复治疗的现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0_4">
    <VALUE Lang="GS">Nurse's Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan Nurse</VALUE>
    <VALUE Lang="cn">护士的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0_5">
    <VALUE Lang="GS">Give the Medicine</VALUE>
    <VALUE Lang="id">Menyerahkan Medicines</VALUE>
    <VALUE Lang="cn">交出药品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0_6">
    <VALUE Lang="GS">Ask about the bad adults</VALUE>
    <VALUE Lang="id">Bertanya tentang Bad Man</VALUE>
    <VALUE Lang="cn">询问关于叛逆大人</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0_7">
    <VALUE Lang="GS">Tell her what happened</VALUE>
    <VALUE Lang="id">Bercerita tentang hal yang terjadi</VALUE>
    <VALUE Lang="cn">告诉她发生了啥事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0_8">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">变更起点位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_1_0_9">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_10_0">
    <VALUE Lang="GS">Thank you very much. These medicines should last for some time. It's lucky that not too many people are getting injured.</VALUE>
    <VALUE Lang="id">Akhirnya semua Medicines telah habis~</VALUE>
    <VALUE Lang="id">Terima kasih karena mau membantu</VALUE>
    <VALUE Lang="cn">谢谢您，幸好伤患没有一直增加，这些药应该还可以再撑一阵子。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_11_0">
    <VALUE Lang="GS">.....</VALUE>
    <VALUE Lang="id">.....</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_12_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_13_0">
    <VALUE Lang="GS">..</VALUE>
    <VALUE Lang="id">..</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_14_0">
    <VALUE Lang="GS">........</VALUE>
    <VALUE Lang="id">........</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_15_0">
    <VALUE Lang="GS">The Medicine can be acquired from the Nurse located at the Sacred Gate Ring. Are you willing to get those medicines for me?</VALUE>
    <VALUE Lang="id">Nurse di Sacred Gate Ring sedang memberikan Medicines</VALUE>
    <VALUE Lang="id">Maukah kamu mengambilkannya?</VALUE>
    <VALUE Lang="cn">可以到Sacred Gate Ring的护士小姐那儿，帮我拿药品吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_15_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_16_0">
    <VALUE Lang="GS">Although we could ask for help from the hospital in the neighboring city, I heard that it's not possible to go through the tunnel because there's something blocking the path inside.</VALUE>
    <VALUE Lang="id">Jika sampai ke kota sebelah saja, kita bisa mendapatkan bantuan dari Rumah sakit disana. Tetapi ada rumor jika tunnel penghubung mengalami penyumbatan dan tidak bisa di lewati</VALUE>
    <VALUE Lang="cn">的确是可以求助于附近的城市医院，但在通往对面的隧道里，有着不明的东西卡在入口，我们得找找其他方法。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_16_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_17_0">
    <VALUE Lang="GS">We're all locked up in here!</VALUE>
    <VALUE Lang="id">Mungkin juga kita akan terjebak selamanya disini…</VALUE>
    <VALUE Lang="cn">我们被关起来了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_17_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_18_0">
    <VALUE Lang="GS">.....</VALUE>
    <VALUE Lang="id">.....</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_19_0">
    <VALUE Lang="GS">Ah! There's one more thing you should know. It seems that the tunnel is block by some strange creatures and this toxic gas.</VALUE>
    <VALUE Lang="id">Ahhaa, dan ada satu berita.</VALUE>
    <VALUE Lang="id">Penyebab penyumbatan di dalam Tunnel itu adalah gas dan para binatang</VALUE>
    <VALUE Lang="cn">噢！还有件情报一定要让你知道！卡在隧道里面的，是畸形生物和烈毒瓦斯。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_19_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_2_0">
    <VALUE Lang="GS">.....</VALUE>
    <VALUE Lang="id">.....</VALUE>
    <VALUE Lang="cn">……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_20_0">
    <VALUE Lang="GS">I heard that we would find it difficult to breathe inside that area, and that even wearing a gas mask is useless.</VALUE>
    <VALUE Lang="id">Jika masuk ke dalam akan membuat napas menjadi sesak, dan penggunaan alat pernapasan pun juga akan sia-sia saja</VALUE>
    <VALUE Lang="cn">听说在里面呼吸会感到困难，就算戴上防毒面具也都没用。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_20_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_21_0">
    <VALUE Lang="GS">A student named Zhen from the Combat Section claims he's got some other way of passing through that place.</VALUE>
    <VALUE Lang="id">Tetapi. Jin pelajar kelas Brawler mengatakan, ada cara untuk melewati Tunnel tersebut</VALUE>
    <VALUE Lang="cn">在格斗部，有个叫作Zhen的学生，声称他曾利用某种方法，成功通过那条隧道。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_21_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_22_0">
    <VALUE Lang="GS">They are just a shameful adults.. You will be able to find Drunkards on the way to Rotary. They could not stop their old habits before the phenomenon. They are stealing rubbing alcohol and I cannot cure the students. I hope someone can stop them.</VALUE>
    <VALUE Lang="id">Orang jahat? Jika pergi ke arah Ring, disana ada para Drunkard. Saya tidak bisa menghilangkan kebiasaan lamaku. Setiap malam saya mencuri alkohol sehingga tidak bisa membantu para pelajar. Jika ada yang mencegahku pasti akan lebih baik.</VALUE>
    <VALUE Lang="cn">他们只不过是些没教养的中年人。您可以在前往Rotary的路上看见这些Drunkard。他们无法停止在异变发生之前的老习惯。 因为他们一直在偷消毒酒精，导致我无法治疗这些学生。我希望各位可以阻止他们。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_22_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_23_0">
    <VALUE Lang="GS">Don't blame yourself! If they had a little piece of human in them then might have tried to cure them but they already are no longer human beings.. Well, anyways, I would be able to sleep at night now. Thank you!</VALUE>
    <VALUE Lang="id">Jangan menyalahkan diri sendiri. Jika ada orang lain pasti kamu sudah diobati. Karena tampaknya mereka bukan lah orang sungguhan.. Untungnya hal yang membuatku begadang sudah mulai berkurang. Makasih ya.</VALUE>
    <VALUE Lang="cn">不要太自责了！ 如果他们还有点人性的话，应早就治疗痊愈了。既然他们已不再是人类，就别想太多了。至少我们现在可以晚上睡觉了。都是您的功劳。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_23_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回首页。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_3_0">
    <VALUE Lang="GS">They started appearing not too long ago. There was only one at first, but then they started multiplying and spread all over the Campus area.</VALUE>
    <VALUE Lang="GS">I don't think they're capable of masterminding or carrying out all of this chaos.</VALUE>
    <VALUE Lang="id">Mereka mulai terlihat beberapa saat lalu. Awalnya hanya ada beberapa tetapi perlahan mereka semakin banyak berkeliaran di kampus...</VALUE>
    <VALUE Lang="id">Menurut saya, mereka mungkin bukanlah otak dibalik semua kekacauan ini.</VALUE>
    <VALUE Lang="cn">这些怪物是最近才出现的。原本只有1只，但后来竟迅速大量地蔓延至学院各个角落里。不过它们看起来似乎很温驯善良。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_4_0">
    <VALUE Lang="GS">Just look at me. I don't have a choice but to sell and take care of the medicine here. My body has mutated too, just like everyone else. It's lucky that my mind has not been affected, though.</VALUE>
    <VALUE Lang="id">Lihat saya. Saya tidak mempunyai pilihan lain selain menjual obat saya di sini. Tubuh saya juga dimutilasi seperti yang lainnya. Untung saja otak saya tidak terkena.</VALUE>
    <VALUE Lang="cn">看看我的样子吧。我没有别的选择，只好在这里贩卖与管理药品。我的身体已经被感染，很其他人一样突变了。不过，我很幸运的是，我的脑部还是正常的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_5_0">
    <VALUE Lang="GS">I'm sure you know the basics since you're already here, but there are still two things I want to teach you.</VALUE>
    <VALUE Lang="id">Saya yakin kamu sudah mengetahui dasarnya. Akan tetapi, saya masih harus mengajarkan 2 hal kepadamu.</VALUE>
    <VALUE Lang="cn">您熬过来了！我想，现在您的基础一定很很扎实。不过，还有两件事情您需要知道。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_5_0_2">
    <VALUE Lang="GS">Ask about Effects of Petrification</VALUE>
    <VALUE Lang="id">Bertanya tentang Efek dari Petrification</VALUE>
    <VALUE Lang="cn">询问Petrification的影响</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_5_0_3">
    <VALUE Lang="GS">Ask about Effects of Confusion</VALUE>
    <VALUE Lang="id">Bertanya tentang Efek dari Confusion</VALUE>
    <VALUE Lang="cn">询问Confusion的影响</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_6_0">
    <VALUE Lang="GS">I'm sorry that my memory still hasn't fully recovered yet. I might end up helping or harming you with my medical skills. I hope you understand the risks.</VALUE>
    <VALUE Lang="id">Maaf, memori saya masih belum pulih benar. Mungkin saya bisa mencederaimu dengan cara pengobatan saya. Saya harap kamu bisa mengerti resiko nya.</VALUE>
    <VALUE Lang="cn">抱歉，我的记忆力似乎尚未完全恢复。也许我该停止帮您了。否则，说不定我会用我的医术来伤害你….。请见谅。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_7_0">
    <VALUE Lang="GS">Petrification makes the body like stone: the victim is immobilized, but his Defense ironically increases.</VALUE>
    <VALUE Lang="id">Petrification membuat tubuh kuat seperti batu: gerak terbatas akan tetapi pertahanannya meningkat tajam.</VALUE>
    <VALUE Lang="cn">Petrification会硬化身体，像石头一样。但讽刺的是，防御力会增加。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_8_0">
    <VALUE Lang="GS">This condition is characterized by the victim getting very dizzy. The Attack and Accuracy Rate of the victim is reduced by half, making him weak against his enemies. The moment SP (Stamina Point) is consumed, the victim will be in grave danger.</VALUE>
    <VALUE Lang="id">"Saya pikir kita bisa menyebutnya sebagai keadaan yang memusingkan</VALUE>
    <VALUE Lang="id">.</VALUE>
    <VALUE Lang="id">Sama halnya dengan kondisi pada saat stamina menurun, situasi dimana Hit Attack dan Rate menurun</VALUE>
    <VALUE Lang="id">.</VALUE>
    <VALUE Lang="id">"</VALUE>
    <VALUE Lang="id">This condition is characterized by the victim getting very dizzy. The Attack and Acc</VALUE>
    <VALUE Lang="cn">该到影响的人，其症状是晕眩，攻击力和命中率减半。在敌人面前，攻击力会变弱。当SP值变低时，将遭到巨大的冲击。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_9_0">
    <VALUE Lang="GS">All the medicine has just been used up. What am I going to do? There are people that still need treatment, so I'm glad that you came to help.</VALUE>
    <VALUE Lang="id">"Terima kasih sekali</VALUE>
    <VALUE Lang="id">Untungnya para korban juga menurun, dengan stok Medicines ini saya rasa akan cukup.</VALUE>
    <VALUE Lang="cn">所有的药品都用完了。我该怎么办呢？这里还是有许多人需要治疗，我很高兴您能来帮忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_medic_1.ntk_9_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_shop1.ntk_1_0">
    <VALUE Lang="GS">Welcome!</VALUE>
    <VALUE Lang="id">Selamat datang</VALUE>
    <VALUE Lang="cn">欢迎光临！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_shop1.ntk_1_0_1">
    <VALUE Lang="GS">Item Trading</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">物品买卖</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_shop1.ntk_1_0_2">
    <VALUE Lang="GS">Listen to the conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
