    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_4">
    <VALUE Lang="GS">skip</VALUE>
    <VALUE Lang="id">skip</VALUE>
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5">
    <VALUE Lang="GS">Didn't you have a tough time reaching this place?</VALUE>
    <VALUE Lang="GS">There are still a few items left, so let me know if you need anything.</VALUE>
    <VALUE Lang="id">Makasih karena sudah datang</VALUE>
    <VALUE Lang="id">Jika ada yang dibutuhkan silahkan beri tahu aku ya</VALUE>
    <VALUE Lang="cn">来这里真是辛苦呀</VALUE>
    <VALUE Lang="cn">物品还有一点,有需要的话要说阿</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_10">
