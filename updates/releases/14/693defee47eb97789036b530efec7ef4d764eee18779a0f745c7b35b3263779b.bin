  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_50">
    <VALUE Lang="GS">Tell about Unknown Boy</VALUE>
    <VALUE Lang="id">Melaporkan hasil penjelajahan anak yang hilang</VALUE>
    <VALUE Lang="cn">谈谈不知名男孩</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_51">
