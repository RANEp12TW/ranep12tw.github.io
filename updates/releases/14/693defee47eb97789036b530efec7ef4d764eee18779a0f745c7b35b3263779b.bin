    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_11_0">
    <VALUE Lang="GS">Good luck!!</VALUE>
    <VALUE Lang="GS">Next step, you need try talking with school helper.</VALUE>
    <VALUE Lang="id">Semoga beruntung!!</VALUE>
    <VALUE Lang="id">Kamu harus berbicara dengan school helper untuk langkah berikutnya.</VALUE>
    <VALUE Lang="cn">加油！</VALUE>
    <VALUE Lang="cn">下一步，你需要尝试与学校帮手进行谈话。</VALUE>
  </SENTENSE>
