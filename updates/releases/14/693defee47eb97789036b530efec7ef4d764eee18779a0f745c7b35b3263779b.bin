  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_14_0">
    <VALUE Lang="GS">The top priority targets in this area are the Jr. Bruisers. Please help eliminate 29 of them.</VALUE>
    <VALUE Lang="id">Musuh yang diutamakan di sini adalah Jr. Bruiser</VALUE>
    <VALUE Lang="id">Lumpuhkanlah 29 orang Jr. Bruiser</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为 Jr. Bruiser。请除掉29只 Jr. Bruiser，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_14_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_2_0">
    <VALUE Lang="GS">The Terminal is running properly.</VALUE>
    <VALUE Lang="id">Terminal beroperasi secara normal</VALUE>
    <VALUE Lang="cn">终端机正常运作中</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_3_0">
    <VALUE Lang="GS">The Force Field mechanism of the Terminal is running properly. You'll need 18 Spiritual Spheres to optimize the Force Field.</VALUE>
    <VALUE Lang="id">Pengoperasian Force Field di Terminal berfungsi secara normal</VALUE>
    <VALUE Lang="id">Jika ingin mendapatkan efek authentication, anda harus mengumpulkan spiritual sphere dan mendapatkan konfirmasi, untuk konfirmasi authentication kali ini anda harus mengumpulkan 18 buah spir</VALUE>
    <VALUE Lang="cn">终端机的结界机能正常运作中。您需要18颗灵珠才能通过认证，并得到结界的能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_4_0">
    <VALUE Lang="GS">The optimization of this Force Field is completed!</VALUE>
    <VALUE Lang="GS">If you complete the remaining Force Field optimization requirements, then you will be able to learn its effects.</VALUE>
    <VALUE Lang="GS">Please move to the next Terminal responsible for the next Force Field optimization.</VALUE>
    <VALUE Lang="id">Autentikasi Force Field telah selesai</VALUE>
    <VALUE Lang="id">Jika sisa autentikasi Force Field telah selesai hasilnya bisa di dapatkan dan untuk autentikasi Force Field berikutnya harap gunakan terminal yang sesuai</VALUE>
    <VALUE Lang="cn">本结界认证已结束。请前往下个终端机，并完成结界认证。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_5_0">
    <VALUE Lang="GS">There are evil spirits roaming inside the Library. The mobs of monsters possessed by these spirits are causing strange effects to their surroundings. Please try your best to eliminate them.</VALUE>
    <VALUE Lang="id">Para Roh Jelmaan sedang beraktivitas di dalam Library</VALUE>
    <VALUE Lang="id">Roh Jelmaan ini dapat mempengaruhi situasi disekelilingnya. Tolong bersihkan Roh Jelmaan ini sebelum terjadi hal yang lebih buruk</VALUE>
    <VALUE Lang="cn">许多恶灵在 Library 里徘徊游荡。被这些恶灵所附着的怪物身上有着不良物质，导致周遭环境出现奇怪现象。请您尽全力处理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_5_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_6_0">
    <VALUE Lang="GS">There are evil spirits roaming inside the Library. The mobs of monsters possessed by these spirits are causing strange effects to their surroundings. Please try your best to eliminate them.</VALUE>
    <VALUE Lang="id">Para Roh Jelmaan sedang beraktivitas di dalam Library</VALUE>
    <VALUE Lang="id">Roh Jelmaan ini dapat mempengaruhi situasi disekelilingnya. Tolong bersihkan Roh Jelmaan ini sebelum terjadi hal yang lebih buruk</VALUE>
    <VALUE Lang="cn">许多恶灵在 Library 里徘徊游荡。被这些恶灵所附着的怪物身上有着不良物质，导致周遭环境出现奇怪现象。请您尽全力处理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_6_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_7_0">
    <VALUE Lang="GS">There are evil spirits roaming the Sports Field. The mobs of monsters possessed by these spirits are causing strange effects to their surroundings. Please try your best to eliminate them.</VALUE>
    <VALUE Lang="id">Para Jelmaan sedang beraktivitas di dalam Science Center</VALUE>
    <VALUE Lang="id">Roh Jelmaan ini dapat mempengaruhi situasi disekelilingnya. Tolong bersihkan Roh Jelmaan ini sebelum terjadi hal yang lebih buruk</VALUE>
    <VALUE Lang="cn">许多恶灵在Sports Field 里徘徊游荡。被这些恶灵所附着的怪物身上有着不良物质，导致周遭环境出现奇怪现象。请您尽全力处理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_7_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_8_0">
    <VALUE Lang="GS">The target amount of purification has been achieved and verified.</VALUE>
    <VALUE Lang="GS">Thank you for your efforts.</VALUE>
    <VALUE Lang="id">Konfirmasi target pembersihan musuh telah selesai</VALUE>
    <VALUE Lang="id">Terima kasih atas kerja keras kalian</VALUE>
    <VALUE Lang="cn">已经确认了目标物与其数量净化的完成。 谢谢您，辛苦您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_9_0">
    <VALUE Lang="GS">.....</VALUE>
    <VALUE Lang="id">.....</VALUE>
    <VALUE Lang="cn">.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_1_0">
    <VALUE Lang="GS">A Broom? Well, it's pretty inconvenient for me to carry this broom around while I'm trying to finish everything I need to do.</VALUE>
    <VALUE Lang="id">Sapu? Ini akan sangat mengganggu untuk dibawa ke mana mana ketika saya melakukan hal lain.</VALUE>
    <VALUE Lang="cn">扫把？反正我在处理事情时，拿着扫把也是挺不方便的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_1_0_1">
    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Buka Locker</VALUE>
    <VALUE Lang="cn">打开Locker 置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_1_1">
    <VALUE Lang="GS">skip</VALUE>
    <VALUE Lang="id">skip</VALUE>
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_1_2">
    <VALUE Lang="GS">The weather is getting cold and gloomy. I'm starting to feel aches and pains in my body.</VALUE>
    <VALUE Lang="id">Cuaca berangsur dingin. Saya mulai merasakan pegal dan sakit di seluruh badan saya.</VALUE>
    <VALUE Lang="cn">天气又冷又阴的，我的身体开始感到疼痛了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_1_2_1">
    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Buka Locker</VALUE>
    <VALUE Lang="cn">打开Locker 置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_1_2_2">
    <VALUE Lang="GS">Ask about Locker Usage</VALUE>
    <VALUE Lang="id">Tanya tentang Penggunaan Locker</VALUE>
    <VALUE Lang="cn">询问Locker的使用方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_1_2_3">
    <VALUE Lang="GS">Ask about the Campus</VALUE>
    <VALUE Lang="id">Tanya tentang Kampus</VALUE>
    <VALUE Lang="cn">询问关于学院的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_1_2_4">
    <VALUE Lang="GS">Return Broom</VALUE>
    <VALUE Lang="id">Tukar Broom</VALUE>
    <VALUE Lang="cn">归还扫帚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_1_2_5">
    <VALUE Lang="GS">Borrow Broom</VALUE>
    <VALUE Lang="id">Pinjam Broom</VALUE>
    <VALUE Lang="cn">出租扫帚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_2_0">
    <VALUE Lang="GS">.......</VALUE>
    <VALUE Lang="id">.......</VALUE>
    <VALUE Lang="cn">.......</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_3_0">
    <VALUE Lang="GS">Of course! Just use these lockers whenever you want. Try to stick to using just one locker space for yourself, alright? Store items that you want to keep and use later inside your locker. You'll need to spend some more money if you want to expand your locker space.</VALUE>
    <VALUE Lang="id">Tentu saja! Kamu bisa menggunakannya kapan pun kamu mau. Simpan item - item yang tidak diperlukan saat ini agar bisa dipergunakan ketika memerlukannya. Kamu memerlukan uang untuk membuka locker lain jika ingin.</VALUE>
    <VALUE Lang="cn">当然！置物箱，您尽管用就是了。但请尽量保持一人份的使用量，好吗？最好是保管真正想收藏的，但又不太紧急的物品。当您嫌置物箱空间不够，想要加大空间时，是需要付些钱币的唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_3_0_1">
    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Buka Locker</VALUE>
    <VALUE Lang="cn">打开Locker 置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_3_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_4_0">
    <VALUE Lang="GS">Sigh. How do I answer that question? As you probably know, there are 3 Campuses in the area, but there are rumors of a fourth campus. I've heard the teachers and the School Administration talking about the Force-- Force Fiel... Ah yes! The Force Field! I'm not one hundred percent sure, but I think there's something very important about that Force Field. Of all the campuses here, Leonair Campus is the probably the weirdest. I remember that I was just listening to some teachers talking when the sky suddenly change</VALUE>
    <VALUE Lang="GS">I really want to know more about what actually happened. If you guys find important information about that event, please don't forget to let me know, alright?</VALUE>
    <VALUE Lang="id">Jangan bertanya hal seperti itu pada saya~</VALUE>
    <VALUE Lang="id">Yang aku ketahui hanyalah kabar desas-desus yang tak berdasar, namun apabila kamu tetap ingin mengetahuinya..baiklah</VALUE>
    <VALUE Lang="id">Nah… jadi sangatlah jelas selain sekolah ini terdapat 3 buah sekolah lainnya</VALUE>
    <VALUE Lang="id">Yang terp</VALUE>
    <VALUE Lang="cn">哀，我该怎么回答好呢？您大概已经听说了，似乎学院的总数不是3个，而是4个！老师们和行政部门的人有提到像是结…..结界的东西….. 啊！就是结界！没错！虽然不能100%的保证，但我相信所谓4个学院的传闻，绝对跟这结界有着很大的关联。现在全部的学院里，最诡异离奇的就属Leonair学院了 。我记得当时我正在听老师们交谈，结果天空急剧变色。但情况太混乱，之后我什么也不记得了。如果各位同学们，关于这部分，有什么新发现，一定要马上跟我说，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_4_0_1">
    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Buka Locker</VALUE>
    <VALUE Lang="cn">打开Locker 置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_4_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_5_0">
    <VALUE Lang="GS">Broom? Oh! That Broom! I really have no idea what's so special about these brooms. Well, if you really think you'll need one, feel free to take it. Please bring it back as soon as you're done using it.</VALUE>
    <VALUE Lang="id">Special Broom?</VALUE>
    <VALUE Lang="id">Ahh</VALUE>
    <VALUE Lang="cn">扫把？噢！刚提到的扫把！我实在是不懂它有什么特别的。这样吧。如果您真认为您会需要，别介意，尽管拿去使用。 只要记住，用完后，要马上归还唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_locker.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_1_0">
    <VALUE Lang="GS">This Terminal controls the entrance and exit to the Main Entrance.</VALUE>
    <VALUE Lang="id">Terminal Enterance</VALUE>
    <VALUE Lang="id">Mengatur akses keluar masuk pintu Entrance</VALUE>
    <VALUE Lang="cn">这个终端机掌控着 Main Entrance 的入口机能。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_1_0_1">
    <VALUE Lang="GS">Automatic Confirmation</VALUE>
    <VALUE Lang="id">Konfirmasi pengaktifan</VALUE>
    <VALUE Lang="cn">自动确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_1_0_2">
    <VALUE Lang="GS">Register for Exam to Pass through Main Entrance</VALUE>
    <VALUE Lang="id">Mulai ujian melewati Main Gate</VALUE>
    <VALUE Lang="cn">申请Main Entrance的通过测验</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_1_0_3">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_2_0">
    <VALUE Lang="GS">The Skill Testing System has been initiated!</VALUE>
    <VALUE Lang="GS">The basic purpose of this program is to protect the students, and also serves as a temporary measure for determining when students develop their abilities beyond a certain level.</VALUE>
    <VALUE Lang="GS">Good Luck, Students!</VALUE>
    <VALUE Lang="id">Skill Test Program di mulai</VALUE>
    <VALUE Lang="cn">技能测试系统已启动！</VALUE>
    <VALUE Lang="cn">该系统的主要目的是为了保护学生，也是一项便利措施，以确保学生的能力有超过一定的水平。 学生们！祝好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_3_0">
    <VALUE Lang="GS">This Terminal's Force Field function is running properly.</VALUE>
    <VALUE Lang="GS">There is no other way to enter and exit through the school's Main Gate unless authentication is acquired.</VALUE>
    <VALUE Lang="id">Pengoperasian Force Field di Terminal berfungsi secara normal</VALUE>
    <VALUE Lang="id">Tidak bisa semiteman mengakses keluar masuk Entrance. Untuk mengakses keluar masuk harus melakukan autentikasi Skill</VALUE>
    <VALUE Lang="cn">终端机的结界机能正常运转中。</VALUE>
    <VALUE Lang="cn">但没有方法能进出学院的Main Gate，除非有得到认可。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_3_0_1">
    <VALUE Lang="GS">Register for Exam to Pass through Main Entrance</VALUE>
    <VALUE Lang="id">Ujian melewati Entrance</VALUE>
    <VALUE Lang="cn">申请通过Main Entrance的考验</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_3_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_4_0">
    <VALUE Lang="GS">The Terminal is running properly.</VALUE>
    <VALUE Lang="id">Terminal beroperasi secara normal</VALUE>
    <VALUE Lang="cn">终端机正常运作中。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_maingate1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
