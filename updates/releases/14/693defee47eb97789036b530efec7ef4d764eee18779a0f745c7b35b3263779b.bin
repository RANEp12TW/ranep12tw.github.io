    <VALUE Lang="cn">给看钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0_7">
    <VALUE Lang="GS">Ask about 3rd Floor of "Green" Command Center</VALUE>
    <VALUE Lang="id">Bertanya tentang "Green" Command Center Lantai 3</VALUE>
    <VALUE Lang="cn">询问关于“Green”指挥中心的3楼</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0_8">
    <VALUE Lang="GS">Show the Key</VALUE>
    <VALUE Lang="id">Tunjukkan kunci</VALUE>
    <VALUE Lang="cn">给看钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0_9">
    <VALUE Lang="GS">Ask about "Green"</VALUE>
    <VALUE Lang="id">Bertanya tentang "Green"</VALUE>
    <VALUE Lang="cn">询问关于“Green”的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1">
    <VALUE Lang="GS">This building is currently under supervision.</VALUE>
    <VALUE Lang="GS">It's great to see students like you that are here to help!</VALUE>
    <VALUE Lang="id">Gedung ini dalam pengawasan. Sangat senang melihat kamu berada di sini untuk menolong.</VALUE>
    <VALUE Lang="cn">这栋大楼被监管中。</VALUE>
    <VALUE Lang="cn">因为您的乐善好施，学生们都喜欢您，真是太好了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">变更开始地点</VALUE>
  </SENTENSE>
