    <VALUE Lang="id">Menyerahkan bahan-bahan untuk perbaikan</VALUE>
    <VALUE Lang="cn">传达卡带复原用的零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_12">
