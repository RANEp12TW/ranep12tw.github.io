    <VALUE Lang="GS">History Center Purification</VALUE>
    <VALUE Lang="id">Pembersihan musuh di History Center</VALUE>
    <VALUE Lang="cn">净化History Center</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_1_0_9">
    <VALUE Lang="GS">Confirm Purification</VALUE>
    <VALUE Lang="id">Konfimasi pembersihan musuh</VALUE>
    <VALUE Lang="cn">净化确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_2_0">
    <VALUE Lang="GS">The Terminal is running properly.</VALUE>
    <VALUE Lang="id">Terminal beroperasi secara normal</VALUE>
    <VALUE Lang="cn">终端机正常运作中</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_3_0">
    <VALUE Lang="GS">This Terminal's Force Field Mechanism is functioning properly.</VALUE>
    <VALUE Lang="GS">You'll need 8 Spiritual Spheres to optimize this Terminal's Force Field function.</VALUE>
    <VALUE Lang="id">Pengoperasian Force Field di Terminal berfungsi secara normal</VALUE>
    <VALUE Lang="id">Untuk mendapatkan hasil dari Force Field kumpulkanlah Spiritual Spheres. Dibutuhkan 8 buah</VALUE>
    <VALUE Lang="cn">终端机的结界机能正常运作中。您需要8颗灵珠才能通过认证，并得到结界的能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_4_0">
    <VALUE Lang="GS">The Force Field Optimization for the current Terminal is completed.</VALUE>
    <VALUE Lang="GS">Please proceed to the next Terminal to complete all the required Force Field Optimizations.</VALUE>
    <VALUE Lang="id">Autentikasi Force Field telah selesai</VALUE>
    <VALUE Lang="id">Jika sisa autentikasi Force Field telah selesai hasilnya bisa di dapatkan dan untuk autentikasi Force Field berikutnya harap gunakan terminal yang sesuai</VALUE>
    <VALUE Lang="cn">本结界认证已结束。请前往下个终端机，并完成结界认证。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_5_0">
    <VALUE Lang="GS">There are evil spirits roaming inside the History Center.</VALUE>
    <VALUE Lang="GS">The mobs of monsters possessed by these spirits are causing strange effects to their surroundings.</VALUE>
    <VALUE Lang="GS">Please try your best to eliminate them.</VALUE>
    <VALUE Lang="id">Para Roh Jelmaan sedang beraktivitas di dalam History Center</VALUE>
    <VALUE Lang="id">Roh Jelmaan ini dapat mempengaruhi situasi disekelilingnya. Tolong bersihkan Roh Jelmaan ini sebelum terjadi hal yang lebih buruk</VALUE>
    <VALUE Lang="cn">许多恶灵在 Society Room里徘徊游荡。被这些恶灵所附着的怪物身上有着不良物质，导致周遭环境出现奇怪现象。请您尽全力处理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_5_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_6_0">
    <VALUE Lang="GS">The target amount required for purification has been achieved and verified.</VALUE>
    <VALUE Lang="GS">Thank you for all your efforts.</VALUE>
    <VALUE Lang="id">Konfirmasi target pembersihan musuh telah selesai</VALUE>
    <VALUE Lang="id">Terima kasih atas kerja keras kalian</VALUE>
    <VALUE Lang="cn">已经确认了目标物与其数量净化的完成。 谢谢您，辛苦您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_9_0">
    <VALUE Lang="GS">The top priority targets in this area are the Fencing Students.</VALUE>
    <VALUE Lang="GS">Please eliminate 30 Fencing Students.</VALUE>
    <VALUE Lang="id">Di lokasi ini targetnya adalah Fencing Student</VALUE>
    <VALUE Lang="id">Bunuh 30 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为Fencing Student。请除掉30只 Fencing Student，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_history_1.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0">
    <VALUE Lang="GS">The Information Room Terminal is unable to function properly due to an error in the school's Main Terminal.</VALUE>
    <VALUE Lang="GS">Please resolve this problem.</VALUE>
    <VALUE Lang="id">Terminal Information Room</VALUE>
    <VALUE Lang="id">Saat ini di dalam sekolah terjadi kesalahan perhitungan, tolong diperhatikan</VALUE>
    <VALUE Lang="cn">因现在学院里的主终端机故障了，资料室终端机无法正常运转。请帮忙解决这问题好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0_1">
    <VALUE Lang="GS">Confirm Activation</VALUE>
    <VALUE Lang="id">Konfirmasi pengaktifan</VALUE>
    <VALUE Lang="cn">激活确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0_2">
    <VALUE Lang="GS">Retrieve Information</VALUE>
    <VALUE Lang="id">Mencari data</VALUE>
    <VALUE Lang="cn">资料检索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0_3">
    <VALUE Lang="GS">Retrieve Information</VALUE>
    <VALUE Lang="id">Mencari data</VALUE>
    <VALUE Lang="cn">资料检索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_1_0_4">
    <VALUE Lang="GS">Search Information</VALUE>
    <VALUE Lang="id">Mencari data</VALUE>
    <VALUE Lang="cn">搜寻资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_2_0">
    <VALUE Lang="GS">Due to the errors in the School's Information Center System, the Information Room can only process the data contained in this 1 File.</VALUE>
    <VALUE Lang="GS">We will restore all necessary information as soon as possible.</VALUE>
    <VALUE Lang="GS">Please feel free to read through the document.</VALUE>
    <VALUE Lang="id">Karena kerusakan yang terjadi pada sitem data base di dalam sekolah, hanya 2 buah data yang tersimpan di Information Room saat ini.</VALUE>
    <VALUE Lang="id">Kami akan berusaha untuk meperbaiki kerusakan secepatnya.</VALUE>
    <VALUE Lang="id">Apakah kamu ingin membaca 2 data tadi?</VALUE>
    <VALUE Lang="cn">因为学院资料库系统故障，资料室现在只能储存一份档案。我们会尽快复原所有重要的资料。请稍微阅读一下这份文件，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_2_0_1">
    <VALUE Lang="GS">Ask about Shockwave Skill</VALUE>
    <VALUE Lang="id">Bertanya tentang 'Shockwave' Skill</VALUE>
    <VALUE Lang="cn">询问关于Shockwave技能</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_3_0">
    <VALUE Lang="GS">After you finish reading and activating the Shockwave skill book, use the [K] button to open the Skill Window. Click and hold down the left mouse button to select Shockwave in the Qi option panel (located on the right). While holding down the button, drag the skill and drop it into the desired Shortcut Key holder in the Shortcut Key panel.</VALUE>
    <VALUE Lang="GS">You are finally ready to use the Shockwave skill with the shortcut key you've assigned.</VALUE>
    <VALUE Lang="id">Setelah membaca Brawler Scrolls 'Shockwave', tekan tombol 'K' pada bagian bawah sebelah kanan 'energi'. Setelah memilih 'Shockwave' akan terbuka Slot ada bagian kiri atas lalu klik kanan untuk dapat menggunakan 'Shockwave' tersebut</VALUE>
    <VALUE Lang="cn">读完Shockwave技能文书后，请按 [K] 键开启技能视窗。并利用滑鼠左键，将位在右方的Shockwave拖拽到左侧的技能快捷视窗。如此一来，您便能直接透过《技能快捷键》来使用您自行设定过的技能了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_3_0_1">
    <VALUE Lang="GS">The Effect of the Shockwave Skill</VALUE>
    <VALUE Lang="id">Efek dari skill yang bernama'Shockwave'</VALUE>
    <VALUE Lang="cn">Shockwave技能的效果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_4_0">
    <VALUE Lang="GS">Due to the errors in the School's Information Center System, the Information Room can only process the data contained in this 1 File.</VALUE>
    <VALUE Lang="GS">We will restore all necessary information as soon as possible.</VALUE>
    <VALUE Lang="GS">Please feel free to stay and read through the document.</VALUE>
    <VALUE Lang="id">Karena Sistem database di sekolah sedang ada gangguan, hanya mampu menyimpan 1 buah data</VALUE>
    <VALUE Lang="id">Kami akan berusaha untuk meperbaiki kerusakan secepatnya.</VALUE>
    <VALUE Lang="id">Apakah kamu ingin membaca 2 data tadi?</VALUE>
    <VALUE Lang="cn">因为学院资料库系统故障，资料室现在只能储存一份档案。我们会尽快复原所有重要的资料。请稍微阅读一下这份文件，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_4_0_1">
    <VALUE Lang="GS">Ask about Refresh Skill</VALUE>
    <VALUE Lang="id">Pencarian data tentang skill yang bernama 'HP Recovery'</VALUE>
    <VALUE Lang="cn">询问 Refresh技能</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_5_0">
    <VALUE Lang="GS">Now there isn't any means of keeping this Terminal functioning properly.</VALUE>
    <VALUE Lang="id">Saat ini terminal tidak berfungsi dengan baik</VALUE>
    <VALUE Lang="cn">现在没有任何办法可以维持这台终端机的正常运作。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_6_0">
    <VALUE Lang="GS">After you finish reading and activating the Refresh skill book, use the [K] button to open the Skill Window. Click and hold down the left mouse button to select Refresh in the Support option panel (located on the right). While holding down the button, drag the skill and drop it into the desired Shortcut Key holder in the Shortcut Key panel.</VALUE>
    <VALUE Lang="GS">You are finally ready to use the Refresh skill with the shortcut key you've assigned.</VALUE>
    <VALUE Lang="id">Setelah membaca Brawler Scrolls 'HP Recovery', tekan tombol 'K' pada bagian bawah sebelah kanan 'perlengkapan'. Setelah memilih 'HP Recovery' akan terbuka Slot ada bagian kiri atas lalu klik kanan untuk dapat menggunakan 'HP Recovery' tersebut</VALUE>
    <VALUE Lang="cn">读完Refresh技能文书后，请按 [K] 键开启技能视窗。并利用滑鼠左键，将位在右方的Refresh拖拽到左侧的技能快捷视窗。如此一来，您便能直接透过《技能快捷键》来使用您自行设定过的技能了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_6_0_1">
    <VALUE Lang="GS">The Effect of the Refresh Skill</VALUE>
    <VALUE Lang="id">Efek dari 'HP Recovery' Skill</VALUE>
    <VALUE Lang="cn">Refresh技能的效果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_7_0">
    <VALUE Lang="GS">The Shockwave skill uses the art of manipulating Qi Energy to attack nearby enemies.</VALUE>
    <VALUE Lang="GS">The usage and training for this skill is the same as other skills for your character.</VALUE>
    <VALUE Lang="id">Schockwave' ini untuk meningkatkan attack power dan konsentrasi untuk menyerang musuh</VALUE>
    <VALUE Lang="id">Cara menyempurnakan Skill yang lainnya juga sama</VALUE>
    <VALUE Lang="cn">Shockwave技能的效果是，能使用气来攻击附近的敌人。至于该效果的使用与锻炼方法，皆与其他技能一样。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_8_0">
    <VALUE Lang="GS">The Refresh skill is used to hasten health recovery against damage. This skill can only be used on your own character.</VALUE>
    <VALUE Lang="GS">The usage and training for this skill is the same as other skills for your character.</VALUE>
    <VALUE Lang="id">HP Recovery' ini untuk memulihkan kondisi yang terluka dan hanya bisa digunakan untuk diri sendiri</VALUE>
    <VALUE Lang="id">Cara menyempurnakan Skill yang lainnya juga sama</VALUE>
    <VALUE Lang="cn">受到伤害时，Refresh技能可加快恢复健康的速度，且此技能只能用在角色自身。至于该效果的使用与锻炼方法，皆与其他技能一样。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_jaryosil1.ntk_9_0">
    <VALUE Lang="GS">Search Information Finished</VALUE>
    <VALUE Lang="id">Pencarian data telah selesai.</VALUE>
    <VALUE Lang="cn">资料搜寻完成</VALUE>
  </SENTENSE>
