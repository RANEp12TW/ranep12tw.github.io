  <SENTENSE Ver="1" Id="npc_1_gwahak_1.ntk_10_0">
    <VALUE Lang="GS">The top priority targets of this area are the Punks. Please help neutralize the violence by eliminating 30 Punk Targets.</VALUE>
    <VALUE Lang="id">Di lokasi ini targetnya adalah Punk</VALUE>
    <VALUE Lang="id">Jatuhkan 30 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为Punk。请除掉30只Punk，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gwahak_1.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gwahak_1.ntk_11_0">
    <VALUE Lang="GS">The top priority targets of this area are the Crooks. Please eliminate 36 Crooks to neutralize their violence.</VALUE>
    <VALUE Lang="id">Di lokasi ini targetnya adalah Masked Iron Pipe</VALUE>
    <VALUE Lang="id">Jatuhkan 36 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为Crook。请除掉36只Punk，维持良好校园风气。</VALUE>
  </SENTENSE>
