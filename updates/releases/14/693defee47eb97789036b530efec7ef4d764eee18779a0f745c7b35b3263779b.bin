    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_medic1.ntk_1_0_4">
    <VALUE Lang="GS">Confirm Position</VALUE>
