    <VALUE Lang="GS">Student Director (Dispatched)'s Call</VALUE>
    <VALUE Lang="id">Student Director (Dispatched)'s Call</VALUE>
    <VALUE Lang="cn">Student Director (Dispatched)的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_scmasterpat.ntk_1_0_24">
