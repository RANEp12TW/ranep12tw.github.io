  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_10_0">
    <VALUE Lang="GS">The top priority targets of this place are the Brute Punks. Please help eliminate 26 Brute Punks.</VALUE>
    <VALUE Lang="id">Musuh yang diutamakan di sini adalah Brute Punk</VALUE>
    <VALUE Lang="id">Jatuhkan 26 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为 Brute Punk。请除掉26只 Brute Punk，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_11_0">
    <VALUE Lang="GS">.......</VALUE>
    <VALUE Lang="id">.......</VALUE>
    <VALUE Lang="cn">.......</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_12_0">
    <VALUE Lang="GS">The top priority targets of this place are the Slashers. Please help eliminate 27 Slashers.</VALUE>
    <VALUE Lang="id">Musuh yang diutamakan di sini adalah Slasher</VALUE>
    <VALUE Lang="id">Lumpuhkanlah 27 orang Masked Slasher</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为 Slasher。请除掉27只 Slasher，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_library_1.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
