  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_7_0_4"><VALUE Lang="tw">兌換 震盪刺擊（67級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Staggering Sting (Lv67, Class=130, Item=175/45)</VALUE><VALUE Lang="id">Skill book: Staggering Sting (Lv67, Class=130, Item=175/45)</VALUE><VALUE Lang="cn">Skill book: Staggering Sting (Lv67, Class=130, Item=175/45)</VALUE><VALUE Lang="th">Skill book: Staggering Sting (Lv67, Class=130, Item=175/45)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_7_0_5"><VALUE Lang="tw">兌換 CP震波（57級／劍道部）</VALUE><VALUE Lang="GS">Skill book: CP Shockwave (Lv57, Class=130, Item=175/66)</VALUE><VALUE Lang="id">Skill book: CP Shockwave (Lv57, Class=130, Item=175/66)</VALUE><VALUE Lang="cn">Skill book: CP Shockwave (Lv57, Class=130, Item=175/66)</VALUE><VALUE Lang="th">Skill book: CP Shockwave (Lv57, Class=130, Item=175/66)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0">
    <VALUE Lang="GS">Which skill do you want to learn out of the skills of Grade 8?</VALUE>
    <VALUE Lang="cn">您想学习哪个8等级的技能呢?</VALUE>
    <VALUE Lang="id">Skill apa yang ingin kamu pelajari dengan spheres 8?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0_2"><VALUE Lang="tw">兌換 痛苦吸收（67級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE><VALUE Lang="id">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE><VALUE Lang="cn">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE><VALUE Lang="th">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0_3"><VALUE Lang="tw">兌換 能量吸收（77級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE><VALUE Lang="id">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE><VALUE Lang="cn">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE><VALUE Lang="th">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0">
    <VALUE Lang="GS">Which skill do you want to learn out of the skills of Grade 9?</VALUE>
    <VALUE Lang="cn">您想学习哪个9等级的技能呢?</VALUE>
    <VALUE Lang="id">Skill apa yang ingin kamu pelajari dengan spheres 9?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_2"><VALUE Lang="tw">兌換 碧波劍氣（87級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="id">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="cn">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="th">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_3"><VALUE Lang="tw">兌換 震撼噴流（57級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="id">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="cn">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="th">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_4"><VALUE Lang="tw">兌換 無盡怒氣（87級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="id">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="cn">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="th">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_0">
    <VALUE Lang="GS">It looks like you are not a magician… I'm not a friendly old man either… Hmmm…</VALUE>
    <VALUE Lang="id">Sepertinya kamu bukan seorang Magician….Saya juga bukan orang tua yang ramah…Hmmm…</VALUE>
    <VALUE Lang="cn">你看起来不像是一个魔术师…. 我也不是一个友善的老人….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_0_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Tukar</VALUE>
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1">
    <VALUE Lang="GS">You must be a Magician, right?</VALUE>
    <VALUE Lang="id">Kamu adalah Magician, bukan?</VALUE>
    <VALUE Lang="cn">你肯定是一个魔术师, 是吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Tukar</VALUE>
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_2">
    <VALUE Lang="GS">Ask the meaning of Dahlia.</VALUE>
    <VALUE Lang="id">Tanyakan arti Dahlia</VALUE>
    <VALUE Lang="cn">询问Dahlia的含义.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_3">
    <VALUE Lang="GS">Suggest ways on how to improve Magician Class.</VALUE>
    <VALUE Lang="id">Berikan saran tentang bagaimana memperbaiki kelas Magician</VALUE>
    <VALUE Lang="cn">听取如何提高魔术等级的建议.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_4">
    <VALUE Lang="GS">Receive Crucio's favor.</VALUE>
    <VALUE Lang="id">Terimalah permintaan Crucio</VALUE>
    <VALUE Lang="cn">获得Crucio的青睐.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_5">
    <VALUE Lang="GS">Deliver the information you investigated.</VALUE>
    <VALUE Lang="id">Berikan informasi yang telah kamu dapatkan dari investigasi</VALUE>
    <VALUE Lang="cn">提交你调查的信息</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_6">
    <VALUE Lang="GS">Learn Crucio's First Lesson.</VALUE>
    <VALUE Lang="id">Pelajari pelajaran pertama Crucio</VALUE>
    <VALUE Lang="cn">学习Crucio的第一节课</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_7">
    <VALUE Lang="GS">Learn Crucio's Second Lesson.</VALUE>
    <VALUE Lang="id">Pelajari pelajaran kedua Crucio</VALUE>
    <VALUE Lang="cn">学习Crucio的第二节课</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_8">
    <VALUE Lang="GS">Learn Crucio's Third Lesson.</VALUE>
    <VALUE Lang="id">Pelajari pelajaran ketiga Crucio</VALUE>
    <VALUE Lang="cn">学习Crucio的第三节课</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_10_0">
    <VALUE Lang="GS">I will be waiting here.</VALUE>
    <VALUE Lang="id">Saya akan menunggu disini</VALUE>
    <VALUE Lang="cn">我会在这里等着的.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_11_0">
    <VALUE Lang="GS">I was stupid. I didn't know the truth.</VALUE>
    <VALUE Lang="id">Saya sangat bodoh. Tidak mengetahui kebenarannya</VALUE>
    <VALUE Lang="cn">我真愚蠢, 居然不知道真相.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_12_0">
    <VALUE Lang="GS">Good luck!</VALUE>
    <VALUE Lang="id">Semoga berhasil!</VALUE>
    <VALUE Lang="cn">祝你好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0">
    <VALUE Lang="GS">Just try to guess the answer.</VALUE>
    <VALUE Lang="GS">You can try again, so don't feel so burdened.</VALUE>
    <VALUE Lang="id">Cobalah untuk menebak jawabannya. Kamu dapat mencobanya lagi, jadi jangan merasa terlalu terbebani.</VALUE>
    <VALUE Lang="cn">试着去猜猜的答案.</VALUE>
    <VALUE Lang="cn">你可以在试一次, 不要灰心.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_1">
    <VALUE Lang="GS">Passionate Love</VALUE>
    <VALUE Lang="id">Cinta yang Penuh Gairah</VALUE>
    <VALUE Lang="cn">热情的爱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_2">
    <VALUE Lang="GS">Everlasting Love</VALUE>
    <VALUE Lang="id">Cinta yang Abadi</VALUE>
    <VALUE Lang="cn">永恒的爱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_3">
    <VALUE Lang="GS">My gratitude exceeds your care.</VALUE>
    <VALUE Lang="id">Rasa terimakasihku melebihi perhatianmu</VALUE>
    <VALUE Lang="cn">非常感谢你的照顾.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_4">
    <VALUE Lang="GS">Pure Soul</VALUE>
    <VALUE Lang="id">Jiwa yang Murni</VALUE>
    <VALUE Lang="cn">纯洁的灵魂</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_3_0">
    <VALUE Lang="GS">That's what Rose symbolizes. Think again.</VALUE>
    <VALUE Lang="id">Itulah arti simbol Rose. Pikirkan lagi.</VALUE>
    <VALUE Lang="cn">那就是Rose所象征的含义，在想一想.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_3_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_4_0">
    <VALUE Lang="GS">That's what Lily symbolizes. Think again.</VALUE>
    <VALUE Lang="id">Itulah arti simbol Lily. Pikirkan lagi.</VALUE>
    <VALUE Lang="cn">那就是Lily所象征的含义，在想一想.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_4_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_5_0">
    <VALUE Lang="GS">You’re right. Let me give you your reward.</VALUE>
    <VALUE Lang="id">Kamu benar. Mari saya berikan kamu hadiah</VALUE>
    <VALUE Lang="cn">你是对的, 让我给你你应得的奖励.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_5_0_1">
    <VALUE Lang="GS">Receive the reward.</VALUE>
    <VALUE Lang="id">Terima hadiahnya</VALUE>
    <VALUE Lang="cn">获取奖励.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_6_0">
    <VALUE Lang="GS">That's what Gypsophila symbolizes. Think again.</VALUE>
    <VALUE Lang="id">Itulah arti simbol Gypsophila. Pikirkan lagi</VALUE>
    <VALUE Lang="cn">那就是Gypsophila所象征的含义，在想一想.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_6_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_7_0">
    <VALUE Lang="GS">Wish you happy.</VALUE>
    <VALUE Lang="id">Harap kamu bahagia.</VALUE>
    <VALUE Lang="cn">希望你开心.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_8_0">
    <VALUE Lang="GS">Talk with the Magician Instructor</VALUE>
    <VALUE Lang="id">Bicara dengan Magician Instructor</VALUE>
    <VALUE Lang="cn">与魔术训练师对话.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0">
    <VALUE Lang="GS">You are looking at an old man , but I was once a great warrior. For the sake of my lover, I fought Valentino, the Great Wizard. Unfortunately, I lost. I ran to the cliff and hid in the cave. I was fortunate that I did not lose my mind and I survived. Can you go to the Sacred gate Police to find out some news about my loved one? I will pass my expertise to you.</VALUE>
    <VALUE Lang="id">Kamu sedang melihat seorang tua renta, tapi dulu saya adalah pejuang hebat. Demi cinta saya pernah bertarung melawan Valentino, Sang Penyihir Hebat. Namun sayangnya, saya kalah. Kemudian saya lari ke tebing dan bersembunyi di gua. Untungnya saya tidak keh</VALUE>
    <VALUE Lang="cn">你正在看着一位老人，可我曾经是一个伟大的战士. 为了爱人我曾经与伟大的魔法师，’Valentino‘战斗过. 不幸的是，我失败了. 我跑到悬崖上，藏在山洞里. 但幸运的是我没有放弃. 我活了下来. 你可以去Sacred gate Police找出一些关于我爱人的消息吗？我将把我的技能传授给你.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0_1">
    <VALUE Lang="GS">Tell him to accept his favor.</VALUE>
    <VALUE Lang="id">Katakan padanya untuk menerima bantuannya</VALUE>
    <VALUE Lang="cn">告诉他，获得他的好感.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0_2">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_1_0">
    <VALUE Lang="GS">Abra Kadabra~ I am the Animal Trainer. What can I do for you?</VALUE>
    <VALUE Lang="id">Abra kadabra~ Saya adalah the Animal Trainer. Apa yang bisa saya bantu?</VALUE>
    <VALUE Lang="cn">Abra Kadabra~我是Animal Trainer, 我能为你做什么?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_1_0_1">
    <VALUE Lang="GS">Get a magical animal.</VALUE>
    <VALUE Lang="id">Dapatkan Magical Animal</VALUE>
    <VALUE Lang="cn">获得一只魔术宠物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0">
    <VALUE Lang="GS">To receive a magical animal, you need to learn the Animal Mastery. Have you learned it?</VALUE>
    <VALUE Lang="id">Untuk mendapatkan magical animal, kamu perlu mempelajari Animal Mastery. Apakah kamu sudah mempelajarinya?</VALUE>
    <VALUE Lang="cn">想获得一只魔术宠物, 你需要学习Animal Mastery, 你学会该技能了吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0_1">
    <VALUE Lang="GS">Yes</VALUE>
    <VALUE Lang="id">Iya</VALUE>
    <VALUE Lang="cn">是的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0_2">
    <VALUE Lang="GS">No</VALUE>
    <VALUE Lang="id">Tidak</VALUE>
    <VALUE Lang="cn">没有</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_3_0">
    <VALUE Lang="GS">Oh, that's unfortunate! You haven't learned the Animal Mastery yet. Learn it if you got the chance.</VALUE>
    <VALUE Lang="id">Oh,sayang sekali! Kamu belum mempelajari skill Animal Mastery. Silahkan pelajari jika ada kesempatan.</VALUE>
    <VALUE Lang="cn">很遗憾, 你还没有学习Animal Mastery. 先学习此技能吧.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_3_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0">
    <VALUE Lang="GS">You already learned the Animal Mastery, but let me explain this to you first. These animals have skills that you can level up in orders 1 to 4. In doing so, they become stronger. Now, shall we look at these skills?</VALUE>
    <VALUE Lang="id">Kamu telah mempelajari Animal mastery, tetapi biarkan saya menjelaskan ini dulu kepadamu. Hewan ini memiliki skill-skill yang dapat ditingkatkan dari 1 hingga 4 level. Dengan demikian, mereka dapat menjadi lebih kuat. Sekarang, mari kita lihat skill-skill</VALUE>
    <VALUE Lang="cn">你已经学会了Animal Mastery. 但是最好先让我给你说明一下. 这些宠物都有技能, 可以把等级从 orders 1升到4. 每升级一个技能它们就会变得越来越强大. 你现在要看看这些技能吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_1">
    <VALUE Lang="GS">Ask about the Tiger.</VALUE>
    <VALUE Lang="id">Pertanyaan tentang Tiger</VALUE>
    <VALUE Lang="cn">询问关于Tiger</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_2">
    <VALUE Lang="GS">Ask about the Cat.</VALUE>
    <VALUE Lang="id">Pertanyaan tentang Cat</VALUE>
    <VALUE Lang="cn">询问关于Cat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_3">
    <VALUE Lang="GS">Ask about the Owl.</VALUE>
    <VALUE Lang="id">Pertanyaan tentang Owl</VALUE>
    <VALUE Lang="cn">询问关于Owl</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0">
    <VALUE Lang="GS">Tiger Mastery</VALUE>
    <VALUE Lang="GS">[Order: Step 1 - Front Paw Strike] Pull, Skill Range (-30), Movement Speed (-30%)</VALUE>
    <VALUE Lang="GS">[Order: Step 2 - Heavy Stomp] Defense (-20%), Movement Speed (-70%)</VALUE>
    <VALUE Lang="GS">[Order: Step 3 - Growling] Air Born + Stun (1.5 seconds), Distance Effect</VALUE>
    <VALUE Lang="GS">[Order: Step 4 - Tiger Roar] Freeze target, Unable to use potion (2 seconds)</VALUE>
    <VALUE Lang="GS">These are Attack skills.</VALUE>
    <VALUE Lang="GS">Now, do you wish to fight in battles with this Tiger?</VALUE>
    <VALUE Lang="id">Tiger Mastery [Order : Step 1 - Front Paw Strike] Menarik, Jarak Skill (-30), Kecepatan Gerakan (-30) [Order : Step 2 - Heavy Stomp] Pertahanan (-20%), Kecepatan Gerakan (-70%) [Order : Step 3 - Growling] Melayang + Stun (1.5 detik), Jarak Efek [Order : S</VALUE>
    <VALUE Lang="cn">Tiger Mastery</VALUE>
    <VALUE Lang="cn">[Order: Step 1 - Front Paw Strike] Pull, 技能范围 (-30), 移动速度 (-30%)</VALUE>
    <VALUE Lang="cn">[Order: Step 2 - Heavy Stomp] 防御 (-20%), 移动速度 (-70%)</VALUE>
    <VALUE Lang="cn">[Order: Step 3 - Growling] Air Born + 眩晕 (1.5 秒), Distance Effect</VALUE>
    <VALUE Lang="cn">[Order: Step 4 - Tiger Roar] 冻结目标, 不能使用药水 (2 秒)</VALUE>
    <VALUE Lang="cn">这些都是攻击技</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0_1">
    <VALUE Lang="GS">Get the Tiger</VALUE>
    <VALUE Lang="id">Dapatkan Tiger</VALUE>
    <VALUE Lang="cn">获得Tiger</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0_2">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">上一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0">
    <VALUE Lang="GS">Cat Mastery</VALUE>
    <VALUE Lang="GS">[Order: Step 1 - Sapphire Heal] Heal (100/second, 5 seconds), Debuff Removal, Abnormal Effect Protection/Recovery</VALUE>
    <VALUE Lang="GS">[Order: Step 2 - Breathtaking Cat] Physical Damage Absorption (10%), Defense (+5%), HP+MP+SP Recovery (0.001), HP Increase (+5%)</VALUE>
    <VALUE Lang="GS">[Order: Step 3 - Miaow Miaow] Attack (+15%), Accuracy (+30)</VALUE>
    <VALUE Lang="GS">[Order: Step 4 - Cat's Meow] Magic Damage Absorption (10%), HP Recovery (+0.002), Resistance (+20), Attack Speed (20%), Movement Speed (10%)</VALUE>
    <VALUE Lang="GS">These are Buff skills.</VALUE>
