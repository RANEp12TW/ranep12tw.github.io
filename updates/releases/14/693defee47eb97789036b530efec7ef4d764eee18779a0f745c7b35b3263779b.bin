  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_1_0">
    <VALUE Lang="GS">My memories…</VALUE>
    <VALUE Lang="id">Seingat…..saya….</VALUE>
    <VALUE Lang="cn">我的记忆…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_1_0_1">
    <VALUE Lang="GS">Ask about Violence</VALUE>
    <VALUE Lang="id">Bertanya tentang kerusuhan yang terjadi</VALUE>
    <VALUE Lang="cn">询问关于暴动</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_1_0_2">
    <VALUE Lang="GS">Ask if Violence was on Purpose</VALUE>
    <VALUE Lang="id">Bertanya apakah dia dalang dari kerusuhan yang terjadi</VALUE>
    <VALUE Lang="cn">询问暴动是否是蓄意的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_2_0">
    <VALUE Lang="GS">I did something wrong...</VALUE>
    <VALUE Lang="GS">I committed crimes... I was a convict...</VALUE>
    <VALUE Lang="GS">It seems like I can leave now.</VALUE>
    <VALUE Lang="GS">I don't understand why I behaved that way.</VALUE>
    <VALUE Lang="GS">It's like there was this voice... Telling me to murder...</VALUE>
    <VALUE Lang="id">Aku…pasti sudah melakukan suatu kejahatan kan?</VALUE>
    <VALUE Lang="id">Karena itu saya menjadi kriminal dan bekerja di sini</VALUE>
    <VALUE Lang="id">Tapi kayaknya bisa keluar…dengan segera</VALUE>
    <VALUE Lang="id">Kenapa tiba-tiba melakukan hal seperti itu...</VALUE>
    <VALUE Lang="id">Seseorang menyuruh saya…ayo bunuh….</VALUE>
    <VALUE Lang="cn">我…分明是犯了什么罪了吧。</VALUE>
    <VALUE Lang="cn">所以在这里当犯人，做事情...</VALUE>
    <VALUE Lang="cn">但好像马上可以放出去。</VALUE>
    <VALUE Lang="cn">但为何突然犯下那种行为...</VALUE>
    <VALUE Lang="cn">好像是什么人指使…叫我杀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_3_0">
    <VALUE Lang="GS">It was as if someone was in my head making me do it.</VALUE>
    <VALUE Lang="GS">I knew it was wrong, but…</VALUE>
    <VALUE Lang="GS">I guess it's pointless to explain…</VALUE>
    <VALUE Lang="GS">I always thought that it was a bad thing.</VALUE>
    <VALUE Lang="GS">…Yes, I started the rebellion.</VALUE>
    <VALUE Lang="GS">Why… Is this happening to me?</VALUE>
    <VALUE Lang="GS">Can you see my leg?</VALUE>
    <VALUE Lang="GS">It looks… Alive, doesn't it?</VALUE>
    <VALUE Lang="id">Seseorang di kepala saya menyuruh saya untuk melakukannya.</VALUE>
    <VALUE Lang="id">Saya tahu bahwa saya tidak boleh melakukan hal seperti itu tapi…</VALUE>
    <VALUE Lang="id">Hah…alasan atau apapun tiu…sudah tidak bergunakan…</VALUE>
    <VALUE Lang="id">Karena kenyataan kalau sayalah yang melakukannya..tidak akan berubah</VALUE>
    <VALUE Lang="cn">好像是什么人在我的脑袋里指使我那样做.</VALUE>
    <VALUE Lang="cn">虽知道不能那样...</VALUE>
    <VALUE Lang="cn">这样…解释似乎..没用吧...</VALUE>
    <VALUE Lang="cn">我一直都认为…那是坏事</VALUE>
    <VALUE Lang="cn">是的，我发起暴动的...</VALUE>
    <VALUE Lang="cn">但是，为什么连我都变成这个样子?</VALUE>
    <VALUE Lang="cn">看到我的腿了吗?</VALUE>
    <VALUE Lang="cn">好像...是...活...的吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_prisoner.ntk_3_0_1">
    <VALUE Lang="GS">return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
