  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_1_3_2">
    <VALUE Lang="GS">Help with her Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan</VALUE>
    <VALUE Lang="cn">帮助她</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_1_3_3">
    <VALUE Lang="GS">Announce the Results</VALUE>
    <VALUE Lang="id">Memberitahukan hasil</VALUE>
    <VALUE Lang="cn">宣布结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_2_0">
    <VALUE Lang="GS">There's a citizen that needs you to save her from some suspicious men.</VALUE>
    <VALUE Lang="GS">I can't help her, but I know you have the power to save her.</VALUE>
    <VALUE Lang="id">Orang-orang yang berada di antara makhluk-makhluk aneh meminta pertolongan… Aku sendiri tak dapat berbuat apa-apa.. Andai ada orang yang mau membantu pasti akan sangat bagus…</VALUE>
    <VALUE Lang="cn">市民需要您的协助。</VALUE>
    <VALUE Lang="cn">我帮不上忙，但您绝对可以胜任的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_3_0">
    <VALUE Lang="GS">I told you before that there's a good citizen that needs your help. I believe that you can do it!</VALUE>
    <VALUE Lang="id">Seperti yang aku bilang sebelumnya, orang-orang yang berada di antara makhluk-makhluk aneh meminta pertolongan. Memang dibutuhkan tenaga yang kuat, tapi aku yakin kalian dapat melakukannya.</VALUE>
    <VALUE Lang="cn">我早就跟您说过，有位好市民需要您的帮忙！相信您可以的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_3_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_3_0_5">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_4_0">
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="GS">There's a lot of shady characters involved in the kidnapping. You'll find yourself in danger if you're not adequately prepared.</VALUE>
    <VALUE Lang="GS">Please take care.</VALUE>
    <VALUE Lang="id">Makasih.. Hati-hati ya… banyaknya jumlah makhluk-makhluk aneh itu memungkinkan mereka menyerangmu, kamu bisa dalam bahaya.</VALUE>
    <VALUE Lang="cn">谢谢您。</VALUE>
    <VALUE Lang="cn">这里有许多黑道分子参与绑架案件。 您要小心做准备，否则会遭殃的。请保重！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_5_0">
    <VALUE Lang="GS">Really?</VALUE>
    <VALUE Lang="GS">I was so worried... But it's such a relief to see you.</VALUE>
    <VALUE Lang="id">Benar rupanya.</VALUE>
    <VALUE Lang="id">Permintaan sih permintaan tapi aku juga sedikit khawatir</VALUE>
    <VALUE Lang="id">Untung saja kamu selamat seperti ini…</VALUE>
    <VALUE Lang="cn">真的吗？我有点担心。</VALUE>
    <VALUE Lang="cn">见到了你，我就放心了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_final.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_1_0">
    <VALUE Lang="GS">Hello~</VALUE>
    <VALUE Lang="GS">I'm Ami.</VALUE>
    <VALUE Lang="id">Helo?</VALUE>
    <VALUE Lang="id">Nama saya Ami</VALUE>
    <VALUE Lang="cn">您好！</VALUE>
    <VALUE Lang="cn">我是Ami。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_1_0_1">
    <VALUE Lang="GS">Listen to Story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">聆听故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_1_0_2">
    <VALUE Lang="GS">Help with her Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan</VALUE>
    <VALUE Lang="cn">接受她的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_1_0_3">
    <VALUE Lang="GS">Exchange for Entry Extra S card</VALUE>
    <VALUE Lang="id">Tukar dengan Entry Extra S card</VALUE>
    <VALUE Lang="cn">兑换Extra S card 入场卡</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_2_0">
    <VALUE Lang="GS">There's a citizen who needs you to save her from some suspicious men.</VALUE>
    <VALUE Lang="GS">I can't help her, but I know you have the power to save her.</VALUE>
    <VALUE Lang="id">Orang-orang yang berada di antara makhluk-makhluk aneh meminta pertolongan… Aku sendiri tak dapat berbuat apa-apa.. Andai ada orang yang mau membantu pasti akan sangat bagus…</VALUE>
    <VALUE Lang="cn">市民需要您的协助。</VALUE>
    <VALUE Lang="cn">我帮不上忙，但您绝对可以胜任的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_0">
    <VALUE Lang="GS">I told you before that there's a good citizen who needs your help. I know, you can do this!</VALUE>
    <VALUE Lang="id">Seperti yang aku bilang sebelumnya, orang-orang yang berada di antara makhluk-makhluk aneh meminta pertolongan. Memang dibutuhkan tenaga yang kuat, tapi aku yakin kalian dapat melakukannya.</VALUE>
    <VALUE Lang="cn">我之前有告诉过您，有一位善良的市民区要您的拯救。这次，我相信您可以的！请帮她。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_0_1">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_0_5">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_0_6">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_3_1">
    <VALUE Lang="GS">You need an Entry Card to enter the Extra Stage S Grade.</VALUE>
    <VALUE Lang="GS">I'm sorry, but you still don't have it.</VALUE>
    <VALUE Lang="id">Kamu memerlukan Entry Card untuk masuk ke Extra Stage S Grade.</VALUE>
    <VALUE Lang="id">Maap tetapi saya sudah memeriksa dan kamu tidak mempunyai itu.</VALUE>
    <VALUE Lang="cn">您需要Entry Card才能进入Extra Stage S级。</VALUE>
    <VALUE Lang="cn">可惜的是，您没有这张认证卡。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_4_0">
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="GS">There are lots of shady characters involved in the kidnapping. Prepare yourself well otherwise you will be in great danger.</VALUE>
    <VALUE Lang="GS">Please take care.</VALUE>
    <VALUE Lang="id">Terima Kasih.</VALUE>
    <VALUE Lang="id">Orang-orang yang berada di antara makhluk-makhluk aneh meminta pertolongan. Berhati - hatilah karena salah sedikit kamu akan dalam masalah besar.</VALUE>
    <VALUE Lang="cn">谢谢..</VALUE>
    <VALUE Lang="cn">请保重</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_5_0">
    <VALUE Lang="GS">Really?</VALUE>
    <VALUE Lang="GS">I was so worried... What load off, to see you.</VALUE>
    <VALUE Lang="id">Benarkah itu?</VALUE>
    <VALUE Lang="id">Saya sangat khawatir…</VALUE>
    <VALUE Lang="cn">真的吗？</VALUE>
    <VALUE Lang="cn">我一直在担心.....现在终于能心安了。非常感激您的帮忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_ami_s.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_0">
    <VALUE Lang="GS">Really…</VALUE>
    <VALUE Lang="GS">Can you help me here?</VALUE>
    <VALUE Lang="id">Bagaimana mungkin…</VALUE>
    <VALUE Lang="id">Apakah kamu datang untuk membantu saya?</VALUE>
    <VALUE Lang="cn">您真的…. 可以帮我吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_0_3">
    <VALUE Lang="GS">Confirm</VALUE>
    <VALUE Lang="id">Melakukan konfirmasi</VALUE>
    <VALUE Lang="cn">确定</VALUE>
  </SENTENSE>
