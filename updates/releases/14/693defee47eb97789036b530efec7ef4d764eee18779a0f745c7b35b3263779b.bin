  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_12_0">
    <VALUE Lang="GS">Oh! Wait! I must take care of something really quick…</VALUE>
    <VALUE Lang="id">Oh! Tunggu! Saya punya urusan mendesak...</VALUE>
    <VALUE Lang="cn">噢！请等等！我有一件很急的事情要办！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_12_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_13_0">
    <VALUE Lang="GS">Paper work is too complicated! Okay, the registration is complete and I must process the Exit Approval Form…</VALUE>
    <VALUE Lang="id">Kertas kerja terlalu membingungkan! Pendaftaran telah selesai dan saya harus mengisi Exit Approval Form..</VALUE>
    <VALUE Lang="cn">整理文件好像很复杂。注册已经完成了。不过还有外出申请书要处理唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_13_0_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_14_0">
