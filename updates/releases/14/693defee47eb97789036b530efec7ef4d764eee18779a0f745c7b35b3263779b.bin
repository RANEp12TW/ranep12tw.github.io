  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_29_0">
    <VALUE Lang="GS">Oh! You have a Spiritual Sphere. Exchange it with desired Skill Scroll.</VALUE>
    <VALUE Lang="id">"Jika kamu mempunyai Spiritual Spheres, berarti kekuatan kamu sudah cukup diakui. Pilihlah Skill yang kamu inginkan "</VALUE>
    <VALUE Lang="cn">噢！恭喜您获得灵珠。请来挑一个您想学的技能文书吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_29_0_1"><VALUE Lang="tw">兌換 赦免（137級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Exoneration (Lv137, Class=12288, Item=362/14)</VALUE><VALUE Lang="id">Skill book: Exoneration (Lv137, Class=12288, Item=362/14)</VALUE><VALUE Lang="cn">Skill book: Exoneration (Lv137, Class=12288, Item=362/14)</VALUE><VALUE Lang="th">Skill book: Exoneration (Lv137, Class=12288, Item=362/14)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_29_0_2"><VALUE Lang="tw">兌換 殲滅（137級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Genocide (Lv137, Class=12288, Item=362/34)</VALUE><VALUE Lang="id">Skill book: Genocide (Lv137, Class=12288, Item=362/34)</VALUE><VALUE Lang="cn">Skill book: Genocide (Lv137, Class=12288, Item=362/34)</VALUE><VALUE Lang="th">Skill book: Genocide (Lv137, Class=12288, Item=362/34)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_29_0_3"><VALUE Lang="tw">兌換 煙幕（127級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE><VALUE Lang="id">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE><VALUE Lang="cn">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE><VALUE Lang="th">Skill book: Smoke Screen (Lv127, Class=12288, Item=362/54)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_29_0_4">
    <VALUE Lang="GS">Learn Titan's Force</VALUE>
    <VALUE Lang="id">Pilih Titan's Force</VALUE>
    <VALUE Lang="cn">兑换 Titan's Force</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_29_0_6">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_3_0">
    <VALUE Lang="GS">Assassin is a club learning the skills to outreach the limit of human with the power of Solidified Stone and the ancient martial arts to win in a fight in any given condition!</VALUE>
    <VALUE Lang="id">Assassin adalah Class yang mempelajari hal hal diluar batas kemampuan manusia. Dengan kekuatan Solidified Stone dan Seni bela diri kuno.. Menang dalam sebuah pertempuran adalah sesuatu yang mudah!</VALUE>
    <VALUE Lang="cn">忍术部是利用固定石力量和自古流传下来的法术，在任何情况下都可以制服敌人的超强人气职业。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_3_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_3_1">
    <VALUE Lang="GS">There are tons to learn so don't rush it! Come back after you take care of the things in the campus.</VALUE>
    <VALUE Lang="id">Banyak yang harus dipelajari. Jadi jangan terlalu terburu buru! Kembalilah setelah kamu melakukan hal baik terhadap sekolahmu !</VALUE>
    <VALUE Lang="cn">您还有很多东西需要学习，慢慢来别太着急。先去完成其他校内任务，再来找我吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_3_1_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_30_0">
    <VALUE Lang="GS">Oh! You have a Spiritual Sphere. Exchange it with desired Skill Scroll.</VALUE>
    <VALUE Lang="id">"Jika kamu mempunyai Spiritual Spheres, berarti kekuatan kamu sudah cukup diakui. Pilihlah Skill yang kamu inginkan "</VALUE>
    <VALUE Lang="cn">噢！恭喜您获得灵珠。请来挑一个您想学的技能文书吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_30_0_1"><VALUE Lang="tw">兌換 黑洞（147級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="id">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="cn">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="th">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_30_0_2"><VALUE Lang="tw">兌換 迷醉（147級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="id">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="cn">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="th">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE></SENTENSE>
