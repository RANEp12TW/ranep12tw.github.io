  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_3">
    <VALUE Lang="GS">Construction Supervisor's Request</VALUE>
    <VALUE Lang="id">Permintaan Construction Supervisor</VALUE>
    <VALUE Lang="cn">Construction Supervisor的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_4">
    <VALUE Lang="GS">Give the Spare Parts</VALUE>
    <VALUE Lang="id">Memberikan genuine part</VALUE>
    <VALUE Lang="cn">传达零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_1_0_5">
    <VALUE Lang="GS">Physic Teacher's call</VALUE>
    <VALUE Lang="id">Berita panggilan dari Physics Teacher</VALUE>
    <VALUE Lang="cn">Physic Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_10_0">
    <VALUE Lang="GS">Excuse me, can you help me acquire the necessary spare parts from the Technical Teacher?</VALUE>
    <VALUE Lang="id">Maaf sebelumnya, maukah kamu mengambilkan Generator Part dari Technical Teacher?</VALUE>
    <VALUE Lang="cn">不好意思, 可以帮我从Technical Teacher那边拿发电机的零件来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_11_0">
    <VALUE Lang="GS">I cannot leave this area because these crazy workers might leave their work stations. I just don't trust them...</VALUE>
    <VALUE Lang="id">Aku tidak bisa kemana-mana karena buruh-buruh stress itu, sedikit saja aku lengah bisa-bisa pekerjaanku hancur..</VALUE>
    <VALUE Lang="cn">我因为那群疯狂的劳工而动弹不得,只怕我一离开他们就会将我已做好的工程都被搞砸了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_12_0">
    <VALUE Lang="GS">.....7</VALUE>
    <VALUE Lang="id">.....7</VALUE>
    <VALUE Lang="cn">.....7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_13_0">
    <VALUE Lang="GS">That's right! These are the spare parts I'm looking for. Thank you very much!</VALUE>
    <VALUE Lang="GS">This can help our construction project for a while until something breaks down again. I'm keeping my fingers crossed that something like that won't happen...</VALUE>
    <VALUE Lang="id">Benar! Ini lah genuine part yang sedang kucari</VALUE>
    <VALUE Lang="id">Terima kasih banyak ya</VALUE>
    <VALUE Lang="cn">没错! 这就是我之前找的零件</VALUE>
    <VALUE Lang="cn">真是多谢</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_14_0">
    <VALUE Lang="GS">What's wrong? Why is everyone like this? Everything looks weird around here. Am I in another dimension?</VALUE>
    <VALUE Lang="id">Walaupun nantinya kerusakan tidak dapat dicegah, setidaknya untuk sementara waktu aku dapat bekerja</VALUE>
    <VALUE Lang="id">Ngomong-nngomong apa yang terjadi, mengapa orang-orang berubah seperti itu?</VALUE>
    <VALUE Lang="cn">虽然没有让它不再故障的办法, 不过可以作业好一阵子了.</VALUE>
    <VALUE Lang="cn">不过这到底是怎么搞的, 人们会变成那模样</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_2_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_3_0">
    <VALUE Lang="GS">The supervisor in charge of this construction project is hiding!</VALUE>
    <VALUE Lang="GS">This is bad! Our construction deadline is close!</VALUE>
    <VALUE Lang="id">Padahal dulu saya mengatur perbaikkan jalan ini tapi sekarang saya tidak bisa apa-apa dan menghindar seperti ini.</VALUE>
    <VALUE Lang="id">Gawat sekali~ Padahal batas waktu konstruksinya hampir tiba</VALUE>
    <VALUE Lang="cn">本来在旁边管理工程, 现在却躲的远远的.</VALUE>
    <VALUE Lang="cn">大事不妙~ 工程期限就快到了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_4_0">
    <VALUE Lang="GS">It's troubling to know most of the people at the construction site are acting funny and most of the machinery broke down. There's going to be a delay in the construction work, and the site is just full of turmoil.</VALUE>
    <VALUE Lang="id">Padahal saya harus kerja</VALUE>
    <VALUE Lang="cn">是该做事没错, 不过人们变的怪怪的, 机器也故障, 实在麻烦</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_4_0_1">
    <VALUE Lang="GS">Ask Who It Is</VALUE>
    <VALUE Lang="id">Bertanya siapa anda</VALUE>
    <VALUE Lang="cn">请问是谁？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_5_0">
    <VALUE Lang="GS">Oh, please get rid of those stubborn students! We can't get anything done with them around! We've got enough trouble as it is!</VALUE>
    <VALUE Lang="id">Wooot, pelajar seperti kamu yang disuruh toh?</VALUE>
    <VALUE Lang="id">Waktu sudah tidak cukup lagi... Terpakas.. Gpp deh?!</VALUE>
    <VALUE Lang="cn">喔,把这种学生送走吧</VALUE>
    <VALUE Lang="cn">没时间没办法呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_5_0_1">
    <VALUE Lang="GS">Construction Supervisor's Request</VALUE>
    <VALUE Lang="id">Permintaan Construction Supervisor</VALUE>
    <VALUE Lang="cn">Construction Supervisor的请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_6_0">
    <VALUE Lang="GS">Would you please hear me out? I could use your help.</VALUE>
    <VALUE Lang="GS">In order to complete construction by the deadline, we must replace these crazy workers with efficiently working machinery. The problem is that the generator is broken. This just makes things more complicated!</VALUE>
    <VALUE Lang="id">Aku mau mendengarkan permintaan para pelajar</VALUE>
    <VALUE Lang="id">Untuk menggantikan para buruh yang stress, aku harus menggilir mesin-mesin ini dengan waktu yang terbatas, sekarang, Generator pun rusak</VALUE>
    <VALUE Lang="cn">听听我的请求</VALUE>
    <VALUE Lang="cn">为了要在期限内完工,必须要使用机器人来代替疯掉的工人们,但是现在竟然连发电机都坏掉了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_6_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_7_0">
    <VALUE Lang="GS">My friend from the Sword Section told me that this is not the only area where strange things started to happen. Now imagine what would happen to our world if this chaos continues and spreads.</VALUE>
    <VALUE Lang="id">Beberapa waktu lalu, saya mendengar cerita dari teman saya yang juga seorang pelajar Sword, hanya tempat ini saja yang masih normal?!</VALUE>
    <VALUE Lang="id">wah…benar-benar… kacau…</VALUE>
    <VALUE Lang="cn">上次听剑道部一个学生朋友说, 不是只有这里这样子..</VALUE>
    <VALUE Lang="cn">唉... 世界将会变成什么样子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_7_0_1">
    <VALUE Lang="GS">Physics Teacher's Call</VALUE>
    <VALUE Lang="id">Panggilan dari Physics Teacher</VALUE>
    <VALUE Lang="cn">Physics Teacher的呼叫</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_8_0">
    <VALUE Lang="GS">I'm pretty nervous. I'm expecting news from the Physics Teacher at Sacred Gate College. Please find him! He said he would wait near the Sacred Gate Ring.</VALUE>
    <VALUE Lang="id">Aaaa, hampir saja lupa</VALUE>
    <VALUE Lang="id">Tadi ada kabar dari Physics Teacher dari sekolah Phoenix</VALUE>
    <VALUE Lang="id">Di-sana beliau pasti sedang menunggu di Phoenix Small Square</VALUE>
    <VALUE Lang="cn">阿 差点吓死</VALUE>
    <VALUE Lang="cn">刚刚Sacred Gate College的Physics Teacher那边有消息传来</VALUE>
    <VALUE Lang="cn">他说会去Sacred Gate Ring等您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_workmaster1.ntk_9_0">
    <VALUE Lang="GS">.....6</VALUE>
    <VALUE Lang="id">.....6</VALUE>
    <VALUE Lang="cn">.....6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0">
    <VALUE Lang="GS">Ask about "Dragon Boat Event"</VALUE>
    <VALUE Lang="id">Bertanya tentang "Dragon Boat Event"</VALUE>
    <VALUE Lang="cn">询问什么是"端午节"。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_1">
    <VALUE Lang="GS">Yes</VALUE>
    <VALUE Lang="id">Iya</VALUE>
    <VALUE Lang="cn">是的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_2">
    <VALUE Lang="GS">Get experience reward</VALUE>
    <VALUE Lang="id">Menerima Hadiah Experience</VALUE>
    <VALUE Lang="cn">领取经验奖励</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_1_0_3">
    <VALUE Lang="GS">Exchange Exorcist Ring(15D)</VALUE>
    <VALUE Lang="id">Tukar Exorcist Ring(15D)</VALUE>
    <VALUE Lang="cn">交换 Exorcist Ring(15D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_55.ntk_2_0">
    <VALUE Lang="GS">I believe in you, you can make it!</VALUE>
    <VALUE Lang="id">Saya percaya kamu pasti bisa!!</VALUE>
    <VALUE Lang="cn">我相信您！您做得到的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0">
    <VALUE Lang="GS">Hello~! Long time to meet outsider in this place~</VALUE>
    <VALUE Lang="GS">I do not care how can you reached this place but it will be better if you leave as soon as possible since these guys will not believe it.</VALUE>
    <VALUE Lang="GS">By the way, can you help me?</VALUE>
    <VALUE Lang="id">Hello~! Lama sekali sudah tidak pernah melihat orang luar di sini~</VALUE>
    <VALUE Lang="id">Saya tidak peduli bagaimana kamu bisa sampai di sini tapi ada baiknya kamu segera keluar dari sini.</VALUE>
    <VALUE Lang="id">Ngomong - ngomong, bisakah kamu membantu saya?</VALUE>
    <VALUE Lang="cn">你好~!在这里看起来像个外地来的…</VALUE>
    <VALUE Lang="cn">来这里…因为那些家伙让我无法逃离这地方。</VALUE>
    <VALUE Lang="cn">可以帮我一个忙吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">进行交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_2">
    <VALUE Lang="GS">Miscellaneos Savior</VALUE>
    <VALUE Lang="id">Miscellaneos Savior</VALUE>
    <VALUE Lang="cn">Miscellaneos Savior</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_3">
    <VALUE Lang="GS">Stockholm Syndrome</VALUE>
    <VALUE Lang="id">Stockholm Syndrome</VALUE>
    <VALUE Lang="cn">斯德哥尔摩症候群</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_4">
    <VALUE Lang="GS">Collect Terrorist's Supply</VALUE>
    <VALUE Lang="id">Mengumpulkan Terrorist's Supply</VALUE>
    <VALUE Lang="cn">收集Terrorist的补给品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_5">
    <VALUE Lang="GS">Heavy Destroyer</VALUE>
    <VALUE Lang="id">Heavy Destroyer</VALUE>
    <VALUE Lang="cn">Heavy Destroyer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_6">
    <VALUE Lang="GS">Certificate Collector</VALUE>
    <VALUE Lang="id">Certificate Collector</VALUE>
    <VALUE Lang="cn">通行证收集狂</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_7">
    <VALUE Lang="GS">Change the Coupon.</VALUE>
    <VALUE Lang="id">Tukar kupon.</VALUE>
    <VALUE Lang="cn">兑换礼票</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_1_0_8">
    <VALUE Lang="GS">Certificate Collector</VALUE>
    <VALUE Lang="id">Certificate Collector</VALUE>
    <VALUE Lang="cn">通行证收集狂</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_2_0">
    <VALUE Lang="GS">Urrgghh~ My stomach~~ Lately I do not eat anything because keep busy hiding from these guys.</VALUE>
    <VALUE Lang="GS">Do you have any food for me? Please try to find some of it for me.</VALUE>
    <VALUE Lang="id">Urrgghh~ Perut saya~~ Belakangan ini saya tidak makan apapun karena sibuk kabur dari orang - orang ini.</VALUE>
    <VALUE Lang="id">Apakah kamu ada makanan buat saya? Kalau tidak ada, tolong carikan saya.</VALUE>
    <VALUE Lang="cn">咕噜咕噜....唉攸我的肚子。躲在这里好几天都没吃东西，快饿扁了..</VALUE>
    <VALUE Lang="cn">你身上有吃的吗? 帮我找到吃的就送给你我的收藏品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_3_0">
    <VALUE Lang="GS">I have already spying them for a few days and I find something weird. At the first time, it was normal but slowly their movement is same with Terrorist action.</VALUE>
    <VALUE Lang="id">Saya menemukan ada yang aneh setelah saya memata - matai mereka. Awalnya sih baik - baik saja tetapi pelan - pelan aktifitas mereka mirip teroris.</VALUE>
    <VALUE Lang="cn">这几天困在这里发现一件奇怪的事。一开始反抗的工人慢慢和侦搜部队靠拢开始协助他们。</VALUE>
    <VALUE Lang="cn">请尽快阻止他们不要让更多人​​被同化。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_4_0">
    <VALUE Lang="GS">Each Terrorist has 1 Certificate in their pocket.</VALUE>
    <VALUE Lang="GS">I found they will show it when it need as a proof.</VALUE>
    <VALUE Lang="id">Setiap Teroris punya 1 Certificate di kantong mereka.</VALUE>
    <VALUE Lang="id">Mereka akan menunjukkannya ketika diperlukan sebagai bukti.</VALUE>
    <VALUE Lang="cn">听说侦搜部队每个人都有一张通行证Certificate。曾经看到他们在领取补给品时拿出通行证</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_5_0">
    <VALUE Lang="GS">Some of the workers there work with pretty heavy duty military border. They drive some big and heavy bulldozer which very scary.</VALUE>
    <VALUE Lang="id">Beberapa pekerja di sini bekerja dengan peralatan sangat berat dari militer. Yang mengedarai buldozer juga sangat menakutkan.</VALUE>
    <VALUE Lang="cn">有一些工人看起来是负责重装备技术。想到如果他们把零件组装开始动乱...想到就觉得很可怕。</VALUE>
    <VALUE Lang="cn">你也来一起帮忙说不定可以扭转情势</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_6_0">
    <VALUE Lang="GS">So here is Terrorist Area right?</VALUE>
    <VALUE Lang="GS">You are so quick! How do you know I need a gun?</VALUE>
    <VALUE Lang="GS">By the way, please collect some coupon for me and I will give you something useful.</VALUE>
    <VALUE Lang="id">Jadi ini area teroris kan?</VALUE>
    <VALUE Lang="id">Kamu sangat cepat, bagaimana kamu tahu saya butuh senjata?</VALUE>
    <VALUE Lang="id">Bawakan saya beberapa kupon dan akan kuganti dengan hadiah.</VALUE>
    <VALUE Lang="cn">所以。这里是Terrorist Area！</VALUE>
    <VALUE Lang="cn">您的反应真快！怎么会知道我想要的是什么？</VALUE>
    <VALUE Lang="cn">哈哈！现在身上没有这个东西，不过只要搜集兑换券交给我，就可以给你我的收藏品。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert_chainsaw.ntk_1_0">
    <VALUE Lang="GS">W-W-Wait a minute!! I do not have any relation with the Terrorist! Wew… If you need something, please let me know so I can help you.</VALUE>
    <VALUE Lang="id">T-T-Tunggu sebentar!! Saya tidak ada hubungannya dengan teroris! Wew… beritahu jika kamu memerlukan sesuatu.</VALUE>
    <VALUE Lang="cn">等...一下!!我跟侦搜部队一点关系也没有!呼...我也看他们很不顺眼，有任何需要尽管跟我说</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_airport_desert_chainsaw.ntk_1_0_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">进行交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_10">
    <VALUE Lang="GS">Get confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">取得确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_2">
    <VALUE Lang="GS">Ask who she is</VALUE>
    <VALUE Lang="id">Bertanya siapa anda</VALUE>
    <VALUE Lang="cn">询问她是谁？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_3">
    <VALUE Lang="GS">Ask about Garansanoa's friends</VALUE>
    <VALUE Lang="id">Bertanya tentang teman Garansanoa</VALUE>
    <VALUE Lang="cn">询问Garansanoa的同伴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_4">
    <VALUE Lang="GS">Tell her you will stop Lucian.</VALUE>
    <VALUE Lang="id">Berkata akan menghentikan Lucian</VALUE>
    <VALUE Lang="cn">告诉他，您会阻止Lucian。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_5">
    <VALUE Lang="GS">I would like to help</VALUE>
    <VALUE Lang="id">Ingin memberikan bantuan</VALUE>
    <VALUE Lang="cn">我想要帮忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_6">
    <VALUE Lang="GS">Get confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">取得确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_7">
    <VALUE Lang="GS">Purify the Basement</VALUE>
    <VALUE Lang="id">Ingin membereskan musuh di Basement</VALUE>
    <VALUE Lang="cn">净化 Basement</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_8">
    <VALUE Lang="GS">Get confirmation</VALUE>
    <VALUE Lang="id">Mendapatkan konfirmasi</VALUE>
    <VALUE Lang="cn">取得确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_1_0_9">
    <VALUE Lang="GS">I would like to help Priest</VALUE>
    <VALUE Lang="id">Ingin membantu Priest</VALUE>
    <VALUE Lang="cn">我想要帮Priest的忙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_10_0">
    <VALUE Lang="GS">This isn't an easy job. They are stronger than the High Elders so be very carful.</VALUE>
    <VALUE Lang="id">Bukan hal yang mudah. Priest tingkat atas lebih kuat, Hati-hati saja</VALUE>
    <VALUE Lang="cn">这不是件容易的事情。他们比High Elders还要强大，请您务必要小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_10_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_11_0">
    <VALUE Lang="GS">Sister.. Please rest in peace..</VALUE>
    <VALUE Lang="id">Saudaraku sekalian, pergilah dengan tenang</VALUE>
    <VALUE Lang="cn">好姐妹…..请别那么紧绷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_11_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_2_0">
    <VALUE Lang="GS">I am one of the Priests who serve Daian</VALUE>
    <VALUE Lang="id">Salah satu Priest yang mengadakan pesta keagamaan besar kan</VALUE>
    <VALUE Lang="cn">我是服侍Daian 的Priest。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_2_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_3_0">
    <VALUE Lang="GS">A guy named Lucian is trying to harm Garansanoa's friend Liz and to take the Adoniechus.</VALUE>
    <VALUE Lang="id">Seseorang bernama Lucian membunuh teman master Garansanoa yang bernama Ace dan ingin merebut Adoniecuse</VALUE>
    <VALUE Lang="cn">一个叫做Lucian的人，试图要伤害 Garansanoa的朋友Liz，甚至夺取Adoniechus绝对起点。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_3_0_1">
    <VALUE Lang="GS">Ask if there is anybody else</VALUE>
    <VALUE Lang="id">Bertanya mungkin saja ada orang lain</VALUE>
    <VALUE Lang="cn">询问还有其他人吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_4_0">
    <VALUE Lang="GS">Well, there is another person called Gainun from Roo Tribe. Not like us, he is the assassin of Roo tribe so be extra careful.</VALUE>
    <VALUE Lang="id">Ada satu orang lagi yang bernama Gainon dari suku Lu. Berbeda dengan suku Daeyun seperti kita, dia adalah pembunuh dari suku Lu. Maka dari itu berhati-hatilah</VALUE>
    <VALUE Lang="cn">这个嘛…. 有个从Roo Tribe来的族人，叫作Gainun。跟我们很不一样，您必须加强警戒，小心提防。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_4_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_5_0">
    <VALUE Lang="GS">This wouldn't be any of your concern, is it? I am not going to turn down if you would like to help</VALUE>
    <VALUE Lang="id">Ini nggak ada hubungnnya sama kamu, tapi kalau emang mau bantu yah nggak apa-apa</VALUE>
    <VALUE Lang="cn">这是和您无关的事情。不过，如果您帮我的话，我可以考虑接受您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_5_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_6_0">
    <VALUE Lang="GS">Please go face Hillo</VALUE>
    <VALUE Lang="id">Kamu tangani musuh yang bernama Hillo saja</VALUE>
    <VALUE Lang="cn">请对付 Hillo。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_6_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_7_0">
    <VALUE Lang="GS">Not bad. Would you like to try again?</VALUE>
    <VALUE Lang="id">Nggak jelek juga, mau lagi?</VALUE>
    <VALUE Lang="cn">不错唷。 你要再试试吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_7_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_8_0">
    <VALUE Lang="GS">Go face Cyclops. He is strong so be careful.</VALUE>
    <VALUE Lang="id">Tangani orang yang bernama Cyclos deh, hati-hati saja karena dia musuh yang kuat</VALUE>
    <VALUE Lang="cn">请对付Cyclop。它的力量很强，请小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_8_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_9_0">
    <VALUE Lang="GS">Good. Go purify those who have lost their will.</VALUE>
    <VALUE Lang="id">Bagus, bisa tolong murnikan semua orang yang sudah kehilangan akalnya</VALUE>
    <VALUE Lang="cn">很好。请继续净化失去理智的人。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ark.ntk_9_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0">
    <VALUE Lang="GS">This is the Bus Stop.</VALUE>
    <VALUE Lang="GS">Once have your Bus Ticket ready, you can use the Bus Service to move to another area.</VALUE>
    <VALUE Lang="id">Informasi rute bus kota</VALUE>
    <VALUE Lang="id">Untuk menggunakan bus cukup menunjukan tiket</VALUE>
    <VALUE Lang="cn">这里是公车站。只要您拥有Bus Ticket ，就可以使用公车服务，畅游各地区唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_1">
    <VALUE Lang="GS">Ride the Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_10">
    <VALUE Lang="GS">Transmit the Documents</VALUE>
    <VALUE Lang="id">Mentransmisikan Dokumen</VALUE>
    <VALUE Lang="cn">传送文件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_3">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_4">
    <VALUE Lang="GS">Send Out Skill Document</VALUE>
    <VALUE Lang="id">Mengirimkan Dokumen Skill</VALUE>
    <VALUE Lang="cn">寄出Skill Document。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_5">
    <VALUE Lang="GS">Find the Stolen Dry Ice</VALUE>
    <VALUE Lang="id">Mencarikan Stolen Dry Ice</VALUE>
    <VALUE Lang="cn">找出被偷走的Dry Ice。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_6">
    <VALUE Lang="GS">Deliver Emergency Action Guide</VALUE>
    <VALUE Lang="id">Mengantar Emergency Action Guide</VALUE>
    <VALUE Lang="cn">传递 Emergency Action Guide。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_7">
    <VALUE Lang="GS">Investigate Dead Police</VALUE>
    <VALUE Lang="id">Menginvestigasi Dead Polisi</VALUE>
    <VALUE Lang="cn">调查死亡的Police。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_8">
    <VALUE Lang="GS">Action on Spell Defensive Mechanism</VALUE>
    <VALUE Lang="id">Action on Spell Defensive Mechanism</VALUE>
    <VALUE Lang="cn">法术防御机制动作</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_1_0_9">
    <VALUE Lang="GS">Action on Spell Defensive Mechanism</VALUE>
    <VALUE Lang="id">Action on Spell Defensive Mechanism</VALUE>
    <VALUE Lang="cn">法术防御机制动作</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_2_0">
    <VALUE Lang="GS">Document Scan is now complete.</VALUE>
    <VALUE Lang="GS">Do you want to send?</VALUE>
    <VALUE Lang="id">Dokumen sudah selesai discan.</VALUE>
    <VALUE Lang="id">Apakah mau dikirim?</VALUE>
    <VALUE Lang="cn">已完成文件的扫描。要发送吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_2_0_1">
    <VALUE Lang="GS">Send Out Skill Document</VALUE>
    <VALUE Lang="id">Mengirimkan Dokumen Skill</VALUE>
    <VALUE Lang="cn">寄出Skill Document。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_3_0">
    <VALUE Lang="GS">Processing...</VALUE>
    <VALUE Lang="GS">Document has been sent.</VALUE>
    <VALUE Lang="id">Proses...</VALUE>
    <VALUE Lang="id">Dokumen sudah terkirim~~</VALUE>
    <VALUE Lang="cn">处理中……..</VALUE>
    <VALUE Lang="cn">文件已传送完成。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_3_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Mulai</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_4_0">
    <VALUE Lang="GS">Dry ice is very important for storing ice cream, but the dry ice kept in the warehouse has been stolen. It's now your job to find the stolen dry ice.</VALUE>
    <VALUE Lang="id">Es Kering sangat penting untuk mencegah es krim mencair. Akan tetapi, setiap hari ada saja yang menghilang karena dicuri. Bisakah kamu membantu saya mencarinya?.</VALUE>
    <VALUE Lang="cn">Dry ice是储存冰淇淋最重要的东西。但被保管在Warehouse的Dry ice竟然被偷走了。请把它找出来。谢谢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_5_0">
    <VALUE Lang="GS">There are some places where the emergency action guide hasn't been delivered yet. Get the guide books near the book stores and distribute them.</VALUE>
    <VALUE Lang="id">Masih ada beberapa tempat yang belum tersampaikan pembagian Emergency Action Guide nya. Ambil Guide Books nya dekat toko buku dan tolong disalurkan..</VALUE>
    <VALUE Lang="cn">还是有些地方尚未接收到紧急措施的相关指令。请至Book Store附近领取导览手册， 并发给他们吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_6_0">
    <VALUE Lang="GS">You should obtain the security monitor videotape to report about the dead policeman in the prison.</VALUE>
    <VALUE Lang="GS">The prisoners already transferred that videotape somewhere, so try to retrieve the security monitor videotape from the prisoners.</VALUE>
    <VALUE Lang="id">Kamu seharusnya mendapatkan videotape yang berisi tentang laporan kematian polisi di penjara.</VALUE>
    <VALUE Lang="id">Video tersebut sudah dikirim ke suatu tempat, jadi tolong coba cari di sekitar prisoner.</VALUE>
    <VALUE Lang="cn">您应该要取得安全监控录像，并报告在监狱里死亡的警察事件。Prisoner已经将该录影带送到某处了。 请从他身上取回录影带。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_7_0">
    <VALUE Lang="GS">Many students were injured from the spell attacks, and especially large number of students were injured in Root Hole. Retrieve the spell skill document from the Elemental Sorcerer to make defensive mechanism work against the spell attacks.</VALUE>
    <VALUE Lang="id">Banyak pelajar yang terluka karena serangan sihir dan rata - rata terluka di Root Hole. Ambil spell skill dokumen dari Elemental Sorcerer untuk membuat alat mekanism berjalan normal lagi untuk menghadang sihir tersebut.</VALUE>
    <VALUE Lang="cn">许多学生受了法术之伤，特别是 Root Hole的学生伤得最严重。请您从Elemental Sorcerer那儿取回法术技能的文件，并制作防御装置。这是为了要阻挡来自法术的伤害持续扩大。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_busteminal.ntk_8_0">
    <VALUE Lang="GS">Completed.</VALUE>
    <VALUE Lang="id">Selesai</VALUE>
    <VALUE Lang="cn">完成</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0">
    <VALUE Lang="GS">Ah! Aren't you a student?</VALUE>
    <VALUE Lang="GS">Why do you look so troubled?</VALUE>
    <VALUE Lang="id">Ah, saya..itu…</VALUE>
    <VALUE Lang="id">Tolong…</VALUE>
    <VALUE Lang="cn">阿！您是学生吗？</VALUE>
    <VALUE Lang="cn">您看起来很狼狈。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_10">
    <VALUE Lang="GS">Ask about What Happened</VALUE>
    <VALUE Lang="id">Bertanya ada masalah apa</VALUE>
    <VALUE Lang="cn">询问发生何事了？</VALUE>
  </SENTENSE>
