  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_0_7">
    <VALUE Lang="GS">Give the Equipment</VALUE>
    <VALUE Lang="id">Menyerahkan peralatan</VALUE>
    <VALUE Lang="cn">传达装备</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_0_8">
    <VALUE Lang="GS">Give the Equipment</VALUE>
    <VALUE Lang="id">Menyerahkan peralatan</VALUE>
    <VALUE Lang="cn">传达装备</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_0_9">
    <VALUE Lang="GS">Ask about the Lost Child</VALUE>
    <VALUE Lang="id">Bertanya tentang anak-anak yang hilang</VALUE>
    <VALUE Lang="cn">询问遗失的孩子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1">
    <VALUE Lang="GS">Ah! My daughter is missing! I hope you're here to help me. I'm so worried about her!</VALUE>
    <VALUE Lang="GS">What can I do for you now?</VALUE>
    <VALUE Lang="id">Aduh~ aduh~ anak saya…</VALUE>
    <VALUE Lang="cn">噢！我的女儿走失了！我希望您可以帮我。我很担心她。现在我能做些什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_1">
    <VALUE Lang="GS">Request for Cassette Recovery</VALUE>
    <VALUE Lang="id">Meminta perbaikan tape</VALUE>
    <VALUE Lang="cn">委托复原卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_10">
    <VALUE Lang="GS">Ask about the Cassette</VALUE>
    <VALUE Lang="id">Bertanya tentang tape</VALUE>
    <VALUE Lang="cn">询问卡带的状况</VALUE>
  </SENTENSE>
