  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_8">
    <VALUE Lang="GS">Ask about the Lost Child</VALUE>
    <VALUE Lang="id">Bertanya tentang anak-anak yang hilang</VALUE>
    <VALUE Lang="cn">询问遗失的孩子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_1_1_9">
    <VALUE Lang="GS">Request for Cassette Recovery</VALUE>
    <VALUE Lang="id">Meminta perbaikan tape</VALUE>
    <VALUE Lang="cn">请求复原卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_10_0">
    <VALUE Lang="GS">Is it about Mr. Brave?</VALUE>
    <VALUE Lang="GS">Yes? Sometimes I hear people complaining about him. I just ignore them.</VALUE>
    <VALUE Lang="id">Kata-kata dari bapak tua itu rupanya?</VALUE>
    <VALUE Lang="id">Iya, kadang beliau datang dan pergi setelah memberikan segumpal omelan</VALUE>
    <VALUE Lang="cn">是说勇敢先生吗</VALUE>
    <VALUE Lang="cn">是的有时候来这里发发一大堆的牢骚然后走人</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_11_0">
    <VALUE Lang="GS">That's right, this is the oil!</VALUE>
    <VALUE Lang="GS">So, where did you get these?</VALUE>
    <VALUE Lang="id">Iya benar, minyak ini…..</VALUE>
    <VALUE Lang="id">Kalau begitu coba…</VALUE>
    <VALUE Lang="id">Nah….</VALUE>
    <VALUE Lang="id">Seperti ini</VALUE>
    <VALUE Lang="id">Kalau begitu…</VALUE>
    <VALUE Lang="id">Ya, sudah cukup</VALUE>
    <VALUE Lang="cn">没错!就是这油.</VALUE>
    <VALUE Lang="cn">那么..... 哪里来?</VALUE>
    <VALUE Lang="cn">这样做的话...</VALUE>
    <VALUE Lang="cn">是的,完成了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_12_0">
    <VALUE Lang="GS">.....2</VALUE>
    <VALUE Lang="id">.....2</VALUE>
    <VALUE Lang="cn">.....2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_13_0">
    <VALUE Lang="GS">What? Broken Cassette?</VALUE>
    <VALUE Lang="GS">I can't help you with that right now!</VALUE>
    <VALUE Lang="GS">My daughter has such a high fever!</VALUE>
    <VALUE Lang="GS">Please, please help my daughter! She needs immediate medical treatment!</VALUE>
    <VALUE Lang="id">Apa ini, tape yang rusak?</VALUE>
    <VALUE Lang="id">Sekarang bukan saatnya untuk melihat hal seperti itu</VALUE>
    <VALUE Lang="id">Anak saya…</VALUE>
    <VALUE Lang="id">Karena aku mendapatkan demam tinggi secara tiba-tiba dan sepertinya akan mati</VALUE>
    <VALUE Lang="id">Kamu pelajar dari yayasan saint kan? Tolong selamatkan puteri saya</VALUE>
    <VALUE Lang="cn">什么 毁损的带子</VALUE>
    <VALUE Lang="cn">现在不能看那些东西</VALUE>
    <VALUE Lang="cn">我的女儿突然因为过敏快要死于高烧</VALUE>
    <VALUE Lang="cn">同学,你是圣者学生吧?请你一定要救我女儿</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_14_0">
    <VALUE Lang="GS">........8</VALUE>
    <VALUE Lang="id">........8</VALUE>
    <VALUE Lang="cn">........8</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_15_0">
    <VALUE Lang="GS">You better check out the content of the cassette before returning it back to the Campus.</VALUE>
    <VALUE Lang="id">Sepertinya lebih baik kamu memperlihatkannya dulu ke sekolah kamu</VALUE>
    <VALUE Lang="id">Kayaknya isinya tidak biasa</VALUE>
    <VALUE Lang="cn">先带学生去学院 再给你看比较好</VALUE>
    <VALUE Lang="cn">反正似乎并不是无聊的内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_15_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_16_0">
    <VALUE Lang="GS">......10</VALUE>
    <VALUE Lang="id">......10</VALUE>
    <VALUE Lang="cn">......10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_17_0">
    <VALUE Lang="GS">Please take good care of that cassette!</VALUE>
    <VALUE Lang="GS">It's very fragile: we might not be able to recover its data again.</VALUE>
    <VALUE Lang="id">Permintaan dari beliau? Harus saya selesaikan dengan tepat</VALUE>
    <VALUE Lang="id">Kalau tidak hati-hati bisa-bisa dia terus mengomel berhari-hari</VALUE>
    <VALUE Lang="cn">是那位的请求 所以要确实处理</VALUE>
    <VALUE Lang="cn">如果做不好的话有好几天要听他发牢骚了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_17_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_18_0">
    <VALUE Lang="GS">I'm so stressed out!</VALUE>
    <VALUE Lang="GS">Need some Special Oil to recover my dizziness.</VALUE>
    <VALUE Lang="GS">Please help me.</VALUE>
    <VALUE Lang="id">Euhm…</VALUE>
    <VALUE Lang="id">Ini sudah rusak dengan aneh</VALUE>
    <VALUE Lang="id">Saya tidak tahu kalau di pantai apakah akan seperti ini….</VALUE>
    <VALUE Lang="id">Saya butuh sedikit minyak untuk memperbaikinya</VALUE>
    <VALUE Lang="cn">嗯</VALUE>
    <VALUE Lang="cn">这变质的有点特别</VALUE>
    <VALUE Lang="cn">不是很清楚泡面在海中会变成这程度</VALUE>
    <VALUE Lang="cn">要恢复的话需要一些油</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_18_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_19_0">
    <VALUE Lang="GS">I already ordered that Special Oil, but it hasn't been delivered to me yet. I heard that it was unloaded at No.3 Wharf. Can you go there and get it for me?</VALUE>
    <VALUE Lang="id">Kebetulan ada yang sudah saya pesan dulu tapi belum sampai</VALUE>
    <VALUE Lang="id">Katanya sudah pasti akan ada di kapal yang tiba di Wharf passage no.3</VALUE>
    <VALUE Lang="cn">我之前刚好有订，不过到现在还没到。</VALUE>
    <VALUE Lang="cn">听说是装载在抵达三号码头No.3 Wharf的船上。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_19_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0">
    <VALUE Lang="GS">The Hospital services are unable to treat my daughter. Sadly, the Police Department cannot do their duties. It is total chaos around here. Please! You must help my daughter...</VALUE>
    <VALUE Lang="GS">If you do, then I'll help you to recover that Cassette.</VALUE>
    <VALUE Lang="id">Rumah sakit berubah jadi sangat aneh dan kita tidak bisa mendapatkan pengobatan selayaknya, di tambah lagi para polisi tidak bisa mengambil tindakkan yang seharusnya</VALUE>
    <VALUE Lang="id">Saya mohon anak saya…kalau begitu akan saya bantu memperbaiki tapenya</VALUE>
    <VALUE Lang="cn">医院也变得好奇怪无法接受治疗警察也动弹不得</VALUE>
    <VALUE Lang="cn">请你一定要救我女儿那我就会协助你复原带子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_2">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_3">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_4">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_5">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Terima Pesan</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_6">
    <VALUE Lang="GS">Refuse</VALUE>
    <VALUE Lang="id">Tolak</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_2_0_7">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_20_0">
    <VALUE Lang="GS">Could you help me look for it?</VALUE>
    <VALUE Lang="GS">Meanwhile, I'll just try my best to relax.</VALUE>
    <VALUE Lang="GS">Oh, and please be careful. I hear that area's kind of dangerous.</VALUE>
    <VALUE Lang="id">Bisakah kamu pergi ke sana dan mencarikannya untukku?</VALUE>
    <VALUE Lang="id">Saya akan berusaha untuk mengembalikannya sebanyak-banyaknya, kalau ada minyak semuanya akan selesai.</VALUE>
    <VALUE Lang="cn">可以帮我去找看看吗?</VALUE>
    <VALUE Lang="cn">这段时间我会尽量帮你复原,只要有油就可以结束了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_20_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_21_0">
    <VALUE Lang="GS">Our radio also acts up like this…</VALUE>
    <VALUE Lang="GS">It seems to be caused by a magnetic field.</VALUE>
    <VALUE Lang="id">Di radio kami juga ada gejala seperti ini…</VALUE>
    <VALUE Lang="id">Mungkin pada saat kecelakaan itu terjadi ada medan gaya kuat yang muncul</VALUE>
    <VALUE Lang="id">Tidak ada part yang sudah dipersiapkan juga…</VALUE>
    <VALUE Lang="cn">我们的收音机也有这种现象…</VALUE>
    <VALUE Lang="cn">异变发生的时候，好像产生了像很强磁场的东西。</VALUE>
    <VALUE Lang="cn">也没给我准备零附件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_21_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_22_0">
    <VALUE Lang="GS">Oh, this is a walkie-talkie! We can use this to talk to each other.</VALUE>
    <VALUE Lang="GS">But now we know a little more. Try going to that location and taking a look.</VALUE>
    <VALUE Lang="id">Ah, kalau radio itu kan yang dulu dijual di depan Sports Center…</VALUE>
    <VALUE Lang="id">Bisa menggunakan part dari Hangphone rupanya</VALUE>
    <VALUE Lang="id">Mungkin sekarang sudah dievakuasi atau menghilang</VALUE>
    <VALUE Lang="id">Mungkin saja, coba cek dan cari ke tempat itu</VALUE>
    <VALUE Lang="id">Bisa menggunakan handphone atau charg</VALUE>
    <VALUE Lang="cn">这是一个对讲机！我们可以用它来相互交谈。</VALUE>
    <VALUE Lang="cn">但现在我们可以尝试更多！</VALUE>
    <VALUE Lang="cn">请您前往该位置，并和我一起来试看看。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_22_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_23_0">
    <VALUE Lang="GS">So lucky!</VALUE>
    <VALUE Lang="GS">Sure, I think I can repair this.</VALUE>
    <VALUE Lang="id">Untung saja.</VALUE>
    <VALUE Lang="id">Dengan ini perbaikannya sudah pasti bisa</VALUE>
    <VALUE Lang="id">Di mana…</VALUE>
    <VALUE Lang="id">Nah, selesai!</VALUE>
    <VALUE Lang="cn">真幸运啊。</VALUE>
    <VALUE Lang="cn">如果是这样的话，确实是可以修理的。</VALUE>
    <VALUE Lang="cn">哪里…</VALUE>
    <VALUE Lang="cn">来，就此结束!"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_23_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_24_0">
    <VALUE Lang="GS">Finally... There's a student who wants to enter the Head Office.</VALUE>
    <VALUE Lang="GS">Why? My shop required to prepare this equipment.</VALUE>
    <VALUE Lang="GS">Who is expecting this?</VALUE>
    <VALUE Lang="GS">It's none of my business, but I'm a bit worried about you since you helped me a lot before.</VALUE>
    <VALUE Lang="id">Akhirnya….ada juga pelajar yang mau masuk ke Kantor pusat yayasan</VALUE>
    <VALUE Lang="id">Kenapa yah, di toko kami peralatan-peralatan yang bahkan tidak diperlukan seperti ini sudah disiapkan dengan setengah terpaksa…</VALUE>
    <VALUE Lang="id">Seseorang sudah memperkirakannya kok?</VALUE>
    <VALUE Lang="id">Hal itu tidak</VALUE>
    <VALUE Lang="cn">终于… 想要踏进财团Head Office的学生出现了。</VALUE>
    <VALUE Lang="cn">为什么呢, 我们店里不需要这些设备，但是半强迫的状态下所准备的…</VALUE>
    <VALUE Lang="cn">谁早有预想过吗?</VALUE>
    <VALUE Lang="cn">跟我无关的事情，但是学生是多次帮助过我，所以比较担心。 "</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_24_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_25_0">
    <VALUE Lang="GS">Can I see?</VALUE>
    <VALUE Lang="GS">Oh… It's that one.</VALUE>
    <VALUE Lang="GS">Yes? Oh… A year ago, I read some stuff about this, and decided to get trained for it.</VALUE>
    <VALUE Lang="GS">Let me see. All the parts are here…</VALUE>
    <VALUE Lang="GS">Huh, there's a crack here. I just need to hold it in place, use this paste to attach it…</VALUE>
    <VALUE Lang="GS">I'm going to need a crystal powder that you can get in the underground prison. I'll show you how to use that crystal powder to affix the parts.</VALUE>
    <VALUE Lang="id">Bisa kamu perlihatkan?</VALUE>
    <VALUE Lang="id">Ah..ini item itu rupanya.</VALUE>
    <VALUE Lang="id">Apa? Ah…iya, sekitar setahun yang lalu aku pernah menerima data-data ini, saya juga tahu karena sudah pernah menerima sedikit latihan</VALUE>
    <VALUE Lang="id">Sepertinya akan mudah untuk merakitnya karena part-partnya sud</VALUE>
    <VALUE Lang="cn">可以给我看吗?</VALUE>
    <VALUE Lang="cn">啊… 是这个呀.</VALUE>
    <VALUE Lang="cn">什么? 啊… 是,1年前有收到过这些资料,也受到一些教育，所以知道些。</VALUE>
    <VALUE Lang="cn">已经充分搜集了零件，所以很容易组合。但是这部分的平衡是个问题。不是负担太多力量的地方，暂时固定一下就可以，这个需要些智慧，需要独特的沾粘剂。利用监狱附近的矿石粉Crystal powder很快就可以沾上。告诉你方法，你找来粉末吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_25_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_3_0">
    <VALUE Lang="GS">Is that real?!</VALUE>
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="GS">The Nurse told us that it wasn't a common allergy, so treating it wasn't easy. I've heard something at the Police Station about the treatment, but I can't remember what it was.</VALUE>
    <VALUE Lang="id">Yang benar?</VALUE>
    <VALUE Lang="id">Terimakasih! Benar-benar terimakasih!</VALUE>
    <VALUE Lang="id">Sudah saya tanyakan pada Nurse sih…</VALUE>
    <VALUE Lang="id">Karena ini bukan alergi biasa, katanya pembuatan obat-obatannya sangat sulit</VALUE>
    <VALUE Lang="id">Saya juga mendengar sesuatu di kepolisian tetapi karena waktu itu saya sedang b</VALUE>
    <VALUE Lang="cn">是真的吗</VALUE>
    <VALUE Lang="cn">谢谢 真是谢谢</VALUE>
    <VALUE Lang="cn">虽然有问过护士因为不是一般的过敏所以制造治疗剂有点为难</VALUE>
    <VALUE Lang="cn">虽然在警察局有听到一些话不过因为一下恍神所以想不起来</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_4_0">
    <VALUE Lang="GS">I am sorry....</VALUE>
    <VALUE Lang="GS">I can't help you recover the Cassette.</VALUE>
    <VALUE Lang="id">Kalau begitu saya juga tidak bisa membantu memperbaiki tape ini.</VALUE>
    <VALUE Lang="cn">我很抱歉……..我无法帮您复原卡带了…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0">
    <VALUE Lang="GS">You already found the medication!</VALUE>
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="GS">This medicine will help my daughter ... As promised, I will now help you recover the Cassette.</VALUE>
    <VALUE Lang="id">Sudah menemukan obat-obatan rupanya!</VALUE>
    <VALUE Lang="id">Benar-benar terimakasih</VALUE>
    <VALUE Lang="id">Kalau ada obat ini anak saya juga sudah pasti bisa baik-baik sajakan?</VALUE>
    <VALUE Lang="id">Terimakasih.</VALUE>
    <VALUE Lang="id">Sesuai janji saya akan membantu memperbaiki tape itu</VALUE>
    <VALUE Lang="cn">拿到治疗剂了呀</VALUE>
    <VALUE Lang="cn">真是辛苦了</VALUE>
    <VALUE Lang="cn">有这药我女儿肯定​​就会好起来了</VALUE>
    <VALUE Lang="cn">谢谢</VALUE>
    <VALUE Lang="cn">依照约定会复原那个带子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0_1">
    <VALUE Lang="GS">Request Cassette Recovery Again</VALUE>
    <VALUE Lang="id">Meminta perbaikan tape</VALUE>
    <VALUE Lang="cn">再次委托复原卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0_2">
    <VALUE Lang="GS">Request Cassette Recovery Again</VALUE>
    <VALUE Lang="id">Meminta perbaikan tape</VALUE>
    <VALUE Lang="cn">再次委托复原卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0_3">
    <VALUE Lang="GS">Request Cassette Recovery Again</VALUE>
    <VALUE Lang="id">Meminta perbaikan tape</VALUE>
    <VALUE Lang="cn">再次委托复原卡带</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_5_0_4">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_6_0">
    <VALUE Lang="GS">First of all, the nature of our business is Video Rental. We have no available equipment to recover Cassettes.</VALUE>
    <VALUE Lang="GS">I think it'll be difficult to recover the data on this Cassette. We'll need special equipment, but I think the people at the Police Station can help us. Can you help me acquire the necessary equipment to fix this Cassette from the Police Station?</VALUE>
    <VALUE Lang="id">Karena pekerjaan utama kami adalah menyewakan sesuatu, kami tidak punya peralatan yang bisa digunakan untuk memperbaiki tape</VALUE>
    <VALUE Lang="id">Kalau bisa sih saya perbaiki atau mengganti partnya, tapi ini sudah rusak parah sekali jadi nggak bisa.</VALUE>
    <VALUE Lang="id">Pokoknya bisa tidak</VALUE>
    <VALUE Lang="cn">首先因为我们是以出租为本业所以没有复原带子作业的装备</VALUE>
    <VALUE Lang="cn">是可以用手工或是副产品解决不过这情况太严重似乎有点困难</VALUE>
    <VALUE Lang="cn">总之可以帮我去警察局拿装备吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0">
    <VALUE Lang="GS">Ah, thank you!</VALUE>
    <VALUE Lang="GS">Let me try to fix this....</VALUE>
    <VALUE Lang="GS">Just wait for 2 seconds. I'll let you observe my expertise on Video Equipment.</VALUE>
    <VALUE Lang="id">Ah, terimakasih~</VALUE>
    <VALUE Lang="id">Kalau dengan peralatan ini kayaknya bisa cepat selesai</VALUE>
    <VALUE Lang="id">Tunggu dua detik saja, aku akan memperlihatkan keahlian dari seorang profesional</VALUE>
    <VALUE Lang="cn">阿 谢谢</VALUE>
    <VALUE Lang="cn">有这装备就不会花时间了</VALUE>
    <VALUE Lang="cn">只要等两秒 给你看专家的手艺</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0_1">
    <VALUE Lang="GS">Wait</VALUE>
    <VALUE Lang="id">Menunggu</VALUE>
    <VALUE Lang="cn">等待</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0_2">
    <VALUE Lang="GS">Wait</VALUE>
    <VALUE Lang="id">Menunggu</VALUE>
    <VALUE Lang="cn">等待</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0_3">
    <VALUE Lang="GS">Wait</VALUE>
    <VALUE Lang="id">Menunggu</VALUE>
    <VALUE Lang="cn">等待</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_7_0_4">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_8_0">
    <VALUE Lang="GS">Here! It is done!</VALUE>
    <VALUE Lang="GS">Even though we cannot recover the entirety of the video, I think this will help you a lot. The video still has its essential content. I made two copies for you.</VALUE>
    <VALUE Lang="id">Nah, sudah selesai</VALUE>
    <VALUE Lang="id">Saya sudah mengkopinya dua kali walaupun tidak bisa melihat semua isinya</VALUE>
    <VALUE Lang="id">Ini hanya pendapat saya saja</VALUE>
    <VALUE Lang="cn">看 都好了</VALUE>
    <VALUE Lang="cn">虽然内容不是都能看不过已经复制两个了</VALUE>
    <VALUE Lang="cn">这是我的想法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_8_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_9_0">
    <VALUE Lang="GS">About that?</VALUE>
    <VALUE Lang="GS">I heard it before, but I was more worried about my daughter. Sorry, but I couldn't help it.</VALUE>
    <VALUE Lang="id">Euhm…..</VALUE>
    <VALUE Lang="id">Saya sudah dengar sih…</VALUE>
    <VALUE Lang="id">Saya juga tidak bisa memikirkannya karena terlalu khawatir dengan anak saya</VALUE>
    <VALUE Lang="id">Maaf sekali karena saya tidak bisa banyak membantu</VALUE>
    <VALUE Lang="cn">这个嘛</VALUE>
    <VALUE Lang="cn">我有听说不过我也很担心我女儿所以没有想到这么多</VALUE>
    <VALUE Lang="cn">帮不上忙真是抱歉</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_video_1.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_1_0">
    <VALUE Lang="GS">I regent… Ordinariness!</VALUE>
    <VALUE Lang="GS">I pursuit for Greatness, Splendor and Powerfulness which I already possess~ HaHaHaHa~</VALUE>
    <VALUE Lang="GS">Look at me! I, alone stand out in this Market Place. You must desire the same and that is why you came to me, right? Are you ready?</VALUE>
    <VALUE Lang="GS">Let's be the hero of this world together.</VALUE>
    <VALUE Lang="GS">Yes, you! I am talking to you!</VALUE>
    <VALUE Lang="id">Saya ada Penguasa!! Penguasa dari Semua Makhluk!!</VALUE>
    <VALUE Lang="id">Lihatlah saya!! Saya berdiri sendiri di Market Place. Kamu pasti ada maunya kan tiba - tiba muncul di hadapan saya?</VALUE>
    <VALUE Lang="id">Mari menjadi salah satu pahlawan di sini.</VALUE>
    <VALUE Lang="id">Iya kamu!! Saya bicara dengan kamu hey!</VALUE>
    <VALUE Lang="cn">我留守中……太单调了！</VALUE>
    <VALUE Lang="cn">我渴望已久的伟大、辉煌与强盛之梦已实现了！哈哈哈！这三者正掌握在我手中.</VALUE>
    <VALUE Lang="cn">看看我！独自站在 Market Place的正中央. 您的渴望想必与我相同. 这也是您来找我的原因，我说的对吧！准备好了吗？让我们一起成为这个世界的大英雄吧.</VALUE>
    <VALUE Lang="cn">对啦！就是在说您！别怀疑.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_capsule.ntk_1_0_1">
    <VALUE Lang="GS">You are Magnificent!</VALUE>
    <VALUE Lang="id">Kamu sungguh luar biasa!</VALUE>
    <VALUE Lang="cn">您真是太完美了。</VALUE>
  </SENTENSE>
