  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0">
    <VALUE Lang="GS">This Terminal controls the access to the Right Dragon Park.</VALUE>
    <VALUE Lang="id">Ini adalah terminal 'Right Dragon Park'</VALUE>
    <VALUE Lang="id">Sedang mengontrol akses izin keluar masuk ke 'Right Dragon Park'</VALUE>
    <VALUE Lang="cn">此终端机掌控着 Right Dragon Park 的出入机能。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_1">
    <VALUE Lang="GS">Confirm Activation</VALUE>
    <VALUE Lang="id">Konfirmasi pengaktifan</VALUE>
    <VALUE Lang="cn">确认激活</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_2">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_wooryong_1.ntk_1_0_3">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
