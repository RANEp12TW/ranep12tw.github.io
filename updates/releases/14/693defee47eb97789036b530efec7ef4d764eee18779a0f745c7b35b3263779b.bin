  <SENTENSE Ver="1" Id="npc_nin_hd.ntk_1_1">
    <VALUE Lang="GS">Assassin Instructor is at the campus. If you need something then just talk to me.</VALUE>
    <VALUE Lang="id">Assassin Instructor berada di campus. Jika kamu butuh sesuatu, Silahkan hubungi saya.</VALUE>
    <VALUE Lang="cn">Assassin Instructor在学院本馆。你需要帮忙时，也可以问问我。</VALUE>
