  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0">
    <VALUE Lang="GS">Magician defeat enemies using their quick hand motion or some tricks. Which weapon do you want?</VALUE>
    <VALUE Lang="id">Magician mengalahkan musuhnya menggunakan gerakan tangan yang cepat dan berbagai trik. Yang mana yang kamu inginkan?</VALUE>
    <VALUE Lang="cn">魔术师使用轻巧的双手和一些戏法击败他们的敌人. 你想要什么样的武器？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_1">
    <VALUE Lang="GS">Trick Magician "Cube"</VALUE>
    <VALUE Lang="id">Trick Magician "Cube"</VALUE>
    <VALUE Lang="cn">戏法魔术师的“Cube”</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_2">
