  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_28_0_5"><VALUE Lang="tw">兌換 黑豹．剝奪（97級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Black Panther - Extortion (Lv97, Class=12288, Item=362/75)</VALUE><VALUE Lang="id">Skill book: Black Panther - Extortion (Lv97, Class=12288, Item=362/75)</VALUE><VALUE Lang="cn">Skill book: Black Panther - Extortion (Lv97, Class=12288, Item=362/75)</VALUE><VALUE Lang="th">Skill book: Black Panther - Extortion (Lv97, Class=12288, Item=362/75)</VALUE></SENTENSE>
