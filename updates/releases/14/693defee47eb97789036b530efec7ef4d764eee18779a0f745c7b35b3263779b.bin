  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_69">
    <VALUE Lang="GS">Ask what has happened</VALUE>
    <VALUE Lang="id">Tanyakan apa yang telah terjadi</VALUE>
    <VALUE Lang="cn">询问发生了什么事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_7">
    <VALUE Lang="GS">Rescue the Civilian</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">搭救市民</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_8">
    <VALUE Lang="GS">Ask about What Happened</VALUE>
    <VALUE Lang="id">Bertanya ada masalah apa</VALUE>
    <VALUE Lang="cn">询问发生何事了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_1_0_9">
    <VALUE Lang="GS">Ask about What Happened</VALUE>
    <VALUE Lang="id">Bertanya ada masalah apa</VALUE>
    <VALUE Lang="cn">询问发生何事了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_10_0">
    <VALUE Lang="GS">Thank you very much.</VALUE>
    <VALUE Lang="GS">The book that got snatched from me was published by the MinFuLeiSi Special Publishing House, and it's entitled "Programming RPGs for DirectX."</VALUE>
    <VALUE Lang="GS">It was snatched by a fiend called Clown ICE. Please help me!</VALUE>
    <VALUE Lang="id">Benar-benar terimakasih-</VALUE>
    <VALUE Lang="id">Buku yang direbut berjudul 'Programming RPG for DirectX' yang dikeluarkan oleh Penerbit Minplus</VALUE>
    <VALUE Lang="id">Tadi direbut oleh orang-orang yang bernama Freezing clown</VALUE>
    <VALUE Lang="cn">真是多谢,</VALUE>
    <VALUE Lang="cn">我被抢的书是MinFuLeiSi Special 出版社出的，书名是"Programming RPGs for DirectX."。</VALUE>
    <VALUE Lang="cn">刚刚被名叫Clown ICE的人抢走了。请您帮我找回来好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0">
    <VALUE Lang="GS">I really need to have those books in order to overcome this difficult stage in my life. I know other people are asking you for help, but please… I think I need your help more!</VALUE>
    <VALUE Lang="GS">Is that okay with you?</VALUE>
    <VALUE Lang="id">Jangan-jangan kalau kamu lihat saya kini hanya teringat buku saja</VALUE>
    <VALUE Lang="id">Tapi tetap saja…karena buku itu saya butuhkan kesulitan sebesar itu harus dilalui kan</VALUE>
    <VALUE Lang="id">Ditambah lagi ada orang-orang yang bisa dimintai bantuan seperti ini</VALUE>
    <VALUE Lang="id">Bisa tolong bantu saya..</VALUE>
    <VALUE Lang="cn">现在看到我应该只有想到书吧,</VALUE>
    <VALUE Lang="cn">总之要有书,才可度过这类难关,</VALUE>
    <VALUE Lang="cn">再说也有拜托您的人</VALUE>
    <VALUE Lang="cn">可以再帮我一次吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_11_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_12_0">
    <VALUE Lang="GS">So you really want to help me?</VALUE>
    <VALUE Lang="GS">Thank you very much.</VALUE>
    <VALUE Lang="GS">The book that got snatched from me was published by the MinFuLeiSi Special Publishing House, and it's entitled "Tricks for Windows Game Programming."</VALUE>
    <VALUE Lang="GS">It was stolen by a fiend named Golf.</VALUE>
    <VALUE Lang="GS">Please help me.</VALUE>
    <VALUE Lang="id">Ah, bisa tolong seperti itu?</VALUE>
    <VALUE Lang="id">Benar-benar terimakasih-</VALUE>
    <VALUE Lang="id">Buku yang direbut berjudul 'Windows Game Programming Tricks' yang dikeluarkan oleh Penerbit Minplus</VALUE>
    <VALUE Lang="id">Tadi direbut oleh orang-orang yang bernama Golf Player…tolong bantu yah</VALUE>
    <VALUE Lang="cn">现在看到我应该只有想到书吧,</VALUE>
    <VALUE Lang="cn">总之要有书,才可度过这类难关,</VALUE>
    <VALUE Lang="cn">再说也有拜托您的人</VALUE>
    <VALUE Lang="cn">可以再帮我一次吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_13_0">
    <VALUE Lang="GS">You found it!</VALUE>
    <VALUE Lang="GS">I never expected you to help me get back all my books!</VALUE>
    <VALUE Lang="GS">Thanks a lot. You really are a helpful person!</VALUE>
    <VALUE Lang="id">Benar-benar menemukannya rupanya</VALUE>
    <VALUE Lang="id">Walaupun saya yang meminta bantuan tapi saya tidak menyangka kamu akan menemukannya seperti ini</VALUE>
    <VALUE Lang="id">Benar-benar terimakasih.</VALUE>
    <VALUE Lang="cn">真的找回来哩.</VALUE>
    <VALUE Lang="cn">拜托归拜托,不过没想到找回来了,</VALUE>
    <VALUE Lang="cn">真是感谢</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_14_0">
    <VALUE Lang="GS">Wow! Thanks a lot!</VALUE>
    <VALUE Lang="GS">I feel so ashamed. I'd like to express my deep gratitude to you for helping me out this entire time.</VALUE>
    <VALUE Lang="GS">These books will really help me a lot!</VALUE>
    <VALUE Lang="id">Sudah menemukannya rupanya..seperti yang saya kira…</VALUE>
    <VALUE Lang="id">Meskipun dulu kamu sudah membantu tapi saya berpikir mungkin untuk kali ini akan sedikit sulit tapi….</VALUE>
    <VALUE Lang="cn">果然找回来了,</VALUE>
    <VALUE Lang="cn">上次已经帮过我,这次是不是更辛苦,我一直在想</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_15_0">
    <VALUE Lang="GS">......2</VALUE>
    <VALUE Lang="id">......2</VALUE>
    <VALUE Lang="cn">......2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_16_0">
    <VALUE Lang="GS">What are you asking about?</VALUE>
    <VALUE Lang="GS">You need information about programs? Like game programs, right?</VALUE>
    <VALUE Lang="GS">I'll do my best to provide you with all the information you may need!</VALUE>
    <VALUE Lang="id">Kamu tanya apa?</VALUE>
    <VALUE Lang="id">Programmer…Game programmer</VALUE>
    <VALUE Lang="id">Tidak seperti kelihatannya saya sedikit bisa hal-hal kayak gitu</VALUE>
    <VALUE Lang="id">Karena itu saya melakukan sedikit penyelidikan dan persiapan tapi kalau begini…</VALUE>
    <VALUE Lang="cn">你问什么?</VALUE>
    <VALUE Lang="cn">程式?游戏程式?</VALUE>
    <VALUE Lang="cn">我做人们看见的与听见的</VALUE>
    <VALUE Lang="cn">所以也做某程度的调查跟准备</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_16_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_17_0">
    <VALUE Lang="GS">Most of the civilians here have nothing else to do but watch the chaos get worse.</VALUE>
    <VALUE Lang="GS">It's good to see students like you doing your part to fight this pandemonium!</VALUE>
    <VALUE Lang="id">Kalau membuat sesuatu harus bisa dijual tapi, coba lihat sini</VALUE>
    <VALUE Lang="id">Kebanyakan wargakan tidak bisa bekerja sepantasnya?</VALUE>
    <VALUE Lang="cn">做什么都可以贩卖,请看这里,</VALUE>
    <VALUE Lang="cn">大部分市民都处于无法做事的状态嘛.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_17_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_18_0">
    <VALUE Lang="GS">I get the feeling that business will be slow today.</VALUE>
    <VALUE Lang="GS">I'm still keeping my hopes up, though!</VALUE>
    <VALUE Lang="id">Tidak mungkin terjual kalau tidak berhubungan langsung dengan kebutuhan primer</VALUE>
    <VALUE Lang="id">Karena itu sekarang saya sedang…khawatir-</VALUE>
    <VALUE Lang="cn">非意识主和直觉所以不可能卖的理想</VALUE>
    <VALUE Lang="cn">所以 有点​​苦恼</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_18_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_19_0">
    <VALUE Lang="GS">......3</VALUE>
    <VALUE Lang="id">......3</VALUE>
    <VALUE Lang="cn">......3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_2_0">
    <VALUE Lang="GS">It's so frustrating to be just an employee!</VALUE>
    <VALUE Lang="GS">Someday, I want to have my own business. I've got to have the right attitude and outlook. I can do it!</VALUE>
    <VALUE Lang="id">Saya tadinya mau membuka usaha sendiri karena sudah bosan dengan hidup sebagai karyawan perusahaan biasa</VALUE>
    <VALUE Lang="id">Kebetulan ada pekerjaan yang cocok dengan bakat dan kemampuan yang dimiliki</VALUE>
    <VALUE Lang="cn">我厌倦了当个平凡的公司职员,想要开创个人生事业</VALUE>
    <VALUE Lang="cn">刚好个性适合,基本能力也有,所以想这样做</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_2_0_6">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_20_0">
    <VALUE Lang="GS">There are various textbooks on gaming, but only a few of them are actually useful.</VALUE>
    <VALUE Lang="GS">The most useful gaming books are hard to find, which is why I felt so terrible when I lost them!</VALUE>
    <VALUE Lang="id">Memang banyak sih buku tentang game, tapi buku berguna yang dikeluarkan oleh penerbit ahli tidaklah banyak</VALUE>
    <VALUE Lang="id">Ditambah lagi buku yang dibutuhkan itu tidak banyak diterbitkan</VALUE>
    <VALUE Lang="cn">游戏专门书籍是很多,但是从专门出版社出来的好用的不多.</VALUE>
    <VALUE Lang="cn">再说好用的书出版的量不多</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_20_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_21_0">
    <VALUE Lang="GS">Books are limited in supply, so you might not be able to get a book later once its first printing sells out.</VALUE>
    <VALUE Lang="GS">I'm so sad that my precious books were stolen from me!</VALUE>
    <VALUE Lang="id">Kalau tidak membelinya begitu keluar akan sulit untuk mencarinya nanti.</VALUE>
    <VALUE Lang="id">Baru saja saya menemukan buku yang berguna tapi malah dicuri lagi</VALUE>
    <VALUE Lang="cn">一出来不买起来放着的话,以后就买不到了.</VALUE>
    <VALUE Lang="cn">刚刚好不容易买到好用的书,被抢走了.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_21_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_22_0">
    <VALUE Lang="GS">.....5</VALUE>
    <VALUE Lang="id">.....5</VALUE>
    <VALUE Lang="cn">.....5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_23_0">
    <VALUE Lang="GS">There aren't any more textbook supplies in this city. That's why I painstakingly make my own copies of these textbooks.</VALUE>
    <VALUE Lang="GS">Soon, I want to establish my own special course on computer programming.</VALUE>
    <VALUE Lang="id">Sekarang memang tidak ada kelayakan pasar di kota ini tapi sambil bersiap-siap saya jadi benar-benar tertarik…</VALUE>
    <VALUE Lang="id">Tadinya saya mau belajar hanya untuk hobi sambil melakukan persiapan untuk membuka usaha tapi kini mencari buku saja sudah susah</VALUE>
    <VALUE Lang="cn">现在这都市已没有市场性了即使如此准备起来还是满有趣的</VALUE>
    <VALUE Lang="cn">虽想准备课程与另外的趣味生活兼学习但现在买书真的很难</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_23_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_24_0">
    <VALUE Lang="GS">......13</VALUE>
    <VALUE Lang="id">......13</VALUE>
    <VALUE Lang="cn">......13</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_25_0">
    <VALUE Lang="GS">I picked this thing up while I was walking around the area. I wonder if you can put this to good use.</VALUE>
    <VALUE Lang="GS">Here! Please accept it!</VALUE>
    <VALUE Lang="id">Ah, saya pungut ini di daerah sekitar sini</VALUE>
    <VALUE Lang="id">Saya tidak tahu apakah ini bisa menjadi hadiah tapi bisa tolong diterima?</VALUE>
    <VALUE Lang="cn">阿,这是附近捡到的,</VALUE>
    <VALUE Lang="cn">不知可否做为谢礼,请收下吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_25_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_26_0">
    <VALUE Lang="GS">....14</VALUE>
    <VALUE Lang="id">....14</VALUE>
    <VALUE Lang="cn">....14</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_27_0">
    <VALUE Lang="GS">I picked this thing up while I was walking around the area. I wonder if you can put this to good use.</VALUE>
    <VALUE Lang="GS">Here! Please accept it!</VALUE>
    <VALUE Lang="id">Ah, saya pungut ini di daerah sekitar sini</VALUE>
    <VALUE Lang="id">Saya tidak tahu apakah ini bisa menjadi hadiah tapi bisa tolong diterima?</VALUE>
    <VALUE Lang="cn">阿,这是附近捡到的,</VALUE>
    <VALUE Lang="cn">不知可否做为谢礼,请收下吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_27_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_28_0">
    <VALUE Lang="GS">Ah, I really appreciate it.</VALUE>
    <VALUE Lang="GS">It's actually a valuable collectible.</VALUE>
    <VALUE Lang="GS">I was so upset because I had such a hard time finding it.</VALUE>
    <VALUE Lang="GS">If you ever tried to collect something, you might understand how I feel...</VALUE>
    <VALUE Lang="GS">Anyway, thank you very much.</VALUE>
    <VALUE Lang="id">Ah, ini benar-benar terimakasih…</VALUE>
    <VALUE Lang="id">Sejujurnya ini hanya ambisi saya pribadi untuk mengumpulkan</VALUE>
    <VALUE Lang="id">Saya sudah mengumpulkannya dengan susah payah tiba-tiba direbut oleh mereka, saya jadi merasa benar-benar kesal</VALUE>
    <VALUE Lang="id">Padahal kalau seorang kolektor pasti men</VALUE>
    <VALUE Lang="cn">啊，这个非常感谢…</VALUE>
    <VALUE Lang="cn">说实话这个是我个人搜集欲望而已…</VALUE>
    <VALUE Lang="cn">好不容易才收集的东西突然被抢走后非常难过…</VALUE>
    <VALUE Lang="cn">如果是搜集家就可以理解我当时的心情…</VALUE>
    <VALUE Lang="cn">不管怎样，非常感谢</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_28_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_29_0">
    <VALUE Lang="GS">Ah. The action guide of emergency?</VALUE>
    <VALUE Lang="GS">Yes, I have.</VALUE>
    <VALUE Lang="GS">Haha, I can't believe my collection is actually helpful!</VALUE>
    <VALUE Lang="id">Ah, maksudnya tindakan yang harus dilakukan pada keadaan darurat?</VALUE>
    <VALUE Lang="id">Iya, saya mempunyainya</VALUE>
    <VALUE Lang="id">Haha, yang saya kumpulkan juga bisa membantu rupanya!</VALUE>
    <VALUE Lang="cn">啊，你说的是紧急状况时的行动指南针吗?</VALUE>
    <VALUE Lang="cn">是的,当然带着。</VALUE>
    <VALUE Lang="cn">哈哈,我搜集的东西可以派上用场了!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_29_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_3_0">
    <VALUE Lang="GS">Furthering my knowledge in order to have a great career head start is an important goal for me right now.</VALUE>
    <VALUE Lang="GS">Would you be willing to help me?</VALUE>
    <VALUE Lang="id">Pasti susah untuk mencarinya kembali meskipun sudah menempelkan premium</VALUE>
    <VALUE Lang="id">Bisa bantu saya?</VALUE>
    <VALUE Lang="cn">拥有一个伟大的职业是我现在的目标。</VALUE>
    <VALUE Lang="cn">可以帮我一下吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_citizen1.ntk_3_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
