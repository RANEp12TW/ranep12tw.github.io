  <SENTENSE Ver="1" Id="npc_cs_storage.ntk_1_0">
    <VALUE Lang="GS">Gold Storage's security is normal.</VALUE>
    <VALUE Lang="GS">All connections to the different Lockers are also normal.</VALUE>
    <VALUE Lang="id">Sistem keamanan pada lemari besi beroperasi dengan normal.</VALUE>
    <VALUE Lang="id">Hubungan dengan locker dalam keadaan normal</VALUE>
    <VALUE Lang="cn">金库的保安系统一切正常。和其他置物箱的连接状态也非常安全。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cube01.ntk_1_0">
    <VALUE Lang="GS">Hello</VALUE>
    <VALUE Lang="GS">Welcome to Cubelaps</VALUE>
    <VALUE Lang="id">Hello!!</VALUE>
    <VALUE Lang="id">Selamat datang di Cube laps~</VALUE>
    <VALUE Lang="cn">哈喽！</VALUE>
    <VALUE Lang="cn">欢迎来到 Cubelaps。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_cube01.ntk_1_0_1">
    <VALUE Lang="GS">Open Shop</VALUE>
    <VALUE Lang="id">Jual Beli item</VALUE>
    <VALUE Lang="cn">开启商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_1_0">
    <VALUE Lang="GS">Control Room Office Access Permission Terminal</VALUE>
    <VALUE Lang="GS">Operations: Normal</VALUE>
    <VALUE Lang="id">Terminal untuk mengontrol akses keluar masuk Kantor administrasi</VALUE>
    <VALUE Lang="id">Sedang beroperasi dengan lancar</VALUE>
    <VALUE Lang="cn">控管办公室出入口的认证终端机：正常运作中！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_danmal1.ntk_1_0_1">
    <VALUE Lang="GS">Execute Authentication</VALUE>
    <VALUE Lang="id">Menjalankan program authentication</VALUE>
    <VALUE Lang="cn">认证执行</VALUE>
  </SENTENSE>
