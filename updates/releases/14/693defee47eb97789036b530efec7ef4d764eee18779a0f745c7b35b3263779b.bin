  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_harvestmooneven_01.ntk_1_0">
    <VALUE Lang="GS">HELP!!! Some Monsters took my crescent moon pieces!!</VALUE>
    <VALUE Lang="GS">Can you please go and find the said pieces and return it back to me!!</VALUE>
    <VALUE Lang="GS">250 Crescent Moon Pieces = Crescent Moon Random Box 1</VALUE>
    <VALUE Lang="GS">300 Crescent Moon Pieces = Choose one of Crescent Moon Random Box 2 or 3</VALUE>
    <VALUE Lang="GS">400 Crescent Moon Pieces = Crescent Moon Random Box 4</VALUE>
    <VALUE Lang="GS">Please go find and get the pieces back for me!</VALUE>
    <VALUE Lang="cn">救命！怪物们抢走了我的新月碎片！</VALUE>
    <VALUE Lang="cn">您可以帮我找回来吗？</VALUE>
    <VALUE Lang="cn">250 Crescent Moon Pieces = Crescent Moon Random Box 1</VALUE>
    <VALUE Lang="cn">300 Crescent Moon Pieces = Choose one of Crescent Moon Random Box 2 or 3</VALUE>
    <VALUE Lang="cn">400 Crescent Moon Pieces = Crescent Moon Random Box 4</VALUE>
    <VALUE Lang="cn">一定要帮我找回来唷！</VALUE>
    <VALUE Lang="id">TOLONG!!! Monster membawa kabur crescent moon saya!!</VALUE>
    <VALUE Lang="id">Tolong bantu saya dapatkan kembali!!</VALUE>
    <VALUE Lang="id">250 Crescent Moon = Crescent Moon Random Box 1</VALUE>
    <VALUE Lang="id">300 Crescent Moon = Choose one of Crescent Moon Random Box 2 atau 3</VALUE>
    <VALUE Lang="id">400 Crescent Moon = Crescent Moon Random Box 4</VALUE>
    <VALUE Lang="id">Mohon dibantu segera!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_harvestmooneven_01.ntk_1_0_1">
    <VALUE Lang="GS">Exchange 250 Crescent Moon Pieces to Crescent Moon Random Box 1.</VALUE>
    <VALUE Lang="cn">将250个Crescent Moon Pieces 兑换成 Crescent Moon Random Box 1.</VALUE>
    <VALUE Lang="id">Tukar 250 Crescent Moon dengan Crescent Moon Random Box 1.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_harvestmooneven_01.ntk_1_0_2">
    <VALUE Lang="GS">Exchange 300 Crescent Moon Pieces to Crescent Moon Random Box 2.</VALUE>
    <VALUE Lang="cn">将300个Crescent Moon Pieces兑换成 Crescent Moon Random Box 2.</VALUE>
    <VALUE Lang="id">Tukar 300 Crescent Moon dengan Crescent Moon Random Box 2.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_harvestmooneven_01.ntk_1_0_3">
    <VALUE Lang="GS">Exchange 300 Crescent Moon Pieces to Crescent Moon Random Box 3.</VALUE>
    <VALUE Lang="cn">将300个Crescent Moon Pieces 兑换成 Crescent Moon Random Box 3.</VALUE>
    <VALUE Lang="id">Tukar 300 Crescent Moon dengan Crescent Moon Random Box 3.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_harvestmooneven_01.ntk_1_0_4">
    <VALUE Lang="GS">Exchange 400 Crescent Moon Pieces to Crescent Moon Random Box 4.</VALUE>
    <VALUE Lang="cn">将400个Crescent Moon Pieces 兑换成 Crescent Moon Random Box 4.</VALUE>
    <VALUE Lang="id">Tukar 400 Crescent Moon dengan Crescent Moon Random Box 4.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_harvestmoonevent_02.ntk_1_0">
    <VALUE Lang="GS">Only The Full Moon Piece Makes my Full Moons Stays with me!</VALUE>
    <VALUE Lang="GS">Can you bring me the full moon pieces</VALUE>
    <VALUE Lang="GS">400 Full Moon Pieces = Full Moon Random Box</VALUE>
    <VALUE Lang="cn">只有满月碎片能使我更完整美好。</VALUE>
    <VALUE Lang="cn">您可以把Full moon pieces拿给我吗？</VALUE>
    <VALUE Lang="cn">400 Full Moon Pieces = Full Moon Random Box</VALUE>
    <VALUE Lang="id">Hanya Full Moon Piece yang dapat membuat Full Moon tetap dengan saya!</VALUE>
    <VALUE Lang="id">Bisakah kamu membawakan saya Full Moon Piece?</VALUE>
    <VALUE Lang="id">400 Full Moon Pieces = Full Moon Random Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_harvestmoonevent_02.ntk_1_0_1">
    <VALUE Lang="GS">Exchange 400 Full Moon Pieces to Full Moon Random Box.</VALUE>
    <VALUE Lang="cn">将400个Full Moon Pieces兑换成Full Moon Random Box.</VALUE>
    <VALUE Lang="id">Tukar 400 Full Moon Pieces to Full Moon Random Box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_harvestmoonevent_02.ntk_1_0_2">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="cn">交易</VALUE>
    <VALUE Lang="id">Tukar</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_magicevent.ntk_1_0">
    <VALUE Lang="GS">Any question about Magician? For your information, Magician class is the new class...Our skills are strong and mystical!!I am not lying about this!!</VALUE>
    <VALUE Lang="GS">I want to show it but I cannot because I lost my stick a while ago. Please try to find it for me and I will give a reward in return...</VALUE>
    <VALUE Lang="GS">------------------------------------------------------</VALUE>
    <VALUE Lang="GS">Magician Stick Piece 50 = Luxury Magician Random Box</VALUE>
    <VALUE Lang="GS">Magician Card 30 = Low Magician Random Box</VALUE>
    <VALUE Lang="id">Ada pertanyaan tentang Magician? Sebagai informasi, Magician adalah kelas baru kami.. Skill kami kuat dan penuh sihir!!! Saya tidak berbohong tentang ini!!</VALUE>
    <VALUE Lang="id">Saya ingin menunjukkannya tapi tidak bisa karena saya telah kehilangan tongkat saya beberapa waktu</VALUE>
    <VALUE Lang="cn">对魔术师有疑问? 我只能告诉你, 魔术师是一个全新的职业, 我们的技能既强大又神秘!!! 关于这点我没有骗你!!! 我很想展示给你看, 可是我不能. 因为我刚才把我的魔术棒给弄丢了. 请帮我找找它. 如果把它找回来, 我会给你奖励最为回报------------------------------------------------------------</VALUE>
    <VALUE Lang="cn">Magician Stick Piece 50 = Luxury Magician Random Box</VALUE>
    <VALUE Lang="cn">Magician Card 30 = Low</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_magicevent.ntk_1_0_1">
    <VALUE Lang="GS">Receive Luxury Magician Random Box</VALUE>
    <VALUE Lang="id">Terima Luxury Magician Random Box</VALUE>
    <VALUE Lang="cn">获得 Luxury Magician Random Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_magicevent.ntk_1_0_2">
    <VALUE Lang="GS">Receive Low Magician Random Box</VALUE>
    <VALUE Lang="id">Terima Low Magician Random Box</VALUE>
    <VALUE Lang="cn">获得 Low Magician Random Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_newyear.ntk_1_0">
    <VALUE Lang="GS">Wow! It's already 2014, Happy Lunar New Year! I've prepared some special items,Check magic pouch of luck on my item list!</VALUE>
    <VALUE Lang="id">Wow~! Akhirnya 2014 sudah tiba~ Selamat Tahun Baru untuk semuanya! Item Khusus telah dipersiapkan di dalam Angpao keberuntungan ini!</VALUE>
    <VALUE Lang="cn">哇！已经2014年了。新年快乐！我已经准备了一些奇特物品，请来看看我的物品列表，有许多魔幻般的好运唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_newyear.ntk_1_0_1">
    <VALUE Lang="GS">trade</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">进行交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_1_0">
    <VALUE Lang="GS">I have already prepared the gifts for the kids, but I cannot go because the evil Stray Sheep</VALUE>
    <VALUE Lang="GS">took away the parts of my Rudolf Bike. Can you get those parts back from the evil Stray Sheep?</VALUE>
    <VALUE Lang="GS">I will give you a nice present in return.</VALUE>
    <VALUE Lang="GS">[Catching the Evil Stray Sheep Event Time]</VALUE>
    <VALUE Lang="GS">1st Event Schedule: 16:00 ~ 16:45</VALUE>
    <VALUE Lang="GS">2nd Event Schedule : 22:00 ~ 22:45</VALUE>
    <VALUE Lang="id">Saya sudah menyiapkan hadiah untuk anak-anak, tetapi saya tidak bisa pergi karena para Evil Stray Sheep mengambil bagian dari Rudolf Bike saya. Dapatkah kamu mengambil kembali bagian-bagian tersebut dari Evil Stray Sheep? Saya akan memberikan hadiah yang</VALUE>
    <VALUE Lang="cn">我已经准备好了给孩子们的礼物.但是我去不了了.因为邪恶的Stray Sheep把我Rudolf Bike的部件给拿走了.你能从邪恶的Stray Sheep那里把我的部件给找回来吗？作为回报我会给你精致的礼物.</VALUE>
    <VALUE Lang="cn">[捕获 Evil Stray Sheep 的活动时间]</VALUE>
    <VALUE Lang="cn">活动时间 1: 16:00 ~ 16:45</VALUE>
    <VALUE Lang="cn">活动时间 2 : 22:00 ~ 22:45</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_1_0_1">
    <VALUE Lang="GS">Trade Item</VALUE>
    <VALUE Lang="id">Tukar Item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_1_0_2">
    <VALUE Lang="GS">Exchange the parts.</VALUE>
    <VALUE Lang="id">Tukar Bagian-bagian</VALUE>
    <VALUE Lang="cn">交换部件.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_2_0">
    <VALUE Lang="GS">Oh you found them! Now, choose whatever you want in return!</VALUE>
    <VALUE Lang="GS">----------------------------------------------------------------------------------------------------</VALUE>
    <VALUE Lang="GS">1. Volt 50 + Knot 50 + Gear 50</VALUE>
    <VALUE Lang="GS">=&gt; Choose one among Rudolf Bike (permanent), Santa Bike (permanent), Santa Board (Permanent)</VALUE>
    <VALUE Lang="GS">2. Volt 50 + Knot 50 + Gear 50 + SSS (Super-Strong-Student) Certificate 5</VALUE>
    <VALUE Lang="GS">=&gt; Rickshaw (permanent)</VALUE>
    <VALUE Lang="id">"Oh, kamu telah menemukannya! Sekarang, pilihlah apapun yang kamu inginkan sebagai imbalannya!</VALUE>
    <VALUE Lang="id">----------------------------------------------------------------------------------------------------</VALUE>
    <VALUE Lang="id">1. Volt 50 + Knot 50 + Gear 50</VALUE>
    <VALUE Lang="id">=&gt; Pilih salah satu dari</VALUE>
    <VALUE Lang="cn">很好, 你找到他们了. 作为回报选择一件你想要的奖励. !</VALUE>
    <VALUE Lang="cn">------------------------------------------------</VALUE>
    <VALUE Lang="cn">1. Volt 50 + Knot 50 + Gear 50</VALUE>
    <VALUE Lang="cn">=&gt;从Rudolf Bike (permanent), Santa Bike (permanent), Santa Board (Permanent)中选择一样.</VALUE>
    <VALUE Lang="cn">2. Volt 50 + Knot 50 + Gear 50 + SSS (Super-Strong-Student) C</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_2_0_1">
    <VALUE Lang="GS">Trade for Rudolf Bike.</VALUE>
    <VALUE Lang="id">Tukar dengan Rudolf Bike</VALUE>
    <VALUE Lang="cn">换取Rudolf Bike.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_2_0_2">
    <VALUE Lang="GS">Trade for Santa Bike.</VALUE>
    <VALUE Lang="id">Tukar dengan Santa Bike</VALUE>
    <VALUE Lang="cn">换取Santa Bike.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_2_0_3">
    <VALUE Lang="GS">Trade for Sanda Board.</VALUE>
    <VALUE Lang="id">Tukar dengan Santa Board</VALUE>
    <VALUE Lang="cn">换取Santa Board.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santa.ntk_2_0_4">
    <VALUE Lang="GS">Trade for Rickshaw</VALUE>
    <VALUE Lang="id">Tukar dengan Rickshaw</VALUE>
    <VALUE Lang="cn">换取RickShaw.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santagirl.ntk_1_0">
    <VALUE Lang="GS">Santa asked me to give you a special present if you bring 25 Merry Red Socks.</VALUE>
    <VALUE Lang="GS">Go find the Merry Red Sock at the Web Item Shop!</VALUE>
    <VALUE Lang="GS">And don't forget to buy one every single day!</VALUE>
    <VALUE Lang="GS">1. Merry Red Sock 1 =&gt; Reform Card (2P) Box</VALUE>
    <VALUE Lang="GS">2. Merry Red Sock 5 =&gt; Mini Christmas Gift Box</VALUE>
    <VALUE Lang="GS">3. Merry Red Sock 25 =&gt; Christmas Box</VALUE>
    <VALUE Lang="id">Santa meminta saya untuk memberikanmu hadiah spesial jika kamu membawa 25 Merry Red Socks</VALUE>
    <VALUE Lang="id">Pergi dan carilah Merry Red Sock di Web Item Shop!</VALUE>
    <VALUE Lang="id">Dan jangan lupa untuk membeli satu setiap harinya!</VALUE>
    <VALUE Lang="id">1. Merry Red Sock 1 =&gt; Reform Card (2P) Box</VALUE>
    <VALUE Lang="id">2. Merry Red S</VALUE>
    <VALUE Lang="cn">如果你带来25个Merry Red Socks, 圣诞老人让我给你特别的礼物,.</VALUE>
    <VALUE Lang="cn">在Web Item Shop寻找Merry Red Sock!</VALUE>
    <VALUE Lang="cn">而且不要忘记每天都要买一个!</VALUE>
    <VALUE Lang="cn">1. Merry Red Sock 1 =&gt; Reform Card (2P) Box</VALUE>
    <VALUE Lang="cn">2. Merry Red Sock 5 =&gt; Mini Christmas Gift Box</VALUE>
    <VALUE Lang="cn">3. Merry Red Sock 25 =&gt; Christmas Box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santagirl.ntk_1_0_1">
    <VALUE Lang="GS">Exchange 1 Merry Red Socks to Reform Card (2P) Box.</VALUE>
    <VALUE Lang="id">Tukarkan 1 Merry Red Socks dengan Reform Card (2P) Box</VALUE>
    <VALUE Lang="cn">将1个Merry Red Socks交换成Reform Card (2P) Box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santagirl.ntk_1_0_2">
    <VALUE Lang="GS">Exchange 5 Merry Red Socks to Mini Christmas Gift Box.</VALUE>
    <VALUE Lang="id">Tukarkan 5 Merry Red Socks dengan Mini Christmas Gift Box</VALUE>
    <VALUE Lang="cn">将5个Merry Red Socks交换成Mini Christmas Gift Box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_santagirl.ntk_1_0_3">
    <VALUE Lang="GS">Exchange 25 Merry Red Socks to Christmas Box.</VALUE>
    <VALUE Lang="id">Tukarkan 25 Merry Red Socks dengan Christmas Gift Box</VALUE>
    <VALUE Lang="cn">将25个Merry Red Socks交换成Christmas Box.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent01.ntk_1_0">
    <VALUE Lang="GS">Our Swordsman class is the strongest one. However there are so many new class has been appeared lately.</VALUE>
    <VALUE Lang="GS">That makes our class became weak and weaker. But!! Do not disappointed because I want to let you know that our class is got stronger again ^__^</VALUE>
    <VALUE Lang="cn">剑道部是最强的！但是比他新出的职业太多了！所以搞得我们好像很弱~ 不过请别失望，我们会让您看到跟以前不一样的剑道部！^__^</VALUE>
    <VALUE Lang="id">Kelas Swordsman adalah kelas terkuat tapi banyak kelas baru yang bermunculan akhir - akhir ini.</VALUE>
    <VALUE Lang="id">Itu membuat kelas kami menjadi makin lemah saja. TAPI! Jangan kecewa karena saya ingin memberitahukan bahwa kelas kita sudah kembali menjadi kuat lagi ^__^</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent01.ntk_1_0_1">
    <VALUE Lang="GS">I am Ready</VALUE>
    <VALUE Lang="cn">我准备好了！</VALUE>
    <VALUE Lang="id">Saya Siap</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent01.ntk_1_0_2">
    <VALUE Lang="GS">Receive Oblivion Potion E</VALUE>
    <VALUE Lang="cn">领取Oblivion Potion E</VALUE>
    <VALUE Lang="id">Menerima Oblivion Potion E</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent01.ntk_2_0">
    <VALUE Lang="GS">Let me know when you are ready!</VALUE>
    <VALUE Lang="cn">当您准备好就告诉我！</VALUE>
    <VALUE Lang="id">Beritahu saya ketika kamu siap!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent01.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent01.ntk_3_0">
    <VALUE Lang="GS">Let others know that our class got stronger again!</VALUE>
    <VALUE Lang="cn">让大家知道我们现在的实力再度变强了！</VALUE>
    <VALUE Lang="id">Beritahu yang lain kalau kelas kita sudah kembali kuat lagi!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent01.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent02.ntk_1_0">
    <VALUE Lang="GS">Actually we are looking for the Hidden Information inside of the 3 Dungeons there but we cannot enter it for some reasons. Because of that, we would like to request some help from you!</VALUE>
    <VALUE Lang="cn">其实我们正在寻找3个副本的相关秘密资料，但基于某些因素我们无法直接进去。 这也是为什么我们需要您的帮忙。</VALUE>
    <VALUE Lang="id">Sebenarnya kami sedang mencari informasi tersembunyi di 3 dungeon di sana. Akan tetapi, kami tidak dapat masuk karena suatu alasan. Oleh karena itu, kami mohon bantulah kami!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent02.ntk_1_0_1">
    <VALUE Lang="GS">Investigate Forbidden Tower</VALUE>
    <VALUE Lang="cn">调查 Forbidden Tower</VALUE>
    <VALUE Lang="id">Investigasi Forbidden Tower</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent02.ntk_1_0_3">
    <VALUE Lang="GS">Investigate Outer Wall</VALUE>
    <VALUE Lang="cn">调查 Outer Wall</VALUE>
    <VALUE Lang="id">Investigasi Outer Wall</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent02.ntk_1_0_5">
    <VALUE Lang="GS">Investigate Abandoned Desert</VALUE>
    <VALUE Lang="cn">调查 Abandoned Desert</VALUE>
    <VALUE Lang="id">Investigasi Abandoned Desert</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2014_swordevent02.ntk_2_0">
    <VALUE Lang="GS">Let me know the information that you have receive from Forbidden Tower.</VALUE>
    <VALUE Lang="cn">请告诉我您从Forbidden Tower打听到的事情。</VALUE>
    <VALUE Lang="id">Beritahu kami informasi yang kamu dapatkan dari Forbidden Tower.</VALUE>
