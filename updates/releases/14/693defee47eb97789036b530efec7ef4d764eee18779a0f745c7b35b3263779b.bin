  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_4_0">
    <VALUE Lang="GS">The.. tea.. teachers.. are ca.. call calling.. me .. no.. now..</VALUE>
    <VALUE Lang="id">se.. sekarang.. pa.. Para guru.. me.. Memanggil kita…</VALUE>
    <VALUE Lang="cn">老…师在…呼叫我…...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_4_0_1">
    <VALUE Lang="GS">Back</VALUE>
