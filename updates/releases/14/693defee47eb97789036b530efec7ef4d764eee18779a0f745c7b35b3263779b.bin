  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_7_0">
    <VALUE Lang="GS">신입생처럼 굴기는...</VALUE>
    <VALUE Lang="GS">곧장 나가면 현관이 있지?</VALUE>
    <VALUE Lang="id">신입생처럼 굴기는...</VALUE>
    <VALUE Lang="id">곧장 나가면 현관이 있지?</VALUE>
    <VALUE Lang="cn">신입생처럼 굴기는...</VALUE>
    <VALUE Lang="cn">곧장 나가면 현관이 있지?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_7_0_1">
    <VALUE Lang="GS">짾??</VALUE>
    <VALUE Lang="id">짾??</VALUE>
    <VALUE Lang="cn">짾??</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0">
    <VALUE Lang="GS">What do you want to know?</VALUE>
    <VALUE Lang="id">Apa yang ingin kamu ketahui?</VALUE>
    <VALUE Lang="cn">您想问什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_1">
    <VALUE Lang="GS">Ask about the Archery Section</VALUE>
    <VALUE Lang="id">Bertanya tentang Archery</VALUE>
    <VALUE Lang="cn">询问关于弓箭部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_2">
    <VALUE Lang="GS">Ask about Training Methods</VALUE>
    <VALUE Lang="id">Bertanya tentang cara mengerjakan tugas</VALUE>
    <VALUE Lang="cn">询问修炼方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_3">
    <VALUE Lang="GS">Ask about Combat Methods</VALUE>
    <VALUE Lang="id">Bertanya tentang cara bertarung</VALUE>
    <VALUE Lang="cn">询问战斗方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_4">
    <VALUE Lang="GS">Ask about Skill Points</VALUE>
    <VALUE Lang="id">Bertanya tentang Skill Point</VALUE>
    <VALUE Lang="cn">询问技能点数</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_8_0_5">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_9_0">
    <VALUE Lang="GS">There's no turning back now.</VALUE>
    <VALUE Lang="GS">Please be aware of this.</VALUE>
    <VALUE Lang="id">Sampai saat ini tidak ada masalah dengan tugas…</VALUE>
    <VALUE Lang="id">tapi kalian tetap tidak boleh lengah dan berdiam saja!</VALUE>
    <VALUE Lang="cn">这儿没有回头路。</VALUE>
    <VALUE Lang="cn">但千万不能大意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_archer1.ntk_9_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0">
    <VALUE Lang="GS">Oh! It's great to see a normal human after all this time!</VALUE>
    <VALUE Lang="id">Senang bisa bertemu dengan sesama manusia</VALUE>
    <VALUE Lang="cn">噢！可以见到正常人真是开心！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_2">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_3">
    <VALUE Lang="GS">Request for Bus Spare Parts</VALUE>
    <VALUE Lang="id">Meminta genuine part Bus</VALUE>
    <VALUE Lang="cn">申请公车零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_4">
    <VALUE Lang="GS">Request for Generator Spare Parts</VALUE>
    <VALUE Lang="id">Meminta Generator Part</VALUE>
    <VALUE Lang="cn">申请发电机零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_5">
    <VALUE Lang="GS">Collect Unverified Currency Notes</VALUE>
    <VALUE Lang="id">Penarikan kembali Unconfimred Currency</VALUE>
    <VALUE Lang="cn">收集未验证纸币</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_6">
    <VALUE Lang="GS">Technical Teacher's Test</VALUE>
    <VALUE Lang="id">Pelaksanaan ujian</VALUE>
    <VALUE Lang="cn">Technical Teacher的测验</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_7">
    <VALUE Lang="GS">Confirm Test Results</VALUE>
    <VALUE Lang="id">Konfirmasi hasil ujian</VALUE>
    <VALUE Lang="cn">确认测验结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_8">
    <VALUE Lang="GS">Give the Order Document</VALUE>
    <VALUE Lang="id">Menyerahkan Orders Book</VALUE>
    <VALUE Lang="cn">传达指令书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_1_0_9">
    <VALUE Lang="GS">Ask about the Taxi</VALUE>
    <VALUE Lang="id">Bertanya tentang taksi</VALUE>
    <VALUE Lang="cn">询问关于计程车的事件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_10_0">
    <VALUE Lang="GS">That money is really strange, and it's good we discovered it before the problem got any worse. Just carry on with delivering the Order Document.</VALUE>
    <VALUE Lang="GS">That'll help out a lot!</VALUE>
    <VALUE Lang="id">Benar? Itu Currency yang bermasalah waktu itu kan?</VALUE>
    <VALUE Lang="id">Untung lah, sudah terdeteksi sebelum terjadi masalah yang lebih besar lagi</VALUE>
    <VALUE Lang="id">Terus tolong kirimkan Orders Book ini</VALUE>
    <VALUE Lang="cn">那纸币真的有点怪异。可以在发生问题之前，发现这些危险因子，真是好家在。请传达这份Order Document。谢谢您的帮忙。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_11_0">
    <VALUE Lang="GS">Oh, so you already reached level to qualify for this exam?</VALUE>
    <VALUE Lang="GS">You learn faster than I thought!</VALUE>
    <VALUE Lang="id">Sudah bisa untuk mengikuti ujian?</VALUE>
    <VALUE Lang="id">Kamu terlihat lebih cepat belajarnya!</VALUE>
    <VALUE Lang="cn">已经到了可以测验的程度了吗？比我预期的还要快呢！很好。那么~请让我再跟您说一次本测验的目的。这跟平常您们上格斗课的目标是不一样的，因为对手并不是人类。希望您可以了解这种能力考试的举办意义。您的敌人攻击水平不低，请您一定要持续认真学习。了解了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_11_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_12_0">
    <VALUE Lang="GS">Good, you pass the exam by achieving your level. It's a little less than what I expected, but...</VALUE>
    <VALUE Lang="GS">You'll need to practice more so that you'll be ready for any kind of attack from these fellahs.</VALUE>
    <VALUE Lang="id">Bagus, segini juga cukup..</VALUE>
    <VALUE Lang="id">Namun aku pikir ini masih kurang~ kedepannya berlatihlah lagi ya</VALUE>
    <VALUE Lang="id">Kamu mungkin tahu apa yang kamu pelajari di kelas, namun sampai kapan monster dua tangan dua kaki tersebut akan menjadi musuh kalian..</VALUE>
    <VALUE Lang="cn">很好！您已通过测验，顺利升级了。虽然比我预期的还要不足，我想您需要更多的练习，将才能随时随地地，从容地应付那些Fellahs的攻击。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_13_0">
    <VALUE Lang="GS">....7</VALUE>
    <VALUE Lang="id">....7</VALUE>
    <VALUE Lang="cn">....7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_14_0">
    <VALUE Lang="GS">Ah, are you looking for spare parts to fix the bus?</VALUE>
    <VALUE Lang="GS">Several people came to collect those same spare parts. They keep coming back because the buses keep getting involved in accidents. I'm just glad we're able to help out by having spare parts available.</VALUE>
    <VALUE Lang="GS">Although we've prepared all the necessary equipment for these kinds of situations, we starting to run out of spare parts.</VALUE>
    <VALUE Lang="id">Tolong ya ambilkan sekarang..</VALUE>
    <VALUE Lang="id">karena walaupun aku sudah melakukan persiapan dengan mengumpulkan banyak item, namun ternyata genuine part tersebut tidak banyak yang tersisa</VALUE>
    <VALUE Lang="cn">噢！您在寻找可以修复公车的零件，对吗？最近有几个人收走了那些零件，但因为出了车祸，又跑来找我了。 我很高兴可以提供重要的零件给大家。 虽然我们都有在准备，可是，渐渐地，零件的数量真的越来越少了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_14_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_15_0">
    <VALUE Lang="GS">....8</VALUE>
    <VALUE Lang="id">....8</VALUE>
    <VALUE Lang="cn">....8</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_16_0">
    <VALUE Lang="GS">You can get the spare parts you need from the supervisors of the Construction Site located at the 4th Hole.</VALUE>
    <VALUE Lang="GS">You'll have to prove yourself to them first. They might give you a bit of a rough time!</VALUE>
    <VALUE Lang="id">Mungkin para Construction Manager yang ada di sana mempunyai item itu</VALUE>
    <VALUE Lang="id">Orang-orang itu sudah tidak normal, mungin kamu harus sedikit bertindak</VALUE>
    <VALUE Lang="cn">您可以从位在4th Hole的Construction Site的 Supervisors那儿，得到您需要的零件。首先，您得靠自己的力量，去解决他们唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_16_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
