    <VALUE Lang="GS">Ask about dispatched Extra Activity Teacher</VALUE>
    <VALUE Lang="id">Bertanya tentang Guru ekstrakulikuler (Agen)</VALUE>
    <VALUE Lang="cn">询问dispatched Extra Activity Teacher</VALUE>
  </SENTENSE>
