    <VALUE Lang="id">Menyerahkan Daggers</VALUE>
    <VALUE Lang="cn">传达 Knives</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_1_0_9">
    <VALUE Lang="GS">Get the Documents</VALUE>
