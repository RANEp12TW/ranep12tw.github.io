  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_7_0">
    <VALUE Lang="GS">Oh, a new student?</VALUE>
    <VALUE Lang="id">Jangan bertingkah kayak anak baru….</VALUE>
    <VALUE Lang="id">Saya akan mengajarkanmu, jadi dengarkan baik-baik.</VALUE>
    <VALUE Lang="cn">噢！是新生。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_7_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_8_0">
    <VALUE Lang="GS">You still haven't finished the Student Registration?</VALUE>
    <VALUE Lang="GS">Please go to the Student Director at the School Administration Office to complete your registration.</VALUE>
    <VALUE Lang="id">Emm!</VALUE>
    <VALUE Lang="id">Ngga mungkin pelajar baru…</VALUE>
    <VALUE Lang="id">Kayanya kamu belum terdaftar ya?</VALUE>
    <VALUE Lang="id">alau kamu bawa Student Registration Form itu kepada Student Director yang ada di School Admin. Office beliau pasti akan mengurusnya</VALUE>
    <VALUE Lang="cn">噢！您还没注册？请将Egresses Application Form交给位在Administration Office的 Student Director，可完成注册手续就。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_fighter1.ntk_9_0">
    <VALUE Lang="GS">Ah! Can I help you with anything?</VALUE>
    <VALUE Lang="id">Iya, jadi kamu penasaran kan?</VALUE>
    <VALUE Lang="cn">噢！有什么我可以为您效劳的吗？</VALUE>
  </SENTENSE>
