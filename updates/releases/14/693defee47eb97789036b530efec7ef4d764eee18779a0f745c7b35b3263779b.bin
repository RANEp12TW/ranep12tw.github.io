  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_7_0">
    <VALUE Lang="GS">The Main Gate of the campus building is straight ahead. The Welfare Society and the Lockers are over there. You should go there so you'll know where they are when you need them.</VALUE>
    <VALUE Lang="id">Pertama dimulai dari '0' dan setiap naik level akan mendapatkan '1' buah 'Skill Point'</VALUE>
    <VALUE Lang="id">Skill' yang di dapatkan pertama kali dan Skill yang didapat setiap menaiki level, akan membutuhkan 'Skill Point'</VALUE>
    <VALUE Lang="cn">学院的Main Gate就在正前方。Welfare Society 和 Lockers 都在那儿附近。建议您先前往确认位置，以后有急事要办时，就不怕找不到他们了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_7_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_8_0">
    <VALUE Lang="GS">Any other questions?</VALUE>
    <VALUE Lang="id">Penasaran tentang apa?</VALUE>
    <VALUE Lang="cn">还有其他的问题吗？</VALUE>
  </SENTENSE>
