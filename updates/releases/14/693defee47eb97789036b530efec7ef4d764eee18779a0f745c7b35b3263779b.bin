  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_46_0">
    <VALUE Lang="GS">It need String, it can get if from Skating Master</VALUE>
    <VALUE Lang="id">Aku butuh Carving Cord… dapatkan dari Skating Master</VALUE>
    <VALUE Lang="cn">应该需要用到加工线String…</VALUE>
    <VALUE Lang="cn">加工线String可以从Skating Master</VALUE>
    <VALUE Lang="cn">的身上取得。</VALUE>
  </SENTENSE>
