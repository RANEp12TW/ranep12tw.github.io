    <VALUE Lang="cn">气功部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_115_0">
    <VALUE Lang="GS">What's in this letter? A shared ability...</VALUE>
    <VALUE Lang="id">Ini letter tentang apa? Berbagi skill…..</VALUE>
    <VALUE Lang="cn">这是什么信啊？共通能力…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_115_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_116_0">
    <VALUE Lang="GS">So is this what I think it is?</VALUE>
    <VALUE Lang="GS">I need to check what it says first.</VALUE>
    <VALUE Lang="id">Euhm…akhirnya keluar juga rupanya. Ini yang dimaksud dengan 'Letter of Opinion' itu yah?</VALUE>
    <VALUE Lang="id">Harus kami periksa terlebih dahulu.</VALUE>
    <VALUE Lang="cn">嗯…终于出来了。这就是我要的东西吗？</VALUE>
    <VALUE Lang="cn">我要先检查看看内容。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_116_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_117_0">
    <VALUE Lang="GS">Up till now, you were only able to collect this much?</VALUE>
    <VALUE Lang="GS">Well, I guess it isn't that easy to get them from underground.</VALUE>
    <VALUE Lang="GS">Please collect more when you have time.</VALUE>
    <VALUE Lang="id">Tidak bisa membawa selain ini? Euhm…</VALUE>
    <VALUE Lang="id">Kayaknya sulit sekali kalau harus mengumpulkannya di Kantor pusat bawah tanah</VALUE>
    <VALUE Lang="id">Setiap ada waktu tolong kumpulkan item-item seperti ini</VALUE>
    <VALUE Lang="cn">到现在只收回这一点点喔? 嗯 …</VALUE>
    <VALUE Lang="cn">总之要在圣财团地下要收集东西，不是容易的事情。</VALUE>
    <VALUE Lang="cn">等你有空时，继续收集这些东西吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_117_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_118_0">
    <VALUE Lang="GS">Please select the skill section you need.</VALUE>
    <VALUE Lang="id">Kamu membutuhkan skill dari kelas apa, silahkan pilih saja</VALUE>
    <VALUE Lang="cn">请选择您需要的职业技能</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_118_0_1">
    <VALUE Lang="GS">Fighter Section</VALUE>
    <VALUE Lang="id">Skill dari Brawler</VALUE>
    <VALUE Lang="cn">格斗部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_118_0_2">
    <VALUE Lang="GS">Sword Section</VALUE>
    <VALUE Lang="id">Skill dari Swordsman</VALUE>
    <VALUE Lang="cn">剑道部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_118_0_3">
    <VALUE Lang="GS">Archery Section</VALUE>
    <VALUE Lang="id">Skill dari Archery</VALUE>
    <VALUE Lang="cn">弓箭部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_118_0_4">
    <VALUE Lang="GS">Shaman Section</VALUE>
    <VALUE Lang="id">Skill dari Shaman</VALUE>
    <VALUE Lang="cn">气功部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_119_0">
    <VALUE Lang="GS">Take it.</VALUE>
    <VALUE Lang="id">Ini, dibawa ini</VALUE>
    <VALUE Lang="cn">拿去吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_119_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_12_0">
    <VALUE Lang="GS">Huh… Supporting each other.</VALUE>
    <VALUE Lang="GS">When one of us couldn't handle a situation, me and Lee Zhen would work together to work it out.</VALUE>
    <VALUE Lang="id">Euhm…membantu kekuatan</VALUE>
    <VALUE Lang="id">Iya sih, dengan keadaan saya sekarang saya tidak mungkin bisa menyelesaikan semuanya sendirian. Saya dan louis akan memperhatikan perkembangan kamu ke depannya</VALUE>
    <VALUE Lang="cn">嗯.....相互扶持。</VALUE>
    <VALUE Lang="cn">当我们其中一个无法处理时，我和 Lee Zhen会一起努力解决它。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
