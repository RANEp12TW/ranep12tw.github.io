  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0">
    <VALUE Lang="GS">The ecosystem is being destroyed~!</VALUE>
    <VALUE Lang="GS">Something must be done, Immediately~!</VALUE>
    <VALUE Lang="GS">This is a big problem ~!</VALUE>
    <VALUE Lang="GS">(Crank Crank)</VALUE>
    <VALUE Lang="id">Ekosistem sudah mulai rusak~!</VALUE>
    <VALUE Lang="id">Kita harus melakukan sesuatu secepatnya~!</VALUE>
    <VALUE Lang="id">Ini adalah masalah besar~!</VALUE>
    <VALUE Lang="id">(Crank Crank)</VALUE>
    <VALUE Lang="cn">生态系统都被破坏了〜！</VALUE>
    <VALUE Lang="cn">我们必须要开始采取一些措施了，就是现在！！</VALUE>
    <VALUE Lang="cn">这问题真的很严重！（怒）</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0_1">
    <VALUE Lang="GS">What's going on in our planet? Can you tell me what's happening?</VALUE>
    <VALUE Lang="id">Apa yang terjadi di planet kita ini? Bisakah kamu memberitahu apa yang sedang terjadi?</VALUE>
    <VALUE Lang="cn">我们的地球发生了什么事了？您能告诉我发生了什么事情吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0_2">
    <VALUE Lang="GS">Submit the Red Trash</VALUE>
    <VALUE Lang="id">Menyerahkan Red Trash</VALUE>
    <VALUE Lang="cn">交付 Red Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0_3">
    <VALUE Lang="GS">Submit the Green Trash</VALUE>
    <VALUE Lang="id">Menyerahkan Green Trash</VALUE>
    <VALUE Lang="cn">交付 Green Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_1_0_4">
    <VALUE Lang="GS">Submit the Yellow Trash</VALUE>
    <VALUE Lang="id">Menyerahkan Yellow Trash</VALUE>
    <VALUE Lang="cn">交付 Yellow Trash</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_2_0">
    <VALUE Lang="GS">Basura, the alien is trying to destroy mother earth~!</VALUE>
    <VALUE Lang="GS">Eliminate the monster and collect the colored trashes~!</VALUE>
    <VALUE Lang="GS">Collect 30 of each colored trash and return to me for rewards~!</VALUE>
    <VALUE Lang="id">Basura, para alien mencoba menghancurkan planet bumi kita ini~!</VALUE>
    <VALUE Lang="id">Bunuh mereka dan kumpulkan itemnya~!</VALUE>
    <VALUE Lang="id">Kumpulkan 30 dari tiap warna sampah dan kembali ke saya untuk mendapatkan hadiah~!</VALUE>
    <VALUE Lang="cn">Basura，就是一直在试图摧毁如同母亲般的地球的外星人！</VALUE>
    <VALUE Lang="cn">请您消灭怪物，并收集多彩的垃圾。</VALUE>
    <VALUE Lang="cn">只要收集多彩垃圾各30个，并交给我就能领到奖励唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_3_0">
    <VALUE Lang="GS">Have you collected all 30 of Red Trashes?</VALUE>
    <VALUE Lang="id">Sudahkan kamu mengumpulkan 30 buah Red Trashes?</VALUE>
    <VALUE Lang="cn">30个Red Trash 您都收集到了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_3_0_1">
    <VALUE Lang="GS">Recycle the collected red trash for a Red Gift Box reward</VALUE>
    <VALUE Lang="id">Tukar Red trash dengan Red Gift Box reward</VALUE>
    <VALUE Lang="cn">请回收已收集到的 Red Trash，并领取奖励 Red Gift Box。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_3_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_4_0">
    <VALUE Lang="GS">Have you collected all 30 of Green Trashes?</VALUE>
    <VALUE Lang="id">Sudahkan kamu mengumpulkan 30 buah Green Trashes?</VALUE>
    <VALUE Lang="cn">30个Green Trash 您都收集到了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_4_0_1">
    <VALUE Lang="GS">Recycle the collected green trash for a Green Gift Box reward</VALUE>
    <VALUE Lang="id">Tukar Green trash dengan Green Gift Box reward</VALUE>
    <VALUE Lang="cn">请回收已收集到的 Green Trash，并领取奖励 Green Gift Box。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_4_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_5_0">
    <VALUE Lang="GS">Have you collected all 30 of Yellow Trashes?</VALUE>
    <VALUE Lang="id">Sudahkan kamu mengumpulkan 30 buah Yellow Trashes?</VALUE>
    <VALUE Lang="cn">30个Yellow Trash 您都收集到了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_5_0_1">
    <VALUE Lang="GS">Recycle the collected yellow trash for a Yellow Gift Box reward</VALUE>
    <VALUE Lang="id">Tukar Yellow trash dengan Yellow Gift Box reward</VALUE>
    <VALUE Lang="cn">请回收已收集到的 Yellow Trash，并领取奖励 Yellow Gift Box。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_wecareearth.ntk_5_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_0">
    <VALUE Lang="GS">Do you have both the Christmas Stockings and Tickets?</VALUE>
    <VALUE Lang="id">Apakah kamu mempunyai Christmas Stockings and Tickets?</VALUE>
    <VALUE Lang="cn">请问您有Christmas Stocking和Ticket吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_0_1">
    <VALUE Lang="GS">Yes.</VALUE>
    <VALUE Lang="id">Ya</VALUE>
    <VALUE Lang="cn">好的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_0_2">
    <VALUE Lang="GS">No.</VALUE>
    <VALUE Lang="id">Tidak</VALUE>
    <VALUE Lang="cn">不要</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_1">
    <VALUE Lang="GS">Do you have the Christmas Stockings?</VALUE>
    <VALUE Lang="id">Apakah kamu mempunyai Christmas Stockings?</VALUE>
    <VALUE Lang="cn">请问您有Christmas Stocking吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_1_1">
    <VALUE Lang="GS">Yes.</VALUE>
    <VALUE Lang="id">Ya</VALUE>
    <VALUE Lang="cn">好的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_1_2">
    <VALUE Lang="GS">No.</VALUE>
    <VALUE Lang="id">Tidak</VALUE>
    <VALUE Lang="cn">不要</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_2">
    <VALUE Lang="GS">Do you have the Christmas Tickets?</VALUE>
    <VALUE Lang="id">Apakah kamu mempunyai Christmas Tickets?</VALUE>
    <VALUE Lang="cn">请问您有Christmas Ticket吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_2_1">
    <VALUE Lang="GS">Yes.</VALUE>
    <VALUE Lang="id">Ya</VALUE>
    <VALUE Lang="cn">好的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_2_2">
    <VALUE Lang="GS">No.</VALUE>
    <VALUE Lang="id">Tidak</VALUE>
    <VALUE Lang="cn">不要</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_3">
    <VALUE Lang="GS">Gee. This is a big problem. What should I do now?</VALUE>
    <VALUE Lang="GS">Could you please help me out?</VALUE>
    <VALUE Lang="id">Fiuh. Ini adalah masalah besar. Apa yang harus saya lakukan?</VALUE>
    <VALUE Lang="id">Bisakah kamu membantu saya?</VALUE>
    <VALUE Lang="cn">哇！这问题真大条。我现在该怎么办呢？你可以帮帮我吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_1_3_1">
    <VALUE Lang="GS">Ask Santa what is going on</VALUE>
    <VALUE Lang="id">Tanya Santa apa yang terjadi?</VALUE>
    <VALUE Lang="cn">问问Santa，现在是什么状况？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_2_0">
    <VALUE Lang="GS">Bad Rudolf, he was grumbling about his work hours and at last, he has disappeared with all the presents.</VALUE>
    <VALUE Lang="GS">How can I find him alone in this huge town. If you could help me finding him, I will give you a present as a token of my gratitude.</VALUE>
    <VALUE Lang="id">Bad Rudolf, dia selalu mengeluh karena kerja lembur dan tiba - tiba menghilang bersama semua hadiah yang sudah disiapkannya.</VALUE>
    <VALUE Lang="id">Bantu saya menemukannya dan akan kuberikan hadiah.</VALUE>
    <VALUE Lang="cn">坏心眼的Rudolf，他总是在抱怨他的工作时数过长，而且竟然他与所有的礼物都一起消失不见了！</VALUE>
    <VALUE Lang="cn">我该如何独自在这广大的城镇里找到他呢？ 如果您能帮我找到他，我会给您一件奖励作为感谢的礼物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_2_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_3_0">
    <VALUE Lang="GS">I will give you the present, if you have 20 Christmas Stockings and Tickets each.</VALUE>
    <VALUE Lang="id">Saya akan memberikan kamu hadiah jika kamu mempunyai 20 buah Christmas Stockings dan 20 buah Tickets.</VALUE>
    <VALUE Lang="cn">我会给您礼物，只要您把 20条Christmas Stockings和20张Tickets给我即可。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_3_0_1">
    <VALUE Lang="GS">Please give me the present</VALUE>
    <VALUE Lang="id">Minta hadiahnya</VALUE>
    <VALUE Lang="cn">请给我礼物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_3_0_2">
    <VALUE Lang="GS">Maybe, next time</VALUE>
    <VALUE Lang="id">Mungkin lain kali</VALUE>
    <VALUE Lang="cn">也许……下次吧!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_4_0">
    <VALUE Lang="GS">I will give you the present, if you have 20 Christmas Stockings.</VALUE>
    <VALUE Lang="id">Saya akan memberikan kamu hadiah jika kamu mempunyai 20 buah Christmas Stockings.</VALUE>
    <VALUE Lang="cn">如果您拥有20条Christmas Stocking，我就给您奖励。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_4_0_1">
    <VALUE Lang="GS">Please give me the present</VALUE>
    <VALUE Lang="id">Minta hadiahnya</VALUE>
    <VALUE Lang="cn">请给我礼物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_4_0_2">
    <VALUE Lang="GS">Maybe, next time</VALUE>
    <VALUE Lang="id">Mungkin lain kali</VALUE>
    <VALUE Lang="cn">也许……下次吧!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_5_0">
    <VALUE Lang="GS">I will give you the present, if you have 20 Christmas Tickets.</VALUE>
    <VALUE Lang="id">Saya akan memberikan kamu hadiah jika kamu mempunyai 20 buah Tickets.</VALUE>
    <VALUE Lang="cn">如果您拥有20张Christmas Ticket，我就给您奖励。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_5_0_1">
    <VALUE Lang="GS">Please give me the present</VALUE>
    <VALUE Lang="id">Minta hadiahnya</VALUE>
    <VALUE Lang="cn">请给我礼物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_5_0_2">
    <VALUE Lang="GS">Maybe, next time</VALUE>
    <VALUE Lang="id">Mungkin lain kali</VALUE>
    <VALUE Lang="cn">也许……下次吧!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0">
    <VALUE Lang="GS">This is for you!</VALUE>
    <VALUE Lang="GS">Thank you so much for your help. Ho Ho Ho~ Merry Christmas, Everyone!</VALUE>
    <VALUE Lang="id">Ini untukmu!</VALUE>
    <VALUE Lang="id">Terima Kasih untuk bantuannya. Ho Ho Ho~ Selamat Hari Natal!</VALUE>
    <VALUE Lang="cn">来~给你。</VALUE>
    <VALUE Lang="cn">真的谢谢您的帮忙！嘿嘿嘿~ Merry Christmas！亲爱的各位！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_1">
    <VALUE Lang="GS">Exchange Christmas Stockings and Tickets for a Christmas Hat</VALUE>
    <VALUE Lang="id">Tukar Christmas Stockings dan Tickets dengan Christmas Hat</VALUE>
    <VALUE Lang="cn">兑换Christmas Stockings 和 Christmas Hat的票卷</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_2">
    <VALUE Lang="GS">Exchange Christmas Stockings and Tickets for a Christmas Hat</VALUE>
    <VALUE Lang="id">Tukar Christmas Stockings dan Tickets dengan Christmas Hat</VALUE>
    <VALUE Lang="cn">兑换Christmas Stockings 和 Christmas Hat的票卷</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_3">
    <VALUE Lang="GS">Exchange Christmas Stockings for a Santa Costume</VALUE>
    <VALUE Lang="id">Tukar Christmas Stockings dengan Santa Costume</VALUE>
    <VALUE Lang="cn">用Christmas Stockings兑换 Santa Costume</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_4">
    <VALUE Lang="GS">Exchange Christmas Stockings for a Santa Costume</VALUE>
    <VALUE Lang="id">Tukar Christmas Stockings dengan Santa Costume</VALUE>
    <VALUE Lang="cn">用Christmas Stockings兑换 Santa Costume</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_5">
    <VALUE Lang="GS">Exchange Christmas Tickets for a Santa's Shoes</VALUE>
    <VALUE Lang="id">Tukar Christmas Tickets dengan Santa's Shoes</VALUE>
    <VALUE Lang="cn">用Christmas Tickets 兑换 Santa's Shoes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_6_0_6">
    <VALUE Lang="GS">Exchange Christmas Tickets for a Santa's Shoes</VALUE>
    <VALUE Lang="id">Tukar Christmas Tickets dengan Santa's Shoes</VALUE>
    <VALUE Lang="cn">用Christmas Tickets 兑换 Santa's Shoes</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_7_0">
    <VALUE Lang="GS">Liar!! You will never receive a present for lying to Santa.</VALUE>
    <VALUE Lang="id">Pembohong!! Kamu tidak akan pernah menerima hadiah jikalau berbohong.</VALUE>
    <VALUE Lang="cn">骗子！对Santa说谎是拿不到礼物的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_x-mas 2009.ntk_8_0">
    <VALUE Lang="GS">I have to go deliver all the presents tonight, so please hurry up!</VALUE>
    <VALUE Lang="id">Saya harus mengantar semua hadiah malam ini, tolong secepatnya!</VALUE>
    <VALUE Lang="cn">我得去发送所有的礼物，请您快快行动！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0">
    <VALUE Lang="GS">Hello.</VALUE>
    <VALUE Lang="id">Apa kabar?</VALUE>
    <VALUE Lang="cn">您好！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_1">
    <VALUE Lang="GS">Show the Stone</VALUE>
    <VALUE Lang="id">Menunjukkan Stone</VALUE>
    <VALUE Lang="cn">出示石头</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e1_arms.ntk_1_0_10">
