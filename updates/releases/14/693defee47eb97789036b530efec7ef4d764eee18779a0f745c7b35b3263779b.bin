  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_81_0">
    <VALUE Lang="GS">In order to acquire knowledge on the Suggestion Book, students need to bring the paper notes to the Student Director located at Mystic Peak.</VALUE>
    <VALUE Lang="id">Tuh kan……</VALUE>
    <VALUE Lang="id">Sesuai dengan perkiraan</VALUE>
    <VALUE Lang="id">Kamu bawa currency ini kepada Student Director dari Phoenix school terus minta Letter of Opinion darinya</VALUE>
    <VALUE Lang="cn">"果然如预想中的一样</VALUE>
    <VALUE Lang="cn">学生们要拿着纸币去给Mystic Peak学院的Student Director来学习意见书。</VALUE>
    <VALUE Lang="cn">"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_t_master1.ntk_81_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
