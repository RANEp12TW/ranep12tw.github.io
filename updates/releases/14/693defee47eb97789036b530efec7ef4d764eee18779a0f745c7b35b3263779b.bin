  <SENTENSE Ver="1" Id="npc_3_junbi_1.ntk_12_0">
    <VALUE Lang="GS">The primary targets in this area are the Fencing Students.</VALUE>
    <VALUE Lang="GS">Please eliminate 18 of them.</VALUE>
    <VALUE Lang="id">Di lokasi ini targetnya adalah Fencing Student</VALUE>
    <VALUE Lang="id">Jatuhkan 18 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为Fencing Student。请除掉18只 Fencing Student，维持良好校园风气。</VALUE>
  </SENTENSE>
