    <VALUE Lang="GS">Ask about Building</VALUE>
    <VALUE Lang="id">Bertanya tentang Building</VALUE>
    <VALUE Lang="cn">询问有关这建筑物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0_3">
    <VALUE Lang="GS">Give the Clue</VALUE>
    <VALUE Lang="id">Menyampaikan petunjuk</VALUE>
    <VALUE Lang="cn">提示线索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0_4">
    <VALUE Lang="GS">Ask about Entering Building</VALUE>
    <VALUE Lang="id">Bertanya cara memasuki Building</VALUE>
    <VALUE Lang="cn">询问进入大楼的方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0_5">
    <VALUE Lang="GS">Ask about "Green" Secret Hideout</VALUE>
    <VALUE Lang="id">Bertanya tentang persembunyian rahasia "Green".</VALUE>
    <VALUE Lang="cn">询问“Green”的机密据点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_0_6">
    <VALUE Lang="GS">Show the Key</VALUE>
