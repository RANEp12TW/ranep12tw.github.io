    <VALUE Lang="GS">Exchange for Lv. 30 'Heavy Cestus'</VALUE>
    <VALUE Lang="id">Tukar dengan Lv. 30 'Heavy Cestus'</VALUE>
    <VALUE Lang="cn">兑换 Lv. 30 'Heavy Cestus'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_6_0_3">
    <VALUE Lang="GS">Exchange for Lv. 30 'Vital Cestus'</VALUE>
    <VALUE Lang="id">Tukar dengan Lv. 30 'Vital Cestus'</VALUE>
    <VALUE Lang="cn">兑换 Lv. 30 'Vital Cestus'</VALUE>
  </SENTENSE>
