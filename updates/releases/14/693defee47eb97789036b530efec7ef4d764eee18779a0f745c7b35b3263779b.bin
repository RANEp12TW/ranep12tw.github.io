    <VALUE Lang="id">Menukarkan Invitation letter dengan 'Hero's bow'</VALUE>
    <VALUE Lang="cn">拿 Hero Invitation 兑换 Hero's Bow Pack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_2_0_5">
    <VALUE Lang="GS">Exchange Hero Invitation for Hero's Power Bow Pack</VALUE>
