    <VALUE Lang="id">Menukarkan Invitation letter dengan 'Hero's gun'</VALUE>
    <VALUE Lang="cn">拿Hero Invitation 兑换 Hero's Gun Pack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_2_0_13">
    <VALUE Lang="GS">Exchange Hero Invitation for Hero's Railgun Pack</VALUE>
    <VALUE Lang="id">Menukarkan Invitation letter dengan 'Hero's railgun'</VALUE>
    <VALUE Lang="cn">拿Hero Invitation兑换 Hero's Railgun Pack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_2_0_14">
    <VALUE Lang="GS">Exchange Hero Invitation for Hero's Portal Gun Pack</VALUE>
    <VALUE Lang="id">Menukarkan Invitation letter dengan 'Hero's Portal Gun'</VALUE>
    <VALUE Lang="cn">拿Hero Invitation兑换 Hero's Portal Gun Pack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_2_0_15">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_2_0_2">
    <VALUE Lang="GS">Exchange Hero Invitation for Hero's Blade Pack</VALUE>
    <VALUE Lang="id">Menukarkan Invitation letter dengan 'Hero's blade'</VALUE>
    <VALUE Lang="cn">拿Hero Invitation 兑换 Hero's Blade Pack</VALUE>
  </SENTENSE>
