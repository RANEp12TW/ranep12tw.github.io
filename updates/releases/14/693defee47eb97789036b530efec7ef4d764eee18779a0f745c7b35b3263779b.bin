    <VALUE Lang="id">Melaporkan Hasil</VALUE>
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex2.ntk_1_5_12">
    <VALUE Lang="GS">Give the Medicine</VALUE>
    <VALUE Lang="id">Menyerahkan Medicine</VALUE>
    <VALUE Lang="cn">交付药品</VALUE>
  </SENTENSE>
