    <VALUE Lang="id">Konfimasi pembersihan musuh</VALUE>
    <VALUE Lang="cn">净化确认</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_14">
    <VALUE Lang="GS">Art Center 2nd Purification</VALUE>
    <VALUE Lang="id">Pemberesan musuh Art Centre 2</VALUE>
    <VALUE Lang="cn">Art Center 净化2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_yesul_1.ntk_1_0_15">
    <VALUE Lang="GS">Confirm Purification</VALUE>
    <VALUE Lang="id">Konfimasi pembersihan musuh</VALUE>
    <VALUE Lang="cn">净化确认</VALUE>
  </SENTENSE>
