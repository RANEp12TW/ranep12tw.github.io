  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_9_0">
    <VALUE Lang="GS">I've found out that quests are very difficult at first. But now... It's really hard for me to finish them.</VALUE>
    <VALUE Lang="id">Sampai beberapa waktu lalu saja proses tugas tidak pernah seperti ini, saya pikir juga ini sudah sangat keterlaluan.</VALUE>
    <VALUE Lang="id">Walaupun semua orang, sampai para guru pergi keluar untuk menyelidiki kejadian itu.</VALUE>
    <VALUE Lang="cn">一开始，这些任务对我来说真的是比登天还难，而现在，要完成它们，仍是需要挤尽我吃奶的力气，非常的难。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_knight1.ntk_9_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_1_0">
    <VALUE Lang="GS">Oh my goodness! Why are so many people injured?</VALUE>
    <VALUE Lang="id">Ah~</VALUE>
    <VALUE Lang="id">Kenapa begini banyak anak-anak yang terluka</VALUE>
    <VALUE Lang="cn">哎呀, 为什么这么多人受伤?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_medic1.ntk_1_0_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
