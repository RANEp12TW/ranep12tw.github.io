    <VALUE Lang="cn">.......9</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_18_0">
    <VALUE Lang="GS">These currency notes have been verified by the ATMs as genuine money.</VALUE>
    <VALUE Lang="id">Tetapi bila dicek dengan mesin ATM, terdeteksi sebagai uang asli</VALUE>
    <VALUE Lang="cn">这些纸币已经透过ATM来检验核准了。</VALUE>
    <VALUE Lang="cn">确实为真钞无误。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_18_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
