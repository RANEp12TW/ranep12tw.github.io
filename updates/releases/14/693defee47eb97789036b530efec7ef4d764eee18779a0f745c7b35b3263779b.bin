  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4">
    <VALUE Lang="GS">A student can be considered quite powerful if he passes all of the exams.</VALUE>
    <VALUE Lang="id">Kamu sudah lulus semua ujian rupanya</VALUE>
    <VALUE Lang="id">Kemampuan kamu sudah dikonfirmasi dengan cukup</VALUE>
    <VALUE Lang="cn">如果学生通过了全部的考试，就能充分地证明学生的能力。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4_1">
    <VALUE Lang="GS">Listen to Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4_2">
    <VALUE Lang="GS">Ask about the Old Man at Root Hole</VALUE>
    <VALUE Lang="id">Bertanya tentang Oldman yang ditemui di Root Hole</VALUE>
    <VALUE Lang="cn">询问有关在Root Hole的 Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_4_3">
    <VALUE Lang="GS">Result</VALUE>
    <VALUE Lang="id">Melaporkan hasil</VALUE>
    <VALUE Lang="cn">结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5">
    <VALUE Lang="GS">I'm curious as to how far the students' capabilities can be tested.</VALUE>
    <VALUE Lang="id">Saya pensarasan seberapakah kemampuan kamu</VALUE>
    <VALUE Lang="cn">我很好奇学生的能力到哪里？真的很好奇。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_1">
    <VALUE Lang="GS">Ask about Mail</VALUE>
    <VALUE Lang="id">Bertanya tentang letter</VALUE>
    <VALUE Lang="cn">询问邮件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_2">
    <VALUE Lang="GS">Show Rewards</VALUE>
    <VALUE Lang="id">Memperlihatkan item yang didapat</VALUE>
    <VALUE Lang="cn">秀出奖励品。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_3">
    <VALUE Lang="GS">Ask about Situation</VALUE>
    <VALUE Lang="id">Bertanya situasi</VALUE>
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_4">
    <VALUE Lang="GS">Show the Pill</VALUE>
    <VALUE Lang="id">Memperlihatkan pill</VALUE>
    <VALUE Lang="cn">秀出Pill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_5">
    <VALUE Lang="GS">Ask about What Happened</VALUE>
    <VALUE Lang="id">Bertanya apa yang terjadi</VALUE>
    <VALUE Lang="cn">询问发生何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_6">
    <VALUE Lang="GS">Accept Confirmed Results</VALUE>
    <VALUE Lang="id">Mnedapatkan konfirmasi hasil</VALUE>
    <VALUE Lang="cn">接受确认结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_7">
    <VALUE Lang="GS">Ask about the Old Man at Root Hole</VALUE>
    <VALUE Lang="id">Bertanya tentang Oldman yang ditemui di Root Hole</VALUE>
    <VALUE Lang="cn">询问有关在Root Hole的 Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_5_8">
    <VALUE Lang="GS">Result</VALUE>
    <VALUE Lang="id">Melaporkan hasil</VALUE>
    <VALUE Lang="cn">结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6">
    <VALUE Lang="GS">What are you here for?</VALUE>
    <VALUE Lang="id">Ada perlu apa yah?</VALUE>
    <VALUE Lang="cn">到这里来的目的是？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_1">
    <VALUE Lang="GS">Show the Letter</VALUE>
    <VALUE Lang="id">Memperlihatkan letter</VALUE>
    <VALUE Lang="cn">秀出信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_2">
    <VALUE Lang="GS">Ask about the Mail</VALUE>
    <VALUE Lang="id">Bertanya tentang letter</VALUE>
    <VALUE Lang="cn">询问信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_3">
    <VALUE Lang="GS">Ask about the Old Man at Root Hole</VALUE>
    <VALUE Lang="id">Bertanya tentang Oldman yang ditemui di Root Hole</VALUE>
    <VALUE Lang="cn">询问有关在Root Hole的 Old Man</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_1_6_4">
    <VALUE Lang="GS">Result</VALUE>
    <VALUE Lang="id">Melaporkan hasil</VALUE>
    <VALUE Lang="cn">结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_10_0">
    <VALUE Lang="GS">Here!</VALUE>
    <VALUE Lang="GS">Do you want to accept the Final Test?</VALUE>
    <VALUE Lang="id">Malah sebaliknya bisa saja menghancurkan bentuknya</VALUE>
    <VALUE Lang="id">Nah, mau melakukan ujian yang terakhir?</VALUE>
    <VALUE Lang="cn">来吧！要挑战最后一道任务了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_10_0_2">
    <VALUE Lang="GS">Accept the Final Test</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受最后的测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_10_0_3">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_11_0">
    <VALUE Lang="GS">This is the Final Test.</VALUE>
    <VALUE Lang="GS">Am I making you nervous?</VALUE>
    <VALUE Lang="GS">This exam can reflect the capabilities of the students in regards to their power.</VALUE>
    <VALUE Lang="GS">You have 8 minutes to finish the test. You are tasked to eliminate 15 Hunk Baldies located in the Golf Field area.</VALUE>
    <VALUE Lang="id">Sayang sekali kan karena ini terakhir?</VALUE>
    <VALUE Lang="id">Tapi kamu harus tahu bahwa ini hanyalah awal</VALUE>
    <VALUE Lang="id">Ujian kali ini adalah untuk mengetahui kekuatan kamu sendiri</VALUE>
    <VALUE Lang="id">Akau akan memberikan waktu selama 8 menit</VALUE>
    <VALUE Lang="id">Cobalah lumpuhkan 15 orang Blue Brothers Member yang ad</VALUE>
    <VALUE Lang="cn">这是最后一道任务了！我让您感到紧张，对吧？</VALUE>
    <VALUE Lang="cn">这次的考试可以测出学生自己的力量。您有8分钟的时间，请消灭位在Golf Field area 的15名Hunk Baldy。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_11_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_12_0">
    <VALUE Lang="GS">This is great!</VALUE>
    <VALUE Lang="GS">Even though it's not complete, the quality is pretty good.</VALUE>
    <VALUE Lang="id">Hebat sekali rupanya</VALUE>
    <VALUE Lang="id">Walaupun masih belum sempurna tapi bakat kamu lumayan juga</VALUE>
    <VALUE Lang="id">Dengan informasi seperti ini mungkin setidaknya tidak ada bahaya akan meledak</VALUE>
    <VALUE Lang="cn">太厉害了！虽然还不是超级厉害，但已经能确定您拥有不错的基本功。很不错了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_12_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_13_0">
    <VALUE Lang="GS">I am sure that there are "Lights" around us.</VALUE>
    <VALUE Lang="GS">I don't know when these "Lights" would be appreciated.</VALUE>
    <VALUE Lang="id">Sekarang di sekeliling kita ada cahaya dan itu sepertinya sudah menjadi sesuatu hal yang biasa</VALUE>
    <VALUE Lang="id">Tapi tidak ada yang tahu mungkin suatu saat nanti cahaya ini akan menjadi sesuatu yang berharga</VALUE>
    <VALUE Lang="cn">我确定光就在我们的身边。但不晓得它们何时可以展现了能量给我们瞧瞧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_13_0_2">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_14_0">
    <VALUE Lang="GS">Even my own daughter doesn't believe me!</VALUE>
    <VALUE Lang="GS">Before the arrival of the abnormal phenomenon, she didn't say a word. She's ignoring the incident and refuses to believe what I say.</VALUE>
    <VALUE Lang="GS">The reality is that these terrible things that are happening… They're not normal!</VALUE>
    <VALUE Lang="id">Anak saya Hermosa juga tidak mau percaya dengan kata-kata saya</VALUE>
    <VALUE Lang="id">Dia juga begitu, sebelum kejadian itu terjadi dia tidak pernah bilang apa-apa. Dia baru mulai bercerita setelah kakak kelasnya berubah menjadi monster…</VALUE>
    <VALUE Lang="cn">连我的女儿都不相信我。在发生异变之前，她一句话也不说。她否认异变的发生，甚至抗拒去相信事实。</VALUE>
    <VALUE Lang="cn">现在的问题在于，可怕的事情正在发生……… 真的非常危险且不安全。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_14_0_2">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_15_0">
    <VALUE Lang="GS">...4</VALUE>
    <VALUE Lang="id">...4</VALUE>
    <VALUE Lang="cn">...4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_16_0">
    <VALUE Lang="GS">The students are starting to panic, but I think this is only the beginning of our troubles. I can feel that this craziness is going to get worse.</VALUE>
    <VALUE Lang="id">Kini kamu juga mungkin sudah bisa merasakan…</VALUE>
    <VALUE Lang="id">Situasi sekarang ini hanyalah pendahuluan dari kejadian yang dimulai</VALUE>
    <VALUE Lang="cn">学生们已经开始恐慌了。我想这只是前戏而已，我也可以感受得到这种份疯狂的气氛一直在持续恶化中。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_16_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_17_0">
    <VALUE Lang="GS">I need to test the capabilities of students so that they will be prepared for whatever dangers lie ahead.</VALUE>
    <VALUE Lang="id">Masih…</VALUE>
    <VALUE Lang="id">Tapi saya harus menguji dulu pengalaman kamu</VALUE>
    <VALUE Lang="id">Karena tidak mungkin memberikan informasi penting secara semiteman yang mungkin akan menyebabkan kekacauan</VALUE>
    <VALUE Lang="cn">我得测验学生的能力，如此他们才能知道自身的实力，并评估各种危险性，来避免各种伤害。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_17_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_18_0">
    <VALUE Lang="GS">....7</VALUE>
    <VALUE Lang="id">....7</VALUE>
    <VALUE Lang="cn">....7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_19_0">
    <VALUE Lang="GS">This mail is from the professor who established the Sacred Financial Group.</VALUE>
    <VALUE Lang="id">Mungkin setidaknya saya berikan sedikit informasi?</VALUE>
    <VALUE Lang="id">Surat ini datang dari Professor Choi Ta Gyu yang merupakan pendiri Yayasan Saint yang mendirikan sekolah kamu</VALUE>
    <VALUE Lang="cn">Sacred Financial Group的创办人崔教授给了您这封信。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_19_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_2_0">
    <VALUE Lang="GS">....</VALUE>
    <VALUE Lang="id">....</VALUE>
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_20_0">
    <VALUE Lang="GS">My daughter is also a student of the Sacred Financial Group.</VALUE>
    <VALUE Lang="GS">Have you heard about her before?</VALUE>
    <VALUE Lang="GS">She's still at Level 1… She doesn't know that much.</VALUE>
    <VALUE Lang="id">Anak saya juga Pelajar dari sekolah yang sama</VALUE>
    <VALUE Lang="id">Saya tidak tahu apakah kamu pernah mendengarnya atau tidak? Namanya Hermosa…</VALUE>
    <VALUE Lang="id">Karena masih kelas satu jadi belum dewasa</VALUE>
    <VALUE Lang="cn">我的女儿也是Sacred Financial Group的学生。</VALUE>
    <VALUE Lang="cn">您有听说过她吗？</VALUE>
    <VALUE Lang="cn">她的等级只有1级，所以懂的不是很多。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_20_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_21_0">
    <VALUE Lang="GS">We have to eliminate the evil Senior Student!</VALUE>
    <VALUE Lang="GS">He's already caused too much trouble.</VALUE>
    <VALUE Lang="id">Sekarang dia sedang berkeliaran untuk membunuh kakak kelasnya yang dia cintai dulu</VALUE>
    <VALUE Lang="cn">我们必须要杀掉邪恶的学长！他真的制造了很多麻烦。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_21_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_22_0">
    <VALUE Lang="GS">That senior transformed like the others into an evil monster! Maybe he belongs to another world now.</VALUE>
    <VALUE Lang="id">Soalnya pelajar laki-laki yang juga merupakan senior dia telah berubah menjadi monster seperti orang lain</VALUE>
    <VALUE Lang="id">Mungkin saja sekarang dia sudah berada di dunia lain</VALUE>
    <VALUE Lang="cn">那个学长变成怪物了。现在他也许已经成为异世界的人了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_22_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_23_0">
    <VALUE Lang="GS">....8</VALUE>
    <VALUE Lang="id">....8</VALUE>
    <VALUE Lang="cn">....8</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_24_0">
    <VALUE Lang="GS">It looks like we may never understand the languages from the other worlds.</VALUE>
    <VALUE Lang="id">Ini seperti alpabet dari dunia lain yang mungkin nantinya harus dihafal</VALUE>
    <VALUE Lang="id">Dari A sampai J sesuai urutannya</VALUE>
    <VALUE Lang="cn">我们似乎是永远也无法了解异世界的语言。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_24_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_25_0">
    <VALUE Lang="GS">There's another to pronounce these words, actually. Am I confusing you? Sorry!</VALUE>
    <VALUE Lang="id">Sebenarnya ada cara lain untuk membacanya selain ini tapi karena ini pertama kali cukup ini dulu…</VALUE>
    <VALUE Lang="id">Kalau kamu perhatikan di daerah sekitar kamu mungkin pernah melihatnya di beberapa tempat</VALUE>
    <VALUE Lang="cn">应该是有其他的念法。事实上，我好像把您搞得更糊涂了….. 抱歉啊！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_25_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_26_0">
    <VALUE Lang="GS">There are weird characters around the area of the Sacred Gate Campus and 3rd Floor of the "Green" Underground Foothole Command Center.</VALUE>
    <VALUE Lang="GS">Ah! Here's the problem.</VALUE>
    <VALUE Lang="GS">Aima, Sarandu, Aida, the existence of connecting these three words can be found in the Trading Hole.</VALUE>
    <VALUE Lang="id">Disekitar lapangan olahraga SG_School atau…Hangout 1F_Ch3…tulisan-tulisan yang berbentuk aneh itu lho</VALUE>
    <VALUE Lang="id">Nah, di sinilah masalahnya!</VALUE>
    <VALUE Lang="id">Aiman, Sarandoo, Eida</VALUE>
    <VALUE Lang="id">Bila 3 huruf ini digabungkan maka sesuatu yang berhubungan denganya ada di Trading Hole.</VALUE>
    <VALUE Lang="cn">在Sacred Gate Campu的周围，以及 "Green" Underground Foothole Command Center 的3楼里面，都写有着奇怪的文字。.</VALUE>
    <VALUE Lang="cn">噢！问题就在这里了！只要是与 “Aima、Sarandu、Aida”这3个文字有关的东西，都可以在 Trading Hole里找得到唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_26_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_27_0">
    <VALUE Lang="GS">Did you know that they carry Painkillers? Please acquire 10 Painkillers within 15 minutes.</VALUE>
    <VALUE Lang="id">Di item-item milik mereka ada obat penenang, coba tolong bawakan 10 buah obat penenang dalam bentuk tablet itu</VALUE>
    <VALUE Lang="id">Batas waktunya adalah 15 menit</VALUE>
    <VALUE Lang="cn">您知道他们拿着Painkillers吗？请您在15分钟之内，拿到10 颗 Painkiller。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_27_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_28_0">
    <VALUE Lang="GS">....10</VALUE>
    <VALUE Lang="id">....10</VALUE>
    <VALUE Lang="cn">....10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_29_0">
    <VALUE Lang="GS">Second Exam completed!</VALUE>
    <VALUE Lang="GS">So did you want to learn more information?</VALUE>
    <VALUE Lang="GS">The professor had predicted this would happen a long time ago, ever since the LiuChengYou incident in 1988.</VALUE>
    <VALUE Lang="id">Begitu yah, saya harus memberikan informasi yang lebih banyak kan?</VALUE>
    <VALUE Lang="id">Professor Choi Te Gyu sudah memperkirakan kejadian ini sejak dulu</VALUE>
    <VALUE Lang="id">Sejak kejadian hujan menetor pada tahun 1988</VALUE>
    <VALUE Lang="cn">第二道测验已成功达成。</VALUE>
    <VALUE Lang="cn">您还想要拿到更多资讯吗？</VALUE>
    <VALUE Lang="cn">自从1988年，LiuChengYou事件发生之后，博士教授马上就猜到这事情会发生了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_29_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_3_0">
    <VALUE Lang="GS">Oh! Why are you late?</VALUE>
    <VALUE Lang="GS">Thanks! You came here just to bring my mail?</VALUE>
    <VALUE Lang="id">Aduh?</VALUE>
    <VALUE Lang="id">Kenapa baru sekarang…surat ini…</VALUE>
    <VALUE Lang="id">Terimakasih , kamu sengaja datang untuk menyerahkan ini?</VALUE>
    <VALUE Lang="id">Tapi bagaimana bisa surat ini ada di tempat seperti itu?</VALUE>
    <VALUE Lang="cn">您怎么现在才来…..</VALUE>
    <VALUE Lang="cn">谢谢您。您是为了给我信才来到这里的吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_3_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_30_0">
    <VALUE Lang="GS">Are you talking about the incident?</VALUE>
    <VALUE Lang="GS">A few years later, the Sacred Financial Group was recognized internationally when it became a huge organization.</VALUE>
    <VALUE Lang="id">Kalau dibilang kejadian juga sedikit begitu yah?</VALUE>
    <VALUE Lang="id">Beberapa tahun kemudian dia mendapatkan pengakuan internasional dan membangun organisasi yang besar itu</VALUE>
    <VALUE Lang="id">Itu adalah Yayasan saint</VALUE>
    <VALUE Lang="cn">你说的是这事件吗？当时，过了几年后，Sacred Financial Group 在成为巨大的机关时，就成功获得了国际间的认证与肯定。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_30_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_31_0">
    <VALUE Lang="GS">I received essential information earlier, which is why I know what is happening right now.</VALUE>
    <VALUE Lang="GS">Recently, I thought that the prophecy was wrong.</VALUE>
    <VALUE Lang="id">Saya juga tahu kejadian seperti hari ini dari data yang diterima dulu</VALUE>
    <VALUE Lang="id">Sebenarnya tadi aku masih berpikir orang gila mana sih yang mengigau begitu keras…</VALUE>
    <VALUE Lang="cn">我也是经由当时收到的资料，才知道现在的事情。事实上，我认为所谓的“预言”，其实都是屁话，不可信的虚假谎言。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_31_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_32_0">
    <VALUE Lang="GS">The information I received before not only explained what happened at the time, but also indicated what will happen later.</VALUE>
    <VALUE Lang="GS">I'm seeing the prophecy being fulfilled right now, considering the activities of the students in this area!</VALUE>
    <VALUE Lang="id">Tapi data-data itu bukan hanya menjelaskan keadaan aneh yang terjadi selama ini tetapi juga hal-hal yang akan terjadi di masa depan</VALUE>
    <VALUE Lang="id">Hingga para pelajar yang akan melakukan pekerjaan seperti ini di sini</VALUE>
    <VALUE Lang="cn">但是，那些资料不仅确实说明了当时的异变现象，同时也显示了之后所发生的种种事迹。甚至连学生在这地方进行的活动也……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_32_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_33_0">
    <VALUE Lang="GS">The prophecy indicated even more turmoil... I feel we should prepare for what's coming.</VALUE>
    <VALUE Lang="id">Bisa saja dibilang bahwa kita sedang bermain di dunia yang memang sudah diperkirakan sejak dulu, tapi saya nggak berpikir seperti itu</VALUE>
    <VALUE Lang="cn">虽然预言这种东西会带来更大的混乱，不过，我想这可以让我们时时处于警戒心态。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_33_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_34_0">
    <VALUE Lang="GS">....13</VALUE>
    <VALUE Lang="id">....13</VALUE>
    <VALUE Lang="cn">....13</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_35_0">
    <VALUE Lang="GS">Please remember that the spreading of war and the abnormal phenomenon are related to the "Light". Students need to think and act as heroes to get ready for the future.</VALUE>
    <VALUE Lang="id">Pertarungan dan bencana yang sedang terjadi sekarang…jangan lupa bahwa semuanya berhubungan dengan cahaya</VALUE>
    <VALUE Lang="id">Mungkin status kamu diluar adalah pelajar tapi jiwa yang ada di dalam diri kamu adalah jiwa pahlawan yang datang dari dunia lain</VALUE>
    <VALUE Lang="cn">别忘了，现在日益严重的异象与战争，都是跟“光”有关系的。学生们一定要表现得像是英雄，才能拯救我们的未来。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_35_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_36_0">
    <VALUE Lang="GS">Someday, I will recover my memories of the peace we enjoyed before all of this happened.</VALUE>
    <VALUE Lang="id">Mungkin semuanya akan menjadi jelas kalau ingatan saya telah kembali melalui kebangkitan suatu saat tapi untuk sekarang saya hanya harus percaya</VALUE>
    <VALUE Lang="id">Kalau tidak bisa seperti itu, mungkin akan menjadi seperti monster yang lain yang hanya terus mengulangi pe</VALUE>
    <VALUE Lang="cn">总有某天，我一定会恢复我的记忆，那些在和平时代，我们享受美好生活的那段回忆。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_36_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_37_0">
    <VALUE Lang="GS">You must remember that we need to be unified in order to combat the chaos around us!</VALUE>
    <VALUE Lang="id">Harus ingat dengan pekerjaan awal.</VALUE>
    <VALUE Lang="id">Saya akan beritahukan pintu menuju dunia lain kalau nanti kekuatan dan kemampuan kamu telah cukup</VALUE>
    <VALUE Lang="cn">您一定要记住，我们是一定要结合的！目标是为了与周遭混乱世界的战斗！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_37_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_38_0">
    <VALUE Lang="GS">Please consider this is the awakening.</VALUE>
    <VALUE Lang="GS">We need plenty of training and should have proven ourselves worthy before we can consider moving to another dimension.</VALUE>
    <VALUE Lang="id">Pada saat itu saya berpikir bahwa itu akan menjadi saatnya kebangkitan</VALUE>
    <VALUE Lang="id">Teruslah berlatih hingga kamu mendekati kemampuan semula kamu sebelum sampai ke pintu itu</VALUE>
    <VALUE Lang="cn">请注意现在是觉醒的时段。</VALUE>
    <VALUE Lang="cn">我们必须接受大量的训练，才能证明我们是有足够能力可前往下一关的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_38_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_39_0">
    <VALUE Lang="GS">......14</VALUE>
    <VALUE Lang="id">......14</VALUE>
    <VALUE Lang="cn">......14</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_4_0">
    <VALUE Lang="GS">Here! I advise you to take a rest first!</VALUE>
    <VALUE Lang="id">Jadi gimana, mau ikut ujian ini?</VALUE>
    <VALUE Lang="cn">来~我建议您先休息一下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_4_0_2">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_4_0_3">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_40_0">
    <VALUE Lang="GS">Have you seen the sun in Leonair Campus?</VALUE>
    <VALUE Lang="GS">There is no Light anymore in that area!</VALUE>
    <VALUE Lang="id">Mungkin tidak mau mempercayainya</VALUE>
    <VALUE Lang="id">Tapi kamu harus tahu ini.</VALUE>
    <VALUE Lang="id">Tidak mau percaya atau tidak bisa percaya tapi kenyataan bahwa permasalahan seperti itu tidak ada gunanya di depan ketulusan…</VALUE>
    <VALUE Lang="cn">请问您在Leonair Campus里面有看过“光”出现的模样吗?我想这地区不会再出现任何光明了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_40_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_41_0">
    <VALUE Lang="GS">Have you seen the sun in Leonair Campus?</VALUE>
    <VALUE Lang="GS">There is no Light anymore in that place.</VALUE>
    <VALUE Lang="GS">The location of Leonair Campus changed all of a sudden.</VALUE>
    <VALUE Lang="id">Pernahkah kamu lihat matahari di Leonine school?</VALUE>
    <VALUE Lang="id">Di tempat itu sudah tidak ada lagi cahaya</VALUE>
    <VALUE Lang="id">Kenapa lokasi dari Leonine School tiba-tiba berubah yah?</VALUE>
    <VALUE Lang="cn">请问您在Leonair Campus里面有看过“光”出现的模样吗?我想这地区不会再出现任何光明了。Leonair Campus 的位置也是突然间移到别处……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_41_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_42_0">
    <VALUE Lang="GS">We should always be aware of events around us. We must be ever vigilant during these dark times!</VALUE>
    <VALUE Lang="id">Hal-hal yang bisa dimengerti oleh akal sehat hingga 10 tahun yang lalu, sudah tidak bisa dimengerti lagi</VALUE>
    <VALUE Lang="id">Pengetahuan umum baru yang harus diketahui mungkin saja salah</VALUE>
    <VALUE Lang="cn">我们必须要警戒所有周遭发生的大小事件。 必须要在这黑暗时期里，保持警戒。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_42_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_43_0">
    <VALUE Lang="GS">The LiuChingYou incident was a costly lesson in vigilance to us.</VALUE>
    <VALUE Lang="GS">Still, he must have had no regrets…</VALUE>
    <VALUE Lang="id">Tapi tolong ketahuilah untuk memahami kejadian yang mungkin terjadi di masa depan kita tidak boleh terjebak dalam hal yang terjadi hingga kini</VALUE>
    <VALUE Lang="id">Kejadian hujan meteor 18 tahun yang lalu</VALUE>
    <VALUE Lang="id">Pada awalnya mereka adalah cahaya di kehidupan sebelumnya</VALUE>
    <VALUE Lang="cn">对我们来说，LiuChingYou事件是一个非常刻苦铭心的教训。</VALUE>
    <VALUE Lang="cn">虽然，他尚未有任何丝毫的悔意。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_43_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_44_0">
    <VALUE Lang="GS">Our lives in the next dimension will reflect the lives we have right now. You should remember that!</VALUE>
    <VALUE Lang="id">Tentu saja kehidupan sebelumnya yang datang dari dunia lain</VALUE>
    <VALUE Lang="id">Kamu adalah salah satu bentuk dari cahaya yang datang dari dunia lain</VALUE>
    <VALUE Lang="id">Meskipun badannya sudah tidak sempurna tapi saya yakin jiwa yang ada di dalamnya masih terjaga</VALUE>
    <VALUE Lang="cn">我们现在的模样，将掌握我们往后未来的结果。一定要记住这点。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_44_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_45_0">
    <VALUE Lang="GS">Please train yourself until you attain enough power and qualification.</VALUE>
    <VALUE Lang="GS">This is preparation for the afterlife!</VALUE>
    <VALUE Lang="id">Kalau kamu mencapai dunia lain tempat dimana kamu berasal mungkin kamu bisa kembali ke bentuk awal secara berulang-ulang melalui kebangkitan</VALUE>
    <VALUE Lang="id">Tapi saya berpikir masih belum waktunya</VALUE>
    <VALUE Lang="id">Teruslah berlatih hingga kamu mempunyai cukup kekuatan dan keahlian</VALUE>
    <VALUE Lang="cn">请狠狠地训练自己，直到你获得足够的力量和资格。这是为了您的未来着想。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_45_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_46_0">
    <VALUE Lang="GS">When the time is right, I'll tell you about the door that connects to the other world.</VALUE>
    <VALUE Lang="id">Saya akan memberitahu tentang pintu yang bisa menyentuh dunia lain kalau sudah waktunya</VALUE>
    <VALUE Lang="id">Tapi kamu harus camkan satu hal</VALUE>
    <VALUE Lang="id">Mungkin….kamu akan bertemu dengan bagian diri kamu yang lain</VALUE>
    <VALUE Lang="cn">如果时间到的话，我会告诉您关于通往异世界的门在哪儿。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_46_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_47_0">
    <VALUE Lang="GS">Once you enter the next dimension, you might see people that look just like you. You may also encounter much stronger monsters!</VALUE>
    <VALUE Lang="GS">Keep this in mind.</VALUE>
    <VALUE Lang="id">Diri kamu yang lain itu mungkin saja adalah teman atau gurumu hingga saat ini</VALUE>
    <VALUE Lang="id">Tapi….</VALUE>
    <VALUE Lang="id">Tak ada jaminan bahwa orang itu akan memilih jalan yang sama dengan kamu</VALUE>
    <VALUE Lang="id">Tolong jelaskan tentang hal itu</VALUE>
    <VALUE Lang="cn">一旦你进入下一个阶段，您可能会看到一个长得像你一样的人。您可能还会遇到更强大的怪物！</VALUE>
    <VALUE Lang="cn">请牢牢记住。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_47_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_48_0">
    <VALUE Lang="GS">Where was he last time?</VALUE>
    <VALUE Lang="GS">I'd better check and make sure.</VALUE>
    <VALUE Lang="id">Beliau ada di sana rupanya</VALUE>
    <VALUE Lang="id">Huhu</VALUE>
    <VALUE Lang="id">Beliau menjaga tempat itu bukan karena dia sedang bosan.</VALUE>
    <VALUE Lang="id">Mungkin sedang menjaganya kan</VALUE>
    <VALUE Lang="id">Padahal dia bukan orang yang menunjukkan rasa suka kepada siapa saja</VALUE>
    <VALUE Lang="id">Kamu sudah cukup memberikan kesan yang baik rupanya</VALUE>
    <VALUE Lang="cn">他上次是跑到哪儿去了？</VALUE>
    <VALUE Lang="cn">我得问清楚，搞明白。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_48_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_49_0">
    <VALUE Lang="GS">That's already standardized.</VALUE>
    <VALUE Lang="GS">Alright, confirmed. Please bring this to him, and he'll help you.</VALUE>
    <VALUE Lang="id">Segitu rupanya</VALUE>
    <VALUE Lang="id">Baiklah, saya akui</VALUE>
    <VALUE Lang="id">Beliau akan membantu kamu kalau kamu membawa tanda ini</VALUE>
    <VALUE Lang="id">Oh iya, saya hampir lupa hal yang penting</VALUE>
    <VALUE Lang="id">Beliau bukan kembar</VALUE>
    <VALUE Lang="cn">这样已经很标准了。好啦！您已经达成了，请把这个交给他，他会帮您忙的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_49_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_5_0">
    <VALUE Lang="GS">Firstly, I would like to make sure that students get familiar with Geography. Have you encountered the Cordies, Freezing Halogens, WereWolves, and Shadow Crows?</VALUE>
    <VALUE Lang="GS">Do you remember where they are located?</VALUE>
    <VALUE Lang="GS">I will give you 20 Minutes to locate them and collect a specimen of their saliva and feathers.</VALUE>
    <VALUE Lang="id">Pertama saya harus mengecek dulu seberapa dalam kamu memahami geographi</VALUE>
    <VALUE Lang="id">Rabis canine, Luminesce Canine, Were wolf, Shadow crow</VALUE>
    <VALUE Lang="id">Kamu ingatkan ada dimana keempat jenis ini?</VALUE>
    <VALUE Lang="id">Akan aku berikan waktu selama 20 menit</VALUE>
    <VALUE Lang="id">Tolong kumpulkan masing-masing sa</VALUE>
    <VALUE Lang="cn">首先，我想确认您的地理能力到哪个程度。您有遇过Cordy、Freezing Halogen、WereWolve、和Shadow Crow吗？</VALUE>
    <VALUE Lang="cn">给您20分钟，请找出牠们的位置，并收集牠们的唾液和羽毛。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_5_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_6_0">
    <VALUE Lang="GS">Yes! You brought them all?</VALUE>
    <VALUE Lang="GS">Thanks! It seems that you now know the locations of these creatures!</VALUE>
    <VALUE Lang="GS">You passed my First Test!</VALUE>
    <VALUE Lang="GS">Congratulations!</VALUE>
    <VALUE Lang="id">Euhm..sudah membawa semuanya rupanya.</VALUE>
    <VALUE Lang="id">Terimakasih atas kerja kerasnya.</VALUE>
    <VALUE Lang="id">Kamu sudah mengumpulkan EXP dasar rupanya</VALUE>
    <VALUE Lang="id">Tapi masih ada ujian yang tersisa kan</VALUE>
    <VALUE Lang="cn">哇！您都带来了吗？辛苦了！看来您很勤劳地在累积实力唷！您通过了我的第一个测验，恭喜您！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_6_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_7_0">
    <VALUE Lang="GS">Okay, that's all!</VALUE>
    <VALUE Lang="GS">Would you like to take the Second Test?</VALUE>
    <VALUE Lang="id">Nah, sedikit informasi hanya sampai sini</VALUE>
    <VALUE Lang="id">Mau memulai ujian yang ke dua?</VALUE>
    <VALUE Lang="cn">很好！这就是全部了。现在，要来进行第二场考试了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_7_0_2">
    <VALUE Lang="GS">Accept 2nd Test</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受第二道测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_7_0_3">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_8_0">
    <VALUE Lang="GS">Antony, Frankno, Salandu, Dalama, Aida, Panarol, Kalasanoya, Huianolu, Aima, Kanaauni!</VALUE>
    <VALUE Lang="GS">Do you know who they are?</VALUE>
    <VALUE Lang="id">Adonia, Biranno, Sarandoo, Daramai, Eida, Paranovo, Garansanoa, Heianor, Aiman, Zaghnaoh…</VALUE>
    <VALUE Lang="id">Nggak ngerti kan apa maksudnya?</VALUE>
    <VALUE Lang="cn">我要开始念了！</VALUE>
    <VALUE Lang="cn">Antony、Frankno、Salandu、Dalama、Aida、Panarol、Kalasanoya、Huianolu、Aima、Kanaauni！这些是什么，您知道吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_8_0_2">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_9_0">
    <VALUE Lang="GS">Was it difficult for you to find these Pills?</VALUE>
    <VALUE Lang="GS">Thanks a lot! You passed the 2nd Test!</VALUE>
    <VALUE Lang="id">Mudah mencarinya kan?</VALUE>
    <VALUE Lang="id">Menarik perhatiankan karena warnanya biru</VALUE>
    <VALUE Lang="id">Terimakasih atas kerja kerasnya.</VALUE>
    <VALUE Lang="cn">寻找Pills对您来说不难吧？</VALUE>
    <VALUE Lang="cn">非常谢谢您。您已经通过第2道关卡了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hong.ntk_9_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_0">
    <VALUE Lang="GS">How are you?</VALUE>
    <VALUE Lang="GS">You look so tired!</VALUE>
    <VALUE Lang="id">Selamat datang</VALUE>
    <VALUE Lang="id">Ini adalah Hot dog yang enak</VALUE>
    <VALUE Lang="cn">你好吗？看起来似乎很累。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_0_2">
    <VALUE Lang="GS">Ask about Problem</VALUE>
    <VALUE Lang="id">Bertanya ada apa?</VALUE>
    <VALUE Lang="cn">询问问题内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_0_3">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_1">
    <VALUE Lang="GS">Welcome!</VALUE>
    <VALUE Lang="GS">Would you like to buy some Hot Dogs?</VALUE>
    <VALUE Lang="id">Selamat datang</VALUE>
    <VALUE Lang="id">Maukah membeli Hot dog dari kami?</VALUE>
    <VALUE Lang="cn">欢迎光临！</VALUE>
    <VALUE Lang="cn">您想要买点Hot Dog吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_1_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_1_2">
    <VALUE Lang="GS">Ask about Lost Child</VALUE>
    <VALUE Lang="id">Bertanya tentang anak-anak yang hilang</VALUE>
    <VALUE Lang="cn">询问走失的孩子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2">
    <VALUE Lang="GS">How are you?</VALUE>
    <VALUE Lang="GS">You look so tired!</VALUE>
    <VALUE Lang="id">Aduh, gimana dong</VALUE>
    <VALUE Lang="cn">你好吗？看起来似乎很累。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2_1">
    <VALUE Lang="GS">Ask about Problem</VALUE>
    <VALUE Lang="id">Bertanya apa yang menjadi masalah</VALUE>
    <VALUE Lang="cn">询问问题内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2_4">
    <VALUE Lang="GS">Give the Food Ingredients</VALUE>
    <VALUE Lang="id">Menyerahkan bahan-bahan makanan</VALUE>
    <VALUE Lang="cn">交付食物的材料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_1_2_8">
    <VALUE Lang="GS">Ask about Lost Child</VALUE>
    <VALUE Lang="id">Bertanya tentang anak-anak yang hilang</VALUE>
    <VALUE Lang="cn">询问走失的孩子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_2_0">
    <VALUE Lang="GS">Hmm...</VALUE>
    <VALUE Lang="GS">All my food ingredients were stolen this morning.</VALUE>
    <VALUE Lang="GS">These ingredients are brought to this area every morning for our food preparations. Whoever did this to me must be planning to stir up trouble.</VALUE>
    <VALUE Lang="GS">Can you help me find those ingredients?</VALUE>
    <VALUE Lang="id">Iya…Pagi ini tiba-tiba bahan-bahan saya dicuri</VALUE>
    <VALUE Lang="id">Padahal itu bahan-bahan bagus yang dibeli waktu subuh</VALUE>
    <VALUE Lang="id">Mereka sengaja berbuat jahat untuk mengganggu orang-orang yang ada di sekitar sini</VALUE>
    <VALUE Lang="id">Maaf bisa tolong bantu saya mencarinya?</VALUE>
    <VALUE Lang="id">Gawat sekali kala</VALUE>
    <VALUE Lang="cn">是 今天早上材料突然都被偷走了</VALUE>
    <VALUE Lang="cn">清晨去买回来的好材料说</VALUE>
    <VALUE Lang="cn">一定是要骚扰附近的人才这样做</VALUE>
    <VALUE Lang="cn">不好意思可以帮我找吗</VALUE>
    <VALUE Lang="cn">没有材料麻烦大了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_2_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_2_0_6">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_3_0">
    <VALUE Lang="GS">Thank you!</VALUE>
    <VALUE Lang="GS">Once all the necessary ingredients are found, I'd be willing to give you complementary samples of my Hot Dogs as a token of my gratitude!</VALUE>
    <VALUE Lang="id">Terimakasih</VALUE>
    <VALUE Lang="id">Kalau kamu mencarikan bahan-bahannya</VALUE>
    <VALUE Lang="id">Yang akan saya berikan paling pertama kali adalah Hot dog yang terbuat dari bahan-bahan itu</VALUE>
    <VALUE Lang="cn">谢谢!!</VALUE>
    <VALUE Lang="cn">找到材料的话,我用那材料做的热狗,第一个就给您</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_4_0">
    <VALUE Lang="GS">Nice! Thanks a lot!</VALUE>
    <VALUE Lang="GS">I've got to repay you for your help…</VALUE>
    <VALUE Lang="GS">Wait here for just a bit.</VALUE>
    <VALUE Lang="GS">Here's a fresh Hot Dog! Please take it.</VALUE>
    <VALUE Lang="GS">Thank you so much!</VALUE>
    <VALUE Lang="id">Benar-benar terimakasih-</VALUE>
    <VALUE Lang="id">Hal seperti ini tidak boleh hanya ngomong saja kan?</VALUE>
    <VALUE Lang="id">Tunggu sebentar</VALUE>
    <VALUE Lang="id">Hot dog panas yang baru saja dimasak</VALUE>
    <VALUE Lang="cn">真是谢谢!!</VALUE>
    <VALUE Lang="cn">不能只用言语感谢</VALUE>
    <VALUE Lang="cn">请等我一下</VALUE>
    <VALUE Lang="cn">等下热腾腾的热狗</VALUE>
    <VALUE Lang="cn">来!请吃</VALUE>
    <VALUE Lang="cn">真是太感谢了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_5_0">
    <VALUE Lang="GS">Oh! The lost child?</VALUE>
    <VALUE Lang="GS">I don't know why the child disappeared. I just remember that child trying to buy some of my Hot Dogs. I am not really sure about it.</VALUE>
    <VALUE Lang="GS">I remember a group of people trying to find information regarding that lost child!</VALUE>
    <VALUE Lang="id">Euhm..begitu ternyata.</VALUE>
    <VALUE Lang="id">Entah sejak kapan tapi anak-anak yang selalu membeli hotdog mulai menghilang…</VALUE>
    <VALUE Lang="id">Saya juga kurang tahu</VALUE>
    <VALUE Lang="id">Kayaknya terakhir aku lihat mereka waktu mereka terlihat senang berkumpul untuk pergi ke gunung…</VALUE>
    <VALUE Lang="cn">嗯 是呀</VALUE>
    <VALUE Lang="cn">总是要我去买热狗回来的孩子不知何时不见了</VALUE>
    <VALUE Lang="cn">实在是不清楚</VALUE>
    <VALUE Lang="cn">几个聚在一起要去附近的山上看喜欢的东西那是最后一次的样子</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_hotdog1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0">
    <VALUE Lang="GS">Welcome!</VALUE>
    <VALUE Lang="GS">Would you like to try our delicious Ice Cream?</VALUE>
    <VALUE Lang="id">Selamat datang. Ini adalah ice cream yang enak</VALUE>
    <VALUE Lang="cn">欢迎光临！</VALUE>
    <VALUE Lang="cn">您要试试看我们的美味Ice Cream吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_10">
    <VALUE Lang="GS">Give the Bottles</VALUE>
    <VALUE Lang="id">Menyerahkan botol kaca</VALUE>
    <VALUE Lang="cn">谢谢您，现在我终于可以开公车载学生上下学了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_11">
    <VALUE Lang="GS">Deliver Dry Ice</VALUE>
    <VALUE Lang="id">Menyerahkan dry ice</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_7">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_8">
    <VALUE Lang="GS">Ask about Ice Cream Stall</VALUE>
    <VALUE Lang="id">Bertanya tentang ice cream</VALUE>
    <VALUE Lang="cn">询问关于 Ice Cream 摊贩的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_1_0_9">
    <VALUE Lang="GS">Collect Recyclable Bottles</VALUE>
    <VALUE Lang="id">Bersuka rela untuk mengumpulkan botol kaca yang bisa didaur ulang</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_10_0">
    <VALUE Lang="GS">.....6</VALUE>
    <VALUE Lang="id">.....6</VALUE>
    <VALUE Lang="cn">.....6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_11_0">
    <VALUE Lang="GS">Oh yes!</VALUE>
    <VALUE Lang="GS">I'm just a part-timer here, so I'm ashamed to say I don't really know much. I'm fairly confident, though, when it comes to food businesses like coffee and desserts.</VALUE>
    <VALUE Lang="id">Ah, iya…</VALUE>
    <VALUE Lang="id">Euh, sebenarnya pekerjaan ini hanya paruh waktu</VALUE>
    <VALUE Lang="id">Malu tapi saya juga tidak tahu banyak</VALUE>
    <VALUE Lang="id">Tapi saya cukup ahli tentang kopi?</VALUE>
    <VALUE Lang="cn">噢是的。我只是工读生，说来羞愧，我懂得其实不多。不过，谈到食品业，例如咖啡甜点，我有着十足的信心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_11_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_12_0">
    <VALUE Lang="GS">I can really make good coffee! If everything goes along fine, I want to run my own coffee shop.</VALUE>
    <VALUE Lang="GS">It's sad to see the city in upheaval like this.</VALUE>
    <VALUE Lang="id">Saya tahu setidaknya 77 cara untuk membuat kopi</VALUE>
    <VALUE Lang="id">Kalau saya sudah cukup ahli kerja paruh waktu tadinya mau membuka kafe sendiri…</VALUE>
    <VALUE Lang="id">Saya khawatir kalau suasana kota sudah kacau seperti ini akan sulit untuk melakukannya</VALUE>
    <VALUE Lang="cn">我能煮很棒的咖啡！情况稳定之后，我想要经营一家属于我自己的咖啡店。</VALUE>
    <VALUE Lang="cn">看到城市变成这样，我感到非常地难过。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_12_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_13_0">
    <VALUE Lang="GS">Recycling work is difficult, you know?</VALUE>
    <VALUE Lang="GS">That's why we try our very best to help out!</VALUE>
    <VALUE Lang="id">Ah, kalau dipikir-pikir akhir-akhir ini pengumpulan item-item daur ulang juga sedikit terhambat karena jumlah warga yang terus berkurang</VALUE>
    <VALUE Lang="id">Karena itu kami juga sedang membantu</VALUE>
    <VALUE Lang="cn">资源回收不简单。 这也是为什么我们需要大家一起来做的原因。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_13_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_14_0">
    <VALUE Lang="GS">Oh, thank you.</VALUE>
    <VALUE Lang="GS">That was fast!</VALUE>
    <VALUE Lang="GS">I thought we'd run out of stuff to recycle, so I went around asking for help.</VALUE>
    <VALUE Lang="GS">Anyway, I won't need to worry about it for a while since you already brought plenty of recyclable trash!</VALUE>
    <VALUE Lang="id">Eh, terimakasih</VALUE>
    <VALUE Lang="id">Benar-benar cepat yah!</VALUE>
    <VALUE Lang="id">Kemarin saya meminta bantuan karena kayaknya akan kurang eh hari ini sudah diantarkan lagi...</VALUE>
    <VALUE Lang="id">Untuk beberapa lama kamu tidak akan khawatir</VALUE>
    <VALUE Lang="cn">哎呀！谢谢您！真快！我以为会不够用，所以又申请了一次。总之，托您的福，我可以高枕无忧好一阵子了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_14_0_1">
    <VALUE Lang="GS">Begin</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_2_0">
    <VALUE Lang="GS">Oh yes!</VALUE>
    <VALUE Lang="GS">I'm just a part-timer here, so I'm ashamed to say I don't really know much. I'm fairly confident, though, when it comes to food businesses like coffee and desserts.</VALUE>
    <VALUE Lang="GS">I can really make good coffee! If everything goes along fine, I want to run my own coffee shop.</VALUE>
    <VALUE Lang="GS">It's sad to see the city in upheaval like this. Part of our contribution to help whittle down the chaos is by promoting recycling.</VALUE>
    <VALUE Lang="GS">It's very difficult, and that's why we need the community to help. Would you be willing to collect recyclable trash to earn some Ice Cream?</VALUE>
    <VALUE Lang="id">Iya…Pagi ini tiba-tiba bahan-bahan saya dicuri</VALUE>
    <VALUE Lang="id">Padahal itu bahan-bahan bagus yang dibeli waktu subuh</VALUE>
    <VALUE Lang="id">Mereka sengaja berbuat jahat untuk mengganggu orang-orang yang ada di sekitar sini</VALUE>
    <VALUE Lang="id">Maaf bisa tolong bantu saya mencarinya?</VALUE>
    <VALUE Lang="id">Gawat sekali kala</VALUE>
    <VALUE Lang="cn">噢是的。我只是工读生，说来羞愧，我懂得其实不多。不过，谈到食品业，例如咖啡甜点，我有着十足的信心。我能煮很棒的咖啡！情况稳定之后，我想要经营一家属于我自己的咖啡店。</VALUE>
    <VALUE Lang="cn">看到城市变成这样，我感到非常地难过。为了减少混乱现象，我们可以贡献的部分就是促进资源回收。</VALUE>
    <VALUE Lang="cn">这不简单。 这也是为什么我们需要大家一起来做的原因。您愿意一起收集“可回收的垃圾”，并交换好吃的 Ice Cream吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_2_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接收请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_2_0_6">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_3_0">
    <VALUE Lang="GS">고마워요</VALUE>
    <VALUE Lang="GS">재료를 찾아주시면</VALUE>
    <VALUE Lang="GS">그 재료로 만든 핫도그는 제일 처음 드릴께요</VALUE>
    <VALUE Lang="id">고마워요</VALUE>
    <VALUE Lang="id">재료를 찾아주시면</VALUE>
    <VALUE Lang="id">그 재료로 만든 핫도그는 제일 처음 드릴께요</VALUE>
    <VALUE Lang="cn">고마워요</VALUE>
    <VALUE Lang="cn">재료를 찾아주시면</VALUE>
    <VALUE Lang="cn">그 재료로 만든 핫도그는 제일 처음 드릴께요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_icecream_1.ntk_4_0">
    <VALUE Lang="GS">정말 고마워요-</VALUE>
    <VALUE Lang="GS">이런거 그냥 말로만 해서는 안되겠죠?</VALUE>
    <VALUE Lang="GS">잠깐만 기다리세요</VALUE>
    <VALUE Lang="GS">금방 따끈한 핫도그를...</VALUE>
    <VALUE Lang="GS">자, 여기 드세요</VALUE>
    <VALUE Lang="GS">정말 고마웠어요-</VALUE>
    <VALUE Lang="id">정말 고마워요-</VALUE>
    <VALUE Lang="id">이런거 그냥 말로만 해서는 안되겠죠?</VALUE>
    <VALUE Lang="id">잠깐만 기다리세요</VALUE>
    <VALUE Lang="id">금방 따끈한 핫도그를...</VALUE>
    <VALUE Lang="id">자, 여기 드세요</VALUE>
    <VALUE Lang="id">정말 고마웠어요-</VALUE>
    <VALUE Lang="cn">정말 고마워요-</VALUE>
    <VALUE Lang="cn">이런거 그냥 말로만 해서는 안되겠죠?</VALUE>
    <VALUE Lang="cn">잠깐만 기다리세요</VALUE>
    <VALUE Lang="cn">금방 따끈한 핫도그를...</VALUE>
    <VALUE Lang="cn">자, 여기 드세요</VALUE>
