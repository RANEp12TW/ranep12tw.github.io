    <VALUE Lang="id">Tukar dengan 9th Grade of Spirit Sphere</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_10_0">
    <VALUE Lang="GS">Which skill do you want to learn out of the skills of Grade 10?</VALUE>
    <VALUE Lang="cn">您想学习哪个10等级的技能呢?</VALUE>
    <VALUE Lang="id">Skill apa yang ingin kamu pelajari dengan spheres 10?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_10_0_2"><VALUE Lang="tw">兌換 沉陷突擊（97級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Sunken Strike (Lv97, Class=130, Item=175/7)</VALUE><VALUE Lang="id">Skill book: Sunken Strike (Lv97, Class=130, Item=175/7)</VALUE><VALUE Lang="cn">Skill book: Sunken Strike (Lv97, Class=130, Item=175/7)</VALUE><VALUE Lang="th">Skill book: Sunken Strike (Lv97, Class=130, Item=175/7)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_10_0_3"><VALUE Lang="tw">兌換 迴旋斬（97級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Revolving Slash (Lv97, Class=130, Item=175/27)</VALUE><VALUE Lang="id">Skill book: Revolving Slash (Lv97, Class=130, Item=175/27)</VALUE><VALUE Lang="cn">Skill book: Revolving Slash (Lv97, Class=130, Item=175/27)</VALUE><VALUE Lang="th">Skill book: Revolving Slash (Lv97, Class=130, Item=175/27)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_10_0_4"><VALUE Lang="tw">兌換 憤怒劍氣（97級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Indignation (Lv97, Class=130, Item=175/47)</VALUE><VALUE Lang="id">Skill book: Indignation (Lv97, Class=130, Item=175/47)</VALUE><VALUE Lang="cn">Skill book: Indignation (Lv97, Class=130, Item=175/47)</VALUE><VALUE Lang="th">Skill book: Indignation (Lv97, Class=130, Item=175/47)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_11_0">
