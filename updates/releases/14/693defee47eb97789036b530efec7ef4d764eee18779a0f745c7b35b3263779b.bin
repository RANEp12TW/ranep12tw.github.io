  <SENTENSE Ver="1" Id="npc_1_t_t_master1.ntk_80_0">
    <VALUE Lang="GS">The School Principal used a strange material to create the Force Field. It's almost unbelievable, but it really has amazing effects!</VALUE>
    <VALUE Lang="id">Coba bawakan dua buah Cigarette Butts yang diisap oleh para Little Hooligan di depan sini</VALUE>
    <VALUE Lang="cn">社长用那些奇怪的东西造结界的时候, 还半信半疑, 原来真的有此惊人效果啊!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_t_master1.ntk_80_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_t_master1.ntk_81_0">
    <VALUE Lang="GS">.......</VALUE>
