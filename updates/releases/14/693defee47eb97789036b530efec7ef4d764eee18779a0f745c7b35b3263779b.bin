    <VALUE Lang="GS">Seung Hee Yoon's Test</VALUE>
    <VALUE Lang="id">Seung Hee Yoon's Test</VALUE>
    <VALUE Lang="cn">Seung Hee Yoon的考验</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_1_0_3">
