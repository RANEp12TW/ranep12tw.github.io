    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_1_0">
    <VALUE Lang="GS">This Terminal controls the entrance and exit to the Science Center.</VALUE>
    <VALUE Lang="id">Terminal Science Center</VALUE>
    <VALUE Lang="id">Mengatur akses keluar masuk Science Center</VALUE>
    <VALUE Lang="cn">这个终端机掌控着 Science Center 的入口机能。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_1_0_1">
    <VALUE Lang="GS">Confirm Activation</VALUE>
    <VALUE Lang="id">Konfirmasi pengaktifan</VALUE>
    <VALUE Lang="cn">确认激活</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_1_0_2">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_1_0_3">
    <VALUE Lang="GS">Test the Terminal</VALUE>
    <VALUE Lang="id">Ujian di Terminal</VALUE>
    <VALUE Lang="cn">终端机测试</VALUE>
  </SENTENSE>
