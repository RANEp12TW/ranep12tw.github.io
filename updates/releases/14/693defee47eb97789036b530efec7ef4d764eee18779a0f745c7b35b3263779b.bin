  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_3_0">
    <VALUE Lang="GS">The Terminal's Force Field mechanism is functioning properly.</VALUE>
    <VALUE Lang="GS">You'll need 9 Spiritual Spheres to optimize this Terminal's Force Field function.</VALUE>
    <VALUE Lang="id">Pengoperasian Force Field di Terminal berfungsi secara normal</VALUE>
    <VALUE Lang="id">Untuk mendapatkan hasil dari autentikasi Force Field kumpulkanlah Spiritual Spheres. Dibutuhkan 9 buah</VALUE>
    <VALUE Lang="cn">终端机的结界机能正常运作中。您需要9颗灵珠才能通过认证，并得到结界的能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
