    <VALUE Lang="GS">다음으로</VALUE>
    <VALUE Lang="id">다음으로</VALUE>
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_8_0_2">
    <VALUE Lang="GS">처음으로</VALUE>
    <VALUE Lang="id">처음으로</VALUE>
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_9_0">
    <VALUE Lang="GS">구슬이 어떻게 만들어졌는지는 모르지만, 어느정도의 힘을 증명하는 것 같아요</VALUE>
    <VALUE Lang="GS">그래서 영령구슬을 가져가면 지도선생님들께서 등급에 맞는 스킬문서로 교환해 주시죠</VALUE>
    <VALUE Lang="id">구슬이 어떻게 만들어졌는지는 모르지만, 어느정도의 힘을 증명하는 것 같아요</VALUE>
    <VALUE Lang="id">그래서 영령구슬을 가져가면 지도선생님들께서 등급에 맞는 스킬문서로 교환해 주시죠</VALUE>
    <VALUE Lang="cn">구슬이 어떻게 만들어졌는지는 모르지만, 어느정도의 힘을 증명하는 것 같아요</VALUE>
    <VALUE Lang="cn">그래서 영령구슬을 가져가면 지도선생님들께서 등급에 맞는 스킬문서로 교환해 주시죠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_9_0_1">
    <VALUE Lang="GS">다음으로</VALUE>
    <VALUE Lang="id">다음으로</VALUE>
    <VALUE Lang="cn">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_9_0_2">
    <VALUE Lang="GS">처음으로</VALUE>
    <VALUE Lang="id">처음으로</VALUE>
    <VALUE Lang="cn">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0">
    <VALUE Lang="GS">Hah.. Hah..</VALUE>
    <VALUE Lang="id">Ha…ha…ha….</VALUE>
    <VALUE Lang="cn">哈哈……啊哈哈哈！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_1">
    <VALUE Lang="GS">Ask if she is a friend of Garansanoa</VALUE>
    <VALUE Lang="id">Bertanya apakah Anda temannya Garansanoa</VALUE>
    <VALUE Lang="cn">询问她是Garansanoa的同伴吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_10">
    <VALUE Lang="GS">Hand over the Tear of Ganil</VALUE>
    <VALUE Lang="id">Menberikan Tear of Ganil</VALUE>
    <VALUE Lang="cn">交付Tear of Ganil！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_11">
    <VALUE Lang="GS">Exchange Vigor of Warrior to Heart of Warrior</VALUE>
    <VALUE Lang="id">Menukarkan 'Vigor of Warrior' dengan 'Heart of Warrior'</VALUE>
    <VALUE Lang="cn">用 Vigor of Warrior换取 Heart of Warrior。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_12">
    <VALUE Lang="GS">Ask how to get to Another World</VALUE>
    <VALUE Lang="id">Bertanya bagaimana cara pergi ke Another World</VALUE>
    <VALUE Lang="cn">询问前往异界的方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_13">
    <VALUE Lang="GS">Hand over the Magical Spirit Stone</VALUE>
    <VALUE Lang="id">Memberikan Soulstone of Magic Spell</VALUE>
    <VALUE Lang="cn">把Magical Spirit Stone交给我吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_14">
    <VALUE Lang="GS">Exchange Heart of Warrior to Spirit of Warrior</VALUE>
    <VALUE Lang="id">Menukarkan 'Heart of Warrior' dengan 'Spirit of Warrior'</VALUE>
    <VALUE Lang="cn">用Heart of Warrior换取 Spirit of Warrior。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_2">
    <VALUE Lang="GS">Ask what brought her down here</VALUE>
    <VALUE Lang="id">Bertanya kenapa berada di bawah tanah</VALUE>
    <VALUE Lang="cn">为什么要到地下室来?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_3">
    <VALUE Lang="GS">Ask how to stop Lucian</VALUE>
    <VALUE Lang="id">Bertanya bagaimana cara menghadapi Lucian</VALUE>
    <VALUE Lang="cn">询问打败Lucian的方法。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_4">
    <VALUE Lang="GS">Hand over the orb</VALUE>
    <VALUE Lang="id">Memberikan Sphere</VALUE>
    <VALUE Lang="cn">把珠子Orb给我吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_5">
    <VALUE Lang="GS">Ask about Gainun</VALUE>
    <VALUE Lang="id">Bertanya tentang Gainun</VALUE>
    <VALUE Lang="cn">询问关于Gainun的事情。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_6">
    <VALUE Lang="GS">Tell her what happened with Gainun</VALUE>
    <VALUE Lang="id">Berbicara sesuatu yang berhubungan dengan Gainun</VALUE>
    <VALUE Lang="cn">告诉她Gainun发生了什么事情。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_7">
    <VALUE Lang="GS">Ask if she needs any help</VALUE>
    <VALUE Lang="id">Bertanya tentang tugas yang yang dikerjakan</VALUE>
    <VALUE Lang="cn">有要帮忙的吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_8">
    <VALUE Lang="GS">Deliver Garansanoa's message</VALUE>
    <VALUE Lang="id">Menyampaikan pesan dari Garansanoa</VALUE>
    <VALUE Lang="cn">转达Garansanoa的讯息</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_9">
    <VALUE Lang="GS">Ask if she needs any help</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">有要帮忙的吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_10_0">
    <VALUE Lang="GS">It's wouldn't be that easy as it may seem.. Take good care of the relic called Vigor of Warrior which I gave you.</VALUE>
    <VALUE Lang="id">Sepertinya tidak mudah… simpan baik-baik Vigor of Warrior yang aku kasih ya..</VALUE>
    <VALUE Lang="cn">不简单阿..给你勇士意志的遗物希望你能好好珍藏</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_10_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_11_0">
    <VALUE Lang="GS">There is a Gate which is connected to our world.. But time is not right yet and no one can crossover now.. Anyways, there will be Gainun in front of that gate, guarding.. He has been tricked by Lucian and will attack as soon as he finds you so be carful.. I wish you can talk to him..</VALUE>
    <VALUE Lang="id">Disini ada satu pintu masuk ke duniaku… sekarang belum waktunya jadi kamu belum bisa masuk, disana di depan pintu ada orang yang bernama Gainun..berhati-hatilah karena mungkin dia akan menyerang duluan… atau kalau bisa bercakap malah lebih bagus</VALUE>
    <VALUE Lang="cn">在这里有一扇通往我们世界的门吧…时候还未到还不能通过但是在门前面有一位叫做Gainun的人。他被Lucian给欺骗了，并且当Lucian发现您时也会主动采取攻击。请小心。我希望您可以跟Gainun聊聊。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_11_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_12_0">
    <VALUE Lang="GS">Tell Garansanoa that Lucian is after Adoniechus and also Gainun is guarding the Gate to Daramai..</VALUE>
    <VALUE Lang="id">Sampaikan pesan kepada Garansanoa bahwa Lucian sedang terobsesi memperoleh Adoniechus. Gainun sedang menjaga pintu menuju Daramai..dia ada disana</VALUE>
    <VALUE Lang="cn">跟Garansanoa说 Lucian已经虎视眈眈觊觎绝对起点了。</VALUE>
    <VALUE Lang="cn">Gainun正在看守前往Daramai的门。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_12_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_13_0">
    <VALUE Lang="GS">When will they be coming.. I don't think I can hold this place much longer by myself..</VALUE>
    <VALUE Lang="id">kesini lagikan?...kalau aku sendirian sulit sekali</VALUE>
    <VALUE Lang="cn">只靠我的力量很辛苦，他们什么时候会到达？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_13_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_14_0">
    <VALUE Lang="GS">Adoniechus is getting unstable every second. Usually I would do it myself, if not for the wound but.. So what I am saying is that, would you please go get Tear of Ganil from Arc and Cannon Buster.</VALUE>
    <VALUE Lang="id">Kondisi Adoniechus semakin tidak terkendali, seandainya saja aku tidak terluka… mungkin kondisinya akan berbeda. Tolong mintakan Tear of Ganil kepada Arc dan Buster Cannon</VALUE>
    <VALUE Lang="cn">Adoniechus绝对起点变的不安定了。如果不是负伤的话，以我的力量可能可以击败的… 把Arc 和Cannon Buste身上的眼泪带来吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_14_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_15_0">
    <VALUE Lang="GS">Let me make the Vigor of Warrior into a more powerful relic. Unleash the necklace from your neck. Tell me when you are ready.</VALUE>
    <VALUE Lang="id">Akan aku ubah 'Vigor of Warrior' menjadi pusaka yang lebih kuat. Lepaskan kalung dari leher kamu dan bilang kalau sudah siap.</VALUE>
    <VALUE Lang="cn">做一个比勇士的运气还要强的遗物给你。希望解开脖子上的项链。准备好的话跟我说一声吧!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_15_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_15_0_2">
    <VALUE Lang="GS">Tell her you are ready.</VALUE>
    <VALUE Lang="id">Sudah siap</VALUE>
    <VALUE Lang="cn">准备好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_16_0">
    <VALUE Lang="GS">You will need the relic called Spirit of Warrior which every one of our friends wear.. Must be able to make you one too.. Go take the Magical Spirit Stone from Gainun. Remember, you must dominate him first.</VALUE>
    <VALUE Lang="id">Untuk membuatnya dibutuhkan Spirit of Warrior yang aku miliki dan teman-temanku. Kalau kamu bisa mengambil satu dari Gainun</VALUE>
    <VALUE Lang="cn">我们的同伴需要各自拥有勇士的灵魂的遗物…也要做一个给你..把Gainun的Magical Spirit Stone带来吧！记住，一定要制伏之后把它带来才可以。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_16_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_17_0">
    <VALUE Lang="GS">Let me make the Heart of Warrior into a Spirit of Warrior. Unleash the necklace from your neck. Tell me when you are ready.</VALUE>
    <VALUE Lang="id">Akan aku ubah 'Heart of Warrior' menjadi 'Spirit of Warrior'. Lepaskan kalung dari leher kamu dan bilang kalau sudah siap.</VALUE>
    <VALUE Lang="cn">用勇士的灵魂做成勇士的心脏给你。想要解开脖子的项链。准备好的话跟我说一声吧</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_17_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_17_0_2">
    <VALUE Lang="GS">Tell her you are ready.</VALUE>
    <VALUE Lang="id">Sudah siap</VALUE>
    <VALUE Lang="cn">准备好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_18_0">
    <VALUE Lang="GS">What a brutal fate she has..</VALUE>
    <VALUE Lang="id">Nasibnya…sungguh tragis…</VALUE>
    <VALUE Lang="cn">真惨…那女孩的命运..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_18_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_2_0">
    <VALUE Lang="GS">I am Gransanoa's friend but would you plaese introduce yourself first?</VALUE>
    <VALUE Lang="id">Iya aku adalah temannya Garansanoa, kamu siapa?</VALUE>
    <VALUE Lang="cn">我跟Gransanoa是同伴…但可以先请您自我介绍吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_2_0_1">
    <VALUE Lang="GS">Introduce yourself</VALUE>
    <VALUE Lang="id">Memperkenalkan diri</VALUE>
    <VALUE Lang="cn">自我介绍</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_3_0">
    <VALUE Lang="GS">Oh, you are from this world.. Sorry.. I guess I am a bit too edgy, going through so many different things.. I'm Liz.</VALUE>
    <VALUE Lang="id">Aa..ternyata kamu manusia… maaf karena disini banyak keanehan, aku kira kamu bukan…ha..ha kamu bisa panggil aku Ace</VALUE>
    <VALUE Lang="cn">噢！是异族世界的人..对不起，太多事情混淆了神经变敏感了..哈哈..就叫我 Liz 吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_3_0_1">
    <VALUE Lang="GS">Ask if she is feeling alright</VALUE>
    <VALUE Lang="id">Bertanya apakah sedang sakit</VALUE>
    <VALUE Lang="cn">问她现在还好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_4_0">
    <VALUE Lang="GS">Well you blush me by worrying about me but don't worry! Thank You! Anyways, I guess you are strong since you have made it to here. You must have scared the traitor away.</VALUE>
    <VALUE Lang="id">Kamu sampai mengkhawatirkan aku seperti ini…aku jadi malu. Tapi tidak apa-apa…terima kasih. Ternyata kamu hebat ya, bisa sampai tempat seperti ini. Pasti banyak rintangankan?</VALUE>
    <VALUE Lang="cn">让你担心了真是不好意思..其实也不用担心。谢谢你。不过你还真厉害能来到这里，你已经摆脱胆小的个性了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_4_0_1">
    <VALUE Lang="GS">Tell her it was a piece of cake</VALUE>
    <VALUE Lang="id">Menjawab datang dengan mudah</VALUE>
    <VALUE Lang="cn">非常简单！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_5_0">
    <VALUE Lang="GS">Whew.. It was easy, huh? In about one hour Lucian will appear again. Please eliminate him again.</VALUE>
    <VALUE Lang="id">karena sudah banyak beristirahat…. Satu jam lagi Lucian pasti datang</VALUE>
    <VALUE Lang="cn">噗..很容易吧！大约再过一小时Lucian会再出现的！到时候再拜托您唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_5_0_1">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">…………..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_6_0">
    <VALUE Lang="GS">After our party had been separated, Garansanoa, Gainun and me have came to this place. I knew it then.. There are two of very important things located here in this basement.</VALUE>
    <VALUE Lang="id">Sejak aku dan teman-temanku Garansanoa dan Gainun terpisah, kami bertiga terdampar disini. Waktu itu kami berhasil menemukan dua jenis item yang sangat penting…</VALUE>
    <VALUE Lang="cn">我们和同伴走散后，Garansanoa、Gainun和我三个人来到这个地方。这个时候发现了两个重要的物品在地下室…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_6_0_1">
    <VALUE Lang="GS">Ask why Lucian is hostile</VALUE>
    <VALUE Lang="id">Bertanya kenapa Lucian terus menyerang</VALUE>
    <VALUE Lang="cn">询问Lucian为何如此带着敌意？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_7_0">
    <VALUE Lang="GS">Isn't it obvious what the ambitious man would want? Power! Obsession for the things that could help enlarge the power! The eagerness to own the Adoniechus..</VALUE>
    <VALUE Lang="id">Mungkin karena dia punya ambisi yang besar. Salah satunya adalah obesi untuk memperoleh item yang bisa mejadikannya lebih kuat… menuju Adoniechus</VALUE>
    <VALUE Lang="cn">拥有野心的男生想要的东西不就是拥有更强大的力量吗!侦查探索可以让自己力量变更强大的东西!那个东西就是绝对起点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_7_0_1">
    <VALUE Lang="GS">Ask about Adoniechus</VALUE>
    <VALUE Lang="id">Bertanya tentang Adoniechus</VALUE>
    <VALUE Lang="cn">问问看有关Adoniechus绝对起点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_8_0">
    <VALUE Lang="GS">Adoniechus is the center of the world where all the powers gather and also where all the powers of the world was created. In the world where you came from it is call the absolute point.</VALUE>
    <VALUE Lang="id">Adoniechus adalah pusatnya dunia, termpat terkumpulnya kekuatan, banyak orang menyebutnya sebagai awal mula kekuatan di dunia ini muncul..</VALUE>
    <VALUE Lang="cn">绝对起点是集结世界中心所有力量的地方，也是世界上所有事情的发源地。这个地方就叫做是绝对起点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_8_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_9_0">
    <VALUE Lang="GS">Lucian carries 5 mysterious orbs on him all the time. If anybody is able to take those five orbs from Lucian, he or she will be able to make a relic and go against him.</VALUE>
    <VALUE Lang="id">Di tubuh Lucian terdapat 5 kekuatan Sphere mistik. Kalau kamu bisa merebutnya, kamu bisa memperoleh kekuatan untuk melawanya</VALUE>
    <VALUE Lang="cn">Lucian身上带着5个神秘的珠子，如果有人去抢他的5项宝物，她将会尽全力去抵抗。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_9_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0">
    <VALUE Lang="GS">What's up?? I can't help you, anything</VALUE>
    <VALUE Lang="id">Mau ngomong apa?</VALUE>
    <VALUE Lang="id">Kalau kesini mau minta tolong, sebenarnya aku ngga bisa bantu banyak.</VALUE>
    <VALUE Lang="cn">怎么了？我已经无法再继续帮您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_1">
    <VALUE Lang="GS">Open Shop</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">开启商店</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_10">
    <VALUE Lang="GS">Exchange Mesil Potion</VALUE>
    <VALUE Lang="id">Menukar Mesil Potion</VALUE>
    <VALUE Lang="cn">兑换Mesil Potion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_11">
    <VALUE Lang="GS">Exchange 16 Spiritual Spheres</VALUE>
    <VALUE Lang="id">Menukar 16 Spiritual Spheres</VALUE>
    <VALUE Lang="cn">兑换16 灵珠</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_12">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_13">
    <VALUE Lang="GS">Show her the Design</VALUE>
    <VALUE Lang="id">Memperlihatkan Design</VALUE>
    <VALUE Lang="cn">给她看设计图</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_14">
    <VALUE Lang="GS">Hand over the Code Decoder</VALUE>
    <VALUE Lang="id">Memberikan Decoder</VALUE>
    <VALUE Lang="cn">交付解码器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_15">
    <VALUE Lang="GS">Show her the Letter of Introduction</VALUE>
    <VALUE Lang="id">Memperlihatkan Recommendation Letter</VALUE>
    <VALUE Lang="cn">把指令书信交给她</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_16">
    <VALUE Lang="GS">Tell her you need a Ring</VALUE>
    <VALUE Lang="id">Membutuhkan cincin</VALUE>
    <VALUE Lang="cn">告诉她您需要一个戒指</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_17">
    <VALUE Lang="GS">Hand over the Design you found</VALUE>
    <VALUE Lang="id">Memberikan Design yang sudah diperoleh</VALUE>
    <VALUE Lang="cn">请将您找到的设计图交给她</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_18">
    <VALUE Lang="GS">Tell her you need a Necklace</VALUE>
    <VALUE Lang="id">Membutuhkan kalung</VALUE>
    <VALUE Lang="cn">告诉她您需要一个项链</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_19">
    <VALUE Lang="GS">Hand over the Design you found</VALUE>
    <VALUE Lang="id">Memberikan Design yang sudah diperoleh</VALUE>
    <VALUE Lang="cn">请将您找到的设计图交给她</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_2">
    <VALUE Lang="GS">listen a story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_20">
    <VALUE Lang="GS">Ask her about weapon remodeling</VALUE>
    <VALUE Lang="id">Bertanya tentang Reformed Weapon</VALUE>
    <VALUE Lang="cn">向她询问武器改造一事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_21">
    <VALUE Lang="GS">Hand over the collected materials</VALUE>
    <VALUE Lang="id">Memberikan bahan yang sudah dikumpulkan</VALUE>
    <VALUE Lang="cn">将收集到的材料交给她</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_22">
    <VALUE Lang="GS">Tell her you want a better ring.</VALUE>
    <VALUE Lang="id">Ingin cincin yang lebih bagus</VALUE>
    <VALUE Lang="cn">告诉她您需要一个更好的戒指</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_23">
    <VALUE Lang="GS">Hand over the carving cord</VALUE>
    <VALUE Lang="id">Memberikan Carving Cord</VALUE>
    <VALUE Lang="cn">请将加工线交给她</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_24">
    <VALUE Lang="GS">Ask her to make you a weapon</VALUE>
    <VALUE Lang="id">Minta tolong dibuatkan senjata</VALUE>
    <VALUE Lang="cn">请她制作一个武器给您</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_25">
    <VALUE Lang="GS">Hand over the collected materials</VALUE>
    <VALUE Lang="id">Memberikan bahan yang sudah dikumpulkan</VALUE>
    <VALUE Lang="cn">请将收集到的材料交给她</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_26">
    <VALUE Lang="GS">Ask her about the Oblivion Potion</VALUE>
    <VALUE Lang="id">Bertanya tentang Oblivion potion</VALUE>
    <VALUE Lang="cn">向她询问忘却药水的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_27">
    <VALUE Lang="GS">Hand over the ingredients of Oblivion Potion</VALUE>
    <VALUE Lang="id">Menyampaikan bahan untuk membuat Oblivion Potion</VALUE>
    <VALUE Lang="cn">交付忘却药水的材料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_28">
    <VALUE Lang="GS">Ask her if she does not have any friend</VALUE>
    <VALUE Lang="id">Bertanya apakah punya teman</VALUE>
    <VALUE Lang="cn">询问她是否没朋友</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_29">
    <VALUE Lang="GS">Deliver Tarsan's letter</VALUE>
    <VALUE Lang="id">Menyampaikan surat dari Jinsan</VALUE>
    <VALUE Lang="cn">传达Tarsan的信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_3">
    <VALUE Lang="GS">Mixing 'Ganil Powder' to 'Ganil Piece'</VALUE>
    <VALUE Lang="id">Membuat 'Ganil Powder' menjadi 'Ganil Piece'</VALUE>
    <VALUE Lang="cn">请将'Ganil Powder' 混入'Ganil Piece'里面。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_30">
    <VALUE Lang="GS">Hear her story</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取她的故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_31">
    <VALUE Lang="GS">Tell her you want a reformed weapon</VALUE>
    <VALUE Lang="id">Ingin mendapatkan Reformed Weapon</VALUE>
    <VALUE Lang="cn">告诉她您想要改造武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_32">
    <VALUE Lang="GS">Tell her you want a weapon</VALUE>
    <VALUE Lang="id">Ingin medapatkan senjata</VALUE>
    <VALUE Lang="cn">告诉她您需要武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_4">
    <VALUE Lang="GS">Mixing 'Bail Powder' to 'Bail Piece'</VALUE>
    <VALUE Lang="id">Membuat 'Bail Powder' menjadi 'Bail Piece'</VALUE>
    <VALUE Lang="cn">请将'Bail Powder'混入'Bail Piece'里面。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_8">
    <VALUE Lang="GS">Pass the research information.</VALUE>
    <VALUE Lang="id">Menyampaikan hasil penelitian</VALUE>
    <VALUE Lang="cn">传达研究资料。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_1_0_9">
    <VALUE Lang="GS">Listen Conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_10_0">
    <VALUE Lang="GS">I do have basic parts.I am warning you in advance, don't ask for it for free.</VALUE>
    <VALUE Lang="GS">I like a person who is precise about calculation.</VALUE>
    <VALUE Lang="id">Aku punya sedikit genuine part tapi yang standar saja.</VALUE>
    <VALUE Lang="id">Aku kasih tahu…ini tidak cuma-cuma dibagikan</VALUE>
    <VALUE Lang="id">aku benci orang yang suka gratisan</VALUE>
    <VALUE Lang="cn">我真的有基本的配备。我先警告您唷。不准要求免费！</VALUE>
    <VALUE Lang="cn">我喜欢精打细算的人。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_10_0_1">
    <VALUE Lang="GS">Ask her where other parts are</VALUE>
    <VALUE Lang="id">Bertanya dimana genuine part lainnya</VALUE>
    <VALUE Lang="cn">询问她其他的零件在哪儿？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_11_0">
    <VALUE Lang="GS">Those in the basement must be at where they were, right?</VALUE>
    <VALUE Lang="GS">Yes, I have heard that story.</VALUE>
    <VALUE Lang="GS">Close acquaintance of mine saw unidentified assailants having the parts..</VALUE>
    <VALUE Lang="GS">Solidified stone can teleport materials and I believe that it must have went missing when the sacred line collapsed.</VALUE>
    <VALUE Lang="GS">Of course, we will need to study more for more accurate information.</VALUE>
    <VALUE Lang="id">item yang dulu ada di basement masih ada kan?</VALUE>
    <VALUE Lang="id">yang di basemen? Kayanya pernah dengar deh….</VALUE>
    <VALUE Lang="id">katanya ada yang melihat item itu dibawa orang yang berkeliaran diluar..</VALUE>
    <VALUE Lang="id">Solid Stone itu bahan yang bisa menggerakkan sesuatu, setelah runtuh, semu</VALUE>
    <VALUE Lang="cn">那些在地下室的人无法离开，对吗？</VALUE>
    <VALUE Lang="cn">是的，我听说过这个故事。</VALUE>
    <VALUE Lang="cn">我的好友看见有身份不明的凶手持有那块零件。..</VALUE>
    <VALUE Lang="cn">Solidified stone可以传送资料，我相信在神圣界线毁坏时，它也跟着失踪了。</VALUE>
    <VALUE Lang="cn">当然，我们需要得到更多更准确的信息。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_11_0_1">
    <VALUE Lang="GS">Ask her if these are better parts.</VALUE>
    <VALUE Lang="id">Bertanya apakah merupakan genuine part yang lebih bagus</VALUE>
    <VALUE Lang="cn">询问她那些是否是比较好的零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_12_0">
    <VALUE Lang="GS">What I have here is not powered parts.</VALUE>
    <VALUE Lang="GS">I don't have things like Hybrid Module or Plasma Injector.</VALUE>
    <VALUE Lang="GS">Huh? Did you say, what are those?</VALUE>
    <VALUE Lang="GS">Do you wanna know? Go out there and search the unidentified assailants.</VALUE>
    <VALUE Lang="GS">Maybe, I mean.. they might have those..</VALUE>
    <VALUE Lang="id">Yang aku miliki bukan item unggulan</VALUE>
    <VALUE Lang="id">aku ngga punya item seperti hybrid module, plasma injector dll</VALUE>
    <VALUE Lang="id">he?? Itu juga ngga tahu???</VALUE>
    <VALUE Lang="id">Ingin tahu? Coba cari dulu diluar..</VALUE>
    <VALUE Lang="id">Aaa</VALUE>
    <VALUE Lang="cn">我拥有的是无动力零件。</VALUE>
    <VALUE Lang="cn">我不喜欢那种Hybrid Module或是Plasma Injector。</VALUE>
    <VALUE Lang="cn">咦？你问那些是什么吗？</VALUE>
    <VALUE Lang="cn">您真的想知道吗？去那里寻找身份不明的凶手。</VALUE>
    <VALUE Lang="cn">嗯…...我的意思是...他们可能有那些..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_12_0_1">
    <VALUE Lang="GS">Tell her to go make it by herself</VALUE>
    <VALUE Lang="id">Minta tolong senior untuk membuatkan</VALUE>
    <VALUE Lang="cn">告诉她请自己做一个试试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_13_0">
    <VALUE Lang="GS">You are thinking too simply.If I was that genius, would I be here?</VALUE>
    <VALUE Lang="GS">I need to find other department students to make it. Don't give me that look..</VALUE>
    <VALUE Lang="GS">Please go find the student of my department for me!</VALUE>
    <VALUE Lang="id">Tidak semudah itu…</VALUE>
    <VALUE Lang="id">Kamu kira aku genius dan sepintar itu?</VALUE>
    <VALUE Lang="id">aku tidak bisa membuatnya sendirian</VALUE>
    <VALUE Lang="id">Kamu jangan lihat aku dengan mukan aneh…</VALUE>
    <VALUE Lang="id">Kamu bantu cari teman-temanku</VALUE>
    <VALUE Lang="id">tolong…</VALUE>
    <VALUE Lang="cn">您想得太简单了。如果我是天才的话，我怎么会在这里呢？</VALUE>
    <VALUE Lang="cn">我需要找其他部门的学生制作它。不要那样看我…...</VALUE>
    <VALUE Lang="cn">请去帮我找找和我同样部门的人！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_13_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_14_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">…....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_15_0">
    <VALUE Lang="GS">I will have to ask Student Director first.. Hope you don't mind.. Foundation has various labs, you've heard about the Zoological and Botanical Labs right? Also there is a not so famous engineering lab. SRC is a tool developed there.</VALUE>
    <VALUE Lang="id">Seharusnya kamu bertanya kepada student director… tapi tak apalah..</VALUE>
    <VALUE Lang="id">Di daerah kompleks ada banyak lab, kamu tahukan animals &amp; plants lab?</VALUE>
    <VALUE Lang="id">Keberadaan tempat itu masih kurang jelas, tapi ada satu science lab</VALUE>
    <VALUE Lang="id">nah SRC adalah item hasil penelitian</VALUE>
    <VALUE Lang="cn">我会先去问Student Director。财团里有许多各式各样的实验室。你听说过动物和植物学实验室吗？另外还有一个不太知名的工程实验室。SRC就是在那儿被开发出来的工具。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_15_0_1">
    <VALUE Lang="GS">Ask what SRC stands for</VALUE>
    <VALUE Lang="id">Bertanya apakah arti SRC</VALUE>
    <VALUE Lang="cn">询问SRC 的意义</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_16_0">
    <VALUE Lang="GS">SRC stands for Saint Rising Craft.I've only heard about this but it actually is a tool used in the space but Dr. TK has took it over from the government. It is a confidential and I can say no more to a student like yourself.</VALUE>
    <VALUE Lang="id">SRC adalah kepanjangan dari Saint Rising Craft</VALUE>
    <VALUE Lang="id">Sebenarnya aku juga kurang tahu, tapi aku pernah dengar bahwa itu adalah bekas beralatan untuk aerospace yang diterima prof Choi dari pemerintah</VALUE>
    <VALUE Lang="id">Hanya informasi ini saja yang boleh diketahui para pe</VALUE>
    <VALUE Lang="cn">SRC代表Saint Rising Craft。我只有听说过，但它实际上是在太空中使用的一种工具。而是Dr. TK 从政府接管了它。这是一个秘密，而且我无法再多说下去了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_16_0_1">
    <VALUE Lang="GS">Ask what kind of equipment are there</VALUE>
    <VALUE Lang="id">Bertanya mempunyai genuine part apa saja</VALUE>
    <VALUE Lang="cn">询问那边有哪些设备？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_17_0">
    <VALUE Lang="GS">When I just came here, there were so many stuffs to be improved.</VALUE>
    <VALUE Lang="GS">Lab has made the Skylock as a standard equipment but it just wasn't good enough for me.Therefore, Science Dept. has joined since the Wildcat development. The department head designed something called Spa..S... what was it called?..</VALUE>
    <VALUE Lang="id">Ketika masih jadi pelajar baru, aku sudah banyak mengembangkan item</VALUE>
    <VALUE Lang="id">Dulu aku pernah membuat Skylark Board standar…yang hasilnya lumayan.</VALUE>
    <VALUE Lang="id">Jadi, aku mulai bergabung ketika ada pengembangan Wild Cat. Dan kepala lab mengembangkan pass.. Ss ah aku lu</VALUE>
    <VALUE Lang="cn">当我刚来到这里时，大部分的东西都尚未准备齐全。。</VALUE>
    <VALUE Lang="cn">实验室已经取得了Skylock 作为标准设备，但对我来说它还不够好。因为Wildcat部门的关系，超能部也加入了。听说该部门设计了一种叫做Spa….S的东西......到底是叫做什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_17_0_1">
    <VALUE Lang="GS">Ask if it is supposed to be called SRC only.</VALUE>
    <VALUE Lang="id">Bertanya apakah itu bukan SRC</VALUE>
    <VALUE Lang="cn">询问是否只能叫做SRC？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_18_0">
    <VALUE Lang="GS">You've got it all wrong..Not only Hover is SRC.There are other vehicle types too..</VALUE>
    <VALUE Lang="GS">Oops.. I shouldn't have said that..Let's stop here. Student Director might get mad at me</VALUE>
    <VALUE Lang="id">Oh iya aku baru ingat..</VALUE>
    <VALUE Lang="id">SRC.. Selain hoverboard masih ada yang lain,</VALUE>
    <VALUE Lang="id">kendaraan lainnya juga ada</VALUE>
    <VALUE Lang="id">hmm…sebenarnya ini masih belum boleh di sebarluaskan..</VALUE>
    <VALUE Lang="id">ya..udah informasinya sampai disini dulu</VALUE>
    <VALUE Lang="id">nanti Student Director bisa marah.</VALUE>
    <VALUE Lang="cn">你已经得到了这一切wrong..Not只有哈弗是SRC.There其他车型太..</VALUE>
    <VALUE Lang="cn">哎呀..我不应该说that..Let的停在这里。学生导演会生我的气</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_18_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_19_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_2_0">
    <VALUE Lang="GS">I'm Sun-A Jo, my class is Science</VALUE>
    <VALUE Lang="GS">I think I'm high class than you.</VALUE>
    <VALUE Lang="id">aku adalah Suna Jo dari Science Club</VALUE>
    <VALUE Lang="id">Aku adalah kakak kelas kamu, panggil aku senior ya</VALUE>
    <VALUE Lang="cn">我是超能部的Sun-A Jo。</VALUE>
    <VALUE Lang="cn">我的年级比你高唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_2_0_1">
    <VALUE Lang="GS">Why are you here?</VALUE>
    <VALUE Lang="id">Kenapa senior ada disini?</VALUE>
    <VALUE Lang="cn">您为何在这边？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_20_0">
    <VALUE Lang="GS">I need some documents. If you go to Root Hole, please look for the documents from Pretty Veyah</VALUE>
    <VALUE Lang="id">Saya membutuhkan dokumen. Tolong bunuh Pretty Veyah di Root Hole</VALUE>
    <VALUE Lang="cn">我需要一些文件。</VALUE>
    <VALUE Lang="cn">若您去Root Hole的话，将会看到Pretty Veyah。</VALUE>
    <VALUE Lang="cn">请从他们那儿取得文件。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_20_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_21_0">
    <VALUE Lang="GS">This is the reward for you as my appreciation. Please accept it</VALUE>
    <VALUE Lang="id">"Sebagai tanda terima kasih,</VALUE>
    <VALUE Lang="id">terimalah ini"</VALUE>
    <VALUE Lang="cn">我送这个礼物给你，表达我对你的谢意。</VALUE>
    <VALUE Lang="cn">请接受吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_21_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_22_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_23_0">
    <VALUE Lang="GS">Erm....You can help me, I heard about research document stolen by Spice Girl. Can you help me get back from them?</VALUE>
    <VALUE Lang="id">Mmm..aku butuh sedikit bantuan…</VALUE>
    <VALUE Lang="id">Lab noteku hilang, aku dengar ada Spice Girl yang membawanya di middle town, mau bantu mencarikan?</VALUE>
    <VALUE Lang="cn">恩... 有件事情你可以帮忙。</VALUE>
    <VALUE Lang="cn">听说我的研究报告被Spice Girl给抢走了。您可以帮我找回来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_23_0_1">
    <VALUE Lang="GS">Reject</VALUE>
    <VALUE Lang="id">Mengatakan kalau kamu tidak mau</VALUE>
    <VALUE Lang="cn">拒绝</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_23_0_2">
    <VALUE Lang="GS">Agree</VALUE>
    <VALUE Lang="id">Mau mencarikan</VALUE>
    <VALUE Lang="cn">同意</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_24_0">
    <VALUE Lang="GS">It is not easy to get back, god bless...</VALUE>
    <VALUE Lang="id">Sepertinya susah menemukannya. Tolong ya…</VALUE>
    <VALUE Lang="cn">应该不容易把资料找回来, 拜托了..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_24_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_25_0">
    <VALUE Lang="GS">You get it back.... Thank you very much. This is a gift for you, Mesil Power.Please let me know if you want the power, i can help you.</VALUE>
    <VALUE Lang="id">Sudah ketemu? Wah… terima kasih sekali..</VALUE>
    <VALUE Lang="id">Sebagai gantinya aku kasih ini…ini adalah sphere yang dibisa mendatangkan kekuatan Methlan</VALUE>
    <VALUE Lang="id">Kalau butuh sesuatu, datang saja..akan aku bantu</VALUE>
    <VALUE Lang="cn">你把它找回来了.. 真的非常谢谢你..</VALUE>
    <VALUE Lang="cn">这个作为帮忙的谢礼送给你.. Mesil Power。</VALUE>
    <VALUE Lang="cn">任何时间你想要获得力量就来找我,我会助你一臂之力。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_25_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_26_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">………..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_27_0">
    <VALUE Lang="GS">Cannot get the power immedeately, you let me keep the Mesil Potion, i give you a book.After you read it, you will get the power.</VALUE>
    <VALUE Lang="id">Skill yang kamu inginkan tidak bisa langsung didapat..</VALUE>
    <VALUE Lang="id">Berikan saya Mesil Potionmu dan akan kuberi skill baru.</VALUE>
    <VALUE Lang="cn">不能直接马上获得想要的力量..</VALUE>
    <VALUE Lang="cn">把Mesil Potion交给我保管吧！ 我给你可以看的懂的文书..</VALUE>
    <VALUE Lang="cn">当你读完文书之后，就会拥有前所未有的力量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_27_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_27_0_10">
    <VALUE Lang="GS">Exchange it for skill scroll Empo's Wisdom.</VALUE>
    <VALUE Lang="id">Pilih Empo's Wisdom Skill</VALUE>
    <VALUE Lang="cn">兑换 Empo's Wisdom 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_27_0_2">
    <VALUE Lang="GS">Exchange "Wayne's Awakening" Skill Book</VALUE>
    <VALUE Lang="id">Pilih "Wayne's Awakening" Skill</VALUE>
    <VALUE Lang="cn">兑换 "Wayne's Awakening" 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_27_0_3">
    <VALUE Lang="GS">Exchange "Toal's Eyes" Skill Book</VALUE>
    <VALUE Lang="id">Pilih "Toal's Eyes" Skill</VALUE>
    <VALUE Lang="cn">兑换 "Toal's Eyes" 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_27_0_4">
    <VALUE Lang="GS">Exchange "Veina's Pace" Skill Book</VALUE>
    <VALUE Lang="id">Pilih "Veina's Pace" Skill</VALUE>
    <VALUE Lang="cn">兑换 "Veina's Pace" 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_27_0_5">
    <VALUE Lang="GS">Exchange "Daran's Breath" Skill Book</VALUE>
    <VALUE Lang="id">Pilih "Daran's Breath" Skill</VALUE>
    <VALUE Lang="cn">兑换 "Daran's Breath" 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_27_0_6">
    <VALUE Lang="GS">Exchange "Kumora's Leap" Skill Book</VALUE>
    <VALUE Lang="id">Tukar "Kumora's Leap" Skill Book</VALUE>
    <VALUE Lang="cn">兑换 "Kumora's Leap" Skill Book</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_28_0">
    <VALUE Lang="GS">Wow! A Spiritual Sphere with mysterious power. Let me exchange it to a skill scroll for you, so you can acquire the power of Mesil.</VALUE>
    <VALUE Lang="id">Kamu membawa Spiritual Sphere?</VALUE>
    <VALUE Lang="id">Aku tukarkan dengan scroll agar kamu bisa mendapatkan kekuatan Mesil</VALUE>
    <VALUE Lang="cn">哇！是个拥有神秘的力量的灵珠！</VALUE>
    <VALUE Lang="cn">让我兑换一个技能文书 skill scroll给您。这样你就可以获取Mesil的力量了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_28_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_28_0_10">
    <VALUE Lang="GS">Exchange it for skill scroll Empo's Wisdom.</VALUE>
    <VALUE Lang="id">Pilih Skill Empo's Wisdom.</VALUE>
    <VALUE Lang="cn">兑换 Empo's Wisdom。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_28_0_2">
    <VALUE Lang="GS">Exchange "Wayne's Awakening" Skill Book</VALUE>
    <VALUE Lang="id">Pilih "Wayne's Awakening" Skill</VALUE>
    <VALUE Lang="cn">兑换 "Wayne's Awakening" 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_28_0_3"><VALUE Lang="tw">兌換 土沃之眼（175級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Toal's Eyes (Lv175, Class=130, Item=175/70)</VALUE><VALUE Lang="id">Skill book: Toal's Eyes (Lv175, Class=130, Item=175/70)</VALUE><VALUE Lang="cn">Skill book: Toal's Eyes (Lv175, Class=130, Item=175/70)</VALUE><VALUE Lang="th">Skill book: Toal's Eyes (Lv175, Class=130, Item=175/70)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_28_0_4">
    <VALUE Lang="GS">Exchange "Veina's Pace" Skill Book</VALUE>
    <VALUE Lang="id">Pilih "Veina's Pace" Skill</VALUE>
    <VALUE Lang="cn">兑换 "Veina's Pace" 技能文书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_28_0_5"><VALUE Lang="tw">兌換 達拉安的氣息（175級／氣功部）</VALUE><VALUE Lang="GS">Skill book: Daran's Breath (Lv175, Class=520, Item=176/71)</VALUE><VALUE Lang="id">Skill book: Daran's Breath (Lv175, Class=520, Item=176/71)</VALUE><VALUE Lang="cn">Skill book: Daran's Breath (Lv175, Class=520, Item=176/71)</VALUE><VALUE Lang="th">Skill book: Daran's Breath (Lv175, Class=520, Item=176/71)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_28_0_6"><VALUE Lang="tw">兌換 終極．庫莫拉之躍（107級／終極部）</VALUE><VALUE Lang="GS">Skill book: Kumora's Leap (Lv107, Class=48, Item=179/95)</VALUE><VALUE Lang="id">Skill book: Kumora's Leap (Lv107, Class=48, Item=179/95)</VALUE><VALUE Lang="cn">Skill book: Kumora's Leap (Lv107, Class=48, Item=179/95)</VALUE><VALUE Lang="th">Skill book: Kumora's Leap (Lv107, Class=48, Item=179/95)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_29_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_3_0">
    <VALUE Lang="GS">Always, I hate outside..</VALUE>
    <VALUE Lang="GS">Of course, I hate to fight and running as like you.</VALUE>
    <VALUE Lang="id">Aku ngga suka main diluar</VALUE>
    <VALUE Lang="id">Dan ngga suka juga bertarung diluar seperti kalian</VALUE>
    <VALUE Lang="cn">那是因为我总是不喜欢到外面出来.</VALUE>
    <VALUE Lang="cn">""我很讨厌像你们一样跑来跑去,到处打架. """</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_3_0_1">
    <VALUE Lang="GS">Where have you been keeping yourself?</VALUE>
    <VALUE Lang="id">Bertanya dari mana</VALUE>
    <VALUE Lang="cn">您过去都待在哪里呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_30_0">
    <VALUE Lang="GS">Oh.... Grocer request you come and visit me? If you really want to know the content, you need to get the Decoder. You can go Phoenix campus to get the Decoder from Shocker.</VALUE>
    <VALUE Lang="id">Oh.... Kamu disuruh Grocer untuk datang menemui saya? Jikalau kamu ingin mengetahui konten yang tersedia, kamu harus memiliki Decoder. Kamu bisa mendapatkannya dengan membunung Shocker di Phoenix Kampus.</VALUE>
    <VALUE Lang="cn">啊…是Grocer派你过来的啊？看来这有点复杂呢。如果要解码需要用到解码器Decoder。先前似乎有看过位在Phoenix campus的 Shocker怪人有用过这东西。您可以帮我取得解码器Decoder吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_30_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_31_0">
    <VALUE Lang="GS">You get it back! That is great you have decoder. Please pass it to Grocer.</VALUE>
    <VALUE Lang="id">Terima kasih sudah membawanya! Tolong berikan kepada Grocer secepatnya.</VALUE>
    <VALUE Lang="cn">找回来的啊？恩…有了解码器果然容易多了。好了，拿去给Grocer吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_31_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0">
    <VALUE Lang="GS">Grocer, this is the item......you.....need.</VALUE>
    <VALUE Lang="id">Grocer, ini saya bawakan item yang kamu inginkan.</VALUE>
    <VALUE Lang="cn">Grocer… 您好。这是您要的东西！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0_2">
    <VALUE Lang="GS">Brawler Weapon Needed</VALUE>
    <VALUE Lang="id">Ingin senjata untuk Brawler</VALUE>
    <VALUE Lang="cn">需要格斗部的武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0_3">
    <VALUE Lang="GS">Sword Weapon Needed</VALUE>
    <VALUE Lang="id">Ingin senjata untuk Swordsman</VALUE>
    <VALUE Lang="cn">需要剑道部的武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0_4">
    <VALUE Lang="GS">Bow Weapon Needed</VALUE>
    <VALUE Lang="id">Ingin senjata untuk Archery</VALUE>
    <VALUE Lang="cn">需要弓箭部的武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0_5">
    <VALUE Lang="GS">Shaman Weapon Needed</VALUE>
    <VALUE Lang="id">Ingin senjata untuk Shaman</VALUE>
    <VALUE Lang="cn">需要气功部的武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0_6">
    <VALUE Lang="GS">Prefer weapons for Scientists</VALUE>
    <VALUE Lang="id">Ingin senjata untuk Science</VALUE>
    <VALUE Lang="cn">想要超能部的武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0_7">
    <VALUE Lang="GS">Prefer weapons for Assassin</VALUE>
    <VALUE Lang="id">Ingin senjata untuk Assassin</VALUE>
    <VALUE Lang="cn">需要忍术部的武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_32_0_8">
    <VALUE Lang="GS">Ask a weapon for Magic Trick</VALUE>
    <VALUE Lang="id">Mintalah senjata untuk Magic Trick</VALUE>
    <VALUE Lang="cn">要求一件关于魔术的武器</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_33_0">
    <VALUE Lang="GS">Select item type.</VALUE>
    <VALUE Lang="id">Pilih yang kamu inginkan</VALUE>
    <VALUE Lang="cn">请选择想要的类型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_33_0_1">
    <VALUE Lang="GS">Take the Cestus</VALUE>
    <VALUE Lang="id">Pilih Cestus</VALUE>
    <VALUE Lang="cn">选择 Cestus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_33_0_2">
    <VALUE Lang="GS">Take the Heavy Cestus</VALUE>
    <VALUE Lang="id">Pilih Heavy Cestus</VALUE>
    <VALUE Lang="cn">选择 Heavy Cestus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_33_0_3">
    <VALUE Lang="GS">Take the Vital Cestus</VALUE>
    <VALUE Lang="id">Pilih Vital Cestus</VALUE>
    <VALUE Lang="cn">选择 Vital Cestus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_34_0">
    <VALUE Lang="GS">Select item type.</VALUE>
    <VALUE Lang="id">Pilih yang kamu inginkan</VALUE>
    <VALUE Lang="cn">请选择想要的类型</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_34_0_1">
    <VALUE Lang="GS">Take the Sword</VALUE>
    <VALUE Lang="id">Pilih Sword</VALUE>
    <VALUE Lang="cn">选择 Sword</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_34_0_2">
    <VALUE Lang="GS">Take the Blade</VALUE>
    <VALUE Lang="id">Pilih Blade</VALUE>
    <VALUE Lang="cn">选择 Blade</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_34_0_3">
