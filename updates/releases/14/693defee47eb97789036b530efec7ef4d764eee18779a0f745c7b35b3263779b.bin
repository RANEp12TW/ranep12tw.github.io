    <VALUE Lang="GS">Exchange Deluxe Protective Potion</VALUE>
    <VALUE Lang="id">Tukar Deluxe Protective Potion</VALUE>
    <VALUE Lang="cn">换取 Deluxe Protective Potion</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_5">
    <VALUE Lang="GS">Exchange Bone Powder</VALUE>
    <VALUE Lang="id">Tukar Bone Powder</VALUE>
    <VALUE Lang="cn">换取 Bone Powder</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_6">
    <VALUE Lang="GS">Exchange Deluxe Bone Powder</VALUE>
    <VALUE Lang="id">Tukar Deluxe Bone Powder</VALUE>
    <VALUE Lang="cn">换取 Deluxe Bone Powder</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_7">
    <VALUE Lang="GS">Exchange Iron</VALUE>
    <VALUE Lang="id">Tukar Iron</VALUE>
    <VALUE Lang="cn">换取 Iron</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_8">
    <VALUE Lang="GS">Exchange Fine Iron</VALUE>
    <VALUE Lang="id">Tukar Fine Iron</VALUE>
    <VALUE Lang="cn">换取 Fine Iron</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_6_0_9">
    <VALUE Lang="GS">Exchange Silver</VALUE>
    <VALUE Lang="id">Tukar Silver</VALUE>
    <VALUE Lang="cn">换取 Silver</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_7_0">
    <VALUE Lang="GS">If this mess and resource shortage continues, then we'll suffer tremendous problems later on.</VALUE>
    <VALUE Lang="GS">There are other matters that you don't need to worry about for now. Just concentrate on helping me collect some Empty Bottles.</VALUE>
    <VALUE Lang="GS">Please use the Medicine Items carefully.</VALUE>
    <VALUE Lang="id">Kebetulan kita sedang kekurangan material, jika sedikit saja tidak bisa dikumpulkan kedepannya akan lebih sulit</VALUE>
    <VALUE Lang="id">Kumpulkanlah Empty Bottles saja dan abaikan yang lainnya</VALUE>
    <VALUE Lang="id">Setidaknya kalian harus bisa menjaga Medicines tersebut</VALUE>
    <VALUE Lang="cn">如果物资短缺，环境脏乱的情况一直持续下去的话，往后我们一定会遭遇到更大的灾难的。</VALUE>
    <VALUE Lang="cn">您什么都不要想，也不需要操心任何事情。现在只需要帮我把 Empty Bottle收集好就可以了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0">
    <VALUE Lang="GS">Wow, this Red Pearl is special! Please choose any of my available items in exchange for this.</VALUE>
    <VALUE Lang="id">Coba lihat…</VALUE>
    <VALUE Lang="id">Red Pearl yang itu memiliki nilai yang cukup tinggi…</VALUE>
    <VALUE Lang="id">Nah, pilihlah item yang diinginkan</VALUE>
    <VALUE Lang="cn">哇!!</VALUE>
    <VALUE Lang="cn">这颗赤珠一定有他的价值，请选择要换取的东西吧。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_cleaner1.ntk_8_0_1">
    <VALUE Lang="GS">Exchange Burr</VALUE>
    <VALUE Lang="id">Tukar Burr</VALUE>
    <VALUE Lang="cn">换取 Burr</VALUE>
  </SENTENSE>
