  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_36_0">
    <VALUE Lang="GS">Hmm?</VALUE>
    <VALUE Lang="GS">You need to check the contents of the trash first. Alright?</VALUE>
    <VALUE Lang="id">Ah, mungkin saja..</VALUE>
    <VALUE Lang="id">Kamu tidak usah mengecek isi sampah-sampah itu</VALUE>
    <VALUE Lang="cn">嗯？您不用先确认看看垃圾的内容吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_cleaner1.ntk_36_0_1">
