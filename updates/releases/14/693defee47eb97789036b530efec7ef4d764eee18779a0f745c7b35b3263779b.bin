    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0">
    <VALUE Lang="GS">Okay, what do you want to know?</VALUE>
    <VALUE Lang="id">Mau dengar cerita apa?</VALUE>
    <VALUE Lang="cn">嗯…. 您想问什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0_1">
    <VALUE Lang="GS">Ask for Directions</VALUE>
    <VALUE Lang="id">Bertanya jalan</VALUE>
    <VALUE Lang="cn">询问方向</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_8_0_2">
    <VALUE Lang="GS">Ask about Sacred Gate Park</VALUE>
    <VALUE Lang="id">Bertanya tentang Sacred Gate Park</VALUE>
    <VALUE Lang="cn">询问关于Sacred Gate Park的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0">
    <VALUE Lang="GS">Ah, I've heard the Construction Supervisor mention that place. I really appreciate your willingness to help me out.</VALUE>
    <VALUE Lang="GS">It's pretty smart for you to accept all the help that you can get because of all the strange things that are happening in different areas.</VALUE>
    <VALUE Lang="GS">Keep up the good work.</VALUE>
    <VALUE Lang="id">O iya, aku dengar dari Supervisor Construction</VALUE>
    <VALUE Lang="id">Beliau sangat berteri makasih karena kamu memenuhi permintaan dia</VALUE>
    <VALUE Lang="id">Mereka juga sudah sedikit tahu bahwa situasi sekarang sangat aneh, kita harus membantu sebisanya. Bagus!</VALUE>
    <VALUE Lang="cn">啊? 听Construction Supervisor 说过</VALUE>
    <VALUE Lang="cn">你接受我的请托 真是非常感谢</VALUE>
    <VALUE Lang="cn">他们也知道现在的状况在某种程度上来说是很奇怪的, 所以尽可能帮你, 做的真是太好了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0_1">
    <VALUE Lang="GS">Apply for the Examination</VALUE>
    <VALUE Lang="id">Ujian dari Physiscs Teacher</VALUE>
    <VALUE Lang="cn">申请考试</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex2.ntk_9_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
