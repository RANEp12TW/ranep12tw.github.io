    <VALUE Lang="cn">转交 Beads</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_p_police.ntk_1_0_27">
    <VALUE Lang="GS">Ask about What is Happening</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
