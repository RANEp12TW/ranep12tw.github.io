  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_53">
    <VALUE Lang="GS">Reward Catalog</VALUE>
    <VALUE Lang="id">Daftar penjahat paling dicari</VALUE>
    <VALUE Lang="cn">奖励目录单</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_54">
    <VALUE Lang="GS">Ask How You can Help</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">询问将如何进行协助</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_55">
    <VALUE Lang="GS">Submit ID Cards</VALUE>
    <VALUE Lang="id">Menyerahkan surat ijin keluar masuk yang sudah terkumpul</VALUE>
    <VALUE Lang="cn">提交 ID卡</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_c1_police_1.ntk_1_0_56">
    <VALUE Lang="GS">Deliver the Action Guide</VALUE>
    <VALUE Lang="id">Menyerahkan buku panduan</VALUE>
