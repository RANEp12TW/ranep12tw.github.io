  <SENTENSE Ver="1" Id="npc_1_t_trick.ntk_1_0">
    <VALUE Lang="GS">If you are not a Magician, there is nothing I can do for you.</VALUE>
    <VALUE Lang="id">Jika kamu bukan Magician, maka tidak ada yang bisa kami lakukan untukmu.</VALUE>
    <VALUE Lang="cn">如果你不是一个魔术师, 我没有什么能帮你做的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_trick.ntk_1_0_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Trade</VALUE>
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_trick.ntk_1_1">
    <VALUE Lang="GS">Learning powerful magic is not easy! It requires a lot of efforts and practice. Now, what can I help you with?</VALUE>
    <VALUE Lang="id">Mempelajari sihir yang kuat tidaklah mudah. Memerlukan banyak upaya dan latihan. Sekarang apa yang bisa saya bantu?</VALUE>
    <VALUE Lang="cn">学习一个强大的魔术不是一件容易的事情. 它需要不懈的努力和练习. 那么, 你希望我帮你做什么？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_trick.ntk_1_1_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Trade</VALUE>
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
