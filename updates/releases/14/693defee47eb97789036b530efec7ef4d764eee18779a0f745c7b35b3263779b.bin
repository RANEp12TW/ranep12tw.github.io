    <VALUE Lang="id">Rahasia Monumen Peringatan Hujan Meteor I</VALUE>
    <VALUE Lang="cn">陨石纪念碑的秘密 I</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_scmasterpat.ntk_1_0_15">
    <VALUE Lang="GS">Secret of Meteorite Monument I</VALUE>
    <VALUE Lang="id">Rahasia Monumen Peringatan Hujan Meteor I</VALUE>
    <VALUE Lang="cn">陨石纪念碑的秘密 I</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_scmasterpat.ntk_1_0_16">
