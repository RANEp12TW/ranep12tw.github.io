  <SENTENSE Ver="1" Id="npc_school_helper.ntk_9_0">
    <VALUE Lang="GS">Character window can be openned with keyboard 'C' button and when there are remaining stat points it can be distriubted to Pow. Dex, Int and etc. by the user.</VALUE>
