    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_4_0">
    <VALUE Lang="GS">Force Field Optimization is completed!</VALUE>
    <VALUE Lang="GS">Please move to the next Terminal to complete the remaining Force Field Optimization requirements.</VALUE>
    <VALUE Lang="id">Autentikasi Force Field telah selesai</VALUE>
    <VALUE Lang="id">Jika sisa autentikasi Force Field telah selesai hasilnya bisa di dapatkan dan untuk autentikasi Force Field berikutnya harap gunakan terminal yang sesuai</VALUE>
    <VALUE Lang="cn">您已完成本结界的认证！请前往下个结界终端机，完成所有的认证，并获取结界能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_gisuk_1.ntk_4_0_1">
