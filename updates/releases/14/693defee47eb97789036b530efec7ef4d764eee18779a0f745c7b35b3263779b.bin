  <SENTENSE Ver="1" Id="2013_halloween06.ntk_1_1_1">
    <VALUE Lang="GS">Receive a Pumpkin box</VALUE>
    <VALUE Lang="id">Menerima Pumpkin box</VALUE>
    <VALUE Lang="cn">领取Pumpkin box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween06.ntk_2_0">
    <VALUE Lang="GS">I give you a Pumpkin box every Saturday and Sunday so please visit me~!</VALUE>
    <VALUE Lang="id">Aku memberi kamu sebuah Pumpkin Box setiap hari Sabtu dan Minggu jadi silakan kunjungi saya ~!</VALUE>
    <VALUE Lang="cn">每周六和日我都会提供Pumpkin box，请您要记得来找我唷。</VALUE>
  </SENTENSE>
