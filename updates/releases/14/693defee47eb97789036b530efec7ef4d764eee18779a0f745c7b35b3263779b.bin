  <SENTENSE Ver="1" Id="npc_e3_danmal30f.ntk_3_0">
    <VALUE Lang="GS">There are the pieces of paper that contain the 30th floor password hints on the 1st floor.</VALUE>
    <VALUE Lang="GS">If you want to enter, please find and complete the password.</VALUE>
    <VALUE Lang="id">Katanya dokumen yang bisa memecahkan passwordnya berserakan di lantai satu</VALUE>
