    <VALUE Lang="GS">Exchange for Scroll of Titan's Mettle</VALUE>
    <VALUE Lang="id">Tukar dengan Scroll of Titan's Mettle</VALUE>
    <VALUE Lang="cn">兑换 Titan's Mettle 技能文书</VALUE>
  </SENTENSE>
