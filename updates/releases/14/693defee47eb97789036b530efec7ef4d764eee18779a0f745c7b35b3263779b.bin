  <SENTENSE Ver="1" Id="npc_event_extra.ntk_1_3_4">
    <VALUE Lang="GS">Ask what Happened</VALUE>
    <VALUE Lang="id">Bertanya apa yang terjadi</VALUE>
    <VALUE Lang="cn">询问发生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_2_0">
    <VALUE Lang="GS">I don't know why I'm here...</VALUE>
    <VALUE Lang="GS">I just saw all these suspicious men when I woke up. It's also kind of hard to even stand in here...</VALUE>
    <VALUE Lang="id">Saya juga tidak tahu bagaimana bisa sampai kesini. Ketika aku sadar, di sekitarku sudah banyak monster-monster. Saya disini sendirian saja kewalahan.. Saya tak tahu harus meminta bantuan kepada siapa</VALUE>
    <VALUE Lang="cn">我不知道为何我会在这里….. 我只知道，当我醒来时，我就看到一堆的可疑男子在旁边绕。 站在这里好辛苦！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_5_0">
    <VALUE Lang="GS">Thank you so much.</VALUE>
    <VALUE Lang="GS">I was in such despair…</VALUE>
    <VALUE Lang="GS">But now, I… I…</VALUE>
    <VALUE Lang="GS">Thank you.</VALUE>
    <VALUE Lang="id">Benar-benar terimakasih…</VALUE>
    <VALUE Lang="id">Soalnya saya sedang memutuskan untuk menyerah</VALUE>
    <VALUE Lang="id">Bahkan mungkin susah untuk melindungi diri sendiri….</VALUE>
    <VALUE Lang="id">Benar-benar terimakasih.</VALUE>
    <VALUE Lang="cn">谢谢您。我原本很绝望的，但现在，我……. 非常地感谢您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_extra.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_0">
    <VALUE Lang="GS">Have you collected 50 of my Gold Coins?</VALUE>
    <VALUE Lang="id">Apakah kamu sudah mengoleksi 50 Koin Emas?</VALUE>
    <VALUE Lang="cn">您有收集到我的50个Gold Coin吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_0_1">
    <VALUE Lang="GS">Sure thing! Here, 50 Gold Coins!</VALUE>
    <VALUE Lang="id">Tentu saja! Ini, 50 Koin Emas!</VALUE>
    <VALUE Lang="cn">是的，当然！来，50 Gold Coin在这儿。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_1">
    <VALUE Lang="GS">Have you collected 50 of my Gold Coins?</VALUE>
    <VALUE Lang="id">Apakah kamu sudah mengoleksi 50 Koin Emas?</VALUE>
    <VALUE Lang="cn">您有收集到我的50个Gold Coin吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_1_1">
    <VALUE Lang="GS">50? No... Not yet...</VALUE>
    <VALUE Lang="id">50? Be…Belum</VALUE>
    <VALUE Lang="cn">50？噢！还没。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_2">
    <VALUE Lang="GS">Bad thugs have taken my Gold Coins... Oh my goodness!... What should I do?.... (sobbing)....</VALUE>
    <VALUE Lang="id">Para penjahat mencuri Koin Emas saya... Apa yang harus saya lakukan?.... (nangis)....</VALUE>
    <VALUE Lang="cn">邪恶歹徒把我的Gold Coin给抢走了......哦，我的天啊！......我该怎么办？......（呜呜）......</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_1_2_1">
    <VALUE Lang="GS">What's wrong? Stop Crying! Do you want to talk to me about it?</VALUE>
    <VALUE Lang="id">Apa yang terjadi? Berhenti menangis! Katakan pada saya apa yang terjadi?</VALUE>
    <VALUE Lang="cn">怎么了？别哭了！你想和我谈谈吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_10_0">
    <VALUE Lang="GS">Hey there. Would you like to collect these Gold Coins one more time for a Lucky Green Hat? If you are interested in getting an extra Hat then collect the Gold Coins again and bring it to me. Cuz, I still have got plenty of that Hat left... Ha Ha Ha</VALUE>
    <VALUE Lang="id">Maukah kamu mengumpulkan Koin Emas sekali lagi untuk ditukar dengan Lucky Green Hat? Jika berminat, kumpulkan dan bawa ke saya... Ha Ha Ha</VALUE>
    <VALUE Lang="cn">嘿！你想收集这些Gold Coin然后再得到一次的Lucky Green Hat吗？如果你有兴趣的话，请再继续收集Gold Coin，并把它交给我。我手中的帽子还有剩很多唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_2_0">
    <VALUE Lang="GS">(sobbing)... One day a mob of monsters came and took all of my Gold Coins.</VALUE>
    <VALUE Lang="GS">Those Gold Coins are the most precious treasure of mine...</VALUE>
    <VALUE Lang="GS">Can somebody please help?....</VALUE>
    <VALUE Lang="GS">Well, look at you, you look pretty strong...</VALUE>
    <VALUE Lang="GS">Would you please help me, would you please?</VALUE>
    <VALUE Lang="id">(hiks hiks)... Suatu hari monster tiba - tiba muncul dan mengambil Koin Emas saya.</VALUE>
    <VALUE Lang="id">Koin Emas tersebut adalah harta tersayang saya...</VALUE>
    <VALUE Lang="id">Ada yang bisa membantu?....</VALUE>
    <VALUE Lang="id">Kamu terlihat sangat kuat...</VALUE>
    <VALUE Lang="id">Bisakah kamu membantu saya?</VALUE>
    <VALUE Lang="cn">（呜呜）......有一天，某个怪物恶棍跑来抢走了我的 Gold Coin。</VALUE>
    <VALUE Lang="cn">这些 Gold Coin是我的最宝贵的财富…..</VALUE>
    <VALUE Lang="cn">有好心人愿意帮助我吗？</VALUE>
    <VALUE Lang="cn">嗯，现在再看看您，感觉您长的挺壮硕的…..</VALUE>
    <VALUE Lang="cn">可以请您帮帮我吗？可以吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_2_0_1">
    <VALUE Lang="GS">Ok! I will help you.</VALUE>
    <VALUE Lang="id">Baiklah! Saya akan membantu.</VALUE>
    <VALUE Lang="cn">OK! 我会帮您的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_2_0_2">
    <VALUE Lang="GS">No! Sorry! (Back to beginning)</VALUE>
    <VALUE Lang="id">Tidak! Maaf!</VALUE>
    <VALUE Lang="cn">不！抱歉！（回到最初）</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_3_0">
    <VALUE Lang="GS">Great! I knew you would help me! Please find 50 of my Gold Coins from the monsters! If you could do that for me then I will give you a nice compensation.</VALUE>
    <VALUE Lang="GS">Be careful! those monsters are pretty strong... Be safe!</VALUE>
    <VALUE Lang="id">Bagus! Saya tahu kamu akan membantu saya! Tolong kumpulkan 50 Koin Emas! Saya akan memberikan hadiah sebagai kompensasi. </VALUE>
    <VALUE Lang="id">nHati - hati monsternya sangat kuat!</VALUE>
    <VALUE Lang="cn">太好了！我就知道你会帮我！请您从怪物那边夺回我的50 Gold Coin！如果您能为我做到的话，我会给您一个很好的奖励。</VALUE>
    <VALUE Lang="cn">要当心！那些怪物非常强悍… 小心安全！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_3_0_1">
    <VALUE Lang="GS">Back to beginning</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回到最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_4_0">
    <VALUE Lang="GS">Hurry! Before those bastards get far away and disappear with my Gold Coins.</VALUE>
    <VALUE Lang="id">Cepat sebelum mereka kabur dengan Koin Emas saya.</VALUE>
    <VALUE Lang="cn">请快点！在那些混蛋拿着我的金币消失之前，请快点解决它们啊！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_4_0_1">
    <VALUE Lang="GS">Back to beginning</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回到最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_5_0">
    <VALUE Lang="GS">Well Well Well~ finally these shining Gold Coins have came back to me...</VALUE>
    <VALUE Lang="GS">(giggles).... Simple ones.... (giggles)</VALUE>
    <VALUE Lang="GS">Thanks to you, I now have acquired mighty power... (giggles)</VALUE>
    <VALUE Lang="id">Akhirnya Koin Emas saya kembali juga...</VALUE>
    <VALUE Lang="id">(hihihi).... (hihihi)</VALUE>
    <VALUE Lang="id">Thanks to you, I now have acquired mighty power... (giggles)</VALUE>
    <VALUE Lang="cn">啊哈啊哈啊哈〜终于这些闪亮亮的Gold Coin再度回到我身边了...... （嘿嘿）......简单嘛....（哈哈）</VALUE>
    <VALUE Lang="cn">谢谢您，我现在已经得到了强大力量了......（呼呼）</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_5_0_1">
    <VALUE Lang="GS">What are you saying...?</VALUE>
    <VALUE Lang="id">Apa kamu bilang...?</VALUE>
    <VALUE Lang="cn">您在说啥？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_6_0">
    <VALUE Lang="GS">You still don't get it, do you? What a fool... (giggles)</VALUE>
    <VALUE Lang="GS">Actually, those monsters you have "Punished" are the true owners of these Gold Coins. You simply trusted my words and took their Gold Coins from them... (giggles)... These Gold Coins work as a charm which gives more power to those monsters.</VALUE>
    <VALUE Lang="GS">I have always envied it but the monsters were too strong for me to defeat and I could not do anything.... After a long long period of my master planning, I knew that I could be able to get these Gold Coins easily by fooling you....</VALUE>
    <VALUE Lang="id">Belum dapat? Bisa apa kamu...</VALUE>
    <VALUE Lang="id">Sebenarnya para monster tersebut adalah pemilik asli dari koin emas ini. Kamu benar - benar percaya dengan kata - kata saya... (hahahaha)... Koin emas ini bisa membuat para monster tersebut menjadi kuat.</VALUE>
    <VALUE Lang="id">Saya sangat iri tet</VALUE>
    <VALUE Lang="cn">你还是不懂，对吧？真是个小傻瓜......（呵呵）</VALUE>
    <VALUE Lang="cn">事实上，那些您已经“惩罚”过的怪物，都是Gold Coin的真正持有者。相信我的话，并找它们夺取金币吧！.....（哈哈）......这些金币其实给了那些怪物不少的魔法力。</VALUE>
    <VALUE Lang="cn">我一直嫉妒它们，但它们太强我无法打败，一直无法进行任何事情。</VALUE>
    <VALUE Lang="cn">这个计划已经很久了，现在似乎可以用捉弄您的方式来实现我的梦想。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_6_0_1">
    <VALUE Lang="GS">Gee... then... you fooled me!! You con!! Give the Gold Coins back!!</VALUE>
    <VALUE Lang="id">Jadi kamu membohongi saya!! Berikan Koin Emas itu kembali!!</VALUE>
    <VALUE Lang="cn">啧啧….所以......你骗了我！你坏坏！</VALUE>
    <VALUE Lang="cn">去把Gold Coin给拿回来！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_7_0">
    <VALUE Lang="GS">(giggles)... Aww, you now understood... But what can you do?</VALUE>
    <VALUE Lang="GS">I have no intention to give these precious treasure back to you! (giggles)...</VALUE>
    <VALUE Lang="GS">However, I am the man of my word!</VALUE>
    <VALUE Lang="GS">I will give you the reward which I have promised you for getting these Gold Coins.</VALUE>
    <VALUE Lang="id">Baru mengerti sekarang? *(hahaha)</VALUE>
    <VALUE Lang="id">Saya tidak ingin memberikannya kembali...</VALUE>
    <VALUE Lang="id">Tenang, saya adalah pria yang pegang janji!</VALUE>
    <VALUE Lang="id">Ini adalah hadiah yang telah saya janjikan.</VALUE>
    <VALUE Lang="cn">（颗颗）......噢，你现在明白了吗？......但是现在您能做些什么呢？</VALUE>
    <VALUE Lang="cn">我不打算把这些珍贵的宝物还给你！ （嘿嘿）...</VALUE>
    <VALUE Lang="cn">不过，我以男人的尊严向你保证！</VALUE>
    <VALUE Lang="cn">我会给你相对于Gold Coin的奖励的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_7_0_1">
    <VALUE Lang="GS">Reward...? What is it?</VALUE>
    <VALUE Lang="id">Hadiah...? Apa itu?</VALUE>
    <VALUE Lang="cn">奖励…？那是啥？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_8_0">
    <VALUE Lang="GS">Well, about now, the monsters should be looking all over for you, as crazy as they can be...</VALUE>
    <VALUE Lang="GS">You are in a great danger... (giggles)</VALUE>
    <VALUE Lang="GS">My reward will be of a great help when you are hunted by those angry monsters... (giggles) Monsters might come at any minute now! I don't want to get involved in it, so hurry up and decide whether to take my reward or not and leave this place!</VALUE>
    <VALUE Lang="id">Kamu dalam bahaya karena semua monster mencari kamu sekarang... (hahaha)</VALUE>
    <VALUE Lang="id">hadiah saya akan menjadi sangat penting ketika kamu dikejar musuh kuat... Monster bisa datang kapan saja karena mereka semua mencari kamu untuk balas dendam! Putuskan mau ambil atau</VALUE>
    <VALUE Lang="cn">好了，现在这个时刻，怪物正疯狂似的到处找您，…..</VALUE>
    <VALUE Lang="cn">您深陷危险中唷…...（啧啧）</VALUE>
    <VALUE Lang="cn">我的奖励品将能帮助您逃脱怪物们的追杀...（嘿嘿）</VALUE>
    <VALUE Lang="cn">怪物随时都会出现！我不想被牵扯到，所以快点决定是否要跟我领取奖励，还是要离开这个地方！请快点。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_8_0_1">
    <VALUE Lang="GS">Accept the Reward</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">领取奖励</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_8_0_2">
    <VALUE Lang="GS">Do not Accept the Reward</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">不收奖励</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_9_0">
    <VALUE Lang="GS">Aww.. Come on... I am sorry for tricking you...! Take this now before the monsters barge into this place!</VALUE>
    <VALUE Lang="id">Aww.. Ayolah... Maaf membohongimu!</VALUE>
    <VALUE Lang="cn">噢…..拜托...我很抱歉欺骗了你......！现在，在怪物闯进这个地方之前，我们需要这个！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_st partick.ntk_9_0_1">
    <VALUE Lang="GS">Angry but accept the gift anyway.</VALUE>
    <VALUE Lang="id">Marah dan menerima hadiahnya.</VALUE>
    <VALUE Lang="cn">虽然生气，但还是接受礼物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_suryun.ntk_1_0">
    <VALUE Lang="GS">Hello...</VALUE>
    <VALUE Lang="id">Hello...</VALUE>
    <VALUE Lang="cn">哈喽……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_event_suryun.ntk_1_0_1">
    <VALUE Lang="GS">Trade</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0">
    <VALUE Lang="GS">This is for the Extra Stage.</VALUE>
    <VALUE Lang="GS">Hurry and take this, if you want to go there and check it out.</VALUE>
    <VALUE Lang="id">Ini adalah buss untuk ExtraStage</VALUE>
    <VALUE Lang="id">Bagi mereka yang ingin mengikuti silahkan naik secepatnya</VALUE>
    <VALUE Lang="cn">这个是竞技场.</VALUE>
    <VALUE Lang="cn">如果要进入,快点购买</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_1">
    <VALUE Lang="GS">Take Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_2">
    <VALUE Lang="GS">Take Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_3">
    <VALUE Lang="GS">Take Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_4">
    <VALUE Lang="GS">Take Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_5">
    <VALUE Lang="GS">Take Bus</VALUE>
    <VALUE Lang="id">Naik Bus</VALUE>
    <VALUE Lang="cn">搭乘公车</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_extra_e_bus.ntk_1_0_6">
    <VALUE Lang="GS">Buy Bus Ticket</VALUE>
    <VALUE Lang="id">Buy Bus Ticket</VALUE>
    <VALUE Lang="cn">购买公车票</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0">
    <VALUE Lang="GS">I'm deployed here to conduct the orders from Saint Foundation. What can I do for you?</VALUE>
    <VALUE Lang="id">Saya ditugaskan disini untuk melakukan perintah dari Saint Foundation. Ada yang bisa saya bantu ?</VALUE>
    <VALUE Lang="cn">我来这里是负责执行自圣财团指派的任务。</VALUE>
    <VALUE Lang="cn">有什么想要知道的吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_1">
    <VALUE Lang="GS">Eliminate Life Weapon</VALUE>
    <VALUE Lang="id">Memusnahkan Life Weapon</VALUE>
    <VALUE Lang="cn">歼灭Life Weapon</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_2">
    <VALUE Lang="GS">Geth the tissue sample</VALUE>
    <VALUE Lang="id">Mendapatkan sample tissue</VALUE>
    <VALUE Lang="cn">收集薄纸标本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_3">
    <VALUE Lang="GS">Deliver the tissue sample</VALUE>
    <VALUE Lang="id">Mengantarkan sample tissue</VALUE>
    <VALUE Lang="cn">交付薄纸标本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_1_0_4">
    <VALUE Lang="GS">Secure way out</VALUE>
    <VALUE Lang="id">Cara keluar yang aman</VALUE>
    <VALUE Lang="cn">确认撤退路线</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_2_0">
    <VALUE Lang="GS">What Ryuin delivered can be reported together with mine at the same time after finishing my mission. Apart from this, can you help me? This is a secret introduction, though, I can't do it by myself. I heard the enemy have biological weapons. Can you check whether they really exist and destroy them instead?</VALUE>
    <VALUE Lang="id">Apa pengiriman Ryuin dapat di laporkan bersamamaan setelah menyelesaikan misi yang saya berikan. Selain itu, apakah kamu dapat membantu saya ? Ini adalah perkenalan rahasia, walaupun, saya tidak bisa melakukan sendiri. Saya dengar musuh memiliki senjata b</VALUE>
    <VALUE Lang="cn">Ryuin提到的事情等我的任务完成再跟他回报也可以。可以先帮我吗？</VALUE>
    <VALUE Lang="cn">雖然是機密任務.....不過一個人要完成還是有困難....聽說敵軍有變種生物已經確認他們確實存在，</VALUE>
    <VALUE Lang="cn">可以帮忙消灭他们吗？拜托你了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_3_0">
    <VALUE Lang="GS">What Saint Foundation though was true! I can't even imagine what could happen to me if I went there alone. I'm sorry to keep asking you for favors, but, can I ask one more? Can you get me some tissue samples from biological weapons?</VALUE>
    <VALUE Lang="id">Apa yang di curigai Saint Foundation benar! Saya tidak membayangkan apa yang terjadi jika saya kesana sendirian. Maaf saya terus meminta bantuan kepada kamu, tapi bisakah saya meminta tolong satu kali lagi ? Dapatkah kamu mendapatkan beberapa tissue sampl</VALUE>
    <VALUE Lang="cn">Saint Foundation预测的没错！我自己前往一定会有危险。可以拜托你一件事吗？</VALUE>
    <VALUE Lang="cn">帮忙消灭Biological weapons，然后把搜集到的Tissue samples交给我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_4_0">
    <VALUE Lang="GS">You are much better than expected always! Thank you. I will remember what you've done for me. Ah, I saw the Physics Teacher around here! You could get some goods you need.</VALUE>
    <VALUE Lang="id">Kamu lebih baik dari yang saya perkirakan ! Terima Kasih. Saya akan mengingat apa yang kamu lakukan untuk saya. Ah, saya lihat Physics Teacher sekitar sini! Kamu dapat mendapatkan sesuatu yang kamu butuhkan.</VALUE>
    <VALUE Lang="cn">还是你最值得信任，谢谢你！等这里的情况处理完一定会给你奖励！</VALUE>
    <VALUE Lang="cn">如果你有缺什么道具可以去找这里的Physics Teacher。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_5_0">
    <VALUE Lang="GS">I'm deeply sorry but I have one more favor. I was to get back to Saint Foundation, though, there are a plenty of monsters and enemies all around. Can you secure my way back to the Saint Foundation? This would be my last favor.</VALUE>
    <VALUE Lang="id">Saya minta maaf tapi saya memiliki satu permintaan. Saya harus kembali ke Saint Foundation, Tetapi, ada banyak monster dan musuh di sekitar. Dapatkah kamu mengamankan jalan saya kembali ke Saint Foundation ? Ini permintaan terakhir saya.</VALUE>
    <VALUE Lang="cn">真的很不好意思，还有一件事需要请你帮忙。</VALUE>
    <VALUE Lang="cn">我需要回去圣财团回报，不过因为路上有太多敌人回不去。</VALUE>
    <VALUE Lang="cn">可不可以请你帮忙确认撤退路线。这次真的是最后一次拜托你了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_agent.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0">
    <VALUE Lang="GS">I'm here to give support in students injured. Just tell me if there is anything I can help you.</VALUE>
    <VALUE Lang="id">Aku disini untuk menyembuhkan pelajar yang terluka. Beritahu aku apabila kalian membutuhkan bantuan.</VALUE>
    <VALUE Lang="cn">我专门提供药物给学生。有什么需要我帮忙的，请尽管说，不用客气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_1">
    <VALUE Lang="GS">Item Trade</VALUE>
    <VALUE Lang="id">Item Trade</VALUE>
    <VALUE Lang="cn">物品交易</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_2">
    <VALUE Lang="GS">Set as Starting Point</VALUE>
    <VALUE Lang="id">Rubah save point</VALUE>
    <VALUE Lang="cn">设为起点位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_3">
    <VALUE Lang="GS">Get first-aid kit</VALUE>
    <VALUE Lang="id">Dapatkan first-aid kit</VALUE>
    <VALUE Lang="cn">取得 First-aid kit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_1_0_4">
    <VALUE Lang="GS">Deliver first-aid kit</VALUE>
    <VALUE Lang="id">Berikan first-aid kit</VALUE>
    <VALUE Lang="cn">转交 First-aid kit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_2_0">
    <VALUE Lang="GS">On my way here, most of the first-aid boxes was stolen by Monsters so that I'm in difficulty with helping students. Can you get them back from the Monsters?</VALUE>
    <VALUE Lang="id">Dalam perjalananku kesini, sebagian besar first-aid box dicuri oleh monster, aku akan kesulitan tanpanya. Bisakah kamu merebutnya kembali dari para monster?</VALUE>
    <VALUE Lang="cn">我在来的路上，一堆怪物突然跑出来，并且抢走了大部分的First-aid box 。现在我想要帮助学生都很困难，现在可以麻烦您帮我把这些‘急救箱’夺回来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_3_0">
    <VALUE Lang="GS">Really appreciated. Please bring me more first-aid boxes.</VALUE>
    <VALUE Lang="id">Terimakasih banyak. Tolong bawakan lebih banyak first-aid box.</VALUE>
    <VALUE Lang="cn">很谢谢您。请把更多的First-aid box 交给我好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_helper.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0">
    <VALUE Lang="GS">Welcome to Ground Zero. It will be harder than you think.</VALUE>
    <VALUE Lang="id">Selamat datang di Ground Zero. Tempat ini lebih menyeramkan daripada yang kau kira.</VALUE>
    <VALUE Lang="cn">欢迎来到 Ground Zero。这里比您想象中的还要艰辛困难。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_1">
    <VALUE Lang="GS">Talk with Student Director</VALUE>
    <VALUE Lang="id">Bicara ke Student Director</VALUE>
    <VALUE Lang="cn">和Student Director进行对话</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_10">
    <VALUE Lang="GS">Final Report</VALUE>
    <VALUE Lang="id">Laporan akhir</VALUE>
    <VALUE Lang="cn">最后回报</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_11">
    <VALUE Lang="GS">Reach Level 225</VALUE>
    <VALUE Lang="id">Capailah level 225</VALUE>
    <VALUE Lang="cn">达成等级 225</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_12">
    <VALUE Lang="GS">Reach Level 230</VALUE>
    <VALUE Lang="id">Capailah level 230</VALUE>
    <VALUE Lang="cn">达成等级 230</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_13">
    <VALUE Lang="GS">Reach Level 235</VALUE>
    <VALUE Lang="id">Capailah level 235</VALUE>
    <VALUE Lang="cn">达成等级 235</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_14">
    <VALUE Lang="GS">Reach Level 240</VALUE>
    <VALUE Lang="id">Capailah level 240</VALUE>
    <VALUE Lang="cn">达成等级 240</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_15">
    <VALUE Lang="GS">Reach Level 225 Report</VALUE>
    <VALUE Lang="id">Lapor telah mencapai level 225</VALUE>
    <VALUE Lang="cn">回报达成等级 225</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_16">
    <VALUE Lang="GS">Reach Level 230 Report</VALUE>
    <VALUE Lang="id">Lapor telah mencapai level 230</VALUE>
    <VALUE Lang="cn">回报达成等级 230</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_17">
    <VALUE Lang="GS">Reach Level 235 Report</VALUE>
    <VALUE Lang="id">Lapor telah mencapai level 235</VALUE>
    <VALUE Lang="cn">回报达成等级 235</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_18">
    <VALUE Lang="GS">Reach Level 240 Report</VALUE>
    <VALUE Lang="id">Lapor telah mencapai level 240</VALUE>
    <VALUE Lang="cn">回报达成等级 240</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_19">
    <VALUE Lang="GS">The Past Still Present</VALUE>
    <VALUE Lang="id">Masa lalu adalah saat ini</VALUE>
    <VALUE Lang="cn">挥之不去的过去</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_2">
    <VALUE Lang="GS">Eliminate Scouter</VALUE>
    <VALUE Lang="id">Kalahkan Scouter</VALUE>
    <VALUE Lang="cn">歼灭 Scouter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_20">
    <VALUE Lang="GS">Report the result</VALUE>
    <VALUE Lang="id">Laporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_21">
    <VALUE Lang="GS">The call for final attack</VALUE>
    <VALUE Lang="id">Panggilan serangan akhir</VALUE>
    <VALUE Lang="cn">最后攻击的召唤</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_3">
    <VALUE Lang="GS">Eliminate Elite Scouter</VALUE>
    <VALUE Lang="id">Kalahkan Elite Scouter</VALUE>
    <VALUE Lang="cn">歼灭 Elite Scouter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_4">
    <VALUE Lang="GS">Acquire Scouter Badge</VALUE>
    <VALUE Lang="id">Dapatkan Scouter Badge</VALUE>
    <VALUE Lang="cn">取得 Scouter 徽章</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_5">
    <VALUE Lang="GS">Deliver Scouter Badge</VALUE>
    <VALUE Lang="id">Berikan Scouter Badge</VALUE>
    <VALUE Lang="cn">转交 Scouter 徽章</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_6">
    <VALUE Lang="GS">Get the directive of search</VALUE>
    <VALUE Lang="id">Carilah petunjuk</VALUE>
    <VALUE Lang="cn">取得侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_7">
    <VALUE Lang="GS">Report the result</VALUE>
    <VALUE Lang="id">Laporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_8">
    <VALUE Lang="GS">Deliver the Attack Directive</VALUE>
    <VALUE Lang="id">Berikan petunjuk penyerangan</VALUE>
    <VALUE Lang="cn">转达 攻击指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_1_0_9">
    <VALUE Lang="GS">Eliminate The Commander</VALUE>
    <VALUE Lang="id">Kalahkan Commander</VALUE>
    <VALUE Lang="cn">歼灭 Commander</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_10_0">
    <VALUE Lang="GS">So..Well.. The final battle is to begin. Don't look down on the boss! You should be more careful. Beating them all is important, but the safety comes first. Good luck!</VALUE>
    <VALUE Lang="id">Jadi.. Pertarungan terakhir sudah dimulai. Jangan meremehkan Boss mereka, berhati-hatilah. Mengalahkan mereka itu penting, tapi keselamatan kalian lebih penting. Semoga beruntung!</VALUE>
    <VALUE Lang="cn">哎….终于到了要一决胜负的时候了。对方可是首领，绝不可大意。虽然非赢不可，但安全是最重要的！祝您好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_11_0">
    <VALUE Lang="GS">Oh..It's more than I've expected! There's no doubt that we can confront and overcome any sort of threats! Every students and teachers will remember and eulogize you forever!</VALUE>
    <VALUE Lang="id">Oh.. Ini lebih bagus daripada yang kubayangkan! Tak bisa dipungkiri lagi, kita bisa melawan dan mengatasi semua ancaman! Setiap pelajar dan guru akan mengingat dan mengenangmu selamanya!</VALUE>
    <VALUE Lang="cn">您真的很厉害！相信无论是多么危险的情况，我们一定可以大获全胜的。我们永远会记得您。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_12_0">
    <VALUE Lang="GS">Waited for you! The remains of the defense line have been being collapsed while the cleanup party had already got into Chaos Island. I desperately want to clutch at any straw now! Can you help us out? Please..It will be defintely a big help for us.</VALUE>
    <VALUE Lang="id">Sudah lama aku menunggumu! Sisa pejuang yang tersisa telah dikalahkan sementara pejuang lainnya telah pergi ke Chaos Island. Aku sebenarnya tidak ingin merepotkanmu, akan tetapi bisakah kau membantuku? Tolong.. Ini akan sangat membantu kami.</VALUE>
    <VALUE Lang="cn">您终于来了！后勤支援进入了Chaos Island，破坏了最后一道防线。现在是需要大家支援的时候了。即便是微薄之力。您可以帮忙支援吗？拜托您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_12_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_13_0">
    <VALUE Lang="GS">Thank you!! Thank you very much! You save us all!</VALUE>
    <VALUE Lang="id">Terimakasih! Terimakasih! Davay dasdivaniya!</VALUE>
    <VALUE Lang="cn">谢谢您！非常感谢。您拯救了我们！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_13_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_2_0">
    <VALUE Lang="GS">Thank you for responding to our call. We are in the serious situation now. So we desperately need your help! It's going to be so painful time.</VALUE>
    <VALUE Lang="id">Terimakasih sudah merespon panggilan kami, keadaan kami sangat genting. Kami sangat membutuhkan bantuanmu! Ini adalah masa yang sangat sulit.</VALUE>
    <VALUE Lang="cn">谢谢您加入招募选拔。不晓得我们会遭遇多大的危险，各位一定要帮帮忙。这将会是一场激励了的战斗。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_3_0">
    <VALUE Lang="GS">The advance party is almost done for observing enemy movement now. Eliminate the enemies closest to you. Kill Scouter.</VALUE>
    <VALUE Lang="id">Tim pengintai hampir selesai mengobservasi pergerakan musuh. Kalahkan musuh didekatmu. Bunuh Scouter.</VALUE>
    <VALUE Lang="cn">先锋部队已经掌握了敌军的行踪！请按照顺序，先消灭最靠近您的Scouter。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_4_0">
    <VALUE Lang="GS">It seems as if the advance party is almost done for observing enemy movement now. Eliminate the enemies closest to you. Kill Elite Scouter.</VALUE>
    <VALUE Lang="id">Sepertinya tim pengintai hampir selesai mengobservasi pergerakan musuh. Kalahkan musuh didekatmu. Bunuh Elite Scouter.</VALUE>
    <VALUE Lang="cn">先锋部队已经掌握了敌军的行踪！请按照顺序，先消灭最靠近您的Elite Scouter。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_5_0">
    <VALUE Lang="GS">We are to build the final defense line to make enemies stay in the Ground Zero. To do that, get me the spoils taken from the enemies. Then you deserve the rewards!</VALUE>
    <VALUE Lang="id">Kami akan membangun benteng pertahanan terakhir untuk mencegah musuh berpindah dari Ground Zero. Untuk bisa melakukan itu, kita harus merampas persediaan musuh. Setelah itu kamu akan mendapat hadiah!</VALUE>
    <VALUE Lang="cn">为了不让敌人离开Ground Zero，一定要建立最后一道防线。绝不能让他们逃出这里。请把他们消灭后，回报给我，如此您将能得到奖励。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_6_0">
    <VALUE Lang="GS">Great! Along with your own power, please save the final defense line!</VALUE>
    <VALUE Lang="id">Bagus! Dengan kekuatanmu sendiri, mari pertahankan benteng pertahanan ini.</VALUE>
    <VALUE Lang="cn">太好了！希望您可以继续撑住！一定要守住最后一道防线。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_7_0">
    <VALUE Lang="GS">It seems as if the enemies move upon a directive of their boss. Some of them definitely have instructions. Please eliminate them and bring it to me!</VALUE>
    <VALUE Lang="id">Sepertinya musuh bergerak sesuai dengan petunjuk bossnya. Sebagian dari mereka memiliki instruktor sendiri. Kalahkan mereka dan bawa kehadapanku!</VALUE>
    <VALUE Lang="cn">敌军似乎是收到指令才开始行动的！那个指令一定藏在某人身上。请消灭他们，并拦截那份指令书。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_8_0">
    <VALUE Lang="GS">Oh… It was true! They've been ordered by their boss. Hm.. But it's all encrypted. Hard to get across it.</VALUE>
    <VALUE Lang="id">Ohh. Jadi itu benar! Merekadiperintah oleh Bossnya. Hmm.. Tapi semua ini mencurigakan. Sulit untuk melewatinya.</VALUE>
    <VALUE Lang="cn">噢！是真的！他们的确是根据指令在行动的。不过，该指令书已加了密，无法进行阅读。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_9_0">
    <VALUE Lang="GS">Head toward the Technical Teacher with the directive taken from the enemies. He could decipher the message!</VALUE>
    <VALUE Lang="id">Pergi ke Tachnical Teacher dengan membawa petunjuk dari musuh. Dia bisa mengenkripsinya!</VALUE>
    <VALUE Lang="cn">Technical Teacher 应该能帮忙解码。请把这份指令交给他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_master1.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0">
    <VALUE Lang="GS">It's not a good situation here. Can you help us?</VALUE>
    <VALUE Lang="id">Situasinya tidak bagus disini. Bisakah kamu membantuku?</VALUE>
    <VALUE Lang="cn">这情况不太对劲！.您能帮帮我们吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_1">
    <VALUE Lang="GS">Deliver deciphered directive of search</VALUE>
    <VALUE Lang="id">Berikan petunjuk yang didapat</VALUE>
    <VALUE Lang="cn">传达解码的侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_10">
    <VALUE Lang="GS">Report the result</VALUE>
    <VALUE Lang="id">Laporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_11">
    <VALUE Lang="GS">Report the result</VALUE>
    <VALUE Lang="id">Laporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_2">
    <VALUE Lang="GS">Eliminate The Chaser</VALUE>
    <VALUE Lang="id">Kalahkan Chaser</VALUE>
    <VALUE Lang="cn">消灭 Chaser</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_3">
    <VALUE Lang="GS">Find where is dispatched agent</VALUE>
    <VALUE Lang="id">Temukan dispatched agent</VALUE>
    <VALUE Lang="cn">寻找Dispatched agent 的行踪</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_4">
    <VALUE Lang="GS">Get the Attack directives</VALUE>
    <VALUE Lang="id">Dapatkan petunjuk penyerangan</VALUE>
    <VALUE Lang="cn">领取Attack指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_5">
    <VALUE Lang="GS">Deliver the Attack Directives</VALUE>
    <VALUE Lang="id">Berikan petunjuk penyerangan</VALUE>
    <VALUE Lang="cn">转达Attack指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_6">
    <VALUE Lang="GS">Secure the entry way</VALUE>
    <VALUE Lang="id">Amankan jalur masuk</VALUE>
    <VALUE Lang="cn">确认进攻路线</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_7">
    <VALUE Lang="GS">Ask for the final attack command</VALUE>
    <VALUE Lang="id">Meminta perintah penyerangan akhir</VALUE>
    <VALUE Lang="cn">询问最后的攻击指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_8">
    <VALUE Lang="GS">Chaos Begins</VALUE>
    <VALUE Lang="id">Chaos Begins</VALUE>
    <VALUE Lang="cn">混乱的开始</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_1_0_9">
    <VALUE Lang="GS">Report the result</VALUE>
    <VALUE Lang="id">Laporkan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_10_0">
    <VALUE Lang="GS">Thank you! The burden of the rearguard students is now lightened.</VALUE>
    <VALUE Lang="id">Terimakasih! Beban yang ditanggung sekarang lebih ringan.</VALUE>
    <VALUE Lang="cn">谢谢您！多亏您的帮忙，在后方支援的学生才免于迫害。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_2_0">
    <VALUE Lang="GS">Are you the student the Technical Teacher sent? Ah..wait for seconds.</VALUE>
    <VALUE Lang="id">Apakah kamu pelajar yang diutus oleh Technical teacher? Ah.. Tunggu dulu.</VALUE>
    <VALUE Lang="cn">是Technical Teacher派您来的吗？ 请稍等唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_3_0">
    <VALUE Lang="GS">It all came true. They've been moving upon the directive of their boss. Hm, everybody reports to the Chaser, then the Chaser must be the leader of Searcher Unit. OK, then she is the one you have to eliminate first! There's no time to hesitate! Go!</VALUE>
    <VALUE Lang="id">Semua menjadi kenyataan. Mereka telah pergi sesuai dengan petunjuk dari Bossnya. Hm, semuanya melapor ke Chaser, jadi Chaser adalah pimpinan dari Searcher Unit. Ok, jadi kita harus mengalahkannya terlebih dahulu! Tidak perlu ragu lagi! Hajar!</VALUE>
    <VALUE Lang="cn">他们一定是有根据某种指令，才有办法如此井然有序地到处执行任务。</VALUE>
    <VALUE Lang="cn">嗯，每个人都向 Chaser作报告，所以Chaser 肯定就是敌军的首领。</VALUE>
    <VALUE Lang="cn">很好！她就是您最先要消灭的对象！没有时间了！上吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_4_0">
    <VALUE Lang="GS">Hm.. I need to report current situation of Lost City to Saint Foundation for more students to fight. One of agents from Saint Foundation dispatched would be around here and have a way to communicate with Saint Foundation, but I lost him. Please find him and tell him about this situation instead.</VALUE>
    <VALUE Lang="id">Hm.. Aku perlu laporan situasi terkini di Lost City untuk menarik pelajar lainnya dari Saint Foundation. Salah satu agen dari Saint Fondation berada disini dan bisa menghubungi Foundation, tapi aku kehilangan dia. Tolong cari dia dan beritahu situasi saat</VALUE>
    <VALUE Lang="cn">为了学生，我需要将 Lost City 的状况报告给Saint Foundation，并请求支援。但有位Dispatched agent下落不明，可以请您帮忙找到他，并代替我告诉他这里的状况吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_5_0">
    <VALUE Lang="GS">I found within the directives on search that the main force has been delivering the directive of search. Before they send them all, we can interrupt the enemy with snatching the directives. Can you do that?</VALUE>
    <VALUE Lang="id">Aku mendapat info bahwa pasukan utama mereka akan segera datang. Sebelum mereka bisa berkumpul semua, kita harus mengacaukannya. Bisakah kau melakukan itu?</VALUE>
    <VALUE Lang="cn">根据搜查结果显示，敌军主力兵似乎正在传送攻击指令。如果您可以先拦截指令，那么他们的攻击力就会稍微降低。拜托您了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_6_0">
    <VALUE Lang="GS">Great works! Please keep collecting the directive of search as much as possible!</VALUE>
    <VALUE Lang="id">Kerja bagus! Kumpulkan petunjuk-ptunjuk lainnya sebanyak-banyaknya.</VALUE>
    <VALUE Lang="cn">干得好！请继续拦截收集更多的指令！万事拜托了！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_7_0">
    <VALUE Lang="GS">Scientist Teacher sent us details. The boss of the enemies is positioned at the deep inside Chaos Island. The thing is that you will confront many monsters in front. Eliminate them all and secure the entry! Go!</VALUE>
    <VALUE Lang="id">Scientist Teachers telah mengirimkan detailnya. Boss mereka terletak tepat dijantung Chaos Island. Sepertinya kamu harus melewati banyak monster untuk bisa menuju kesana. Kalahkan mereka semua dan amankan jalur kesana!</VALUE>
    <VALUE Lang="cn">Scientist Teacher 寄更多的细节给我们了。. 敌军的总指挥应该是位在Chaos Island得最隐秘处，所以您将会在前方遇到许多的怪物。现在，请您消灭他们，并确保可以进攻的正确路线。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_8_0">
    <VALUE Lang="GS">Thank you so much! Now that we can approach to the boss without a hitch, please report this situation to Student Director and ask the final attack. I'll wait here.</VALUE>
    <VALUE Lang="id">Terimakasih banyak! Sekarang kami bisa menuju Boss tanpa halangan, tolong laporkan hal ini ke Student Director dan aktifkan kode penyerangan akhir. Aku akan menunggu disini.</VALUE>
    <VALUE Lang="cn">太谢谢您了！ 现在我们可以直接去找最终极的首领了！首先，请您将此结果报告给 Student Director，并请他发布最后一道攻击指令！我会在这儿等您唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_9_0">
    <VALUE Lang="GS">I feel strange here. I assume that the enemy decides to advance to attack. It may damage the students in rear. Can you gain time?</VALUE>
    <VALUE Lang="id">Aneh sekali disini. Aku rasa mereka telah merubah arah serangan. Ini bisa berakibat fatal pada para pelajar. Bisakah kamu mengulur waktu?</VALUE>
    <VALUE Lang="cn">感觉这边怪怪的。假设敌人预先进行攻击，那么在后方支援的学生们就会遭到极大的伤害。您可以帮我们争取更多的时间吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_ruin.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0">
    <VALUE Lang="GS">Why I've dispatched here is… to collect the technical resources.</VALUE>
    <VALUE Lang="id">Tujuanku dikirim kesini adalah… untuk mengumpulkan sumber daya yang tersedia.</VALUE>
    <VALUE Lang="cn">为何我被派遣到这儿？…. 是为了收集技术资源。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_1">
    <VALUE Lang="GS">Deliver the directive of search</VALUE>
    <VALUE Lang="id">Berikan petunjuk yang didapat</VALUE>
    <VALUE Lang="cn">传达侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_2">
    <VALUE Lang="GS">Get the code-breaking kit</VALUE>
    <VALUE Lang="id">Dapatkan code-breaking kit</VALUE>
    <VALUE Lang="cn">取得解码工具</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_3">
    <VALUE Lang="GS">Deliver the code-breaking kit</VALUE>
    <VALUE Lang="id">Berikan code-breaking kit</VALUE>
    <VALUE Lang="cn">转交解码工具</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_4">
    <VALUE Lang="GS">Secure the entry way 1</VALUE>
    <VALUE Lang="id">Amankan jalan masuk 1</VALUE>
    <VALUE Lang="cn">确认进攻路线 1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_5">
    <VALUE Lang="GS">Secure the entry way 2</VALUE>
    <VALUE Lang="id">Amankan jalan masuk 2</VALUE>
    <VALUE Lang="cn">确认进攻路线 2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_6">
    <VALUE Lang="GS">Collect Weapon Parts</VALUE>
    <VALUE Lang="id">Kumpulkan part senjata</VALUE>
    <VALUE Lang="cn">收集武器零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_7">
    <VALUE Lang="GS">Collect Weapon Parts</VALUE>
    <VALUE Lang="id">Kumpulkan part senjata</VALUE>
    <VALUE Lang="cn">收集武器零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_8">
    <VALUE Lang="GS">Deliver deciphered directive of search</VALUE>
    <VALUE Lang="id">Berikan petunjuk yang didapat</VALUE>
    <VALUE Lang="cn">转交解码的侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_1_0_9">
    <VALUE Lang="GS">Deliver again the directive of search</VALUE>
    <VALUE Lang="id">Berikan petunjuk yang didapat</VALUE>
    <VALUE Lang="cn">再次转交解码的侦查指令</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_10_0">
    <VALUE Lang="GS">Ah, is that a new directive on search taken from the enemies? I'll start to decrypt it right away.</VALUE>
    <VALUE Lang="id">Ah, apakah itu petunjuk baru dari musuh? Aku akan mengenkripsinya segera.</VALUE>
    <VALUE Lang="cn">噢！这是最新的搜查敌军指令吗？我马上进行解码。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_2_0">
    <VALUE Lang="GS">The encrypted structure of this enemy's directive on search from Student Director is different. I can't decrypt it right away, but what if you get me the code-breaking kit?</VALUE>
    <VALUE Lang="id">Kode petunjuk enksripsi dari musuh yang diberikan Student Director berbeda. Aku tidak bisa mengenkripsinya, tolong bantu aku mencari code-breaking kit.</VALUE>
    <VALUE Lang="cn">Student Director给的敌军指令密码的构造太难解了。我实在是无法胜任。不过要是您有解码工具的话，我可以成功的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_3_0">
    <VALUE Lang="GS">Some of enemies might have the code-breaking kit. If I get it, I can use it for deciphering the code soon!</VALUE>
    <VALUE Lang="id">Sebagian musuh mungkin mempunyai code-breking kit. Apabila aku memilikinya aku bisa mengenkripsi kode ini segera.</VALUE>
    <VALUE Lang="cn">可能有不少敌人已经拿到解码工具了。如果我拿到它，我就可以进行快速的解码了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_4_0">
    <VALUE Lang="GS">Is this the code-breaking kit? Wait for seconds. It seems that the way to use this kit is not so different from ours. It won't take so long to decrypt it.</VALUE>
    <VALUE Lang="id">Inikah code-breaking kit itu? Tunggu sebentar. Sepertinya ini cukup mirip dengan apa yang biasa kami gunakan. Tak akan lama lagi untuk memecahkannya.</VALUE>
    <VALUE Lang="cn">我们发现这加密手续方式很不寻常，不易解开。请您试着从敌方那儿取得解码工具。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_5_0">
    <VALUE Lang="GS">Hello, again! Code-breaking works is almost done. I need to deliver this to Ryuin if I'm done with it, but there are a bunch of monsters. Can you secure the entry way to him?</VALUE>
    <VALUE Lang="id">Hallo! Code-Breakingnya berhasil, hampir selesai sekarang. Aku perlu mengirimkan ini ke Ryuin apabila sudah selesai, tapi diluar sangat berbahaya, bisakah kamu mengantarkannya untukku?</VALUE>
    <VALUE Lang="cn">又见面了！解码的手续快结束了！等等我就会把它交给 Ryuin。可是有一群怪物卡在那儿。您可以帮他确认安全的入口路线吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_6_0">
    <VALUE Lang="GS">Appreciate your help, though, there are plenty of monsters left still. Please keep working on it more. Thank you.</VALUE>
    <VALUE Lang="id">Terimakasih atas bantuanmu, walaupun masih ada beberapa musuh tersisa. Teruslah berjuang!!</VALUE>
    <VALUE Lang="cn">感激您的帮忙。但还是有很多怪物在那儿。请继续奋斗！拜托您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_7_0">
    <VALUE Lang="GS">I've checked on the weapons and arms of the enemies, and technically, they are much more prominent than ours. Can you get the parts of them? I'll analyze them, and it will be defintely helpful for us.</VALUE>
    <VALUE Lang="id">Aku sudah mengecek persenjataan musuh dan sepertinya mereka lebih maju daripada kita. Bisakah kamu mencari part lainnya? Aku akan menganalisanya, itu akan sangat membantu.</VALUE>
    <VALUE Lang="cn">敌人武器的火力似乎比我们强很多。您能帮我们收集一些零件过来吗？我会分析它们，并研发出对我们有益的成果。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_8_0">
    <VALUE Lang="GS">Thank you! But the parts have been broken while I'm doing a research on it. The more get the parts, the better I can do my research. Can you keep getting them for me?</VALUE>
    <VALUE Lang="id">Terimakasih! Tapi part ini sudah rusak saat kuanalisa. Semakin banyak part yang kau kumpulkan maka penelitianku akan semakin cepat.</VALUE>
    <VALUE Lang="cn">谢谢您！但是有个部分破损了，我正在研究中。这部分的零件越多，我的研究就越顺利。您可以继续帮我收集吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_9_0">
    <VALUE Lang="GS">Finally I'm done with decryption!! It contains the important messages for the advance party. Can you hand it over to Ryuin?</VALUE>
    <VALUE Lang="id">Akhirnya selesai juga! Ini berisi info penting untuk tim pengintai. Bisakah kamu memberikannya kepada Ryuin?</VALUE>
    <VALUE Lang="cn">我终于解码成功！这重要的信息是属于先锋部队的。您能帮我交给 Ryuin吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t1.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0">
    <VALUE Lang="GS">It's impossible. It's superphysical. How come have they done this? It could bring a terrible disaster…</VALUE>
    <VALUE Lang="id">Ini Mustahil. Ini superphysical. Bagaimana mereka yang sudah datang kesini melakukannya ? Ini akan membawa bencana yang mengerikan…</VALUE>
    <VALUE Lang="cn">这次的情况没办法用物理学来解释。出现这种情况不知道会不会带来什么灾难</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_1">
    <VALUE Lang="GS">Item Trade</VALUE>
    <VALUE Lang="id">Transaksi Item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_2">
    <VALUE Lang="GS">Deliver Blood Sample</VALUE>
    <VALUE Lang="id">Mengirimkan Blood Sample</VALUE>
    <VALUE Lang="cn">传递血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_3">
    <VALUE Lang="GS">Block the supplies passage</VALUE>
    <VALUE Lang="id">Menghalangi pengiriman persediaan</VALUE>
    <VALUE Lang="cn">封锁补给路线</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_4">
    <VALUE Lang="GS">Report the result</VALUE>
    <VALUE Lang="id">Melaporkan Hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_5">
    <VALUE Lang="GS">Eliminate The Transformer</VALUE>
    <VALUE Lang="id">Memusnahkan Transformer</VALUE>
    <VALUE Lang="cn">歼灭Transformer</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_1_0_6">
    <VALUE Lang="GS">Report the result</VALUE>
    <VALUE Lang="id">Melaporkan Hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_2_0">
    <VALUE Lang="GS">Oh! Surprised! How did you find me? I've been waiting for someone coming because Scientist Teacher asked me a favor. I forgot to deliver this message to him as frantically coming here.Can you deliver this message instead of me? He's inside of Collapsed City.</VALUE>
    <VALUE Lang="id">Oh! Mengejutkan! Bagaimana kau menamukanku ? Saya sudah menunggu seseorang datang karena Scientist Teacher memintaku bantunya. Saya lupa untuk mengirimkan pesan ini kepadanya saking paniknya datang kesini. Dapatkan kamu mengirimkan pesan ini menggantikan</VALUE>
    <VALUE Lang="cn">阿...吓我一跳! 你怎么找到我的?刚好有件事需要请人帮忙，我正在等那个人出现，刚好你就出现了!</VALUE>
    <VALUE Lang="cn">来这里之前超能部指导老师曾经拜托我一件事。后来因为太忙竟然忘记告诉他结果。可以拜托你帮忙转达吗?听说超能部指导老师在被摧毁的都市。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_3_0">
    <VALUE Lang="GS">A massive size of army was moving out from inside of the city, and… they were carrying big loads a lot. I guess that they are supplies for armies. Can you cut off them? Ah, but, please be careful the big one. I don't have a good feeling.</VALUE>
    <VALUE Lang="id">Pasukan besar tertara bergerak keluar dari kota, dan…Mereka membawa bawaan besar. Saya rasa itu adalah persediaan untuk tentara. Dapatkah kamu menghalangi mereka ? Ah, tapi tolong berhati-hati yang satu ini. Perasaan saya tidak enak.</VALUE>
    <VALUE Lang="cn">我躲起来前往市中心的时候发现大批敌军前往居住地，带着大批行李看起来像是补给物资。</VALUE>
    <VALUE Lang="cn">可以帮忙拦截敌军的物资吗?对了!要小心体型庞大的人!有种不好的预感</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_4_0">
    <VALUE Lang="GS">Wasn't it hard? You are fantastic! The students in rear will definitely appreciate you a lot.</VALUE>
    <VALUE Lang="id">Apakah itu sulit ? Kamu menakjubkan! Pelajar di belakang pasti sangat menghargaimu.</VALUE>
    <VALUE Lang="cn">这次的任务是有难度的，你还是完成了真厉害!</VALUE>
    <VALUE Lang="cn">看来帮后勤支援减轻不少负担。真的是谢谢你!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_5_0">
    <VALUE Lang="GS">While researching inside of the city, I found a strange enemy in mechanical arms. I couldn't finish my survey because of him. Looks dangerous but you would know what you can do for this, don't you?</VALUE>
    <VALUE Lang="id">Selama meneliti di dalam kota, saya menemukan musuh yang aneh dengan tangan mechanic. Saya tidak dapat menyelesaikan penelitian saya karena dia. Terlihat berbahaya tapi apakah kamu tau apa yang akan kamu lakukan ?</VALUE>
    <VALUE Lang="cn">在那里调查时发现双臂机械人。因为那个家伙中断我的调查。</VALUE>
    <VALUE Lang="cn">虽然很危险不过我想你应该可以胜任，是吧?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_6_0">
    <VALUE Lang="GS">I was right! Thank you so much! I can restart my survey now.</VALUE>
    <VALUE Lang="id">Saya tahu saya benar! Terima Kasih banyak! Saya bisa melanjutkan penelitian saya sekarang.</VALUE>
    <VALUE Lang="cn">果然..我的眼光很准。谢谢你!现在终于可以继续调查了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t2.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0">
    <VALUE Lang="GS">Hm…It's really strange. Really odd creatures are here. Inspires my curiosity a lot. Hope to go back to my lab as soon as possible. Hope that this situation goes end soon.</VALUE>
    <VALUE Lang="id">Hm…Ini sangat aneh. Banyak makhluk aneh disini. Banyak menginspirasi rasa penasaran saya. Berharap kembali ke laboraturium saya secepat mungkin. Berharap situasi ini cepat selesai.</VALUE>
    <VALUE Lang="cn">嗯..这里的生物还真特别..让我愈来愈感到有兴趣。</VALUE>
    <VALUE Lang="cn">好想赶快掌握这里的情况回到实验室</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_1">
    <VALUE Lang="GS">Deliver Blood Sample</VALUE>
    <VALUE Lang="id">Mengirimkan Blood Sample</VALUE>
    <VALUE Lang="cn">交付血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_2">
    <VALUE Lang="GS">Deliver research report on enemy troops</VALUE>
    <VALUE Lang="id">Mengirimkan Hasil Penelitian pada pasukan musuh</VALUE>
    <VALUE Lang="cn">交付敌军相关的研究报告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_3">
    <VALUE Lang="GS">Get the blood sample of Mutant Citizen</VALUE>
    <VALUE Lang="id">Dapatkan Blood Sample of Mutant Citizen</VALUE>
    <VALUE Lang="cn">取得 Mutant Citizen的血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_4">
    <VALUE Lang="GS">Deliver the blood sample of Mutant Citizen</VALUE>
    <VALUE Lang="id">Mengirimkan Blood Sample of Mutant Citizen</VALUE>
    <VALUE Lang="cn">转交 Mutant Citizen的血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_5">
    <VALUE Lang="GS">Get the blood sample of Twisted Soldier</VALUE>
    <VALUE Lang="id">Dapatkan Blood Sample of Twisted Soldier</VALUE>
    <VALUE Lang="cn">取得Twisted Soldier的血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_6">
    <VALUE Lang="GS">Deliver the blood sample of Twisted Soldier</VALUE>
    <VALUE Lang="id">Mengirimkan Blood Sample of Twisted Soldier</VALUE>
    <VALUE Lang="cn">转交Twisted Soldier的血液样本</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_1_0_7">
    <VALUE Lang="GS">Get the reseach report on the size of enemy.</VALUE>
    <VALUE Lang="id">Dapatkan hasil laporan tentang jumlah musuh</VALUE>
    <VALUE Lang="cn">交付敌军兵力相关的研究报告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_2_0">
    <VALUE Lang="GS">Finally I got it! I've desperately needed it. Thank you! Ah, I have something for Ryuin. Wait for seconds..Where did I put it?</VALUE>
    <VALUE Lang="id">Akhirnya saya mendapatkannya! Saya sangat membutuhkan ini. Terima kasih! Ah , saya memiliki sesuatu untuk Ryuin. Tunggu sebentar…Dimana saya menaruhnya?</VALUE>
    <VALUE Lang="cn">终于找到了。真的很需要这样东西，辛苦你了。</VALUE>
    <VALUE Lang="cn">有一个东西需要交给Ryuin....不过放在哪里呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_3_0">
    <VALUE Lang="GS">Ah! Here it is. It's a research report written while searching inside of the city. Please hand it over to Ryuin. He must want it.</VALUE>
    <VALUE Lang="id">Ah! Ini dia. Ini laporan penelitian tertulis saat mencari di dalam kota. Tolong serahkan ke Ryuin. Dia sangat menginginkannya.</VALUE>
    <VALUE Lang="cn">阿...!找到了。调查被摧毁的都市时制作的调查报告，帮我交给Ryuin。</VALUE>
    <VALUE Lang="cn">他一定会需要这份报告</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_4_0">
    <VALUE Lang="GS">Resembles Gorilla.. And a bunch of rare creatures are here, but they are really aggressive. It's my personal request, though, could you get me the blood samples of them?</VALUE>
    <VALUE Lang="id">Menyerupai Gorilla…Dan banyak makhluk langka disini, tapi mereka sangat agresif. Ini permintaan pribadi saya, Dapatkah kamu mendapatkan sample darah mereka ?</VALUE>
    <VALUE Lang="cn">这里有很多稀有的生物。不过他们看起来好像很残暴。</VALUE>
    <VALUE Lang="cn">因为我个人的好奇才特别拜托你的。如果可以帮忙采集血液样本，</VALUE>
    <VALUE Lang="cn">我一定会好好谢谢你</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_5_0">
    <VALUE Lang="GS">Deeply appreciated! I want to proceed my experiments more!</VALUE>
    <VALUE Lang="id">Sangat berharga! Saya ingin melanjutkan percobaan saya lagi!</VALUE>
    <VALUE Lang="cn">谢谢你。愈来愈有研究的欲望</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_6_0">
    <VALUE Lang="GS">Sorry, but I have one more favor for you. Did you see an abnormal living thing with strange arms. Looks really creepy, but I badly want to have a study about it. Can you bring me the blood sample of it?</VALUE>
    <VALUE Lang="id">Maaf, tapi saya memiliki satu permintaan lagi. Apakah kamu melihat makhluk abnormal dengan tangan yang aneh. Terlihat mengerikan, tapi saya sangat ingin mempelajarinya. Dapatkah kamu membawakan Sample darah mereka ?</VALUE>
    <VALUE Lang="cn">不好意思。看样子需要再请你帮一个忙。</VALUE>
    <VALUE Lang="cn">有看到一个手臂很长的生物吗?虽然长的很可怕不过还是想研究看看!</VALUE>
    <VALUE Lang="cn">可以帮忙采集血液样本吗</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_7_0">
    <VALUE Lang="GS">Thank you for your help! Thank you so much! I'll never forget your hard decision on this!</VALUE>
    <VALUE Lang="id">Terima Kasih atas bantuannya ! Terima Kasih Banyak! Saya tidak akan melupakan keputusan sulit yang anda lakukan untuk ini!</VALUE>
    <VALUE Lang="cn">再困难的请求你都可以轻松解决呢!真的是很谢谢你。</VALUE>
    <VALUE Lang="cn">等这里的事情处理完，我一定会给你奖励的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_g0_t3.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0">
    <VALUE Lang="GS">This is the dedicated elevator to Basement 2.</VALUE>
    <VALUE Lang="GS">You must enter the password before you can use it.</VALUE>
    <VALUE Lang="id">Ini adalah lift untuk naik ke lantai 2</VALUE>
    <VALUE Lang="id">Anda tidak bisa menggunakannya kalau tidak mengetahui password</VALUE>
    <VALUE Lang="cn">是到地下2楼去的专用电梯。</VALUE>
    <VALUE Lang="cn">不知道密码的话, 无法使用。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0_1">
    <VALUE Lang="GS">Enter Password</VALUE>
    <VALUE Lang="id">Masukan password</VALUE>
    <VALUE Lang="cn">输入密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0_4">
    <VALUE Lang="GS">Enter Password</VALUE>
    <VALUE Lang="id">Masukan password</VALUE>
    <VALUE Lang="cn">输入密码</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_1_0_5">
    <VALUE Lang="GS">Read Information</VALUE>
    <VALUE Lang="id">Membaca pesan</VALUE>
    <VALUE Lang="cn">阅读资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_4_0">
    <VALUE Lang="GS">Password Error.</VALUE>
    <VALUE Lang="GS">Please try again.</VALUE>
    <VALUE Lang="id">Password salah</VALUE>
    <VALUE Lang="id">Cobalah kembali setelah memeriksanya</VALUE>
    <VALUE Lang="cn">密码出现错误，请确认后再试一次。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_5_0">
    <VALUE Lang="GS">Password Confirmed.</VALUE>
    <VALUE Lang="GS">You may now use the elevator.</VALUE>
    <VALUE Lang="id">Password telah dikonfirmasi</VALUE>
    <VALUE Lang="id">Diizinkan untuk menggunakan lift</VALUE>
    <VALUE Lang="cn">密码输入成功！请使用电梯。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_5_0_1">
    <VALUE Lang="GS">Read Information</VALUE>
    <VALUE Lang="id">Membaca pesan</VALUE>
    <VALUE Lang="cn">阅读资料</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_5_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_6_0">
    <VALUE Lang="GS">Some of the specimens in Basement 2 are spreading…</VALUE>
    <VALUE Lang="GS">Whoever reads this message, please inform the others as soon as possible.</VALUE>
    <VALUE Lang="GS">They have to know that the basement is in critical condition.</VALUE>
    <VALUE Lang="id">Bahan percobaan yang ada di lantai 2 bawah tanah sedang memulai penyebaran</VALUE>
    <VALUE Lang="id">Orang yang pertama kali membaca pesan ini tolong sampaikan keadaan bahaya yang sedang terjadi di bawah tanah</VALUE>
    <VALUE Lang="id">Lantai bawah tanah sangat berbahaya sekarang</VALUE>
    <VALUE Lang="cn">地下2楼部份的实验体正开始扩散。</VALUE>
    <VALUE Lang="cn">先看到这个留言的人, 请将目前地下发生的状况告知外面。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_elevator3f.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0">
    <VALUE Lang="GS">Ermm... I can't see...</VALUE>
    <VALUE Lang="GS">Just where am I?</VALUE>
    <VALUE Lang="GS">It feels like… Like this world is completely different!</VALUE>
    <VALUE Lang="id">Aku tidak bisa melihatnya…</VALUE>
    <VALUE Lang="id">Apakah aku ada di dunia ini</VALUE>
    <VALUE Lang="id">Apakah di dalam diriku ada dunia…</VALUE>
    <VALUE Lang="id">Aku tidak terlihat pada diriku dan dunia tidak terlihat pada dunia….</VALUE>
    <VALUE Lang="id">Hahahahaha…</VALUE>
    <VALUE Lang="cn">我不存...</VALUE>
    <VALUE Lang="cn">这个世上有我吗...</VALUE>
    <VALUE Lang="cn">在我心中有世上吗...</VALUE>
    <VALUE Lang="cn">对我而言我不存在, 对世上而言那个世上也不存在...</VALUE>
    <VALUE Lang="cn">呵呵..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_0_2">
    <VALUE Lang="GS">Ask about Sacred Financial Group's Public Service</VALUE>
    <VALUE Lang="id">Bertanya tentang kegiatan sosial yayasan</VALUE>
    <VALUE Lang="cn">询问Sacred Financial Group的社服活动内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1">
    <VALUE Lang="GS">Student!</VALUE>
    <VALUE Lang="GS">I know how you can pass through this door.</VALUE>
    <VALUE Lang="GS">I would be happy to tell you how if you do some favors for me.</VALUE>
    <VALUE Lang="id">Ini permintaan saya</VALUE>
    <VALUE Lang="id">Aku, aku tahu bagaimana caranya melewati pintu ini</VALUE>
    <VALUE Lang="id">…Ka karena itu..kamu ha harus….melakukan permintaanku</VALUE>
    <VALUE Lang="id">Harus seperti itu</VALUE>
    <VALUE Lang="cn">拜 拜托...</VALUE>
    <VALUE Lang="cn">知.. 知道我..我能通过这扇门的方法吗?</VALUE>
    <VALUE Lang="cn">因..因此…你...要给我帮忙呀</VALUE>
    <VALUE Lang="cn">那样才行</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_2">
    <VALUE Lang="GS">Ask about the Request</VALUE>
    <VALUE Lang="id">Bertanya permintaannya</VALUE>
    <VALUE Lang="cn">询问委托什么</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_3">
    <VALUE Lang="GS">Give the Encyclopedias</VALUE>
    <VALUE Lang="id">Memberikan buku</VALUE>
    <VALUE Lang="cn">交付百科全书</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_4">
    <VALUE Lang="GS">Give the Feathers</VALUE>
    <VALUE Lang="id">Memberikan Feather</VALUE>
    <VALUE Lang="cn">交付羽毛</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_5">
    <VALUE Lang="GS">Ask about Sacred Financial Group's Public Service</VALUE>
    <VALUE Lang="id">Bertanya tentang kegiatan sosial yayasan</VALUE>
    <VALUE Lang="cn">询问Sacred Financial Group的社服活动内容</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_1_6">
    <VALUE Lang="GS">Ask about the day of Phenomenon.</VALUE>
    <VALUE Lang="id">Tanyakan tentang Phenomenon</VALUE>
    <VALUE Lang="cn">询问异变当天的情况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_2">
    <VALUE Lang="GS">I'm sorry, but there's no way you can pass through these gates at your current level.</VALUE>
    <VALUE Lang="GS">Come back again after you get stronger and can prove yourself of being worthy!</VALUE>
    <VALUE Lang="id">Masih…</VALUE>
    <VALUE Lang="id">Dengan kemampuan seperti itu kamu tidak bisa melewati pintu ini</VALUE>
    <VALUE Lang="id">Apa yang harus aku lakukan…</VALUE>
    <VALUE Lang="cn">还是...</VALUE>
    <VALUE Lang="cn">以那样的程度, 是无法通过这扇门</VALUE>
    <VALUE Lang="cn">要怎么做才能</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_1_2_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">变更开始地点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_10_0">
    <VALUE Lang="GS">Sa… Sac... Sacred...</VALUE>
    <VALUE Lang="GS">Hate... Many… Bodies of Tomb…</VALUE>
    <VALUE Lang="GS">Heaven... Rest... Interrupted... Damn people…</VALUE>
    <VALUE Lang="GS">Disobey... Orders... Dangerous…</VALUE>
    <VALUE Lang="id">Sa…sa…in..t</VALUE>
    <VALUE Lang="id">Dulu aku benci….sangat….mayat-mayat di dalam kuburan</VALUE>
    <VALUE Lang="id">Ah…tempat beristirahat….mereka sudah…mengganggu..istirahat saya…</VALUE>
    <VALUE Lang="id">Perintah…yang tidak diakui…berbahaya…</VALUE>
    <VALUE Lang="cn">圣…圣…圣…徒…</VALUE>
    <VALUE Lang="cn">非常… 讨厌… 坟墓里的尸体…</VALUE>
    <VALUE Lang="cn">防碍了安…安息处…安息…那些家伙…</VALUE>
    <VALUE Lang="cn">不承认…秩序…危险</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_11_0">
    <VALUE Lang="GS">Pheo… Pheonomenon? What are you talking about?</VALUE>
    <VALUE Lang="id">Phenomenon ? Apa yang kamu bicarakan ?</VALUE>
    <VALUE Lang="cn">异…..异变？您在说什么咚咚？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_11_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_2_0">
    <VALUE Lang="GS">skip</VALUE>
    <VALUE Lang="id">skip</VALUE>
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_2_0_1">
    <VALUE Lang="GS">Changed Start Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">已变更开始地点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_3_0">
    <VALUE Lang="GS">The entrance to this building was set up with a Force Field function. In order to pass through this door, you must have an Authentication Booklet.</VALUE>
    <VALUE Lang="GS">I can make one for you if you like!</VALUE>
    <VALUE Lang="id">Ah, pintu ini dan itu, ada au..authentication di sekitarnya</VALUE>
    <VALUE Lang="id">Soalnya aku terburu-buru, benar…</VALUE>
    <VALUE Lang="id">Kalau mau melewati pintu ini harus ada surat izin masuk…</VALUE>
    <VALUE Lang="id">Aku bisa mem, membuatnya</VALUE>
    <VALUE Lang="id">Karena itu..tolong ban..tu</VALUE>
    <VALUE Lang="cn">这..这门</VALUE>
    <VALUE Lang="cn">时间不够了, 是呀...</VALUE>
    <VALUE Lang="cn">想要通过门, 要有这认证书才行</VALUE>
    <VALUE Lang="cn">我可以制..制作</VALUE>
    <VALUE Lang="cn">因此, 才拜..拜托你</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_3_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_4_0">
    <VALUE Lang="GS">Now I remember!</VALUE>
    <VALUE Lang="GS">I need 8 pieces of Black Feathers from the Shadow Crows. Please bring them to me.</VALUE>
    <VALUE Lang="GS">Thank you!</VALUE>
    <VALUE Lang="id">Te, terimakasih</VALUE>
    <VALUE Lang="id">Kini…saya sepertinya…sedikit ingat…</VALUE>
    <VALUE Lang="id">Iya…feather</VALUE>
    <VALUE Lang="id">Bawakan feather</VALUE>
    <VALUE Lang="id">Aku butuh bulu yang berwarna hitam</VALUE>
    <VALUE Lang="id">Bawalah delapan buah</VALUE>
    <VALUE Lang="id">Tapi kenapa kok ada 8 buah?</VALUE>
    <VALUE Lang="cn">谢..谢谢</VALUE>
    <VALUE Lang="cn">现在…有点想起来了…</VALUE>
    <VALUE Lang="cn">我需要Shadow Crow的8个黑色羽毛（Black Feather）。</VALUE>
    <VALUE Lang="cn">请带给我好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_5_0">
    <VALUE Lang="GS">I need eight pieces of Enchanted Feathers.</VALUE>
    <VALUE Lang="GS">This is needed to create the Authentication Scroll. Once you have that, you'll be able to pass through the doors.</VALUE>
    <VALUE Lang="GS">Very good! This should be enough!</VALUE>
    <VALUE Lang="id">Delapan buah…feather…</VALUE>
    <VALUE Lang="id">Ba…baiklah</VALUE>
    <VALUE Lang="id">Ini certificate….ini seperti talisman</VALUE>
    <VALUE Lang="id">Kamu bisa melewati pintu itu kalau mempunyai ini</VALUE>
    <VALUE Lang="cn">羽毛.. 8个</VALUE>
    <VALUE Lang="cn">好, 好..</VALUE>
    <VALUE Lang="cn">这里…认证书… 和簿子一样</VALUE>
    <VALUE Lang="cn">拿着这个的话, 现在起就可通过那扇了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_5_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_6_0">
    <VALUE Lang="GS">.....3</VALUE>
    <VALUE Lang="id">.....3</VALUE>
    <VALUE Lang="cn">.....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_7_0">
    <VALUE Lang="GS">Please help me…</VALUE>
    <VALUE Lang="GS">Something is definitely wrong with my head.</VALUE>
    <VALUE Lang="GS">I can't remember anything. Please help me find a book that can help me remember…</VALUE>
    <VALUE Lang="id">Sekarang, kepalaku aneh sekali…tidak ingat dengan baik</VALUE>
    <VALUE Lang="id">Tolong carikan bu, buku</VALUE>
    <VALUE Lang="id">Mawar, dari mawar yang warnanya sudah pudar</VALUE>
    <VALUE Lang="id">Tolong carikan buku</VALUE>
    <VALUE Lang="cn">现在我的..脑袋好奇怪…想不太起来</VALUE>
    <VALUE Lang="cn">把书..书找给我</VALUE>
    <VALUE Lang="cn">蔷薇, 从颜色褪掉的蔷薇...</VALUE>
    <VALUE Lang="cn">把书找给我</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_8_0">
    <VALUE Lang="GS">.....5</VALUE>
    <VALUE Lang="id">.....5</VALUE>
    <VALUE Lang="cn">.....5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_9_0">
    <VALUE Lang="GS">Okay, once you've been authenticated to pass through the doors, you can easily enter and exit this building.</VALUE>
    <VALUE Lang="GS">Please be safe!</VALUE>
    <VALUE Lang="id">Kalau bisa lewat sekali, sekali saja setelah itu bisa keluar masuk dengan bebas</VALUE>
    <VALUE Lang="id">Nah, pergilah</VALUE>
    <VALUE Lang="id">Tapi…siapa saya?</VALUE>
    <VALUE Lang="cn">只要通.. 通过一次, 从下次开始, 就可自由进..进入</VALUE>
    <VALUE Lang="cn">来, 去看看</VALUE>
    <VALUE Lang="cn">但是… 我是谁呀</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_1.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0">
    <VALUE Lang="GS">Hahaha!</VALUE>
    <VALUE Lang="id">Hahaha!</VALUE>
    <VALUE Lang="cn">哈哈哈！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_1">
    <VALUE Lang="GS">Ask What's the Matter</VALUE>
    <VALUE Lang="id">Bertanya apa yang terjadi</VALUE>
    <VALUE Lang="cn">询问怎么回事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_10">
    <VALUE Lang="GS">Ask if he needs anything</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">询问是否需要帮忙？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_2">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Mendengarkan permintaan</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_3">
    <VALUE Lang="GS">Give the Food</VALUE>
    <VALUE Lang="id">Menyerahkan makanan</VALUE>
    <VALUE Lang="cn">分享食物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_4">
    <VALUE Lang="GS">Ask if he is a friend of Suna Jo</VALUE>
    <VALUE Lang="id">Bertanya apakah temannya Suna Jo</VALUE>
    <VALUE Lang="cn">询问他是否为Suna Jo的朋友</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_5">
    <VALUE Lang="GS">Tell him Suna Jo has sent you here</VALUE>
    <VALUE Lang="id">Berkata aku diutus Suna Jo</VALUE>
    <VALUE Lang="cn">回复说是Suna Jo派你来的</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_6">
    <VALUE Lang="GS">Ask what had happened</VALUE>
    <VALUE Lang="id">Bertanya apa saja yang telah terjadi</VALUE>
    <VALUE Lang="cn">询问发生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_7">
    <VALUE Lang="GS">Deliver greetings from Evilplate Monk</VALUE>
    <VALUE Lang="id">Menyampaikan salam dari Evilplate Monk</VALUE>
    <VALUE Lang="cn">转达 Evilplate Monk 的问候</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_8">
    <VALUE Lang="GS">Ask if he needs help with anything</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
    <VALUE Lang="cn">询问是否需要帮忙？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_1_0_9">
    <VALUE Lang="GS">Report the result</VALUE>
    <VALUE Lang="id">Memberitahukan hasil</VALUE>
    <VALUE Lang="cn">回报结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_10_0">
    <VALUE Lang="GS">Oh! Suna has sent you here.. I am getting my memories back somehow since from your last visit.. For a while, my mind was just dim and I was hungry.. But My head is not clear yet.</VALUE>
    <VALUE Lang="id">Kamu diutus Sun-A ya?.. Entah kenapa ingatanku spertinya sudah pulih… saat-saat pikiranku kacau aku hanya merasa sangat kelaparan… namun semua ingatanku tidak begitu jelas terekam di otakku</VALUE>
    <VALUE Lang="cn">噢，是Suna派您来的啊。从您上次来访后，我的记忆开始慢慢地恢复了。之前的确有好一阵子我的神智不是很清醒，也一直都很饿。虽然现在也没好到哪里去…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_10_0_1">
    <VALUE Lang="GS">Tell him you would like to know what happened</VALUE>
    <VALUE Lang="id">Ingin tahu apa yang telah terjadi</VALUE>
    <VALUE Lang="cn">告诉他您想知道发生了什么事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_11_0">
    <VALUE Lang="GS">I only remember someone helping me to get here. She had a very beautiful yet sad eyes but the people she was with looked very scary..</VALUE>
    <VALUE Lang="id">Aku ingat ada banyak orang yang pernah datang kesini untuk membantu. Gadis itu sangat cantik dengan mata yang berkaca-kaca, namun orang-orang disekitar aku sangat mengerikan</VALUE>
    <VALUE Lang="cn">我只记得某人有在帮助我一路走来平安无事。她有着美丽又悲伤的双眼，但跟她走在一起的那些人看起来就很可怕……….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_11_0_1">
    <VALUE Lang="GS">Ask what had happened to them</VALUE>
    <VALUE Lang="id">Bertanya bagaimana kondisi orang-orang tersebut</VALUE>
    <VALUE Lang="cn">询问后来那些人怎么样了？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_12_0">
    <VALUE Lang="GS">We said goodbye in front of the main gate and they were headed to Trading Hole. Then, I met Leonine school Student Director. I wonder what that child is doing right now.. I really would like to know. If you aren't that busy would you please send my regards to her?</VALUE>
    <VALUE Lang="id">Kami berpapasan di main gate kemudian mereka pergi ke arah Trading Hole. Setelah itu aku bertemu Student Director di Leonine School. Aku jadi ingat gadis itu..penasaran bagaimana keadaannya ya?? Kalau kamu tidak sibuk mau ngga temui dia dan sampaikan sala</VALUE>
    <VALUE Lang="cn">我们在Main Gate说再见之后， 他们就往Trading Hole的方向走了。然后，我跑去与Leonine学院的Student Director见面了。我真的很想知道那个孩子过的如何，如果您有时间的话，可以帮我问候一下她吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_12_0_1">
    <VALUE Lang="GS">Tell him you will find it</VALUE>
    <VALUE Lang="id">Bersedia mencarinya</VALUE>
    <VALUE Lang="cn">告诉他您会找找的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_13_0">
    <VALUE Lang="GS">Thanks.. I am really grateful.</VALUE>
    <VALUE Lang="id">Terima kasih… tolong dibantu ya.</VALUE>
    <VALUE Lang="cn">谢谢您，我真的很开心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_13_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_14_0">
    <VALUE Lang="GS">He must be.. worried about me.. But I would like to find out about something first..</VALUE>
    <VALUE Lang="id">Tampaknya… Orang itu sangat ingin tahu kabarku… tapi sebaiknya dicari tahu dulu….</VALUE>
    <VALUE Lang="cn">他应该很担心我…….但我想先找点什么东西…..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_14_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_15_0">
    <VALUE Lang="GS">A student called Stoner had followed me to Leonine School but.. When I was conscious again, he was gone. Recently, a child passing through here told me that he has found a clue in the B 3F..</VALUE>
    <VALUE Lang="id">Ada pelajar adik kelas bernama Seok Hyun, dia mengikutiku ke Leonine School tapi</VALUE>
    <VALUE Lang="cn">以前有个学生叫做Stoner，他曾跟我一起到了Leonine学院，但是，当我幌了一下神，回过头来看，他竟然消失了！最近有个孩子跟我说，他经过Leonine学院的B3时，似乎有找到Stoner的相关线索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_15_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_16_0">
    <VALUE Lang="GS">Oh.. Stoner.. Gee</VALUE>
    <VALUE Lang="id">aaa… Seok Hyun…..kkkk kkk</VALUE>
    <VALUE Lang="cn">噢…..Stoner.. 哇！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_16_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0">
    <VALUE Lang="GS">Please deliver this letter to him</VALUE>
    <VALUE Lang="id">Tolong sampaikan surat ini kepada orang tua itu…</VALUE>
    <VALUE Lang="cn">请将这封信交给他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_17_0_2">
    <VALUE Lang="GS">Deliver the letter</VALUE>
    <VALUE Lang="id">Menyampaikan surat</VALUE>
    <VALUE Lang="cn">请传递信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_2_0">
    <VALUE Lang="GS">skip</VALUE>
    <VALUE Lang="id">skip</VALUE>
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_3_0">
    <VALUE Lang="GS">Very scary…</VALUE>
    <VALUE Lang="GS">Everybody has become scary.</VALUE>
    <VALUE Lang="GS">It wasn't like this before, but after that kid died…</VALUE>
    <VALUE Lang="GS">Everything changed all of a sudden.</VALUE>
    <VALUE Lang="id">Takut….</VALUE>
    <VALUE Lang="id">Karena semuanya menjadi takut….</VALUE>
    <VALUE Lang="id">Padahal dulu tidak begini</VALUE>
    <VALUE Lang="id">Tiba-tiba….</VALUE>
    <VALUE Lang="id">Setelah anak itu mati tiba-tiba….</VALUE>
    <VALUE Lang="cn">好可怕……...之前不是这样子的。自从那个孩子离奇死亡后，大家都变得跟原本不一样了….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_4_0">
    <VALUE Lang="GS">I've gotten very hungry, just hiding in here. I'm too scared to go outside… But… Do you have something I can eat?</VALUE>
    <VALUE Lang="GS">Please spare me some food…</VALUE>
    <VALUE Lang="id">Karena ada di dalam sini saya jadi sangat lapar</VALUE>
    <VALUE Lang="id">Tolong bagi makanan</VALUE>
    <VALUE Lang="id">Aku takut keluar…</VALUE>
    <VALUE Lang="id">Karena itu bagikanlah makanan…</VALUE>
    <VALUE Lang="cn">我好饿，因为我躲在这里太久了……..我也不敢到外头去找食物…. 外头太危险了。请问您有食物可以分给我吗？真的拜托您了……..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_5_0">
    <VALUE Lang="GS">Food?</VALUE>
    <VALUE Lang="GS">Food!</VALUE>
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="GS">Now I can hide in here a while longer… I'll last…</VALUE>
    <VALUE Lang="id">Makanan?</VALUE>
    <VALUE Lang="id">Makanan!</VALUE>
    <VALUE Lang="id">Terimakasih, kini saya bisa terus bersembunyi di sini…</VALUE>
    <VALUE Lang="id">Terimakasih….</VALUE>
    <VALUE Lang="cn">食物？是吃的？！太谢谢您了！现在我可以在这多躲一会儿了！我会坚持下去的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_6_0">
    <VALUE Lang="GS">...</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="cn">…….</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_7_0">
    <VALUE Lang="GS">Suna.. Suna Jo.. Hmm.. I think I can remember..</VALUE>
    <VALUE Lang="id">Suna. Suna Jo… Aaaa.. Aku ingat…</VALUE>
    <VALUE Lang="cn">Suna……..好像是Suna Jo…嗯，我想我应该知道她是谁。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_7_0_1">
    <VALUE Lang="GS">Tell him you are here on a request to find him</VALUE>
    <VALUE Lang="id">Berkata aku diutus seseorang</VALUE>
    <VALUE Lang="cn">告诉他，您来这儿是为了完成寻找他的任务。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_8_0">
    <VALUE Lang="GS">Suna is.. She is my friend. How come I couldn't remember a friend's name.. She must have been worried so much.. Um.. Would you please send my regards to her?</VALUE>
    <VALUE Lang="id">Sun-A… memang temanku..kenapa bisa lupa nama teman sendiri…pasti karena terlalu khawatir.. Beritahukan tentang kabarku ya.. Bisakah kamu membantunya?</VALUE>
    <VALUE Lang="cn">Suna，他是我的朋友阿！我怎么会忘记朋友的名字了呢？他一定很担心我，您可以帮我跟他说一声吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_8_0_1">
    <VALUE Lang="GS">Tell him not to worry</VALUE>
    <VALUE Lang="id">Menasehati untuk tidak usah khawatir.</VALUE>
    <VALUE Lang="cn">请他别担心</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_9_0">
    <VALUE Lang="GS">Please deliver this letter to Suna, please..</VALUE>
    <VALUE Lang="id">Tolong berikan surat ini kepada Sun-A.. Terima kasih</VALUE>
    <VALUE Lang="cn">请将这封信转交给Suna，拜托您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_ghost_2.ntk_9_0_1">
    <VALUE Lang="GS">Take the letter</VALUE>
    <VALUE Lang="id">Menyampaikan surat</VALUE>
    <VALUE Lang="cn">领取信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0">
    <VALUE Lang="GS">You're… You're h-human!</VALUE>
    <VALUE Lang="GS">When the Force Field was removed… The humans… Changed…</VALUE>
    <VALUE Lang="GS">I'm also ch-changing. Very slowly.</VALUE>
    <VALUE Lang="GS">Still got some… M-medicine here, but not m-much left.</VALUE>
    <VALUE Lang="GS">I c-can sell it to you, but it'll b-be expensive…</VALUE>
    <VALUE Lang="id">Ternyata..kamu…manusia rupanya…</VALUE>
    <VALUE Lang="id">Authenticationnya runduh…semuanya…</VALUE>
    <VALUE Lang="id">Orang-orang…berubah</VALUE>
    <VALUE Lang="id">Saya juga…berubah…se..dikit demi…sedikit</VALUE>
    <VALUE Lang="id">Ah..membawa..beberapa..oabat-obatan</VALUE>
    <VALUE Lang="id">Ada..tapi sangat…berharga</VALUE>
    <VALUE Lang="id">Mau tidak mau…saya harus menjualnya…dengan har</VALUE>
    <VALUE Lang="cn">你.. 你是.. 人..</VALUE>
    <VALUE Lang="cn">自从.. 结界.. 解除以来..</VALUE>
    <VALUE Lang="cn">所有的人.. 都变了....</VALUE>
    <VALUE Lang="cn">我也..正慢慢的.. 改变..</VALUE>
    <VALUE Lang="cn">啊.. 虽然我有.. 一些药品..</VALUE>
    <VALUE Lang="cn">但是因为.. 非常.. 稀有.....</VALUE>
    <VALUE Lang="cn">所以.. 只能卖你.. 贵一些了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_1">
    <VALUE Lang="GS">Trade Items</VALUE>
    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">交易物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_2">
    <VALUE Lang="GS">Ask if she is scared</VALUE>
    <VALUE Lang="id">Bertanya apakah tidak takut</VALUE>
    <VALUE Lang="cn">询问她会不会害怕</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_3">
    <VALUE Lang="GS">Tell her what happened</VALUE>
    <VALUE Lang="id">Bercerita tentang hal yang terjadi</VALUE>
    <VALUE Lang="cn">告诉她事情的真相</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_4">
    <VALUE Lang="GS">Ask if she is scared</VALUE>
    <VALUE Lang="id">Bertanya apakah tidak takut</VALUE>
    <VALUE Lang="cn">询问她会不会害怕</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_5">
    <VALUE Lang="GS">Tell her what happened</VALUE>
    <VALUE Lang="id">Bercerita tentang hal yang terjadi</VALUE>
    <VALUE Lang="cn">告诉她事情的真相</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_1_0_6">
    <VALUE Lang="GS">Ask about the day of Phenomenon.</VALUE>
    <VALUE Lang="id">Tanyakan tentang Phenomenon</VALUE>
    <VALUE Lang="cn">询问异变当天的状况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_2_0">
    <VALUE Lang="GS">Ev.. every night.. those men.. ca.. call.. me.. I.. don't.. wan.. wanna. go..</VALUE>
    <VALUE Lang="id">Setiap ma.. malam.. Orang itu..me..memanggil.. Tetpai saya ma..las mendatanginya</VALUE>
    <VALUE Lang="cn">每…天晚上….那些男....人打给我…我不想见他们…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_h_medic1.ntk_2_0_1">
