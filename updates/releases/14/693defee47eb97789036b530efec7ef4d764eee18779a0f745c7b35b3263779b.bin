  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_1_0_8">
    <VALUE Lang="GS">Library Purification</VALUE>
    <VALUE Lang="id">Pembersihan musuh di Library</VALUE>
    <VALUE Lang="cn">Library净化</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_1_0_9">
    <VALUE Lang="GS">Confirm Purification</VALUE>
    <VALUE Lang="id">Konfimasi pembersihan musuh</VALUE>
    <VALUE Lang="cn">确认净化</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_2_0">
    <VALUE Lang="GS">The Terminal is running properly.</VALUE>
    <VALUE Lang="id">Terminal beroperasi secara normal</VALUE>
    <VALUE Lang="cn">终端机正常运作中。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_3_0">
    <VALUE Lang="GS">This Terminal's Force Field Mechanism is functioning properly.</VALUE>
    <VALUE Lang="GS">You'll need 9 Spiritual Spheres to optimize this Terminal's Force Field function.</VALUE>
    <VALUE Lang="id">Pengoperasian Force Field di Terminal berfungsi secara normal</VALUE>
    <VALUE Lang="id">Untuk mendapatkan hasil dari autentikasi Force Field kumpulkanlah Spiritual Spheres. Dibutuhkan 9 buah</VALUE>
    <VALUE Lang="cn">终端机的结界机能正常运作中。您需要9颗灵珠才能通过认证，并得到结界的能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_4_0">
    <VALUE Lang="GS">The Force Field Optimization for the current Terminal is completed!</VALUE>
    <VALUE Lang="GS">Please proceed to the next Terminal to complete all the required Force Field Optimizations.</VALUE>
    <VALUE Lang="id">Autentikasi Force Field telah selesai</VALUE>
    <VALUE Lang="id">Jika sisa autentikasi Force Field telah selesai hasilnya bisa di dapatkan dan untuk autentikasi Force Field berikutnya harap gunakan terminal yang sesuai</VALUE>
    <VALUE Lang="cn">您已完成本结界的认证！请前往下个结界终端机，完成所有的认证，并获取结界能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_5_0">
    <VALUE Lang="GS">There are evil spirits roaming inside the Library. The mobs of monsters possessed by these spirits are causing strange effects to their surroundings. Please try your best to eliminate them.</VALUE>
    <VALUE Lang="id">Para Roh Jelmaan sedang beraktivitas di dalam Library</VALUE>
    <VALUE Lang="id">Roh Jelmaan ini dapat mempengaruhi situasi disekelilingnya. Tolong bersihkan Roh Jelmaan ini sebelum terjadi hal yang lebih buruk</VALUE>
    <VALUE Lang="cn">许多恶灵在Library里徘徊游荡。被这些恶灵所附着的怪物身上有着不良物质，导致周遭环境出现奇怪现象。请您尽全力处理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_5_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_6_0">
    <VALUE Lang="GS">The target amount for purification has been achieved and verified. Thank you for all your efforts.</VALUE>
    <VALUE Lang="id">Konfirmasi target pembersihan musuh telah selesai</VALUE>
    <VALUE Lang="id">Terima kasih atas kerja keras kalian</VALUE>
    <VALUE Lang="cn">已经确认了目标物与其数量净化的完成。 谢谢您，辛苦您了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_6_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_9_0">
    <VALUE Lang="GS">The top priority targets in this area are the Street Junkies. Please eliminate 22 Street Junkies.</VALUE>
    <VALUE Lang="id">Di lokasi ini targetnya adalah Street Junkie</VALUE>
    <VALUE Lang="id">Bunuh 22 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为Street Junkie。请除掉22只Street Junkie，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_library_1.ntk_9_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_0">
    <VALUE Lang="GS">A Broom? Well, it's pretty inconvenient for me to carry this broom around while I'm trying to finish everything I need to do.</VALUE>
    <VALUE Lang="id">Sapu? Ini akan sangat mengganggu untuk dibawa ke mana mana ketika saya melakukan hal lain.</VALUE>
    <VALUE Lang="cn">扫把？反正我在处理事情时，拿着扫把也是挺不方便的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_0_1">
    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Buka Locker</VALUE>
    <VALUE Lang="cn">开启置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_1">
    <VALUE Lang="GS">skip</VALUE>
    <VALUE Lang="id">skip</VALUE>
    <VALUE Lang="cn">skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_2">
    <VALUE Lang="GS">The weather is getting cold and gloomy. I'm starting to feel aches and pains in my body.</VALUE>
    <VALUE Lang="id">Cuaca berangsur dingin. Saya mulai merasakan pegal dan sakit di seluruh badan saya.</VALUE>
    <VALUE Lang="cn">天气又冷又阴的，我的身体开始感到疼痛了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_2_1">
    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Buka Locker</VALUE>
    <VALUE Lang="cn">开启置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_2_2">
    <VALUE Lang="GS">Ask about Locker Usage</VALUE>
    <VALUE Lang="id">Tanya tentang Penggunaan Locker</VALUE>
    <VALUE Lang="cn">询问置物箱用法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_2_3">
    <VALUE Lang="GS">Ask about the Campus</VALUE>
    <VALUE Lang="id">Tanya tentang Kampus</VALUE>
    <VALUE Lang="cn">询问学院事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_2_4">
    <VALUE Lang="GS">Return Broom</VALUE>
    <VALUE Lang="id">Tukar Broom</VALUE>
    <VALUE Lang="cn">归还扫帚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_1_2_5">
    <VALUE Lang="GS">Borrow Broom</VALUE>
    <VALUE Lang="id">Pinjam Broom</VALUE>
    <VALUE Lang="cn">出借扫帚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_2_0">
    <VALUE Lang="GS">.......</VALUE>
    <VALUE Lang="id">.......</VALUE>
    <VALUE Lang="cn">.......</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_3_0">
    <VALUE Lang="GS">Of course! Just use these lockers whenever you want. Try to stick to using just one locker space for yourself, alright? Store items that you want to keep and use later inside your locker. You'll need to spend some more money if you want to expand your locker space.</VALUE>
    <VALUE Lang="id">Tentu saja! Kamu bisa menggunakannya kapan pun kamu mau. Simpan item - item yang tidak diperlukan saat ini agar bisa dipergunakan ketika memerlukannya. Kamu memerlukan uang untuk membuka locker lain jika ingin.</VALUE>
    <VALUE Lang="cn">当然！置物箱，您尽管用就是了。但请尽量保持一人份的使用量，好吗？最好是保管真正想收藏的，但又不太紧急的物品。当您嫌置物箱空间不够，想要加大空间时，是需要付些钱币的唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_3_0_1">
    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Buka Locker</VALUE>
    <VALUE Lang="cn">开启置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_3_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_4_0">
    <VALUE Lang="GS">Sigh. How do I answer that question? As you probably know, there are 3 Campuses in the area, but there are rumors of a fourth campus. I've heard the teachers and the School Administration talking about the Force-- Force Fiel... Ah yes! The Force Field! I'm not one hundred percent sure, but I think there's something very important about that Force Field. Of all the campuses here, Leonair Campus is the probably the weirdest. I remember that I was just listening to some teachers talking when the sky suddenly change</VALUE>
    <VALUE Lang="GS">I really want to know more about what actually happened. If you guys find important information about that event, please don't forget to let me know, alright?</VALUE>
    <VALUE Lang="id">Jangan bertanya hal seperti itu pada saya~</VALUE>
    <VALUE Lang="id">Yang aku ketahui hanyalah kabar desas-desus yang tak berdasar, namun apabila kamu tetap ingin mengetahuinya..baiklah</VALUE>
    <VALUE Lang="id">Nah… jadi sangatlah jelas selain sekolah ini terdapat 3 buah sekolah lainnya</VALUE>
    <VALUE Lang="id">Yang terp</VALUE>
    <VALUE Lang="cn">哀，我该怎么回答好呢？您大概已经听说了，似乎学院的总数不是3个，而是4个！老师们和行政部门的人有提到像是结…..结界的东西….. 啊！就是结界！没错！虽然不能100%的保证，但我相信所谓4个学院的传闻，绝对跟这结界有着很大的关联。现在全部的学院里，最诡异离奇的就属Leonair学院了 。我记得当时我正在听老师们交谈，结果天空急剧变色。但情况太混乱，之后我什么也不记得了。如果各位同学们，关于这部分，有什么新发现，一定要马上跟我说，好吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_4_0_1">
    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Buka Locker</VALUE>
    <VALUE Lang="cn">开启置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_4_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_5_0">
    <VALUE Lang="GS">Broom? Oh! That Broom! I really have no idea what's so special about these brooms. Well, if you really think you'll need one, feel free to take it. Please bring it back as soon as you're done using it.</VALUE>
    <VALUE Lang="id">Special Broom?</VALUE>
    <VALUE Lang="id">Ahh</VALUE>
    <VALUE Lang="cn">扫把？噢！刚提到的扫把！我实在是不懂它有什么特别的。这样吧。如果您真认为您会需要，别介意，尽管拿去使用。 只要记住，用完后，要马上归还唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_1.ntk_1_0">
    <VALUE Lang="GS">These are the Lockers of the Market Area.</VALUE>
    <VALUE Lang="GS">Please feel free to use these Lockers to store your items and equipment.</VALUE>
    <VALUE Lang="id">Ini adalah Locker Servis di MarketPlace.</VALUE>
    <VALUE Lang="id">Silahkan menggunakannya untuk menyimpan item - item pribadimu.</VALUE>
    <VALUE Lang="cn">这些是Market区的置物箱。可储存自身的道具和装备。请安心使用。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_1.ntk_1_0_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah posisi awal</VALUE>
    <VALUE Lang="cn">更改起点位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_1.ntk_1_0_2">
    <VALUE Lang="GS">Open the Locker</VALUE>
    <VALUE Lang="id">Menggunakan Locker</VALUE>
    <VALUE Lang="cn">开启置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_1_0">
    <VALUE Lang="GS">Welcome to the School's Back Door Area!</VALUE>
    <VALUE Lang="GS">How can I help you?</VALUE>
    <VALUE Lang="id">Apa yang bisa saya bantu?</VALUE>
    <VALUE Lang="cn">欢迎来到学院的Back Door Area！请问需要什么帮忙吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_1_0_1">
    <VALUE Lang="GS">Access Lockers</VALUE>
    <VALUE Lang="id">Menggunakan Locker</VALUE>
    <VALUE Lang="cn">进入置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_1_0_2">
    <VALUE Lang="GS">Ask about Outdoor Lockers</VALUE>
    <VALUE Lang="id">Bertanya tentang Locker di luar</VALUE>
    <VALUE Lang="cn">询问关于户外置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_1_0_3">
    <VALUE Lang="GS">Ask about Practice Yard</VALUE>
    <VALUE Lang="id">Bertanya tentang Practice Yard</VALUE>
    <VALUE Lang="cn">询问关于Practice Yard</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_2_0">
    <VALUE Lang="GS">.......</VALUE>
    <VALUE Lang="id">.......</VALUE>
    <VALUE Lang="cn">.......</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_3_0">
    <VALUE Lang="GS">These Lockers are available for immediate use to students that wish to leave some of their items for safekeeping before venturing into the dangerous areas past these gates.</VALUE>
    <VALUE Lang="id">Locker di sana untuk membantu para pemain menyimpan item - item berharga mereka sebelum berangkat ke map yang memili banyak monster buas.</VALUE>
    <VALUE Lang="cn">这些置物箱对学生来说，是个在前往危险地带之前的可安心寄放物品的安心箱。还可以紧急打开使用唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_3_0_1">
    <VALUE Lang="GS">Open Lockers</VALUE>
    <VALUE Lang="id">Membuka Lockers</VALUE>
    <VALUE Lang="cn">开启置物箱</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_3_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_4_0">
    <VALUE Lang="GS">The Practicing Yard outside provides easier access to the other campuses for students. There are Bus Stations outside if you want to move to another location outside the campus. Please have your Bus Tickets ready if you want to use the Bus Services.</VALUE>
    <VALUE Lang="id">Kamu harus mempunyai\ Tiket Bus untuk menggunakan pelayanan Bus.</VALUE>
    <VALUE Lang="cn">在Practicing Yard的外面提供前往各学院的直达巴士。您可搭至各个学院外部的车站下车。首先，请您确认一下，手中的公车票数量是否足够。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_4_0_1">
    <VALUE Lang="GS">Ask more about the Training Yard</VALUE>
    <VALUE Lang="id">Bertanya lebih tentang Training Yard</VALUE>
    <VALUE Lang="cn">询问更多关于Training Yard</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_4_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_5_0">
    <VALUE Lang="GS">Danger lurks in the Practicing Yard area.</VALUE>
    <VALUE Lang="GS">Student! Remember that the Training Yard area is not a safe zone. Please be careful outside since there are several monsters patrolling that area!</VALUE>
    <VALUE Lang="GS">Please be discreet when traveling through the Training Yard. Good Luck!</VALUE>
    <VALUE Lang="id">Practicing Yard area adalah tempat yang berbahaya.</VALUE>
    <VALUE Lang="id">Harap diingat jika Training Yard bukanlah tempat yang aman. Banyak monster yang berlalu lalang di sana!</VALUE>
    <VALUE Lang="id">Harap berhati - hati bila berkunjung ke sana, Semoga Beruntung!</VALUE>
    <VALUE Lang="cn">Practicing Yard里潜伏着许多危险。要记住Practicing Yard不是个安全的地方。请小心外面，因为有许多只的怪物总是徘徊在这个区域里！当您途径Training Yard时，务必请注意安全。祝您好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_b.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_locker_human.ntk_1_0">
    <VALUE Lang="GS">Would you like to use your locker?</VALUE>
    <VALUE Lang="id">Emm, ingin menggunakan Locker?</VALUE>
    <VALUE Lang="cn">想用Locker置物箱吗？</VALUE>
  </SENTENSE>
