    <VALUE Lang="id">Menukarkan Invitation letter dengan 'Hero's vital sword'</VALUE>
    <VALUE Lang="cn">拿Hero Invitation 兑换 Hero's Vital Sword Pack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_2_0_4">
