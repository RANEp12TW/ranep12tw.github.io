    <VALUE Lang="GS">Ask about 3rd Floor of "Green" Command Center</VALUE>
    <VALUE Lang="id">Bertanya tentang "Green" Command Center Lantai 3</VALUE>
    <VALUE Lang="cn">询问关于“Green”指挥中心的3楼</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_11">
    <VALUE Lang="GS">Show the Key</VALUE>
    <VALUE Lang="id">Tunjukkan kunci</VALUE>
    <VALUE Lang="cn">给看钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_12">
    <VALUE Lang="GS">Ask about "Green"</VALUE>
    <VALUE Lang="id">Bertanya tentang "Green"</VALUE>
    <VALUE Lang="cn">询问关于“Green”的事情</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_13">
    <VALUE Lang="GS">Give the Document</VALUE>
    <VALUE Lang="id">Menyerahkan dokumen</VALUE>
    <VALUE Lang="cn">传达文件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_14">
    <VALUE Lang="GS">Ask about Mail</VALUE>
    <VALUE Lang="id">Bertanya tentang Mail</VALUE>
    <VALUE Lang="cn">询问信件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_15">
    <VALUE Lang="GS">Ask if he is in a trouble</VALUE>
    <VALUE Lang="id">Bertanya apakah dia dalam masalah</VALUE>
    <VALUE Lang="cn">询问需要帮忙什么吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_16">
    <VALUE Lang="GS">Tell him what happened</VALUE>
    <VALUE Lang="id">Beri tahu apa yang terjadi</VALUE>
    <VALUE Lang="cn">告诉他事情的经过</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_2">
    <VALUE Lang="GS">Ask about Smuggling</VALUE>
    <VALUE Lang="id">Bertanya tentang Smuggling</VALUE>
    <VALUE Lang="cn">询问走私一事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_3">
    <VALUE Lang="GS">Give the Smuggler's Trace</VALUE>
    <VALUE Lang="id">Menyerahkan petunjuk Smuggler</VALUE>
    <VALUE Lang="cn">传达走私犯的行踪</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_4">
    <VALUE Lang="GS">Ask about Building</VALUE>
    <VALUE Lang="id">Bertanya tentang Building</VALUE>
    <VALUE Lang="cn">询问有关这建筑物</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_5">
    <VALUE Lang="GS">Give the Clue</VALUE>
    <VALUE Lang="id">Menyerahkan petunjuk</VALUE>
    <VALUE Lang="cn">提示线索</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_6">
    <VALUE Lang="GS">Ask about Entering Building</VALUE>
    <VALUE Lang="id">Bertanya cara memasuki Building</VALUE>
    <VALUE Lang="cn">询问进入大楼的方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_7">
    <VALUE Lang="GS">Ask about "Green" Secret Hideout</VALUE>
    <VALUE Lang="id">Bertanya tentang persembunyian rahasia "Green".</VALUE>
    <VALUE Lang="cn">询问“Green”的机密据点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_8">
    <VALUE Lang="GS">Ask about Key</VALUE>
    <VALUE Lang="id">Bertanya tentang kunci</VALUE>
    <VALUE Lang="cn">询问钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_1_9">
    <VALUE Lang="GS">Show the Key</VALUE>
    <VALUE Lang="id">Tunjukkan kunci</VALUE>
    <VALUE Lang="cn">给看钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_2">
    <VALUE Lang="GS">This building is currently under supervision.</VALUE>
    <VALUE Lang="GS">It's great to see students like you that are here to help!</VALUE>
    <VALUE Lang="id">Gedung ini dalam pengawasan. Sangat senang melihat kamu berada di sini untuk menolong.</VALUE>
    <VALUE Lang="cn">这栋大楼被监管中。</VALUE>
    <VALUE Lang="cn">因为您的乐善好施，学生们都喜欢您，真是太好了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_2_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">变更开始地点</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_2_2">
    <VALUE Lang="GS">Ask What's the Matter</VALUE>
    <VALUE Lang="id">Bertanya apa yang terjadi</VALUE>
    <VALUE Lang="cn">询问发生何事了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_1_2_3">
    <VALUE Lang="GS">Give the smuggled goods</VALUE>
    <VALUE Lang="id">Menyerahkan item - item Smuggler</VALUE>
    <VALUE Lang="cn">传达走私物品</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_10_0">
    <VALUE Lang="GS">Try to look around and investigate the building carefully.</VALUE>
    <VALUE Lang="GS">See whether you can find any clues.</VALUE>
    <VALUE Lang="GS">Thanks!</VALUE>
    <VALUE Lang="id">Tolong periksa daerah sekitar gedung dengan cara mengitarinya satu kali</VALUE>
    <VALUE Lang="id">Kalau saja bisa menemukan sesuatu…</VALUE>
    <VALUE Lang="cn">试着环顾四周，仔细调查这栋楼。</VALUE>
    <VALUE Lang="cn">看是否能找到任何线索。谢谢。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_10_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_11_0">
    <VALUE Lang="GS">Ah!</VALUE>
    <VALUE Lang="GS">You solved these cases easily! I think you are better in doing these types of tasks compared to the Police Department.</VALUE>
    <VALUE Lang="GS">Ow! Where did you find this?</VALUE>
    <VALUE Lang="GS">This money is shining and looks a little weird. It's like there's something special about these notes.</VALUE>
    <VALUE Lang="id">Ah!</VALUE>
    <VALUE Lang="id">Para polisi jadi kelihatan sedang bermain karena kamu menyelesaikan pekerjaan kami dengan mudah seperti ini</VALUE>
    <VALUE Lang="id">Kamu temukan ini dimana?</VALUE>
    <VALUE Lang="id">Apa? Uangnya bersinar?</VALUE>
    <VALUE Lang="id">Aneh…padahal sekarang hanya currency biasa…</VALUE>
    <VALUE Lang="id">Sepertinya kamu memang punya suatu k</VALUE>
    <VALUE Lang="cn">啊！</VALUE>
    <VALUE Lang="cn">您这么轻易地解决这些事情了！！您一定会想说我们警察都在游手好闲……</VALUE>
    <VALUE Lang="cn">疑？这是在那里找到的呢？</VALUE>
    <VALUE Lang="cn">噢！这钱在发光耶~看起来还有点奇怪…..好像很神奇唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_12_0">
    <VALUE Lang="GS">With these paper notes, we already have enough reason to arrest them without a warrant. However, you need to acquire Terminal Approval before you can get inside the building.</VALUE>
    <VALUE Lang="GS">That is a problem!</VALUE>
    <VALUE Lang="id">Currency ini bisa menjadi alasan walaupun kamu tidak punya jaminan</VALUE>
    <VALUE Lang="id">Tapi…</VALUE>
    <VALUE Lang="id">Ada masalah karena bila kamu ingin masuk ke gedung itu kamu harus mendapatkan verifikasi dari terminal yang ada di sana</VALUE>
    <VALUE Lang="cn">有了这张纸币，我们就算没有逮捕令，也有充分的理由来进行逮捕了！</VALUE>
    <VALUE Lang="cn">但是，在进去大楼之前，您必须先得到终端机的认证才行。</VALUE>
    <VALUE Lang="cn">这真的是个麻烦的事情啊~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_12_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_13_0">
    <VALUE Lang="GS">Furthermore, we need to have the key to get through the 2nd and 3rd Floors.</VALUE>
    <VALUE Lang="GS">Could you help me acquire these keys?</VALUE>
    <VALUE Lang="id">Terus katanya kamu butuh kunci kalau mau naik ke lantai 2 atau 3</VALUE>
    <VALUE Lang="id">Bisa tolong carikan?</VALUE>
    <VALUE Lang="cn">此外，我们需要有钥匙，才能进入2楼与3楼。</VALUE>
    <VALUE Lang="cn">可以请您帮我找找吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_13_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_13_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_14_0">
    <VALUE Lang="GS">Please be careful!</VALUE>
    <VALUE Lang="GS">Those mobsters will attack no matter who you are! On the 1st Floor, there is a freezer supervisor. Please don't simply fight your way through…</VALUE>
    <VALUE Lang="GS">It's very dangerous in that area. Sometimes, you'll need to resort to running.</VALUE>
    <VALUE Lang="id">Hati-hati</VALUE>
    <VALUE Lang="id">Di hari biasa juga orang-orang itu sering memukuli orang-orang tak peduli mereka wanita atau pria</VALUE>
    <VALUE Lang="id">Dan di lantai satu akan ada manager yang mengatur Ice warehouse</VALUE>
    <VALUE Lang="id">Kamu harus hati-hati untuk tidak memulai pertarungan</VALUE>
    <VALUE Lang="cn">请小心！那些怪物不分男女老少都会照样攻击的。</VALUE>
    <VALUE Lang="cn">Freezer supervisor在1楼那边，请不要轻易引起战斗。</VALUE>
    <VALUE Lang="cn">这边是很危险的区域。您将会常常被追杀唷。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_14_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_15_0">
    <VALUE Lang="GS">This is the key!</VALUE>
    <VALUE Lang="GS">Why is it broken?</VALUE>
    <VALUE Lang="GS">I'm not sure if we can restore this key to its original form.</VALUE>
    <VALUE Lang="id">Ini kunci itu rupanya</VALUE>
    <VALUE Lang="id">Tapi kalau rusak seperti ini…</VALUE>
    <VALUE Lang="id">Untuk berjaga-jaga saja, bisa tolong perlihatkan kepada 'Warehouse Security'</VALUE>
    <VALUE Lang="id">Satu sih tidak apa-apa tapi kalau ada lima kita tidak tahu harus dicocokkan seperti apa baru bisa diperbaiki</VALUE>
    <VALUE Lang="cn">就是这把钥匙！</VALUE>
    <VALUE Lang="cn">但为何是损坏的？</VALUE>
    <VALUE Lang="cn">我不确定我们是否能够把它给修好？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_15_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_16_0">
    <VALUE Lang="GS">I think we'll be alright with this.</VALUE>
    <VALUE Lang="GS">There should be no more problems getting to the 2nd Floor.</VALUE>
    <VALUE Lang="id">Kayaknya ini sudah cukup</VALUE>
    <VALUE Lang="id">Kini tidak ada masalah lagi untuk naik ke lantai 2</VALUE>
    <VALUE Lang="cn">我想应该没有问题了。可以放心前往2楼了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_16_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_17_0">
    <VALUE Lang="GS">To go to the 3rd Floor, we must get the key first.</VALUE>
    <VALUE Lang="GS">Although the key was bent out of shape, you can ask for help from the Warehouse Supervisor.</VALUE>
    <VALUE Lang="GS">So don't worry!</VALUE>
    <VALUE Lang="GS">You will face similar dangers on the 2nd Floor, just like in the Control Center.</VALUE>
    <VALUE Lang="GS">Please be careful!</VALUE>
    <VALUE Lang="id">Cara untuk pergi ke lantai 3 adalah sama</VALUE>
    <VALUE Lang="id">Kamu harus menemukan kuncinya terlebih dahulu</VALUE>
    <VALUE Lang="id">Tidak perlu khawatir karena meskipun yang kamu temukan adalah kunci yang telah patah kita bisa memperbaikinya ke pada Warehouse Security</VALUE>
    <VALUE Lang="id">Tapi orang yang berjag</VALUE>
    <VALUE Lang="cn">请到3楼拿到钥匙。</VALUE>
    <VALUE Lang="cn">虽然钥匙已经变形了，但还是可以拜托 Warehouse Supervisor。所以，别担心。</VALUE>
    <VALUE Lang="cn">您会在2楼处遇到些危险，就像在Control Center里面的时候一样。请小心。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_17_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_17_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_18_0">
    <VALUE Lang="GS">There are people who dress like Ninjas in that area. Although they might not have all the genuine ninja skills, they're still more dangerous than normal people.</VALUE>
    <VALUE Lang="id">Mungkin tidak akan jauh berbeda dengan lantai satu</VALUE>
    <VALUE Lang="id">Menurut informasi yang kami dapat ada orang-orang yang mirip ninja</VALUE>
    <VALUE Lang="id">Mungkin mereka tidak akan melakukan tipuan seperti membagi diri menjadi beberapa orang tapi sudah pasti bahwa mereka berbeda dengan</VALUE>
    <VALUE Lang="cn">在这区有人穿着像Ninjas。虽然他们也许没有真正的Ninja技术，但他们的危险度并不低于一般人！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_18_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_19_0">
    <VALUE Lang="GS">I think this is okay.</VALUE>
    <VALUE Lang="GS">We should have no more problems getting to the 2nd Floor of that building.</VALUE>
    <VALUE Lang="id">Ini sudah cukup</VALUE>
    <VALUE Lang="id">Kini tidak ada masalah lagi untuk naik ke lantai 3</VALUE>
    <VALUE Lang="cn">我想应该没有问题了。可以放心前往2楼了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_19_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_2_0">
    <VALUE Lang="GS">This building is currently under supervision.</VALUE>
    <VALUE Lang="GS">It's great to see students like you that are here to help!</VALUE>
    <VALUE Lang="id">Gedung ini dalam pengawasan. Sangat senang melihat kamu berada di sini untuk menolong.</VALUE>
    <VALUE Lang="cn">这栋大楼被监管中。</VALUE>
    <VALUE Lang="cn">因为您的乐善好施，学生们都喜欢您，真是太好了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_20_0">
    <VALUE Lang="GS">Can you help us completely investigate that building in order to clarify the issues and rumors spreading around?</VALUE>
    <VALUE Lang="id">Karena walau bagaimanapun juga kita harus memeriksa gedung</VALUE>
    <VALUE Lang="id">Bisa membantu saya?</VALUE>
    <VALUE Lang="cn">为了澄清这些问题，以及散布各处的谣言，您可以帮助我们对这大楼做一番彻底的调查吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_20_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_20_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_21_0">
    <VALUE Lang="GS">Thank you!</VALUE>
    <VALUE Lang="GS">The 3rd Floor is composed of a Ball Room and the Top Management Room. I think we can find the clues we need in that area.</VALUE>
    <VALUE Lang="GS">However, there are some strong mobsters that await you. Be careful!</VALUE>
    <VALUE Lang="GS">Furthermore, those that stay in the Top Management Room are international criminals. Don't approach them! They're too dangerous.</VALUE>
    <VALUE Lang="GS">Just run away if you feel overwhelmed.</VALUE>
    <VALUE Lang="GS">Don't force yourself to fight them!</VALUE>
    <VALUE Lang="id">Terimakasih.</VALUE>
    <VALUE Lang="id">Dilantai 3 ada Ruang jamuan dan administrasi, kamu pasti bisa mendapatkan petunjuk di sana</VALUE>
    <VALUE Lang="id">Tapi kamu harus hati-hati karena orang-orang yang lebih kuat akan menyerang</VALUE>
    <VALUE Lang="id">Ditambah lagi orang yang ada di Kantor administrasi tertinggi itu</VALUE>
    <VALUE Lang="cn">谢谢您。</VALUE>
    <VALUE Lang="cn">3楼是由Ball Room和Top Management Room组成的。我想我们可以找到一些重要的线索。</VALUE>
    <VALUE Lang="cn">但是，那边有很多强悍的怪物。请小心！</VALUE>
    <VALUE Lang="cn">还有，待在Top Management Room的正是国际要犯。别太靠近，他们真的太危险了。</VALUE>
    <VALUE Lang="cn">如果您觉得不行，就退出来吧！千万不要勉强自己去战斗。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_21_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_22_0">
    <VALUE Lang="GS">Look at all this torn up mail.</VALUE>
    <VALUE Lang="GS">Don't you have to put it all back together?</VALUE>
    <VALUE Lang="GS">Try to put it back together now.</VALUE>
    <VALUE Lang="GS">Hmm... It's really a mailed letter.</VALUE>
    <VALUE Lang="GS">The sender is Professor ChuiQingGui.</VALUE>
    <VALUE Lang="GS">Hold on, this man is the founder of the Sacred Financial Group!</VALUE>
    <VALUE Lang="GS">The letter was intended for HongMeiLan. I've heard that name before....</VALUE>
    <VALUE Lang="GS">Anyway, you can return the evidence now!</VALUE>
    <VALUE Lang="id">Ini…adalah surat rupanya?</VALUE>
    <VALUE Lang="id">Tidak pernah mencoba menggabungkannya kan?</VALUE>
    <VALUE Lang="id">Sekarang kita coba gabungkan</VALUE>
    <VALUE Lang="id">Meskipun 7 buah bukanlah satu yang sempurna…..</VALUE>
    <VALUE Lang="id">Ini benar surat rupanya!</VALUE>
    <VALUE Lang="id">Di tambah lagi pengirimnya adalah professor..Choi..Te gyu?</VALUE>
    <VALUE Lang="id">Sebenta</VALUE>
    <VALUE Lang="cn">看看这些撕毁的邮件。</VALUE>
    <VALUE Lang="cn">有没有把它们全部重组一下呢？</VALUE>
    <VALUE Lang="cn">请尽量把它修补好。</VALUE>
    <VALUE Lang="cn">嗯......这真是一个邮寄信件。</VALUE>
    <VALUE Lang="cn">寄件人是ChuiQingGui教授。</VALUE>
    <VALUE Lang="cn">慢着！这人是Sacred Financial Group创办人！</VALUE>
    <VALUE Lang="cn">这封信的收件人是HongMeiLan。</VALUE>
    <VALUE Lang="cn">我以前听说过这个名字....</VALUE>
    <VALUE Lang="cn">总之，您现在可以缴回证据了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_22_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_23_0">
    <VALUE Lang="GS">Excuse me! Please hand this evidence to the Police Station located in the Trading Hole.</VALUE>
    <VALUE Lang="GS">We need to continue with our investigation.</VALUE>
    <VALUE Lang="id">Maaf tapi tolong sampaikan surat itu kepada polisi di Trading Hole Polisi</VALUE>
    <VALUE Lang="id">Kami akan tinggai di sini dan melakukan penyelidikkan lebih dalam lagi</VALUE>
    <VALUE Lang="id">Maaf karena terus merepotkan</VALUE>
    <VALUE Lang="cn">不好意思，请把证据交到位在Trading Hole的Police Station。我们需要继续进行调查。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_23_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_24_0">
    <VALUE Lang="GS">.....3</VALUE>
    <VALUE Lang="id">.....3</VALUE>
    <VALUE Lang="cn">.....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_25_0">
    <VALUE Lang="GS">I heard that there was a report of a fight in this area. The patrol car was here, and it took all the smuggled goods. This building is now under supervision and investigation.</VALUE>
    <VALUE Lang="id">Dulu ada laporan tentang tawuran jadi kami datang untuk melakukan penyelidikan eh malah ada laporan lagi tentang pemasukkan item selundupan jadi kami sedang membatasi gedung dan melakukan penyelidikan tentang itu</VALUE>
    <VALUE Lang="cn">听说之前有人申报群架案件。调查车有来，还没收了走私物品。现在这栋大楼已被管制，调查继续进行中。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_25_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_26_0">
    <VALUE Lang="GS">....6</VALUE>
    <VALUE Lang="id">....6</VALUE>
    <VALUE Lang="cn">....6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_27_0">
    <VALUE Lang="GS">This looks like normal garbage, but did you happen to see the White Drug Powder and Golden Coin?</VALUE>
    <VALUE Lang="id">Dari luar kelihatan seperti sampah biasa tapi di dalamnya tidak begitu</VALUE>
    <VALUE Lang="id">Sekilas kamu bisa melihat serbuk putih dan lempeng tembaga bercahaya keemasan kan?</VALUE>
    <VALUE Lang="cn">看来只是一般的垃圾而已。但您有碰巧看见White Drug Powder 和 Golden Coin吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_27_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_28_0">
    <VALUE Lang="GS">It seems that someone was planning to use a fake coin in some exchange. We also need to confirm whether the power is a narcotic.</VALUE>
    <VALUE Lang="GS">It cannot be verified as a drug just by looking at it.</VALUE>
    <VALUE Lang="id">Kayaknya ada rencana untuk memalsukan atau menukarkan sesuatu dengan yang palsu</VALUE>
    <VALUE Lang="id">Serbuk ini masih harus diperiksa tapi kayaknya ini obat terlarang</VALUE>
    <VALUE Lang="id">Hebat sekali karena kamu bisa menyangka hal seperti ini.</VALUE>
    <VALUE Lang="cn">似乎有人正打算使用假硬币在交换什么。我们还需要确认这些粉末是否为麻药。</VALUE>
    <VALUE Lang="cn">要用肉眼区分是很难的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_28_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_29_0">
    <VALUE Lang="GS">.....7</VALUE>
    <VALUE Lang="id">.....7</VALUE>
    <VALUE Lang="cn">.....7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_3_0">
    <VALUE Lang="GS">Ah! You're the student sent by the Sacred Financial Group, right?</VALUE>
    <VALUE Lang="GS">Can you help us with our investigation?</VALUE>
    <VALUE Lang="id">Ah! Kamu adalah Pelajar dari Sacred Financial Group bukan?</VALUE>
    <VALUE Lang="id">Bisakah menolong kami?</VALUE>
    <VALUE Lang="cn">啊！你是Sacred Financial Group来的学生，对吗？ 可以帮助我们进行调查？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_3_0_2">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_3_0_3">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_30_0">
    <VALUE Lang="GS">Anyway, please arrest him after you confirm that these are illegal drugs.</VALUE>
    <VALUE Lang="id">Walau bagaimanapun juga aku tidak bisa berpikir kalau ini normal</VALUE>
    <VALUE Lang="id">Tolong konfirmasikan lalu tangkap yah?</VALUE>
    <VALUE Lang="cn">总之，在您确定是非法药物之后，清逮捕他。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_30_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_31_0">
    <VALUE Lang="GS">.....9</VALUE>
    <VALUE Lang="id">.....9</VALUE>
    <VALUE Lang="cn">.....9</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_32_0">
    <VALUE Lang="GS">Since the establishment of the Sacred Financial Group, the "Green" gangsters started to be active in the area near the Trading Hole.</VALUE>
    <VALUE Lang="GS">That territory has become their hideout.</VALUE>
    <VALUE Lang="id">Ini gedung yang dipakai sebagai markas organisasi bernama Red Axe yang sudah ada sejak sebelum sekolah dari yayasan saint dibangun</VALUE>
    <VALUE Lang="cn">早在Sacred Financial Group成立的时候，名叫Green得帮派组织就已经于Trading Hole一带开始活动了。</VALUE>
    <VALUE Lang="cn">这地区已成了他们的藏身之所。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_32_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_33_0">
    <VALUE Lang="GS">From the outside, it looks like a legal Docking operation. These docks actually welcome illegal transport of international goods from different areas.</VALUE>
    <VALUE Lang="id">Dari luar tempat ini menggunakan nama Kantor administrai Wharf passage sebagai topeng</VALUE>
    <VALUE Lang="id">Ditambah lagi tempat ini menerima kapal dari luar negeri padahal tidak punya izin untuk membuka Pelabuhan internasional</VALUE>
    <VALUE Lang="cn">外观来看，这是合法码头。</VALUE>
    <VALUE Lang="cn">但其实这些码头非常欢迎来自不同地区的非法运输国际货物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_33_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_34_0">
    <VALUE Lang="GS">I wanted to investigate that building on my own, but I can't get into the building after the abnormal phenomenon.</VALUE>
    <VALUE Lang="GS">Now, I must have sufficient evidence and an arrest permit to perform a search.</VALUE>
    <VALUE Lang="id">Mungkin memang sudah berencana untuk melakukan perdagangan gelap</VALUE>
    <VALUE Lang="id">Tapi setelah bencana terjadi kami jadi tidak bisa masuk ke gedung itu</VALUE>
    <VALUE Lang="id">Setidaknya harus ada sebuah bukti baru kami bisa membuat surat penyelidikkan dan melakukan pencarian…tapi kami tid</VALUE>
    <VALUE Lang="cn">我想要走私，但自从发生异象之后，大楼就进不去了。现在，我必须有足够的证据和逮捕许才能执行搜索。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_34_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_35_0">
    <VALUE Lang="GS">....12</VALUE>
    <VALUE Lang="id">....12</VALUE>
    <VALUE Lang="cn">....12</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_36_0">
    <VALUE Lang="GS">Two days ago, we hired hacker to break into the Terminal.</VALUE>
    <VALUE Lang="GS">It should be done and tested by now.</VALUE>
    <VALUE Lang="GS">Go and explain the situation at the Police Station at the Trading Hole to obtain the program.</VALUE>
    <VALUE Lang="id">Dua hari yang lalu saya sudah meminta bantuan untuk membuat program yang bisa menghacking terminal</VALUE>
    <VALUE Lang="id">Mungkin sekarang sudah selesai</VALUE>
    <VALUE Lang="id">Kamu bisa menerima program itu kalau pergi ke Polisi Station dan menjelaskan situasinya</VALUE>
    <VALUE Lang="cn">两天前，我们有请人制作入侵终端机的程式。</VALUE>
    <VALUE Lang="cn">现在应该已经都做好了。</VALUE>
    <VALUE Lang="cn">请至Trading Hole的Police Station说明状况，并取得那个程式。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_36_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_37_0">
    <VALUE Lang="GS">.....13</VALUE>
    <VALUE Lang="id">.....13</VALUE>
    <VALUE Lang="cn">.....13</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_38_0">
    <VALUE Lang="GS">We are aware of that building's structure!</VALUE>
    <VALUE Lang="GS">The 1st Floor is a warehouse, and the 2nd Floor contains several offices.</VALUE>
    <VALUE Lang="GS">The 3rd Floor is composed of the Ball Room and the Management Office.</VALUE>
    <VALUE Lang="id">Setahu kami ada sampai lantai 3….</VALUE>
    <VALUE Lang="id">Saya dengar lantai 1 digunakan untuk Warehouse, lantai 2 untuk kantor dan lantai 3 untuk ruang perjamuan</VALUE>
    <VALUE Lang="cn">我们都知这建筑物的构造！</VALUE>
    <VALUE Lang="cn">一楼是仓库Warehouse，而二楼有许多个Office。</VALUE>
    <VALUE Lang="cn">3楼则是由Ball Room和Management Office 组成的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_38_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_39_0">
    <VALUE Lang="GS">During the controversial fight, it was certain that all the supervisors weren't around.</VALUE>
    <VALUE Lang="id">Hari terakhir dari tawuran terjadi, kebanyakan dari petinggi tidak ada di tempat jadi walaupun kita masuk kesana dan melakukan penyelidikan nggak tahu berapa besar petunjuk yang bisa kita dapatkan</VALUE>
    <VALUE Lang="cn">在有争议性的斗争里，Supervisor通常都不会在附近待着。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_39_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_4_0">
    <VALUE Lang="GS">There are reports stating that there are smuggling activities at Wharf No. 4.</VALUE>
    <VALUE Lang="GS">Although we need to double check this, we are unable to do it.</VALUE>
    <VALUE Lang="GS">Will you help me investigate and acquire the smuggled goods at Wharf No.4?</VALUE>
    <VALUE Lang="id">Telah masuk laporan bahwa item selundupan ada di atas kapal yang berlabuh di Warf Passage no.4</VALUE>
    <VALUE Lang="id">Seharusnya kami menyita dan menyelidiki semuanya tapi karena situasinya seperti ini kami tidak bisa</VALUE>
    <VALUE Lang="id">Maaf tapi bisa bantu saya untuk menemukan item selundu</VALUE>
    <VALUE Lang="cn">有通报说Wharf No. 4的船上载有走私品。</VALUE>
    <VALUE Lang="cn">虽然我们需要仔细检查确定，但是现在状况有点困难。</VALUE>
    <VALUE Lang="cn">不好意思，可以请您帮我去Wharf No.4的船上把走私品没收回来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_40_0">
    <VALUE Lang="GS">Although the situation out there looks the same, those areas are still pretty dangerous.</VALUE>
    <VALUE Lang="id">Kalau dilihat dari situasinya di luar mungkin suasanya akan menakutkan</VALUE>
    <VALUE Lang="id">Sebelum bencana saja kita tidak bisa masuk semiteman apalagi sekarang pasti lebih berbahaya</VALUE>
    <VALUE Lang="cn">虽然外面的情况看起来是一样的，但这些地区仍然相当地危险。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_40_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_41_0">
    <VALUE Lang="GS">.......20</VALUE>
    <VALUE Lang="id">.......20</VALUE>
    <VALUE Lang="cn">.......20</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_42_0">
    <VALUE Lang="GS">Like what I said before, the gangsters are pretty active in this area. Their numbers grew right after the Sacred Financial Group was established.</VALUE>
    <VALUE Lang="id">Seperti yang saya bilang mereka adalah berandalan yang sejak dulu berkeliaran di daerah sini</VALUE>
    <VALUE Lang="id">Pada awalnya hanya dianggap sebagai berandalan biasa tetapi setelah Yayasan saint dibangun komploton mereka tumbuh menjadi organisasi yang besar</VALUE>
    <VALUE Lang="cn">就像我之前说的，帮派分子们在这一区域里非常活跃。特别是在Sacred Financial Group 成立之后，他们的人数规模急速扩大。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_42_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_43_0">
    <VALUE Lang="GS">Legend says that the power of students has diminished. They can, however, regain their lost power through continuous training and competing amongst themselves.</VALUE>
    <VALUE Lang="id">Kayaknya rumor yang mengatakan bahwa mereka memperkuat kelompoknya secara kompetitif setelah kalah oleh para pelajar adalah benar…</VALUE>
    <VALUE Lang="id">Kini sudah masuk peringkat lima teratas do seluruh asia</VALUE>
    <VALUE Lang="id">Tidak mungkin petinggi-petinggi dari organisasi besar seperti</VALUE>
    <VALUE Lang="cn">传说学生的力量已经减弱。他们可以通过不断的训练和战斗来找回失去的力量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_43_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_44_0">
    <VALUE Lang="GS">We should be able to learn something after investigating this Warehouse.</VALUE>
    <VALUE Lang="GS">Part of our objective is to search for the source of the abnormal phenomenon.</VALUE>
    <VALUE Lang="id">Tapi karena tempat ini adalah gudang mungkin kamu bisa menemukan sesuatu</VALUE>
    <VALUE Lang="id">Tidak masalah kalau tujuannya bukan untuk melawan kelompok kejahatan tapi untuk mencari petunjuk tentang situasi pada saat kecelakaan terjadi</VALUE>
    <VALUE Lang="cn">在调查这个Warehouse之后，我们应该能学到一些东西。</VALUE>
    <VALUE Lang="cn">我们的目标之一就是寻找异象的根本问题。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_44_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_45_0">
    <VALUE Lang="GS">The security of the Wharf Passage is getting worse every minute. The storage guards, gas technicians, vicious sailors and security guards have turned into monsters and they wander around in groups destroying the goods stacked in the Wharf.</VALUE>
    <VALUE Lang="GS">People have been fighting over the lacking goods and if this keeps up then more horrible things will occur. I know you must be busy but please defeat them and help me save the goods here.</VALUE>
    <VALUE Lang="id">Kemanan Wharf Passage sangat rentan. Storage Guard, Gas Technician, dan monster lainnya sangat mengancam.</VALUE>
    <VALUE Lang="id">Orang orang sangat ketakutan. Kamu harus melakukan sesuatu!</VALUE>
    <VALUE Lang="cn">Wharf Passage的治安越来越差。Storage guard、Gas technician、Vicious sailor、Security guard 都已经突变成怪物了。他们甚至还成群结队的到处破坏Wharf的货物。</VALUE>
    <VALUE Lang="cn">人们为了仅存的物资与他们战斗，如果继续这样下去，恐怕会有更可怕的事情发生。</VALUE>
    <VALUE Lang="cn">我知道您一定很忙，但请打败他们，并帮助我在这里保管货物商品。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_45_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_46_0">
    <VALUE Lang="GS">Thanks to you, I wil be safe for a while!</VALUE>
    <VALUE Lang="id">Terima kasih. Saya akan aman untuk sementara!</VALUE>
    <VALUE Lang="cn">谢谢您，我终于可以暂时先喘口气了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_46_0_1">
    <VALUE Lang="GS">Back</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">返回</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_5_0">
    <VALUE Lang="GS">You found it!</VALUE>
    <VALUE Lang="GS">Thanks!</VALUE>
    <VALUE Lang="GS">I'm sure that this is enough evidence.</VALUE>
    <VALUE Lang="id">Seperti yang saya kira kamu sudah menemukannya rupanya</VALUE>
    <VALUE Lang="id">Terimakasih</VALUE>
    <VALUE Lang="id">Dengan ini kita sudah mengumpulkan bukti rupanya</VALUE>
    <VALUE Lang="cn">您找到了！谢谢！</VALUE>
    <VALUE Lang="cn">我不确定是否足够成为证据。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_6_0">
    <VALUE Lang="GS">Is there anyone else who would like to help me arrest those smugglers?</VALUE>
    <VALUE Lang="id">Dan…</VALUE>
    <VALUE Lang="id">Saya harus menangkap orang yang bersangkutan dengan item selundupan ini, bisa bantu saya?</VALUE>
    <VALUE Lang="cn">还有谁愿意跟我一起去逮捕走私犯呢?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_6_0_2">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_6_0_3">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_7_0">
    <VALUE Lang="GS">The smuggler was known to be a member of the "Green" gangster group who rented this building.</VALUE>
    <VALUE Lang="GS">He doesn't plan on running away, which is unexpected. He stays in his room most of the time.</VALUE>
    <VALUE Lang="id">Kami sudah mengkonfirmasikan bahwa penyelundupnya adalah seseorang anggota komplotan Red axe yang sedang menyewa gedung ini</VALUE>
    <VALUE Lang="id">Tapi orang-orang ini tidak ada pikiran untuk melarikan diri dan terus berkeliaran di sekitar sini.</VALUE>
    <VALUE Lang="cn">走私犯正是一名租下这栋建筑物的Green帮派成员。</VALUE>
    <VALUE Lang="cn">令人意外的是，他竟然不打算逃跑。他几乎一直都待在他的房间。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_7_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_8_0">
    <VALUE Lang="GS">Did the suspect fight back?</VALUE>
    <VALUE Lang="GS">Anyway, thanks a lot!</VALUE>
    <VALUE Lang="GS">That Green Gangsters seems to be the source of all the crimes here in this area.</VALUE>
    <VALUE Lang="id">Makhluk itu melawan rupanya</VALUE>
    <VALUE Lang="cn">那家伙有反击吗？</VALUE>
    <VALUE Lang="cn">总之，辛苦了！</VALUE>
    <VALUE Lang="cn">Green混混似乎是这个区域中所有犯罪事件的罪魁祸首。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_9_0">
    <VALUE Lang="GS">I heard that there are students who have special abilities.</VALUE>
    <VALUE Lang="GS">Could you help me investigate this issue?</VALUE>
    <VALUE Lang="id">Saya dengar kalian mempunyai kemampuan yang khusus</VALUE>
    <VALUE Lang="id">Bisa bantu saya untuk mencari petunjuk?</VALUE>
    <VALUE Lang="cn">我听说有学生拥有特别的能力。您能帮我调查这条小道消息吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_9_0_2">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受委托</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_police1.ntk_9_0_3">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_0">
    <VALUE Lang="GS">It used to be so easy to repair a car.....</VALUE>
    <VALUE Lang="id">Saya nggak pernah sesusah ini dalam memperbaiki kendaraan…</VALUE>
    <VALUE Lang="cn">我以前修车一点儿都不困难……</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_0_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_0_2">
    <VALUE Lang="GS">Ask about Current Status</VALUE>
    <VALUE Lang="id">Bertanya situasi</VALUE>
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_1">
    <VALUE Lang="GS">Ah! There you are!</VALUE>
    <VALUE Lang="GS">What were you doing for the past few days?</VALUE>
    <VALUE Lang="GS">Me? I'm trying to fix this antique truck!</VALUE>
    <VALUE Lang="GS">It's really difficult! Can you help me?</VALUE>
    <VALUE Lang="id">Ah, kok…</VALUE>
    <VALUE Lang="id">Sudah berapa hari kamu seperti ini-</VALUE>
    <VALUE Lang="id">Dasar mobil rongsokkan!</VALUE>
    <VALUE Lang="id">Punya niat bergerak atau tidak?</VALUE>
    <VALUE Lang="cn">啊！您来啦！</VALUE>
    <VALUE Lang="cn">过去几天都在忙什么呢？</VALUE>
    <VALUE Lang="cn">我？我想解决这个古董车的问题！</VALUE>
    <VALUE Lang="cn">这真的很难！您能帮助我吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_1_1">
    <VALUE Lang="GS">Change Save Point</VALUE>
    <VALUE Lang="id">Mengubah titik awal</VALUE>
    <VALUE Lang="cn">变更开始位置</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_1_2">
    <VALUE Lang="GS">Ask about What Happened</VALUE>
    <VALUE Lang="id">Bertanya apa yang terjadi</VALUE>
    <VALUE Lang="cn">你在做什么，在过去几天？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_1_3">
    <VALUE Lang="GS">Give the Key</VALUE>
    <VALUE Lang="id">Meminta data</VALUE>
    <VALUE Lang="cn">传达钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_1_4">
    <VALUE Lang="GS">Ask about the Truck</VALUE>
    <VALUE Lang="id">Bertanya tentang truck</VALUE>
    <VALUE Lang="cn">我？我想解决这个问题的古董车！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_1_5">
    <VALUE Lang="GS">Give the Diesel</VALUE>
    <VALUE Lang="id">Menyerahkan diesel</VALUE>
    <VALUE Lang="cn">传达柴油 Diesel</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_1_6">
    <VALUE Lang="GS">Ask about the Truck</VALUE>
    <VALUE Lang="id">Bertanya tentang truck</VALUE>
    <VALUE Lang="cn">这真的很难！你能帮助我吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_1_7">
    <VALUE Lang="GS">Give the Spare Parts</VALUE>
    <VALUE Lang="id">Menyerahkan part</VALUE>
    <VALUE Lang="cn">交付零件</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_1_1_8">
    <VALUE Lang="GS">Ask about Situation</VALUE>
    <VALUE Lang="id">Bertanya situasi</VALUE>
    <VALUE Lang="cn">询问现况</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_10_0">
    <VALUE Lang="GS">These supplies can also be used on the ships.</VALUE>
    <VALUE Lang="GS">I think the neighborhood also keeps a supply of diesel.</VALUE>
    <VALUE Lang="GS">The No.1 Wharf is a short walk from here.</VALUE>
    <VALUE Lang="id">Ini digunakan juga di kapal, kayaknya bisa kita cari di daerah sekitar sini</VALUE>
    <VALUE Lang="id">Kalau kamu pergi sedikit dari sini ada tempat yang dinamakan Wharf Passage No.1</VALUE>
    <VALUE Lang="cn">这些物资，也可用在船舶。</VALUE>
    <VALUE Lang="cn">我觉得附近人家也会保存一些柴油。</VALUE>
    <VALUE Lang="cn">No.1 Wharf是离这里最近的。走吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_10_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_11_0">
    <VALUE Lang="GS">Oh! You aqcuired the supplies faster than I expected! Thank you very much!</VALUE>
    <VALUE Lang="GS">Now, I can start to fix this wreck.</VALUE>
    <VALUE Lang="id">Datang lebih cepat daripada yang dikira rupanya?</VALUE>
    <VALUE Lang="id">Ah- ah- jangan berpikir negatif</VALUE>
    <VALUE Lang="id">Bukan menertawakan kok…</VALUE>
    <VALUE Lang="id">Pokoknya terimakasih</VALUE>
    <VALUE Lang="id">Kini saya bisa membetulkannya dengan baik</VALUE>
    <VALUE Lang="cn">哦！您申请物资的速度比我想像中的还要快！</VALUE>
    <VALUE Lang="cn">真的谢谢。</VALUE>
    <VALUE Lang="cn">现在，我可以开始处理这些故障的机械了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_12_0">
    <VALUE Lang="GS">This area suddenly changed and became like this</VALUE>
    <VALUE Lang="id">Euhm…..</VALUE>
    <VALUE Lang="id">Seperti yang saya bilang tiba-tiba jadi seperti ini</VALUE>
    <VALUE Lang="id">Setelah saya dengarkan kayaknya daerah ini yang paling tenang</VALUE>
    <VALUE Lang="cn">这个地方突然变成了这样…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_12_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_13_0">
    <VALUE Lang="GS">..........3</VALUE>
    <VALUE Lang="id">..........3</VALUE>
    <VALUE Lang="cn">..........3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_14_0">
    <VALUE Lang="GS">Anyway, people suddenly disappeared.</VALUE>
    <VALUE Lang="GS">The trucks and buses stopped moving too!</VALUE>
    <VALUE Lang="GS">It was like total chaos here!</VALUE>
    <VALUE Lang="id">Sudah berapa lama berlalu yah-</VALUE>
    <VALUE Lang="id">Pokoknya tiba-tiba orang-orang menghilang dan truk inipun tidak bisa jalan</VALUE>
    <VALUE Lang="id">Sekarang juga tidak ada tanda-tanda akan bergerak tapi….</VALUE>
    <VALUE Lang="cn">就是，大家都突然消失了。卡车、公车都开不动。整个状况非常地混乱。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_14_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_15_0">
    <VALUE Lang="GS">.....6</VALUE>
    <VALUE Lang="id">.....6</VALUE>
    <VALUE Lang="cn">.....6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_16_0">
    <VALUE Lang="GS">This vehicle is all out of fuel.</VALUE>
    <VALUE Lang="GS">I think we can acquire some supplies nearby.</VALUE>
    <VALUE Lang="id">Saya tidak bisa mengeceknya setelah kunci yang dibetulkan hilang, setelah saya periksa sekarang ternyata sudah tidak ada lagi minyak.</VALUE>
    <VALUE Lang="id">Kalau dulu pasti gampang mendapatkannya di daerah sekitar sini</VALUE>
    <VALUE Lang="cn">这车的油都用完了。</VALUE>
    <VALUE Lang="cn">我想我们可以在附近取得一些用品。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_16_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_17_0">
    <VALUE Lang="GS">I heard there are some supplies at the Trading Hole. Please help me!</VALUE>
    <VALUE Lang="id">Kalau harus pergi sampai ke pom bensin yang ada di Trading Hole juga..</VALUE>
    <VALUE Lang="id">Sya mau minta tolong satu saja</VALUE>
    <VALUE Lang="id">Di depan sana ada orang-orang yang berkeliaran dengan memanggul ikan</VALUE>
    <VALUE Lang="cn">我听说在Trading Hole有不少的补给品。请帮帮我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_17_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_18_0">
    <VALUE Lang="GS">....10</VALUE>
    <VALUE Lang="id">....10</VALUE>
    <VALUE Lang="cn">....10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_19_0">
    <VALUE Lang="GS">There are also some spare parts, gasoline, and oil for lubrication in that area.</VALUE>
    <VALUE Lang="GS">Please help me by bringing some of those supplies.</VALUE>
    <VALUE Lang="id">Di sana ada kapal kargo yang sedang berlabuh</VALUE>
    <VALUE Lang="id">Kalau kamu naik ke atas kapal, kamu bisa menemukan Parts dan minyak yang bisa dijadikan Lubricant oil</VALUE>
    <VALUE Lang="id">Tolong carikan benda-benda itu</VALUE>
    <VALUE Lang="cn">那边停有货船,从甲板上去,应该有零件跟用作润滑油的汽油</VALUE>
    <VALUE Lang="cn">帮我拿一点来.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_19_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_2_0">
    <VALUE Lang="GS">....</VALUE>
    <VALUE Lang="id">....</VALUE>
    <VALUE Lang="cn">....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_20_0">
    <VALUE Lang="GS">......12</VALUE>
    <VALUE Lang="id">......12</VALUE>
    <VALUE Lang="cn">......12</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_21_0">
    <VALUE Lang="GS">Things at the Trading Hole are starting to get messy. I heard that prisoners are trying very hard to escape. There's also the issue of the Management Office staff having a big fight with the students and gangsters.</VALUE>
    <VALUE Lang="id">Mungkin di daerah selatan sedang kacau- ada juga kabar bahwa para tahanan melarikan diri…</VALUE>
    <VALUE Lang="id">Katanya di kantor administrasi juga terjadi pertarungan yang sangat hebat yah….</VALUE>
    <VALUE Lang="cn">搞不好Trading Hole也乱起来了,听说连监狱的罪犯都猛地逃狱,那边的管理办公室也有大战, 这样看来学生和流氓已经大干起来了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_21_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_22_0">
    <VALUE Lang="GS">Please go to the Freezing Warehouse and try to find something that we might need for our investigation.</VALUE>
    <VALUE Lang="id">Kalau diingat-ingat kayaknya saya pernah dengar kalau para pelajar bertarung dengan berandalan-berandalan itu</VALUE>
    <VALUE Lang="id">Ah, coba pergi ke Ice Warehouse yang ada di sana</VALUE>
    <VALUE Lang="cn">请去Freezing Warehouse那边，并试着寻找我们调查时可能会用到的东西。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_22_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_23_0">
    <VALUE Lang="GS">There was an old man asking me to let students enter that area.</VALUE>
    <VALUE Lang="GS">The old man wearing white clothes… He looked very peculiar.</VALUE>
    <VALUE Lang="id">Tadi ada kakek-kakek yang lewat terus berpesan kalau ada pelajar yang lewat tolong sampaikan untuk mencarinya</VALUE>
    <VALUE Lang="id">Dia memakai baju putih dan berjalan seolah-olah tidak terjadi apa-apa..</VALUE>
    <VALUE Lang="id">Kayaknya beliau bukan kakek-kakek biasa…..</VALUE>
    <VALUE Lang="cn">刚刚有个老人经过,要我传话看见学生的话,就请他们去找他,</VALUE>
    <VALUE Lang="cn">身穿白色衣服啥也不做就走来走去,</VALUE>
    <VALUE Lang="cn">好像不是一般老人</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_23_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_3_0">
    <VALUE Lang="GS">I have to take a good look at the office first before I can figure what's going on.</VALUE>
    <VALUE Lang="GS">Errr... I was interrupted while fixing this wreck! Just now, a giant dog took away my Key.</VALUE>
    <VALUE Lang="GS">I can't do anything now.</VALUE>
    <VALUE Lang="id">Setidaknya saya harus pergi ke kantor untuk mengetahui apa yang terjadi tapi ini tidak bisa dibetulkan</VALUE>
    <VALUE Lang="id">Saya sudah tak bisa apa-apa lagi karena tadi anjing yang sebesar rumah datang dan mencuri kunci truk saya</VALUE>
    <VALUE Lang="cn">要先去办公室看看才知道怎么回事?到底是不是不修了?</VALUE>
    <VALUE Lang="cn">而且刚刚有只如房屋般大的狗刁走我的卡车钥匙,啥都不能做了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_3_0_1">
    <VALUE Lang="GS">Help the Truck Driver Recover the Key</VALUE>
    <VALUE Lang="id">Bilang kalau kamu bisa mencarikan kunci yang hilang</VALUE>
    <VALUE Lang="cn">帮助Truck Driver 修复钥匙</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_3_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_4_0">
    <VALUE Lang="GS">Thank you very much!</VALUE>
    <VALUE Lang="GS">You look real strong, so I'm sure you can take care of those nasty hounds for me.</VALUE>
    <VALUE Lang="GS">You seem brave enough...</VALUE>
    <VALUE Lang="GS">Do you want to accept my request?</VALUE>
    <VALUE Lang="id">...</VALUE>
    <VALUE Lang="id">Terimakasih sih…</VALUE>
    <VALUE Lang="id">Meskipun aku ini bukan penjinak anjing tapi aku tahu kalau anjing itu bukan anjing biasa.</VALUE>
    <VALUE Lang="id">Sepertinya sih dia tidak begitu kuat, tidak apa-apa kan?</VALUE>
    <VALUE Lang="id">Yah…dia bilang seperti itu karena punya rasa percaya diri untuk mengatakann</VALUE>
    <VALUE Lang="cn">先谢谢啦!</VALUE>
    <VALUE Lang="cn">我不是狗买卖,但是你应该知道他不是普通流浪狗.</VALUE>
    <VALUE Lang="cn">你看起来不是很强,没关系吗?</VALUE>
    <VALUE Lang="cn">因为有自信所以才会说这种话,</VALUE>
    <VALUE Lang="cn">要接收我的请求吗?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_5_0">
    <VALUE Lang="GS">Oh! You really found it!</VALUE>
    <VALUE Lang="GS">It doesn't look the same anymore.</VALUE>
    <VALUE Lang="GS">Ah! Have you heard about the heroes?</VALUE>
    <VALUE Lang="GS">These are the students who possess exceptional capabilities.</VALUE>
    <VALUE Lang="GS">Yes, I've just heard rumors that they're more than just normal students.</VALUE>
    <VALUE Lang="GS">Anyway, thank you very much!</VALUE>
    <VALUE Lang="id">Eh, kamu benar-benar menemukannya?</VALUE>
    <VALUE Lang="id">Kamu berkelahi juga rupanya beda sekali dengan penampilan dari luar?</VALUE>
    <VALUE Lang="id">Ah…setelah dilihat sekarang ternyata kamu pelajar saint atau sekolah apa gitu?</VALUE>
    <VALUE Lang="id">Begitu rupanya…selama ini saya hanya mendengar dari rumor saja.</VALUE>
    <VALUE Lang="cn">真的找回来了!</VALUE>
    <VALUE Lang="cn">和看的不同,大概是一个拳头大吗?</VALUE>
    <VALUE Lang="cn">阿!现在看来圣者是什么?就是那些学院的学生阿,</VALUE>
    <VALUE Lang="cn">是阿!只听过传闻,真的不是一般学生</VALUE>
    <VALUE Lang="cn">这真是多谢</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_5_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_6_0">
    <VALUE Lang="GS">My friends usually provide me with the Diesel supplies I need. Right now, I have no means to acquire Diesel for this truck.</VALUE>
    <VALUE Lang="GS">Would you please help me get some Diesel fuel?</VALUE>
    <VALUE Lang="id">Padahal dulu mereka membagikan minyak</VALUE>
    <VALUE Lang="id">Sekarang saya tidak bisa menjamim akan begitu tapi coba saja tanyakan</VALUE>
    <VALUE Lang="cn">我的朋友们平时都会给我需要的Diesel。但现在我无法取得卡车的Diesel。您可以帮我取得一些Diesel Fuel来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_6_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_6_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_7_0">
    <VALUE Lang="GS">Please hurry!</VALUE>
    <VALUE Lang="GS">It's dangerous out there!</VALUE>
    <VALUE Lang="id">Selama saya memperbaikinya kamu silahkan pergi</VALUE>
    <VALUE Lang="id">Berapa waktu lalu saya bertemu dengan seseorang, saya ajak bicara tapi dia tidak mengerti terus matanya seperti orang mabuk, sepertinya gawat kalau saya mencari masalah dengan dia</VALUE>
    <VALUE Lang="cn">请快点！</VALUE>
    <VALUE Lang="cn">外面很危险的。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_7_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_8_0">
    <VALUE Lang="GS">I think you can negotiate to acquire the diesel supplies that we need. Please be vigilant!</VALUE>
    <VALUE Lang="id">Kalau dilihat dari suasananya sepertinya tidak mungkin bisa mendapatkannya hanya melalui percakapan</VALUE>
    <VALUE Lang="id">Pokoknya karena sudah mendapatkan minyak tidak ada masalah sih</VALUE>
    <VALUE Lang="id">Kalau bisa lebih baik menyelesaikannya dengan baik-baik</VALUE>
    <VALUE Lang="cn">我想你可以透过谈判来取得我们需要的柴油。请小心加油 ！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_8_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_9_0">
    <VALUE Lang="GS">It's really impossible to get this truck to move. I've tried my best to get this thing to work!</VALUE>
    <VALUE Lang="GS">I feel so hopeless now....</VALUE>
    <VALUE Lang="GS">Could you help me?</VALUE>
    <VALUE Lang="id">Sudah sejak dulu saya membuang pikiran bahwa ini akan mudah diperbaiki</VALUE>
    <VALUE Lang="id">Seperti yang saya kira tidak bergerak sama sekali</VALUE>
    <VALUE Lang="id">Ini tidak masuk akal, baru saja saya memperbaikinya tadi tapi sudah rusak lagi seprti ini</VALUE>
    <VALUE Lang="id">Mau tidak mau harus dibetulkan l</VALUE>
    <VALUE Lang="cn">这个卡车应该无法再启动了。我已经尽我所能去修复它了。</VALUE>
    <VALUE Lang="cn">我现在觉得好绝望.... 能帮我吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_9_0_1">
    <VALUE Lang="GS">Accept Request</VALUE>
    <VALUE Lang="id">Menerima</VALUE>
    <VALUE Lang="cn">接受请求</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_truckdriver1.ntk_9_0_2">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Menolak</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2007p.ntk_1_0">
    <VALUE Lang="GS">Oh dear..It's already too late.. So stupid that I lost that..</VALUE>
    <VALUE Lang="id">Oh.. Ini sudah sangat telat.. Sangat bodoh sampai aku bisa kehilangannya..</VALUE>
    <VALUE Lang="cn">"哎呀..</VALUE>
    <VALUE Lang="cn">糟糕!时间都已经这么晚了... 像傻瓜一样竟然把东西弄丢了…"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2007p.ntk_1_0_1">
    <VALUE Lang="GS">Ask what's happening</VALUE>
    <VALUE Lang="id">Bertanya adakah yang bisa dibantu</VALUE>
    <VALUE Lang="cn">询问发生了何事？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2007p.ntk_1_0_2">
    <VALUE Lang="GS">Exchange ill luck package</VALUE>
    <VALUE Lang="id">Tukar ill luck package</VALUE>
    <VALUE Lang="cn">兑换厄运包</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2007p.ntk_2_0">
    <VALUE Lang="GS">ill luck packages have been stolen by Alienated zina which I've collected for a year..I have no idea what she will do with it.. thoroughly understand her.. She eagerly hoped to be in the 12 Earth's Branches..she would have a grudge..but already the matter has decided.. My goodness.. I have no time ! Will you find that packages for me?</VALUE>
    <VALUE Lang="id">ill luck packages yang sudah saya kumpulkan selama 1 tahun dicuri oleh Alienated zina.. Saya benar - benar tidak menyangka dia akan melakukan itu.. Dia berhasrat untuk menjadi salah satu dari 12 Ketua Perkumpulan dari Earth.. Bisakah kamu membantu saya me</VALUE>
    <VALUE Lang="cn">把过去一整年的霉运集中包起来的'倒楣袋(Ill luck packages)', 不小心被'Alienated zina'抢走了.. 不知道她拿着那个包袱,会做出什么事情.. 我很了解她的心情。她那么想成为代表12生肖的神里面的一个.. 她一定有许多的埋怨，但是还能怎么办呢？结果已经是这样了.</VALUE>
    <VALUE Lang="cn">唉呀,,.. 我现在不是这样闲聊的时候.. 你可以帮我找回那个'Ill luck packages'吗？</VALUE>
    <VALUE Lang="cn">…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2007p.ntk_2_0_1">
    <VALUE Lang="GS">Back to the beginning</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回到最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2007p.ntk_3_0">
    <VALUE Lang="GS">you really have gathered these so many? So thank you.. It's still many packages out there, but I am happy..</VALUE>
    <VALUE Lang="GS">I should repay your kindness.. Here.. Choose one you like</VALUE>
    <VALUE Lang="id">Banyak sekali yang kamu kumpulkan...</VALUE>
    <VALUE Lang="id">Benar - benar terima kasih sudah membawakannya. Sebagai gantinya, silahkan pilih hadiah yang diinginkan</VALUE>
    <VALUE Lang="cn">真的收集这么多回来了?</VALUE>
    <VALUE Lang="cn">实在太谢谢你了... 虽然还剩不少，但是这些就够了...</VALUE>
    <VALUE Lang="cn">我要好好报答你。来！选一个你想要的吧！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2007p.ntk_3_0_1">
    <VALUE Lang="GS">Exchange to good luck package</VALUE>
    <VALUE Lang="id">Tukar dengan Good Luck Package</VALUE>
    <VALUE Lang="cn">兑换好运包</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2007p.ntk_3_0_2">
    <VALUE Lang="GS">Exchange to lucky party costume(7days)</VALUE>
    <VALUE Lang="id">Tukar dengan Lucky Party Costume(7days)</VALUE>
    <VALUE Lang="cn">兑换Lucky party costume(7D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2007p.ntk_3_0_3">
    <VALUE Lang="GS">Exchange to lucky party costume(7days)</VALUE>
    <VALUE Lang="id">Tukar dengan Lucky Party Costume(7days)</VALUE>
    <VALUE Lang="cn">兑换Lucky party costume(7D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008_dragonboat.ntk_1_0">
    <VALUE Lang="GS">Hi,</VALUE>
    <VALUE Lang="GS">can help me defeat 100[Changgie soldier]?</VALUE>
    <VALUE Lang="id">Hello,</VALUE>
    <VALUE Lang="id">Bisakah kamu membantu saya membunuh 100 Changgie Soldier?</VALUE>
    <VALUE Lang="cn">嗨！您好。可以帮我打倒100个[Changgie soldier]吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008_dragonboat.ntk_1_0_1">
    <VALUE Lang="GS">Tell the result</VALUE>
    <VALUE Lang="id">Beritahukan hasilnya</VALUE>
    <VALUE Lang="cn">报告结果</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008_dragonboat.ntk_1_1">
    <VALUE Lang="GS">Do you finish to defeat Changgie Soldier??</VALUE>
    <VALUE Lang="id">Apakah kamu sudah membunuh Changgie Soldier??</VALUE>
    <VALUE Lang="cn">您已经打倒Changgie Soldier了吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008_dragonboat.ntk_1_1_1">
    <VALUE Lang="GS">Start 'Catch The Chonggie'</VALUE>
    <VALUE Lang="id">Memulai quest 'Catch The Chonggie'</VALUE>
    <VALUE Lang="cn">'抓拿Chonggie' 开始</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008_dragonboat.ntk_2_0">
    <VALUE Lang="GS">Good luck!!</VALUE>
    <VALUE Lang="id">Semoga Berhasil!!</VALUE>
    <VALUE Lang="cn">祝您好运！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008_dragonboat.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008_dragonboat.ntk_3_0">
    <VALUE Lang="GS">Thank you so much.</VALUE>
    <VALUE Lang="GS">You have very special skill.</VALUE>
    <VALUE Lang="id">Terima Kasih!!!</VALUE>
    <VALUE Lang="id">Kamu benar - benar sangat kuat.</VALUE>
    <VALUE Lang="cn">太谢谢您了！</VALUE>
    <VALUE Lang="cn">您有着超人般的神技唷！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008_dragonboat.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008m.ntk_1_0">
    <VALUE Lang="GS">oh~ Isn’t it good luck packages?</VALUE>
    <VALUE Lang="GS">How come you are holding them?</VALUE>
    <VALUE Lang="GS">I see... There was like that happening ..I am good that you want to bring ill luck packages instead..</VALUE>
    <VALUE Lang="GS">Anyway thanks to take hard work in charge in stead of my friend</VALUE>
    <VALUE Lang="GS">Nothing big..but hope to be blessed by this lucky necklace..Happy new year~</VALUE>
    <VALUE Lang="id">oh~ Bukankah itu paket keberuntungan?</VALUE>
    <VALUE Lang="id">Bagaimana mungkin kamu bisa memilikinya?</VALUE>
    <VALUE Lang="id">Ah... Terima Kasih sudah membawakannya..</VALUE>
    <VALUE Lang="id">Tidak seberapa… Semoga kamu beruntung dengan pemberian saya ini… Selamat Tahun Baru~</VALUE>
    <VALUE Lang="cn">哎哟,,那​​不是 'Good luck packages'吗？</VALUE>
    <VALUE Lang="cn">你怎会拿着那个包袱呢？</VALUE>
    <VALUE Lang="cn">啊.. 原来是有那种事情..你要替我把' Ill luck packages'带走的话，我当然很好啊... 不管如何你如此的帮我朋友做辛苦的事情，实在太谢谢你了。</VALUE>
    <VALUE Lang="cn">虽然不是什么特别的东西, 新年到来希望这个'Lucky necklace' 能带来满满的福运..恭喜发财！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008m.ntk_1_0_1">
    <VALUE Lang="GS">Exchange to lucky necklace(7days)</VALUE>
    <VALUE Lang="id">Tukar dengan Lucky Necklace (7days)</VALUE>
    <VALUE Lang="cn">兑换Lucky necklace(7D)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008m.ntk_1_1">
    <VALUE Lang="GS">Already late..</VALUE>
    <VALUE Lang="GS">Never seems to come..</VALUE>
    <VALUE Lang="GS">When can I start my work for this year?</VALUE>
    <VALUE Lang="id">Mulai kapan saya bisa mulai bekerja?</VALUE>
    <VALUE Lang="cn">现在都几点了..</VALUE>
    <VALUE Lang="cn">怎么都还不来呢?</VALUE>
    <VALUE Lang="cn">这样我就没有办法开始做事情了</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008m.ntk_1_1_1">
    <VALUE Lang="GS">Listen to the conversation</VALUE>
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
    <VALUE Lang="cn">听取故事</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008m.ntk_2_0">
    <VALUE Lang="GS">It's new year..</VALUE>
    <VALUE Lang="GS">I must work hard for this year..but Tired pig never seems to come</VALUE>
    <VALUE Lang="GS">too loiter on the way here..even though Tired pig should bring good luck packages not only ill luck packages !</VALUE>
    <VALUE Lang="id">It's new year..</VALUE>
    <VALUE Lang="id">I must work hard for this year..but Tired pig never seems to come</VALUE>
    <VALUE Lang="id">too loiter on the way here..even though Tired pig should bring good luck packages not only ill luck packages !</VALUE>
    <VALUE Lang="cn">元旦的太阳已经升起来了...</VALUE>
    <VALUE Lang="cn">今年是我要努力工作的一年。但是 Tired pig到现在还没有出现。</VALUE>
    <VALUE Lang="cn">他会把 Ill luck packages送过来，也会准备Good luck packages！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008valentine.ntk_1_0">
    <VALUE Lang="GS">I was lost my love arrow.</VALUE>
    <VALUE Lang="GS">Can you help me?</VALUE>
    <VALUE Lang="id">Saya kehilangan panah cinta saya.</VALUE>
    <VALUE Lang="id">Bisakah membantu saya mencarinya?</VALUE>
    <VALUE Lang="cn">我遗失了我的爱之弓。您可以帮我找回来吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008valentine.ntk_1_0_1">
    <VALUE Lang="GS">Can I ask a favour of you?</VALUE>
    <VALUE Lang="id">Bisakah saya meminta bantuan?</VALUE>
    <VALUE Lang="cn">我可以跟您提个请求吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008valentine.ntk_1_0_2">
    <VALUE Lang="GS">Exchange to Valentine Event item</VALUE>
    <VALUE Lang="id">Tukar dengan Valentine item</VALUE>
    <VALUE Lang="cn">兑换《情人节活动道具》</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008valentine.ntk_2_0">
    <VALUE Lang="GS">I heard to birds.I was while a bit sleeps in a grove, cyclops steal my arrow of love</VALUE>
    <VALUE Lang="GS">Can I have my arrow of love please?</VALUE>
    <VALUE Lang="GS">If you help to me, I'll offer power of love to you.</VALUE>
    <VALUE Lang="id">Saya ketiduran di dalam gua dan tiba - tiba cyclops muncul dan mencuri panah saya.</VALUE>
    <VALUE Lang="id">Bisakah kamu membantu mendapatkannya kembali?</VALUE>
    <VALUE Lang="id">Jika kamu bersedia, saya akan membantumu mencari cinta.</VALUE>
    <VALUE Lang="cn">我听到了鸟语之音…. 但我只不过是在果树林中睡了一下下，独眼人竟然趁机偷走了我的爱弓！我能再次拥有我的爱弓吗？如果您愿意帮我，我将会分享给您这爱的力量的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008valentine.ntk_2_0_1">
    <VALUE Lang="GS">To begin</VALUE>
    <VALUE Lang="id">Mulai</VALUE>
    <VALUE Lang="cn">回到最初</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008valentine.ntk_3_0">
    <VALUE Lang="GS">Thank you, Kindly student.</VALUE>
    <VALUE Lang="GS">You can using power of love while 15days</VALUE>
    <VALUE Lang="id">Terima Kasih Pahlawan.</VALUE>
    <VALUE Lang="id">Kamu dapat menggunakan kekuatan cinta ini selama 15 hari.</VALUE>
    <VALUE Lang="cn">谢谢学生，真亲切。现在您可以使用15天爱的力量!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008valentine.ntk_3_0_1">
    <VALUE Lang="GS">Exchange to power of Love(M)</VALUE>
    <VALUE Lang="id">Tukar dengan Power of Love (M)</VALUE>
    <VALUE Lang="cn">交换 power of Love(M)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2008valentine.ntk_3_0_2">
    <VALUE Lang="GS">Exchange to power of Love(F)</VALUE>
    <VALUE Lang="id">Tukar dengan Power of Love (F)</VALUE>
    <VALUE Lang="cn">交换 power of Love(F)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_jack.ntk_1_0">
    <VALUE Lang="GS">Snow is the symbol of Christmas but since we are short on Snow Flakes this year so don't expect a white Christmas. Bring me snow flakes then I will exchange it for a gift.</VALUE>
    <VALUE Lang="GS">Oh and this is a secret.. Please don't tell sally that I am here. I am not here to see Genie!</VALUE>
    <VALUE Lang="id">Salju adalah simbol dari hari Natal, akan tetapi untuk saat ini kami kekurangan Snow Flakes jadi jangan berharap Natal Putih ya tahun ini. Bawakan saya Snow Flakes dan akan kuberikan hadiah. Ini rahasia loh, jangan bilang siapa - siapa terutama Genie!</VALUE>
    <VALUE Lang="cn">雪是圣诞节的象征，但今年我们雪量不足，所以无法指望一个白色圣诞。如果您带给我雪花，我就给您奖励品。</VALUE>
    <VALUE Lang="cn">哦，这是一个秘密。请不要告诉Sally 我在这里。我来这里不是为了Genie！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_jack.ntk_1_0_1">
    <VALUE Lang="GS">Please exchange it for Snow Bike!</VALUE>
    <VALUE Lang="id">Pilih Snow Bike!</VALUE>
    <VALUE Lang="cn">请兑换Snow Bike！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_jack.ntk_1_0_2">
    <VALUE Lang="GS">Please exchange it for Rudolph Costume!</VALUE>
    <VALUE Lang="id">Pilih Rudolph Costume!</VALUE>
    <VALUE Lang="cn">请兑换Rudolph Costume！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_jack.ntk_1_0_3">
    <VALUE Lang="GS">This is a Love Letter for you!</VALUE>
    <VALUE Lang="id">Ini ada Surat Cinta untuk kamu!</VALUE>
    <VALUE Lang="cn">这是给您的情书。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_jack.ntk_3_0">
    <VALUE Lang="GS">(After reading the love letter..)</VALUE>
    <VALUE Lang="GS">Oh MY GOODNESS! She knows! This can't be true! Please tell me this is not happening to me!</VALUE>
    <VALUE Lang="GS">I am going to drink this Christmas away.. Yeah.. Booze is the only friend of man.</VALUE>
    <VALUE Lang="id">(Setelah membaca surat cinta.)</VALUE>
    <VALUE Lang="id">Oh Tuham! Dia tahu! Ini bohong kan?! Kenapa harus terjadi pada saya!</VALUE>
    <VALUE Lang="cn">（看完情书。）</VALUE>
    <VALUE Lang="cn">哦，我的天啊！她知道！这不是真的！请告诉我这是一场梦！我在做梦！</VALUE>
    <VALUE Lang="cn">我要去圣诞节酒宴派对....是啊.. 豪饮是男人的唯一的朋友。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_jack.ntk_3_0_1">
    <VALUE Lang="GS">Right? Solo is the best!</VALUE>
    <VALUE Lang="id">Benar? Single adalah yang terbaik!</VALUE>
    <VALUE Lang="cn">对吗？单身是最赞的！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_selly.ntk_1_0">
    <VALUE Lang="GS">I must get ready for a big Christmas party but all the ornaments for the Christmas tree are missing. Find me the ornaments then I will exchange it for a gift.</VALUE>
    <VALUE Lang="GS">I was looking for the ornaments and Jack disappeared. Have you seen Jack?</VALUE>
    <VALUE Lang="id">Saya harus bersiap untuk Pesta Natal tetapi semua ornamen untuk Natal menghilang. Carikan saya dan diberi imbalan sebagai hadiah.</VALUE>
    <VALUE Lang="id">Ornamen tersebut hilang beserta si Jack? Apakah kamu melihat Jack?</VALUE>
    <VALUE Lang="cn">我必须要准备一个盛大的耶诞派对，但我把要挂在耶诞树上面的装饰品给弄丢了。如果您找给我，我就给您不错的奖励。</VALUE>
    <VALUE Lang="cn">当我在寻找装饰品时，Jack突然不见了。请问您有看到Jack吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_selly.ntk_1_0_1">
    <VALUE Lang="GS">Please exchange it for Reform Card!</VALUE>
    <VALUE Lang="id">Pilih Reform Card!</VALUE>
    <VALUE Lang="cn">请兑换 Reform Card！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_selly.ntk_1_0_2">
    <VALUE Lang="GS">Please exchange it for 1P Card!</VALUE>
    <VALUE Lang="id">Pilih 1P Card!</VALUE>
    <VALUE Lang="cn">请兑换 1P Card！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_selly.ntk_1_0_3">
    <VALUE Lang="GS">I saw Jack with a girl named Genie!</VALUE>
    <VALUE Lang="id">Saya melihat Jack bersama Genie!</VALUE>
    <VALUE Lang="cn">我看到 Jack正和一个叫做 Genie的女孩玩在一块！</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_selly.ntk_2_0">
    <VALUE Lang="GS">What happened? It is almost the Christmas and how can he..? If this is true then would you please deliver this letter to him?</VALUE>
    <VALUE Lang="id">Apa yang terjadi? Ini hampir Natal dan apa yang sedang dia lakukan? Jikalau ini benar, bisakah kamu sampaikan surat saya?</VALUE>
    <VALUE Lang="cn">发生什么事情了？都已经要圣诞节了，他怎么还可以……如果这是真的，那可以请您帮我把信交给他吗？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_2012xmas_selly.ntk_2_0_1">
    <VALUE Lang="GS">Okay, leave it to me!</VALUE>
    <VALUE Lang="id">Serahkan pada saya!</VALUE>
    <VALUE Lang="cn">好！把这个留给我。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_1_0">
    <VALUE Lang="GS">Welcome back Hero!</VALUE>
    <VALUE Lang="GS">Attain your fame and presence once again in Ran World.</VALUE>
    <VALUE Lang="GS">I will help you! It won't be hard to acheive with my support.</VALUE>
    <VALUE Lang="GS">* Please make sure to check your class and skill before receiving the item pack. Item pack cannot be exchanged once received.</VALUE>
    <VALUE Lang="id">Oh~ kamu, sudah datang?</VALUE>
    <VALUE Lang="id">Ada Hero's weapon yang sudah disiapkan untukmu. Dan kalau hari ini kamu bisa melakukan permintaan saya, ada hadiah besar yang sedang menunggu</VALUE>
    <VALUE Lang="cn">欢迎回来！我们的英雄！</VALUE>
    <VALUE Lang="cn">请试着提高您在Ran World的实力。</VALUE>
    <VALUE Lang="cn">我会帮你！有我的加持，您不会太辛苦的。</VALUE>
    <VALUE Lang="cn">*在领取道具包之前，请确认您的职业和技能。收到道具包之后，无法进行再兑换。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_1_0_1">
    <VALUE Lang="GS">Submit Hero Inviation for 'Hero Pack'</VALUE>
    <VALUE Lang="id">Mengembalikan kartu undangan dan menukarkan senjata</VALUE>
    <VALUE Lang="cn">提交英雄邀请函'Hero Pack'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_1_0_2">
    <VALUE Lang="GS">Not interested.</VALUE>
    <VALUE Lang="id">Tidak Tertarik</VALUE>
    <VALUE Lang="cn">没有兴趣</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_1_1">
    <VALUE Lang="GS">Hero’s weapon will only be provided to heroes who has not shown up</VALUE>
    <VALUE Lang="GS">over 60 days.</VALUE>
    <VALUE Lang="GS">Such heroes will be furnished with Hero Invitations which they can</VALUE>
    <VALUE Lang="GS">exchange for the weapon.</VALUE>
    <VALUE Lang="GS">Hero’s weapon are the little welcome back gift for the returning</VALUE>
    <VALUE Lang="GS">heroes.</VALUE>
    <VALUE Lang="id">Oh~ kamu, sudah datang?</VALUE>
    <VALUE Lang="id">Ada Hero's weapon yang sudah disiapkan untukmu. Dan kalau hari ini kamu bisa melakukan permintaan saya, ada hadiah besar yang sedang menunggu</VALUE>
    <VALUE Lang="cn">英雄的武器将只提供给60天以上没有露脸的英雄们.</VALUE>
    <VALUE Lang="cn">持有Hero Invitation的英雄可以进行换取武器.</VALUE>
    <VALUE Lang="cn">换句话说，英雄的武器正是欢迎各位英雄回归队伍的小小祝贺礼物唷.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_1_1_1">
    <VALUE Lang="GS">Next</VALUE>
    <VALUE Lang="id">Berikut</VALUE>
    <VALUE Lang="cn">继续</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_2_0">
    <VALUE Lang="GS">Please keep up the good work for our school.</VALUE>
    <VALUE Lang="id">Saya harap kamu bisa berusaha untuk sekolah</VALUE>
    <VALUE Lang="cn">请继续保卫我们的校园。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_2_0_1">
    <VALUE Lang="GS">Exchange Hero Invitation for Hero's Sword Pack</VALUE>
    <VALUE Lang="id">Menukarkan Invitation letter dengan 'Hero's sword'</VALUE>
    <VALUE Lang="cn">拿Hero Invitation 兑换 Hero's Sword Pack</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_6thkor.ntk_2_0_10">
    <VALUE Lang="GS">Exchange Hero Invitation for Hero's Spear Pack</VALUE>
    <VALUE Lang="id">Menukarkan Invitation letter dengan 'Hero's stick'</VALUE>
    <VALUE Lang="cn">拿Hero Invitation 兑换 Hero's Spear Pack</VALUE>
  </SENTENSE>
