  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_18">
    <VALUE Lang="GS">Tell him that you would like to complete the Eight Signs of Divine</VALUE>
    <VALUE Lang="id">Ingin menyelesaikan the Eight Trigrams</VALUE>
    <VALUE Lang="cn">告诉他您愿意完成 Eight Signs of Divine任务</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sosungil1.ntk_1_0_19">
    <VALUE Lang="GS">Ask if he needs help with anything</VALUE>
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu.</VALUE>
    <VALUE Lang="cn">询问是否需要帮忙？</VALUE>
