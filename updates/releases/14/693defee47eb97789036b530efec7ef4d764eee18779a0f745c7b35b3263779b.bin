    <VALUE Lang="id">....</VALUE>
    <VALUE Lang="cn">......</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_11_0">
    <VALUE Lang="GS">The top priority targets for this area are the Street Junkies. Please help eliminate 22 of them.</VALUE>
    <VALUE Lang="id">Di lokasi ini targetnya adalah Street Junkie</VALUE>
    <VALUE Lang="id">Jatuhkan 22 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为Street Junky。请除掉22只Street Junky，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_11_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_2_0">
    <VALUE Lang="GS">The Terminal is running properly.</VALUE>
    <VALUE Lang="id">Terminal beroperasi secara normal</VALUE>
    <VALUE Lang="cn">终端机正常运作中</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_2_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_3_0">
    <VALUE Lang="GS">The Force Field Mechanism of the Terminal running properly. You must gather Spiritual Spheres to optimize the Force Field.</VALUE>
    <VALUE Lang="GS">You'll need 7 Spiritual Spheres in order to activate this Terminal's Force Field.</VALUE>
    <VALUE Lang="id">Pengoperasian Force Field di Terminal berfungsi secara normal</VALUE>
    <VALUE Lang="id">Jika ingin mendapatkan hasil autentikasi, anda harus mengumpulkan spiritual sphere dan mendapatkan konfirmasi, untuk konfirmasi authentication kali ini anda harus mengumpulkan 7 buah spiritu</VALUE>
    <VALUE Lang="cn">终端机的结界机能正常运作中。您需要7颗灵珠才能通过认证，并得到结界的能量。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_3_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_4_0">
    <VALUE Lang="GS">The optimization of this Force Field is completed!</VALUE>
    <VALUE Lang="GS">Please proceed to the next Terminal responsible for the next Force Field Optimization.</VALUE>
    <VALUE Lang="id">Autentikasi Force Field telah selesai</VALUE>
    <VALUE Lang="id">Jika sisa autentikasi Force Field telah selesai hasilnya bisa di dapatkan dan untuk autentikasi Force Field berikutnya harap gunakan terminal yang sesuai</VALUE>
    <VALUE Lang="cn">本结界认证已结束。请前往下个终端机，并完成结界认证。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_5_0">
    <VALUE Lang="GS">There are evil spirits roaming the Science Center. The mobs of monsters possessed by these spirits are causing strange effects to their surroundings. Please try your best to eliminate them.</VALUE>
    <VALUE Lang="id">Para Jelmaan sedang beraktivitas di dalam Science Center</VALUE>
    <VALUE Lang="id">Roh Jelmaan ini dapat mempengaruhi situasi disekelilingnya. Tolong bersihkan Roh Jelmaan ini sebelum terjadi hal yang lebih buruk</VALUE>
    <VALUE Lang="cn">许多恶灵在 Science Center 里徘徊游荡。被这些恶灵所附着的怪物身上有着不良物质，导致周遭环境出现奇怪现象。请您尽全力处理掉怪物。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_5_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_gwahak_1.ntk_6_0">
    <VALUE Lang="GS">The target amount of purification has been achieved and verified.</VALUE>
    <VALUE Lang="GS">Thank you for your efforts!</VALUE>
    <VALUE Lang="id">Konfirmasi target pembersihan musuh telah selesai</VALUE>
    <VALUE Lang="id">Terima kasih atas kerja keras kalian</VALUE>
    <VALUE Lang="cn">已经确认了目标物与其数量净化的完成。 谢谢您，辛苦您了。</VALUE>
  </SENTENSE>
