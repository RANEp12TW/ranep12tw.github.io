  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_8_0">
    <VALUE Lang="GS">The Main Gate of the campus building is straight ahead. The Welfare Society and the Lockers are over there. You should go there so you'll know where they are when you need them.</VALUE>
    <VALUE Lang="id">Jangan bertingkah kayak anak baru….</VALUE>
    <VALUE Lang="id">Main Building sudah ditutup</VALUE>
    <VALUE Lang="cn">学院的Main Gate就在正前方。Welfare Society 和 Lockers 都在那儿附近。建议您先前往确认位置，以后有急事要办时，就不怕找不到他们了。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_8_0_1">
    <VALUE Lang="GS">Next Page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_9_0">
    <VALUE Lang="GS">Please let me know if you have any questions.</VALUE>
    <VALUE Lang="id">Penasaran apa, ayo bilang</VALUE>
    <VALUE Lang="cn">您想知道什么呢？</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_9_0_1">
    <VALUE Lang="GS">Ask about the Shaman Section</VALUE>
    <VALUE Lang="id">Bertanya tentang kelas Shaman</VALUE>
    <VALUE Lang="cn">询问关于气功部</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_9_0_2">
    <VALUE Lang="GS">Ask about Training Methods</VALUE>
    <VALUE Lang="id">Bertanya tentang cara mengerjakan tugas</VALUE>
    <VALUE Lang="cn">询问修炼方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_9_0_3">
    <VALUE Lang="GS">Ask about Combat Methods</VALUE>
    <VALUE Lang="id">Bertanya tentang cara bertarung</VALUE>
    <VALUE Lang="cn">询问战斗方法</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_9_0_4">
    <VALUE Lang="GS">Ask about Skill Points</VALUE>
    <VALUE Lang="id">Bertanya tentang Skill Point</VALUE>
    <VALUE Lang="cn">询问技能点数</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_spirit1.ntk_9_0_5">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_1_0">
    <VALUE Lang="GS">If you've got a broom, then you're going to be doing some sweeping, right? If you're not, then please put that broom away before coming into the Admin Office.</VALUE>
    <VALUE Lang="id">Kamu membawa Special Broom? sedang bersih-bersih rupanya.</VALUE>
    <VALUE Lang="id">Kalau tidak…</VALUE>
    <VALUE Lang="id">Atau kamu datang untuk mengembalikannya</VALUE>
    <VALUE Lang="id">Atau simpan dulu sebentar baru ngobrol,</VALUE>
    <VALUE Lang="id">mau tidak?</VALUE>
    <VALUE Lang="cn">如果你有一把扫帚，你会去扫地，对不对？如果你不是，那么请在进入Admin Office之前把它放下。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_1_0_1">
    <VALUE Lang="GS">Clean the Dormitory</VALUE>
    <VALUE Lang="id">Membersihkan Dormitory</VALUE>
    <VALUE Lang="cn">打扫宿舍</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_1_0_2">
    <VALUE Lang="GS">Hand in the Garbage</VALUE>
    <VALUE Lang="id">Menyerahkan Trash</VALUE>
    <VALUE Lang="cn">交付垃圾</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_1_0_3">
    <VALUE Lang="GS">Ask about Returning the Broom</VALUE>
    <VALUE Lang="id">Bertanya tentang pengembalian Special Broom</VALUE>
    <VALUE Lang="cn">询问关于归还扫帚</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_1_1">
    <VALUE Lang="GS">It looks like you still haven't registered as a College Student yet! Even though the situation outside is complete chaos, I'll never allow a new student to skip the registration process.</VALUE>
    <VALUE Lang="GS">You need to register first so we can confirm whether you are qualified to be a student of this college.</VALUE>
    <VALUE Lang="GS">Please finish the Registration process as soon as possible.</VALUE>
    <VALUE Lang="id">Kamu tidak tedaftar secara resmi, walau database tidak berjalan normal, ingatanku tidak bisa dibohongi.</VALUE>
    <VALUE Lang="cn">看来你还没有注册呢！尽管外面的情况是混乱，我永远不会允许新的学生省略注册过程。</VALUE>
    <VALUE Lang="cn">您需要先注册，我们才可以确认你是否有资格成为这所学院的学生。</VALUE>
    <VALUE Lang="cn">请尽快完成注册。</VALUE>
  </SENTENSE>
