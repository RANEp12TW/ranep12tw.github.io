  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_2_0">
    <VALUE Lang="GS">Initially, your character's Skill Points is set to 0. You earn 1 additional skill point every time your character levels up. You can use these points to learn new skills.</VALUE>
    <VALUE Lang="id">Kamu akan mendapatkan 1 Skill Point setiap kali naik level. Gunakan untuk mempelajari skill yang tersedia.</VALUE>
    <VALUE Lang="cn">技能点数从0个开始计算，每当角色等级晋级时，就会增加 1个技能点数。您可利用这些技能点数，来学习新的技能，亦或是提升旧技能的等级。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_2_0_1">
    <VALUE Lang="GS">Next page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_3_0">
    <VALUE Lang="GS">Your character's Skill Points may not be enough to learn Grade 16 Skill.</VALUE>
    <VALUE Lang="id">Skill Point kamu tidak cukup untuk mempelajari skill level 16.</VALUE>
    <VALUE Lang="cn">但是你的技能点数可能不够让你学到Grade 16的技能。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_3_0_1">
    <VALUE Lang="GS">Next page</VALUE>
    <VALUE Lang="id">Lanjut</VALUE>
    <VALUE Lang="cn">下一页</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_4_0">
    <VALUE Lang="GS">I will offer quests for you to earn more Skill Points.</VALUE>
    <VALUE Lang="GS">The reward of each quest you accomplish is 2 Skill Points.</VALUE>
    <VALUE Lang="GS">Some of these quests might be a little difficult.</VALUE>
    <VALUE Lang="GS">Good luck!</VALUE>
    <VALUE Lang="id">Saya menawarkan beberapa quest yang berhadiah skill point.</VALUE>
    <VALUE Lang="id">Hadiah untuk tiap quest adalah 2 skill point.</VALUE>
    <VALUE Lang="id">Beberapa dari mereka sangatlah sulit,</VALUE>
    <VALUE Lang="id">Semoga Beruntung!</VALUE>
    <VALUE Lang="cn">让我来提供你一些机会得到技能点数。</VALUE>
    <VALUE Lang="cn">每完成一件我交代给你的任务，你将会得到两点的技能点数。</VALUE>
    <VALUE Lang="cn">不过，有些任务可不是那么简单喔!</VALUE>
    <VALUE Lang="cn">祝你好运!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_4_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skillhelper_1.ntk_5_0">
    <VALUE Lang="GS">Let us start the quest now!</VALUE>
    <VALUE Lang="id">Mari memulainya!</VALUE>
    <VALUE Lang="cn">让我们开始衝任务吧！</VALUE>
  </SENTENSE>
