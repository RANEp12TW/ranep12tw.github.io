  <SENTENSE Ver="1" Id="npc_2_haksen1_1.ntk_13_0">
    <VALUE Lang="GS">The primary targets for this area are the Maulers. Please eliminate 30 of them.</VALUE>
    <VALUE Lang="id">Musuh yang diutamakan di tempat ini adalah Mauler</VALUE>
    <VALUE Lang="id">Jatuhkan 30 orang</VALUE>
    <VALUE Lang="cn">此地的首要净化对象为Mauler。请除掉30只Mauler，维持良好校园风气。</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_haksen1_1.ntk_13_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
