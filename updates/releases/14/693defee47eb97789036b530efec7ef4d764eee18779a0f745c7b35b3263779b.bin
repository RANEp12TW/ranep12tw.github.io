    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_47_0">
    <VALUE Lang="GS">It better than previous.</VALUE>
    <VALUE Lang="id">Ini.. Sudah lebih kuat dari sebelumnya.</VALUE>
    <VALUE Lang="cn">这样以来应该会比之前还要好</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_47_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
