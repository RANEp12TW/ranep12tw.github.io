    <VALUE Lang="id">Jual beli item</VALUE>
    <VALUE Lang="cn">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_20_0">
    <VALUE Lang="GS">Please take these and verify them.</VALUE>
    <VALUE Lang="id">Ambil Currency tersebut dan lakukan verifikasi</VALUE>
    <VALUE Lang="cn">请带去再确认一次</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_20_0_1">
    <VALUE Lang="GS">Return</VALUE>
    <VALUE Lang="id">Kembali</VALUE>
    <VALUE Lang="cn">回主题</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_ex1.ntk_21_0">
    <VALUE Lang="GS">...11</VALUE>
