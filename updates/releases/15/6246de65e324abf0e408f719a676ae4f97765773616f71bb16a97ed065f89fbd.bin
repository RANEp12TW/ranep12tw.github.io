  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_9">
    <VALUE Lang="id">Masih banyak genuine parts yang bisa dikumpulkan, walau sedikit repot kalau terus dikumpulkan suatu saat nanti pasti membantu.</VALUE>
