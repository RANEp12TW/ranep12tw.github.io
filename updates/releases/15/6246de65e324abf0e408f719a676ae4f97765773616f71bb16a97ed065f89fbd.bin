  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0_2"><VALUE Lang="tw">兌換 痛苦吸收（67級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE><VALUE Lang="id">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE><VALUE Lang="cn">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE><VALUE Lang="th">Skill book: Pain Absorption (Lv67, Class=130, Item=175/67)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_8_0_3"><VALUE Lang="tw">兌換 能量吸收（77級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE><VALUE Lang="id">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE><VALUE Lang="cn">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE><VALUE Lang="th">Skill book: Energy Absorption (Lv77, Class=130, Item=175/68)</VALUE></SENTENSE>
