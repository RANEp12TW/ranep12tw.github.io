  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_60_0">
    <VALUE Lang="id">Ah, jadi kamu sudah melihat Listnya Saints.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
