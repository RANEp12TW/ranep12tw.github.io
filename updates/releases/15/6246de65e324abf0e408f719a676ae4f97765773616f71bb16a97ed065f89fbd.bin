    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_4_0">
    <VALUE Lang="id">Fokus Stat point kamu di INT akan membuat karakter kamu bagus sebagai pendukung untuk karakter lain.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_4_0_1">
    <VALUE Lang="id">Bertanya tentang musuh</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_4_0_2">
