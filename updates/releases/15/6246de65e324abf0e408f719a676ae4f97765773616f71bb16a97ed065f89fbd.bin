    <VALUE Lang="id">.......</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_47_0">
    <VALUE Lang="id">Skill pada fase awal tidak membutuhkan banyak point jadi mungkin akan banyak point yang tersisa</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_47_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_48_0">
    <VALUE Lang="id">하지만 나중엔 모자라서 배울 수도 있는 스킬을 못배우고 썩히게 될 경우가 생길 수도 있으니까 잘 생각해 보고 꼭 필요한 스킬만 익히도록.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_48_0_1">
