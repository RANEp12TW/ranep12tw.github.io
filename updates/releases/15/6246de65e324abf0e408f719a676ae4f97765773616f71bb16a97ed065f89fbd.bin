  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_8_0">
    <VALUE Lang="id">Pelajar harus bisa mengetahui situasi di luar sekolah. Pelajar yang rajin dan giat akan diberikan kompensasi yang sesuai. Hancurkanlah Black Belt dan kumpulkanlah token</VALUE>
    <VALUE Lang="id">Skip</VALUE>
