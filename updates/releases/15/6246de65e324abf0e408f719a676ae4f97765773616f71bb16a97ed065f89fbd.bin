  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_115_0">
    <VALUE Lang="id">Ini letter tentang apa? Berbagi skill…..</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_115_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_116_0">
    <VALUE Lang="id">Euhm…akhirnya keluar juga rupanya. Ini yang dimaksud dengan 'Letter of Opinion' itu yah?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Harus kami periksa terlebih dahulu.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_116_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_117_0">
    <VALUE Lang="id">Tidak bisa membawa selain ini? Euhm…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Kayaknya sulit sekali kalau harus mengumpulkannya di Kantor pusat bawah tanah</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Setiap ada waktu tolong kumpulkan item-item seperti ini</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_117_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_118_0">
    <VALUE Lang="id">Kamu membutuhkan skill dari kelas apa, silahkan pilih saja</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_118_0_1">
