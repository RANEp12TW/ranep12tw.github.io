  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_4_0">
    <VALUE Lang="id">Kami, science club yang aktivitas setiap harinya meneliti di basement main building</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Jadi kita jarang sekali bertemu…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">berbeda dengan kelas lain, kami mendapat perintah langsung dari devisi penelitian suatu organisasi</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_4_0_1">
    <VALUE Lang="id">Bertanya meneliti apa</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_40_0">
    <VALUE Lang="id">Sepertinya yang dibutuhkan banyak… untuk membuat kalung diutuhkan design. Di Sacred Gate Town ada Bomber Clown, dia membawa item yang bagus untuk membuat kalung permata. Coba kamu cari ya..</VALUE>
