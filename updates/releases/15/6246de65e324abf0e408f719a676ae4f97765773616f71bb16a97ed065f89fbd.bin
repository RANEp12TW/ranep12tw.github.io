  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_7">
    <VALUE Lang="id">Laporkan hasil</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_1_0_8">
    <VALUE Lang="id">(Limited time) Kebaikan Underworld</VALUE>
