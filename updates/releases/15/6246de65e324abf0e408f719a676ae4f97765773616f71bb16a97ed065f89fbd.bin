  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_61_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_62_0">
    <VALUE Lang="id">Kamu sudah liat Saint List rupanya…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Sebenarnya tidak ada masalah dengan daftarnya.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tapi tetap penasaran… iya kan?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Kenapa banyak sekali keluarga yang memiliki masalah…?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Jika dipikir-pikir ini hal yang sepele tapi...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Sebenarnyakan hanya sedik</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_62_0_1">
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_63_0">
    <VALUE Lang="id">Banyak orang yang mempertanyakannya…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apakah itu perbuatan yang dapat diampuni atau perbuatan yang layak dapat pujian.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tetapi..aku sebagai pengajar semua itu tidak benar..</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Aku juga sebenarnya dipaksa untuk mengerjakan sesuatu yang aku tak ketahui</VALUE>
