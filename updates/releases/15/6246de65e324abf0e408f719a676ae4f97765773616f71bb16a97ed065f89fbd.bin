    <VALUE Lang="id">5 candies + 1 Gold Lollipop = Test Paper III</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0">
    <VALUE Lang="id">Hi ~ Apakah kamu suka permen? Jika tidak, kamu akan memberikan permen kepadaku? 2 Halloween candies = Pet skin card [Jack-o’-Lantern] (15days) 1 Big Halloween silver lollipop = 1 Pumpkin box 1 Big Halloween gold lollipop = Death bike (30days) Saya akan me</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_1">
    <VALUE Lang="id">Menukarkan 2 candy dengan Pet skin card.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_2">
    <VALUE Lang="id">Menukarkan Big silver lollipop dengan Pumpkin box</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_3">
    <VALUE Lang="id">Menukarkan Big gold lollipop dengan Death bike(30days)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_halloween09.ntk_1_0_4">
    <VALUE Lang="id">Menukarkan candy.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0">
    <VALUE Lang="id">Pekerjaan bagus bisa sampai di sini. Sangat mudah kan?</VALUE>
    <VALUE Lang="id">Akan kuperlihatkan cara membuat item menggunakan badges dan kartu~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0_1">
    <VALUE Lang="id">Apa yang diperlukan untuk membuat item tersebut?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_1_0_2">
    <VALUE Lang="id">Sudah kudapatkan, tolong buatkan saya segera!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_2_0">
    <VALUE Lang="id">Pierrot Badge 50ea + Joker Badge 40ea</VALUE>
