  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_47_0">
    <VALUE Lang="id">Kamu seharusnya mempunyai banyak skill point yang tersisa karena level awal belum banyak skill untuk dipelajari.</VALUE>
