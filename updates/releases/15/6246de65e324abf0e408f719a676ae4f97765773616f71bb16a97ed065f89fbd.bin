  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_41_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_42_0">
    <VALUE Lang="id">Pemikiran yang baik.</VALUE>
    <VALUE Lang="id">Kami tidak tahu bahaya apa yang ada tetapi saya percaya anda dapat mengatasi apapun itu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_42_0_1">
    <VALUE Lang="id">Selanjutnya</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_43_0">
    <VALUE Lang="id">Saya akan menyampaikan formulir aplikasinya.</VALUE>
    <VALUE Lang="id">Pergi ke root Hole ke tempat konstruksinya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_43_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_44_0">
    <VALUE Lang="id">Maksud anda kunci cadangan gudang peralatan?</VALUE>
