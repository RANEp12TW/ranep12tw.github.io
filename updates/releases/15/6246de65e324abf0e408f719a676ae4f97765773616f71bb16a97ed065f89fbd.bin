  <SENTENSE Ver="1" Id="npc_0_iss.ntk_1_0_9">
    <VALUE Lang="id">Bertanya apakah ada yang bisa dibantu</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_10_0">
    <VALUE Lang="id">Sepertinya tidak mudah… simpan baik-baik Vigor of Warrior yang aku kasih ya..</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_10_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_11_0">
    <VALUE Lang="id">Disini ada satu pintu masuk ke duniaku… sekarang belum waktunya jadi kamu belum bisa masuk, disana di depan pintu ada orang yang bernama Gainun..berhati-hatilah karena mungkin dia akan menyerang duluan… atau kalau bisa bercakap malah lebih bagus</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_11_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_12_0">
    <VALUE Lang="id">Sampaikan pesan kepada Garansanoa bahwa Lucian sedang terobsesi memperoleh Adoniechus. Gainun sedang menjaga pintu menuju Daramai..dia ada disana</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_12_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_13_0">
    <VALUE Lang="id">kesini lagikan?...kalau aku sendirian sulit sekali</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_13_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_14_0">
    <VALUE Lang="id">Kondisi Adoniechus semakin tidak terkendali, seandainya saja aku tidak terluka… mungkin kondisinya akan berbeda. Tolong mintakan Tear of Ganil kepada Arc dan Buster Cannon</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_14_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_15_0">
    <VALUE Lang="id">Akan aku ubah 'Vigor of Warrior' menjadi pusaka yang lebih kuat. Lepaskan kalung dari leher kamu dan bilang kalau sudah siap.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_15_0_1">
