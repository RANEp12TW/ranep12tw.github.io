  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_1_0_3">
    <VALUE Lang="id">I've collected kill!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_2_0">
    <VALUE Lang="id">You can enter event map from Elemental Shaman NPC which located in each campus</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">*</VALUE>
    <VALUE Lang="id">--- Open Time ---</VALUE>
    <VALUE Lang="id">*</VALUE>
    <VALUE Lang="id">[Lv30~130]</VALUE>
    <VALUE Lang="id">1:00, 5:00, 9:00, 13:00, 17:00, 21:00</VALUE>
    <VALUE Lang="id">*</VALUE>
    <VALUE Lang="id">[Lv131~195]</VALUE>
    <VALUE Lang="id">1:40, 5:45, 9:45, 13:45, 17:45, 21:45</VALUE>
    <VALUE Lang="id">*</VALUE>
    <VALUE Lang="id">[Lv196 or higher]</VALUE>
    <VALUE Lang="id">2:30, 6:30, 10:3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_2_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_3_0">
    <VALUE Lang="id">Hunted mobs in Saint Power Plant No.2 will drop a certificate to certifiy the number of kill. Collect it and I'll help you to exchangewith some useful items. The more kill number the better the reward.</VALUE>
    <VALUE Lang="id">*</VALUE>
    <VALUE Lang="id">---[ Exchage Event Helper ]---</VALUE>
    <VALUE Lang="id">*</VALUE>
    <VALUE Lang="id">1,000 kill</VALUE>
    <VALUE Lang="id">-&gt;</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_summer_help.ntk_4_0">
    <VALUE Lang="id">Wow! Kamu mengoleksi banyak sekali. Pilih hadiah yang kamu inginkan!</VALUE>
