    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_44_0">
    <VALUE Lang="id">.....</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_45_0">
    <VALUE Lang="id">Selalu ada dibarisan paling belakang untuk membatu teman-teman kalian supaya bisa mengoptimalkan kekuatan mereka, dan melanjutkan peran dari para member party</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_45_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
