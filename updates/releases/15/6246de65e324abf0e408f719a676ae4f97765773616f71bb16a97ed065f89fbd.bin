  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_4_0">
    <VALUE Lang="id">Heum…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Setidaknya masih ada hal yang bisa kamu lakukan</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Hanya perlu menggabungkan potongan kunci ini menjadi sebuah kunci yang sempurna kan?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
