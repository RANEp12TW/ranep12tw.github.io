  <SENTENSE Ver="1" Id="npc_hl_scienceteacher.ntk_11_0">
    <VALUE Lang="id">Grup loan shark ini benar benar seperti kecoa!</VALUE>
    <VALUE Lang="id">Kali ini mereka menggunakan drugs lain untuk mempengaruhi pedagang-pedagang itu.</VALUE>
