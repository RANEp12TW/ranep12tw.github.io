  <SENTENSE Ver="1" Id="npc_c1_t_spirit1.ntk_17_0">
    <VALUE Lang="id">Begitu yah?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Saya bisa memberitahu kamu sedikit walaupun guru besar tidak ada di sini</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Director Lee sudah mengira-ngira hubungan antara dunia ini dan dunia lain setelah kejadian hujan meteor 18 tahun yang lalu. Dia juga memprediksikan bahwa pengaruh</VALUE>
  </SENTENSE>
