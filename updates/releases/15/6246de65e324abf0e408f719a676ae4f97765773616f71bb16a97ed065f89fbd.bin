  <SENTENSE Ver="1" Id="2016_oct_event1.ntk_1_1">
    <VALUE Lang="id">Trick or treat!</VALUE>
    <VALUE Lang="id">Kalau kamu tidak memberikan candy, akan saya ikuti dan ganggu selamanya!</VALUE>
    <VALUE Lang="id">Tapi kalau kamu berikan, saya boleh tukarkan dengan hadiah~</VALUE>
    <VALUE Lang="id">Cepat, berikan saya candy!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event1.ntk_1_1_1">
