  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_3_0">
    <VALUE Lang="id">Oh! Buff ini hanya akan bertahan 1 jam 30 menit! Harap ingat! Ya, saya harap anda mendapatkan banyak keberuntungan untuk hari ini!</VALUE>
  </SENTENSE>
