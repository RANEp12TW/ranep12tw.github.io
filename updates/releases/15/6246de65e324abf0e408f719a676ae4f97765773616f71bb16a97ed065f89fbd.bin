  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_60_0">
    <VALUE Lang="id">Seperti yang sudah saya bilang mereka yang berada di sekitar Sekolah adalah orang-orang yang menghancurkan apapun yang terlihat dan sedang mencari sesuatu yang bisa dihancurkan lagi</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_60_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_61_0">
    <VALUE Lang="id">Nggak ada masalah di Main Building di dalam Sekolah. Tapi kalau di luar sekolah kamu lengah sedikit saja, kamu bisa kehilangan nyawa</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_61_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_62_0">
    <VALUE Lang="id">Exit Approval yang kamu tuliskan berisikan tentang segala resiko akan bahaya, ingatlah itu baik-baik!</VALUE>
