  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_4_0">
    <VALUE Lang="id">Dengarkan baik baik!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_4_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_40_0">
    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_41_0">
    <VALUE Lang="id">3 point akan dialokasikan setiap kali level naik.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Arah pertumbuhan karakter akan dibedakan berdasarkan point yang didistribusikan</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_41_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_42_0">
    <VALUE Lang="id">Kalau berkonsentrasi pada kecepatan karakter digolongkan kepada jenis 'Pukulan Cepat' dimana pukulan yang digunakan lemah namun sangat cepat</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_42_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_43_0">
    <VALUE Lang="id">Sebaliknya kalau berkonsentrasi pada kekuatan kalian digolongkan kepada jenis 'Pukulan Kuat' dimana pukulan yang digunakan sangat kuat namun lambat</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_43_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_44_0">
    <VALUE Lang="id">Yang terakhir disebut dengan golongan 'Pukulan Energi' dimana point dikonsentrasikan pada pikiran dan pukulan dikeluarkan melului energi yang ada di seluruh tubuh</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_44_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_45_0">
    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_46_0">
    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_47_0">
    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_48_0">
    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_49_0">
    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_5_0">
    <VALUE Lang="id">Hal unik dan keuntungan dari Assassin adalah serangan yang cepat tanpa memperdulikan hal lainnya. Ingat! Assassin memiliki kecepatan dalam segala kondisi!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_5_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_50_0">
    <VALUE Lang="id">Kenapa kamu tidak terdaftar... Kamu belum siap seperti yang telah saya katakan.. Kamu akan menemukan sesuatu yang menarik di DB room Terimal. Pergilah !</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_50_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_51_0">
    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_52_0">
    <VALUE Lang="id">Kami mengalami kesulitan untuk mendapatkan segalanya. Huru Hara diluar sekolah telah meraja lela. Huff.. Saya tidak punya waktu untuk beristirahat.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_52_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_53_0">
    <VALUE Lang="id">Makhluk makhluk dipergunakan untuk membuat kekacauan diluar sekolah. Banyak korban korban yang berasal dari orang orang yang tidak bersalah. Point nya adalah mereka berubah menjadi agresif!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_53_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_54_0">
    <VALUE Lang="id">Jika tidak ada kejadian ini, Saya mungkin tidak akan menjadi Instructor. Namun jangan membenci saya. Saya siap membantumu kapanpun !</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_54_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_55_0">
    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_56_0">
    <VALUE Lang="id">Fenomena ini telah memiliki dampak yang besar. Semua orang melaporkan hal yang sama. Ingat !! Keselamatan adalah prioritas kami !</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_56_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_57_0">
    <VALUE Lang="id">Sekali kamu memasukkan Exit Approval Form, Kamu berjanji akan bertanggung jawab terhadap semua kekuatanmu !</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_57_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_58_0">
    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_59_0">
    <VALUE Lang="id">Ini hanya sebagian dari Saint List. Kamu akan terkejut jika tahu kebenarannya. Saya harap kamu dapat berpikir lebih.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_59_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_6_0">
    <VALUE Lang="id">Dimulai dari 0, Kamu akan menerima 1 Skill Point setiap naik level.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_6_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_60_0">
    <VALUE Lang="id">Saya tahu kamu pasti bingung!</VALUE>
    <VALUE Lang="id">Pergilah ke Trading Hole dan temui Sia. Dia akan memberikan informasi lebih tentang Saint List.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_60_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_nin.ntk_61_0">
    <VALUE Lang="id">"Jika kamu mempunyai Spiritual Spheres, berarti kekuatan kamu sudah cukup diakui. Pilihlah Skill yang kamu inginkan "</VALUE>
  </SENTENSE>
