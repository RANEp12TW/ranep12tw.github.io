    <VALUE Lang="id">Berikan senjata dan barang</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_10_0">
    <VALUE Lang="id">Saya banyak yang harus diurus akhir akhir ini..tapi biker gang tetap membuat banyak berisik pada malam hari, saya tidak bisa tidur atau fokus.</VALUE>
    <VALUE Lang="id">Kami bisa menangani normal biker gang tetapi pemimpinnya terbukti sangat kuat.</VALUE>
    <VALUE Lang="id">Bisakah anda temukan dan kalahkan</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_10_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_11_0">
    <VALUE Lang="id">Terima kasih.</VALUE>
    <VALUE Lang="id">Anda bisa tidur nyenyak ya malam ini. Ho ho</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_11_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_12_0">
    <VALUE Lang="id">Rata-rata disini memakainya.</VALUE>
    <VALUE Lang="id">Semuanya berkat anda. Ho ho</VALUE>
    <VALUE Lang="id">Sekarang harus mengerjakan yang tentang senjata dan barang nih.</VALUE>
    <VALUE Lang="id">Anda bisa membawa kesini senjata dan barang mysterious mask?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_12_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_13_0">
    <VALUE Lang="id">Hebat sekali.</VALUE>
    <VALUE Lang="id">Sangat senang sekali saya dengan kamu. Ho ho</VALUE>
    <VALUE Lang="id">Bantu lagi ya lain kali.</VALUE>
