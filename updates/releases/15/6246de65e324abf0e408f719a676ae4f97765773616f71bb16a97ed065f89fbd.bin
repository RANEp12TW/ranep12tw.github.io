  <SENTENSE Ver="1" Id="npc_rantto.ntk_3_0_1">
    <VALUE Lang="id">1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_3_0_2">
    <VALUE Lang="id">2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_3_0_3">
    <VALUE Lang="id">3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_3_0_4">
    <VALUE Lang="id">4</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_3_0_5">
    <VALUE Lang="id">5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_4_0">
    <VALUE Lang="id">원하시는 번호를 골라주십시요</VALUE>
    <VALUE Lang="id">번호는 교환하신뒤 당첨이 되지 않을 경우 일주일 후 자동 소멸 됩니다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_4_0_1">
    <VALUE Lang="id">6</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_4_0_2">
    <VALUE Lang="id">7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_4_0_3">
    <VALUE Lang="id">8</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_4_0_4">
    <VALUE Lang="id">9</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_4_0_5">
    <VALUE Lang="id">10</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_6_0">
    <VALUE Lang="id">행운번호를 얻기 위해서는 주화가 있어야만 해요</VALUE>
    <VALUE Lang="id">원래는 제가 기념으로 먼저 나눠드리려고 했는데, 여기 들어오다가 몽땅 빼앗겨 버렸지 뭐예요-</VALUE>
    <VALUE Lang="id">바깥에 체인 들고 다니는 사람들 있잖아요?</VALUE>
    <VALUE Lang="id">그 사람들한테서 주화를 빼앗아 오면 행운번호로 바꿔드릴께요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_6_0_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_7_0">
    <VALUE Lang="id">주화를 행운번호로 교환해 드릴께요</VALUE>
    <VALUE Lang="id">한번 바꾼 행운번호는 다음 기회가 아니면 바꾸질 못하시니 신중히 생각해 보고 결정하세요</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_7_0_1">
    <VALUE Lang="id">행운번호로 교환한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_9_0">
    <VALUE Lang="id">원하시는 행운번호가 어느 군에 속하는지 확인하신 뒤 선택해 주십시오</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">제 1군 : 1 ~ 5</VALUE>
    <VALUE Lang="id">제 2군 : 6 ~ 10</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_9_0_1">
    <VALUE Lang="id">제 1군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_rantto.ntk_9_0_2">
    <VALUE Lang="id">제 2군</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_reformcard.ntk_1_0">
    <VALUE Lang="id">Ganti option item kamu di sini! Tapi saya tidak menjamin status bagus loh!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_reformcard.ntk_1_0_1">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0">
    <VALUE Lang="id">Halo~</VALUE>
    <VALUE Lang="id">Saya adalah Club War Processing Agent.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Pertarungan ini akan diadakan di Saint Complex Research Basement untuk menentukan guild yang berhak menjadi pemimpin. Kumpulkan poin sebanyak yang diperlukan untuk memenuhi Target Point selama waktu yang terbatas.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apakah kamu masih membutuhkan informasi lainnya?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_1">
    <VALUE Lang="id">Atur Pajak Baru</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_2">
    <VALUE Lang="id">Masuk ke medan pertempuran</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_3">
    <VALUE Lang="id">Dapat Poin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_4">
    <VALUE Lang="id">Efek Buff Akselerasi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_5">
    <VALUE Lang="id">Persyaratan Party</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_6">
    <VALUE Lang="id">Menggunakan Item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_7">
    <VALUE Lang="id">Batasan Skill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_1_0_8">
    <VALUE Lang="id">Wilayah Pajak</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_2_0">
    <VALUE Lang="id">Izin masuk ke Club War hanya diperbolehkan ketika waktu Club War.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ketika Club War dimulai, pemain dapat masuk melalui gerbang di samping saya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_2_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_3_0">
    <VALUE Lang="id">Anda dapat mendapatkan 10 poin setiap 5 detik jika berhasil mendapatkan kendali mesin utama di tengah.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_4_0">
    <VALUE Lang="id">Dapatkan buff yang berguna dengan menghancurkan Accelerator Machine di tiap area.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Buff tersebut terdiri dari waktu autentifikasi dan hidup kembali berkurang 50% ditambah poin bernilai 2 kali. Gunakan buff tersebut untuk membalikkan keadaan.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ah jangan lupa jika buff tersebut hanya berlangsung 3 menit setelah mesin tersebut dihancurkan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_4_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_5_0">
    <VALUE Lang="id">Poin yang didapatkan oleh pemain Guild akan terhitung untuk poin Guild. Di samping itu, party dengan pemain dari Guild lain tidak diperbolehkan.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Jikalau party dengan pemain dari Guild lain, maka party tersebut akan hilang dengan sendirinya ketika masuk ke dalam Club War.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_5_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_6_0">
    <VALUE Lang="id">Harap ingat bahwa item-item konsumsi, pet, mount, dan item jenis kartu tidak dapat digunakan di peta S.R.C Basement.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_6_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_7_0">
    <VALUE Lang="id">Skill untuk menghidupkan pemain lain tidak dapat digunakan di dalam Saint Research Complex Basement.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Harap diingat juga jika skill yang berhubungan dengan kekebalan, pengalihan serangan dan menghilang tidak akan berlaku ketika sedang melakukan autentifikasi.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_7_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_8_0">
    <VALUE Lang="id">Sebagai pemenang dari Club War, Ketua Guild anda dapat menentukan besar pajak di daerah yang termasuk wilayah pajak ketika terjadi transaksi jual / beli.</VALUE>
    <VALUE Lang="id">Jika tidak ditentukan, tarif pajak dasar akan berlaku.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apakah anda ingin menentukannya sekarang?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_8_0_1">
    <VALUE Lang="id">Atur Pajak Baru</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_renewal_guidance_helper.ntk_8_0_2">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0">
    <VALUE Lang="id">어서 와라</VALUE>
    <VALUE Lang="id">뭘 도와줄까?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_1">
    <VALUE Lang="id">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_2">
    <VALUE Lang="id">검도부에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_3">
    <VALUE Lang="id">수행 방법에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_0_4">
    <VALUE Lang="id">전투 방법에 대해 묻는다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_1">
    <VALUE Lang="id">다른 부원들은 다 나가!</VALUE>
    <VALUE Lang="id">정신 사납다.</VALUE>
    <VALUE Lang="id">아니면 뭐냐,</VALUE>
    <VALUE Lang="id">볼 일이라도 있는거냐?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_1_1_1">
    <VALUE Lang="id">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_0">
    <VALUE Lang="id">우선 기본적인 것들을 다시 한번 알려 줄테니 잘 들어.</VALUE>
    <VALUE Lang="id">너희들에겐 레벨업을 하는 순간 3개의 '포인트'가 할당된다.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_0_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_1">
    <VALUE Lang="id">호오? 연습을 꽤 했나 보군!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_10_1_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_11_0">
    <VALUE Lang="id">그리고 그 포인트들을 분배하는 방법에 따라 너희들의 '성장 방향'이 달라지게 되지.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_11_0_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_12_0">
    <VALUE Lang="id">만약 힘과 체력과 민첩에 분배한다면 검으로 보다 빠른 공격을 할 수 있는 '속공형'이 될테고,</VALUE>
    <VALUE Lang="id">힘에만 집중하다면 검이 아니라 도를 사용하며 파괴력 높은 공격을하는 '필살형'이 될거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_12_0_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_13_0">
    <VALUE Lang="id">.....5</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_0">
    <VALUE Lang="id">선두에 서서 동료들을 지키는게 너희들이 해야 할 일이야.</VALUE>
    <VALUE Lang="id">힘이 있으면 당연히 그래야지!</VALUE>
    <VALUE Lang="id">주의해야 할 점은 검도부원으로서 성장한 너희들이 '스태미너'를 상대적으로 많이 소비한다는 거야</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_0_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_1">
    <VALUE Lang="id">이거 정말 대단하군!</VALUE>
    <VALUE Lang="id">너 언제 그렇게 강해진거냐?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_14_1_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_2_0">
    <VALUE Lang="id">.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0">
    <VALUE Lang="id">어느쪽이 될 지는 선택하기 나름이겠지만 ,</VALUE>
    <VALUE Lang="id">누군가를 보호하기 위할 때에만 상대를 해하는 행동이 용서된다는 걸 명심해.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_0_2">
    <VALUE Lang="id">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_1">
    <VALUE Lang="id">'3층'은 레벨이 최소한 '20'은 돼야 하니까, 혹시라도 지금 갈 생각은 하지 않는게 좋을거야!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_1_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_3_1_2">
    <VALUE Lang="id">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_0">
    <VALUE Lang="id">그리고 힘과 민첩에 2:1 비율로 분배한다면 방어에 중심을 두는 '지구전형'이 되겠고,</VALUE>
    <VALUE Lang="id">마지막으로 힘과 민첩과 기력에 분배한다면 기를 이용할 할 수 있는 '기공형'으로 성장하게 될거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_0_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_0_2">
    <VALUE Lang="id">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_1">
    <VALUE Lang="id">그 정도면 학교 밖으로 나가 볼 수도 있겠는데?</VALUE>
    <VALUE Lang="id">나가서 더 실력을 키워봐라!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_1_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_4_1_2">
    <VALUE Lang="id">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_0">
    <VALUE Lang="id">'스태미너'가 완전히 떨어지게 되면 '명중률'이나 '공격력'이 반감돼 버려서 경우에 따라서는 위험한 상황이 될 수도 있으니 무턱대고 달려 나가기만 하는 행동은 신중히 삼가해야 한다는 점을 항상 명심하고 있도록 해.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_0_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_0_2">
    <VALUE Lang="id">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_1">
    <VALUE Lang="id">너라면 지하 괴물들까지 청소해 버릴 수도 있겠는데?!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_1_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_5_1_2">
    <VALUE Lang="id">물품 매매</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_6_0">
    <VALUE Lang="id">....3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_0">
    <VALUE Lang="id">음... 검도부라...</VALUE>
    <VALUE Lang="id">그런 걸 한마디로 말 하자면...</VALUE>
    <VALUE Lang="id">그래, 힘을 지닌 자들이 배워야 할 기술이라고 할 수 있겠군.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_0_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_1">
    <VALUE Lang="id">그 정도 실력으로 검도부의 본질을 알고 싶다고?</VALUE>
    <VALUE Lang="id">아직 멀어도 한참 멀었으니, 가서 더 수련하고 와!</VALUE>
    <VALUE Lang="id">너라면 '2층'이 아마 적당할 거다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_7_1_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_s_k_t1.ntk_8_0">
    <VALUE Lang="id">힘이 있으면 할 수 있는 일이 두 가지가 있는데,</VALUE>
