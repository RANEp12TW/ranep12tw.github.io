  <SENTENSE Ver="1" Id="npc_d_oldman1.ntk_10_0">
    <VALUE Lang="id">Kayaknya terlalu lama disimpan di tempat yang lembab</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Kadar garam juga mengambil bagian</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Carilah 'Audio Visual Expert' di Trading Hole dan minta dia untuk memperbaikinya</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Dia orang yang aku kenal makanya dia akan lakukan tanpa banyak omong</VALUE>
