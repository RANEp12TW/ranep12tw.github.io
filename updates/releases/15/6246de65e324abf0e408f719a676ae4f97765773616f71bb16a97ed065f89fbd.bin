  <SENTENSE Ver="1" Id="2017_lunarnewyear.ntk_1_1">
    <VALUE Lang="id">Hai! Senang bertemu denganmu lagi~</VALUE>
    <VALUE Lang="id">Hei hei!! Jangan pergi~ saya perlu bantuanmu!</VALUE>
