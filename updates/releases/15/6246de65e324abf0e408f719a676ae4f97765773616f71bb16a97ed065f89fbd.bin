  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_0">
    <VALUE Lang="id">Clover melambangkan keberuntungan~</VALUE>
    <VALUE Lang="id">Saya ingin mengucapkan pada semua disini good luck untuk sepanjang tahun!</VALUE>
    <VALUE Lang="id">Tetapi bukankah lebih baik jika kami menukar kebahagiaan dengan keberuntungan?</VALUE>
    <VALUE Lang="id">Gunakan Blessing milik saya dan kumpulkan Saint Clover saat item buff time.</VALUE>
    <VALUE Lang="id">Saya akan menukarkan kebahagiaan anda menjadi keberuntungan!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_0_1">
    <VALUE Lang="id">Yeah!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_2_1">
    <VALUE Lang="id">Clover melambangkan keberuntungan~</VALUE>
    <VALUE Lang="id">Saya ingin mengucapkan pada semua disini good luck untuk sepanjang tahun!</VALUE>
