    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_7_0">
    <VALUE Lang="id">Kok makasih….mungkin saja saya nggak bisa membantu apa-apa</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_7_0_1">
    <VALUE Lang="id">Bertanya maksudnya apa</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_8_0">
    <VALUE Lang="id">Saya bilang sih untuk menghentikan kekacauan atau untuk meningkatkan kekuatan sebenarnya saya melakuakn semua itu dengan harapan bisa menemukan adik saya. Akhirnya saya bisa ketemu dia…tapi saat melihat adik saya yang berubah sedikit demi sedikit saya tid</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_8_0_1">
    <VALUE Lang="id">Mendengarkan cerita</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoruin.ntk_9_0">
    <VALUE Lang="id">Sampai sini..hanya itu yang bisa saya ingat tidak ada lagi yang bisa saya ceritakan…kamu boleh pergi sekarang, katanya sedang latihan, kamu harus selalu ingat bahwa kami banyak berharap sama kamu</VALUE>
