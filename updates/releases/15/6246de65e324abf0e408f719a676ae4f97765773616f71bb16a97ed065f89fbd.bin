  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_1_7">
    <VALUE Lang="id">Hi? Bertemu lagi.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Saya tidak bisa memberitahu apapun karena saya sangat sibuk. Emm~ kamu terlihat berbeda sekali dengan pelajar lain?</VALUE>
  </SENTENSE>
