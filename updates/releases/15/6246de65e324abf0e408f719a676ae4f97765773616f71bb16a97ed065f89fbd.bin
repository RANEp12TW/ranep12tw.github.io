  <SENTENSE Ver="1" Id="2017_smuggler_npc1.ntk_1_0">
    <VALUE Lang="id">Cepat kesini! Saya telah mencuri item ini dari shop! Datang dan beli secepatnya!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc1.ntk_1_0_1">
    <VALUE Lang="id">상점</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc2.ntk_1_0">
    <VALUE Lang="id">Apakah anda sedang mencari sesuatu? Saya bisa memberi material jika anda punya gold!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc2.ntk_1_0_1">
    <VALUE Lang="id">상점</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc3.ntk_1_0">
    <VALUE Lang="id">Saya datang dari shop dengan kostum curian ini! Mau beli? Beri saya gold dan saya akan beri anda barang ini!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_smuggler_npc3.ntk_1_0_1">
    <VALUE Lang="id">상점</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_0">
    <VALUE Lang="id">Ah haa…Apa yang harus kulakukan…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_0_1">
    <VALUE Lang="id">Toko</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_1">
    <VALUE Lang="id">Apakah dia menyukaiku..? Atau tidak..?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_1_1">
    <VALUE Lang="id">Apa yang bisa kulakukan?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_1_1_2">
    <VALUE Lang="id">Toko</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_2_0">
    <VALUE Lang="id">Hei untung kamu ada disini!</VALUE>
    <VALUE Lang="id">Ada seorang perempuan yang sudah sejak lama saya sukai</VALUE>
    <VALUE Lang="id">Tapi saya tidak tahu apakah dia menyukai saya atau tidak... Karena itu!</VALUE>
    <VALUE Lang="id">Dapatkah kamu membantuku menyampaikan perasaan ini kepadanya?</VALUE>
    <VALUE Lang="id">saya sangat gugup sampai tidak dapat berbicara dengannya…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_2_0_1">
    <VALUE Lang="id">Hah, itu bukan apa-apa~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_3_0">
    <VALUE Lang="id">Terimakasih banyak! Ah!</VALUE>
    <VALUE Lang="id">Dipikir-pikir lagi, para monster jahat telah mencuri coklat yang telah saya siapkan untuknya..!</VALUE>
    <VALUE Lang="id">Saya akan membalas budimu jika kamu menyampaikan perasaanku dan mencari coklat-coklat itu!</VALUE>
    <VALUE Lang="id">Saya bergantung padamu!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine1.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_1_0">
    <VALUE Lang="id">Hi~ apakah kamu terluka? Mari saya periksa…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_1_1">
    <VALUE Lang="id">Hi~ ada yang bisa saya bantu? Apakah kamu ingin mengatakan sesuatu?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_1_1_1">
    <VALUE Lang="id">Jelaskan situasi.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_2_0">
    <VALUE Lang="id">Oh oh iya, saya ingat!</VALUE>
    <VALUE Lang="id">Beberapa waktu yang lalu dia kemari dan saya merawatnya!</VALUE>
    <VALUE Lang="id">Dia bilang dia ingin mengenal saya lebih jauh?</VALUE>
    <VALUE Lang="id">Um…Dapatkah kamu sampaikan padanya bahwa saya juga tertarik?</VALUE>
    <VALUE Lang="id">Dan minta dia datang dan berbicara langsung dengan saya!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_2_0_1">
    <VALUE Lang="id">Baik! Akan saya sampaikan!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_3_0">
    <VALUE Lang="id">Terimakasih! Baiklah, sampai jumpa lain kali~ Saya harap kamu juga menemukan pasanganmu secepatnya~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_valentine2.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="costumesell_kr.ntk_1_0">
    <VALUE Lang="id">Bagaimana penampilan saya? Mengaku sajalah jika kamu memang menyukai cara berpakaian saya haha. Saya menjual beberapa kostum di sini. Juga, kostum saya dapat menggunakan Blessed paper loh! Mari kemari~</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="costumesell_kr.ntk_1_0_1">
    <VALUE Lang="id">상점열기</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="event_npc_0806.ntk_1_0">
    <VALUE Lang="id">Hello…</VALUE>
    <VALUE Lang="id">Toko Kart sudah dibuka~~</VALUE>
    <VALUE Lang="id">Hanya beberapa item yang tersedia saat ini, ke depannya akan lebih banyak lagi~</VALUE>
    <VALUE Lang="id">Tolong dibeli dan jangan bilang mahal~ T__T</VALUE>
  </SENTENSE>
