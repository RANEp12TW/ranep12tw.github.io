  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_40_0">
    <VALUE Lang="id">Itu dia. Dalam rangka untuk menerima tenaga Extreme dan bertambah kuat, kamu harus mengatur ulang semua skill kamu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_41_0">
    <VALUE Lang="id">Konstruksi tunnel yang diabaikan di Root Hole akan selesai sebentar lagi.</VALUE>
    <VALUE Lang="id">Akan dimulai investigasinya, apakah anda ingin daftar?</VALUE>
