  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_14_0">
    <VALUE Lang="id">Ha.. Sibuk sekali ini.</VALUE>
    <VALUE Lang="id">Tidak tahu.. kemarin malam anak berandal mencuri daftar tagihan dan membuangnya.</VALUE>
    <VALUE Lang="id">Curiga juga sih..</VALUE>
    <VALUE Lang="id">Beri pelajaran pada para spine basher disebelah sana dan bawa tagihannya kesini.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_14_0_1">
