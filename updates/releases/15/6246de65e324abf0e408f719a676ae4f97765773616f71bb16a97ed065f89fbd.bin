  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_march_event.ntk_2_0">
    <VALUE Lang="id">Ini adalah tiket masuk ke meadow. Oh, harap ingat bahwa kamu hanya dapat menggunakannya sekali sehari dan hanya 30 menit saja!</VALUE>
  </SENTENSE>
