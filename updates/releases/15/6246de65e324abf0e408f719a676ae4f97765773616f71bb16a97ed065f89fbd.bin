  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_3_0">
    <VALUE Lang="id">Dulunya saya Archery Club Manager dari SG_School</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">….Karens saya sudah mati…seribu…sepuluh ribu..kali</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Aku berubah menjadi monster hari itu karena tidak punya kekuatan seperti adikku, terpaksa aku menyerahkan semua beban pada adikku.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_3_0_1">
    <VALUE Lang="id">Terus mendengarkan</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_4_0">
    <VALUE Lang="id">Adik saya yang perlu dikasihani sudah membantu saya untuk mati</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Pasti kamu merasa kesulitan sekali</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Dan dia membagikan kekuatannya pada saya.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Berkat itu roh-roh gentayangan bisa sadar dan kembali ke bentuknya semula</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_4_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_4_0_2">
    <VALUE Lang="id">Bertanya tentang Roh Jelmaan</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_5_0">
    <VALUE Lang="id">Saya lebih tahu karena saya sendiri adalah roh gentayangan.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ini adalah tempat untuk mengikat makhluk-makhluk yang mengembara</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Saya mau pergi tapi tidak bisa dan ada kekuatan yang membuat saya tidak punya tempat untuk didatangi</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apakah itu dendam?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_5_0_1">
    <VALUE Lang="id">Tetap mendengarkan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_6_0">
    <VALUE Lang="id">Kalau bisa saya ingin meninggalkan tempat ini.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tapi sesuatu yang tidak terlihat sedang menggenggam erat kaki saya</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Saya berharap agar roh gentayangan saya yang lain bisa lebih bebas tapi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_6_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_7_0">
    <VALUE Lang="id">Kekuatan yang datang dari dimensi yang berbeda saling berbenturan dan menyebabkan makhluk hidup yang ada di antaranya kacau hingga pada akhirnya kehilangan kekuasaan untuk mengontrol.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Berubah menjadi sesuatu yang mengerikan atau terbagi ke dalam bebera</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_7_0_1">
    <VALUE Lang="id">Terus mendengarkan</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_8_0">
    <VALUE Lang="id">Dulu saya begitu</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tapi diantara anjing-anjing ada beberapa kondisi</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Contohnya meskipun badannya sudah berubah menjadi monster tapi dia masih memiliki akal sehat</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_8_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e3_sungheeyoun.ntk_9_0">
    <VALUE Lang="id">Sebagai kakak saya sudah melakukan hal yang sangat jahat kan?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Saya tidak mau berada di sini dan berlari untuk memeluknya segera</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tapi…saya tidak bisa meninggalkan tempat ini.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Lucu sekali….sekarangpun dia bukan dalam keadaan manusia yang sempurna</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
