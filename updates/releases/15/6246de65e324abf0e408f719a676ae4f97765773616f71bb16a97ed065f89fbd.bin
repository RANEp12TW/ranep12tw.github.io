  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_14_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_15_0">
    <VALUE Lang="id">Aaa~ Makasih banyak-</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tadi dokumen yang ditulis terburu-buru harus dipindahkan dong</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Kalau suatu saat nanti kamu terluka, datang ke sini yah ~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Aku pasti obati dengan pelayanan yang terbaik~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_15_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_16_0">
    <VALUE Lang="id">Eh, kamu yang ambil yah?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Dulu kan saya minta bantuan pada Security Guard</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Pokoknya makasih deh, kebetulan lagi perlu banget</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Lagian juga kita memang sedang kekurangan medicine, kalau tidak ada P3K tidak tahu deh gimana.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Situasi di luar harus ce</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_16_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_17_0">
    <VALUE Lang="id">Situasi permintaan dan penawaran Medicines sedang tidak bagus, sampai-sampai kita harus membuat sendiri obat-obat yang darurat</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Maaf, bisa bantu kumpulkan Cigarette Filter nggak?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Saya dengar orang-orang seperti Hooligan dan Little Hooligan pada merok</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_17_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_18_0">
    <VALUE Lang="id">Wahh, sudah terkumpul semua</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Makasih banyak</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Sepertinya kita harus mandiri kedepannya, karena itu kalau ada waktu tolong bantu lagi yah</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_18_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_19_0">
    <VALUE Lang="id">Bukan hanya obat-obatan, peralatan kesehatan yang lain juga kurang</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Kalau sudah seperti ini, kumpulkan saja semua bahan yang bisa dicari</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tadi saya lihat, ada beberapa pelajar yang salah satu tangannya digips</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Di saku para Pelajar itu kayaknya ada</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_19_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_2_0">
    <VALUE Lang="id">.....</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_20_0">
    <VALUE Lang="id">Wah, untung saja~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Para pelajar itu keliahatannya bermuka menakutkan, tetapi ternyata baik hati...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Iya benar, kalau diajak ngobrol dengan baik-baik siapa saja pasti mau</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Bagaimana pun juga, makasih ya. Nantinya saya mohon bantuannya lagi~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_20_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_21_0">
    <VALUE Lang="id">망각의 약?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">함부로 쓰면 안되는 약품인데...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">이제까지 조정했던 능력치들을 분배하기 전의 상태로 돌려버리는 약이라는 건 알고 있지?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">익혔던 스킬들을 모두 잊어버리게 되고, 대신 영령구슬들로 바꿔주고, 나눴던 스킬포인트를 모두 회수해 모아주는데...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">그래도 그런 약을 먹을거야?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_21_0_1">
    <VALUE Lang="id">망각의 약을 사용하겠다고 한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_21_0_2">
    <VALUE Lang="id">스킬과 스탯30개를 초기화하기 위해 망각의 약을 사용하겠다고 한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_21_0_3">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_22_0">
    <VALUE Lang="id">그래...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">벌써 결심해 버렸나 보구나</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">할 수 없지</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">그럼 가서 약재를 좀 구해 줄래?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">예전같으면 따로 재료를 구할 필요도 없었겠지만, 지금은 그런 흔한 것들도 함부로 쓸 수 없는 상황이니까...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">자, 자 그렇게 싫은 표정 하지 말고!</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">금방 구할 수 있을테니까, 다녀와-</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_22_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_23_0">
    <VALUE Lang="id">별로 오래 걸리진 않았지?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">쉽게 구할 수 있다고 했잖니-</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">그런데 아쉽게도 더이상 약을 만들수가 없어</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">그러게 정해진 날짜 동안에 다 했어야지-</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_23_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_24_0">
    <VALUE Lang="id">별로 오래 걸리진 않았지?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">쉽게 구할 수 있다고 했잖니-</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">자, 여기에 이 알약만 섞으면 완성이야</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">솔직히 쓰레기장에서 구한 재료로 이런 미심쩍은 약을 만들어 먹인다는게 좀 마음에 걸리긴 하지만... 그래도 먹는다는데 어떻게 말리겠니-</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">응? 이런 재료로 약을 만든다는 말은 안했던가?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">음...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">이제라도 말 해줬으니까 된거지?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">자, 약은 다 만들어졌으니까</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">먹어봐-</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">아, 배우고 있던 스킬수 만큼 영령구슬이 잔뜩</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_24_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_25_0">
    <VALUE Lang="id">망각의 약?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">함부로 쓰면 안되는 약품인데...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">이제까지 조정했던 능력치들을 분배하기 전의 상태로 돌려버리는 약이라는 건 알고 있지?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">익혔던 스킬들을 모두 잊어버리게 되고, 대신 영령구슬들로 바꿔주고, 나눴던 스킬포인트를 모두 회수해 모아주는데...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">그래도 그런 약을 먹을거야?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_25_0_1">
    <VALUE Lang="id">망각의 약을 사용하겠다고 한다</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_25_0_3">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_3_0">
    <VALUE Lang="id">Kalau luka ringan masih bisa aku obati, tapi kalau luka parah tidak bisa karena persediaan medicine sangat sedikit.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tapi tetap saja kalau kamu sudah melebihi level 15, aku tidak bisa membantu karena sudah diluar kemampuan aku.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_4_0">
    <VALUE Lang="id">미안, 내 실력으로 학생을 치료했다가는 오히려 해를 입힐지도 몰라.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_4_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_5_0">
    <VALUE Lang="id">Ini bukan penyakit lebih kepada reaksi kimia</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Badannya terbakar, atau lumpuh, atau membeku….</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ada juga kasus mengeras seperti batu</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_5_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_5_0_2">
    <VALUE Lang="id">Bertanya tentang 'Flame'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_5_0_3">
    <VALUE Lang="id">Bertanya tentang 'Paralysis'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_5_0_4">
    <VALUE Lang="id">Bertanya tentang 'Frozz'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_5_0_5">
    <VALUE Lang="id">Bertanya tentang 'Poisoned'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_5_0_6">
    <VALUE Lang="id">Bertanya tentang 'Faint'</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_6_0">
    <VALUE Lang="id">Gimana yah, saya juga kurang tahu soalnya nggak pernah keluar</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Saya dengar dari para guru yang baru saja keluar kayaknya…terjadi masalah besar…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_6_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_7_0">
    <VALUE Lang="id">Ini adalah keadaan dimana stamina menurun karena seluruh tubuh terbakar</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_7_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_8_0">
    <VALUE Lang="id">Keadaan dimana energi terkuras dan gerakan menjadi sangat lambat</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_8_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_9_0">
    <VALUE Lang="id">Karena tubuh membeku gerakan menjadi lambat dan pertahanan pun menurun</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Kalau terus dibiarkan, ini bisa membahayakan jadi harus diobati secepatnya</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_9_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_1_0">
    <VALUE Lang="id">Ah, Kamu bukan Assassin.. Sang pangeran kegelapan. Maaf saya tidak dapat membantumu !!</VALUE>
