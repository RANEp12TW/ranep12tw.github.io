    <VALUE Lang="id">체력 : 230</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">공격력 : 25~36</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">방어력 : 4</VALUE>
    <VALUE Lang="id">Skip</VALUE>
