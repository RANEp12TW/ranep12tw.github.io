  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_38_0">
    <VALUE Lang="id">Tapi ada perkumpulan yang dinamakan Shaman Club untuk para pelajar yang terpilih seperti kalian</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
