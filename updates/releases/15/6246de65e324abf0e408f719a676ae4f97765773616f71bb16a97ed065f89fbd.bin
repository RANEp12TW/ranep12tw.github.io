  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_medic1.ntk_14_0">
    <VALUE Lang="id">Sesibuk apapun harusnya bekerja sambil menulis dokumen</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tanpa sepengetahuan saya ternyata paper terus berkurang</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Kalau pergi ke shop di sana ada sih, kamu bisa tolong ambilkan nggak?</VALUE>
