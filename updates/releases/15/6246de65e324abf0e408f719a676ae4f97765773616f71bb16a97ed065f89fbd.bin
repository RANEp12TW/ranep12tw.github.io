  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_41_0">
    <VALUE Lang="id">angan khawatir karena semua musuh-musuh yang terlihat hanyalah boneka hasil kloning yang berbeda dengan wujud asli mereka.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_41_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_42_0">
    <VALUE Lang="id">Kamu tidak perlu merasa bersalah karena kamu telah membebaskan jiwa-jiwa yang terkurung di dalam tubuh yang telah mati.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_42_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_spirit1.ntk_43_0">
    <VALUE Lang="id">하지만... 언젠가는 살인이라는 걸 하기 싫어도 해야 할 때가 올 거야. 그때는...</VALUE>
