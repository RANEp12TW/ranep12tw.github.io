  <SENTENSE Ver="1" Id="npc_ep4_leejin.ntk_1_7">
    <VALUE Lang="id">Sepertinya saya harus melakukan inspeksi pertengahan. Saya percaya bahwa kamu tidak akan merasa kesulitan pada inspeksi pertengahan ini</VALUE>
