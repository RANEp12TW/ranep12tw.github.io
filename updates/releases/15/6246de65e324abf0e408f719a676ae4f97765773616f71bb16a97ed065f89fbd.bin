  <SENTENSE Ver="1" Id="2016_may_event.ntk_1_0">
    <VALUE Lang="id">Tidak!!! Pierrots telah mencuri hadiah saya..</VALUE>
    <VALUE Lang="id">Tolong bantu saya dengan mengambil kembali hadiah - hadiah tersebut dari para Pierrot yang akan muncul di setiap kampus dan hole pada waktu tertentu.</VALUE>
    <VALUE Lang="id">Saya masih mempunyai sedikit sisa hadih.. Ambil ini!!</VALUE>
    <VALUE Lang="id">-------------------------------------------------------</VALUE>
    <VALUE Lang="id">Waktu Pierrots Muncul (Setiap Kampus / Hole)</VALUE>
