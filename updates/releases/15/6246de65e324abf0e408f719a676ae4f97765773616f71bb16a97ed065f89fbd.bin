    <VALUE Lang="id">Menerima Firebird Hat (VIII) [Feather of Firebird(300)+FirebirdHat(VII)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_4_0_8">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_gentlegirl.ntk_1_0">
    <VALUE Lang="id">Apakah kamu mempunyai "plate" dari event?</VALUE>
    <VALUE Lang="id">Bunuh monster di luar sana untuk mendapatkannya. Jika kamu membawanya, aku akan memberikan hadiah sebagai gantinya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_gentlegirl.ntk_1_0_1">
    <VALUE Lang="id">Bertanya tentang Oblivion Potion.</VALUE>
  </SENTENSE>
