  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_36_0">
    <VALUE Lang="id">Entah bagaimana pedang tersebut sangat tidak enak dilihat</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">aku tidak takut tertusuk pedang itu</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Bagaimanapun juga mereka itu tidak benar, membawa pedang yang berlumuran darah</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_36_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_37_0">
    <VALUE Lang="id">Pelajar, kali ini ini lakukanlah permintaan terakhirku</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ambilah pedang-pedang tersebut</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tidak perlu semuanya, cukup ambil 10 buah saja dari mereka</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_37_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_38_0">
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Jadi para pelajar sekarang punya banyak waktu luang</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tidak pernah terpikirkan untuk menemukan kembali fungsi-fungsi yang hilang</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ada rumor yang bilang kalau item seperti itu sering ditemukan di daerah large trading hall 1, kalau kamu kesana past</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_38_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_39_0">
    <VALUE Lang="id">Item praktis itu mudah hilang dan terjatuh karena ukurannya sangat kecil</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apalagi kalau sedang berlari karena dikejar sesuatu, benda ini sangat mudah terjatuh~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Aku juga mendengar kalau ada orang-orang yang memungut item yang terjatuh itu</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Katanya</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_39_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_4_0">
    <VALUE Lang="id">Aku juga baru keluar sampai depan saja…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Seumur hidup baru aku alami kejadian yang susah dimengerti seperti ini</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Sebenarnya darimana orang-orang yang berpenampilan mirip itu muncul…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Beberapa waktu yang lalu aku hampir saja mati gara-gara mereka, u</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_4_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_4_0_3">
    <VALUE Lang="id">Bertanya tentang jalan</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_guard1.ntk_40_0">
    <VALUE Lang="id">Karena item yang membuat nyaman itu sangat kecil, jadi mudah hilang…. dan jatuh</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apalagi kalau sedang berlari karena dikejar sesuatu, benda ini sangat mudah terjatuh~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Aku juga mendengar kalau ada orang-orang yang memungut item yang terjatuh itu</VALUE>
