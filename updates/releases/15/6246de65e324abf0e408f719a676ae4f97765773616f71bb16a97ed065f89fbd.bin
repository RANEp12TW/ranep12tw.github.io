  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_37_0">
    <VALUE Lang="id">Untuk menjadi Pemanah Master, sangatlah sulit. Ada beberapa style dari seorang pemanah dan itu semua membutuhkan dasarnya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_37_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_38_0">
    <VALUE Lang="id">Pertama, kamu harus mempelajari teknik dasar terlebih dahulu</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_38_0_1">
