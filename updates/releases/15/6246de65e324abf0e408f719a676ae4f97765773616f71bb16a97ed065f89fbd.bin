  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_3_2">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_4">
    <VALUE Lang="id">Ini apa? Siapa yang memberikannya sama kamu?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_4_1">
    <VALUE Lang="id">Memberitahukan hasil</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_4_2">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_5">
    <VALUE Lang="id">Kekuatan kamu sudah berkembang setengahya? Kamu memang lebih kuat daripada pelajar sebelumnya, tapi ingat kekuatan kamu baru sampai setengah saja</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_5_1">
    <VALUE Lang="id">Memberitahukan hasil</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_5_2">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_6">
    <VALUE Lang="id">Setelah sekian lama baru sekarang dapat surat konfirmasi lagi</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_6_1">
    <VALUE Lang="id">Memberitahukan hasil</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_6_2">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_7">
    <VALUE Lang="id">Sudah nggak bisa lagi. Sampaikan letter ini pada Louis</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_7_1">
    <VALUE Lang="id">Menerima latter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_7_2">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_8">
    <VALUE Lang="id">Sejak beberapa waktu yang lalu para pelajar memperlakukan saya dengan aneh. Bagaimana permintaan saya kemarin? Sebenarnya ada apa sieh?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_8_1">
    <VALUE Lang="id">Menerima latter</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_8_2">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_9">
    <VALUE Lang="id">Ini kayaknya pusaka untuk bone sphere spesial. Berikan pusaka ini pada saya terus kamu coba gunakan bone sphere spesial itu, gimana? Dulu nggak bisa digunakan…mungkin…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_9_1">
    <VALUE Lang="id">Mendapatkan konfirmasi Ancient Treasure</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_1_9_2">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_10_0">
    <VALUE Lang="id">Begitu yah…Louis sudah muncul rupanya….ini bisa jadi masalah besar</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_choiyoungsub.ntk_10_0_1">
    <VALUE Lang="id">Bertanya ada apa?</VALUE>
  </SENTENSE>
