  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_15_0_9">
    <VALUE Lang="id">Tukar dengan Lv. 70 Spirit type weapon.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_16_0">
    <VALUE Lang="id">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_17_0">
    <VALUE Lang="id">If you are a new student who has just joined then reach Lv.10 and come Kembali to me for a weapon. However, existing students who doesn't meet the conditions would just better continue their training.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_17_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_18_0">
    <VALUE Lang="id">You haven't reached level 10.</VALUE>
    <VALUE Lang="id">It's a piece of a cake so become level 10 and come Kembali then, I will give you a fine weapon as a gift.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_18_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_19_0">
    <VALUE Lang="id">...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_19_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0">
    <VALUE Lang="id">Swordman adalah ilmu untuk meningkatkan jiwa dan raga, mau meningkatkannya dengan senjata apa?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_1">
    <VALUE Lang="id">Sword yang berhubungan dengan DEX</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_2">
    <VALUE Lang="id">Blade yang berhubungan dengan POW</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_3">
    <VALUE Lang="id">Vital Sword yang berhubungan dengan INT</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_2_0_4">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0">
    <VALUE Lang="id">Tugas Assassin adalah mengalahkan musuhnya tanpa diketahui. Kemampuan menggunakan senjata menjadi rahasianya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_1">
    <VALUE Lang="id">Dex Type "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_2">
    <VALUE Lang="id">Pow Type "Scythe"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_3">
    <VALUE Lang="id">Int Type "Shuriken"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_20_0_4">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0">
    <VALUE Lang="id">I can see that you need new weapon now. When you have reached level 30, 50 or 70 come Kembali to me for a weapon. Remember you cannot trade the weapon while you are equipping it.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_1">
    <VALUE Lang="id">Tukar dengan 30 Lv. "Dual Spear"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_21_0_10">
