    <VALUE Lang="id">Terimakasih…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Meskipun di mata orang lain kebanyakannya adalah buku-buku tua tapi untuk saya semua ini sangatlah berharga…</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Hati-hati dan semoga beruntung….</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
