  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_joker_trade.ntk_3_0_3">
    <VALUE Lang="id">Joker Bike!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_0">
    <VALUE Lang="id">Wow, kamu berhasil mengalahkan Medusa! Pergi dan kumpulkanlah Trophy. Saya akan membantu kamu dalam proses pencampurannya!</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Resep</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Hair of Medusa (30) + Snake Scale (30) + Piece of Snake Stone (30) + Vitality of Medusa (10) + 100,000 Gold = Medusa Tr</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_0_1">
    <VALUE Lang="id">Proses Trophy</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1">
    <VALUE Lang="id">Apakah kamu tahu bahwa tahun 2013 adalah tahun ular ? Karena hal inilah, para ular menjadi semakin kuat. Medusa telah terlihat dan memiliki rencana untuk menganggu keamanan kita semua. Kami membutuhkan kamu untuk tetap menjaga dunia RAN tetap aman.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">S</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_1">
    <VALUE Lang="id">Bagaimana caranya summon Medusa?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_2">
    <VALUE Lang="id">Tolong berikan saya saran untuk mengalahkan Medusa</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_1_1_3">
    <VALUE Lang="id">Saya telah mengalahkan Medusa!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0">
    <VALUE Lang="id">Kamu perlu memiliki Seruling dulu untuk memanggil Medusa. Kamu bisa mendapatkannya dengan mudah, Cukup dengan memburu para monster yang ada di RAN.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Namun tergantung pada level pemain, Setiap seruling dapat memanggil Medusa yang berbeda beda.</VALUE>
    <VALUE Lang="id">Setiap med</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0_1">
    <VALUE Lang="id">Ah! Dapatkah kamu memberikan saya masukkan? Bagaimana cara mengalahkan Medusa?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_2_0_2">
    <VALUE Lang="id">Saya telah mengalahkan Medusa! Dapatkah kamu memberikan hadiahnya?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0">
    <VALUE Lang="id">Medusa adalah ular yang sangat kuat. Dia akan merubah siapapun yang menatapnya menjadi batu. Jadi berhati hatilah. Jika kamu memiliki Google of Protection, kamu bisa mengalahkannya dengan lebih mudah. Google of Protection juga memberikanmu kemungkinan men</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0_1">
    <VALUE Lang="id">Beritahukan saya 1 kali lagi. Bagaimana cara memanggil Medusa?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_newyear.ntk_3_0_2">
    <VALUE Lang="id">Saya telah mengalahkan Medusa! Dapatkah kamu memberikan hadiahnya?</VALUE>
  </SENTENSE>
