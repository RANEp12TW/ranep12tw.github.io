    <VALUE Lang="id">8,000 kill</VALUE>
    <VALUE Lang="id">-&gt; Costume (1D) or Fresh water (Item untuk membuat potion)</VALUE>
    <VALUE Lang="id">50,000 kill</VALUE>
    <VALUE Lang="id">-&gt; Costume (7D) or Taxi card (10P)</VALUE>
    <VALUE Lang="id">80,000 kill</VALUE>
    <VALUE Lang="id">-&gt; Costume (15D)</VALUE>
  </SENTENSE>
