  <SENTENSE Ver="1" Id="npc_e3_tammy1.ntk_5_0">
    <VALUE Lang="id">Di sini tidak ada sistem kesejahteraan untuk pelajar sama sekali~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Padahal aku sedang belajar di Amerika lalu datang ke sini karena katanya perlakuan di sini baik…tapi ini ceritanya beda banget kan~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apa yang bisa dilakukan di tempat yang tidak higien</VALUE>
