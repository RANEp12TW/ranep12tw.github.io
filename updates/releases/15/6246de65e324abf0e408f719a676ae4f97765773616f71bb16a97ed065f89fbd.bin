  <SENTENSE Ver="1" Id="npc_e3_giilchung1.ntk_8_0">
    <VALUE Lang="id">Jumlah monster yang sangat banyak…Tapi makhluk-makhluk seperti ini bukan hanya ada di lantai bawah tanah saja kan?</VALUE>
