  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_10_0">
    <VALUE Lang="id">Saya mendengar bahwa beberapa pelajar mempunyai laporan penelitian Yin Xi.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Mereka terlihat di lantai 50.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Bisakah kamu membantu mengambilnya?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_10_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_11_0">
    <VALUE Lang="id">Yin Xi itu sama seperti saya… Kita adalah korban dari penelitian aneh.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apakah dia tahu yang sebenarnya?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apakah dia tahu kalau yang melakukan semua ini adalah kakeknya?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_11_0_1">
    <VALUE Lang="id">Bertanya tentang Chui Yin Xi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_12_0">
    <VALUE Lang="id">Apakah kamu bertemu dengan Yin Xi?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Jadi kamu latian bersama Chui Yin Xi....</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Zhen, Ruoyin, Yin Xi, Da Xu</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_12_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_13_0">
    <VALUE Lang="id">Mereka seharusnya sih sekarang hidup bahagia. Saya juga sudah sangat bahagia jadi saya akan memberikan kamu informasi yang diperlukan.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Saya memberikan semua data penelitian saya kepada Yin Xi. Acak - acakan sih tapi saya merapikannya dan akan mengirimn</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_13_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_14_0">
    <VALUE Lang="id">Terima Kasih... Saya sangat senang karena saya sudah bisa bertemu dengan kakak saya lagi.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_14_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_ep4_amanoyoung.ntk_15_0">
