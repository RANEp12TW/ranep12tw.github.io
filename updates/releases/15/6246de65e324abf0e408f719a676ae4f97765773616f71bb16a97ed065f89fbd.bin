  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_5_0">
    <VALUE Lang="id">Kamu harus terus menerus menggunakan skillmu agar menjadi lebih terlatih untuk membunuh musuhmu</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_5_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_50_0">
    <VALUE Lang="id">Hampir semua skill memerlukan Skill Point ketika kamu mempelajarinya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_50_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_51_0">
    <VALUE Lang="id">Kamu harus memiliki Skill Point yang cukup karena diperlukan untuk mempelajari skill pada awalnya.</VALUE>
  </SENTENSE>
