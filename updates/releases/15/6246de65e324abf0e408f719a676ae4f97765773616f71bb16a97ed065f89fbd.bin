  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_1">
    <VALUE Lang="id">Hi~ Nama saya Chloe dari Fantasy Forest~ Kesini dan dengarlah cerita saya!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_1_1">
