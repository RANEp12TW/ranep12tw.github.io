    <VALUE Lang="id">아이템이나 스킬에 대해서는 본관 안에 있는 매점 판매원을 만나시면 더 자세한 설명을 들으실 수 있을거예요</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_4_0_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_4_0_2">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_5_0">
    <VALUE Lang="id">현재 서 계시는 곳은 학원 내의 옥외지역이고, 전투지역으로 분류되어 있어요</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">물품 매매 등의 거래나 초반 퀘스트 수행을 위해서는 본관 안으로 들어가셔야 하는데</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">키보드 'M' 키를 누르시면 볼 수 있는 전체지도의 '본관' 을 찾아 들어가시면 내부로 가실 수 있어요</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_5_0_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_6_0">
    <VALUE Lang="id">본관에 들어가시면 왼편에서 찾을 수 있는 매점 판매원을 만나보세요</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">신입생들을 위한 선물을 받도록 도와줄거예요</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_6_0_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_6_0_2">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_7_0">
    <VALUE Lang="id">본관으로 들어가는 현관의 위치를 모르시면 키보드의 'M' 키를 눌러 볼 수 있는 전체 지도를 이용해 주세요</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_7_0_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_8_0">
    <VALUE Lang="id">혹시 지금 화면 하단에 반짝이는 아이콘이 보이지 않으세요?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">만약 보인다면 퀘스트가 진행중이라는 거예요</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">'T' 키를 누르셔서 퀘스트 내용을 확인하시고 그대로 수행하셔야 해요</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_8_0_1">
    <VALUE Lang="id">다음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_8_0_2">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_helper.ntk_9_0">
    <VALUE Lang="id">구슬이 어떻게 만들어졌는지는 모르지만, 어느정도의 힘을 증명하는 것 같아요</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">그래서 영령구슬을 가져가면 지도선생님들께서 등급에 맞는 스킬문서로 교환해 주시죠</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
