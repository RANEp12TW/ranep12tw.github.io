    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_30_0">
    <VALUE Lang="id">그 개 뿐만이 아냐</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">지금 모든 걸 다 알 순 없겠지만, 재단에서 하는 일 중에 걸리는 게 좀 있거든</VALUE>
