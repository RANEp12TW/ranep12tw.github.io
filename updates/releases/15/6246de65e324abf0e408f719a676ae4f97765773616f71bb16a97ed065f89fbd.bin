    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_43_0">
    <VALUE Lang="id">Selalu jaga jarak dengan musuh adalah strategi terbaik untuk melindungi diri sendiri.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_43_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_44_0">
    <VALUE Lang="id">Jikalau terlalu dekat dengan musuhmu, cobalah atur jarak.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_44_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_45_0">
    <VALUE Lang="id">Lebih baik berburu dengan teman-temanmu karena Pemanah sedikit lemah di bagian defense.</VALUE>
  </SENTENSE>
