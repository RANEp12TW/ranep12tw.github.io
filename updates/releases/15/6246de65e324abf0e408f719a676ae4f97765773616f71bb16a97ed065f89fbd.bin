  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_54_0">
    <VALUE Lang="id">‘양호실’에 가면 상처치료도 해 주니까 미리 가서 인사나 드리도록 해</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_54_0_1">
    <VALUE Lang="id">Kembali</VALUE>
