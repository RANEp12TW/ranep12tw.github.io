  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_11_0">
    <VALUE Lang="id">Tujuan akhir dari pengasahan shaman adalah untuk meningkatkan kekuatan ilmu gaib yang melebihi tiga energi dan ruang waktu yang terpendam</VALUE>
