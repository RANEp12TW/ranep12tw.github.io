  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_57_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_58_0">
    <VALUE Lang="id">Harap waspada karena sedikit kesalahan saja bisa berakibat buruk.</VALUE>
