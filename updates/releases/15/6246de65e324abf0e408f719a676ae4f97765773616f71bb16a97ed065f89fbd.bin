    <VALUE Lang="id">..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0">
    <VALUE Lang="id">Magician mengalahkan musuhnya menggunakan gerakan tangan yang cepat dan berbagai trik. Yang mana yang kamu inginkan?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_1">
    <VALUE Lang="id">Trick Magician "Cube"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_2">
    <VALUE Lang="id">Taming Magician "Whip"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_3">
    <VALUE Lang="id">Illusion Magician "Magic Wand"</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_23_0_4">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_juniorteacher.ntk_24_0">
    <VALUE Lang="id">Ketika kamu mencapai level 30, 50 atau 70, datang lagi kemari supaya saya bisa mengganti senjatamu dengan yang lebih kuat. Namun jangan lupa untuk melepas yang sedang kamu pakai terlebih dulu</VALUE>
  </SENTENSE>
