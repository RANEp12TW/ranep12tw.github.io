  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_59_0">
    <VALUE Lang="id">Sekarang ada yang harus kamu lakukan sebelum menyerahkan formulir pendaftaranmu.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Seperti yang sudah saya beritahukan sebelumnya, banyak monster yang datang mengganggu sekolah kita.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tolong cegah mereka sebelum lebih banyak jatuh korban.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_59_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_6_0">
    <VALUE Lang="id">Skill Point diatur dari 0 sejak awal. Setiap kali karaktermu naik level, akan mendapat 1 Skill Point. Kamu dapet menggunakan Skill Point tersebut untuk menaikkan level Skillmu atau mempelajari Skill baru</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_6_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_60_0">
    <VALUE Lang="id">Kalau kamu lengah sedikit saja di daerah sekitar sekolah kamu bisa kehiangan nyawa</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
