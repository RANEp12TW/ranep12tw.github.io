  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_0">
    <VALUE Lang="id">Hi~ Nama saya Chloe dari Fantasy Forest~ Aku sangat suka warna hijau. Membuat saya nyaman dan tenang.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_marchevent.ntk_1_0_1">
