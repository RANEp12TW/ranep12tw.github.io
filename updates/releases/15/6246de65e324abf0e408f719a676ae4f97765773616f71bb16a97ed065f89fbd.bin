  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_5_0">
    <VALUE Lang="id">Berada di barisan paling depan dan melindungi teman-teman adalah tugas kalian.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Kalau punya kekuatan tentu saja harus digunakan</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
