    <VALUE Lang="id">Ada apa ya dengan mereka…</VALUE>
    <VALUE Lang="id">Anda bisa kesana dan ambil kuncinya dari mereka.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_44_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_checkit.ntk_5_0">
    <VALUE Lang="id">Sudah lama sekali kamu tidak kelihatan…</VALUE>
