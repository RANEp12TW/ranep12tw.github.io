  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event1.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_1_0">
    <VALUE Lang="id">Selamat datang! Saya pemandu disini, panggil saja saya Cooler~</VALUE>
    <VALUE Lang="id">Ada yang bisa saya bantu?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_1_0_1">
    <VALUE Lang="id">Saya ingin tahu lebih tentang festival!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_1_0_2">
    <VALUE Lang="id">Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_april_event2.ntk_2_0">
    <VALUE Lang="id">Kamu lihat mereka yang mirip dengan saya?</VALUE>
