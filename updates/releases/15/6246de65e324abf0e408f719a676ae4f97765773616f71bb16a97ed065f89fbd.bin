  <SENTENSE Ver="1" Id="npc_1_t_ex1.ntk_4_0">
    <VALUE Lang="id">Bencana ini sendiri sudah diperkirakan sebelumnya, namun sekarang tidak ada seorang pun yang tahu apa yang akan terjadi selanjutnya</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Selain itu, belum diketahui apakah ini benar-benar sama seperti yang diprediksi sebelumnya..</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Oleh karena itu harus du</VALUE>
