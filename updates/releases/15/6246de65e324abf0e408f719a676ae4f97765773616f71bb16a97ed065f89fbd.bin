  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_2"><VALUE Lang="tw">兌換 碧波劍氣（87級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="id">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="cn">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE><VALUE Lang="th">Skill book: Blue Wave (Lv87, Class=130, Item=175/6)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_3"><VALUE Lang="tw">兌換 震撼噴流（57級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="id">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="cn">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE><VALUE Lang="th">Skill book: Shock Geyser (Lv57, Class=130, Item=175/26)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_sword_sdchange.ntk_9_0_4"><VALUE Lang="tw">兌換 無盡怒氣（87級／劍道部）</VALUE><VALUE Lang="GS">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="id">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="cn">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE><VALUE Lang="th">Skill book: Infinite Rage (Lv87, Class=130, Item=175/46)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_0">
    <VALUE Lang="id">Sepertinya kamu bukan seorang Magician….Saya juga bukan orang tua yang ramah…Hmmm…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_0_1">
    <VALUE Lang="id">Tukar</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1">
    <VALUE Lang="id">Kamu adalah Magician, bukan?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_1">
    <VALUE Lang="id">Tukar</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_10">
    <VALUE Lang="id">Berikan saran tentang bagaimana memperbaiki kelas Magician</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_2">
    <VALUE Lang="id">Tanyakan arti Dahlia</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_3">
    <VALUE Lang="id">Berikan saran tentang bagaimana memperbaiki kelas Magician</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_4">
    <VALUE Lang="id">Terimalah permintaan Crucio</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_5">
    <VALUE Lang="id">Berikan informasi yang telah kamu dapatkan dari investigasi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_6">
    <VALUE Lang="id">Pelajari pelajaran pertama Crucio</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_7">
    <VALUE Lang="id">Pelajari pelajaran kedua Crucio</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_8">
    <VALUE Lang="id">Pelajari pelajaran ketiga Crucio</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_1_1_9">
    <VALUE Lang="id">Berikan saran tentang bagaimana memperbaiki kelas Magician</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_10_0">
    <VALUE Lang="id">Saya akan menunggu disini</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_11_0">
    <VALUE Lang="id">Saya sangat bodoh. Tidak mengetahui kebenarannya</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_12_0">
    <VALUE Lang="id">Semoga berhasil!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0">
    <VALUE Lang="id">Cobalah untuk menebak jawabannya. Kamu dapat mencobanya lagi, jadi jangan merasa terlalu terbebani.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_1">
    <VALUE Lang="id">Cinta yang Penuh Gairah</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_2">
    <VALUE Lang="id">Cinta yang Abadi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_3">
    <VALUE Lang="id">Rasa terimakasihku melebihi perhatianmu</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_2_0_4">
    <VALUE Lang="id">Jiwa yang Murni</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_3_0">
    <VALUE Lang="id">Itulah arti simbol Rose. Pikirkan lagi.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_4_0">
    <VALUE Lang="id">Itulah arti simbol Lily. Pikirkan lagi.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_4_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_5_0">
    <VALUE Lang="id">Kamu benar. Mari saya berikan kamu hadiah</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_5_0_1">
    <VALUE Lang="id">Terima hadiahnya</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_6_0">
    <VALUE Lang="id">Itulah arti simbol Gypsophila. Pikirkan lagi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_6_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_7_0">
    <VALUE Lang="id">Harap kamu bahagia.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_8_0">
    <VALUE Lang="id">Bicara dengan Magician Instructor</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0">
    <VALUE Lang="id">Kamu sedang melihat seorang tua renta, tapi dulu saya adalah pejuang hebat. Demi cinta saya pernah bertarung melawan Valentino, Sang Penyihir Hebat. Namun sayangnya, saya kalah. Kemudian saya lari ke tebing dan bersembunyi di gua. Untungnya saya tidak keh</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0_1">
    <VALUE Lang="id">Katakan padanya untuk menerima bantuannya</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_trick_crusio.ntk_9_0_2">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_1_0">
    <VALUE Lang="id">Abra kadabra~ Saya adalah the Animal Trainer. Apa yang bisa saya bantu?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_1_0_1">
    <VALUE Lang="id">Dapatkan Magical Animal</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0">
    <VALUE Lang="id">Untuk mendapatkan magical animal, kamu perlu mempelajari Animal Mastery. Apakah kamu sudah mempelajarinya?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0_1">
    <VALUE Lang="id">Iya</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_2_0_2">
    <VALUE Lang="id">Tidak</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_3_0">
    <VALUE Lang="id">Oh,sayang sekali! Kamu belum mempelajari skill Animal Mastery. Silahkan pelajari jika ada kesempatan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0">
    <VALUE Lang="id">Kamu telah mempelajari Animal mastery, tetapi biarkan saya menjelaskan ini dulu kepadamu. Hewan ini memiliki skill-skill yang dapat ditingkatkan dari 1 hingga 4 level. Dengan demikian, mereka dapat menjadi lebih kuat. Sekarang, mari kita lihat skill-skill</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_1">
    <VALUE Lang="id">Pertanyaan tentang Tiger</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_2">
    <VALUE Lang="id">Pertanyaan tentang Cat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_4_0_3">
    <VALUE Lang="id">Pertanyaan tentang Owl</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0">
    <VALUE Lang="id">Magician Tiger</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Order 1. Menarik target selama 1.5 detik , Movement Speed -30%, HP Absorption +10%</VALUE>
    <VALUE Lang="id">Order 2. Selama 1.5 detik, Movement Speed -20%, HP Absorption +10%, Skill Range -70</VALUE>
    <VALUE Lang="id">Order 3. Dalam 1.5 detik dengan cepat mendekati target, HP Absorption +10%, Target Tidak Berubah, Tidak dapat menggunakan Potion</VALUE>
    <VALUE Lang="id">Order 4. Stun selama 0.8 detik, HP Absorption +10%, Defense -10%</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ia memiliki banyak kemampuan menyerang.</VALUE>
    <VALUE Lang="id">Apakah anda tidak ingin ke medan perang bersamanya??</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0_1">
    <VALUE Lang="id">Dapatkan Tiger</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_5_0_2">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0">
    <VALUE Lang="id">Magician Cat</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Order 1. Selama 1.5 detik, setiap detik +100, menghilangkan debuff, mencegah/ memulihkan status abnormal</VALUE>
    <VALUE Lang="id">Order 2. Selama 1.5 detik, Absorption +10%, Defense +5%, HP+MP+SP Recovery Rate 0.01%</VALUE>
    <VALUE Lang="id">Order 3. Selama 2 detik, Attack +15%, Accuracy +30</VALUE>
    <VALUE Lang="id">Order 4. Selama 1 detik, menyerap serangan Magic +10%, HP Recovery +0.2%, Resistance +20, Attack Speed +20%, Move Speed +20%</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ia memiliki banyak skill Buff.</VALUE>
    <VALUE Lang="id">Apakah anda ingin menghabiskan lebih banyak waktu dengannya?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0_1">
    <VALUE Lang="id">Dapatkan Cat</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_6_0_2">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_7_0">
    <VALUE Lang="id">Magician Owl</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Order 1. Selama 2 detik, Defense -10%, Attack Speed -20%, HP Absorption +10%,</VALUE>
    <VALUE Lang="id">Order 2. Selama 2 detik, Defense -10%, Skill Delay +10%, HP Absorption +10%</VALUE>
    <VALUE Lang="id">Order 3. Selama 1.5 detik, Defense -30%, Accuracy -45, Attack -30%, HP Absorption +10%,</VALUE>
    <VALUE Lang="id">Order 4. Selama 0.8 detik, Defense -10%, tidak dapat menggunakan skill dan potion, HP Absorption +10%</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ia memiliki banyak kemampuan menyerang.</VALUE>
    <VALUE Lang="id">Apakah anda ingin bersama dengan Owl yang dapat mengurangi kemampuan bertarung lawan?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_7_0_1">
    <VALUE Lang="id">Dapatkan Owl</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_tricker_animal01.ntk_7_0_2">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_ruin.ntk_1_0">
    <VALUE Lang="id">Musuh berniat menyerang kita siang dan malam jadi kita harus tetap siaga!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_ruin.ntk_1_0_1">
    <VALUE Lang="id">Item Sale</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_sia.ntk_1_0">
    <VALUE Lang="id">Ini adalah peraturan perkumpulan jadi kita tidak bisa berbuat apa-apa tetapi melihat keadaan sekarang, saya memiliki firasat tidak enak..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_worldwar_reward_sia.ntk_1_0_1">
    <VALUE Lang="id">Item Sale</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_0">
    <VALUE Lang="id">Uh? Kamu pelajar disini? Saya juga pelajar disini dulu, tetapi sekarang saya sudah sukses. Hu hu huft</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">--------------------------------------------------</VALUE>
    <VALUE Lang="id">Saya datang kemari untuk melihat adik-adik kelas dan membawa banyak hadiah. Kamu mau? Hu hu huft.. Tapi saya tidak dapat memberikannya begitu saja. Yah, saya suka berpesta.. Kamu mau pergi ke pesta dengan saya? Kalau iya, saya dapat memberikan semua hadiah-hadiahnya~ Hu hu huft</VALUE>
    <VALUE Lang="id">--------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_0_1">
    <VALUE Lang="id">Shop</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_0_2">
    <VALUE Lang="id">Ada hadiahnya kan? Bagaimana mendapatkannya?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_1_1">
    <VALUE Lang="id">Uh? Kamu pelajar disini? Saya juga pelajar disini dulu, tetapi sekarang saya sudah sukses. Hu hu huft</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">--------------------------------------------------</VALUE>
    <VALUE Lang="id">Saya datang kemari untuk melihat adik-adik kelas dan membawa banyak hadiah. Um? Kamu terlalu lucu. Kamu harus tumbuh dewasa agar dapat berpesta dengan saya. Kembalilah jika kamu telah mencapai level 30 atau lebih. Terus berusaha dan kembali karena saya akan menunggu~</VALUE>
    <VALUE Lang="id">---------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_2_0">
    <VALUE Lang="id">Hu Huft. Semuanya terserah kamu. Mari kita mulai berpesta?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">--------------------------------------------------</VALUE>
    <VALUE Lang="id">Jika kamu ingin menukarkan dan menerima hadiah, kamu harus menggunakan handmade lunchbox dan menerima buff. Selama kamu dalam status buff, mob akan menjatuhkan bagian-bagian foto saya. Dapatkan foto-foto tersebut dan tukarkan dengan hadiah yang kamu mau. Hu huft.. Pesta kita diadakan setiap hari tetapi kamu hanya memiliki waktu 3 jam setelah mengkonsumsi handmade lunchbox buatan saya. Semoga beruntung!</VALUE>
    <VALUE Lang="id">---------------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_2_0_1">
    <VALUE Lang="id">Yah. Saya juga tahu cara berpesta. (Quest Mulai)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_3_0">
    <VALUE Lang="id">Saya menyukai gaya kamu~ Mari berpesta dengan saya. Hu huft..</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">----------------------------------------------</VALUE>
    <VALUE Lang="id">Oh, Ada sedikit tip untukmu. Jika kamu ingin menyelesaikan quest harian, kamu harus mendapatkan party invitation card yang dapat ditukar dengan beloved alumni gift box. Di dalam box, kamu dapat menemukan hand made lunchbox. Hu huft  Semoga beruntung!</VALUE>
    <VALUE Lang="id">-----------------------------------------------</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="sangsievent.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_1_0">
    <VALUE Lang="id">시험을 치르기 위해 한 학생이 시험지를 배부받아갔다더니 그게 자네군... 그래 얼마나 열심히 공부했는지 볼까?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_1_0_1">
    <VALUE Lang="id">시험을 시작한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_1_0_3">
    <VALUE Lang="id">반성문을 제출한다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_10_0">
    <VALUE Lang="id">음... 그렇다면 기숙사에 있는 쓰레기장에서 청소를 하며 반성문을 모아오시게 그러면 다시한번 생각을 해보겠네.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_10_0_1">
    <VALUE Lang="id">처음으로</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_2_0">
    <VALUE Lang="id">축하하네. 학교에 이런학생이 있었다니 가슴이 벅차오르는군. 이 의견서를 교무실에 계신 학생 주임에게 드리게.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_2_0_2">
    <VALUE Lang="id">의견서를 배부받는다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0">
    <VALUE Lang="id">다음 중 함수 y=2x+4의 그래프 위에 있는 점은 무엇인가?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_1">
    <VALUE Lang="id">1. (0,2)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_2">
    <VALUE Lang="id">2. (1,6)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_3">
    <VALUE Lang="id">3. (-1,-2)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_3_0_4">
    <VALUE Lang="id">4. (2,6)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0">
    <VALUE Lang="id">남학생은 한 명이 10일 동안 여학생은 한명이 15일 동안 걸려서 할 수 있는 일을 남학생과 여학생을 합해 12명이 하루에 끝내려고 한다. 남학생은 최소한 몇 명이 필요한가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_1">
    <VALUE Lang="id">1. 4명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_2">
    <VALUE Lang="id">2. 5명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_3">
    <VALUE Lang="id">3. 6명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_4_0_4">
    <VALUE Lang="id">4. 7명</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0">
    <VALUE Lang="id">합이 163인 두 자연수가 있다. 큰 수를 작은 수로 나누면 몫이 7이고 나머지는 3이다. 두 자연수 중에서 작은 수를 구하면 무엇인가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_1">
    <VALUE Lang="id">1. 7</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_2">
    <VALUE Lang="id">2. 20</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_3">
    <VALUE Lang="id">3. 52</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_5_0_4">
    <VALUE Lang="id">4. 77</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0">
    <VALUE Lang="id">연립 방정식 2x+y=4x-3y=5를 푼다면 과연 x,y의 값은 얼마인가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_1">
    <VALUE Lang="id">1. x=-1, y=3</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_2">
    <VALUE Lang="id">2. x=2, y=1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_3">
    <VALUE Lang="id">3. x=-2, y=-1</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_6_0_4">
    <VALUE Lang="id">4. x=1, y=2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0">
    <VALUE Lang="id">톱니의 수가 30개, 42개인 두 톱니바퀴가 맞물려 돌아가고 있다. 두 톱니가 한 번 맞물린 후 같은 톱니에서 다시 맞물릴 때까지 큰 톱니바퀴는 몇 바퀴를 돌아야 하는가?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_1">
    <VALUE Lang="id">1. 3바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_2">
    <VALUE Lang="id">2. 4바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_3">
    <VALUE Lang="id">3. 5바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_7_0_4">
    <VALUE Lang="id">4. 6바퀴</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_8_0">
    <VALUE Lang="id">아직 수양이 부족한 것 같군. 이래서 어떻게 시험을 볼 생각을 했는지....쯧쯧.....</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_8_0_1">
    <VALUE Lang="id">다시한번 시험을 치르고 싶다.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_9_0">
    <VALUE Lang="id">그렇군 반성문을 적어왔군. 이제는 정말 잘할 자신이 있겠지. 좋아... 다시한번 기회를 주지. 이번에는 잘해보게나</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="test_npc.ntk_9_0_1">
    <VALUE Lang="id">시험을 재도전한다.</VALUE>
  </SENTENSE>

