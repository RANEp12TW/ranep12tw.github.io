  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_5_0">
    <VALUE Lang="id">…kerja yang baik. Ayo seberangi jembatannya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_5_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_6_0">
    <VALUE Lang="id">…Ayo menyusup setelah menyeberang. Kumpul kembali di sebelah lainnya dulu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_6_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_7_0">
    <VALUE Lang="id">…jadi penduduk mengatakan hal yang sama. Hmm begitu ya.</VALUE>
  </SENTENSE>
