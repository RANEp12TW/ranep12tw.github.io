  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_1_0">
    <VALUE Lang="id">Apakah kamu pernah mendengar tentang Feather of Firebird?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_1_0_1">
    <VALUE Lang="id">Bertanya tentang Feather of Firebird.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_1_0_2">
    <VALUE Lang="id">Jadi kamu ingin menukar Feather of Firebird dengan 'Firebird Hat'!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_1_0_3">
    <VALUE Lang="id">Apakah kamu ingin mengupgrade 'Firebird Hat'?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_2_0">
    <VALUE Lang="id">Feather of Firebird? Firebird selalu menyembunyikan dirinya! Apakah kamu tahu? Ketika dia muncul, berarti sesuatu akan terjadi di dunia ini. Bahkan bulu nya saja mengandung kekuatan ajaib. Jikalau bisa, kumpulkan bulu nya dan bawakan ke saya. Akan kubuatk</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_2_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_3_0">
    <VALUE Lang="id">Apakah kamu sudah mendapatkan bulunya?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_3_0_1">
    <VALUE Lang="id">Tukar 1 Feather of Firebird dengan Firebird Hat (I).</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_3_0_3">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_4_0">
    <VALUE Lang="id">Apakah kamu sudah mendapatkan bulunya? Makin banyak bulu yang kamu kumpulkan, makin kuat topi yang akan dihasilkan! Kumpulkan sebanyak yang kamu bisa!!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_4_0_1">
    <VALUE Lang="id">Menerima Firebird Hat (II) [Feather of Firebird(10)+Firebird Hat(I)]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_4_0_2">
    <VALUE Lang="id">Menerima Firebird Hat (III) [Feather of Firebird(30)+Firebird Hat(II)]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_4_0_3">
    <VALUE Lang="id">Menerima Firebird Hat (IV) [Feather of Firebird(100)+Firebird Hat(III)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_4_0_4">
    <VALUE Lang="id">Menerima Firebird Hat (V) [Feather of Firebird(300)+FirebirdHat(IV)]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_4_0_5">
    <VALUE Lang="id">Menerima Firebird Hat (VI) [Feather of Firebird(300)+Firebird Hat(V)]</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_fire bird.ntk_4_0_6">
    <VALUE Lang="id">Menerima Firebird Hat (VII) [Feather of Firebird(300)+FirebirdHat(VI)]</VALUE>
  </SENTENSE>
