  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_47_0">
    <VALUE Lang="id">Kalau stamina terus berkurang, ketepatan dan kekuatan serangan menjadi berkurang. Tergantung pada situasi yang ada hal ini bisa membahayakan</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
