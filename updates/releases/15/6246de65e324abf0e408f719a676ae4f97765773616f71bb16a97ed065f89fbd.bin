  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event2.ntk_1_0">
    <VALUE Lang="id">Kemana perginya si Playful Witch…</VALUE>
    <VALUE Lang="id">Semoga dia tidak mencari gara gara lagi..?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_oct_event2.ntk_1_1">
    <VALUE Lang="id">Hati-hati! Playful Witch mungkin mengganggu kamu..</VALUE>
    <VALUE Lang="id">Tapi jika kamu menerima candy ini dari saya setiap hari~</VALUE>
