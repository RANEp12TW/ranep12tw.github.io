  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_22_0">
    <VALUE Lang="id">Karena itu, dengan adanya ujian reguler ini pelajar jadi tahu kekuranyanya dan mana yang harus diperbaiki</VALUE>
