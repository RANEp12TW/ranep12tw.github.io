  <SENTENSE Ver="1" Id="npc_0_jsa.ntk_39_0">
    <VALUE Lang="id">Kamu sudah menemukannya? Nah..in ambil yang kamu inginkan. Sekarang aku harus meneliti lagi design yang kamu temukan tadi</VALUE>
    <VALUE Lang="id">Skip</VALUE>
