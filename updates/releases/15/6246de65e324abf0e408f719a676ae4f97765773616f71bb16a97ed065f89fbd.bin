  <SENTENSE Ver="1" Id="2016_christmas_event1.ntk_2_0">
    <VALUE Lang="id">Terimakasih banyak karena telah membantuku~</VALUE>
    <VALUE Lang="id">Saya akan memasukkan pecahan-pecahan yang telah kamu kumpulkan ke dalam magic pouch saya!</VALUE>
    <VALUE Lang="id">Kamu dapat menerima star decoration setelahnya</VALUE>
    <VALUE Lang="id">dengan cara mengumpulkan mereka dan membawanya kepadaku!</VALUE>
    <VALUE Lang="id">Oh! Pouch nya ada di saya, kamu dapat menerima 1 per hari nya jadi jangan lupa ya~!</VALUE>
