  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_gainun.ntk_4_0">
    <VALUE Lang="id">Bukan… tempat ini adalah gabungan dunia kamu dan dunia kami.. Kalau lama disni, bisa jadi guardian penjaga tempat ini..untuk menjaga pintu ini selama satu tahun..</VALUE>
