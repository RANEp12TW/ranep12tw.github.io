    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_8_0">
    <VALUE Lang="id">그동안 배웠던 모든 능력 (스탯)과 기술 (스킬)을 처음 상태로 되돌린다니</VALUE>
    <VALUE Lang="id">Skip</VALUE>
