    <VALUE Lang="id">Apalagi kalau sedang berlari karena dikejar sesuatu, benda ini sangat mudah terjatuh~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Terus ada cerita lagi kalau ada orang-orang yang memungut item yang terjatuh itu</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Katan</VALUE>
  </SENTENSE>
