    <VALUE Lang="id">"Jika kamu mempunyai Spiritual Spheres, berarti kekuatan kamu sudah cukup diakui. Pilihlah Skill yang kamu inginkan "</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_30_0_1"><VALUE Lang="tw">兌換 黑洞（147級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="id">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="cn">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE><VALUE Lang="th">Skill book: Blackhole (Lv147, Class=12288, Item=362/15)</VALUE></SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_nin.ntk_30_0_2"><VALUE Lang="tw">兌換 迷醉（147級／忍術部）</VALUE><VALUE Lang="GS">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="id">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="cn">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE><VALUE Lang="th">Skill book: Enrapture (Lv147, Class=12288, Item=362/35)</VALUE></SENTENSE>
