  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_0">
    <VALUE Lang="id">Ternyata sudah selesai.</VALUE>
    <VALUE Lang="id">Sekarang bisa pergi ke tunnel itu.</VALUE>
    <VALUE Lang="id">Hati-hati ya!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_1">
    <VALUE Lang="id">Eh.. Bukan disitu!!</VALUE>
    <VALUE Lang="id">Tidak bisa lebih cepat?!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_1_1">
    <VALUE Lang="id">Beritahu sudah sampai lebih dahulu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_1_1_2">
    <VALUE Lang="id">Keluarkan kunci cadangan gudang peralatan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_2_0">
    <VALUE Lang="id">Ah, peserta hunting ternyata..</VALUE>
    <VALUE Lang="id">Ha….Bagaimana dong? Pekerjaannya kan belum selesai.</VALUE>
    <VALUE Lang="id">Bornya rusak dan masih butuh perlatan cadangan tambahan.</VALUE>
    <VALUE Lang="id">Anda tidak mau tanya keatas dan bawa kuncinya kesini?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_2_0_1">
    <VALUE Lang="id">Beritahu akan pergi ambil dan akan kembali lagi.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_3_0">
    <VALUE Lang="id">Dulu lupa pernah taruh kuncinya dimana ya.</VALUE>
    <VALUE Lang="id">Jadi harus menggunakan kunci cadangan ya.</VALUE>
    <VALUE Lang="id">Bertanyalah pada student counselor di MarketPlace</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_3_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_4_0">
    <VALUE Lang="id">Waaaa~~~ Terimakasih banyak!</VALUE>
    <VALUE Lang="id">Berkat anda semua dapat selesai nih. Hehehe</VALUE>
    <VALUE Lang="id">Sedikit lagi selesai percayalah pada kami.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefworker.ntk_4_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_0">
    <VALUE Lang="id">Hi..Hiiks..Selamatkan saya…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_0_1">
    <VALUE Lang="id">Tanya apa yang sakit</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_0_2">
    <VALUE Lang="id">Tanya tentang area diseberang jembatan</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_1">
    <VALUE Lang="id">Ah Ah..Apa yang terjadi pada yang lain?…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_1_1">
    <VALUE Lang="id">Gangsters Tyranny (kembali)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_1_1_2">
    <VALUE Lang="id">Tanya apa yang terjadi.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_2_0">
    <VALUE Lang="id">Ah..Ah Ah..Be beneran?</VALUE>
    <VALUE Lang="id">Ugh..Te te terima kasih. Beneran deh.</VALUE>
    <VALUE Lang="id">Saya telah diserang oleh para gangsters. Untungnya saya bisa kabur..</VALUE>
    <VALUE Lang="id">Habis deh saya kalau sampai tertangkap.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_2_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_3_0">
    <VALUE Lang="id">Ada kecelakaan beberapa waktu lalu.</VALUE>
    <VALUE Lang="id">Tunnelnya roboh dan kita terpisah dari dunia lain tapi kita berhasil selamat.</VALUE>
    <VALUE Lang="id">Tapi, saya tidak ingat mulai kapan..orang-orang mencurigakan itu mulai berkumpul.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_3_0_1">
    <VALUE Lang="id">Selanjutnya</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_4_0">
    <VALUE Lang="id">Pertamanya saya kira mereka cuma berandalan dari daerah sekitar</VALUE>
    <VALUE Lang="id">tapi mereka menangkap orang-oang, memperlakukan mereka seperti budak , sambil mengambil alih kota.</VALUE>
    <VALUE Lang="id">Bahkan sampai sekarang, ada orang yang masih bekerja pada mereka secara dipaksakan.</VALUE>
    <VALUE Lang="id">Orang-or</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_4_0_1">
    <VALUE Lang="id">Gangsters Tyranny</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_5_0">
    <VALUE Lang="id">Te te terima kasih…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_5_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_6_0">
    <VALUE Lang="id">Saya masih khawatir tentang orang-orang yang tertangkap.</VALUE>
    <VALUE Lang="id">Bisakah anda kalahkan mereka sehingga yang lain bisa kabur?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_6_0_1">
    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_citizen.ntk_7_0">
    <VALUE Lang="id">Anda mau menyeberangi jembatan itu?</VALUE>
    <VALUE Lang="id">Tempat itu adalah tempat persembunyian gangster.</VALUE>
    <VALUE Lang="id">Si orang aneh dengan mask tidak hanya menembak sembarangan.</VALUE>
    <VALUE Lang="id">Perempuan yang seram itu selalu bawa pedang.</VALUE>
