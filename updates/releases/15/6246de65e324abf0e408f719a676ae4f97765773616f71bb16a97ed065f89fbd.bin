  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_5_0">
    <VALUE Lang="id">Peran dari pelajar brawler dalam pertarungan kelompok adalah melakukan serangan langsung di barisan paling depan sambil membuat gerakan musuh terpencar.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Pasti lebih mudah untuk berkonsentrasi karena tidak ada tameng ataupun senjata yang harus dipegang</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_fighter1.ntk_5_0_1">
