    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_1_t_knight1.ntk_46_0">
    <VALUE Lang="id">Yang harus diperhatikan bagi kalian yang memilih jurusan Sword adalah bahwa kalian membutuhkan stamina yang lebih banyak bila dibandingkan dengan jurusan yang lain pada masa perkembangan kalian</VALUE>
