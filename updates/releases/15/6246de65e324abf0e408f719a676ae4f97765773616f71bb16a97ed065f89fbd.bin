  <SENTENSE Ver="1" Id="npc_0_iss.ntk_15_0_2">
    <VALUE Lang="id">Sudah siap</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_16_0">
    <VALUE Lang="id">Untuk membuatnya dibutuhkan Spirit of Warrior yang aku miliki dan teman-temanku. Kalau kamu bisa mengambil satu dari Gainun</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_iss.ntk_16_0_1">
