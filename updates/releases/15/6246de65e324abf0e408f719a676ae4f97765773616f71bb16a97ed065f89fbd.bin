    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_56_0">
    <VALUE Lang="id">Saat ini manusia normal sudah sangatlah langka. Hampir semuanya sudah terinfeksi menjadi monster yang jahat. Walaupun itu terdengar sangat buruk tapi bukan berarti kita tidak bisa memperbaikinya.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_56_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_57_0">
    <VALUE Lang="id">Para Guru sedang berusaha keras untuk membuat semuanya kembali seperti semula.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_57_0_1">
    <VALUE Lang="id">Kembali</VALUE>
