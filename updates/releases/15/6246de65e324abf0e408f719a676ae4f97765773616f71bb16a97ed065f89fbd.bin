  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_0_1">
    <VALUE Lang="id">Open Store</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2017_newyear_event.ntk_1_1">
    <VALUE Lang="id">Oh, sepertinya Santa lupa membawa saya bersamanya...</VALUE>
    <VALUE Lang="id">Tolong bantu saya kembali kepada Santa dengan mengumpulkan Santa's Trace…!</VALUE>
    <VALUE Lang="id">Ah! Sebelum kamu pergi, saya berikan hadiah ini~</VALUE>
