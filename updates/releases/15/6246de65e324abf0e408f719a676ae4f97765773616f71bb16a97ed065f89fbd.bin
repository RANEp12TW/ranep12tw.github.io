    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Material 1 (30) + Material 2 (30) + Material 3 (30) + Material 4 (10) + 100,000 Gold = Reward 1</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Material 1 (30) + Material 2 (30) + Material</VALUE>
