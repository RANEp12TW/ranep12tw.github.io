  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_d_guard1.ntk_6_0">
    <VALUE Lang="id">Padalah dulu meskipun mereka bertampang garang, mereka sangat sopan dan baik</VALUE>
    <VALUE Lang="id">Skip</VALUE>
