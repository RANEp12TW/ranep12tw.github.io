    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_reformcardcampaign.ntk_1_0">
    <VALUE Lang="id">Kembalilah jika kamu telah mencapai level 195.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_reformcardcampaign.ntk_1_1">
    <VALUE Lang="id">Hi~ Terimakasih telah datang, mari kita jaga game kita dari item dengan stats aneh! Silahkan reform item anda dengan Reform Card dari saya. Harap ingat bahwa Reform Cards yang saya berikan akan hilang setelah 1 jam!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_reformcardcampaign.ntk_1_1_1">
