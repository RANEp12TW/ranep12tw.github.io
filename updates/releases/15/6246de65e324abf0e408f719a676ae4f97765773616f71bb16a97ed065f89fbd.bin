    <VALUE Lang="id">Kalau berkonsentrasi pada kekuatan kalian akan digolongkan pada jenis blade dimana kamu tidak menggunakan sword tetapi power sword yang kekuatan penghancurnya tinggi saat menyerang</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_43_0_1">
    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_44_0">
    <VALUE Lang="id">Terakhir kalau berkonsentrasi pada pikiran kalian akan digolongkan ke dalam jenis sword/ blade dimana kamu menyerang dengan menggunakan tenaga dalam</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
