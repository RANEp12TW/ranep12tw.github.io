    <VALUE Lang="id">Silahkan melihat konten yang kami sediakan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_1">
    <VALUE Lang="id">Konfirmasi Kehadiran</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_school_helper.ntk_1_0_10">
