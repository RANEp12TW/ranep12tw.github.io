  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper2.ntk_1_0">
    <VALUE Lang="id">Wah, sudah lama sekali saya melihat ada pelajar yang ke sini.. Katakan saja jika ada yang bisa dibantu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_industry_helper2.ntk_1_0_1">
