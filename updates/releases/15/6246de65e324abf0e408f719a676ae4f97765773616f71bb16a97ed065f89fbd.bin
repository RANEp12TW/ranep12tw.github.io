  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_76_0">
    <VALUE Lang="id">Banyak pelajar yang begitu mencoba melewati Pintu Gerbang langsung menuju ke arah First-Aid Room. Bagaimana mungkin mereka tidak bisa melewatinya?</VALUE>
  </SENTENSE>
