  <SENTENSE Ver="1" Id="npc_0_scmasterpat.ntk_1_0_4">
    <VALUE Lang="id">Penyelidikan Peralatan Tenaga Listrik 1-2</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_scmasterpat.ntk_1_0_5">
