  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_1_1">
    <VALUE Lang="id">Sini, sini! Kamu sudah mendengar beritanya kan? Maksud saya adalah tentang mob-mob yang menyerang kampus! Sulit dipercaya.. Mereka mengetahui tentang kelas Shaper dan sekarang membawa senjata dan menyerang kampus-kampus..</VALUE>
    <VALUE Lang="id">Tetapi, mereka hanya menyerang pa</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_1_1_1">
    <VALUE Lang="id">Mari kita lakukan!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_1_1_2">
    <VALUE Lang="id">상점 열기</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_2_0">
    <VALUE Lang="id">Bagus! Sudah saya duga.</VALUE>
    <VALUE Lang="id">Ini, ambilllah tiket bus ini! Kamu perlu tiket ini untuk transportasi nanti saat melawan para monster</VALUE>
    <VALUE Lang="id">Jangan sampai hilang dan semoga berhasil mengalahkan bos monster!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_2_0_1">
    <VALUE Lang="id">Terima Tiket</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_3_0">
    <VALUE Lang="id">Terimakasih, saya sangat menghargainya! Saya berhasil mengetahui kapan saja para mob biasanya menyerang. Mereka selalu menyerang daerah pintu masuk kampus, tolong bantu kami pada saat-saat ini!</VALUE>
    <VALUE Lang="id">-----------------------------------------------------------------------------</VALUE>
    <VALUE Lang="id">15 : 00 ~ : dapat masuk dan menjalankan event</VALUE>
    <VALUE Lang="id">21 : 00 ~ : dapat masuk dan menjalankan event</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event1.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_1_0">
    <VALUE Lang="id">Terimakasih! Karena bantuanmu kami berhasil menghalau serangan dengan mudah! Oh dan, para mob meninggalkan apology letter sebelum mereka kabur. Kumpulkan item ini dan tukarkan dengan hadiah-hadiah!</VALUE>
    <VALUE Lang="id">Tapi, jangan lengah.. Mob-mob licik ini mungkin akan beru</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_1_0_1">
    <VALUE Lang="id">Tidak apa-apa!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_1_0_2">
    <VALUE Lang="id">Naik bus</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_2_0">
    <VALUE Lang="id">Oh! Dan kamu hanya dapat meninggalkan area ini melalui saya!</VALUE>
    <VALUE Lang="id">Silahkan gunakan bus yang saya sediakan~</VALUE>
    <VALUE Lang="id">Sampai jumpa~!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event2.ntk_2_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event3.ntk_1_0">
    <VALUE Lang="id">Masih terlalu berbahaya untuk kamu..</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2016_gs_event3.ntk_1_1">
    <VALUE Lang="id">Bagus kamu telah datang!! Sekarang persiapkan dirimu untuk melawan para mob..</VALUE>
    <VALUE Lang="id">Ini tidak akan mudah.</VALUE>
    <VALUE Lang="id">Apakah kamu sudah siap?</VALUE>
