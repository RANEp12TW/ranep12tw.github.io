    <VALUE Lang="id">Tukar dengan E Class Random Box (1~50Lv)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_gentlegirl.ntk_1_0_3">
    <VALUE Lang="id">Tukar dengan D Class Random Box (51~100Lv)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_gentlegirl.ntk_1_0_4">
    <VALUE Lang="id">Tukar dengan C Class Random Box (101~150Lv)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_gentlegirl.ntk_1_0_5">
    <VALUE Lang="id">Tukar dengan B Class Random Box (151~200Lv)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_gentlegirl.ntk_1_0_6">
    <VALUE Lang="id">Tukar dengan E Class Random Box (201Lv~)</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_gentlegirl.ntk_2_0">
    <VALUE Lang="id">Ahirnya musim panas telah tiba, lupakan semua kenangan masa lalu yang buruk. Tentu saja saya tidak akan memberikan Oblivion Potion gratis.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_e_gentlegirl.ntk_2_0_1">
    <VALUE Lang="id">Menerima Oblivion Potion.</VALUE>
  </SENTENSE>
