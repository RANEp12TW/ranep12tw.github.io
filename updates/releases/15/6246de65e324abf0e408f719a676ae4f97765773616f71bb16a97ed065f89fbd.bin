    <VALUE Lang="id">Ke halaman pertama</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_8_0">
    <VALUE Lang="id">…Cari tahu strategi dan pattern musuh terlebih dahulu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_chiefassassin_2.ntk_8_0_1">
