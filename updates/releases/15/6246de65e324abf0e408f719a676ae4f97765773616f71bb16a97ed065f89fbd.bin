  <SENTENSE Ver="1" Id="npc_0_gainun.ntk_4_0_1">
    <VALUE Lang="id">Bertanya apakah butuh bantuan</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_gainun.ntk_5_0">
    <VALUE Lang="id">Misalkan bisa menemukan orang yang lebih kuat…tolong hentikan amarah Lucian…dan tolong jaga juga dunia kami</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_0_gainun.ntk_5_0_1">
