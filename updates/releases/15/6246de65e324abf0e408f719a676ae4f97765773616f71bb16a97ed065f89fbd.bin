  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_42_0">
    <VALUE Lang="id">O, mau melakukan ujian sendiri, hebat juga!</VALUE>
    <VALUE Lang="id">Skip</VALUE>
