<?xml version="1.0" encoding="utf-8"?>
<TEXT>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0">
    <VALUE Lang="id">Pierrot yang sedang membuat event untuk para pelajar tiba - tiba berubah menjadi Joker karena stress yang disebabkan lembur siang dan malam demi menyelesaikannya!</VALUE>
    <VALUE Lang="id">Membiarkan Joker ini bebas akan berdampak buruk bagi kampus karena dia akan membuat seluruh</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_1">
    <VALUE Lang="id">Di mana saya bisa menemukan Joker tersebut?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_2">
    <VALUE Lang="id">Di mana saya bisa mendapatkan Admission Ticket untuk masuk ke dungeon?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_1_0_3">
    <VALUE Lang="id">Di mana saya bisa mendapatkan hadiahnya?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0">
    <VALUE Lang="id">Joker bersembunyi senditi di dalam dungeon tersembunyi.Tempat tersebut dipenuhi dengan berbagai macam perangkap jadi tidak akan mudah untuk bertemu dengannya. Jangan lupa kamu membutuhkan Admission Ticket untuk masuk ke dungeon tersebut.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_2_0_2">
    <VALUE Lang="id">Di mana saya bisa mendapatkan Admission Ticket?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0">
    <VALUE Lang="id">Monster di RAN sudah terinfeksi oleh penyakit yang dibawa oleh Joker and ketika dibunuh, mereka akan menjatuhkan  Matryoshka Boxes!</VALUE>
    <VALUE Lang="id">Tidak ada yang tahu terbuat dari bahan apa box tersebut tapi kamu bisa menemukan Admission Ticket yang disembunyikan oleh</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_3_0_2">
    <VALUE Lang="id">Di mana saya bisa mendapatkan hadiahnya?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0">
    <VALUE Lang="id">Akan ada orang yang sedang mengejar Joker di dalam dungeon. Kamu bisa mendapatkan hadiah dari orang tersebut (Joker Hunter). Saya bisa membantumu menukarkan hadiahnya tetapi akan lebih baik jika kamu bisa menemuinya sendiri. Apakah kamu masih mau menukarn</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_4_0_2">
    <VALUE Lang="id">Tolong ditukar</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0">
    <VALUE Lang="id">Ini yang kamu perlukan untuk menukar hadiah di sini.</VALUE>
    <VALUE Lang="id">--</VALUE>
    <VALUE Lang="id">Pierrot Badge 100 buah + Joker Badge 80 buah</VALUE>
    <VALUE Lang="id">= Jester King's Hat</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Pierrot Badge 150 buah + Joker Badge 100 buah +</VALUE>
    <VALUE Lang="id">Joker Card 100 buah</VALUE>
    <VALUE Lang="id">= Joker Look Box (7D)</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Pierrot Badge 200 buah + Joker</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_1">
    <VALUE Lang="id">Pilih Jester King's Hat!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_2">
    <VALUE Lang="id">Pilih Joker Look Box!</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="2013_april.ntk_5_0_3">
    <VALUE Lang="id">Pilih Joker Bike!</VALUE>
  </SENTENSE>
