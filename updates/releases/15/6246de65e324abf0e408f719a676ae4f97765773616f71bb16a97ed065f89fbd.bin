    <VALUE Lang="id">Lanjut</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_2_t_ex1.ntk_23_0">
    <VALUE Lang="id">Musuh yang akan kalian hadapi nantinya tidaklah seperti ini, oleh karena itu berlatihlah terus kedepannya</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Mengerti?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
