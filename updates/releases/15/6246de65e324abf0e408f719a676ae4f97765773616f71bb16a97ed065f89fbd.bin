  <SENTENSE Ver="1" Id="npc_3_t_t_master1.ntk_91_0">
    <VALUE Lang="id">Saya akan hubungi sebelumnya, kamu silahkan temui Student Director dari Mystic Peak Kampus dan minta Kembaliup disk untuk memulihkan Information Room.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
