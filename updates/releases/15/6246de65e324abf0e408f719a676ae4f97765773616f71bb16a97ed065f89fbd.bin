  <SENTENSE Ver="1" Id="npc_2_t_archer1.ntk_42_0">
    <VALUE Lang="id">Jangan terlalu banyak mendistribusikan Stat Points di bagian Physical Strengths karena karakter akan mendapatkan keuntungan juga dari atribut lain.</VALUE>
