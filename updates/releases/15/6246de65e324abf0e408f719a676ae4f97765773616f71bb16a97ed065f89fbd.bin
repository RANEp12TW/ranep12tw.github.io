    <VALUE Lang="id">Iya, ada apa?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Apa itu yang ada di tangan kamu? Kayaknya itu item yang akan kamu serahkan pada saya</VALUE>
    <VALUE Lang="id">Skip</VALUE>
