  <SENTENSE Ver="1" Id="npc_3_t_ex2.ntk_30_0">
    <VALUE Lang="id">Masalahnya bukan itu, tapi masalah sebenarnya Leonine School itu ada dimana</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Ada orang yang bilang kalau sekolah itu ada di bagian selatan Sacred Gate's park, ada juga yang bilang ada di bagian utaranya. Kalau tidak dikonfirmasi kita tidak bisa tahu</VALUE>
    <VALUE Lang="id">
    </VALUE>
