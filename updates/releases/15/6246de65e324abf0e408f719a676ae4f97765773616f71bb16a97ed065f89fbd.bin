  <SENTENSE Ver="1" Id="npc_1_t_medic1.ntk_15_0">
    <VALUE Lang="id">Aaa~ Makasih banyak-</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tadi dokumen yang ditulis terburu-buru harus dipindahkan dong</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Kalau suatu saat nanti kamu terluka, datang ke sini yah ~</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Aku pasti obati dengan pelayanan yang terbaik~</VALUE>
