  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_0">
    <VALUE Lang="id">Sudah yakin?...Sudah siap untuk menerima kekuatan?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_0_1">
    <VALUE Lang="id">Sudah siap untuk menerima kekuatan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_0_2">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_0_3">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_1">
    <VALUE Lang="id">Haha...kan udah aku bilang, kamu pasti bertemu lagi denganku...Eum..kini sudah waktunya untuk kamu mendapatkan kekuatan yang baru.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_1_1">
    <VALUE Lang="id">Bersedia datang untuk panggilan terakhir.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_1_2">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_1_3">
    <VALUE Lang="id">Tidak tertarik</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_2">
    <VALUE Lang="id">Sudah yakin?...Sudah siap untuk menerima kekuatan?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_2_1">
    <VALUE Lang="id">Sudah siap untuk menerima kekuatan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_2_2">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_2_3">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_3">
    <VALUE Lang="id">Akhirnya ketemu juga. Pertemuan kamu dan aku sepertinya takdir yang lewat tapi sebetulnya sudah direncanakan sejak dulu. Aku sudah menunggu sekian lama untuk menyerahkan kekuatan ini pada kamu…gimana?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_3_1">
    <VALUE Lang="id">Bertanya tentang kekuatan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_3_2">
    <VALUE Lang="id">Mungkin nanti</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_3_3">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_4">
    <VALUE Lang="id">Sudah yakin?...Sudah siap untuk menerima kekuatan?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_4_1">
    <VALUE Lang="id">Sudah siap untuk menerima kekuatan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_4_3">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5">
    <VALUE Lang="id">Akhirnya ketemu juga. Pertemuan kamu dan aku sepertinya takdir yang lewat tapi sebetulnya sudah direncanakan sejak dulu. Aku sudah menunggu sekian lama untuk menyerahkan kekuatan ini pada kamu…gimana?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_1">
    <VALUE Lang="id">Bertanya tentang kekuatan.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_2">
    <VALUE Lang="id">Tidak tertarik</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_3">
    <VALUE Lang="id">Jual beli item</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_4">
    <VALUE Lang="id">Machinator's Call</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_5_5">
    <VALUE Lang="id">Machinator's Test</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_1_6">
    <VALUE Lang="id">Kamu belum siap. Kembalilah setelah menjadi lebih kuat...</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_10_0">
    <VALUE Lang="id">Tolong bunuh Crazy Bomber di Prison Test Zone.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_10_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_11_0">
    <VALUE Lang="id">Pikirkan dengan baik sekali lagi kalau kamu sudah siap silahkan datang lagi ke sini.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_11_0_1">
    <VALUE Lang="id">Apa yang bisa saya lakukan?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_11_0_2">
    <VALUE Lang="id">Tidak tahu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_12_0">
    <VALUE Lang="id">Kamu harus berkonstrasi untuk menerima kekuatan dari saya lagi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_12_0_1">
    <VALUE Lang="id">Saya yakin</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_12_0_2">
    <VALUE Lang="id">Saya akan kembali lagi</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_12_0_3">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_13_0">
    <VALUE Lang="id">Pikirkan dengan baik sekali lagi kalau kamu sudah siap silahkan datang lagi ke sini.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_13_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_14_0">
    <VALUE Lang="id">Semoga beruntung. Saya rindu dengan masa lalu yang damai..tolong yah…dapatkan kembali kedamaian itu</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_14_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_15_0">
    <VALUE Lang="id">Hmmm… Sepertinya saya telah salah menilaimu…</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_15_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_2_0">
    <VALUE Lang="id">Pernah mendengar tentang 7 Titik awal mutlak? Di sanalah ke 7 Solid stone itu berada. Tak ada yang tahu apa itu Solid stone yang sebenarnya, tapi untuk bisa menghentikan kekacauan ini kita harus membetulkan keseimbangan dari ke 7 Solid stone itu.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_2_0_1">
    <VALUE Lang="id">Apa yang bisa saya lakukan?</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_2_0_2">
    <VALUE Lang="id">Tidak tahu.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_3_0">
    <VALUE Lang="id">Mungkin sekarang masih belum waktunya, tapi kamu pasti bisa menjaga keseimbangan dari Solid stone itu setelah bisa mengontrol kekuatan kegelapan melalui latihan. Bisa kamu tangani tidak?</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_3_0_1">
    <VALUE Lang="id">Saya punya kepercayaan diri.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_3_0_2">
    <VALUE Lang="id">Mungkin nanti</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_3_0_3">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_4_0">
    <VALUE Lang="id">Eum, penilaianku memang tidak pernah salah. Pikirkan dengan baik sekali lagi kalau kamu sudah siap silahkan datang lagi ke sini.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_4_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_5_0">
    <VALUE Lang="id">Eum, sudah lebih kuat daripada dulu. Saya siap kapan saja, kalau kamu sudah siap silahkan datang lagi.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_5_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_6_0">
    <VALUE Lang="id">Selamat. Kini kamu bisa mendapatkan kekuatan yang lebih kuat…nanti kalau sudah setahap lebih kuat silahkan datang lagi karena ada hadiah yang terakhir….</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_6_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_7_0">
    <VALUE Lang="id">Semoga beruntung. Saya rindu dengan masa lalu yang damai..tolong yah…dapatkan kembali kedamaian itu</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_7_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_8_0">
    <VALUE Lang="id">Saya telah salah menilai orang….</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_8_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_9_0">
    <VALUE Lang="id">Senang kamu kembali lagi. Lewati ujian dari saya dan akan kuberi kekuatan baru.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_skpoint_17_18.ntk_9_0_1">
    <VALUE Lang="id">Kembali</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_sp_blueevil.ntk_1_0">
    <VALUE Lang="id">Wow! Carl sangat berani!</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Tapi sebentar lagi dia akan menghadapi masalah besar...</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Jika kamu tidak tega melihatnya, segera kembali ke duniamu sekarang juga.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Skip</VALUE>
    <VALUE Lang="id">Saya akan menunggu jawabanmu. Hahaha~!</VALUE>
    <VALUE Lang="id">Skip</VALUE>
  </SENTENSE>
