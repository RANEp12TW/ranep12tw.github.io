  <SENTENSE Ver="1" Id="npc_2_t_knight1.ntk_57_0">
    <VALUE Lang="id">This is just my observation, but all the teachers and students from the school came out fine.</VALUE>
    <VALUE Lang="id">Skip</VALUE>
