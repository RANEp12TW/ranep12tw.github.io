  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_15_0">
    <VALUE Lang="id">Terima kasih.</VALUE>
    <VALUE Lang="id">Anda ingin kerja terus bersama saya?</VALUE>
    <VALUE Lang="id">….Ho ho. Bercanda kok.</VALUE>
    <VALUE Lang="id">Sampai bertemu besok.</VALUE>
  </SENTENSE>
  <SENTENSE Ver="1" Id="npc_hl_madame.ntk_15_0_1">
