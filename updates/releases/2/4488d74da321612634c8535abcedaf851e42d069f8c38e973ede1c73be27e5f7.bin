<?xml version="1.0" encoding="utf-8"?> 
<TEXT>
<SENTENSE Ver="1" Id="ALLIANCE_BATTLE_BEGIN">
<VALUE Lang="tw">%1%'同盟和 '%2%'同盟的 '同盟對戰'開始了.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ALLIANCE_BATTLE_BEGIN_REFUSE">
<VALUE Lang="tw">%1%'同盟拒絕了 '%2%'同盟發出的 '同盟對戰'申請.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ALLIANCE_BATTLE_OVER_ARMISTICE">
<VALUE Lang="tw">%1%'同盟和 '%2%'同盟的 '同盟對戰'進行休戰.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ALLIANCE_BATTLE_OVER_ARMISTICE_RESULT">
<VALUE Lang="tw">休戰結果分數%d : %d</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ALLIANCE_BATTLE_OVER_DRAW">
<VALUE Lang="tw">%1%'同盟和 '%2%'同盟在 '同盟對戰'中沒有分出勝負.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ALLIANCE_BATTLE_OVER_SUBMISSION">
<VALUE Lang="tw">%1%'同盟已向 '%2%'同盟投降.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ALLIANCE_BATTLE_OVER_WIN">
<VALUE Lang="tw">'%1%'同盟在'同盟對戰'中戰勝了 '%2%'同盟.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ALLIANCE_BATTLE_RESULT">
<VALUE Lang="tw">同盟對戰進度 : %1% %2%勝 %3%敗 %4%平</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="APPLY_GUID_MAP_EFFECT">
<VALUE Lang="tw">認證組織獲得了 %1% %2$2.2f%% 效果</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ATTENDANCE_REWARD_POST_CONTENT">
<VALUE Lang="tw">此信件為點名簿課程獎勵品</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ATTENDANCE_REWARD_POST_SENDERNAME">
<VALUE Lang="tw">Ran Online World</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="ATTENDANCE_REWARD_POST_TITLE">
<VALUE Lang="tw">點名簿課程獎勵</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BANISHMENT_POST_CONTENT">
<VALUE Lang="tw">已成功退出公會。</VALUE>
<VALUE Lang="tw">退出後1天內無法再加入其他公會。但是，可創立公會。</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BANISHMENT_POST_SENDER_NAME">
<VALUE Lang="tw">Ran Online World</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BANISHMENT_POST_TITLE">
<VALUE Lang="tw">退出公會訊息</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BATTLE_BEGIN">
<VALUE Lang="tw">%1%'組織和 '%2%'組織的 '組織對戰'開始了.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BATTLE_BEGIN_REFUSE">
<VALUE Lang="tw">%1%'組織拒絕了 '%2%'組織發出的 '組織對戰'申請.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BATTLE_OVER_ARMISTICE">
<VALUE Lang="tw">%1%'組織和 '%2%'組織的 '組織對戰'進行休戰.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BATTLE_OVER_ARMISTICE_RESULT">
<VALUE Lang="tw">休戰結果 比分 %d : %d</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BATTLE_OVER_DRAW">
<VALUE Lang="tw">%1%'組織和 '%2%'組織在 '組織對戰'中沒有分出勝負.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BATTLE_OVER_SUBMISSION">
<VALUE Lang="tw">%1%'組織已向 '%2%'組織投降.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BATTLE_OVER_WIN">
<VALUE Lang="tw">%1%'組織在 '組織對戰'中戰勝了 '%2%'組織.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_BATTLE_RESULT">
<VALUE Lang="tw">組織對戰記錄 : %1% %2%勝 %3%敗 %4%和</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="CLUB_DEATHMATCH_END_RANKING">
<VALUE Lang="tw">第%1%名 : '%2%' ( %3% / %4% )</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="EMCONFRONT_END_CDRAWN">
<VALUE Lang="tw">'在'%1%' '%2%' 對 '%3%' 之間的組織訓練結束了. 沒有分出勝負.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="EMCONFRONT_END_CWIN">
<VALUE Lang="tw">'在'%1%' '%2%' 對 '%3%' 之間的組織訓練結束了. '%4%' 組織獲勝.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="EMCONFRONT_END_PDRAWN">
<VALUE Lang="tw">'在'%1%' '%2%' 對 '%3%' 之間的隊伍訓練結束了. 沒有分出勝負.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="EMCONFRONT_END_PWIN">
<VALUE Lang="tw">'在'%1%' '%2%' 對 '%3%' 之間的隊伍訓練結束了. '%4%' 隊員獲勝.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="EMCONFRONT_START_PARTY">
<VALUE Lang="tw">在'%1%' '%2%' 對 '%3%' 之間的隊伍訓練開始了.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="EMCROWACT_KNOCK">
<VALUE Lang="tw">'%1%' 已經在 %2%重生.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="EMCROWACT_REPULSE">
<VALUE Lang="tw">'%1%' 已經被擊殺.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="EMGUIDCLUB_CERTIFIED">
<VALUE Lang="tw">'%1%' 組織獲得 '%2%' 地區的領導組織認證.</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="LOTTOSYSTEM_GIVE_MONEY_POST_CONTENT">
<VALUE Lang="tw">恭喜樂透%1%期%2%獎 中獎。(%2%獎 獎金%3%已發送。請確認背包金額)</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="LOTTOSYSTEM_GIVE_MONEY_POST_SENDERNAME">
<VALUE Lang="tw">Ran Online World</VALUE>
</SENTENSE>
<SENTENSE Ver="1" Id="LOTTOSYSTEM_GIVE_MONEY_POST_TITLE">
<VALUE Lang="tw">樂透第%1%期 %2%獎 中獎通知</VALUE>
</SENTENSE>
