@echo off
set "EP12_THEME_SETUP=%~f0"
title EP12 Chibi Theme Setup
powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -Command "$part=[IO.File]::ReadAllText($env:EP12_THEME_SETUP) -split '(?m)^# === EP12 THEME ===\r?$',2; & ([ScriptBlock]::Create($part[1]))"
pause
exit /b
# === EP12 THEME ===
$ErrorActionPreference = 'Stop'
if (!(Get-NetIPAddress -IPAddress '192.168.0.130' -ErrorAction SilentlyContinue)) {
    throw 'Open this installer inside the EP12 Windows Server VM.'
}
$folder = Join-Path $env:TEMP ('EP12-ChibiTheme-' + [guid]::NewGuid().ToString('N'))
[void](New-Item -ItemType Directory -Path $folder)
$payload = @{
    'Install-EP12-ChibiTheme-Guest.ps1' = ''
    'register.ashx' = ''
}
foreach ($file in $payload.Keys) {
    [IO.File]::WriteAllBytes((Join-Path $folder $file), [Convert]::FromBase64String($payload[$file]))
}
& (Join-Path $folder 'Install-EP12-ChibiTheme-Guest.ps1')
